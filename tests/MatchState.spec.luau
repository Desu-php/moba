--!strict
local Rules = require("../src/shared/Game/MatchState")
local passed = 0
local function check(name: string, value: boolean)
	assert(value, name); passed += 1; print("PASS MatchState: " .. name)
end
local state = Rules.new({ "Blue", "Red" })
check("waiting initially", state.phase == "WaitingForPlayers")
check("two active bases", #Rules.active(state) == 2)
check("balanced first team", Rules.assign(state, nil) == "Blue")
state.teams.Blue.count = 1
check("balanced second team", Rules.assign(state, nil) == "Red")
check("rejoin keeps team", Rules.assign(state, "Blue") == "Blue")
check("enemy allowed", Rules.enemy(state, "Blue", "Red"))
check("ally denied", not Rules.enemy(state, "Blue", "Blue"))
check("unknown and missing team denied", not Rules.enemy(state, "Alien", "Red") and not Rules.enemy(state, nil, "Red"))
check("not enough players", not Rules.advance(state, 0, 1, 2, 5, 5))
check("prepare on second player", Rules.advance(state, 1, 2, 2, 5, 5) and state.phase == "Preparing")
check("leaving cancels preparation", Rules.advance(state, 2, 1, 2, 5, 5) and state.phase == "WaitingForPlayers")
Rules.advance(state, 3, 2, 2, 5, 5)
check("preparation not early", not Rules.advance(state, 7.9, 2, 2, 5, 5))
check("start at deadline", Rules.advance(state, 8, 2, 2, 5, 5) and state.phase == "InProgress")
check("first wave waits five seconds", not Rules.waveDue(state, 12.9, 20))
check("first wave on schedule", Rules.waveDue(state, 13, 20) and state.wave == 1)
check("no duplicate wave", not Rules.waveDue(state, 13, 20))
check("twenty second interval", not Rules.waveDue(state, 32.99, 20) and Rules.waveDue(state, 33, 20))
check("no catch-up storm", Rules.waveDue(state, 1000, 20) and not Rules.waveDue(state, 1000, 20) and state.wave == 3)
check("departure does not kill base or end active match", not Rules.advance(state, 1001, 0, 2, 5, 5) and #Rules.active(state) == 2)
check("ordinary death does not affect teams", #Rules.active(state) == 2)
check("base elimination accepted once", Rules.eliminate(state, "Red", 1002))
check("winner is surviving team", state.phase == "Finished" and state.winner == "Blue")
check("repeat destruction ignored", not Rules.eliminate(state, "Red", 1003) and state.finishedAt == 1002)
check("waves stopped", not Rules.waveDue(state, 10000, 20))
check("finished match rejects joining combat", Rules.assign(state, nil) == nil)
check("eliminated side cannot deal damage", not Rules.enemy(state, "Red", "Blue"))
local four = Rules.new({ "A", "B", "C", "D" })
Rules.advance(four, 0, 4, 4, 0, 5); Rules.advance(four, 0, 4, 4, 0, 5)
check("four-team start", four.phase == "InProgress")
Rules.eliminate(four, "B", 1)
check("three survivors is not victory", four.phase == "InProgress" and #Rules.active(four) == 3)
check("eliminated reconnect cannot switch", Rules.assign(four, "B") == nil)
Rules.eliminate(four, "D", 2)
check("two survivors is not victory", four.phase == "InProgress")
Rules.eliminate(four, "A", 3)
check("arbitrary last team wins", four.phase == "Finished" and four.winner == "C")
check("post finish elimination blocked", not Rules.eliminate(four, "C", 4))
local solo = Rules.new({ "Blue", "Red" })
Rules.advance(solo, 0, 1, 1, 0, 5); Rules.advance(solo, 0, 1, 1, 0, 5)
check("solo retains opposing NPC side", solo.phase == "InProgress" and #Rules.active(solo) == 2)
local invalid = pcall(function() Rules.new({ "Only" }) end)
check("at least two teams enforced", not invalid)
check("duplicate team IDs refused", not pcall(function() Rules.new({ "A", "A" }) end))
print("ALL PASS: " .. passed .. " match/team/wave checks")
