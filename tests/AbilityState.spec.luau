--!strict
local Rules = require("../src/shared/Combat/AbilityState")
local Combat = require("../src/shared/Combat/CombatState")
local CombatConfig = require("../src/shared/Config/CombatConfig")
local Config = require("../src/shared/Config/AbilityConfig")
local Poses = require("../src/shared/Combat/HeroPoses")
local count = 0
local function check(name: string, condition: boolean) assert(condition, name); count += 1; print("PASS Abilities: " .. name) end
local sphere = { Cooldown=8, Windup=.35, Duration=.9 }
local auxiliary = { Cooldown=7, Windup=.25, Duration=.65 }
local state = Rules.new(1)
local cast, reason = Rules.request(state, "FixtureAction", sphere, 10, 1, "Idle", 10, true)
assert(cast)
check("accepted exactly at M1 recovery boundary", reason == "Accepted")
check("cooldown starts on acceptance", state.ready.FixtureAction == 18)
check("one active cast", Rules.request(state, "FixtureAuxiliary", auxiliary, 10, 2, "Idle", 0, true) == nil)
check("cannot claim before contact", not Rules.claim(state, cast, 10.349))
check("claim contact once", Rules.claim(state, cast, 10.35))
check("second contact rejected", not Rules.claim(state, cast, 10.36))
check("not finished before recovery", not Rules.finish(state, cast, cast.endsAt - 0.001))
check("finished at recovery boundary", Rules.finish(state, cast, cast.endsAt))
check("finished cast cannot impact", not Rules.claim(state, cast, cast.endsAt + 0.01))
check("cooldown before boundary", Rules.request(state, "FixtureAction", sphere, 17.999, 3, "Idle", 0, true) == nil)
check("remaining exact", math.abs(Rules.remaining(state, "FixtureAction", 17.5) - 0.5) < 1e-9)
local nextCast = Rules.request(state, "FixtureAction", sphere, 18, 4, "Idle", 0, true); assert(nextCast)
check("cooldown boundary accepted", nextCast.id == 2)
check("old cast cannot claim new action", not Rules.claim(state, cast, 18.35))
Rules.cancel(state)
check("stun cancellation invalidates impact", not Rules.claim(state, nextCast, 18.35))
check("interrupt does not refund cooldown", state.ready.FixtureAction == 26)
check("cancel frees active action", state.active == nil)
check("stun cannot cast", Rules.request(state, "FixtureAuxiliary", auxiliary, 19, 5, "Stunned", 0, true) == nil)
check("dead cannot cast", Rules.request(state, "FixtureAuxiliary", auxiliary, 19, 6, "Dead", 0, true) == nil)
check("inactive match cannot cast", Rules.request(state, "FixtureAuxiliary", auxiliary, 19, 7, "Idle", 0, false) == nil)
check("active M1 blocks ability", Rules.request(state, "FixtureAuxiliary", auxiliary, 19, 8, "Attacking", 0, true) == nil)
check("M1 recovery blocks ability", Rules.request(state, "FixtureAuxiliary", auxiliary, 19, 9, "Idle", 19.001, true) == nil)
local wind = Rules.request(state, "FixtureAuxiliary", auxiliary, 19, 10, "Idle", 19, true); assert(wind)
check("fixture cannot hit during preparation", not Rules.claim(state, wind, 19))
check("fixture hits after preparation", Rules.claim(state, wind, 19.25))
Rules.newLife(state, 2)
check("respawn clears action", state.active == nil)
check("respawn rejects old life", not Rules.claim(state, wind, 19.26))
check("respawn preserves cooldown", state.ready.FixtureAuxiliary == 26)
check("remaining is clamped", Rules.remaining(state, "FixtureAuxiliary", 100) == 0)
local fighter = Combat.new()
local m1 = Combat.Request(fighter, CombatConfig.Profiles.Default, 100, 1)
check("actual CombatState begins M1", m1 == "Started")
check("ability uses actual CombatState exclusion", Rules.request(state, "FixtureAction", sphere, 100.1, 11, fighter.mode, fighter.nextAttackAt, true) == nil)
Combat.Update(fighter, 100.28)
check("recovery survives pose ending", fighter.mode == "Idle" and Rules.request(state, "FixtureAction", sphere, 100.3, 12, fighter.mode, fighter.nextAttackAt, true) == nil)
local late = Rules.request(state, "FixtureAction", sphere, 101, 13, "Idle", 0, true); assert(late)
check("late frame cannot deliver expired impact", not Rules.claim(state, late, 102))
Rules.finish(state, late, 102)
local fresh = Rules.new(3)
check("new match resets cooldowns", Rules.remaining(fresh, "FixtureAction", 0) == 0)
for _, key in { "Idle", "Run", "Punch1", "Punch2", "Punch3", "HeavyPunch", "ShadowClones", "RasenganPrepare", "RasenganStrike", "RasenganHelper", "Stun" } do
	local pose = Poses.sample(key, 1.5, 0.5)
	local finite = true; local moved = false
	for _, angles in pose do for _, value in angles do finite = finite and value == value and math.abs(value) < math.huge; moved = moved or math.abs(value) > 0.05 end end
	check(key .. " finite non-neutral pose", finite and moved)
end
local runA, runB = Poses.sample("Run", 0, 0), Poses.sample("Run", 0.12, 0)
check("running legs move over time", math.abs(runA.LeftHip[1] - runB.LeftHip[1]) > 0.5)
check("running arms point backwards", runB.LeftShoulder[1] < -0.8 and runB.RightShoulder[1] < -0.8)
local first, second = Poses.sample("Punch1", 0, 0.357), Poses.sample("Punch2", 0, 0.357)
check("M1 alternates arms", first.RightShoulder[1] > first.LeftShoulder[1] and second.LeftShoulder[1] > second.RightShoulder[1])
check("charge and strike are distinct", Poses.sample("RasenganPrepare",0,.5).RightElbow[1] > Poses.sample("RasenganStrike",0,.5).RightElbow[1])
local contactState = Rules.new(1)
local contact = Rules.request(contactState, "FixtureAction", sphere, 0, 1, "Idle", 0, true); assert(contact)
check("contact closed before windup", not Rules.contactOpen(contactState, contact, 0.34, .2))
check("contact opens at windup", Rules.contactOpen(contactState, contact, 0.35, .2))
check("contact remains open for moving target", Rules.contactOpen(contactState, contact, 0.5, .2))
check("contact closes during recovery", not Rules.contactOpen(contactState, contact, 0.56, .2))
check("contact can claim once", Rules.claim(contactState, contact, 0.5))
check("claimed contact closes immediately", not Rules.contactOpen(contactState, contact, 0.51, .2))
check("removed dash absent from config and order", Config.Abilities.NinjaDash == nil and table.find(Config.Order, "NinjaDash") == nil)
local seal = Poses.sample("ShadowClones", 0, 0.4)
check("clone seal brings both hands inward", seal.LeftShoulder[3] > 0 and seal.RightShoulder[3] < 0)

local held=Poses.holdRasengan(Poses.sample("Run",.12,0),.12)
check("holding preserves running legs", held.LeftHip[1]==runB.LeftHip[1] and held.RightElbow[1]>1)
check("removed palm has no configured input", (Config.Abilities :: {[string]:any})["WindPalm"]==nil and table.find(Config.Order,"WindPalm")==nil)
local movement = { W=true,A=true,S=true,D=true }
for _,id in Config.Order do check(id.." does not consume movement keys",not (movement :: {[string]:boolean})[Config.Abilities[id].Key]) end
check("Q alias still prepares Rasengan",Config.InputAliases.Q=="Rasengan")
print("ALL PASS: " .. count .. " ability state and pose checks")
