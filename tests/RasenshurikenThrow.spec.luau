--!strict
local R=require("../src/shared/Abilities/RasenshurikenThrowRules")
assert(R.allowed(3,true,"Rasenshuriken","Holding",5,4,15))
assert(not R.allowed(2,true,"Rasenshuriken","Holding",5,4,15))
assert(not R.allowed(3,false,"Rasenshuriken","Holding",5,4,15))
assert(not R.allowed(3,true,"Odama","Holding",5,4,15))
assert(not R.allowed(3,true,"Rasenshuriken","Preparing",5,4,15))
assert(not R.allowed(3,true,"Rasenshuriken","Holding",3,4,15))
assert(not R.allowed(3,true,"Rasenshuriken","Holding",15,4,15))
assert(not R.allowed(3,true,"Rasenshuriken","Consumed",5,4,15))
assert(not R.finite(0/0) and not R.finite(math.huge) and not R.finite(1e9))
assert(R.radius(-.001)==0 and R.radius(0)==305 and R.radius(.04)==310)
assert(R.radiusForTick(39)==495 and R.radiusForTick(40)==500 and R.radiusForTick(88)==500)
assert(R.radius(1.6)==500 and R.radius(3.5)==0)
assert(R.pulse(56)==9 and R.pulse(56.9)==9 and R.pulse(100)==11)
local Units=require("../src/shared/Abilities/WorldUnits")
assert(Units.toStuds(R.Radius)==18.75 and Units.toStuds(R.MaxRadius)==31.25)
print("PASS Rasenshuriken throw: eligibility, expiry, malformed aim and dome radius")
