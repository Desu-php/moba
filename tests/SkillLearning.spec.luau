--!strict
local Learning = require("../src/shared/Abilities/SkillLearning")
local Config = require("../src/shared/Config/ProgressionConfig")
local Rules = require("../src/shared/Game/ProgressionRules").configure(Config,require("../src/shared/Config/ItemConfig").Items)
local count=0
local function check(name: string,value: boolean) assert(value,name); count+=1 end
local a,b=Rules.new(),Rules.new()
check("one native-default initial point",a.SkillPoints==1 and next(a.Learned)==nil)
check("five distinct lines",#Learning.Order==5)
check("Q minimum four",Learning.reason(a,"Rasengan")=="Level")
check("provisional ordinary clone unlock",Learning.learn(a,"ShadowClones"))
check("atomic debit",a.SkillPoints==0 and a.Learned.ShadowClones==1)
check("independent hero",b.SkillPoints==1 and next(b.Learned)==nil)
check("no unavailable upgrade spend",not Learning.learn(a,"ShadowClones") and a.SkillPoints==0 and a.Learned.ShadowClones==1)
for _,id in {"Gamakichi","SageMode","KCM"} do check("unimplemented "..id,Learning.reason(a,id)=="NotImplemented") end
check("unknown line",not Learning.learn(a,"Fake"))
Rules.addXP(a,450)
check("level4 and three earned points",a.Level==4 and a.SkillPoints==3)
check("Q learned at four",Learning.learn(a,"Rasengan"))
check("second debit once",a.SkillPoints==2 and a.Learned.Rasengan==1)
check("future Q rank not fake ready",Learning.reason(a,"Rasengan")=="NotImplemented")
Rules.addXP(a,100000)
check("cap30",a.Level==30 and a.CurrentXP==0)
check("all level points exactly once",a.SkillPoints==28)
Rules.addXP(a,100000)
check("cap XP no extra points",a.SkillPoints==28)
check("unspent points retained without invented sink",not Learning.learn(a,"KCM") and a.SkillPoints==28)
local s=Rules.stats(b)
check("source level1 primary attributes",s.Strength==16 and s.Agility==15 and s.Intelligence==14)
check("source HP and armor factors",s.MaxHealth==620 and s.Defense==3)
check("inferred mana labeled separately",s.MaxMana==1510 and math.abs(s.ManaRegen-.71)<1e-9)
Rules.addXP(b,100)
s=Rules.stats(b)
check("raw source growth",math.abs(s.RawStrength-17.4)<1e-9 and math.abs(s.RawAgility-16.1)<1e-9 and s.Intelligence==15)
check("explicit floor adaptation",s.Strength==17 and s.Agility==16 and s.MaxHealth==640)
local buffed=Rules.stats(b,2)
check("current bonus affects derived health/damage",buffed.Strength==19 and buffed.MaxHealth==680 and buffed.AttackDamageMultiplier>s.AttackDamageMultiplier)
check("idempotent current stats",Rules.stats(b,2).MaxHealth==680)
print("PASS SkillLearning: "..count.." assertions")
