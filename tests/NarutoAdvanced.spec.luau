--!strict
local V=require("../src/shared/Abilities/RasenganVariants")
local R=require("../src/shared/Abilities/RasenganState")
local D=require("../src/shared/Abilities/NarutoDefinitions")
local Q=R.configure(D.Rasengan)
local Sleep=require("../src/shared/Abilities/SleepState")
local Plan=require("../src/shared/Abilities/CloneCastPlan")
local Catalog=require("../src/shared/Abilities/NarutoAdvancedCatalog")
local checks=0
local function check(ok: boolean,label: string) assert(ok,label); checks+=1 end
local a,b=V.new(),V.new()
check(select(2,V.select(a,"Odama",1,0,.1,1000,true))=="Rank","rank1 cannot select")
check(select(2,V.select(a,"Odama",2,0,1,1000,true))=="Window","exclusive upper boundary")
check(select(2,V.select(a,"Odama",2,0,-.1,1000,true))=="Window","no earlier selection")
check(select(2,V.select(a,"Odama",2,0,.1,199,true))=="Mana","no free selection")
local choice,why,debit=V.select(a,"Odama",3,0,.5,1000,true); assert(choice,why)
check(debit==200 and choice.readyAt==2.5 and a.cooldowns.Odama==40.5,"Odama transaction")
check(b.choice==nil and next(b.cooldowns)==nil,"caster isolation")
check(select(2,V.select(a,"Odama",3,0,.6,1000,true))=="Window","no duplicate debit")
check(select(2,V.select(a,"Rasenshuriken",2,.5,.6,1000,false))=="Rank","rank2 no RS")
check(select(2,V.select(a,"Rasenshuriken",3,.5,1.5,1000,false))=="Window","second window exact boundary")
choice,why,debit=V.select(a,"Rasenshuriken",3,.5,1.49,1000,false); assert(choice,why)
check(debit==200 and choice.readyAt==2.79 and choice.expiresAt==16.49,"RS prep and hold")
check(select(2,V.select(a,"Rasenshuriken",3,0,1.5,1000,false))=="Window","no duplicate RS")
V.cancel(a); check(a.choice==nil and a.cooldowns.Odama==40.5,"cancel retains cooldown")
check(select(2,V.select(a,"Odama",3,20,20.1,1000,true))=="Cooldown","independent CD")
check(V.damage("Odama",30,20)==310 and V.stun("Odama")==4,"Odama formula")
check(V.damage("Rasengan",11,30)==260 and V.stun("Rasengan")==3.5,"base preserved")
check(V.pulse(16)==7 and V.selfDamage(16)==150,"separate integer victim and self formulas")
check(V.pulse(100)==11 and V.selfDamage(100)==270,"current STR changes pulse")
check(V.radius(0)==300 and V.radius(40)==500 and V.radius(80)==500,"bounded radius growth")
for _,bad in {0/0,math.huge,-math.huge} do
 check(select(2,V.select(b,"Odama",3,0,bad,1000,true))=="Malformed","finite time")
end
local q=R.new("owner",1,1)
local cast=Q.request(q,0,1,1000,true); assert(cast)
cast.variant="Odama"; cast.stun=4; cast.impactDelay=1
check(not Q.attack(q,cast,1.99,"enemy",true,false),"prep cannot attack")
check(Q.attack(q,cast,2,"enemy",true,false),"attack-start admission")
local target,stun=Q.claimControl(q,cast,2.01)
check(target=="enemy" and stun==4,"per-cast stun")
check(Q.claimImpact(q,cast,3)==nil and Q.claimImpact(q,cast,3.01)=="enemy","impact once")
check(Q.claimImpact(q,cast,4)==nil,"no second impact")
local other=R.new("other",1,1); local old=Q.request(other,0,1,1000,true); assert(old)
R.newLife(other,2); check(not Q.attack(other,old,2,"enemy",true,false),"stale life")
for rank,count in {3,4,5,7} do
 local plan=Plan.create(rank,"Self",200,1000); assert(plan)
 check(plan.count==count and plan.extraManaDrain==0,"ordinary/fallback counts")
end
local mass=Plan.create(4,"Self",500,1000); assert(mass)
check(mass.count==30 and mass.extraManaDrain==300 and mass.nativeManaCost==200,"inclusive postcost mass threshold")
local fallback=Plan.create(4,"Self",499.99,1000); assert(fallback)
check(fallback.count==7,"threshold fallback")
for rank=2,4 do
 local enemy=Plan.create(rank,"Enemy",1000,1000); assert(enemy)
 check(enemy.kind=="Sleep" and enemy.count==0 and enemy.extraManaDrain==0,"sleep no battle clones")
end
check(Plan.create(1,"Enemy",1000,1000)==nil,"rank1 no sleep")
check(Plan.create(4,"Self",199,1000)==nil,"base mana required")
local s=Sleep.new(5)
check(not Sleep.update(s,7.99) and s.active,"sleep lasts until deadline")
check(not Sleep.wake(s,false,0) and s.active,"zero damage does not wake")
check(Sleep.wake(s,true,0) and not s.active,"attack wakes without damage")
check(not Sleep.wake(s,true,10),"wake once")
s=Sleep.new(5); check(Sleep.update(s,8) and not s.active,"natural expiry")
s=Sleep.new(5); check(Sleep.wake(s,false,1),"confirmed spell damage wakes")
local ctx={sageReady=true,level=30,kcmRank=0,hagoromo=false,held="Odama"}
check(Catalog.reason("ChoOdama",ctx)=="NativeCostUnknown","unknown cost not zero")
ctx.kcmRank=1; check(Catalog.reason("Wakusei",ctx)=="NativeCostUnknown","unknown Wakusei cost")
ctx.kcmRank=3; ctx.hagoromo=true
check(Catalog.reason("BijudamaRasenshuriken",ctx)=="DownstreamGraphUnverified","no stale formula")
check(Catalog.reason("ChakraKnife",ctx)=="RegionPolicyUnknown","no unbounded blink")
print("PASS NarutoAdvanced: "..checks.." assertions")
