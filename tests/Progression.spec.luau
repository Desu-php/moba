--!strict
local Config = require("../src/shared/Config/ProgressionConfig")
local Items = require("../src/shared/Config/ItemConfig")
local Rules = require("../src/shared/Game/ProgressionRules").configure(Config, Items.Items)
local Ledger = require("../src/shared/Game/RewardLedger")
local count = 0
local function check(name: string, value: boolean)
 assert(value, name); count += 1; print("PASS Progression: " .. name)
end
local p = Rules.new()
check("initial profile", p.Level == 1 and p.CurrentXP == 0 and p.TotalKills == 0 and next(p.Owned) == nil)
check("thresholds", Rules.required(1) == 100 and Rules.required(2) == 150 and Rules.required(3) == 200)
check("below threshold", Rules.addXP(p, 99) == 0 and p.CurrentXP == 99)
check("exact threshold", Rules.addXP(p, 1) == 1 and p.Level == 2 and p.CurrentXP == 0)
check("overflow", Rules.addXP(p, 170) == 1 and p.Level == 3 and p.CurrentXP == 20)
check("multiple levels", Rules.addXP(p, 500) == 2 and p.Level == 5 and p.CurrentXP == 70)
local stats = Rules.stats(p)
check("level five stats", stats.MaxHealth == 720 and math.abs(stats.AttackDamageMultiplier - 1.10) < 0.0001)
check("level leaves speed and defense", stats.WalkSpeed == 16 and math.abs(stats.Defense-3.8)<0.00001)
check("max level cap", Rules.addXP(p, 100000) == 25 and p.Level == 30 and p.CurrentXP == 0)
check("no XP at cap", Rules.addXP(p, 100) == 0 and p.CurrentXP == 0 and Rules.required(p.Level) == 0)
stats = Rules.stats(p)
check("level thirty stats", stats.MaxHealth == 1420 and math.abs(stats.AttackDamageMultiplier - 1.80) < 0.0001)
p.Owned.IronBlade = true; p.Owned.GuardianArmor = true; p.Owned.SwiftBoots = true
stats = Rules.stats(p)
check("equipment health", stats.MaxHealth == 1460)
check("equipment speed", stats.WalkSpeed == 18)
check("additive base damage bonuses", math.abs(stats.AttackDamageMultiplier - 1.95) < 0.0001)
for _ = 1, 100 do stats = Rules.stats(p) end
check("idempotent recalculation", stats.MaxHealth == 1460 and stats.WalkSpeed == 18)
p.Owned.UnknownItem = true
check("unknown ownership ignored", Rules.stats(p).MaxHealth == 1460)
check("defense mitigation", Rules.mitigate(20, 100) == 10 and Rules.mitigate(20, -5) == 20)
for index, amount in { -1, 0/0, math.huge, -math.huge, 0.5, Config.MaxGrant + 1 } do
 check("invalid amount " .. index, not Rules.validAmount(amount))
 local fresh = Rules.new(); Rules.addXP(fresh, amount)
 check("invalid XP no mutation " .. index, fresh.Level == 1 and fresh.CurrentXP == 0)
 check("invalid gold no mutation " .. index, Rules.balanceAfter(100, amount, false) == nil)
end
check("gold add", Rules.balanceAfter(100, 20, false) == 120)
check("gold cap", Rules.balanceAfter(Config.MaxGold - 2, 20, false) == Config.MaxGold)
check("spend exact balance", Rules.balanceAfter(100, 100, true) == 0)
check("cannot overspend", Rules.balanceAfter(100, 101, true) == nil)
check("zero safe", Rules.balanceAfter(100, 0, false) == 100)
local wallet = 200
local first = Rules.balanceAfter(wallet, 200, true); assert(first); wallet = first
check("second spend refused", Rules.balanceAfter(wallet, 200, true) == nil)
check("equipment duplicate refused", Rules.purchaseReason(p, 999, "IronBlade", 50, 230) == "Purchased")
local fresh = Rules.new()
check("unknown item refused", Rules.purchaseReason(fresh, 999, "Fake", 50, 100) == "UnknownItem")
check("poor player refused", Rules.purchaseReason(fresh, 100, "IronBlade", 50, 100) == "NotEnoughGold")
check("full health potion refused", Rules.purchaseReason(fresh, 100, "HealingPotion", 100, 100) == "FullHealth")
check("injured potion accepted", Rules.purchaseReason(fresh, 100, "HealingPotion", 99, 100) == nil)
check("equipment accepted", Rules.purchaseReason(fresh, 200, "IronBlade", 100, 100) == nil)
check("reset profile removes equipment", fresh.Level == 1 and next(fresh.Owned) == nil and Rules.stats(fresh).MaxHealth == 620)
local a: Ledger.Actor = { userId = 1, teamId = "Blue" }; local b: Ledger.Actor = { userId = 2, teamId = "Blue" }
local ledger = Ledger.new()
Ledger.record(ledger, b, "Red", 1); Ledger.record(ledger, b, "Red", 2); Ledger.record(ledger, a, "Red", 3)
local claimed, killer, assists = Ledger.claim(ledger, 4, 10)
check("last hit attribution", claimed and killer ~= nil and killer.userId == 1)
check("assistant deduplicated", #assists == 1 and assists[1].userId == 2)
check("ledger cleared", ledger.last == nil and next(ledger.contributions) == nil)
check("death consumed once", not Ledger.claim(ledger, 4, 10))
ledger = Ledger.new(); Ledger.record(ledger, a, "Blue", 1)
claimed, killer, assists = Ledger.claim(ledger, 2, 10)
check("friendly kill no attribution", claimed and killer == nil and #assists == 0)
ledger = Ledger.new(); Ledger.record(ledger, b, "Red", 1); Ledger.record(ledger, a, "Red", 12)
claimed, killer, assists = Ledger.claim(ledger, 13, 10)
check("expired assist excluded", #assists == 0 and killer ~= nil and killer.userId == 1)
ledger = Ledger.new(); Ledger.record(ledger, a, "Red", 1)
claimed, killer = Ledger.claim(ledger, 10.9, 10)
check("knockback death within window", killer ~= nil and killer.userId == 1)
ledger = Ledger.new(); Ledger.record(ledger, a, "Red", 1)
claimed, killer = Ledger.claim(ledger, 11.1, 10)
check("expired killer excluded", killer == nil)
ledger = Ledger.new(); Ledger.record(ledger, a, "Red", 1); Ledger.record(ledger, { teamId = "Blue" }, "Red", 2)
claimed, killer, assists = Ledger.claim(ledger, 3, 10)
check("NPC last hit has no player gold recipient", killer ~= nil and killer.userId == nil and killer.teamId == "Blue")
check("NPC hero kill permits player assist", #assists == 1 and assists[1].userId == 1)
ledger = Ledger.new(); Ledger.record(ledger, a, "Red", 1); Ledger.forget(ledger, 1)
claimed, killer, assists = Ledger.claim(ledger, 2, 10)
check("departure forgets contribution", killer == nil and #assists == 0)
ledger = Ledger.new(); claimed, killer, assists = Ledger.claim(ledger, 2, 10)
check("new life has no stale credit", claimed and killer == nil and #assists == 0)
print("ALL PASS: " .. count .. " progression/economy/attribution checks")
