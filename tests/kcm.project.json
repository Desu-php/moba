{
  "name": "KCMFocusedQA",
  "serveAddress": "127.0.0.1",
  "servePort": 34872,
  "tree": {
    "$className": "DataModel",
    "$ignoreUnknownInstances": true,
    "ReplicatedStorage": {
      "$ignoreUnknownInstances": true,
      "Shared": {
        "$path": "../src/shared"
      }
    },
    "ServerScriptService": {
      "$ignoreUnknownInstances": true,
      "Server": {
        "$path": "../src/server"
      },
      "KcmTests": {
        "$path": "kcm/Runner.server.luau"
      }
    },
    "StarterPlayer": {
      "$properties": {
        "GameSettingsAvatar": "R15",
        "LoadCharacterAppearance": false
      },
      "$ignoreUnknownInstances": true,
      "StarterPlayerScripts": {
        "$ignoreUnknownInstances": true,
        "Client": {
          "$path": "../src/client"
        }
      }
    },
    "Workspace": {
      "$ignoreUnknownInstances": true,
      "$attributes": {
        "RegressionSuite": "KCM"
      }
    }
  }
}