--!strict
assert(game:GetService("RunService"):IsStudio())
local S=game.ServerScriptService:WaitForChild("Server"):WaitForChild("Services")
local Dev=require(S.DeveloperCommandService)
local Progression=require(S.HeroProgressionService)
local Stats=require(S.CharacterStatsService)
local Naruto=require(S.NarutoAbilityService)
local Match=require(S.MatchService)
local Players=game:GetService("Players")
local checks={}
local function check(ok: boolean,name: string) assert(ok,name);table.insert(checks,name) end
local function run()
 local untilAt=os.clock()+25
 while os.clock()<untilAt do local m=Match.GetState();if m and m.phase=="InProgress" and Players:GetPlayers()[1] and Naruto.Get(Players:GetPlayers()[1]) then break end;task.wait(.1) end
 local player=Players:GetPlayers()[1];assert(player)
 check(select(1,Dev.Execute(player,"level 30")),"level command accepted")
 task.wait(.15)
 local profile=Progression.Get(player);assert(profile)
 check(profile.Level==30 and Stats.Get(player).Level==30,"level updates gameplay stats")
 check(Stats.Get(player).Strength==56 and Stats.Get(player).MaxHealth==1532 and player.Character.Humanoid.MaxHealth==1532 and player.HeroState:GetAttribute("Strength")==56,"level-derived strength and health reach the character and HUD")
 check(not select(1,Dev.Execute(player,"level 31")),"out of range rejected")
 check(not select(1,Dev.Execute(player,"level 2")),"no destructive level reduction")
 check(not select(1,Dev.Execute(player,{command="level"})),"non-string rejected")
 check(select(1,Dev.Execute(player,"learnall")),"learnall accepted")
 check(profile.Learned.Rasengan==3 and profile.Learned.SageMode==3,"skills learned through rank rules")
 local s=Naruto.Get(player);assert(s)
 local now=workspace:GetServerTimeNow()
 s.q.cooldownAt=now+100;s.clones.cooldownAt=now+100;s.sage.cooldownAt=now+100;s.variants.cooldowns.Odama=now+100
 check(select(1,Dev.Execute(player,"nocd on")),"nocd enabled")
 check(s.q.cooldownAt==0 and s.sage.cooldownAt==0 and next(s.variants.cooldowns)==nil,"authoritative cooldowns cleared")
 s.q.cooldownAt=now+100;task.wait(.1)
 check(s.q.cooldownAt==0,"nocd remains active between casts")
 check(select(1,Dev.Execute(player,"nocd off")),"nocd disabled")
 s.q.cooldownAt=now+100;task.wait(.1)
 check(s.q.cooldownAt==now+100,"cooldowns resume after off")
 s.pool.mana=1;local h=player.Character:FindFirstChildOfClass("Humanoid");assert(h);h.Health=100
 check(select(1,Dev.Execute(player,"refresh")),"refresh accepted")
 check(s.q.cooldownAt==0 and s.pool.mana==s.pool.maximum and h.Health==h.MaxHealth,"refresh restores resources and cooldowns")
 local ok=Naruto.TryCast(player,"Rasengan",s.q.lastRequest+1,workspace:GetServerTimeNow(),nil)
 check(ok,"actual Rasengan cast accepted")
 local active=s.q.active;assert(active)
 Dev.Execute(player,"nocd on");task.wait(.1)
 check(s.q.active==active and active.readyAt>now,"nocd preserves active cast and preparation")
 Dev.Execute(player,"nocd off")
end
local ok,result=pcall(run)
workspace:SetAttribute("DeveloperCommandQA",game:GetService("HttpService"):JSONEncode({ok=ok,checks=checks,error=if ok then nil else tostring(result)}))
assert(ok,tostring(result))
print("PASS developer command integration: "..#checks.." checks")
