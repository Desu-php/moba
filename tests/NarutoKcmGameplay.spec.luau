--!strict
local G=require("../src/shared/Abilities/NarutoKcmGameplay")
local Learning=require("../src/shared/Abilities/SkillLearning")
local Layers=require("../src/shared/Abilities/StatLayers")
local n=0
local function check(name: string,ok: boolean) assert(ok,name); n+=1 end
for rank=1,3 do
 local m=G.modifier(rank); assert(m)
 check("retained resources rank"..rank,m.health==0)
 local layers: Layers.Layers={item={health=80,armor=2,attack=7,speed=1},sage={health=200,armor=7,attack=30,speed=6}}
 Layers.set(layers,"KCM",{health=m.health,armor=m.armor,attack=m.attack,speed=m.speedWarcraft/16})
 check("KCM composes with Sage/items rank"..rank,Layers.sum(layers).health==280 and Layers.sum(layers).attack==37+m.attack)
 Layers.set(layers,"KCM",nil); check("removal preserves other owners rank"..rank,Layers.sum(layers).health==280 and Layers.sum(layers).attack==37)
end
check("invalid rank no modifier",G.modifier(4)==nil and G.modifier(0/0)==nil)
local d=G.newDash()
local ok,why,cost,damage=G.dash(d,0,1,true,false,500,650,"Unit",31)
check("halfsecond readiness required",not ok and why=="Form" and d.cooldownAt==0)
ok,why,cost,damage=G.dash(d,0,2,true,true,500,650,"Unit",31)
check("dash exact range cost damage",ok and cost==100 and damage==131 and d.cooldownAt==40)
check("replay no second debit",select(2,G.dash(d,1,2,true,true,500,10,"Unit",31))=="Replay")
check("dash cooldown40",select(2,G.dash(d,39.99,3,true,true,500,10,"Unit",31))=="Cooldown")
ok,why,cost,damage=G.dash(d,40,4,true,true,100,650,"Point",31)
check("point blink has no damage",ok and cost==100 and damage==nil)
check("range failure",select(2,G.dash(d,80,5,true,true,500,650.001,"Point",31))=="Range")
check("mana failure",select(2,G.dash(d,80,6,true,true,99,10,"Point",31))=="Mana")
check("target failure",select(2,G.dash(d,80,7,true,true,500,10,"Structure",31))=="Target")
check("inactive failure",select(2,G.dash(d,80,8,false,true,500,10,"Unit",31))=="Form")
check("finite clock",select(2,G.dash(d,0/0,9,true,true,500,10,"Unit",31))=="Malformed")
local h=G.newHagoromo(); G.updateHagoromo(h,0,24,true)
check("no timer at24",h.deadline==nil)
G.updateHagoromo(h,10,25,true); check("360second wait",h.deadline==370 and not h.granted)
check("not early or free",G.updateHagoromo(h,369.99,27,true)==nil and not h.granted)
check("deadline waits alive",G.updateHagoromo(h,370,27,false)==nil and not h.granted)
check("one second presentation",G.updateHagoromo(h,400,27,true)=="Cutscene" and not h.granted)
G.updateHagoromo(h,400.5,27,false); check("death cancels presentation",h.cutsceneAt==nil)
G.updateHagoromo(h,410,27,true)
check("not grant before full alive second",G.updateHagoromo(h,410.99,27,true)==nil)
check("grant once",G.updateHagoromo(h,411,27,true)=="Granted" and h.granted and G.updateHagoromo(h,412,27,true)==nil)
local other=G.newHagoromo(); check("owners separate",not other.granted and other.deadline==nil)
local p={Level=12,SkillPoints=10,Learned={} :: {[string]: number}}
check("rank1level13 gate",Learning.reason(p,"KCM")=="Level")
p.Level=13; check("rank1 purchase",Learning.learn(p,"KCM") and p.SkillPoints==9)
p.Level=19; check("rank2level20 gate",Learning.reason(p,"KCM")=="Level")
p.Level=20; check("rank2 purchase",Learning.learn(p,"KCM") and p.SkillPoints==8)
p.Level=26; check("rank3level27 gate",Learning.reason(p,"KCM")=="Level")
p.Level=27; check("rank3 learned independently of Hagoromo cast gate",Learning.learn(p,"KCM") and p.SkillPoints==7)
check("not a sixth learning line",#Learning.Order==5 and Learning.reason(p,"KcmDash")=="UnknownAbility")
print("ALL PASS: "..n.." KCM gameplay policy/dash/Hagoromo/learning checks")
