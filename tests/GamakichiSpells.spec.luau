--!strict
local S=require("../src/shared/Abilities/GamakichiSpells")
local count=0
local function check(name: string,ok: boolean) assert(ok,name); count+=1 end
local a,b=S.new(),S.new()
check("adult gate",not S.request(a,"GamakichiChop",0,1,false,0) and a.chopReady==0)
check("invalid requests",not S.request(a,"GamakichiOil",0,0,true,0))
check("oil admission",S.request(a,"GamakichiOil",0,2,false,.8))
check("independent casters",b.flight==nil and b.oilReady==0)
check("no early arrival",not S.claimOil(a,.799))
check("one arrival only",S.claimOil(a,.8) and not S.claimOil(a,.8))
local accepted,reason=S.request(a,"GamakichiOil",24.999,3,true,0)
check("oil cooldown retained",not accepted and reason=="Cooldown" and a.oilReady==25)
check("oil exact cooldown boundary",S.request(a,"GamakichiOil",25,4,true,.5))
S.cancel(a)
check("cancel flight no late effect",not S.claimOil(a,100) and a.oilReady==50)
check("channel independent cooldown",S.request(a,"GamakichiChop",26,5,true,0))
check("no channel tick during prep",S.claimWave(a,26.499)==nil)
for wave=1,4 do
 local at=26.5+(wave-1)*S.NativePolicy.WaveInterval
 check("one wave "..wave,S.claimWave(a,at)==wave)
 check("no duplicate wave "..wave,S.claimWave(a,at)==nil)
end
check("four waves then stop",a.channel==nil and S.claimWave(a,100)==nil)
check("channel cooldown",not S.request(a,"GamakichiChop",55.9,6,true,0) and a.chopReady==56)
check("new channel after cooldown",S.request(a,"GamakichiChop",56,7,true,0))
S.cancel(a)
check("interruption no remaining waves",S.claimWave(a,60)==nil and a.chopReady==86)
check("stale serial cannot revive",not S.request(a,"GamakichiChop",100,7,true,0))
local c=S.new(); check("lagged channel start",S.request(c,"GamakichiChop",0,1,true,0))
for wave=1,4 do check("lag catchup bounded "..wave,S.claimWave(c,100)==wave) end
check("lag no fifth",S.claimWave(c,100)==nil)
local d=S.debuff()
S.apply(d,"owner-a:1",0)
check("slow applies once",math.abs(S.movement(d,0)-.6)<1e-9)
S.apply(d,"owner-a:1",1)
check("refresh does not multiply slow",S.movement(d,1)==.6 and S.untilAt(d,1)==7)
S.apply(d,"owner-b:1",2); S.clear(d,"owner-a:1")
check("owned cleanup preserves other caster",S.untilAt(d,3)==8 and S.movement(d,3)==.6)
check("miss boundary below30percent",S.misses(d,3,.299999))
check("miss boundary at30percent",not S.misses(d,3,.3))
check("invalid rolls never manufacture miss",not S.misses(d,3,0/0) and not S.misses(d,3,-1) and not S.misses(d,3,1))
check("expiry restores movement/miss",S.movement(d,8)==1 and not S.misses(d,8,0))
check("single target raw wave",S.waveDamage(1)==120)
check("wave cap allocated across targets",S.waveDamage(8)==93.75 and S.waveDamage(8)*8==750)
check("empty area no damage",S.waveDamage(0)==0)
check("uncertified attack-speed field not enabled",not S.NativePolicy.AttackSpeedReductionImplemented)
print("PASS GamakichiSpells: "..count.." assertions")
