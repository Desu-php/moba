--!strict
local Rules = require("../src/shared/Game/TowerRules")
local Structures = require("../src/shared/Game/StructureRules")
local Config = require("../src/shared/Config/TowerConfig")
local count = 0
local function check(name: string, value: boolean) assert(value, name); count += 1; print("PASS Towers: " .. name) end
local function sample(id: number, kind: string, distance: number, valid: boolean?): Rules.Candidate
	return { id = id, kind = kind, distance = distance, valid = valid ~= false }
end
local function choose(state: Rules.State, candidates: { Rules.Candidate }, now: number): number?
	return Rules.choose(state, candidates, now, Config.TargetPriority, Config.AllowSummons)
end
local state = Rules.new()
check("minion preferred over closer hero", choose(state, { sample(1, "Hero", 2), sample(2, "Minion", 20) }, 0) == 2)
check("nearest minion", choose(state, { sample(1, "Minion", 20), sample(2, "Minion", 10) }, 0) == 2)
check("hero when no minions", choose(state, { sample(1, "Hero", 9), sample(2, "Hero", 10) }, 0) == 1)
check("invalid includes dead wall range and ally", choose(state, { sample(1, "Minion", 1, false), sample(2, "Hero", 2) }, 0) == 2)
check("summons explicitly excluded", choose(state, { sample(1, "Summon", 1) }, 0) == nil)
check("structures never candidates", choose(state, { sample(1, "Tower", 1), sample(2, "Base", 1) }, 0) == nil)
check("equal distance stable by id", choose(state, { sample(2, "Hero", 10), sample(1, "Hero", 10) }, 0) == 1)
state.target = 2
check("equal distance keeps current target", choose(state, { sample(1, "Hero", 10), sample(2, "Hero", 10) }, 0) == 2)
check("closer target still wins", choose(state, { sample(1, "Hero", 9), sample(2, "Hero", 10) }, 0) == 1)
Rules.aggress(state, 3, 10, Config.AggroDuration, false)
check("unconfirmed damage cannot aggro", state.aggro == nil)
Rules.aggress(state, 3, 10, Config.AggroDuration, true)
local pool = { sample(2, "Minion", 1), sample(3, "Hero", 25) }
check("defensive aggro overrides minions", choose(state, pool, 10) == 3)
check("aggro holds until deadline", choose(state, pool, 12.999) == 3)
check("aggro expires at three seconds", choose(state, pool, 13) == 2 and state.aggro == nil)
Rules.aggress(state, 3, 20, 3, true)
check("unavailable aggressor clears lock", choose(state, { sample(2, "Minion", 1), sample(3, "Hero", 25, false) }, 21) == 2 and state.aggro == nil)
check("returning aggressor needs new damage", choose(state, pool, 21.1) == 2)
state = Rules.new()
check("begin first shot", Rules.begin(state, 1, 0, 0.3, 1.2))
check("no concurrent preparation", not Rules.begin(state, 2, 0.1, 0.3, 1.2))
check("no early contact", Rules.contact(state, 0.299, true, true) == nil)
check("contact at windup boundary", Rules.contact(state, 0.3, true, true) == 1)
check("no duplicate shot", Rules.contact(state, 0.4, true, true) == nil)
check("cooldown enforced", not Rules.begin(state, 1, 1.199, 0.3, 1.2))
check("cooldown boundary accepted", Rules.begin(state, 1, 1.2, 0.3, 1.2))
check("shot interval includes preparation", Rules.contact(state, 1.5, true, true) == 1)
state = Rules.new(); Rules.begin(state, 1, 0, 0.3, 1.2)
check("revalidation cancels target behind wall", Rules.contact(state, 0.3, false, true) == nil and state.shot == nil)
check("cancel cannot revive on later tick", Rules.contact(state, 0.4, true, true) == nil)
state = Rules.new(); Rules.begin(state, 1, 0, 0.3, 1.2)
check("Finished cancels pending contact", Rules.contact(state, 0.3, true, false) == nil and state.shot == nil)
state = Rules.new(); Rules.begin(state, 1, 0, 0.3, 1.2); Rules.aggress(state, 2, 0.1, 3, true)
check("defensive aggro cancels previous windup", state.shot == nil)
check("new aggressor gets full windup", Rules.begin(state, 2, 0.1, 0.3, 1.2) and Rules.contact(state, 0.3, true, true) == nil)
check("new aggressor contacted once", Rules.contact(state, 0.4, true, true) == 2)
state = Rules.new(); Rules.begin(state, 1, 0, 0.3, 1.2)
check("destroy claimed once", Rules.destroy(state))
check("destroy cancels all targeting", state.shot == nil and state.target == nil and state.aggro == nil)
check("repeated destruction rejected", not Rules.destroy(state))
check("destroyed shot never resolves", Rules.contact(state, 1, true, true) == nil)
check("destroyed cannot attack", not Rules.begin(state, 1, 10, 0.3, 1.2))
check("destroyed cannot select", choose(state, pool, 10) == nil)
check("no friendly bounty", not Rules.claimReward(state, false))
check("confirmed team bounty", Rules.claimReward(state, true))
check("no duplicate bounty", not Rules.claimReward(state, true))
check("live tower has no bounty", not Rules.claimReward(Rules.new(), true))
check("connected active teammate rewarded without alive condition", Rules.recipient("Blue", "Blue", true, true, false))
check("enemy not rewarded", not Rules.recipient("Blue", "Red", true, true, false))
check("departed not rewarded", not Rules.recipient("Blue", "Blue", false, true, false))
check("eliminated not rewarded", not Rules.recipient("Blue", "Blue", true, true, true))
check("inactive not rewarded", not Rules.recipient("Blue", "Blue", true, false, false))
check("both structures recognized", Structures.isStructure("Base") and Structures.isStructure("Tower") and not Structures.isStructure("Summon"))
check("three towers protect base", not Structures.canReceive("Base", 3))
check("last tower protects base", not Structures.canReceive("Base", 1))
check("zero towers opens base", Structures.canReceive("Base", 0))
check("tower not shielded by other towers", Structures.canReceive("Tower", 3))
print("ALL PASS: " .. count .. " tower rules checks")
