--!strict
local Rules = require("../src/shared/Game/MatchState")
local Protocol = require("../src/shared/Game/RoundProtocol")
local count = 0
local function check(name: string, ok: boolean)
	assert(ok, name); count += 1; print("PASS Match lifecycle: " .. name)
end
local state = Rules.new({ "Blue", "Red" })
check("internal epoch begins at one", state.roundId == 1)
check("waits for full readiness", not Rules.advance(state, 0, 0, 2, 5, 5))
check("ready roster starts preparation", Rules.advance(state, 1, 2, 2, 5, 5))
check("departure cancels countdown", Rules.advance(state, 2, 1, 2, 5, 5) and state.phase == "WaitingForPlayers")
Rules.advance(state, 3, 2, 2, 5, 5)
check("fresh countdown", state.preparationEnds == 8)
check("does not start early", not Rules.advance(state, 7.9, 2, 2, 5, 5))
check("starts match", Rules.advance(state, 8, 2, 2, 5, 5) and state.phase == "InProgress")
check("first wave waits", not Rules.waveDue(state, 12.9, 20))
check("first wave starts", Rules.waveDue(state, 13, 20) and state.wave == 1)
check("active departures do not restart", not Rules.advance(state, 14, 0, 2, 5, 5))
check("core destruction selects winner", Rules.eliminate(state, "Red", 15) and state.winner == "Blue")
for _, now in { 15, 17, 25, 30, 100000 } do
	check("terminal result survives time", not Rules.advance(state, now, 10, 2, 5, 5) and state.phase == "Finished" and state.finishedAt == 15 and state.roundId == 1)
	check("terminal match has no waves", not Rules.waveDue(state, now, 20) and state.wave == 1)
	check("late opposite core cannot replace winner", not Rules.eliminate(state, "Blue", now) and state.winner == "Blue")
end
check("late joining player observes", Rules.assign(state, nil) == nil)
check("completed epoch still accepted structurally", Protocol.accepts(state.roundId, 1))
check("different epoch rejected", not Protocol.accepts(state.roundId, 2))
for _, value in { 0/0, math.huge, -1, 0, 1.5, "1", {}, false } do
	check("malformed epoch rejected", not Protocol.accepts(state.roundId, value))
end
check("missing epoch rejected", not Protocol.accepts(state.roundId, nil))
check("explicit isolated Studio accepts absent epoch", Protocol.acceptsClient(nil, nil, nil, true))
check("production without match rejects absent epoch", not Protocol.acceptsClient(nil, nil, nil, false))
check("isolated mode cannot admit invented epoch", not Protocol.acceptsClient(nil, 1, nil, true))
check("active match accepts matching epoch", Protocol.acceptsClient(1, 1, "InProgress", false))
check("active isolated flag does not bypass epoch", not Protocol.acceptsClient(1, 2, "InProgress", true))
check("finished match rejects matching epoch", not Protocol.acceptsClient(1, 1, "Finished", false))
check("isolated flag cannot bypass terminal state", not Protocol.acceptsClient(1, 1, "Finished", true))
check("state without epoch cannot masquerade as isolated", not Protocol.acceptsClient(nil, nil, "InProgress", true))
check("missing incoming epoch rejected in live match", not Protocol.acceptsClient(1, nil, "InProgress", false))
print("ALL PASS: " .. count .. " terminal match/protocol checks")
