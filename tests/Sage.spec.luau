--!strict
local S=require("../src/shared/Abilities/SageState")
local L=require("../src/shared/Abilities/StatLayers")
local Learning=require("../src/shared/Abilities/SkillLearning")
local count=0
local function check(name: string,ok: boolean) assert(ok,name); count+=1 end
local a,b=S.new("A",1,1),S.new("B",1,1)
local cast,reason,debit=S.request(a,0,1,1,5,100)
check("minimum6",not cast and reason=="Level" and debit==0 and a.cooldownAt==0)
cast,reason,debit=S.request(a,0,2,1,6,24)
check("mana rejection atomic",not cast and reason=="Mana" and debit==0 and a.cooldownAt==0)
cast,reason,debit=S.request(a,0,3,1,6,25); assert(cast)
check("rank1 exact debit cooldown prep",debit==25 and a.cooldownAt==150 and cast.readyAt==10)
check("chosen51cleanup47aura",cast.expiresAt==61 and cast.auraUntil==57)
check("no early refill",S.activate(a,9.999)==nil)
check("NaN clock cannot activate",S.activate(a,0/0)==nil and cast.phase=="Preparing")
check("infinite clock cannot activate",S.activate(a,math.huge)==nil and not cast.activated)
check("invalid clock cannot expire",not S.expire(a,math.huge) and not S.expire(a,0/0) and a.active==cast)
check("other player independent",b.active==nil and b.cooldownAt==0)
check("activates exact boundary",S.activate(a,10)==cast and cast.phase=="Active")
check("one activation only",S.activate(a,10)==nil and S.activate(a,30)==nil)
local again,why,cost=S.request(a,20,4,1,6,100)
check("cannot stack own active",not again and why=="Busy" and cost==0)
check("source restore tables",S.Source.ManaRestore[1]==200 and S.Source.ManaRestore[2]==350 and S.Source.ManaRestore[3]==500)
check("live until cleanup boundary",not S.expire(a,60.999) and S.expire(a,61))
check("cleanup one time",not S.expire(a,61))
again,why,cost=S.request(a,149.99,5,1,6,100)
check("cooldown not reset by expiry",not again and why=="Cooldown" and cost==0)
again,why,cost=S.request(a,150,6,2,9,100)
check("rank2 minimum10",not again and why=="Level")
again,why,cost=S.request(a,150,7,2,10,100); assert(again)
check("rank2 prep7",again.readyAt==157 and again.expiresAt==208 and cost==25)
local old=again; S.newLife(a,1,2)
check("life cancels pending",not S.live(a,old) and S.activate(a,157)==nil)
check("life retains cooldown",a.cooldownAt==300)
S.reset(a,2,3)
check("match reset cooldown",a.active==nil and a.cooldownAt==0 and a.lastRequest==0 and a.round==2)
cast,reason,debit=S.request(a,300,1,3,30,1000)
check("rank3 unknown HP fails closed",not cast and reason=="NotImplemented" and debit==0 and S.modifier(3)==nil)
cast,reason,debit=S.request(a,300,2,1,6,100); assert(cast)
check("cancel pending",S.cancel(a) and not S.cancel(a) and S.activate(a,310)==nil and a.cooldownAt==450)
cast,reason=S.request(a,500,2,1,6,100)
check("replay rejected",not cast and reason=="Replay")
cast,reason=S.request(a,500,0/0,1,6,100)
check("NaN rejected",not cast and reason=="Malformed")
cast,reason=S.request(b,0,1,2,10,100); assert(cast)
check("late update skips stale restore",S.activate(b,58)==nil and S.expire(b,58))
local m1,m2=S.modifier(1),S.modifier(2); assert(m1 and m2)
check("explicit attackHPspeed",m1.attack==10 and m1.health==150 and m1.speedWarcraft==105 and m2.attack==30 and m2.health==200)
check("inherited armor labeled policy",S.Policy.ArmorProvisional and m1.armor==3 and m2.armor==7)
local layers: L.Layers={}; local unrelated: L.Layers={}
L.set(layers,"Sage",{health=150,armor=3,attack=10,speed=105/16})
L.set(layers,"Sage",{health=150,armor=3,attack=10,speed=105/16})
check("idempotent modifier identity",L.sum(layers).health==150 and L.sum(layers).attack==10)
L.set(layers,"FutureLayer",{health=20,armor=2,attack=1,speed=1})
check("future layers additive not exclusive",L.sum(layers).health==170 and L.sum(layers).armor==5)
check("hero layer isolation",L.sum(unrelated).health==0)
L.set(layers,"Sage",nil)
check("remove only owned layer",L.sum(layers).health==20 and L.sum(layers).attack==1)
L.set(layers,"Sage",nil)
check("cleanup idempotent",L.sum(layers).health==20)
local profile={Level=5,SkillPoints=3,Learned={}}
check("learning min6",Learning.reason(profile,"SageMode")=="Level")
profile.Level=6; check("learn rank1 normally",Learning.learn(profile,"SageMode") and profile.SkillPoints==2)
check("rank2 not before10",Learning.reason(profile,"SageMode")=="Level")
profile.Level=10; check("learn rank2 normally",Learning.learn(profile,"SageMode") and profile.SkillPoints==1)
profile.Level=30; check("rank3 closed without spending",not Learning.learn(profile,"SageMode") and profile.SkillPoints==1 and profile.Learned.SageMode==2)
print("PASS Sage: "..count.." assertions")
