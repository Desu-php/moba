--!strict
local R = require("../src/shared/Game/JungleRules")
local count = 0
local function check(name: string, value: boolean) assert(value, name); count += 1 end
local c = R.new()
check("idle initially", c.mode == "Idle")
check("no activity before match", R.step(c, 0, false, 0, true, 4, 30) == "Stopped" and c.mode == "Idle")
check("acquire eligible target", R.step(c, 1, true, 0, true, 4, 30) == "Chasing")
check("leash inclusive", R.step(c, 2, true, 30, true, 30, 30) == "Chasing")
check("target beyond leash", R.step(c, 3, true, 12, true, 31, 30) == "Returning")
check("ignore reacquisition on return", R.step(c, 4, true, 10, true, 4, 30) == "Returning")
check("home restores idle", R.step(c, 5, true, 3, true, 4, 30) == "Idle")
check("own position beyond leash", R.step(c, 6, true, 31, true, 4, 30) == "Returning")
R.step(c, 7, true, 0, false, 0, 30)
check("lost target away returns", R.step(c, 8, true, 8, false, 0, 30) == "Returning")
R.die(c, 10, 45)
check("death cooldown", c.mode == "Dead" and c.respawnAt == 55)
R.die(c, 40, 45)
check("duplicate death no extension", c.respawnAt == 55)
check("not due early", R.step(c, 54.999, true, 0, false, 0, 30) == "Dead")
check("due exactly", R.step(c, 55, true, 0, false, 0, 30) == "Spawn")
check("terminal blocks due respawn", R.step(c, 1000, false, 0, false, 0, 30) == "Stopped")
check("independent camp", R.new().mode == "Idle" and c.mode == "Dead")
check("neutral vs active", R.hostile(true, false, false, true))
check("active vs neutral", R.hostile(false, true, true, false))
check("neutral vs neutral denied", not R.hostile(true, true, false, false))
check("neutral vs inactive denied", not R.hostile(true, false, false, false))
check("inactive vs neutral denied", not R.hostile(false, true, false, false))
check("ordinary hostility untouched", not R.hostile(false, false, true, true))
print("PASS Jungle: " .. count .. " assertions")
