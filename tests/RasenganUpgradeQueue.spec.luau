--!strict
local Queue=require("../src/shared/Abilities/RasenganUpgradeQueue")
local checks=0
local function check(value: boolean, label: string) assert(value,label); checks+=1 end
-- A human can type 1-Z-X faster than the previous Result/attributes replicate.
local q=Queue.new(12,"Rasengan",1.25,"Rasengan")
check(Queue.enqueue(q,"Odama",.02),"Z accepted while base is in flight")
check(Queue.enqueue(q,"Rasenshuriken",.03),"X accepted after explicitly queued Z")
check(#q.items==2,"two explicit ordered steps retained")
check(Queue.next(q,.04)==nil,"no transmission before base confirmation")
check(Queue.enqueue(q,"Odama",.05) and #q.items==2,"repeated Z cannot duplicate debit")
check(Queue.enqueue(q,"Rasenshuriken",.06) and #q.items==2,"repeated X cannot duplicate debit")
check(Queue.observe(q,12,"Rasengan",1.1,.1),"matching replicated base accepted")
check(Queue.next(q,.11)=="Odama","only next stage can transmit")
Queue.sent(q,"Odama",.11)
check(Queue.next(q,.12)==nil,"X waits for Odama result and attributes")
check(Queue.observe(q,12,"Rasengan",1.1,.13),"old attributes do not discard in-flight Odama")
check(Queue.next(q,.13)==nil,"old stage cannot release queued X")
check(Queue.observe(q,12,"Odama",1.2,.2),"Odama server deadline becomes queue deadline")
check(Queue.next(q,.21)=="Rasenshuriken","explicit X released once Odama replicated")
Queue.sent(q,"Rasenshuriken",.21)
check(Queue.enqueue(q,"Rasenshuriken",.22),"in-flight repeated X ignored")
check(#q.items==0,"no duplicate step remains")
check(not Queue.observe(q,12,"Rasenshuriken",0,.3) and q.closed,"final stage clears queue")
check(Queue.next(q,.31)==nil,"completed chain never casts again")

q=Queue.new(13,"Rasengan",1,nil)
check(Queue.enqueue(q,"Rasenshuriken",.1),"X selects RS directly without Z")
check(Queue.next(q,.11)=="Rasenshuriken","direct branch is next request")
q=Queue.new(13,"Rasengan",1,nil)
check(not Queue.enqueue(q,"ShadowClones",.1),"unrelated techniques never enter queue")
check(#q.items==0,"invalid inputs do not mutate queue")
check(Queue.enqueue(q,"Odama",.2),"valid next input still allowed")
check(Queue.next(q,1)==nil and q.closed,"exact server deadline expires queued input")
check(not Queue.observe(q,13,"Odama",2,1.1),"late replication cannot resurrect expired input")

q=Queue.new(14,"Rasengan",5,nil)
check(Queue.enqueue(q,"Odama",1),"queue starts for cast identity")
check(not Queue.observe(q,15,"Rasengan",5,1.1) and q.closed,"new cast cannot inherit old input")
check(Queue.next(q,1.2)==nil,"cast mismatch cannot replay")

q=Queue.new(16,"Rasengan",5,nil)
check(Queue.enqueue(q,"Odama",1),"explicit press before rejection")
Queue.clear(q)
check(Queue.next(q,1.1)==nil and #q.items==0,"rejection/death/menu cleanup clears pending press")

q=Queue.new(17,"Rasengan",2,nil)
check(Queue.enqueue(q,"Odama",.1),"upgrade before timeout")
Queue.sent(q,"Odama",.1)
check(Queue.enqueue(q,"Rasenshuriken",.2),"next explicit press buffered during request")
check(Queue.next(q,1.36)==nil and q.closed,"unanswered request is discarded after bounded wait")
check(not Queue.enqueue(q,"Rasenshuriken",1.4),"timeout never replays queued upgrade")
print("PASS RasenganUpgradeQueue: "..checks.." checks; explicit inputs, ordering, replication latency, expiry and cleanup")
