{
  "name": "AnimeBattlegroundsCombatTests",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": { "Shared": { "$path": "../src/shared" } },
    "ServerScriptService": {
      "Server": { "$path": "../src/server" },
      "CombatTests": { "$path": "studio/Runner.server.luau" }
    },
    "StarterPlayer": {
      "$properties": { "GameSettingsAvatar": "R15" },
      "StarterPlayerScripts": {
        "Client": { "$path": "../src/client" },
        "CombatTestDriver": { "$path": "studio/Driver.client.luau" }
      }
    },
    "Workspace": {
      "$attributes": { "CombatOnlyTest": true },
      "TestFloor": {
        "$className": "Part",
        "$properties": { "Anchored": true, "Size": [128, 1, 128], "Position": [0, -0.5, 0] }
      },
      "Spawn": {
        "$className": "SpawnLocation",
        "$properties": { "Anchored": true, "Duration": 0, "Size": [6, 1, 6], "Position": [20, 0.5, 0] }
      }
    }
  }
}
