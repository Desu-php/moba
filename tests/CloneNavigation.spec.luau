--!strict
local Policy = require("../src/shared/Abilities/CloneNavigationPolicy")
local Commands = require("../src/shared/Abilities/CloneCommands")
local count = 0
local function check(name: string, condition: boolean)
	assert(condition, name); count += 1; print("PASS clone navigation: " .. name)
end
local state = Policy.new()
check("initial request admitted", Policy.canRequest(state, 0))
Policy.change(state, "target-A")
local generation = Policy.begin(state, 0)
check("one request per clone in flight", not Policy.canRequest(state, 100))
check("completed path accepted", Policy.finish(state, generation, 0.1, true))
check("repath cooldown enforced", not Policy.canRequest(state, 0.79) and Policy.canRequest(state, 0.8))
generation = Policy.begin(state, 1)
Policy.change(state, "target-B")
check("target change drops old async result", not Policy.finish(state, generation, 1.1, true))
generation = Policy.begin(state, 2)
Policy.change(state, "idle")
check("stun or idle drops old route", not Policy.finish(state, generation, 2.1, true))
generation = Policy.begin(state, 3)
check("unreachable result recorded", Policy.finish(state, generation, 3.1, false))
check("failure backs off two seconds", not Policy.canRequest(state, 5.09) and Policy.canRequest(state, 5.1))
generation = Policy.begin(state, 6)
Policy.cancel(state)
check("death expiry reset removes pending result", not Policy.finish(state, generation, 7, true) and not Policy.canRequest(state, 100))
check("global concurrency and start limits bounded", Policy.MaxConcurrent == 2 and Policy.RequestInterval == 0.25)
for i = 1, 24 do
	local x, z = Policy.slot(i, 4.5, 3)
	check("slot ring " .. i, math.abs(math.sqrt(x*x+z*z) - (4.5 + math.floor((i-1)/Policy.SlotsPerRing)*3)) < 1e-6)
	for j = 1, i - 1 do
		local px, pz = Policy.slot(j, 4.5, 3)
		assert(math.sqrt((x-px)^2+(z-pz)^2) > 2.35, "distinct body slots")
	end
end
check("crossing a peer rejected", not Policy.clearPeer(0,0,10,0,5,0,2.35))
check("detour beside peer admitted", Policy.clearPeer(0,0,4,4,5,0,2.35))
check("overlap can separate", Policy.clearPeer(0,0,-1,0,0,0,2.35))
check("overlap cannot deepen", not Policy.clearPeer(1,0,0.5,0,0,0,2.35))
check("segment endpoint clearance enforced", not Policy.clearPeer(0,0,3,0,5,0,2.35))
local command = Commands.new("owner", 1, 1)
check("follow preserved", Commands.resolve(command).mode == "Follow")
Commands.assist(command,"A",true)
check("assist preserved", Commands.resolve(command).targetId == "A")
check("F command accepted", Commands.command(command,"owner",1,1,1,"B",true))
check("F overrides assist", Commands.resolve(command).targetId == "B")
Commands.invalidateTarget(command,"B")
check("invalid F target falls back to assist", Commands.resolve(command).targetId == "A")
Commands.invalidateTarget(command,"A")
check("vanished target falls back to follow", Commands.resolve(command).mode == "Follow")
check("hold order accepted", Commands.order(command,"owner",1,1,2,"Hold"))
Commands.assist(command,"A",true)
check("hold ignores autonomous assist", Commands.resolve(command).mode == "Hold" and Commands.resolve(command).targetId == nil)
check("foreign follow rejected", not Commands.order(command,"other",1,1,3,"Follow") and Commands.resolve(command).mode == "Hold")
check("stale-life follow rejected", not Commands.order(command,"owner",1,2,3,"Follow") and Commands.resolve(command).mode == "Hold")
check("attack releases hold", Commands.command(command,"owner",1,1,3,"B",true) and Commands.resolve(command).targetId == "B")
check("follow clears prior attack target", Commands.order(command,"owner",1,1,4,"Follow") and Commands.resolve(command).mode == "Follow")
check("replayed hold cannot override follow", not Commands.order(command,"owner",1,1,4,"Hold") and Commands.resolve(command).mode == "Follow")
check("unknown order rejected", not Commands.order(command,"owner",1,1,5,"Teleport") and Commands.resolve(command).mode == "Follow")
check("second hold accepted", Commands.order(command,"owner",1,1,6,"Hold"))
Commands.suspend(command)
check("suspended owner idles", Commands.resolve(command).mode == "Idle")
check("dead owner cannot follow", not Commands.order(command,"owner",1,1,7,"Follow"))
Commands.newLife(command,1,2)
check("respawn clears hold", Commands.resolve(command).mode == "Follow")
print("PASS CloneNavigation " .. count .. " checks")
