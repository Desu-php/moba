--!strict
local Definitions = require("../src/shared/Abilities/NarutoDefinitions")
local Rules = require("../src/shared/Abilities/NarutoRules").configure(Definitions)
local Rasengan = require("../src/shared/Abilities/RasenganState")
local Q = Rasengan.configure(Definitions.Rasengan)
local Clones = require("../src/shared/Abilities/CloneState")
local W = Clones.configure(Definitions.Clones)
local Commands = require("../src/shared/Abilities/CloneCommands")
local Units = require("../src/shared/Abilities/WorldUnits")
local count = 0
local function check(name: string, condition: boolean)
	assert(condition, name); count += 1; print("PASS Naruto domain: " .. name)
end
check("five source lines remain", #Definitions.Lines == 5)
for _, line in Definitions.Lines do check(line.Id .. " is not presented as runtime-ready", not line.RuntimeReady) end
check("definitions immutable", table.isfrozen(Definitions) and table.isfrozen(Definitions.Clones.Counts))
check("map Hpal attributes remain separate", Definitions.Hero.Strength == 16 and Definitions.Hero.Agility == 15 and Definitions.Hero.Intelligence == 14)
check("map levelcap30 is retained", Definitions.Hero.MapLevelCap == 30)
check("native mana estimates not runtime-certified", not Definitions.NativeInference.RuntimeCertified)
check("central scale converts cast range", Units.toStuds(2000) == 125)
check("central scale converts clone payload push", Units.toStuds(600) == 37.5)
check("central scale preserves relative travel time", math.abs(Units.toStuds(2000) / Units.toStuds(270) - 2000 / 270) < 1e-10)
check("scale is explicitly a prototype adaptation", Units.SourceStatus == "PrototypeAdaptation")
local a = Rasengan.new("naruto-a", 1, 1)
local b = Rasengan.new("naruto-b", 1, 1)
local cast, reason, debit = Q.request(a, 0, 1, 100, true)
assert(cast)
check("Q accepted and commands one 100 debit", reason == "Accepted" and debit == 100)
check("Q no immediate damage", cast.targetId == nil and not cast.impacted)
check("Q cooldown and native held lifetime", a.cooldownAt == 60 and cast.expiresAt == 15)
check("Q preparation lasts two seconds", cast.readyAt == 2 and cast.phase == "Preparing")
local _, replay, replayDebit = Q.request(a, 0, 1, 100, true)
check("duplicate Q cannot charge again", replay == "Replay" and replayDebit == 0)
local _, busy, busyDebit = Q.request(a, 0, 2, 100, true)
check("spam Q cannot replace cast or charge", busy == "Busy" and busyDebit == 0 and a.active == cast)
check("cannot attack while preparing", not Q.attack(a, cast, 1.999, "victim", true, false))
Q.update(a, 2)
check("Q transitions to holding", cast.phase == "Holding")
check("allied target does not consume", not Q.attack(a, cast, 2, "friend", false, false) and cast.phase == "Holding")
check("structure does not consume", not Q.attack(a, cast, 2, "tower", true, true) and cast.phase == "Holding")
check("another Naruto cannot consume cast", not Q.attack(b, cast, 2, "victim", true, false))
check("first enemy attack consumes", Q.attack(a, cast, 2, "victim", true, false))
check("second attack cannot consume", not Q.attack(a, cast, 2, "other", true, false))
check("consumed attack keeps native held buff until impact", Q.hasMarker(a, 2))
check("control waits initial .01 callback", Q.claimControl(a, cast, 2.009) == nil)
check("impact requires control callback", Q.claimImpact(a, cast, 3) == nil)
local controlledTarget, stun = Q.claimControl(a, cast, 2.01)
check("control applies target stun before damage", controlledTarget == "victim" and stun == 3.5)
check("control callback claims once", Q.claimControl(a, cast, 2.01) == nil)
check("impact delay follows control", Q.claimImpact(a, cast, 3.009) == nil)
local target = Q.claimImpact(a, cast, 3.01)
check("impact target after one-second control wait", target == "victim")
check("base raw formula fixture 250", Rules.rasenganDamage(10, 30) == 250)
check("current STR at impact changes formula", Rules.rasenganDamage(10, 50) == 270)
check("spell impact occurs once", Q.claimImpact(a, cast, 4) == nil)
check("consumed marker gone", not Q.hasMarker(a, 4))
check("spell use retains cooldown", a.cooldownAt == 60)
local _, cooldown = Q.request(a, 59.999, 3, 100, true)
check("Q cooldown before boundary", cooldown == "Cooldown")
local expiry = Q.request(a, 60, 4, 100, true); assert(expiry)
check("Q available exactly at cooldown", expiry.id ~= cast.id)
Q.update(a, 75)
check("unused Q expires without impact", a.active == nil and Q.claimImpact(a, expiry, 76) == nil and a.cooldownAt == 120)
local poor = Rasengan.new("poor", 1, 1)
local _, insufficient, insufficientDebit = Q.request(poor, 0, 1, 99, true)
check("insufficient mana no cooldown/debit", insufficient == "Mana" and insufficientDebit == 0 and poor.cooldownAt == 0)
local _, unavailable = Q.request(poor, 0, 2, 100, false)
check("dead/ineligible cannot start Q", unavailable == "Unavailable")
for _, bad in { 0/0, math.huge, -math.huge } do
	check("nonfinite formula rejected", Rules.rasenganDamage(10, bad) == nil)
	check("nonfinite request rejected", Q.request(poor, bad, 3, 100, true) == nil)
end
for rank, expected in { 3, 4, 5, 7 } do
	local plan = Rules.clonePlan(rank, "Point", 0, 1000); assert(plan)
	check("W rank " .. rank .. " count", plan.kind == "Burst" and plan.count == expected)
	check("W rank " .. rank .. " cooldown", plan.cooldown == Definitions.Clones.Cooldowns[rank])
	check("W rank " .. rank .. " native cost metadata", plan.nativeManaCost == 200)
end
local mass = Rules.clonePlan(4, "Self", 300, 1000); assert(mass)
check("post-native-cost 30 percent admits 30", mass.count == 30 and mass.extraManaDrain == 300)
local fallback = Rules.clonePlan(4, "Self", 299, 1000); assert(fallback)
check("below threshold falls back to seven", fallback.count == 7 and fallback.extraManaDrain == 0)
local point = Rules.clonePlan(4, "Point", 1000, 1000); assert(point)
check("point does not get self mass branch", point.count == 7 and point.extraManaDrain == 0)
local sleep = Rules.clonePlan(2, "Enemy", 0, 1000); assert(sleep)
check("enemy branch is sleep only", sleep.kind == "Sleep" and sleep.count == 0)
check("sleep cosmetic count separate", Definitions.Clones.SleepCosmetics == 5 and Definitions.Clones.SleepDuration == 3)
check("rank1 enemy not admitted", Rules.clonePlan(1, "Enemy", 800, 1000) == nil)
check("allied nonself not admitted", Rules.clonePlan(2, "Ally", 800, 1000) == nil)
for _, rank in { -1, 0, 1.5, 5, math.huge, 0/0 } do check("bad W rank rejected", Rules.clonePlan(rank, "Self", 800, 1000) == nil) end
check("bad resource values rejected", Rules.clonePlan(4, "Self", 1001, 1000) == nil)
local ca = Clones.new("naruto-a", 1, 1)
local cb = Clones.new("naruto-b", 1, 1)
local burst = W.begin(ca, 0, 1, 3, 50); assert(burst)
check("burst not synchronous", W.spawnOne(ca, burst, 0, true, true) == nil)
local first = W.spawnOne(ca, burst, 0.01, true, true); assert(first)
check("clone owner isolated", first.ownerId == "naruto-a" and cb.clones[first.id] == nil)
check("clone lifetime 20 seconds", first.expiresAt == 20.01)
check("clone outgoing 30 percent incoming 20x", first.outgoingMultiplier == 0.3 and first.incomingMultiplier == 20)
check("clone has no second HP reduction", (first :: any).maxHealthMultiplier == nil)
check("fresh clone inherits held marker", first.hasPayload)
check("another owner cannot consume marker", Clones.takePayload(cb, first, 0.01, "victim", true, false) == nil and first.hasPayload)
check("clone allied attack does not consume", Clones.takePayload(ca, first, 0.01, "friend", false, false) == nil and first.hasPayload)
check("clone structure attack does not consume", Clones.takePayload(ca, first, 0.01, "tower", true, true) == nil and first.hasPayload)
local payload = Clones.takePayload(ca, first, 0.01, "victim", true, false); assert(payload)
check("marker consumed atomically", not first.hasPayload and Clones.takePayload(ca, first, 0.01, "victim", true, false) == nil)
check("payload uses original owner", payload.ownerId == "naruto-a")
local sameIdentity = Clones.new("naruto-a", 1, 1)
check("payload belongs to exact hero state instance", Clones.claimPayload(sameIdentity, payload) == nil)
local forged: Clones.Payload = { cloneId = payload.cloneId, ownerId = payload.ownerId, round = payload.round,
	life = payload.life, targetId = "forged", claimed = false }
check("copied payload fields cannot forge admission", Clones.claimPayload(ca, forged) == nil)
check("payload raw49 formula", Rules.clonePayloadDamage(10, 30) == 49)
check("clone payload does not copy original stun", (payload :: any).stun == nil)
check("payload source distance retains units", Definitions.Clones.PayloadDisplacementWarcraft == 600 and Definitions.Clones.PayloadDisplacementDuration == 0.5)
check("payload claims once", Clones.claimPayload(ca, payload) == "victim" and Clones.claimPayload(ca, payload) == nil)
check("same burst cannot advance early", W.spawnOne(ca, burst, 0.019, true, true) == nil)
local second = W.spawnOne(ca, burst, 0.02, true, false); assert(second)
check("W before Q has no retroactive marker", not second.hasPayload)
check("W replay does not duplicate burst", select(2, W.begin(ca, 0.02, 1, 3, 50)) == "Replay")
check("W spam does not replace burst", select(2, W.begin(ca, 0.02, 2, 3, 50)) == "Busy")
check("dead hero stops remaining burst", W.spawnOne(ca, burst, 0.03, false, false) == nil and ca.burst == nil)
check("death does not purge completed clones", ca.clones[first.id] == first and ca.clones[second.id] == second)
check("clone not expired early", #Clones.expire(ca, 20.009) == 0)
check("clone expires once", #Clones.expire(ca, 20.01) == 1 and #Clones.expire(ca, 20.01) == 0)
check("remaining clone has independent expiry", ca.clones[second.id] == second)
local deathState = Rasengan.new("dead", 1, 1)
local dying = Q.request(deathState, 0, 1, 100, true); assert(dying)
assert(Q.attack(deathState, dying, 2, "victim", true, false))
assert(Q.claimControl(deathState, dying, 2.01) ~= nil)
Rasengan.newLife(deathState, 2)
check("death cancels pending Q damage", Q.claimImpact(deathState, dying, 3.01) == nil)
check("death cancels pending control callbacks", Q.claimControl(deathState, dying, 3.01) == nil)
check("respawn retains Q cooldown", deathState.cooldownAt == 60)
Rasengan.reset(deathState, 2, 3)
check("round resets Q cooldown", deathState.cooldownAt == 0)
check("old round cast invalid", not Rasengan.current(deathState, dying))
local db = W.begin(cb, 0, 1, 3, 50); assert(db)
local dc = W.spawnOne(cb, db, 0.01, true, true); assert(dc)
local dp = Clones.takePayload(cb, dc, 0.01, "victim", true, false); assert(dp)
Clones.newLife(cb, 2)
check("death invalidates pending clone payload", Clones.claimPayload(cb, dp) == nil)
check("respawn retains ordinary clone record", cb.clones[dc.id] == dc and not dc.hasPayload)
check("old burst cannot spawn on respawn", W.spawnOne(cb, db, 1, true, true) == nil)
Clones.reset(cb, 2, 3)
check("round resets clones and cooldown", next(cb.clones) == nil and cb.cooldownAt == 0)
check("stale clone cannot consume after reset", Clones.takePayload(cb, dc, 2, "victim", true, false) == nil)
local manyA = Clones.new("many-a", 1, 1)
local manyB = Clones.new("many-b", 1, 1)
local ba = W.begin(manyA, 0, 1, 30, 38); assert(ba)
local bb = W.begin(manyB, 0, 1, 30, 38); assert(bb)
for i = 1, 30 do
	local at = i * 0.02
	assert(W.spawnOne(manyA, ba, at, true, false))
	assert(W.spawnOne(manyB, bb, at, true, false))
end
check("two owners complete thirty-clone bursts independently", manyA.serial == 30 and manyB.serial == 30 and manyA.burst == nil and manyB.burst == nil)
check("completed burst cannot spawn again", W.spawnOne(manyA, ba, 1, true, false) == nil)
local laterBurst = W.begin(manyA, 38, 2, 3, 38); assert(laterBurst)
check("new burst does not erase existing clone records", manyA.clones[1] ~= nil)
check("mass clone cleanup occurs once per clone", #Clones.expire(manyB, 21) == 30 and #Clones.expire(manyB, 21) == 0)
local qa = Rasengan.new("a", 2, 1)
local qb = Rasengan.new("b", 2, 1)
local q1 = Q.request(qa, 0, 1, 100, true); assert(q1)
local q2 = Q.request(qb, 0, 1, 100, true); assert(q2)
assert(Q.attack(qa, q1, 2, "target-a", true, false))
assert(Q.attack(qb, q2, 2, "target-b", true, false))
assert(Q.claimControl(qa, q1, 2.01) ~= nil)
assert(Q.claimControl(qb, q2, 2.01) ~= nil)
check("two simultaneous Narutos keep own targets", Q.claimImpact(qa, q1, 3.01) == "target-a" and Q.claimImpact(qb, q2, 3.01) == "target-b")
local lateState = Rasengan.new("late-control", 1, 1)
local lateCast = Q.request(lateState, 0, 1, 100, true); assert(lateCast)
assert(Q.attack(lateState, lateCast, 2, "target", true, false))
assert(Q.claimControl(lateState, lateCast, 3) ~= nil)
check("late control still waits full second before damage", Q.claimImpact(lateState, lateCast, 3.999) == nil and Q.claimImpact(lateState, lateCast, 4) == "target")
local groupA = Commands.new("a", 1, 1)
local groupB = Commands.new("b", 1, 1)
check("clones follow own owner by default", Commands.resolve(groupA).mode == "Follow" and Commands.resolve(groupA).ownerId == "a")
Commands.assist(groupA, "owner-target", true)
check("clones assist owner target", Commands.resolve(groupA).mode == "Assist" and Commands.resolve(groupA).targetId == "owner-target")
check("another owner cannot issue command", select(2, Commands.command(groupA, "b", 1, 1, 1, "victim", true)) == "Owner")
check("foreign command does not consume request sequence", groupA.lastRequest == 0)
check("current owner can command selected enemy", Commands.command(groupA, "a", 1, 1, 1, "selected", true))
check("explicit command takes precedence over assist", Commands.resolve(groupA).mode == "Command" and Commands.resolve(groupA).targetId == "selected")
check("command cannot affect another Naruto group", Commands.resolve(groupB).mode == "Follow")
check("replayed command cannot retarget", select(2, Commands.command(groupA, "a", 1, 1, 1, "other", true)) == "Replay" and Commands.resolve(groupA).targetId == "selected")
check("friendly or invalid enemy cannot be commanded", select(2, Commands.command(groupA, "a", 1, 1, 2, "friend", false)) == "Target")
check("bad target leaves prior command intact", Commands.resolve(groupA).targetId == "selected")
Commands.invalidateTarget(groupA, "selected")
check("lost commanded target falls back to assist", Commands.resolve(groupA).mode == "Assist")
Commands.invalidateTarget(groupA, "owner-target")
check("lost assist target falls back to follow", Commands.resolve(groupA).mode == "Follow")
Commands.assist(groupA, "friend", false)
check("friendly target does not become assist target", Commands.resolve(groupA).mode == "Follow")
Commands.suspend(groupA)
check("owner death suspends group intent", Commands.resolve(groupA).mode == "Idle")
check("dead owner cannot command", select(2, Commands.command(groupA, "a", 1, 1, 3, "enemy", true)) == "Unavailable")
Commands.newLife(groupA, 2, 2)
check("new life clears targets", Commands.resolve(groupA).mode == "Follow")
check("stale round command rejected", select(2, Commands.command(groupA, "a", 1, 1, 4, "enemy", true)) == "StaleLife")
check("stale life command rejected", select(2, Commands.command(groupA, "a", 2, 1, 4, "enemy", true)) == "StaleLife")
check("new life retains replay high-water mark", select(2, Commands.command(groupA, "a", 2, 2, 3, "enemy", true)) == "Replay")
for _, bad in { 0/0, math.huge, -math.huge, 0, 1.5 } do
	check("malformed command request rejected", select(2, Commands.command(groupA, "a", 2, 2, bad, "enemy", true)) == "Malformed")
end
print("ALL PASS: " .. count .. " Naruto Legend domain checks (not Roblox parity)")
