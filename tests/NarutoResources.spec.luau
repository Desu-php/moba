--!strict
local Definitions = require("../src/shared/Abilities/NarutoDefinitions")
local Resource = require("../src/shared/Abilities/NarutoResources")
local Rules = Resource.configure(Definitions.Hero, Definitions.NativeInference)
local count = 0
local function check(name: string, condition: boolean) assert(condition, name); count += 1; print("PASS Naruto resources: " .. name) end
local first = Rules.values(1, 0)
check("source starting STR16", first.rawStrength == 16 and first.strength == 16)
check("native inference mana1510", first.maxMana == 1510)
check("native inference regen .71", math.abs(first.regen - 0.71) < 1e-9)
local higher = Rules.values(2, 0)
check("fractional growth retained separately", math.abs(higher.rawStrength - 17.4) < 1e-9 and higher.strength == 17)
check("native inference INT growth", higher.intelligence == 15 and higher.maxMana == 1525)
check("impact bonuses read currently", Rules.values(10, 2).strength == 30)
local pool = Resource.new(first, 10)
check("initial mana clamped full rather than 9999", pool.mana == 1510 and pool.mana == pool.maximum)
check("Q debit exact", Resource.spend(pool, 100) and pool.mana == 1410)
check("W debit exact", Resource.spend(pool, 200) and pool.mana == 1210)
check("insufficient mana cannot partially debit", not Resource.spend(pool, 1300) and pool.mana == 1210)
check("negative debit cannot grant mana", not Resource.spend(pool, -100) and pool.mana == 1210)
Resource.update(pool, 20)
check("elapsed time regen", math.abs(pool.mana - 1217.1) < 1e-9)
Resource.update(pool, 20)
check("same tick cannot regen twice", math.abs(pool.mana - 1217.1) < 1e-9)
Resource.update(pool, 19)
check("clock rollback cannot change pool", math.abs(pool.mana - 1217.1) < 1e-9 and pool.at == 20)
Resource.recalculate(pool, higher, 20)
check("level increase does not grant unconfirmed refill", math.abs(pool.mana - 1217.1) < 1e-9 and pool.maximum == 1525)
Resource.update(pool, 10000)
check("regen clamps maximum", pool.mana == 1525)
Resource.recalculate(pool, first, 10000)
check("max reduction clamps current mana", pool.mana == 1510)
for _, bad in { 0/0, math.huge, -math.huge } do
	check("nonfinite debit rejected", not Resource.spend(pool, bad))
	Resource.update(pool, bad); check("nonfinite clock ignored", pool.mana == 1510)
end
print("ALL PASS: " .. count .. " Naruto resource checks (native inference, not engine certification)")
