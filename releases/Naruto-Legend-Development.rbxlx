            <Properties>
              <string name="Name">HeroMotionController</string>
              <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Poses = require(Shared.Combat.HeroPoses)
local Config = require(Shared.Config.AbilityConfig)
local Combat = require(Shared.Config.CombatConfig)
local Ids = require(Shared.Config.AnimationIds)
local RigJoints = require(Shared.Combat.RigJoints)
type Prediction = { id: number, key: string, at: number, duration: number }
type Rig = { model: Model, humanoid: Humanoid, root: BasePart, joints: { RigJoints.Entry }, poses: { [Instance]: CFrame },
	tracks: { [string]: AnimationTrack }, animations: { Animation }, animate: LocalScript?, animateEnabled: boolean,
	key: string, track: AnimationTrack?, owned: boolean }
local Motion = {}
local rigs: { [Model]: Rig } = {}
local prediction: Prediction? = nil
local started = false
local nextScan = 0
function Motion.Predict(id: number, key: string, at: number, duration: number)
	prediction = { id = id, key = key, at = at, duration = duration }
end
function Motion.StopPrediction(id: number?) if not id or (prediction and prediction.id == id) then prediction = nil end end
local function remove(model: Model)
	local rig = rigs[model]; if not rig then return end
	for _, entry in rig.joints do if entry.joint.Parent then entry.joint.Transform = CFrame.identity end end
	for _, track in rig.tracks do track:Stop(0); track:Destroy() end
	for _, animation in rig.animations do animation:Destroy() end
	if rig.animate and rig.animate.Parent then rig.animate.Enabled = rig.animateEnabled end
	rigs[model] = nil
end
local function bind(model: Model)
	if rigs[model] then rigs[model].joints = RigJoints.Collect(model); return end
	local humanoid = model:FindFirstChildOfClass("Humanoid"); local root = model:FindFirstChild("HumanoidRootPart")
	if not humanoid or humanoid.Health <= 0 or humanoid.RigType ~= Enum.HumanoidRigType.R15 or not root or not root:IsA("BasePart") then return end
	local joints = RigJoints.Collect(model)
	if #joints == 0 then return end -- Refresh as streamed limbs arrive; do not require 15 legacy motors.
	local localOwner = model == Players.LocalPlayer.Character
	local animate = model:FindFirstChild("Animate")
	local scriptAnimate = if localOwner and animate and animate:IsA("LocalScript") then animate else nil
	local rig: Rig = { model = model, humanoid = humanoid, root = root, joints = joints, poses = {}, tracks = {}, animations = {},
		animate = scriptAnimate, animateEnabled = if scriptAnimate then scriptAnimate.Enabled else false,
		key = "", track = nil, owned = localOwner }
	if scriptAnimate and model:GetAttribute("HeroId") then
		scriptAnimate.Enabled = false
		local animator = humanoid:FindFirstChildOfClass("Animator")
		if animator then for _, track in animator:GetPlayingAnimationTracks() do if track.Priority == Enum.AnimationPriority.Core then track:Stop(0.1) end end end
	end
	rigs[model] = rig
end
local function active(rig: Rig, now: number): (string, number, number)
	local model = rig.model
	local throwAt=model:GetAttribute("RasenshurikenThrowAt")
 if typeof(throwAt)=="number" and now>=throwAt and now<throwAt+.8 then return "RasenshurikenThrow",throwAt,.8 end
	local variant = model:GetAttribute("RasenganVariant")
	local technique = if variant == "Odama" or variant == "Rasenshuriken" then variant else "Rasengan"
	local function attackKey(key: string): string
		return if model:GetAttribute("RasenganHeld") == true and (string.match(key,"^Punch%d$") or key == "HeavyPunch") then technique.."Strike" else key
	end
	if model:GetAttribute("NativeMeditationClone")==true then return "Meditation",now,1 end
	local sageReady=model:GetAttribute("SageReadyAt")
 if model:GetAttribute("SagePhase")=="Preparing" and typeof(sageReady)=="number" and now<sageReady then return "SagePrepare",now,1 end
 local rangedUntil=model:GetAttribute("RangedPreparingUntil");local rangedAt=model:GetAttribute("RangedCastStartedAt")
 if typeof(rangedUntil)=="number" and typeof(rangedAt)=="number" and now<rangedUntil then
  if now<rangedAt+1.3 then return "RasenganPrepare",rangedAt,1.3 else return "RasenganStrike",rangedAt+1.3,.2 end
 end
 local selfPause = model:GetAttribute("RasenganSelfPauseUntil")
	local ownPause = typeof(selfPause)=="number" and now<selfPause
	local phase = model:GetAttribute("RasenganPhase")
	local impact = model:GetAttribute("RasenganImpactAt")
	if phase=="Consumed" and ownPause and typeof(impact)=="number" and impact>now then
		local impactDelay = if technique == "Rasenshuriken" then .5 else 1
		return technique.."Strike",impact-impactDelay,impactDelay
	end
	local rasenganAt = model:GetAttribute("RasenganStartedAt"); local ready = model:GetAttribute("RasenganReadyAt")
	-- Begin gathering immediately, including the one-second selection window.
	-- Presentation alone never introduces a new movement or input lock.
	if phase=="Preparing" and typeof(rasenganAt)=="number" and typeof(ready)=="number" and now>=rasenganAt and now<ready then return technique.."Prepare",rasenganAt,ready-rasenganAt end
	if model:GetAttribute("RasenganHelper")==true then return "RasenganHelper",0,1 end
	if model:GetAttribute("CombatState") == "Stunned" then return "Stun", now, 1 end
	local ability = model:GetAttribute("AbilityId")
	if typeof(ability) == "string" and ability ~= "" then
		local at = model:GetAttribute("AbilityStartedAt"); local ends = model:GetAttribute("AbilityEndsAt")
		if typeof(at) == "number" and typeof(ends) == "number" and now < ends then return ability, at, ends - at end
	end
	local intent = if rig.owned then prediction else nil
	if intent and now < intent.at + intent.duration then return attackKey(intent.key), intent.at, intent.duration end
	local swingAt = model:GetAttribute("SummonSwingAt")
	if typeof(swingAt) == "number" and now < swingAt + 0.28 then return "Punch" .. tostring(model:GetAttribute("SummonSwingStep") or 1), swingAt, 0.28 end
	local ends, at = model:GetAttribute("CombatAttackEndsAt"), model:GetAttribute("CombatLastAttackAt")
	if typeof(ends) == "number" and typeof(at) == "number" and now < ends then
		return attackKey("Punch1"), at, ends - at
	end
	local velocity = rig.root.AssemblyLinearVelocity * Vector3.new(1, 0, 1)
	return if velocity.Magnitude > 1.5 or model:GetAttribute("SummonMoving") == true then "Run" else "Idle", 0, 1
end
local function hasPublished(rig: Rig, key: string, at: number, duration: number): boolean
	local animator = rig.humanoid:FindFirstChildOfClass("Animator"); if not animator then return false end
	local profile = Combat.Profiles[tostring(rig.model:GetAttribute("CombatProfileId"))] or Combat.Profiles.Default
	local set = Ids[profile.AnimationSet]; local id = if set then set[key] else nil
	if not id or id == "" or rig.model:GetAttribute("EntityKind") == "Summon" then return false end
	local m1 = key == "HeavyPunch" or string.match(key, "^Punch%d$") ~= nil
	-- M1 tracks belong to AnimationController, including local prediction. Observers only inspect replication.
	if rig.owned and not m1 and rig.model:GetAttribute("TrackReady_" .. key) == true then
		local track = rig.tracks[key]
		if not track then
			local animation = Instance.new("Animation"); animation.AnimationId = id; table.insert(rig.animations, animation)
			local ok, loaded = pcall(function() return animator:LoadAnimation(animation) end)
			if ok then track = loaded; rig.tracks[key] = loaded end
		end
		if track and track.Length > 0 then
			if rig.track ~= track or rig.key ~= key then
				if rig.track then rig.track:Stop(Combat.AnimationFadeTime) end
				track.Looped = key == "Idle" or key == "Run" or key == "Stun"
				track.Priority = if key == "Idle" then Enum.AnimationPriority.Idle elseif key == "Run" then Enum.AnimationPriority.Movement else Enum.AnimationPriority.Action
				track:Play(Combat.AnimationFadeTime)
				if not track.Looped then track.TimePosition = math.min(math.max(0, workspace:GetServerTimeNow() - at), duration) end
				rig.track = track
			end
		end
	end
	for _, track in animator:GetPlayingAnimationTracks() do
		if track.Animation and track.Animation.AnimationId == id and track.Length > 0 and track.IsPlaying then return true end
	end
	return false
end
function Motion.GetDiagnostics(model: Model): (string?, number)
	local rig = rigs[model]; if not rig then return nil, 0 end
	local moved = 0
	for _, entry in rig.joints do local x, y, z = entry.joint.Transform:ToOrientation(); if math.abs(x) + math.abs(y) + math.abs(z) > 0.05 then moved += 1 end end
	return rig.key, moved
end
function Motion.Start()
	if started then return end; started = true
	Players.LocalPlayer.CharacterRemoving:Connect(function(model) prediction = nil; remove(model) end)
	-- Animator evaluates after PreAnimation. Apply fallback joint transforms in PreSimulation.
	RunService.PreSimulation:Connect(function(dt)
		local now = workspace:GetServerTimeNow()
		if now >= nextScan then
			nextScan = now + 0.25
			for _, player in Players:GetPlayers() do if player.Character then bind(player.Character) end end
			local summons = workspace:FindFirstChild("HeroSummons")
			if summons then for _, model in summons:GetChildren() do if model:IsA("Model") then bind(model) end end end
			local visuals = workspace:FindFirstChild("LocalHeroVFX")
			if visuals then for _, model in visuals:GetChildren() do if model:IsA("Model") and model:GetAttribute("RasenganHelper")==true then bind(model) end end end
		end
		for model, rig in rigs do
			if not model:IsDescendantOf(workspace) or rig.humanoid.Health <= 0 then remove(model); continue end
			if rig.owned and model:GetAttribute("HeroId") then
				local animate = model:FindFirstChild("Animate")
				if animate and animate:IsA("LocalScript") then
					if not rig.animate then rig.animate = animate; rig.animateEnabled = animate.Enabled end
					animate.Enabled = false
				end
			end
			local camera = workspace.CurrentCamera
			if camera and (camera.CFrame.Position - rig.root.Position).Magnitude > Config.Visual.ViewDistance and not rig.owned then continue end
			local key, at, duration = active(rig, now)
			if rig.track and rig.key ~= key then rig.track:Stop(Combat.AnimationFadeTime); rig.track = nil end
			local holding = model:GetAttribute("RasenganVisible")==true and (key=="Idle" or key=="Run")
			local published = not holding and hasPublished(rig, key, at, duration)
			rig.key = key
			if published then table.clear(rig.poses); continue end
			if not model:GetAttribute("HeroId") and (key == "Idle" or key == "Run") then
				for _, entry in rig.joints do if entry.joint.Parent then entry.joint.Transform = CFrame.identity end end
				table.clear(rig.poses); continue
			end
			local pose = Poses.sample(key, now, math.clamp((now - at) / math.max(0.001, duration), 0, 1))
			if holding then pose = Poses.holdRasengan(pose,now,tostring(model:GetAttribute("RasenganVariant"))) end
			if (key == "RasenganPrepare" or key == "OdamaPrepare" or key == "RasenshurikenPrepare")
				and rig.humanoid.WalkSpeed > 0 and (rig.root.AssemblyLinearVelocity*Vector3.new(1,0,1)).Magnitude > 1.5 then
				local run = Poses.sample("Run",now,0)
				for _, joint in {"LeftHip","RightHip","LeftKnee","RightKnee"} do pose[joint] = run[joint] end
			end
			local alpha = 1 - math.exp(-Config.Visual.BlendSpeed * dt)
			for _, entry in rig.joints do
				local motor = entry.joint
				if not motor.Parent then continue end
				local angle = pose[entry.key]
				local target = if angle then CFrame.Angles(angle[1], angle[2], angle[3]) else CFrame.identity
				local current = (rig.poses[motor] or CFrame.identity):Lerp(target, alpha)
				motor.Transform = current; rig.poses[motor] = current
			end
		end
	end)
end
return Motion
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="147">
            <Properties>
              <string name="Name">InputController</string>
              <string name="Source"><![CDATA[--!strict

local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local CombatController = require(script.Parent.CombatController)
local Camera = require(script.Parent.CameraController)
local Abilities = require(script.Parent.AbilityController)
local CameraRules = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared").Combat.CombatCameraRules)
local AbilityConfig = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared").Config.AbilityConfig)
local interruptKeys: { [string]: boolean } = {}
for _, ability in AbilityConfig.Abilities do interruptKeys[ability.Key] = true end
for key in (AbilityConfig.InputAliases :: { [string]: string }) do interruptKeys[key] = true end
interruptKeys.R = true; interruptKeys.Y = true -- Follow/Hold orders also release a held attack.

local InputController = {}
local started = false
local held = false
local nextPoll = 0

function InputController.Start()
	if started then
		return
	end
	started = true
	local player = game:GetService("Players").LocalPlayer
	if UserInputService.KeyboardEnabled then
		-- Own PC locomotion so user-selected ClickToMove never competes with aim clicks.
		-- The existing Humanoid still applies authoritative speed, jump and control locks.
		task.spawn(function()
			local scripts = player:WaitForChild("PlayerScripts")
			local module = scripts:WaitForChild("PlayerModule", 15)
			if module and module:IsA("ModuleScript") then
				-- Roblox injects PlayerModule at runtime, outside the Rojo source map.
				local loadRuntimeModule: any = require
				local defaultPlayer = loadRuntimeModule(module)
				defaultPlayer:GetControls():Disable()
			end
		end)
		RunService:BindToRenderStep("CombatMovement", Enum.RenderPriority.Character.Value + 1, function()
			local character = player.Character
			local humanoid = if character then character:FindFirstChildOfClass("Humanoid") else nil
			if not humanoid then return end
			if not Camera.IsCaptured() or humanoid.Health <= 0 then player:Move(Vector3.zero, false); humanoid.Jump = false; return end
			local x = (if UserInputService:IsKeyDown(Enum.KeyCode.D) then 1 else 0) - (if UserInputService:IsKeyDown(Enum.KeyCode.A) then 1 else 0)
			local z = (if UserInputService:IsKeyDown(Enum.KeyCode.S) then 1 else 0) - (if UserInputService:IsKeyDown(Enum.KeyCode.W) then 1 else 0)
			x, z = CameraRules.move(x, z)
			player:Move(Vector3.new(x, 0, z), true)
			humanoid.Jump = UserInputService:IsKeyDown(Enum.KeyCode.Space)
		end)
	end
	UserInputService.InputBegan:Connect(function(input: InputObject, gameProcessed: boolean)
		-- A skill/command key interrupts a held attack; it cannot manufacture M1.
		if interruptKeys[input.KeyCode.Name] then held = false end
		if gameProcessed or not Camera.IsCaptured() then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			if game:GetService("Players").LocalPlayer:GetAttribute("SelectingCloneTarget") == true then return end
			local playerGui = game:GetService("Players").LocalPlayer:FindFirstChildOfClass("PlayerGui")
			local abilityGui = if playerGui then playerGui:FindFirstChild("AbilityHUD") else nil
			if playerGui and abilityGui then
				for _, object in playerGui:GetGuiObjectsAtPosition(input.Position.X, input.Position.Y) do
					if object:IsDescendantOf(abilityGui) then return end
				end
			end
			if Abilities.TryThrowRasenshuriken() then held=false; return end
			held = true
			CombatController.TryAttack()
		end
	end)
	UserInputService.InputEnded:Connect(function(input: InputObject)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then held = false end
	end)
	UserInputService.WindowFocusReleased:Connect(function() held = false end)
	player.CharacterAdded:Connect(function() held = false end)
	player.CharacterRemoving:Connect(function() held = false end)
	require(script.Parent.RoundController).Watch(function() held = false end)
	RunService.Heartbeat:Connect(function()
		if not held or os.clock() < nextPoll then return end
		nextPoll = os.clock() + 0.05
		local player = game:GetService("Players").LocalPlayer
		if not Camera.IsCaptured() or player:GetAttribute("SelectingCloneTarget") == true then
			held = false; return
		end
		CombatController.TryHeldAttack()
	end)
end

return InputController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="148">
            <Properties>
              <string name="Name">LearningController</string>
              <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local Controller = {}
local remote: RemoteEvent? = nil
local serial, messageUntil = 0, 0
local message = ""
local reasons: { [string]: string } = { Learned="Способность изучена", NoPoints="Нет очков обучения", Level="Недостаточный уровень", NotImplemented="Ранг пока недоступен", Replay="Повторный запрос", StaleLife="Герой изменился", RateLimited="Слишком часто" }
function Controller.GetMessage(): string return if os.clock()<messageUntil then message else "" end
function Controller.Start()
	if remote then return end
	local event=game:GetService("ReplicatedStorage"):WaitForChild("AbilityLearning",15)
	assert(event and event:IsA("RemoteEvent")); remote=event
	event.OnClientEvent:Connect(function(_ok: boolean,reason: string) message=reasons[reason] or "Обучение недоступно"; messageUntil=os.clock()+3 end)
end
function Controller.TryLearn(id: string)
	local player=Players.LocalPlayer; local model=player.Character
	local state=game:GetService("ReplicatedStorage"):FindFirstChild("SurvivalState")
	if not remote or not model or not state then return end
	serial += 1
	remote:FireServer(serial,model,model:GetAttribute("LifeId"),id,state:GetAttribute("RoundId"))
end
return Controller
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="149">
            <Properties>
              <string name="Name">MinionMotionController</string>
              <string name="Source"><![CDATA[--!strict
local RunService = game:GetService("RunService")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Poses = require(Shared.Combat.MinionPoses)
type Rig = { root: BasePart, humanoid: Humanoid, joints: { Motor6D }, nextAt: number, deathAt: number?, neutral: boolean }
local Motion = {}
local rigs: { [Model]: Rig } = {}
local connection: RBXScriptConnection? = nil
local nextScan = 0
local names = { RootJoint = true, Neck = true, ["Left Shoulder"] = true, ["Right Shoulder"] = true, ["Left Hip"] = true, ["Right Hip"] = true }
local function reset(rig: Rig)
	for _, joint in rig.joints do if joint.Parent then joint.Transform = CFrame.identity end end
	rig.neutral = true
end
local function scan()
	local npcs = workspace:FindFirstChild("NPCs")
	local folder = if npcs then npcs:FindFirstChild("SurvivalMinions") else nil
	if not folder then return end
	for _, model in folder:GetChildren() do
		if not model:IsA("Model") or model:GetAttribute("EntityKind") ~= "Minion" then continue end
		local rig = rigs[model]
		local complete = rig ~= nil and #rig.joints == 6
		if rig then
			for _, joint in rig.joints do if not joint:IsDescendantOf(model) then complete = false; break end end
		end
		if complete then continue end
		local root = model:FindFirstChild("HumanoidRootPart")
		local humanoid = model:FindFirstChildOfClass("Humanoid")
		if not root or not root:IsA("BasePart") or not humanoid then continue end
		local joints: { Motor6D } = {}
		for _, item in model:GetDescendants() do
			if item:IsA("Motor6D") and names[item.Name] then table.insert(joints, item) end
		end
		if rig then reset(rig) end
		rigs[model] = { root = root, humanoid = humanoid, joints = joints, nextAt = 0, deathAt = if rig then rig.deathAt else nil, neutral = true }
	end
end
function Motion.Stop()
	if connection then connection:Disconnect(); connection = nil end
	for _, rig in rigs do reset(rig) end
	table.clear(rigs); nextScan = 0
end
function Motion.Start()
	if connection then return end
	-- One shared loop, no Animation instances, per-NPC event connections, or server pose replication.
	connection = RunService.PreSimulation:Connect(function()
		local now = workspace:GetServerTimeNow()
		if now >= nextScan then nextScan = now + .5; scan() end
		local camera = workspace.CurrentCamera
		for model, rig in rigs do
			if not model:IsDescendantOf(workspace) or not rig.root:IsDescendantOf(model) or not rig.humanoid:IsDescendantOf(model) then
				reset(rig); rigs[model] = nil; continue
			end
			if now < rig.nextAt then continue end
			local distance = if camera then (camera.CFrame.Position - rig.root.Position).Magnitude else math.huge
			local visible = false
			if camera and distance <= Poses.FarDistance then
				local _, onScreen = camera:WorldToViewportPoint(rig.root.Position); visible = onScreen
			end
			rig.nextAt = now + Poses.Interval(distance, visible)
			if not visible or distance > Poses.FarDistance then
				if not rig.neutral then reset(rig) end
				continue
			end
			local velocity = rig.root.AssemblyLinearVelocity * Vector3.new(1, 0, 1)
			local at = model:GetAttribute("MinionAttackAt")
			local dead = rig.humanoid.Health <= 0 or model:GetAttribute("AIState") == "Dead"
			local state, phase = Poses.State(dead, model:GetAttribute("CombatState") == "Stunned", model:GetAttribute("CombatDisabled") == true,
				velocity.Magnitude, now, if typeof(at) == "number" then at else nil)
			if dead then
				local diedAt = model:GetAttribute("MinionDiedAt")
				rig.deathAt = if typeof(diedAt) == "number" then diedAt else rig.deathAt or now
				phase = math.clamp((now - (rig.deathAt :: number)) / Poses.DeathDuration, 0, 1)
			end
			local angles = Poses.Sample(state, now, phase, model:GetAttribute("MinionType") == "Ranged", model:GetAttribute("MinionVisual") == "WhiteZetsu")
			for _, joint in rig.joints do
				local rotation = angles[joint.Name]
				if joint.Parent and rotation then joint.Transform = CFrame.Angles(rotation[1], rotation[2], rotation[3]) end
			end
			rig.neutral = false
		end
	end)
end
return Motion
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="150">
            <Properties>
              <string name="Name">MobaHUDView</string>
              <string name="Source"><![CDATA[--!strict
local View = {}
View.Background = Color3.fromRGB(20, 24, 29)
View.Card = Color3.fromRGB(35, 41, 47)
View.Gold = Color3.fromRGB(224, 182, 102)
View.Text = Color3.fromRGB(229, 229, 220)
function View.frame(parent: Instance, name: string, size: UDim2, position: UDim2): Frame
	local f = Instance.new("Frame"); f.Name = name; f.Size = size; f.Position = position
	f.BackgroundColor3 = View.Background; f.BorderSizePixel = 0; f.Parent = parent; return f
end
function View.label(parent: Instance, name: string, size: UDim2, position: UDim2, textSize: number): TextLabel
	local t = Instance.new("TextLabel"); t.Name = name; t.Size = size; t.Position = position
	t.BackgroundTransparency = 1; t.Font = Enum.Font.GothamMedium; t.TextSize = textSize; t.TextColor3 = View.Text
	t.Text = ""; t.TextTruncate = Enum.TextTruncate.AtEnd; t.Parent = parent; return t
end
function View.border(parent: GuiObject, color: Color3)
	local stroke = Instance.new("UIStroke"); stroke.Color = color; stroke.Transparency = .35; stroke.Parent = parent
end
export type Portrait = { viewport: ViewportFrame, source: Model?, copy: Model?, appearance: string,
 generation:number,pending:string?,pendingSource:Model? }
function View.portrait(parent: Instance, size: UDim2, position: UDim2): Portrait
	local viewport = Instance.new("ViewportFrame"); viewport.Name = "Portrait"; viewport.Size = size; viewport.Position = position
	viewport.BackgroundColor3 = View.Card; viewport.BorderSizePixel = 0; viewport.LightDirection = Vector3.new(-1,-1,-2)
	viewport.Ambient = Color3.fromRGB(180,180,180); viewport.Parent = parent
	return { viewport = viewport, source = nil, copy = nil, appearance = "",generation=0,pending=nil,pendingSource=nil }
end
function View.updatePortrait(portrait: Portrait, source: Model?)
	local costume = if source then source:FindFirstChild("HeroAppearance") else nil
 local appearance = if source then tostring(source:GetAttribute("HeroAppearanceVersion")) else ""
	if portrait.source == source and portrait.appearance == appearance and (not source or portrait.copy) then
  if portrait.pending then portrait.generation+=1;portrait.pending=nil;portrait.pendingSource=nil end
  return
 end
	if not source then
  portrait.generation+=1;portrait.pending=nil;portrait.pendingSource=nil
  portrait.source=nil;portrait.appearance="";portrait.copy=nil;portrait.viewport:ClearAllChildren();return
 end
 -- Keep the current portrait through partial replication and texture loading.
 if not costume or costume:GetAttribute("AppearanceVersion")~=appearance then return end
 local count=costume:GetAttribute("AppearanceParts")
 local descendants=costume:GetAttribute("AppearanceDescendants")
 if typeof(count)~="number" or #costume:GetChildren()<count or typeof(descendants)~="number" or #costume:GetDescendants()<descendants then return end
 if portrait.pendingSource==source and portrait.pending==appearance then return end
	local head = source:FindFirstChild("Head"); if not head or not head:IsA("BasePart") then portrait.source = nil; return end
 portrait.generation+=1;local generation=portrait.generation
 portrait.pending=appearance;portrait.pendingSource=source
 -- A fixed cosmetic bust keeps combat poses, helper clones and live effects out of the portrait.
 local copy=Instance.new("Model");copy.Name="HeroPortrait"
 local upper=source:FindFirstChild("UpperTorso")
 local torsoHeight=if upper and upper:IsA("BasePart") then upper.Size.Y else 1.6
 local headY=torsoHeight/2+head.Size.Y/2+.1
 local frames: {[string]: CFrame}={Head=CFrame.new(0,headY,0),UpperTorso=CFrame.identity,
  LowerTorso=CFrame.new(0,-1,0),LeftUpperArm=CFrame.new(-1.5,.1,0),RightUpperArm=CFrame.new(1.5,.1,0)}
 local kurama=costume:GetAttribute("AppearanceForm")=="Kurama"
 if kurama then frames.HumanoidRootPart=CFrame.identity end
 local function visualClone(original: BasePart, frame: CFrame): BasePart
  local part=original:Clone()
  local target=original:GetAttribute("AppearanceTransparency")
  if typeof(target)=="number" then part.Transparency=target end
  for _,child in part:GetDescendants() do
   if not child:IsA("DataModelMesh") and not child:IsA("Decal") and not child:IsA("SurfaceAppearance") then child:Destroy() end
  end
  part.Anchored=true;part.CanCollide=false;part.CanTouch=false;part.CanQuery=false
  part.LocalTransparencyModifier=0;part.CFrame=frame;part.Parent=copy;return part
 end
 for name,frame in frames do
  local original=source:FindFirstChild(name)
  if original and original:IsA("BasePart") then visualClone(original,frame) end
 end
 if costume then for _,original in costume:GetChildren() do
  if not original:IsA("BasePart") then continue end
  local body=original:GetAttribute("CosmeticBody");local offset=original:GetAttribute("CosmeticOffset")
  if typeof(body)=="string" and frames[body] and typeof(offset)=="CFrame" then visualClone(original,frames[body]*offset) end
 end end
 for _,item in source:GetChildren() do if item:IsA("Shirt") or item:IsA("Pants") then item:Clone().Parent=copy end end
 local sourceHumanoid=source:FindFirstChildOfClass("Humanoid")
 if sourceHumanoid then
  local humanoid=sourceHumanoid:Clone();humanoid:ClearAllChildren();humanoid.AutomaticScalingEnabled=false
  humanoid.DisplayDistanceType=Enum.HumanoidDisplayDistanceType.None;humanoid.Parent=copy
 end
 local world=Instance.new("WorldModel");copy.Parent=world
 local camera=Instance.new("Camera");camera.FieldOfView=35
 camera.CFrame=CFrame.lookAt(Vector3.new(0,headY+.3,-4.8),Vector3.new(0,headY-.25,0))
 if kurama then
  -- Frame the fox's face, rather than the invisible humanoid head inside its body.
  camera.CFrame=CFrame.lookAt(Vector3.new(0,2,-12),Vector3.new(0,.8,-2))
 end
 -- Build and preload a replacement off-screen, then swap in one non-yielding step.
 task.spawn(function()
  local ready=pcall(function() game:GetService("ContentProvider"):PreloadAsync({copy}) end)
  if not ready or portrait.generation~=generation or not portrait.viewport.Parent or not source.Parent
   or source:GetAttribute("HeroAppearanceVersion")~=appearance then world:Destroy();camera:Destroy();return end
  portrait.viewport:ClearAllChildren()
  world.Parent=portrait.viewport;camera.Parent=portrait.viewport;portrait.viewport.CurrentCamera=camera
  portrait.copy=copy;portrait.source=source;portrait.appearance=appearance;portrait.pending=nil;portrait.pendingSource=nil
 end)
end
return View
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="151">
            <Properties>
              <string name="Name">NarutoRangedVFXController</string>
              <string name="Source"><![CDATA[--!strict
-- Original procedural art. Seven/nine visuals remain one authoritative damage zone.
local Run=game:GetService("RunService")
local Units=require(game:GetService("ReplicatedStorage"):WaitForChild("Shared").Abilities.WorldUnits)
local Rounds=require(script.Parent.RoundController)
type Projectile={core:Part,a:Part,b:Part}
type Effect={folder:Folder,caster:Model,life:number,code:string,origin:Vector3,target:Vector3,
 startedAt:number,releaseAt:number,arrivalAt:number?,center:Vector3,projectiles:{Projectile},ring:{Part},radius:number}
local active:{[string]:Effect}={}
local starts,arrivals,pulses,ends=0,0,0,0
local started=false
local V={}
local function remove(key:string)
 local e=active[key];if e then active[key]=nil;e.folder:Destroy() end
end
local function clear() for key in active do remove(key) end end
local function part(parent:Folder,name:string,color:Color3):Part
 local p=Instance.new("Part");p.Name=name;p.Anchored=true;p.CanCollide=false;p.CanTouch=false;p.CanQuery=false
 p.CastShadow=false;p.Material=Enum.Material.Neon;p.Color=color;p.Size=Vector3.one;p.Parent=parent;return p
end
function V.Diagnostics():(number,number,{number})
 local n,parts=0,0;for _,e in active do n+=1;parts+=#e.projectiles*3+#e.ring end
 return n,parts,{starts,arrivals,pulses,ends}
end
function V.Event(message:any)
 if typeof(message.key)~="string" then return end
 local key=message.key
 if message.kind=="RikudoEnd" then ends+=1;remove(key);return end
 if message.kind=="RikudoStart" then
  if typeof(message.caster)~="Instance" or not (message.caster :: Instance):IsA("Model")
   or typeof(message.origin)~="Vector3" or typeof(message.target)~="Vector3" then return end
  local camera=workspace.CurrentCamera
  if camera and (camera.CFrame.Position-message.origin).Magnitude>260 then return end
  remove(key)
  local count=0;local oldest:string?=nil;local at=math.huge
  for id,e in active do count+=1;if e.startedAt<at then at=e.startedAt;oldest=id end end
  if count>=12 and oldest then remove(oldest) end
  local folder=Instance.new("Folder");folder.Name="RikudoRasenshurikenVFX";folder.Parent=workspace
  local e:Effect={folder=folder,caster=message.caster :: Model,life=message.life,code=message.abilityId,
   origin=message.origin,target=message.target,startedAt=message.startedAt,releaseAt=message.releaseAt,
   arrivalAt=nil,center=message.target,projectiles={},ring={},radius=0}
  local color=if e.code=="A0HY" then Color3.fromRGB(107,216,255) else Color3.fromRGB(187,138,255)
  for _=1,(if e.code=="A0HY" then 7 else 9) do
   local core=part(folder,"ChakraCore",Color3.fromRGB(38,31,65));core.Shape=Enum.PartType.Ball
   table.insert(e.projectiles,{core=core,a=part(folder,"WindBlade",color),b=part(folder,"WindBlade",color)})
  end
  for _=1,16 do local p=part(folder,"DamageZoneEdge",color);p.Transparency=1;table.insert(e.ring,p) end
  active[key]=e;starts+=1;return
 end
 local e=active[key];if not e then return end
 if message.kind=="RikudoArrived" and typeof(message.position)=="Vector3" then
  e.arrivalAt=message.at;e.center=message.position;arrivals+=1
 elseif message.kind=="RikudoPulse" and typeof(message.radius)=="number" then
  e.radius=message.radius;pulses+=1
 end
end
function V.Start()
 if started then return end;started=true;Rounds.Watch(clear)
 Run.RenderStepped:Connect(function()
  local now=workspace:GetServerTimeNow()
  for key,e in active do
   local hp=e.caster:FindFirstChildOfClass("Humanoid")
   if not e.caster.Parent or not hp or hp.Health<=0 or e.caster:GetAttribute("LifeId")~=e.life or now>e.startedAt+10 then remove(key);continue end
   local delta=(e.target-e.origin)*Vector3.new(1,0,1)
   local length=delta.Magnitude;local direction=if length>.001 then delta.Unit else Vector3.xAxis
   local preparing=now<e.releaseAt
   local travel=math.min(length,math.max(0,now-e.releaseAt)*Units.toStuds(1000))
   local center=if e.arrivalAt then e.center else e.origin+direction*travel+Vector3.new(0,(e.target.Y-e.origin.Y)*(if length>.001 then travel/length else 1),0)
   local spread=Units.toStuds(300)*(if preparing then .15 else 1)
   local size=if e.code=="A0HY" then 1.05 else 1.45
   local elapsed=if e.arrivalAt then math.max(0,now-e.arrivalAt) else 0
   local radius=if e.arrivalAt then Units.toStuds(636+4*(if e.code=="A0HY" then math.min(58,math.floor((elapsed+.03)/.06)) else math.min(116,math.floor(elapsed/.03)+1))) else 0
   radius=math.max(radius,e.radius)
   for i,p in e.projectiles do
    local angle=(i-2)*math.pi*2/(#e.projectiles-1)
    local offset=if i==1 then Vector3.zero else Vector3.new(math.cos(angle),0,math.sin(angle))*spread
    local point=center+offset
    if e.arrivalAt then point=e.center+offset*.3+Vector3.new(0,math.sin(now*6+i)*.4,0) end
    p.core.Size=Vector3.one*size*(if preparing then .7 else 1);p.core.CFrame=CFrame.new(point)
    local cf=CFrame.new(point)*CFrame.Angles(0,now*15+i,0)
    p.a.Size=Vector3.new(size*3.8,.1,size*.28);p.b.Size=Vector3.new(size*.28,.1,size*3.8)
    p.a.CFrame=cf;p.b.CFrame=cf
   end
   for i,p in e.ring do
    if radius<=0 then p.Transparency=1;continue end
    local a=(i-1)*math.pi/8;local b=i*math.pi/8
    local first=e.center+Vector3.new(math.cos(a)*radius,-.85,math.sin(a)*radius)
    local second=e.center+Vector3.new(math.cos(b)*radius,-.85,math.sin(b)*radius)
    p.Size=Vector3.new(.12,.12,(second-first).Magnitude);p.CFrame=CFrame.lookAt((first+second)/2,second);p.Transparency=.22
   end
  end
 end)
end
return V
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="152">
            <Properties>
              <string name="Name">RasenganEvolutionHUD</string>
              <string name="Source"><![CDATA[--!strict
-- A permanent explanation of the existing 1 -> Z -> X technique, not new spells.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local GuiService = game:GetService("GuiService")
local Controller = require(script.Parent.AbilityController)
local View = require(script.Parent.MobaHUDView)
local Icons = require(script.Parent.HUDIcons)
local Layout = require(script.Parent.HUDLayout)

local HUD = {}
local started = false
local ids = { "Rasengan", "Odama", "Rasenshuriken" }
local names = { "Расенган", "Одама Расенган", "Расенсюрикен" }
local keys = { "1", "Z", "X" }
local colors = { Color3.fromRGB(81,189,255), Color3.fromRGB(105,220,255), Color3.fromRGB(192,250,255) }
type Card = { button: TextButton, stroke: UIStroke, key: TextLabel, state: TextLabel, progress: Frame, icon: Frame }
local function number(model: Instance?, name: string): number
	local n = if model then model:GetAttribute(name) else nil
	return if typeof(n) == "number" then n else 0
end

function HUD.Start(gui: ScreenGui)
	if started then return end; started = true
	local player = Players.LocalPlayer
	local panel = View.frame(gui,"RasenganEvolution",UDim2.fromOffset(278,294),UDim2.new(0,18,1,-190))
	panel.AnchorPoint = Vector2.new(0,1); panel.BackgroundTransparency = .08
	local corner = Instance.new("UICorner"); corner.CornerRadius = UDim.new(0,8); corner.Parent = panel
	local outline = Instance.new("UIStroke"); outline.Color = Color3.fromRGB(62,100,124); outline.Transparency = .3; outline.Parent = panel
	local scale = Instance.new("UIScale"); scale.Parent = panel
	local header = View.label(panel,"Heading",UDim2.new(1,-24,0,32),UDim2.fromOffset(12,3),12)
	header.TextWrapped = true
	header.TextXAlignment = Enum.TextXAlignment.Left; header.Font = Enum.Font.GothamBold
	local footer = View.label(panel,"Instruction",UDim2.new(1,-24,0,47),UDim2.fromOffset(12,241),12)
	footer.TextWrapped = true
	footer.TextColor3 = Color3.fromRGB(179,198,212); footer.TextXAlignment = Enum.TextXAlignment.Left
	local cards: {Card} = {}
	for i,id in ids do
		local button = Instance.new("TextButton"); button.Name = id; button.Text = ""
		button.Position = UDim2.fromOffset(12,38+(i-1)*68); button.Size = UDim2.fromOffset(254,60)
		button.BackgroundColor3 = Color3.fromRGB(28,37,49); button.BorderSizePixel = 0; button.Parent = panel
		local round = Instance.new("UICorner"); round.CornerRadius = UDim.new(0,5); round.Parent = button
		local stroke = Instance.new("UIStroke"); stroke.Color = colors[i]; stroke.Transparency = .7; stroke.Parent = button
		local iconHolder = View.frame(button,"Symbol",UDim2.fromOffset(44,44),UDim2.fromOffset(7,10))
		local icon = Icons.draw(iconHolder,id)
		local name = View.label(button,"Name",UDim2.fromOffset(190,22),UDim2.fromOffset(57,5),13)
		name.TextXAlignment = Enum.TextXAlignment.Left; name.Font = Enum.Font.GothamBold; name.Text = names[i]
		local state = View.label(button,"State",UDim2.fromOffset(190,20),UDim2.fromOffset(57,30),11)
		state.TextXAlignment = Enum.TextXAlignment.Left
		local key = View.label(iconHolder,"Key",UDim2.fromOffset(18,18),UDim2.fromOffset(-3,-5),12)
		key.BackgroundTransparency = 0; key.BackgroundColor3 = Color3.fromRGB(9,17,25); key.Font = Enum.Font.GothamBold; key.Text = keys[i]; key.ZIndex = 3
		local progress = View.frame(button,"Window",UDim2.new(0,0,0,3),UDim2.new(0,0,1,-3)); progress.BackgroundColor3 = colors[i]
		button.Activated:Connect(function() Controller.TryCast(id) end)
		cards[i] = {button=button,stroke=stroke,key=key,state=state,progress=progress,icon=icon}
		if i<3 then
			local arrow = View.label(panel,"Arrow"..i,UDim2.fromOffset(20,12),UDim2.fromOffset(129,96+(i-1)*68),11)
			arrow.Text = "↓"; arrow.TextColor3 = colors[i+1]
		end
	end
	RunService.RenderStepped:Connect(function()
		local model = player.Character
		local humanoid = if model then model:FindFirstChildOfClass("Humanoid") else nil
		panel.Visible = humanoid ~= nil and humanoid.Health>0 and player:GetAttribute("ShopOpen")~=true
			and player:GetAttribute("StatsOpen")~=true and not GuiService.MenuIsOpen and (not model or model:GetAttribute("RikudoRangedGranted")~=true)
		if not panel.Visible then return end
		local camera = workspace.CurrentCamera
		if camera then
			scale.Scale = math.clamp(camera.ViewportSize.Y/900,.72,1)
			panel.Position = UDim2.new(0,18,1,-(Layout.ConsoleHeight*Layout.scale(camera.ViewportSize.X,camera.ViewportSize.Y)+18))
		end
		local now = workspace:GetServerTimeNow()
		local profile = player:FindFirstChild("HeroState")
		local rank = number(profile,"Rank_Rasengan")
		local phase = if model then model:GetAttribute("RasenganPhase") else nil
		local variant = if model then model:GetAttribute("RasenganVariant") else nil
		local current = if typeof(variant)=="string" then table.find(ids,variant) or 0 else 0
		local active = current>0 and (phase=="Preparing" or phase=="Holding" or phase=="Consumed")
		local ordinary = model ~= nil and model:GetAttribute("KcmActive")~=true and model:GetAttribute("KuramaActive")~=true
			and (model:GetAttribute("SagePhase")==nil or model:GetAttribute("SagePhase")=="")
		local window = if active and ordinary then math.max(0,number(model,"RasenganVariantUntil")-now) else 0
		local nextIndex = if current<3 and window>0 then current+1 else 0
		local ready = math.max(0,number(model,"RasenganReadyAt")-now,if phase~="Consumed" then number(model,"RasenganSelfPauseUntil")-now else 0)
		header.Text = "РАСЕНГАН  /  ЦЕПОЧКА УСИЛЕНИЙ"
		header.TextColor3 = colors[1]
		footer.Text = "1 → Z → X  ·  На каждое усиление — 1 секунда.  Alt — курсор."
		if not ordinary then
			footer.Text = "Усиления Z и X доступны в обычной форме Наруто."
		elseif rank==0 then
			footer.Text = "Изучите Расенган: Ctrl + 1 с уровня 4. Одама — ранг II, Расенсюрикен — III."
		end
		if active then
			header.Text = string.upper(names[current])..(if phase=="Consumed" then "  /  ПОПАДАНИЕ" elseif ready>0 then "  /  ФОРМИРОВАНИЕ" else "  /  ГОТОВ К УДАРУ")
			header.TextColor3 = colors[current]
			footer.Text = if phase=="Consumed" then "Контакт подтверждён — техника завершается."
				elseif ready>0 then string.format("Формирование %.1f с · затем подойдите к врагу и нажмите ЛКМ.",ready)
				else string.format("Подойдите к врагу: ЛКМ — удар. Заряд сохранится ещё %.1f с.",math.max(0,number(model,"RasenganExpiresAt")-now))
			if nextIndex>0 and rank>=nextIndex then
				local reason = Controller.AbilityUnavailable(ids[nextIndex])
				if not reason and Controller.Remaining(ids[nextIndex])<=0 then
					header.Text = "НАЖМИТЕ "..keys[nextIndex].."  →  "..string.upper(names[nextIndex])
					footer.Text = string.format("Усилить за +200 чакры · окно %.1f с. Без усиления сохранится %s.",window,names[current])
				end
			end
		end
		for i,id in ids do
			local card = cards[i]
			local reason = Controller.AbilityUnavailable(id)
			local cooldown = Controller.Remaining(id)
			local isCurrent = active and current==i
			local available = (i==1 or ordinary) and rank>=i and reason==nil and cooldown<=0 and ((i==1 and not active) or nextIndex==i)
			local complete = active and current>i
			card.button.AutoButtonColor = available; card.button.Active = true
			card.button.BackgroundColor3 = if isCurrent then Color3.fromRGB(26,67,88) elseif available then Color3.fromRGB(28,59,72) else Color3.fromRGB(26,32,42)
			card.stroke.Transparency = if available then .1+.12*math.sin(now*10) elseif isCurrent then .1 else .78
			card.stroke.Thickness = if available or isCurrent then 2 else 1
			card.key.TextColor3 = if available then Color3.fromRGB(255,233,143) else colors[i]
			card.state.TextColor3 = if available then Color3.fromRGB(255,233,143) elseif isCurrent then colors[i] else Color3.fromRGB(159,177,191)
			card.progress.Size = UDim2.new(if nextIndex==i and rank>=i then math.clamp(window,0,1) else 0,0,0,3)
			card.state.Text = if rank<i then (if i==1 then "Изучить: Ctrl + 1" else "Нужен ранг "..(if i==2 then "II" else "III"))
				elseif isCurrent then (if phase=="Consumed" then "Удар" elseif ready>0 then string.format("Формирование %.1f с",ready) else "ЛКМ — удар")
				elseif complete then "✓ Усилено"
				elseif Controller.GetQueuedUpgrade(id) then "Нажатие принято…"
				elseif i>1 and not ordinary then "Обычная форма"
				elseif cooldown>0 then string.format("Перезарядка %.0f с",math.ceil(cooldown))
				elseif active and i==current+1 and window<=0 then "Окно усиления закрыто"
				elseif number(model,"Mana")<(if i==1 then 100 else 200) then "Не хватает чакры"
				elseif available then (if i==1 then "Начать · 100 чакры" else string.format("НАЖМИТЕ %s · %.1f с",keys[i],window))
				elseif nextIndex==i and reason then reason
				elseif i==1 and not active and reason then reason
				else (if i==1 then "100 чакры" elseif i==2 then "После 1 · +200 чакры" else "После Z · +200 чакры")
		end
	end)
end
return HUD
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="153">
            <Properties>
              <string name="Name">RasenganVisual</string>
              <string name="Source"><![CDATA[--!strict
-- Chakra currents with a reviewed Creator Store wind-blade mesh. See docs/CREATOR-ASSETS.md.
local Shared=game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local StoreData=require(Shared.Config.CreatorVisualData)
local Factory=require(Shared.CreatorVisualFactory)
local Particles=require(script.Parent.ChakraParticleVisual)
local Visual = {}
local cyan = Color3.fromRGB(80,198,255)
local ice = Color3.fromRGB(213,250,255)
local white = Color3.fromRGB(248,255,255)
type Current = { part: Part, ring: number, segment: number }
export type Orb = { group: Model, core: Part, plasma: Part, glow: Part, currents: {Current}, storeBlade: Part, storeMesh: SpecialMesh,
 particles: Particles.State?, light: PointLight, variant: string, changedAt: number, radius: number, detailed: boolean, size: number }
export type Burst = { group: Model, parts: {Part}, at: number, duration: number, radius: number, variant: string }
local function part(parent: Instance, name: string, color: Color3): Part
 local p=Instance.new("Part"); p.Name=name; p.Anchored=true; p.CanCollide=false; p.CanTouch=false; p.CanQuery=false
 p.Material=Enum.Material.Neon; p.Color=color; p.CastShadow=false; p.Size=Vector3.one*.1; p.Parent=parent; return p
end
local function sphere(parent: Instance, name: string, color: Color3, transparency: number): Part
 local p=part(parent,name,color); p.Shape=Enum.PartType.Ball; p.Transparency=transparency; return p
end
function Visual.Create(parent: Instance, source: Model, detailed: boolean): Orb
 local group=Instance.new("Model"); group.Name="RasenganChakra"; group:SetAttribute("Source",source.Name); group.Parent=parent
 -- Saturated, deliberately low-value Neon avoids both white clipping and the
 -- directional shadow of an opaque plastic ball. Geometric currents need no Beam texture.
 local core=sphere(group,"ChakraCore",Color3.fromRGB(10,85,135),.08)
 local plasma=sphere(group,"BluePlasma",Color3.fromRGB(18,96,163),.78)
 local glow=sphere(group,"ChakraHalo",Color3.fromRGB(10,65,145),.95)
 local currents: {Current}={}
 for ring=1,if detailed then 0 else 2 do for segment=1,if detailed then 24 else 8 do
  local current=part(group,"RotatingChakraCurrent",Color3.fromRGB(92,198,245))
  table.insert(currents,{part=current,ring=ring,segment=segment})
 end end
 local storeBlade,storeMesh=Factory.Part(StoreData.blade)
 storeBlade.Name="CreatorStoreWindBlades";storeBlade.Anchored=true;storeBlade.Transparency=1
 storeBlade.Material=Enum.Material.Neon;storeBlade.Color=Color3.fromRGB(145,230,255);storeBlade.Parent=group
 local light=Instance.new("PointLight"); light.Color=cyan; light.Range=5; light.Brightness=.22; light.Shadows=false; light.Parent=core
 return {group=group,core=core,plasma=plasma,glow=glow,currents=currents,storeBlade=storeBlade,storeMesh=storeMesh,light=light,
  particles=if detailed then Particles.Create(core) else nil,variant="",changedAt=0,radius=.1,detailed=detailed,size=0}
end
function Visual.Update(state: Orb, source: Model, hand: BasePart, now: number, dt: number)
 local attr=source:GetAttribute("RasenganVariant")
 local variant=if attr=="Odama" or attr=="Rasenshuriken" then attr else "Rasengan"
 if variant~=state.variant then
  state.variant=variant; state.changedAt=now; state.group:SetAttribute("Variant",variant)
  state.group.Name=if variant=="Odama" then "OdamaRasenganChakra" elseif variant=="Rasenshuriken" then "RasenshurikenChakra" else "RasenganChakra"
 end
 local ready=source:GetAttribute("RasenganReadyAt"); local started=source:GetAttribute("RasenganStartedAt")
 -- CFrame stores float32 values. Unix-sized angles erase small ring offsets and
 -- frame-to-frame movement; keep all rotations relative to this short-lived cast.
 local animationTime=if typeof(started)=="number" then math.max(0,now-started) else now%100
 local preparation=if typeof(ready)=="number" and typeof(started)=="number" then math.clamp((now-started)/math.max(.1,ready-started),0,1) else 1
 local charge=if source:GetAttribute("RasenganPhase")=="Preparing" then .16+.84*preparation^1.2 else 1
 local targetRadius=(if variant=="Odama" then 2.15 elseif variant=="Rasenshuriken" then .95 else .66)*charge
 state.radius+=(targetRadius-state.radius)*(1-math.exp(-16*math.min(dt,.1)))
 local radius=math.max(.04,state.radius)
 local upgrade=math.max(0,1-(now-state.changedAt)/.35)
 local offset=if variant=="Odama" then Vector3.new(0,-1.9,-.3) elseif variant=="Rasenshuriken" then Vector3.new(0,-1,-.25) else Vector3.new(0,-.85,-.35)
 local position=hand.CFrame:PointToWorldSpace(offset)
 local center=CFrame.new(position)
 state.core.CFrame=center; state.plasma.CFrame=center; state.glow.CFrame=center
 local pulse=1+math.sin(animationTime*17)*.018
 state.core.Size=Vector3.one*radius*1.64*pulse
 state.plasma.Size=Vector3.one*radius*1.93
 state.glow.Size=Vector3.one*radius*(2.15+upgrade*.35)
 state.core.Color=if variant=="Rasenshuriken" then Color3.fromRGB(12,104,151) else Color3.fromRGB(10,85,135)
 state.plasma.Color=if variant=="Rasenshuriken" then Color3.fromRGB(24,113,177) else Color3.fromRGB(18,96,163)
 state.glow.Transparency=.96-upgrade*.035
 state.light.Range=math.min(8,radius*3+2); state.light.Brightness=.18+upgrade*.12
 if state.particles then Particles.Update(state.particles,radius);state.core.Transparency=.65;state.plasma.Transparency=.93 end
 state.size=radius*2
 -- Three independently rotating, tapered arcs form a readable spherical vortex.
 -- All are outside the plasma shell, so even opaque-volume ordering cannot hide them.
 local segmentCount=if state.detailed then 24 else 8
 for _,current in state.currents do
  local ring,index=current.ring,current.segment
  local rotation=center*CFrame.Angles(ring*.92+animationTime*.21,ring*1.16+animationTime*.14,ring*.73)
  local spin=(if ring%2==0 then -1 else 1)*animationTime*(if variant=="Odama" then 4.7 else 6.8)
  local span=math.pi*1.58
  local angle=spin+(index-1)*span/segmentCount
  local nextAngle=angle+span/segmentCount*1.05
  local r=radius*(1.025+(ring-1)*.018)
  local a=rotation:PointToWorldSpace(Vector3.new(math.cos(angle)*r,math.sin(angle)*r,0))
  local b=rotation:PointToWorldSpace(Vector3.new(math.cos(nextAngle)*r,math.sin(nextAngle)*r,0))
  local tail=(index-1)/segmentCount
  local thickness=radius*(.065-.03*tail)
  local p=current.part
  p.Size=Vector3.new(thickness,thickness,(b-a).Magnitude*1.08)
  p.CFrame=CFrame.lookAt((a+b)/2,b)
  p.Transparency=if state.particles then 1 else .05+tail*.68
 end
 local shuriken=variant=="Rasenshuriken"
 if shuriken then
  local root=source:FindFirstChild("HumanoidRootPart")
  local facing=if root and root:IsA("BasePart") then root.CFrame.Rotation else CFrame.identity
  -- Tilted wind-disc remains recognisable from the shoulder camera, with its
  -- normal independent of wrist rotation so all four points remain readable.
  local bladeFrame=center*facing*CFrame.Angles(math.rad(-35),0,0)*CFrame.Angles(0,animationTime*10,0)
  local size=math.clamp(radius/.95,0,1)
  -- The store mesh is 20.72 studs wide at its authored scale. Fit the same 7.3-stud disc.
  local factor=7.3/StoreData.blade.size[1]*size
  state.storeBlade.CFrame=bladeFrame
  state.storeMesh.Scale=Factory.Vector(StoreData.blade.scale)*factor
  state.storeBlade.Transparency=.3
 else
  state.storeBlade.Transparency=1
 end
end
function Visual.Destroy(state: Orb) state.group:Destroy() end
function Visual.Burst(parent: Instance, position: Vector3, variant: string, kind: string, now: number): Burst
 local group=Instance.new("Model"); group.Name=variant..kind; group.Parent=parent
 local parts: {Part}={}
 local radius=if variant=="Odama" then 6 elseif variant=="Rasenshuriken" then 5 else 3.2
 local duration=if kind=="Contact" then .24 elseif kind=="Impact" then .48 else .62
 if kind=="Contact" then radius*=.42 end
 for index=1,if kind=="Contact" then 9 else 19 do
  local p=if index<=3 then sphere(group,"PressureShell",if index==1 then white else cyan,.3) else part(group,"ChakraSpiral",ice)
  p.Position=position; table.insert(parts,p)
 end
 return {group=group,parts=parts,at=now,duration=duration,radius=radius,variant=variant}
end
function Visual.UpdateBurst(state: Burst, position: Vector3, now: number)
 local t=math.clamp((now-state.at)/state.duration,0,1)
 for index,p in state.parts do
  if index<=3 then
   p.Size=Vector3.one*math.max(.03,state.radius*(.15+t*(if index==1 then .7 else 1.3)))
   p.Position=position; p.Transparency=math.clamp((if index==1 then .25 else .72)+t*.75,0,1)
  else
   local angle=(index-4)*math.pi*2/(#state.parts-3)+t*3.3
   local nextAngle=angle+.22
   local r=state.radius*(.15+t)
   local height=math.sin(angle*2)*(1-t)*state.radius*.35
   local a=position+Vector3.new(math.cos(angle)*r,height,math.sin(angle)*r)
   local b=position+Vector3.new(math.cos(nextAngle)*r,height+.12,math.sin(nextAngle)*r)
   p.Size=Vector3.new(.045,.045,(b-a).Magnitude);p.CFrame=CFrame.lookAt((a+b)/2,b);p.Transparency=t
  end
 end
end
return Visual
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="154">
            <Properties>
              <string name="Name">RasenshurikenFlightVisual</string>
              <string name="Source"><![CDATA[--!strict
local Art=require(script.Parent.RasenganVisual)
type Flight={orb:Art.Orb,model:Model,hand:Part,source:Model?,origin:Vector3,direction:Vector3,at:number,speed:number,range:number}
local flights:{[number]:Flight}={}
local V={}
local function remove(id:number)
 local f=flights[id];if f then Art.Destroy(f.orb);f.model:Destroy();flights[id]=nil end
end
function V.Event(message:any,parent:Folder)
 if message.kind=="RasenshurikenFlightEnd" or message.kind=="RasenshurikenDetonate" then remove(message.id);return end
 if message.kind~="RasenshurikenFlight" then return end
 local count=0;for _ in flights do count+=1 end;if count>=32 then return end
 local m=Instance.new("Model");m.Name="ThrownRasenshuriken";m:SetAttribute("RasenganVariant","Rasenshuriken");m:SetAttribute("RasenganPhase","Holding");m:SetAttribute("RasenganStartedAt",message.releaseAt)
 local hand=Instance.new("Part");hand.Name="HumanoidRootPart";hand.Parent=m
 flights[message.id]={orb=Art.Create(parent,m,true),model=m,hand=hand,source=message.source,origin=message.position,direction=message.direction,at=message.releaseAt,speed=message.speed,range=message.range}
end
function V.Update(now:number,dt:number)
 for id,f in flights do
  if now>f.at+f.range/f.speed+.5 or not f.source or not f.source.Parent then remove(id);continue end
  local pos=f.origin+f.direction*math.clamp((now-f.at)*f.speed,0,f.range)
  f.hand.CFrame=CFrame.lookAt(pos,pos+f.direction)*CFrame.new(0,1,.25)
  local hand=f.source:FindFirstChild("RightHand")
  Art.Update(f.orb,f.model,if now<f.at and hand and hand:IsA("BasePart") then hand else f.hand,now,dt)
 end
end
function V.Clear() for id in flights do remove(id) end end
return V
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="155">
            <Properties>
              <string name="Name">RoundController</string>
              <string name="Source"><![CDATA[--!strict
local Storage = game:GetService("ReplicatedStorage")
local Protocol = require(Storage:WaitForChild("Shared").Game.RoundProtocol)
local Controller = {}
local callbacks: { () -> () } = {}
local bound: Instance? = nil
local function clear() for _, callback in callbacks do callback() end end
local function bind(state: Instance)
	if bound or state.Name ~= "SurvivalState" then return end; bound = state
	state:GetAttributeChangedSignal("RoundId"):Connect(clear)
	state:GetAttributeChangedSignal("Phase"):Connect(function()
		local phase = state:GetAttribute("Phase")
		if phase == "Finished" then clear() end
	end)
end
function Controller.Current(): number?
	local state = Storage:FindFirstChild("SurvivalState")
	return if state then state:GetAttribute("RoundId") :: number? else nil
end
function Controller.Accepts(roundId: any): boolean
	local state = Storage:FindFirstChild("SurvivalState")
	local isolated = game:GetService("RunService"):IsStudio() and workspace:GetAttribute("CombatOnlyTest") == true
	return Protocol.acceptsClient(Controller.Current(), roundId, if state then state:GetAttribute("Phase") else nil, isolated)
end
function Controller.Watch(callback: () -> ())
	table.insert(callbacks, callback)
end
Storage.ChildAdded:Connect(bind)
local state = Storage:FindFirstChild("SurvivalState"); if state then bind(state) end
return Controller
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="156">
            <Properties>
              <string name="Name">SurvivalHUDController</string>
              <string name="Source"><![CDATA[--!strict
local Players=game:GetService("Players")
local RS=game:GetService("ReplicatedStorage")
local RunService=game:GetService("RunService")
local Shared=RS:WaitForChild("Shared")
local Minions=require(Shared.Config.MinionConfig)
local VFX=require(script.Parent.VFXController)
local Rounds=require(script.Parent.RoundController)
local View=require(script.Parent.MobaHUDView)
local Layout=require(script.Parent.HUDLayout)
local HUD={}
local started=false
function HUD.Start()
	if started then return end; started=true
	task.spawn(function()
		local state=RS:WaitForChild("SurvivalState",30); if not state then return end
		local player=Players.LocalPlayer
		local gui=Instance.new("ScreenGui"); gui.Name="SurvivalHUD"; gui.ResetOnSpawn=false; gui.DisplayOrder=5
		gui.ScreenInsets=Enum.ScreenInsets.None; gui.Parent=player:WaitForChild("PlayerGui")
		local panel=View.frame(gui,"MatchPanel",UDim2.fromOffset(Layout.TopWidth,Layout.TopHeight),UDim2.new(.5,0,0,0)); panel.AnchorPoint=Vector2.new(.5,0)
		local scale=Instance.new("UIScale"); scale.Parent=panel
		local clock=View.label(panel,"Clock",UDim2.fromOffset(140,20),UDim2.fromOffset(390,25),15)
		local score=View.label(panel,"Score",UDim2.fromOffset(140,27),UDim2.fromOffset(390,0),23); score.TextColor3=View.Gold
		local status=View.label(gui,"Status",UDim2.fromOffset(460,25),UDim2.new(.5,0,0,82),14); status.AnchorPoint=Vector2.new(.5,0); status.TextColor3=View.Gold
		local slots: { {frame: Frame,portrait: View.Portrait,name: TextLabel,condition: TextLabel,shade: Frame,team: string,index: number} }={}
		for side,team in {"Blue","Red"} do
			for index=1,5 do
				local x=if side==1 then (index-1)*76+4 else 536+(index-1)*76
				local cell=View.frame(panel,team..index,UDim2.fromOffset(72,46),UDim2.fromOffset(x,0)); View.border(cell,if side==1 then Color3.fromRGB(81,151,112) else Color3.fromRGB(186,82,74))
				local portrait=View.portrait(cell,UDim2.fromOffset(70,44),UDim2.fromOffset(1,0))
				local shade=View.frame(cell,"Dead",UDim2.fromOffset(70,44),UDim2.fromOffset(1,0)); shade.BackgroundTransparency=.35; shade.Visible=false
				local condition=View.label(cell,"Condition",UDim2.fromOffset(70,22),UDim2.fromOffset(1,11),11); condition.ZIndex=3
				local name=View.label(cell,"Player",UDim2.fromOffset(70,13),UDim2.fromOffset(1,30),9)
				table.insert(slots,{frame=cell,portrait=portrait,name=name,condition=condition,shade=shade,team=team,index=index})
			end
		end
		local ending=View.frame(gui,"Result",UDim2.fromOffset(420,140),UDim2.fromScale(.5,.38)); ending.AnchorPoint=Vector2.new(.5,.5); ending.Visible=false; View.border(ending,View.Gold)
		local endingScale=Instance.new("UIScale"); endingScale.Parent=ending
		local result=View.label(ending,"ResultText",UDim2.new(1,-24,0,58),UDim2.fromOffset(12,16),30)
		local explanation=View.label(ending,"Explanation",UDim2.new(1,-24,0,42),UDim2.fromOffset(12,80),14); explanation.TextWrapped=true
		local notice=View.label(gui,"TowerNotice",UDim2.fromOffset(500,28),UDim2.new(.5,0,0,112),14); notice.AnchorPoint=Vector2.new(.5,0); notice.TextColor3=View.Gold
		local noticeUntil=0
		Rounds.Watch(function() noticeUntil=0; notice.Visible=false end)
		local towerEvents=state:WaitForChild("TowerEvent") :: RemoteEvent
		towerEvents.OnClientEvent:Connect(function(kind: string,_model: Model,_origin: Vector3,_destination: Vector3,id: string,_lane: string,epoch: number)
			if not Rounds.Accepts(epoch) then return end
			if kind=="Destroyed" then notice.Text=if id==player:GetAttribute("TeamId") then "Ваша башня разрушена" else "Вражеская башня разрушена"; noticeUntil=os.clock()+4 end
		end)
		local nextUpdate=0
		RunService.Heartbeat:Connect(function()
			local now=workspace:GetServerTimeNow(); if now<nextUpdate then return end; nextUpdate=now+.2
			local phase=state:GetAttribute("Phase"); local finished=phase=="Finished"
			local start=state:GetAttribute("StartedAt"); local finish=state:GetAttribute("FinishedAt")
			local elapsed=if typeof(start)=="number" and start>0 then math.max(0,(if finished and typeof(finish)=="number" then finish else now)-start) else 0
			clock.Text=string.format("%02d:%02d",math.floor(elapsed/60),math.floor(elapsed%60))
			local members: {[string]: {Player}}={Blue={},Red={}}
			for _,member in Players:GetPlayers() do
				local id=member:GetAttribute("TeamId")
				if typeof(id)=="string" and members[id] and member:GetAttribute("Spectating")~=true then
					table.insert(members[id],member)
				end
			end
			for _,team in members do table.sort(team,function(a: Player,b: Player) return a.UserId<b.UserId end) end
			local blue=state:FindFirstChild("Blue"); local red=state:FindFirstChild("Red")
			score.Text=string.format("%d   :   %d",if blue then (blue:GetAttribute("Kills") or 0) :: number else 0,if red then (red:GetAttribute("Kills") or 0) :: number else 0)
			for _,slot in slots do
				local member=members[slot.team][slot.index]; local model=if member then member.Character else nil
				View.updatePortrait(slot.portrait,model)
				slot.name.Text=if member then member.DisplayName else "Пусто"
				local humanoid=if model then model:FindFirstChildOfClass("Humanoid") else nil
				local dead=member~=nil and (not humanoid or humanoid.Health<=0)
				slot.shade.Visible=dead; slot.condition.Text=if not member then "—" elseif dead then "Погиб" else ""
			end
			status.Text=if phase=="WaitingForPlayers" then "Ожидание игроков" elseif phase=="Preparing" then "Начало через "..math.max(0,math.ceil((state:GetAttribute("PreparationEnds") :: number)-now)) elseif not finished and player:GetAttribute("Spectating")==true then "Наблюдение" else ""
			ending.Visible=finished
			local winner=state:GetAttribute("Winner"); local team=player:GetAttribute("TeamId")
			result.Text=if winner==team then "ПОБЕДА" elseif typeof(team)=="string" then "ПОРАЖЕНИЕ" else "МАТЧ ЗАВЕРШЁН"
			result.TextColor3=if winner==team then Color3.fromRGB(127,192,111) else View.Gold
			local winningTeam=if typeof(winner)=="string" then state:FindFirstChild(winner) else nil
			explanation.Text=if winningTeam then tostring(winningTeam:GetAttribute("DisplayName")).."\n"..(if winner==team then "Вражеский трон разрушен" elseif typeof(team)=="string" then "Ваш трон разрушен" else "Трон разрушен") else "Трон разрушен"
			notice.Visible=not finished and os.clock()<noticeUntil
			local camera=workspace.CurrentCamera
			if camera then
				local width=camera.ViewportSize.X; scale.Scale=Layout.scale(width,camera.ViewportSize.Y); endingScale.Scale=math.min(1,(width-24)/420)
				status.Position=UDim2.new(.5,0,0,Layout.TopHeight*scale.Scale+7); status.Size=UDim2.fromOffset(math.min(460,width-16),25)
				notice.Position=UDim2.new(.5,0,0,Layout.TopHeight*scale.Scale+35); notice.Size=UDim2.fromOffset(math.min(500,width-16),28)
			end
		end)
		local shots=state:WaitForChild("MinionShot") :: RemoteEvent
		shots.OnClientEvent:Connect(function(origin: Vector3,destination: Vector3,kind: string,id: string,target: Model,epoch: number)
			if not Rounds.Accepts(epoch) then return end
			local team=state:FindFirstChild(id); local color=if team then team:GetAttribute("Color") else Color3.new(1,1,1)
			if kind=="Ranged" then VFX.Projectile(origin,destination,color :: Color3,Minions.ProjectileDuration) end
			if target and target.Parent then VFX.Hit(target,destination,false) end
		end)
	end)
end
return HUD
]]></string>
            </Properties>
