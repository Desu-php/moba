          <Item class="ModuleScript" referent="136">
            <Properties>
              <string name="Name">AnimationController</string>
              <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config.CombatConfig)
local AnimationIds = require(Shared.Config.AnimationIds)
local Motion = require(script.Parent.HeroMotionController)

type Loaded = { track: AnimationTrack, animation: Animation, marker: RBXScriptConnection }
local AnimationController = {}
local animator: Animator? = nil
local tracks: { [string]: Loaded } = {}
local warned: { [string]: boolean } = {}
local current: AnimationTrack? = nil
local currentRequest = 0
local currentStep = 0
local currentSet = ""
local endsAt = 0
local generation = 0
local diedConnection: RBXScriptConnection? = nil
local markerCallback: (() -> ())? = nil
local logicalPlayCount = 0
local started = false

function AnimationController.Stop(requestId: number?)
	if requestId and requestId ~= currentRequest then return end
	Motion.StopPrediction(requestId)
	if current then current:Stop(Config.AnimationFadeTime) end
	current = nil
	currentRequest = 0
	endsAt = 0
end

local function clearCharacter()
	generation += 1
	AnimationController.Stop()
	if diedConnection then diedConnection:Disconnect(); diedConnection = nil end
	for _, loaded in tracks do
		loaded.marker:Disconnect()
		loaded.track:Destroy()
		loaded.animation:Destroy()
	end
	table.clear(tracks)
	animator = nil
end

local function warnOnce(key: string, message: string)
	if warned[key] then return end
	warned[key] = true
	warn("[CombatAnimations] " .. message)
end

local function loadTrack(profile: Config.AttackProfile, step: number): AnimationTrack?
	local animationKey = profile.AnimationKey
	local key = profile.AnimationSet .. "." .. animationKey
	local cached = tracks[key]
	if cached then return cached.track end
	local set = AnimationIds[profile.AnimationSet]
	local assetId = if set then set[animationKey] else nil
	if not assetId or not string.match(assetId, "^rbxassetid://[1-9]%d*$") then
		return nil
	end
	local owner = animator
	if not owner then return nil end
	local animation = Instance.new("Animation")
	animation.Name = animationKey
	animation.AnimationId = assetId
	local success, result = pcall(function() return owner:LoadAnimation(animation) end)
	if not success then
		animation:Destroy()
		warnOnce(key, "Cannot load " .. key .. ": " .. tostring(result))
		return nil
	end
	local track = result :: AnimationTrack
	track.Priority = Enum.AnimationPriority.Action
	track.Looped = false
	local marker = track:GetMarkerReachedSignal("Hit"):Connect(function()
		-- This marker may drive a local cue, never a request or damage decision.
		if current == track and markerCallback then markerCallback() end
	end)
	tracks[key] = { track = track, animation = animation, marker = marker }
	return track
end

local function bindCharacter(model: Model)
	clearCharacter()
	local token = generation
	task.spawn(function()
		local humanoid = model:WaitForChild("Humanoid", Config.CharacterReadyTimeout)
		if token ~= generation or not humanoid or not humanoid:IsA("Humanoid") then return end
		if humanoid.RigType ~= Enum.HumanoidRigType.R15 then
			warnOnce("Rig", "R15 is required for the configured animations. Set the experience avatar type to R15.")
			return
		end
		local serverAnimator = humanoid:WaitForChild("Animator", Config.CharacterReadyTimeout)
		if token ~= generation then return end
		if not serverAnimator or not serverAnimator:IsA("Animator") then
			warnOnce("Animator", "Server-created Animator missing; local Animator will not be created.")
			return
		end
		animator = serverAnimator
		diedConnection = humanoid.Died:Connect(function() AnimationController.Stop() end)
		local profile = Config.Profiles[Config.DefaultProfile]
		loadTrack(profile, 1)
	end)
end

function AnimationController.Play(requestId: number, step: number, profile: Config.AttackProfile, startedAt: number, attackDuration: number?): boolean
	local duration = attackDuration or profile.AttackDuration
	local now = workspace:GetServerTimeNow()
	local elapsed = math.max(0, now - startedAt)
	if elapsed >= duration then return false end
	if currentRequest == requestId and currentStep == step then
		-- Confirm the prediction without replaying the track from frame zero.
		if currentSet ~= profile.AnimationSet then
			if current then current:Stop(Config.AnimationFadeTime) end
			currentSet = profile.AnimationSet
			current = loadTrack(profile, step)
			if current then
				current:Play(Config.AnimationFadeTime)
				if current.Length > 0 then current.TimePosition = math.min(elapsed, current.Length) end
			end
		end
		if current and current.Length > 0 and math.abs(current.TimePosition - elapsed) > Config.AnimationCorrectionThreshold then
			current.TimePosition = math.min(elapsed, current.Length)
		end
		endsAt = startedAt + duration
		Motion.Predict(requestId, profile.AnimationKey, startedAt, duration)
		return false
	end
	AnimationController.Stop()
	currentRequest, currentStep, currentSet = requestId, step, profile.AnimationSet
	endsAt = startedAt + duration
	logicalPlayCount += 1
	Motion.Predict(requestId, profile.AnimationKey, startedAt, duration)
	local track = loadTrack(profile, step)
	if track then
		current = track
		track:Play(Config.AnimationFadeTime)
		if track.Length > 0 then track.TimePosition = math.min(elapsed, track.Length) end
	end
	return true
end

function AnimationController.GetLogicalPlayCount(): number
	return logicalPlayCount
end

function AnimationController.Start(onMarker: () -> ())
	if started then return end
	started = true
	Motion.Start()
	markerCallback = onMarker
	Players.LocalPlayer.CharacterAdded:Connect(bindCharacter)
	Players.LocalPlayer.CharacterRemoving:Connect(clearCharacter)
	if Players.LocalPlayer.Character then bindCharacter(Players.LocalPlayer.Character) end
	RunService.Heartbeat:Connect(function()
		if currentRequest ~= 0 and workspace:GetServerTimeNow() >= endsAt then AnimationController.Stop() end
	end)
end

return AnimationController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="137">
            <Properties>
              <string name="Name">CameraController</string>
              <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local Input = game:GetService("UserInputService")
local Gui = game:GetService("GuiService")
local RunService = game:GetService("RunService")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config.CameraConfig)
local Rules = require(Shared.Combat.CombatCameraRules)

local Controller = {}
local player = Players.LocalPlayer
local started, focused, active = false, true, false
local enabled = true
local yaw, pitch = 0, math.rad(Config.InitialPitch)
local followed: Model? = nil
local previousHumanoid: Humanoid? = nil
local previousAutoRotate = true
local previousCamera: Camera? = nil
local previousType = Enum.CameraType.Custom
local pivot: Vector3? = nil
local distance = Config.Distance
local reticle: ScreenGui? = nil
local hiddenParts: { [BasePart]: number } = {}
local fadedSummons: { [Model]: { [BasePart]: number } } = {}
local nextOcclusion = 0

local function showSummon(model: Model)
	local parts = fadedSummons[model]
	if not parts then return end
	for part, transparency in parts do
		if part.Parent then part.LocalTransparencyModifier = transparency end
	end
	fadedSummons[model] = nil
end

local function updateSummonOcclusion(camera: Camera)
	local now = os.clock()
	if now < nextOcclusion then return end
	nextOcclusion = now + .05
	local blocking: { [Model]: boolean } = {}
	local summons = workspace:FindFirstChild("HeroSummons")
	local team = player:GetAttribute("TeamId")
	if summons then
		for _, model in summons:GetChildren() do
			if not model:IsA("Model") or not (model:GetAttribute("SummonOwner") == player.UserId
				or (team ~= nil and model:GetAttribute("TeamId") == team)) then continue end
			local root = model:FindFirstChild("HumanoidRootPart")
			local humanoid = model:FindFirstChildOfClass("Humanoid")
			if not root or not root:IsA("BasePart") or not humanoid or humanoid.Health <= 0 then continue end
			local relative = camera.CFrame:PointToObjectSpace(root.Position)
			local depth = -relative.Z
			-- Bounds include the toad's head and a narrow corridor around the reticle.
			-- Only nearby friendly bodies fade; enemies retain normal combat readability.
			local radius = math.max(root.Size.X, root.Size.Y, root.Size.Z) * .65 + 1
			if depth > -radius and depth < 40 and Vector2.new(relative.X, relative.Y).Magnitude < radius + math.max(0,depth)*.035 then
				blocking[model] = true
				local saved = fadedSummons[model]
				if not saved then saved = {}; fadedSummons[model] = saved end
				for _, part in model:GetDescendants() do
					if part:IsA("BasePart") then
						if saved[part] == nil then saved[part] = part.LocalTransparencyModifier end
						part.LocalTransparencyModifier = math.max(saved[part], .75)
					end
				end
			end
		end
	end
	for model in fadedSummons do if not blocking[model] then showSummon(model) end end
end

local function showCharacter()
	for part, transparency in hiddenParts do
		if part.Parent then part.LocalTransparencyModifier = transparency end
	end
	table.clear(hiddenParts)
end

function Controller.IsCaptured(): boolean
	return started and enabled and active and Input.KeyboardEnabled and Rules.captured(focused, Gui.MenuIsOpen, Input:GetFocusedTextBox() ~= nil,
		player:GetAttribute("ShopOpen") == true, player:GetAttribute("StatsOpen") == true,
		player:GetAttribute("CombatCursorFree") == true or player:GetAttribute("DeveloperConsoleOpen") == true)
end

function Controller.GetAimRay(): Ray?
	local camera = workspace.CurrentCamera
	if not camera then return nil end
	return camera:ViewportPointToRay(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
end

local function restore()
	showCharacter()
	for model in fadedSummons do showSummon(model) end
	nextOcclusion = 0
	if previousHumanoid and previousHumanoid.Parent then previousHumanoid.AutoRotate = previousAutoRotate end
	previousHumanoid = nil
	if previousCamera and previousCamera.Parent then previousCamera.CameraType = previousType end
	previousCamera = nil
	followed, pivot, active = nil, nil, false
	Input.MouseBehavior = Enum.MouseBehavior.Default
	Input.MouseIconEnabled = true
	if reticle then reticle.Enabled = false end
end

function Controller.SetEnabled(value: boolean)
	enabled = value
	if not value then restore() end
end

local function setting(name: string, fallback: number, minimum: number, maximum: number): number
	return Rules.setting(player:GetAttribute("CombatCamera" .. name), fallback, minimum, maximum)
end

local function exclusions(character: Model): { Instance }
	local excluded: { Instance } = { character }
	-- Summons, characters and VFX must never pump the camera in and out.
	for _, name in { "HeroSummons", "LocalHeroVFX", "Effects", "JungleCamps", "NPCs" } do
		local object = workspace:FindFirstChild(name)
		if object then table.insert(excluded, object) end
	end
	for _, other in Players:GetPlayers() do
		if other.Character and other.Character ~= character then table.insert(excluded, other.Character) end
	end
	return excluded
end

function Controller.Start()
	if started or not Input.KeyboardEnabled then return end
	started = true
	local gui = Instance.new("ScreenGui")
	gui.Name = "CombatReticle"; gui.ResetOnSpawn = false; gui.ScreenInsets = Enum.ScreenInsets.None; gui.DisplayOrder = 5
	for _, axis in { true, false } do
		local line = Instance.new("Frame")
		line.Name = if axis then "Horizontal" else "Vertical"
		line.AnchorPoint = Vector2.new(0.5, 0.5); line.Position = UDim2.fromScale(0.5, 0.5)
		line.Size = UDim2.fromOffset(if axis then 11 else 2, if axis then 2 else 11)
		line.BorderSizePixel = 0; line.BackgroundColor3 = Color3.fromRGB(240, 244, 250); line.BackgroundTransparency = 0.2
		local outline = Instance.new("UIStroke"); outline.Thickness = 1; outline.Transparency = 0.35; outline.Parent = line
		line.Parent = gui
	end
	gui.Parent = player:WaitForChild("PlayerGui"); reticle = gui
	Input.WindowFocusReleased:Connect(function() focused = false; player:SetAttribute("CombatCursorFree", false) end)
	Input.WindowFocused:Connect(function() focused = true end)
	Input.InputBegan:Connect(function(input, processed)
		if input.KeyCode == Enum.KeyCode.LeftAlt and not processed and not Input:GetFocusedTextBox() then player:SetAttribute("CombatCursorFree", true) end
	end)
	Input.InputEnded:Connect(function(input)
		if input.KeyCode == Enum.KeyCode.LeftAlt then player:SetAttribute("CombatCursorFree", false) end
	end)
	player.CharacterRemoving:Connect(restore)
	RunService:BindToRenderStep("CombatShoulderCamera", Enum.RenderPriority.Camera.Value + 1, function(dt)
		if not enabled then return end
		local model = player.Character
		local humanoid = if model then model:FindFirstChildOfClass("Humanoid") else nil
		local root = if model then model:FindFirstChild("HumanoidRootPart") else nil
		local camera = workspace.CurrentCamera
		if not model or not humanoid or not root or not root:IsA("BasePart") or humanoid.Health <= 0 or not camera then
			if active then restore() end
			return
		end
		if followed ~= model then
			local look = root.CFrame.LookVector
			yaw = math.atan2(-look.X, -look.Z); pitch = math.rad(Config.InitialPitch)
			followed = model; pivot = nil; distance = Config.Distance
			previousHumanoid = humanoid; previousAutoRotate = humanoid.AutoRotate
		end
		if previousCamera ~= camera then
			if previousCamera and previousCamera.Parent then previousCamera.CameraType = previousType end
			previousCamera, previousType = camera, camera.CameraType
		end
		active = true
		camera.CameraType = Enum.CameraType.Scriptable
		humanoid.AutoRotate = false
		local captured = Controller.IsCaptured()
		Input.MouseBehavior = if captured then Enum.MouseBehavior.LockCenter else Enum.MouseBehavior.Default
		Input.MouseIconEnabled = not captured; gui.Enabled = captured
		local hitUntil = player:GetAttribute("CombatHitUntil")
		local validTarget = player:GetAttribute("AimTargetValid")
		local color = if typeof(hitUntil) == "number" and hitUntil > workspace:GetServerTimeNow() then Color3.fromRGB(255, 211, 101)
			elseif validTarget == true then Color3.fromRGB(119, 234, 157)
			elseif validTarget == false then Color3.fromRGB(244, 102, 100) else Color3.fromRGB(240, 244, 250)
		for _, line in gui:GetChildren() do if line:IsA("Frame") then line.BackgroundColor3 = color end end
		if captured then
			local delta = Input:GetMouseDelta()
			local sensitivity = math.rad(setting("Sensitivity", Config.Sensitivity, 0.03, 1))
			yaw -= delta.X * sensitivity
			pitch = math.clamp(pitch - delta.Y * sensitivity, math.rad(Config.MinimumPitch), math.rad(Config.MaximumPitch))
		end
		local rotation = CFrame.Angles(0, yaw, 0) * CFrame.Angles(pitch, 0, 0)
		local fox = model:GetAttribute("HeroVisualForm") == "Kurama"
		local desiredPivot = root.Position + Vector3.new(0, if fox then 4.5 else setting("Height", Config.Height, 0.5, 6), 0)
		local oldPivot = pivot
		pivot = if not oldPivot or (oldPivot - desiredPivot).Magnitude > Config.TeleportDistance then desiredPivot
			else oldPivot:Lerp(desiredPivot, Rules.alpha(setting("Smoothing", Config.Smoothing, 0, 60), dt))
		local focus = (pivot :: Vector3) + CFrame.Angles(0, yaw, 0):VectorToWorldSpace(humanoid.CameraOffset)
		local desiredOffset = -rotation.LookVector * (if fox then math.max(20,setting("Distance", Config.Distance, 4, 24)) else setting("Distance", Config.Distance, 4, 24))
			+ rotation.RightVector * setting("Shoulder", Config.Shoulder, -3, 3)
		local params = RaycastParams.new(); params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = exclusions(model); params.RespectCanCollide = true
		local wall = workspace:Spherecast(focus, Config.CollisionRadius, desiredOffset, params)
		local safeDistance = if wall then math.max(0, wall.Distance - Config.CollisionPadding) else desiredOffset.Magnitude
		-- A new obstruction retracts immediately; leaving a wall restores distance gradually.
		distance = if safeDistance < distance then safeDistance else distance + (safeDistance - distance) * Rules.alpha(Config.ReturnSpeed, dt)
		camera.CFrame = CFrame.new(focus + desiredOffset.Unit * distance) * rotation
		camera.Focus = CFrame.new(focus)
		updateSummonOcclusion(camera)
		-- At a very close wall the camera can enter the avatar. Hide only local
		-- character geometry until there is room again; other players still see it.
		if distance < 2 then
			for _, part in model:GetDescendants() do
				if part:IsA("BasePart") then
					if hiddenParts[part] == nil then hiddenParts[part] = part.LocalTransparencyModifier end
					part.LocalTransparencyModifier = 1
				end
			end
		elseif next(hiddenParts) ~= nil then showCharacter() end
		-- Server-owned control/knockback keeps its orientation. Never unanchor or change WalkSpeed.
		if captured and humanoid.WalkSpeed > 0 and not humanoid.PlatformStand and not humanoid.Sit and not root.Anchored
			and model:GetAttribute("CombatState") ~= "Stunned" then
			root.CFrame = CFrame.new(root.Position) * CFrame.Angles(0, yaw, 0)
		end
	end)
end

return Controller
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="138">
            <Properties>
              <string name="Name">ChakraAuraVisual</string>
              <string name="Source"><![CDATA[--!strict
local Players=game:GetService("Players")
local Aura={}
type State={folder:Folder,parts:{Part},form:string,at:number}
local states:{[Model]:State}={}
function Aura.Update(parent:Folder,now:number)
 local live:{[Model]:boolean}={}
 for _,player in Players:GetPlayers() do
  local model=player.Character
  if not model then continue end
  local root=model:FindFirstChild("HumanoidRootPart");local hp=model:FindFirstChildOfClass("Humanoid")
  local form:string=if model:GetAttribute("KcmActive")==true or model:GetAttribute("KuramaActive")==true then "Kurama" elseif model:GetAttribute("SagePhase")=="Active" or model:GetAttribute("SagePhase")=="Preparing" then "Sage" else ""
  local camera=workspace.CurrentCamera
  if form=="" or not root or not root:IsA("BasePart") or not hp or hp.Health<=0 or (camera and (root.Position-camera.CFrame.Position).Magnitude>120) then continue end
  live[model]=true
  local costume=model:FindFirstChild("DisplayedHeroAppearance") or model:FindFirstChild("HeroAppearance")
  if costume and model:GetAttribute("HeroVisualForm")=="Kurama" then
   local moving=math.clamp(Vector3.new(root.AssemblyLinearVelocity.X,0,root.AssemblyLinearVelocity.Z).Magnitude/12,0,1)
   for _,part in costume:GetChildren() do
    if not part:IsA("BasePart") then continue end
    local weld=part:FindFirstChild("FormVisualWeld");local base=part:GetAttribute("CosmeticOffset")
    if not weld or not weld:IsA("Weld") or typeof(base)~="CFrame" then continue end
    local tail=tonumber(string.match(part.Name,"Tail(%d+)$"))
    local motion=CFrame.new(0,math.sin(now*2)*.035,0)
    if tail then
     local pivot=Vector3.new(0,.7,2.5)
     motion*=CFrame.new(pivot)*CFrame.Angles(0,math.sin(now*1.8+tail*.45)*.045,0)*CFrame.new(-pivot)
    elseif string.find(part.Name,"Left") or string.find(part.Name,"Right") then
     local side=if string.find(part.Name,"Left") then 0 else math.pi
     local hind=if string.find(part.Name,"Leg") then math.pi else 0
     local stride=math.sin(now*9+side+hind)*moving
     motion*=CFrame.new(0,math.max(0,stride)*.18,stride*.32)
    end
    weld.C0=motion*base
   end
  end
  local state=states[model]
  if not state then
   local f=Instance.new("Folder");f.Name="ChakraAura";f.Parent=parent
   local parts:{Part}={}
   for i=1,18 do
    local p=Instance.new("Part");p.Name="ChakraStream";p.Anchored=true;p.CanCollide=false;p.CanQuery=false;p.CanTouch=false;p.CastShadow=false;p.Material=Enum.Material.Neon;p.Parent=f;table.insert(parts,p)
   end
   local createdState:State={folder=f,parts=parts,form=form,at=now};state=createdState;states[model]=createdState
  end
  if state.form~=form then state.form=form;state.at=now end
  local t=now-state.at
  for i,p in state.parts do
   local phase=(t*(if form=="Kurama" then 1.2 else .55)+i/18)%1
   local angle=i*2.399+t*.7
   local radius=(if form=="Kurama" then 1.5 else 2.2)+math.sin(phase*math.pi)*.5
   local pos=root.Position+Vector3.new(math.cos(angle)*radius,-2.7+phase*6,math.sin(angle)*radius)
   p.Color=if form=="Kurama" then Color3.fromRGB(255,151,25) else Color3.fromRGB(231,174,80)
   p.Size=Vector3.new(.035,if form=="Kurama" then .7+phase else .18,.035)
   p.CFrame=CFrame.new(pos)*CFrame.Angles(0,angle,math.sin(angle)*.3)
   p.Transparency=.25+math.abs(phase-.5)*1.4
  end
 end
 for model,state in states do if not live[model] then state.folder:Destroy();states[model]=nil end end
end
return Aura
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="139">
            <Properties>
              <string name="Name">ChakraParticleVisual</string>
              <string name="Source"><![CDATA[--!strict
local Data=require(game:GetService("ReplicatedStorage").Shared.Config.ChakraParticleData)
local Visual={}
export type Layer={emitter: ParticleEmitter, sizes: {{number}}}
export type State={layers: {Layer}, radius: number}
local function sequence(keys: {{number}}, radius: number?): NumberSequence
 local points: {NumberSequenceKeypoint}={}
 for _,k in keys do table.insert(points,NumberSequenceKeypoint.new(k[1],if radius then math.min(2.4,k[2]*2.5)*radius else k[2],0)) end
 return NumberSequence.new(points)
end
function Visual.Create(parent: BasePart): State
 local attachment=Instance.new("Attachment");attachment.Name="CreatorChakra";attachment.Parent=parent
 local state: State={layers={},radius=0}
 for _,spec in Data do
  local e=Instance.new("ParticleEmitter");e.Name=spec.name;e.Texture=spec.texture
  e.Rate=math.min(30,spec.rate*.6);e.Lifetime=NumberRange.new(spec.lifetime[1],spec.lifetime[2])
  e.Rotation=NumberRange.new(spec.rotation[1],spec.rotation[2]);e.RotSpeed=NumberRange.new(spec.rotSpeed[1],spec.rotSpeed[2])
  e.Speed=NumberRange.new(0);e.LockedToPart=true;e.Orientation=Enum.ParticleOrientation.FacingCamera
  e.LightEmission=1;e.LightInfluence=0;e.Transparency=sequence(spec.transparency)
  local colors: {ColorSequenceKeypoint}={}
  for _,k in spec.color do table.insert(colors,ColorSequenceKeypoint.new(k[1],if string.find(spec.name,"golden") then Color3.fromRGB(125,225,255) else Color3.new(k[2],k[3],k[4]))) end
  e.Color=ColorSequence.new(colors);e.Size=sequence(spec.size,.04);e.Parent=attachment
  table.insert(state.layers,{emitter=e,sizes=spec.size})
 end
 return state
end
function Visual.Update(state: State,radius: number)
 if math.abs(radius-state.radius)<.015 then return end
 state.radius=radius
 for _,layer in state.layers do layer.emitter.Size=sequence(layer.sizes,radius) end
end
return Visual
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="140">
            <Properties>
              <string name="Name">CombatController</string>
              <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config.CombatConfig)
local Debug = require(Shared.Config.DebugConfig)
local AttackRules = require(Shared.Combat.BasicAttackRules)
local Protocol = require(Shared.Combat.CombatProtocol)
local Animations = require(script.Parent.AnimationController)
local VFX = require(script.Parent.VFXController)
local Rounds = require(script.Parent.RoundController)

type Pending = { id: number, step: number, sentAt: number, startAt: number, played: boolean, character: Model }
local CombatController = {}
local attackRemote: RemoteEvent? = nil
local snapshot: Protocol.Snapshot? = nil
local pending: Pending? = nil
local requestSerial = 0
local localNextAttackAt = 0
local localStep = 0
local queuedUntil = 0
local currentProfile = Config.Profiles[Config.DefaultProfile]
local seenStarted: { [Model]: number } = setmetatable({}, { __mode = "k" })
local seenHits: { [Model]: number } = setmetatable({}, { __mode = "k" })
local abilityConnection: RBXScriptConnection? = nil

function CombatController.NextRequestId(): number
	requestSerial += 1
	assert(requestSerial <= Config.MaxRequestId, "Combat request ID limit reached")
	return requestSerial
end

local function reset()
	Animations.Stop()
	snapshot, pending = nil, nil
	localNextAttackAt, localStep, queuedUntil = 0, 0, 0
	currentProfile = Config.Profiles[Config.DefaultProfile]
end

local function reconcile(incoming: Protocol.Snapshot): boolean
	if incoming.character ~= Players.LocalPlayer.Character then return false end
	if snapshot and incoming.revision < snapshot.revision then return false end
	snapshot = incoming
	local profiles: { read [string]: Config.AttackProfile } = Config.Profiles
	currentProfile = profiles[incoming.profileId] or Config.Profiles[Config.DefaultProfile]
	localNextAttackAt = incoming.nextAttackAt
	localStep = 1
	if incoming.mode == "Stunned" or incoming.mode == "Dead" then
		Animations.Stop()
		pending = nil
		queuedUntil = 0
	end
	return true
end

local function attackSpeed(): number
 local stats = Players.LocalPlayer:FindFirstChild("HeroState")
 local agility = if stats then stats:GetAttribute("Agility") else 0
 return AttackRules.speed(currentProfile, if typeof(agility) == "number" then agility else 0)
end
local function playPrediction(intent: Pending)
	if intent.played then return end
	intent.played = true
	Animations.Play(intent.id, intent.step, currentProfile, intent.startAt, currentProfile.AttackDuration / attackSpeed())
	VFX.Swing(intent.character, intent.step)
end

local function onEvent(message: Protocol.Event)
	local incoming = message.snapshot
	if incoming and not Rounds.Accepts(incoming.roundId) then return end
	local character = if incoming then incoming.character else message.character
	if message.kind == "Rejected" then
		if incoming then reconcile(incoming) end
		if pending and pending.id == message.requestId and character == pending.character then
			Animations.Stop(pending.id)
			pending = nil
			queuedUntil = 0
			localNextAttackAt = if snapshot then snapshot.nextAttackAt else workspace:GetServerTimeNow()
		end
		return
	end
	if not incoming or not character then return end
	local localCharacter = character == Players.LocalPlayer.Character
	if localCharacter and not reconcile(incoming) then return end

	if message.kind == "Buffered" then
		-- Keep one pending intent. It is played at the due time, never at the early click.
		if pending and pending.id == message.requestId then pending.startAt = incoming.nextAttackAt end
	elseif message.kind == "Started" then
		local attack = message.attack
		if not attack or (seenStarted[character] or 0) >= attack.id then return end
		seenStarted[character] = attack.id
		if localCharacter then
			local predicted = pending
			local alreadyPlayed = predicted and predicted.id == attack.requestId and predicted.played and predicted.step == attack.step
			Animations.Play(attack.requestId, attack.step, currentProfile, attack.startedAt, attack.endsAt - attack.startedAt)
			if not alreadyPlayed and workspace:GetServerTimeNow() < attack.endsAt then VFX.Swing(character, attack.step) end
			if predicted and predicted.id == attack.requestId then pending = nil end
		else
			VFX.Swing(character, attack.step)
		end
		if Debug.LogCombat then print(string.format("[Combat] confirmed %s M1-%d", character.Name, attack.step)) end
	elseif message.kind == "Hit" then
		local attackId, step, hits = message.attackId, message.step, message.hits
		if not attackId or not step or not hits or (seenHits[character] or 0) >= attackId then return end
		seenHits[character] = attackId
		local heavy = false
		for _, hit in hits do
			if hit.character.Parent then VFX.Hit(hit.character, hit.position, heavy) end
		end
		if localCharacter and #hits > 0 then VFX.Shake(heavy) end
		if message.hitboxCFrame and message.hitboxSize then VFX.DebugBox(message.hitboxCFrame, message.hitboxSize) end
	end
end

function CombatController.TryAttack(): boolean
	local remote = attackRemote
	local character = Players.LocalPlayer.Character
	local humanoid = if character then character:FindFirstChildOfClass("Humanoid") else nil
	if not remote or not character or not humanoid or humanoid.Health <= 0 then return false end
	if character:GetAttribute("CombatDisabled") == true then return false end
	if character:GetAttribute("AbilityId") and character:GetAttribute("AbilityId") ~= "" then return false end
	local match = ReplicatedStorage:FindFirstChild("SurvivalState")
	if match and match:GetAttribute("Phase") ~= "InProgress" then return false end
	local now = workspace:GetServerTimeNow()
	local authoritative = snapshot
	if not authoritative then
		currentProfile = Config.Profiles[tostring(character:GetAttribute("CombatProfileId"))] or currentProfile
	end
	if authoritative and (authoritative.mode == "Dead" or (authoritative.mode == "Stunned" and now < authoritative.stunUntil)) then return false end
	if not authoritative and character:GetAttribute("CombatState") == "Stunned" then return false end
	if pending then
		-- Only an additional real click near recovery can occupy this one local slot.
		if queuedUntil == 0 and now >= localNextAttackAt - currentProfile.InputBufferWindow and now <= localNextAttackAt then
			queuedUntil = localNextAttackAt + currentProfile.InputBufferWindow
		end
		return false
	end
	if now < localNextAttackAt - currentProfile.InputBufferWindow then return false end
	local step = 1
	local dueAt = math.max(now, localNextAttackAt)
	local intent: Pending = {
		id = CombatController.NextRequestId(), step = step, sentAt = now,
		startAt = dueAt, played = false, character = character,
	}
	pending = intent
	queuedUntil = 0
	if dueAt <= now then
		playPrediction(intent)
		localStep = step
		localNextAttackAt = now + currentProfile.AttackCooldown / attackSpeed()
	end
	if match then remote:FireServer(intent.id, character, Rounds.Current()) else remote:FireServer(intent.id, character) end
	return true
end

-- Holding repeats only once recovery ends. It never fills a future input buffer.
function CombatController.TryHeldAttack(): boolean
	if pending or workspace:GetServerTimeNow() < localNextAttackAt then return false end
	return CombatController.TryAttack()
end

function CombatController.GetDiagnostics()
	return { pendingRequestId = if pending then pending.id else 0, queued = queuedUntil > 0 }
end

function CombatController.Start()
	if attackRemote then return end
	Rounds.Watch(function() reset(); table.clear(seenStarted); table.clear(seenHits) end)
	local folder = ReplicatedStorage:WaitForChild(Protocol.FolderName, Config.CharacterReadyTimeout)
	assert(folder, "CombatRemotes missing: check Server/Main")
	local request = folder:WaitForChild(Protocol.BasicAttackName, Config.CharacterReadyTimeout)
	local events = folder:WaitForChild(Protocol.EventName, Config.CharacterReadyTimeout)
	assert(request and request:IsA("RemoteEvent") and events and events:IsA("RemoteEvent"), "Combat protocol v2 remotes missing")
	attackRemote = request
	VFX.Start()
	Animations.Start(function()
		local character = Players.LocalPlayer.Character
		if character then VFX.Swing(character, localStep) end
	end)
	Players.LocalPlayer.CharacterAdded:Connect(reset)
	Players.LocalPlayer.CharacterRemoving:Connect(reset)
	local function bindAbilities(character: Model)
		if abilityConnection then abilityConnection:Disconnect() end
		abilityConnection = character:GetAttributeChangedSignal("AbilityId"):Connect(function()
			if character ~= Players.LocalPlayer.Character then return end
			if character:GetAttribute("AbilityId") ~= "" then Animations.Stop(); pending = nil; queuedUntil = 0 end
		end)
	end
	Players.LocalPlayer.CharacterAdded:Connect(bindAbilities)
	Players.LocalPlayer.CharacterRemoving:Connect(function()
		if abilityConnection then abilityConnection:Disconnect(); abilityConnection = nil end
	end)
	if Players.LocalPlayer.Character then bindAbilities(Players.LocalPlayer.Character) end
	events.OnClientEvent:Connect(onEvent)
	RunService.Heartbeat:Connect(function()
		local now = workspace:GetServerTimeNow()
		local intent = pending
		if intent then
			if intent.character ~= Players.LocalPlayer.Character or now - intent.sentAt > Config.PredictionTimeout then
				Animations.Stop(intent.id)
				pending = nil
				queuedUntil = 0
				localNextAttackAt = if snapshot then snapshot.nextAttackAt else now
			elseif not intent.played and now >= intent.startAt then
				playPrediction(intent)
			end
		elseif queuedUntil > 0 then
			if now > queuedUntil then
				queuedUntil = 0
			elseif now >= localNextAttackAt - currentProfile.InputBufferWindow then
				queuedUntil = 0
				CombatController.TryAttack()
			end
		end
	end)
end

return CombatController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="141">
            <Properties>
              <string name="Name">DeveloperConsoleController</string>
              <string name="Source"><![CDATA[--!strict
local Controller={}
function Controller.Start()
 if not game:GetService("RunService"):IsStudio() then return end
 local player=game:GetService("Players").LocalPlayer
 local input=game:GetService("UserInputService")
 local remote=game:GetService("ReplicatedStorage"):WaitForChild("DeveloperCommand",15)
 if not remote or not remote:IsA("RemoteEvent") then return end
 local gui=Instance.new("ScreenGui");gui.Name="DeveloperConsole";gui.ResetOnSpawn=false;gui.DisplayOrder=100;gui.Parent=player:WaitForChild("PlayerGui")
 local hint=Instance.new("TextButton");hint.Name="Toggle";hint.Text="DEV · F8";hint.Size=UDim2.fromOffset(96,30);hint.Position=UDim2.new(1,-108,0,60)
 hint.BackgroundColor3=Color3.fromRGB(28,35,45);hint.TextColor3=Color3.fromRGB(255,211,110);hint.Font=Enum.Font.GothamBold;hint.TextSize=14;hint.Parent=gui
 local panel=Instance.new("Frame");panel.Name="Panel";panel.Size=UDim2.new(.9,0,0,290);panel.Position=UDim2.new(.5,0,.18,0);panel.AnchorPoint=Vector2.new(.5,0)
 panel.BackgroundColor3=Color3.fromRGB(20,25,33);panel.Visible=false;panel.Parent=gui
 local limit=Instance.new("UISizeConstraint");limit.MaxSize=Vector2.new(620,290);limit.Parent=panel
 local title=Instance.new("TextLabel");title.Size=UDim2.new(1,-28,0,36);title.Position=UDim2.fromOffset(14,8);title.BackgroundTransparency=1
 title.Text="РЕЖИМ РАЗРАБОТКИ · F8 закрыть";title.Font=Enum.Font.GothamBold;title.TextSize=16;title.TextColor3=Color3.fromRGB(255,211,110);title.Parent=panel
 local output=Instance.new("TextLabel");output.Name="Output";output.Position=UDim2.fromOffset(16,50);output.Size=UDim2.new(1,-32,0,160)
 output.BackgroundTransparency=1;output.TextWrapped=true;output.TextXAlignment=Enum.TextXAlignment.Left;output.TextYAlignment=Enum.TextYAlignment.Top
 output.Font=Enum.Font.Gotham;output.TextSize=17;output.TextColor3=Color3.fromRGB(232,237,244);output.Parent=panel
 local box=Instance.new("TextBox");box.Name="Command";box.Position=UDim2.new(0,16,1,-58);box.Size=UDim2.new(1,-32,0,42)
 box.Text="";box.PlaceholderText="Например: level 30    ·    Enter — выполнить";box.ClearTextOnFocus=false;box.Font=Enum.Font.Code;box.TextSize=18
 box.BackgroundColor3=Color3.fromRGB(35,44,57);box.TextColor3=Color3.new(1,1,1);box.Parent=panel
 local function toggle()
  panel.Visible=not panel.Visible;player:SetAttribute("DeveloperConsoleOpen",panel.Visible)
  if panel.Visible then remote:FireServer("help");box:CaptureFocus() else box:ReleaseFocus() end
 end
 hint.Activated:Connect(toggle)
 input.InputBegan:Connect(function(key,processed)
  if key.KeyCode==Enum.KeyCode.F8 and (not processed or panel.Visible) then toggle() end
 end)
 box.FocusLost:Connect(function(enter)
  if not enter or not panel.Visible or box.Text=="" then return end
  remote:FireServer(box.Text);box.Text=""
  task.defer(function() if panel.Visible then box:CaptureFocus() end end)
 end)
 remote.OnClientEvent:Connect(function(ok: boolean,message: string)
  output.Text=message;output.TextColor3=if ok then Color3.fromRGB(225,238,244) else Color3.fromRGB(255,148,123)
  if ok then require(script.Parent.AbilityController).ClearCooldownCorrections() end
 end)
end
return Controller
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="142">
            <Properties>
              <string name="Name">HUDIcons</string>
              <string name="Source"><![CDATA[--!strict
-- Original code-drawn Naruto symbols. No uploaded images or Valve assets.
local Icons = {}
local palettes: {[string]: Color3} = {
	Rasengan=Color3.fromRGB(32,133,190), Odama=Color3.fromRGB(23,92,178), Rasenshuriken=Color3.fromRGB(36,115,126), ShadowClones=Color3.fromRGB(183,104,39),
	Gamakichi=Color3.fromRGB(148,66,50), SageMode=Color3.fromRGB(186,96,42),
	KCM=Color3.fromRGB(198,151,34), CloneCommand=Color3.fromRGB(86,129,148),
	GamakichiOil=Color3.fromRGB(87,127,52), GamakichiChop=Color3.fromRGB(126,83,62),
	IronBlade=Color3.fromRGB(82,119,137), GuardianArmor=Color3.fromRGB(107,101,137),
	SwiftBoots=Color3.fromRGB(117,85,51), HealingPotion=Color3.fromRGB(91,144,82),
}
function Icons.draw(parent: GuiObject, id: string): Frame
	local canvas=Instance.new("Frame"); canvas.Name="Icon"; canvas.Size=UDim2.fromScale(1,1)
	canvas.BackgroundColor3=palettes[id] or Color3.fromRGB(65,87,105); canvas.BorderSizePixel=0; canvas.Parent=parent
	local gradient=Instance.new("UIGradient"); gradient.Rotation=65
	gradient.Color=ColorSequence.new(Color3.new(1,1,1),Color3.fromRGB(55,60,78)); gradient.Parent=canvas
	local function shape(name: string,x: number,y: number,w: number,h: number,round: boolean,rotation: number?): Frame
		local f=Instance.new("Frame"); f.Name=name; f.AnchorPoint=Vector2.new(.5,.5); f.Position=UDim2.fromScale(x,y); f.Size=UDim2.fromScale(w,h)
		f.BackgroundColor3=Color3.fromRGB(224,237,226); f.BorderSizePixel=0; f.Rotation=rotation or 0; f.Parent=canvas
		if round then local c=Instance.new("UICorner"); c.CornerRadius=UDim.new(1,0); c.Parent=f end
		return f
	end
	if id=="Rasengan" then
		for i=1,4 do
			local r=shape("ChakraRing",.5,.5,.18+i*.14,.18+i*.14,true); r.BackgroundTransparency=1
			local stroke=Instance.new("UIStroke"); stroke.Color=Color3.fromRGB(159,232,255); stroke.Thickness=2; stroke.Parent=r
		end
		shape("Core",.5,.5,.22,.22,true); shape("Flow",.5,.5,.78,.045,false,-35)
	elseif id=="Odama" then
        local outer=shape("LargeAura",.5,.5,.91,.91,true); outer.BackgroundColor3=Color3.fromRGB(83,198,255); outer.BackgroundTransparency=.35
        shape("LargeCore",.5,.5,.72,.72,true).BackgroundColor3=Color3.fromRGB(224,252,255)
        for i=1,3 do
            local r=shape("CompressedFlow",.5,.5,.25+i*.16,.25+i*.16,true);r.BackgroundTransparency=1
            local stroke=Instance.new("UIStroke");stroke.Color=Color3.fromRGB(79,166,237);stroke.Thickness=2;stroke.Parent=r
        end
    elseif id=="Rasenshuriken" then
        for i=0,3 do
            local a=math.pi*i/2
            local blade=shape("WindBlade",.5+math.cos(a)*.24,.5+math.sin(a)*.24,.15,.48,false,45+i*90)
            blade.BackgroundColor3=Color3.fromRGB(210,255,255)
        end
        shape("WindCore",.5,.5,.45,.45,true).BackgroundColor3=Color3.fromRGB(115,228,255)
        local core=shape("Core",.5,.5,.29,.29,true);core.BackgroundColor3=Color3.fromRGB(245,255,255)
    elseif id=="ShadowClones" or id=="CloneCommand" then
		for i=1,3 do local x=.19+(i-1)*.30; shape("Head",x,.37,.18,.22,true); shape("Body",x,.66,.23,.30,true) end
		if id=="CloneCommand" then shape("Command",.5,.20,.74,.035,false) end
	elseif id=="Gamakichi" or id=="GamakichiOil" then
		shape("Frog",.5,.57,.74,.49,true); shape("Eye",.27,.31,.22,.25,true); shape("Eye",.73,.31,.22,.25,true)
		shape("Mouth",.5,.63,.44,.045,false).BackgroundColor3=palettes[id]
		if id=="GamakichiOil" then shape("Oil",.5,.81,.17,.24,true) end
	elseif id=="SageMode" then
		for _,x in {.28,.72} do
			shape("EyeMark",x,.49,.32,.28,true).BackgroundColor3=Color3.fromRGB(78,36,28)
			shape("Eye",x,.49,.24,.12,true); shape("Pupil",x,.49,.15,.035,false).BackgroundColor3=Color3.fromRGB(33,30,25)
		end
	elseif id=="KCM" then
		for i=1,5 do shape("Flame",.18+(i-1)*.16,.43,.13,.52,true,(i-3)*18) end
		shape("Seal",.5,.73,.40,.27,true).BackgroundColor3=Color3.fromRGB(77,49,22)
	elseif id=="GuardianArmor" then
		shape("Plate",.5,.46,.54,.58,true); shape("Shoulder",.20,.29,.25,.22,true); shape("Shoulder",.80,.29,.25,.22,true)
	elseif id=="SwiftBoots" then
		shape("Boot",.45,.37,.29,.50,false,-12); shape("Sole",.57,.65,.56,.22,true)
	elseif id=="HealingPotion" then
		shape("Bottle",.5,.50,.46,.57,true); shape("Cork",.5,.18,.26,.15,false)
	else
		shape("Blade",.54,.44,.14,.76,false,38); shape("Guard",.36,.67,.44,.09,false,38); shape("Grip",.24,.83,.10,.27,false,38)
	end
	return canvas
end
return Icons
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="143">
            <Properties>
              <string name="Name">HUDLayout</string>
              <string name="Source"><![CDATA[--!strict
-- Reference space: 1920x1080. Scale with height; never stretch on ultrawide.
local Layout = { ConsoleWidth = 900, ConsoleHeight = 164, TopWidth = 920, TopHeight = 48,
	RikudoPanelY = -124, RikudoTooltipY = -284 }
function Layout.skill(index: number): (number, number, number)
	if index<=5 then return 240+(index-1)*66,38,60 end
	return 582+(index-6)*38,54,32
end
function Layout.item(index: number): (number,number)
	return 704+((index-1)%3)*62,24+math.floor((index-1)/3)*52
end
function Layout.scale(width: number, height: number): number
	return math.min(height / 1080, (width - 32) / Layout.ConsoleWidth, (width - 240) / Layout.TopWidth)
end
return table.freeze(Layout)
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="144">
            <Properties>
              <string name="Name">HeroAppearanceTransition</string>
              <string name="Source"><![CDATA[--!strict
-- Presentation only: keep a loaded costume while its successor is replicated/preloaded.
local Content=game:GetService("ContentProvider")
local Run=game:GetService("RunService")
local Shared=game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Controller={}
type State={model:Model,source:Folder?,shown:Folder?,generation:number,connection:RBXScriptConnection?}
local states:{[Model]:State}={}
local started=false
local function hide(folder:Instance)
 for _,part in folder:GetDescendants() do if part:IsA("BasePart") then part.Transparency=1 end end
end
local function alpha(folder:Folder,value:number)
 for _,part in folder:GetChildren() do
  if part:IsA("BasePart") then
   local original=part:GetAttribute("TransitionTransparency")
   part.Transparency=(if typeof(original)=="number" then original else 0)+(1-(if typeof(original)=="number" then original else 0))*value
  end
 end
end
local function visualCopy(source:Folder,model:Model):Folder
 local copy=Instance.new("Folder");copy.Name="DisplayedHeroAppearance"
 copy:SetAttribute("AppearanceVersion",source:GetAttribute("AppearanceVersion"))
 copy:SetAttribute("AppearanceForm",source:GetAttribute("AppearanceForm"))
 for _,original in source:GetChildren() do
  if not original:IsA("BasePart") then continue end
  local bodyName=original:GetAttribute("CosmeticBody");local offset=original:GetAttribute("CosmeticOffset")
  local body=if typeof(bodyName)=="string" then model:FindFirstChild(bodyName) else nil
  if not body or not body:IsA("BasePart") or typeof(offset)~="CFrame" then continue end
  local part=original:Clone()
  for _,child in part:GetDescendants() do
   if not child:IsA("DataModelMesh") and not child:IsA("Decal") and not child:IsA("SurfaceAppearance") then child:Destroy() end
  end
  local target=original:GetAttribute("AppearanceTransparency")
  part.Transparency=if typeof(target)=="number" then target else 0
  part:SetAttribute("TransitionTransparency",part.Transparency)
  part.CanCollide=false;part.CanTouch=false;part.CanQuery=false;part.Massless=true;part.Anchored=false
  part.LocalTransparencyModifier=0;part.CFrame=body.CFrame*offset;part.Parent=copy
  local weld=Instance.new("Weld");weld.Name="FormVisualWeld";weld.Part0=body;weld.Part1=part;weld.C0=offset;weld.Parent=part
 end
 return copy
end
local function stage(state:State,folder:Folder)
 if state.source==folder then return end
 state.source=folder;state.generation+=1
 local generation=state.generation
 hide(folder)
 task.spawn(function()
  local function current():boolean return state.model.Parent~=nil and state.generation==generation and folder.Parent==state.model end
  -- Attribute/descendant replication is not atomic, even when the server builds off-tree.
  while current() do
   local expected=folder:GetAttribute("AppearanceParts")
   local descendants=folder:GetAttribute("AppearanceDescendants")
   if typeof(expected)=="number" and #folder:GetChildren()>=expected and typeof(descendants)=="number" and #folder:GetDescendants()>=descendants then break end
   Run.Heartbeat:Wait()
  end
  if not current() then return end
  local copy=visualCopy(folder,state.model)
  if not state.shown then
   -- First spawn has no previous costume; show it while warming its textures.
   copy.Parent=state.model;state.shown=copy
   pcall(function() Content:PreloadAsync({copy}) end)
   return
  end
  local fetched=true
  local ready=pcall(function() Content:PreloadAsync({copy},function(_id,status)
   if status~=Enum.AssetFetchStatus.Success then fetched=false end
  end) end)
  if not current() or not ready or not fetched then copy:Destroy();return end
  local previous=state.shown
  alpha(copy,1);copy.Parent=state.model
  local at=os.clock()
  while current() do
   local t=math.clamp((os.clock()-at)/.55,0,1)
   -- Keep the old face fully opaque until the new face is opaque.
   local incoming=math.clamp(t/.6,0,1);incoming=incoming*incoming*(3-2*incoming)
   local outgoing=math.clamp((t-.6)/.4,0,1);outgoing=outgoing*outgoing*(3-2*outgoing)
   alpha(copy,1-incoming);if previous then alpha(previous,outgoing) end
   if t>=1 then break end
   Run.RenderStepped:Wait()
  end
  if not current() then copy:Destroy();if previous and previous.Parent then alpha(previous,0) end;return end
  if previous then previous:Destroy() end
  state.shown=copy;alpha(copy,0)
 end)
end
local function bind(model:Model)
 if states[model] then return end
 local state:State={model=model,source=nil,shown=nil,generation=0,connection=nil};states[model]=state
 state.connection=model.DescendantAdded:Connect(function(item)
  local parent=item.Parent
  if parent and (parent.Name=="HeroAppearance" or parent.Name=="PreviousHeroAppearance") and item:IsA("BasePart") then item.Transparency=1 end
  if item:IsA("Folder") and item.Parent==model and item.Name=="HeroAppearance" then stage(state,item) end
 end)
 for _,child in model:GetChildren() do
  if child.Name=="PreviousHeroAppearance" then hide(child) end
  if child:IsA("Folder") and child.Name=="HeroAppearance" then stage(state,child) end
 end
 model.Destroying:Once(function()
  state.generation+=1;if state.connection then state.connection:Disconnect() end
  if state.shown then state.shown:Destroy() end;states[model]=nil
 end)
end
function Controller.Start()
 if started then return end;started=true
 -- Warm every form's mesh/face IDs before the first transformation when possible.
 task.spawn(function()
  local cache=Instance.new("Folder")
  local factory=require(Shared.CreatorVisualFactory)
  local data=require(Shared.Config.CreatorVisualData)
  local forms=require(Shared.Config.NarutoFormVisualData)
  -- Typed Instances ensure mesh IDs are fetched as meshes, not as generic images.
  local function add(specs:any) for _,s in specs do factory.Part(s).Parent=cache end end
  add(data.appearance);for _,specs in forms do add(specs) end
  for _,id in {"rbxassetid://9477576334","rbxassetid://9449064416"} do
   local part=Instance.new("Part");part.Parent=cache;local decal=Instance.new("Decal");decal.Texture=id;decal.Parent=part
  end
  pcall(function() Content:PreloadAsync({cache}) end);cache:Destroy()
 end)
 workspace.DescendantAdded:Connect(function(item)
  if item:IsA("Folder") and item.Name=="HeroAppearance" and item.Parent and item.Parent:IsA("Model") then bind(item.Parent) end
 end)
 for _,item in workspace:GetDescendants() do
  if item:IsA("Folder") and item.Name=="HeroAppearance" and item.Parent and item.Parent:IsA("Model") then bind(item.Parent) end
 end
end
return Controller
]]></string>
