      <Item class="ModuleScript" referent="116">
        <Properties>
          <string name="Name">CreatorVisualFactory</string>
          <string name="Source"><![CDATA[--!strict
-- Rebuild only whitelisted visual properties; never load marketplace scripts at runtime.
local Factory = {}
export type Spec = { name: string, body: string, form: string, size: {number}, cf: {number}, color: {number},
 transparency: number, mesh: string, texture: string, scale: {number}, offset: {number},
 decals: {{face: string, texture: string, transparency: number}} }
function Factory.Vector(v: {number}): Vector3 return Vector3.new(v[1],v[2],v[3]) end
function Factory.Frame(v: {number}): CFrame
 return CFrame.new(v[1],v[2],v[3],v[4],v[5],v[6],v[7],v[8],v[9],v[10],v[11],v[12])
end
function Factory.Part(spec: Spec): (Part, SpecialMesh)
 local p=Instance.new("Part");p.Name=spec.name;p.Size=Factory.Vector(spec.size)
 p.CanCollide=false;p.CanTouch=false;p.CanQuery=false;p.Massless=true;p.CastShadow=false
 p.Color=Color3.new(spec.color[1],spec.color[2],spec.color[3]);p.Transparency=spec.transparency
 p.Material=Enum.Material.SmoothPlastic
 local mesh=Instance.new("SpecialMesh");mesh.MeshType=Enum.MeshType.FileMesh
 mesh.MeshId=spec.mesh;mesh.TextureId=spec.texture;mesh.Scale=Factory.Vector(spec.scale);mesh.Offset=Factory.Vector(spec.offset);mesh.Parent=p
 for _,value in spec.decals do
  local decal=Instance.new("Decal");decal.Face=(Enum.NormalId :: any)[value.face]
  decal.Texture=value.texture;decal.Transparency=value.transparency;decal.Parent=p
 end
 return p,mesh
end
return Factory
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="117">
        <Properties>
          <string name="Name">GamakichiAppearance</string>
          <string name="Source"><![CDATA[--!strict
-- Blender-authored skinned mesh. The collider remains independent of the visual skeleton.
local A={}
local template=script.Parent:WaitForChild("GamakichiRig")
function A.Build(model:Model,root:BasePart,adult:boolean)
 local original=template:FindFirstChildWhichIsA("MeshPart",true)
 assert(original,"Gamakichi mesh is missing")
 local skin=original:Clone()
 local scale=(if adult then 7 else 5)/original.Size.X
 skin.Name="GamakichiSkin";skin.Anchored=true;skin.CanCollide=false;skin.CanTouch=false;skin.CanQuery=false
 skin.Size=original.Size*scale
 for _,bone in skin:GetDescendants() do
  if bone:IsA("Bone") then bone.CFrame=CFrame.new(bone.CFrame.Position*scale)*bone.CFrame.Rotation end
 end
 local floor=-math.max(4,root.Size.Y)/2
 local offset=CFrame.new(original.CFrame.Position*scale+Vector3.new(0,floor,0))
 skin:SetAttribute("HeroCosmetic",true);skin:SetAttribute("ToadVisual",true);skin:SetAttribute("ToadOffset",offset)
 skin.CFrame=root.CFrame*offset;skin.Parent=model
 model:SetAttribute("GamakichiVisualWidth",if adult then 7 else 5)
 model:SetAttribute("GamakichiVisualVersion",3);model:SetAttribute("ToadScale",scale)
end
return A
]]></string>
        </Properties>
      </Item>
