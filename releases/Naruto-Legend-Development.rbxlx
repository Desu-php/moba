          <Properties>
            <string name="Name">CloneService</string>
            <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config.AbilityConfig).Clones
local Damage = require(script.Parent.DamageService)
local Stats = require(script.Parent.CharacterStatsService)
local Targets = require(script.Parent.AbilityTargetService)
local Hitboxes = require(script.Parent.HitboxService)
local Collision = require(script.Parent.SummonCollision)
export type Clone = { model: Model, root: BasePart, humanoid: Humanoid, owner: Player, character: Model,
	expires: number, nextHit: number, hits: number }
local CloneService = { Spawned = Instance.new("BindableEvent") }
local records: { [Model]: Clone } = {}
local count, nextUpdate = 0, 0
function CloneService.GetCount(): number return count end
function CloneService.GetAll(): { [Model]: Clone } return records end
function CloneService.Remove(model: Model)
	if not records[model] then return end
	records[model] = nil; count -= 1; model:Destroy()
end
function CloneService.ClearOwner(player: Player)
	for model, record in records do if record.owner == player then CloneService.Remove(model) end end
end
function CloneService.Reset()
	for model in records do CloneService.Remove(model) end
	nextUpdate = 0
end
function CloneService.Spawn(player: Player, character: Model): number
	if player.Character ~= character or not Damage.CanAct(character) then return 0 end
	CloneService.ClearOwner(player)
	local root = character:FindFirstChild("HumanoidRootPart")
	if not root or not root:IsA("BasePart") or not Hitboxes.IsFiniteCFrame(root.CFrame) then return 0 end
	local folder = workspace:FindFirstChild("HeroSummons")
	if not folder then folder = Instance.new("Folder"); folder.Name = "HeroSummons"; folder.Parent = workspace end
	local spawned = 0
	for i = 1, Config.Count do
		if count >= Config.GlobalLimit then break end
		local previous = character.Archivable; character.Archivable = true
		local model = character:Clone(); character.Archivable = previous
		for _, item in model:GetDescendants() do
			if item:IsA("LuaSourceContainer") or item:IsA("Tool") or item:IsA("ForceField") then item:Destroy()
			elseif item:IsA("BasePart") then item.CanCollide = false; item.CanTouch = false; item.CanQuery = false; item.Massless = true end
		end
		model.Name = "ShadowClone"; model:SetAttribute("EntityKind", "Summon"); model:SetAttribute("SummonOwner", player.UserId)
		model:SetAttribute("CombatDisabled", false); model:SetAttribute("CombatState", "Idle")
		model:SetAttribute("AbilityId", ""); model:SetAttribute("LifeId", nil)
		model:SetAttribute("CombatLastAttackAt", 0); model:SetAttribute("CombatAttackEndsAt", 0)
		local cloneRoot = model:FindFirstChild("HumanoidRootPart") :: BasePart
		local humanoid = model:FindFirstChildOfClass("Humanoid") :: Humanoid
		humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None; humanoid.BreakJointsOnDeath = false
		humanoid.MaxHealth = 100; humanoid.Health = 100
		cloneRoot.Anchored = true; model.PrimaryPart = cloneRoot
		model:PivotTo(root.CFrame)
		local offset = root.CFrame.RightVector * (if i % 2 == 0 then Config.SpawnOffset else -Config.SpawnOffset) + root.CFrame.LookVector * Config.SpawnForward
		local ray = RaycastParams.new(); ray.FilterType = Enum.RaycastFilterType.Exclude; ray.FilterDescendantsInstances = { character, folder :: Instance }; ray.RespectCanCollide = true
		local wall = workspace:Blockcast(root.CFrame, Vector3.new(2, 4, 2), offset, ray)
		if wall then offset = offset.Unit * math.max(0, wall.Distance - 0.3) end
		Collision.Apply(model)
		model:PivotTo(root.CFrame + offset); model.Parent = folder
		local now = workspace:GetServerTimeNow()
		records[model] = { model = model, root = cloneRoot, humanoid = humanoid, owner = player, character = character,
			expires = now + Config.Lifetime, nextHit = now + Config.Interval, hits = 0 }
		count += 1; spawned += 1; CloneService.Spawned:Fire(model)
	end
	return spawned
end
function CloneService.Update(now: number)
	-- Cleanup is checked every server tick; target search is shared and capped at 10 Hz.
	for model, record in records do
		if not model.Parent or record.owner.Parent ~= Players or record.owner.Character ~= record.character
			or not Damage.CanAct(record.character) or now >= record.expires then CloneService.Remove(model) end
	end
	if now < nextUpdate then return end; nextUpdate = now + Config.UpdateInterval
	for model, record in records do
		local target = if record.hits < Config.MaxHits then Targets.Nearest(record.character, record.root.CFrame, Config.Radius, -1, false) else nil
		local targetModel = if target then target.Parent else nil
		local targetRoot = if targetModel then targetModel:FindFirstChild("HumanoidRootPart") else nil
		if not target or not targetModel or not targetModel:IsA("Model") or not targetRoot or not targetRoot:IsA("BasePart") then model:SetAttribute("SummonMoving", false); continue end
		local delta = targetRoot.Position - record.root.Position
		local horizontal = delta * Vector3.new(1, 0, 1)
		if horizontal.Magnitude > 0.001 then record.root.CFrame = CFrame.lookAt(record.root.Position, record.root.Position + horizontal) end
		if delta.Magnitude <= Config.Range then
			model:SetAttribute("SummonMoving", false)
			if now >= record.nextHit and Targets.Visible(record.character, targetModel, record.root.Position, targetRoot.Position) then
				record.nextHit = now + Config.Interval; record.hits += 1
				model:SetAttribute("SummonSwingAt", now); model:SetAttribute("SummonSwingStep", (record.hits - 1) % 2 + 1)
				local stats = Stats.GetForModel(record.character)
				Damage.Apply(record.character, target, Config.Damage * (if stats then stats.AttackDamageMultiplier else 1))
			end
		else
			model:SetAttribute("SummonMoving", true)
			if horizontal.Magnitude < 0.001 then continue end
			local step = horizontal.Unit * math.min(horizontal.Magnitude - Config.Range * 0.8, Config.Speed * Config.UpdateInterval)
			local ray = RaycastParams.new(); ray.FilterType = Enum.RaycastFilterType.Exclude
			ray.FilterDescendantsInstances = { record.character, model.Parent :: Instance, targetModel }; ray.RespectCanCollide = true
			local wall = workspace:Blockcast(record.root.CFrame, Vector3.new(2, 4, 2), step, ray)
			if not wall then model:PivotTo(record.root.CFrame + step) end
		end
	end
end
Players.PlayerRemoving:Connect(CloneService.ClearOwner)
return CloneService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="218">
          <Properties>
            <string name="Name">CombatLifeService</string>
            <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Ledger = require(Shared.Game.RewardLedger)
local Config = require(Shared.Config.ProgressionConfig)
local Structures = require(Shared.Game.StructureRules)
export type Death = { lifeId: number, roundId: number?, model: Model, victimUserId: number?, teamId: string, kind: string, minionType: string,
 position: Vector3, killer: Ledger.Actor?, assists: { Ledger.Actor } }
type Life = { id: number, model: Model, humanoid: Humanoid, ledger: Ledger.Ledger, scheduled: boolean, onDeath: (() -> ())?, connections: { RBXScriptConnection } }
local LifeService = { Died = Instance.new("BindableEvent") }
local lives: { [Model]: Life } = {}
local serial, generation = 0, 0
function LifeService.Remove(model: Model)
 local life = lives[model]; if not life then return end
 for _, connection in life.connections do connection:Disconnect() end
 lives[model] = nil
end
function LifeService.Register(model: Model)
	if lives[model] or Structures.isStructure(model:GetAttribute("EntityKind")) or model:GetAttribute("EntityKind") == "Summon" then return end
 local humanoid = model:FindFirstChildOfClass("Humanoid"); if not humanoid then return end
 serial += 1
 local life: Life = { id = serial, model = model, humanoid = humanoid, ledger = Ledger.new(), scheduled = false, connections = {} }
 lives[model] = life; model:SetAttribute("LifeId", serial)
 local function died()
  if life.scheduled then return end; life.scheduled = true
  local time = workspace:GetServerTimeNow()
  local position = model:GetPivot().Position
  local epoch = generation
  -- Defer until Damage.Apply has recorded the confirmed lethal damage.
  task.defer(function()
   if epoch ~= generation then return end
   local claimed, killer, assists = Ledger.claim(life.ledger, math.max(time, workspace:GetServerTimeNow()), Config.AttributionWindow)
   if not claimed then return end
   local player = Players:GetPlayerFromCharacter(model)
   local death: Death = { lifeId = life.id, roundId = model:GetAttribute("RoundId") :: number?, model = model, victimUserId = if player then player.UserId else nil,
    teamId = tostring(model:GetAttribute("TeamId") or ""), kind = tostring(model:GetAttribute("EntityKind") or ""),
    minionType = tostring(model:GetAttribute("MinionType") or ""), position = position, killer = killer, assists = assists }
   LifeService.Died:Fire(death)
  end)
 end
 life.onDeath = died
 table.insert(life.connections, humanoid.Died:Connect(died))
 table.insert(life.connections, model.AncestryChanged:Connect(function()
  if not model:IsDescendantOf(workspace) then LifeService.Remove(model) end
 end))
 if humanoid.Health <= 0 then died() end
end
function LifeService.Record(attacker: Model, victim: Model)
 LifeService.Register(victim)
 local life = lives[victim]; if not life then return end
 local player = Players:GetPlayerFromCharacter(attacker)
 if not player and (attacker:GetAttribute("NativeNarutoClone") == true or attacker:GetAttribute("NativeGamakichi")==true) then
  local owner = attacker:GetAttribute("SummonOwner")
  if typeof(owner) == "number" then player = Players:GetPlayerByUserId(owner) end
 end
 local actor: Ledger.Actor = { userId = if player then player.UserId else nil, teamId = tostring(attacker:GetAttribute("TeamId") or "") }
 Ledger.record(life.ledger, actor, tostring(victim:GetAttribute("TeamId") or ""), workspace:GetServerTimeNow())
 -- A freshly spawned Humanoid can reach zero HP before its first physics step
 -- without firing Died. Confirm death after recording the lethal hit; the same
 -- scheduled flag deduplicates the later engine event.
 if life.humanoid.Health <= 0 and life.onDeath then life.onDeath() end
end
function LifeService.ResetHistory()
 generation += 1
 for _, life in lives do life.ledger = Ledger.new() end
end
function LifeService.Reset()
 generation += 1
 for model in lives do LifeService.Remove(model) end
end
Players.PlayerRemoving:Connect(function(player)
 for _, life in lives do Ledger.forget(life.ledger, player.UserId) end
 if player.Character then LifeService.Remove(player.Character) end
end)
return LifeService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="219">
          <Properties>
            <string name="Name">CombatService</string>
            <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config.CombatConfig)
local Debug = require(Shared.Config.DebugConfig)
local Protocol = require(Shared.Combat.CombatProtocol)
local State = require(Shared.Combat.CombatState)
local Fighters = require(script.Parent.FighterStateService)
local Hitboxes = require(script.Parent.HitboxService)
local AttackRules = require(Shared.Combat.BasicAttackRules)
local RequestLimiter = require(script.Parent.RequestLimiter)
local Damage = require(script.Parent.DamageService)
local Sleep = require(script.Parent.NarutoSleepService)
local Stats = require(script.Parent.CharacterStatsService)
local Structures = require(Shared.Game.StructureRules)
local Teams = require(script.Parent.TeamService)
local RoundProtocol = require(Shared.Game.RoundProtocol)

type Session = { bucket: RequestLimiter.Bucket, lastRequestId: number, lastRejectAt: number }
local KuramaSwipe=require(script.Parent.KuramaSwipeService)
local KuramaShape=require(Shared.Config.KuramaAvatarConfig)
type Sweep={id:number,phase:number,origin:CFrame,seen:{[Humanoid]:boolean}}
local sweeps:{[Model]:Sweep}=setmetatable({}, {__mode="k"})
local CombatService = { AttackStarted = Instance.new("BindableEvent") }
-- A prepared melee technique may replace the ordinary strike after the server
-- has verified contact. It must never consume itself merely on attack intent.
local heroContacts:{[string]:(Fighters.Fighter,Model)->boolean}={}
local heroGuards:{[string]:(Fighters.Fighter)->boolean}={}
function CombatService.SetHeroHandlers(id:string,contact:(Fighters.Fighter,Model)->boolean,guard:(Fighters.Fighter)->boolean) heroContacts[id]=contact;heroGuards[id]=guard end
local contactHandler: ((Fighters.Fighter, Model) -> boolean)? = nil
local attackGuard: ((Fighters.Fighter) -> boolean)? = nil
function CombatService.SetAttackGuard(guard: (Fighters.Fighter) -> boolean) attackGuard=guard end
function CombatService.SetContactHandler(handler: (Fighters.Fighter, Model) -> boolean)
	contactHandler = handler
end
local sessions: { [Player]: Session } = {}
local eventRemote: RemoteEvent? = nil
local started = false

local function broadcastState(fighter: Fighters.Fighter)
	local remote = eventRemote
	if remote then
		remote:FireAllClients({ kind = "State", snapshot = Fighters.Snapshot(fighter) })
	end
end

local function reject(player: Player, requestId: number, character: Model?, reason: string)
	local remote = eventRemote
	if not remote then return end
	local fighter = if character then Fighters.Get(character) else nil
	remote:FireClient(player, {
		kind = "Rejected", requestId = requestId, character = character, reason = reason,
		snapshot = if fighter then Fighters.Snapshot(fighter) else nil,
	})
end

local function announceStart(fighter: Fighters.Fighter)
	local attack, remote = fighter.logic.active, eventRemote
	if not attack or not remote then return end
	Fighters.Publish(fighter)
	fighter.attackLifeId = fighter.character:GetAttribute("LifeId")
	fighter.attackRoundId = fighter.character:GetAttribute("RoundId")
	fighter.attackProfileId = fighter.profileId
	fighter.wakeOnlyAttackId=nil
	local candidates=Hitboxes.GetTargets(fighter.character,fighter.root,fighter.profile,function(target)
		return Sleep.CanWakeAlly(fighter.character,target)
	end)
    local first=candidates[1]
    local model=if first then first.Parent else nil
    local wakeOnly=model~=nil and model:IsA("Model") and Sleep.TryWakeAlly(fighter.character,model)
    if wakeOnly then fighter.wakeOnlyAttackId=attack.id end
    for _,hp in candidates do
        local target=hp.Parent
        if target and target:IsA("Model") and Damage.CanDamage(fighter.character,target) then Damage.NotifyAttackAttempt(fighter.character,target) end
    end
    if not wakeOnly then CombatService.AttackStarted:Fire(fighter,model) end
	remote:FireAllClients({ kind = "Started", snapshot = Fighters.Snapshot(fighter), attack = attack })
	if Debug.LogCombat then
		print(string.format("[Combat] %s M1-%d request=%d", fighter.character.Name, attack.step, attack.requestId))
	end
end

local function canAttack(fighter: Fighters.Fighter): boolean
	return fighter.character:IsDescendantOf(Workspace)
		and (not attackGuard or attackGuard(fighter))
        and (not heroGuards[tostring(fighter.character:GetAttribute("HeroId"))] or heroGuards[tostring(fighter.character:GetAttribute("HeroId"))](fighter))
		and Damage.CanAct(fighter.character)
		and not (fighter.sleep and fighter.sleep.active)
		and ((fighter.character:GetAttribute("NarutoPausedUntil") or 0) :: number) <= Workspace:GetServerTimeNow()
		and (fighter.character:GetAttribute("AbilityId") == nil or fighter.character:GetAttribute("AbilityId") == "")
		and fighter.humanoid.Health > 0
		and fighter.humanoid:GetState() ~= Enum.HumanoidStateType.Dead
		and fighter.root:IsDescendantOf(fighter.character)
		and not fighter.root.Anchored
		and Hitboxes.IsFiniteCFrame(fighter.root.CFrame)
end

local function attackSpeed(fighter: Fighters.Fighter): number
	local stats = Stats.GetForModel(fighter.character)
	local poison=(fighter.character:GetAttribute("SnakePoisonUntil") or 0) :: number
	return AttackRules.speed(fighter.profile, if stats then stats.Agility else 0)*(if poison>Workspace:GetServerTimeNow() then (fighter.character:GetAttribute("SnakePoisonAttack") or 1) :: number else 1)
end
-- Only request identity and the exact current character may come from the client.
function CombatService.TryAttack(player: Player, ...: any): string
	if player.Parent ~= Players then return "Rejected" end
	local now = Workspace:GetServerTimeNow()
	local session = sessions[player]
	if not session then
		session = {
			bucket = RequestLimiter.new(Config.RemoteLimit.Burst, Config.RemoteLimit.RequestsPerSecond, now),
			lastRequestId = 0, lastRejectAt = 0,
		}
		sessions[player] = session
	end
	local allowed = RequestLimiter.Consume(session.bucket, now)
	local requestId, characterValue = ...
	local validId = typeof(requestId) == "number" and requestId == requestId
		and requestId >= 1 and requestId <= Config.MaxRequestId and requestId % 1 == 0
	if not validId then return "Rejected" end
	if not allowed then
		if now - session.lastRejectAt >= Config.RemoteLimit.RejectReplyInterval then
			session.lastRejectAt = now
			reject(player, requestId, player.Character, "RateLimited")
		end
		return "Rejected"
	end
	if select("#", ...) ~= 2 or typeof(characterValue) ~= "Instance" then
		reject(player, requestId, player.Character, "Malformed")
		return "Rejected"
	end
	local character = characterValue :: Instance
	if not character:IsA("Model") or character ~= player.Character then
		reject(player, requestId, player.Character, "Malformed")
		return "Rejected"
	end
	if requestId <= session.lastRequestId then
		reject(player, requestId, character, "Replay")
		return "Rejected"
	end
	session.lastRequestId = requestId
	local fighter = Fighters.GetOrCreate(character)
	if not fighter or not canAttack(fighter) then
		reject(player, requestId, character, "Unavailable")
		return "Rejected"
	end
	Fighters.Update(fighter, now)
	local result, reason = State.Request(fighter.logic, fighter.profile, now, requestId, attackSpeed(fighter))
	if result == "Started" then
		announceStart(fighter)
	elseif result == "Buffered" then
		local remote = eventRemote
		if remote then remote:FireClient(player, { kind = "Buffered", requestId = requestId, snapshot = Fighters.Snapshot(fighter) }) end
	else
		reject(player, requestId, character, reason or "Unavailable")
	end
	return result
end

local function resolveHit(fighter: Fighters.Fighter, attack: State.Attack, swept: {Humanoid}?, seen: {[Humanoid]:boolean}?)
	-- This committed swing already woke its one ally at attack-start. It must not
	-- retarget an enemy at impact or consume a held Rasengan/offensive proc.
	if fighter.wakeOnlyAttackId==attack.id then return end
	if Fighters.Get(fighter.character) ~= fighter
		or fighter.attackLifeId ~= fighter.character:GetAttribute("LifeId")
		or fighter.attackRoundId ~= fighter.character:GetAttribute("RoundId")
		or fighter.attackProfileId ~= fighter.profileId
		or not canAttack(fighter) then return end
	local profile = fighter.profile
	local targets, box, size = Hitboxes.GetTargets(fighter.character, fighter.root, profile)
 if swept then targets=swept end
	local hits = {}
	local stats = Stats.GetForModel(fighter.character)
	local multiplier = if stats then stats.AttackDamageMultiplier else 1
	for _, humanoid in targets do
  if seen and seen[humanoid] then continue end
  if seen then seen[humanoid]=true end
		local character = humanoid.Parent
		if not character or not character:IsA("Model") then continue end
		local isStructure = Structures.isStructure(character:GetAttribute("EntityKind"))
		local victim = if isStructure then nil else Fighters.GetOrCreate(character)
		if not isStructure and not victim then continue end
		local handler = heroContacts[tostring(fighter.character:GetAttribute("HeroId"))] or contactHandler
		if handler and handler(fighter, character) then continue end
		local dealt = Damage.ApplyAttack(fighter.character, humanoid, profile.Damage * multiplier + (if stats then stats.AttackDamageBonus else 0))
		-- Only confirmed server damage is a hit.
		if dealt <= 0 then continue end
		if fighter.profileId=="Kurama" and not isStructure then
			local away=(character:GetPivot().Position-fighter.root.Position)*Vector3.new(1,0,1)
			character:SetAttribute("PawHitDirection",if away.Magnitude>.01 then away.Unit else fighter.root.CFrame.LookVector)
			character:SetAttribute("PawHitAt",Workspace:GetServerTimeNow())
		end
		local position = character:GetPivot().Position
		table.insert(hits, { character = character, position = position })
	end
	local remote = eventRemote
	if remote then
		remote:FireAllClients({
			kind = "Hit", snapshot = Fighters.Snapshot(fighter), attackId = attack.id,
			step = attack.step, hits = hits,
			hitboxCFrame = if Debug.DebugHitboxes then box else nil,
			hitboxSize = if Debug.DebugHitboxes then size else nil,
		})
	end
end

local function heartbeat()
	local now = Workspace:GetServerTimeNow()
	for character, fighter in Fighters.GetAll() do
		if not character:IsDescendantOf(Workspace) then
			Fighters.Remove(character)
			continue
		end
		Fighters.Update(fighter, now)
		local attack = State.ClaimHit(fighter.logic, now)
		if fighter.profileId=="Kurama" then
   local current=fighter.logic.active
   if current and fighter.logic.mode=="Attacking" then
    local sweep=sweeps[character]
    if not sweep or sweep.id~=current.id then sweep={id=current.id,phase=0,origin=fighter.root.CFrame,seen={}};sweeps[character]=sweep end
    local phase=math.clamp((now-current.startedAt)/(current.endsAt-current.startedAt),0,1)
    if phase>=KuramaShape.SwipeStart and sweep.phase<=KuramaShape.SwipeEnd then
     local targets=KuramaSwipe.Targets(character,fighter.root.CFrame,sweep.origin,sweep.phase,phase,current.id,now)
     if #targets>0 then resolveHit(fighter,current,targets,sweep.seen) end
    end
    sweep.phase=phase;sweep.origin=fighter.root.CFrame
   else sweeps[character]=nil end
  elseif attack then sweeps[character]=nil;resolveHit(fighter, attack) end
		local requestId, valid = State.TakeBuffer(fighter.logic, now)
		if requestId then
			if valid and canAttack(fighter) then
				local result = State.Request(fighter.logic, fighter.profile, now, requestId, attackSpeed(fighter))
				if result == "Started" then announceStart(fighter) end
			elseif fighter.player then
				reject(fighter.player, requestId, character, "BufferExpired")
			end
		end
	end
end

-- Trusted server callers use TryAttack; network callers must carry the round.
function CombatService.HandleRequest(player: Player, ...: any): string
	local match = Teams.GetState()
	if not match then return CombatService.TryAttack(player, ...) end
	local args = table.pack(...)
	if not RoundProtocol.accepts(match.roundId, args[args.n]) then return "Rejected" end
	return CombatService.TryAttack(player, table.unpack(args, 1, args.n - 1))
end
function CombatService.Start()
	if started then return end
	local existingFolder = ReplicatedStorage:FindFirstChild(Protocol.FolderName)
	assert(not existingFolder or existingFolder:IsA("Folder"), "CombatRemotes must be a Folder")
	local folder = existingFolder or Instance.new("Folder")
	folder.Name = Protocol.FolderName
	local function makeRemote(name: string): RemoteEvent
		local existing = folder:FindFirstChild(name)
		assert(not existing or existing:IsA("RemoteEvent"), name .. " must be a RemoteEvent")
		local remote = (existing or Instance.new("RemoteEvent")) :: RemoteEvent
		remote.Name = name
		remote.Parent = folder
		return remote
	end
	local request = makeRemote(Protocol.BasicAttackName)
	eventRemote = makeRemote(Protocol.EventName)
	request.OnServerEvent:Connect(function(player: Player, ...: any)
		CombatService.HandleRequest(player, ...)
	end)
	Players.PlayerRemoving:Connect(function(player: Player) sessions[player] = nil end)
	Fighters.Changed.Event:Connect(broadcastState)
	Fighters.Start()
	RunService.Heartbeat:Connect(heartbeat)
	started = true
	folder.Parent = ReplicatedStorage
end

return CombatService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="220">
          <Properties>
            <string name="Name">DamageService</string>
            <string name="Source"><![CDATA[--!strict
local Teams = require(script.Parent.TeamService)
local Stats = require(script.Parent.CharacterStatsService)
local Life = require(script.Parent.CombatLifeService)
local Structures = require(script.Parent.StructureService)
local TowerRewards = require(script.Parent.TowerRewardService)
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Rules = require(Shared.Game.ProgressionRules).configure(require(Shared.Config.ProgressionConfig), require(Shared.Config.ItemConfig).Items)
local DamageService = { Applied = Instance.new("BindableEvent"), AttackAttempt = Instance.new("BindableEvent") }
local enabled = true
local aodaGuards:{[Model]:{source:Model,untilAt:number}}={}
function DamageService.SetAodaGuard(target:Model,source:Model,untilAt:number)
 aodaGuards[target]={source=source,untilAt=untilAt};target:SetAttribute("AodaGuardUntil",untilAt)
end
function DamageService.ClearAodaGuard(source:Model)
 for target,guard in aodaGuards do if guard.source==source then target:SetAttribute("AodaGuardUntil",nil);aodaGuards[target]=nil end end
end
local incoming:{[string]:(Model,number,string?)->number}={}
function DamageService.RegisterIncoming(id:string,handler:(Model,number,string?)->number) incoming[id]=handler end
local Oil=require(script.Parent.OilStatusService)
function DamageService.SetEnabled(value: boolean) enabled = value end
function DamageService.CanAct(model: Model): boolean
	if not enabled or model:GetAttribute("CombatDisabled") == true or not model:IsDescendantOf(workspace) then return false end
	local state = Teams.GetState()
	local player = game:GetService("Players"):GetPlayerFromCharacter(model)
	if state and player and not Teams.IsParticipant(player) then return false end
	if state and (state.phase ~= "InProgress" or model:GetAttribute("RoundId") ~= state.roundId or not (Teams.IsNeutral(model) or Teams.IsActive(Teams.GetId(model)))) then return false end
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	return humanoid ~= nil and humanoid.Health > 0
end
function DamageService.CanDamage(attacker: Model, target: Model): boolean
return DamageService.CanAct(attacker) and DamageService.CanAct(target) and Teams.IsEnemy(attacker, target)
		and (target:GetAttribute("EntityKind") ~= "Summon" or target:GetAttribute("NativeNarutoClone") == true or target:GetAttribute("NativeGamakichi")==true or target:GetAttribute("NativeMeditationClone")==true or target:GetAttribute("NativeAoda")==true)
		and target:GetAttribute("IsDestroyed") ~= true
		and Structures.CanReceive(target)
end
function DamageService.Apply(attacker: Model, humanoid: Humanoid, amount: number, kind:string?): number
	local target = humanoid.Parent
	if not target or not target:IsA("Model") or not DamageService.CanDamage(attacker, target) then return 0 end
	if amount ~= amount or amount <= 0 or amount == math.huge then return 0 end
 local guard=aodaGuards[target]
 if guard then
  if workspace:GetServerTimeNow()>=guard.untilAt or not DamageService.CanAct(guard.source) then target:SetAttribute("AodaGuardUntil",nil);aodaGuards[target]=nil
  elseif kind~="Attack" and kind~="Pure" then amount*=.7 end
 end
	local modifier=incoming[tostring(target:GetAttribute("HeroId"))];if modifier then amount=modifier(target,amount,kind) end
	local before = humanoid.Health
	if attacker:GetAttribute("NativeNarutoClone") == true then amount *= (attacker:GetAttribute("OutgoingDamageMultiplier") :: number) end
	if target:GetAttribute("NativeNarutoClone") == true then amount *= (target:GetAttribute("IncomingDamageMultiplier") :: number) end
	local stats = Stats.GetForModel(target)
	if kind=="Pure" then -- Source pure damage bypasses armor.
 elseif stats then local poison=(target:GetAttribute("SnakePoisonUntil") or 0) :: number;amount = Rules.mitigate(amount, stats.Defense-(if poison>workspace:GetServerTimeNow() then (target:GetAttribute("SnakePoisonArmor") or 0) :: number else 0))
	elseif target:GetAttribute("NativeGamakichi")==true or target:GetAttribute("NativeAoda")==true then amount=Rules.mitigate(amount,(target:GetAttribute("SummonArmor") or 0) :: number) end
	Life.Register(target)
	humanoid:TakeDamage(math.min(amount, before))
	local dealt = math.max(0, before - humanoid.Health)
	if dealt > 0 then
		TowerRewards.Confirmed(attacker, target)
		Life.Record(attacker, target)
		local match = Teams.GetState()
		DamageService.Applied:Fire(attacker, target, dealt, if match then match.roundId else nil)
	end
	return dealt
end
function DamageService.NotifyAttackAttempt(attacker: Model,target: Model)
 if DamageService.CanDamage(attacker,target) then
  local untilAt=(target:GetAttribute("SasukeGenjutsuUntil") or 0) :: number
  local sleeping=(target:GetAttribute("SleepUntil") or 0) :: number
  -- Consume before firing callbacks: attack start and contact cannot award twice.
  local bonus=untilAt>workspace:GetServerTimeNow() and sleeping>workspace:GetServerTimeNow()
  if bonus then target:SetAttribute("SasukeGenjutsuUntil",nil) end
  DamageService.AttackAttempt:Fire(attacker,target)
  local humanoid=target:FindFirstChildOfClass("Humanoid")
  if bonus and humanoid then DamageService.Apply(attacker,humanoid,50,"Pure") end
 end
end
function DamageService.ApplyAttack(attacker: Model,humanoid: Humanoid,amount: number): number
 local target=humanoid.Parent
 if target and target:IsA("Model") then DamageService.NotifyAttackAttempt(attacker,target) end
 if target and target:GetAttribute("NativeAoda")==true and math.random()<.3 then return 0 end
 if Oil.MissesAttack(attacker) then return 0 end
 return DamageService.Apply(attacker,humanoid,amount,"Attack")
end
return DamageService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="221">
          <Properties>
            <string name="Name">DeveloperCommandService</string>
            <string name="Source"><![CDATA[--!strict
-- Studio-only command boundary. No arbitrary code, player targets, or live-server access.
local RunService=game:GetService("RunService")
local Players=game:GetService("Players")
local RS=game:GetService("ReplicatedStorage")
local Shared=RS:WaitForChild("Shared")
local Parser=require(Shared.Game.DeveloperCommandRules)
local Progression=require(script.Parent.HeroProgressionService)
local Rules=require(Shared.Game.ProgressionRules).configure(require(Shared.Config.ProgressionConfig),require(Shared.Config.ItemConfig).Items)
local Learning=require(Shared.Abilities.SkillLearning)
local Naruto=require(script.Parent.NarutoAbilityService)
local Kcm=require(script.Parent.NarutoKcmService)
local Kurama=require(script.Parent.NarutoKuramaService)
local Ranged=require(script.Parent.NarutoRangedService)
local Gama=require(script.Parent.GamakichiService)
local Service={}
local noCooldown: {[Player]: boolean}={}
local requests: {[Player]: number}={}
local started=false
local help="level 30 — уровень • learnall — изучить навыки\nrikudo — сразу включить Рикудо без Хагоромо\nnocd on / nocd off — убрать / вернуть КД героя\nrefresh — восстановить HP, чакру и все КД один раз\nsolo — начать тест одному • help — команды"
local function cooldowns(player: Player, includeSummon: boolean?)
 if player:GetAttribute("HeroId")=="Sasuke" then table.clear(require(script.Parent.SasukeAbilityService).Ready(player)) end
 local s=Naruto.Get(player)
 if s then
  s.q.cooldownAt=0;s.clones.cooldownAt=0;s.sage.cooldownAt=0;s.gama.cooldownAt=0;s.meditationRecallAt=0
  table.clear(s.variants.cooldowns);s.nextPublish=0
 end
 -- nocd is a hero testing aid. Autonomous summons keep their combat cadence.
 -- Only an explicit one-shot refresh resets the toad's independent cooldowns.
 local toad=Gama.Get(player)
 if includeSummon and toad then toad.spells.oilReady=0;toad.spells.chopReady=0 end
 local ranged=Ranged.Inspect(player);if ranged then table.clear(ranged.cooldowns) end
 Kcm.StudioResetCooldowns(player);Kurama.StudioResetCooldowns(player)
 local model=player.Character
 if model then
  for name in model:GetAttributes() do
   local summonSpell=name=="Ready_GamakichiOil" or name=="Ready_GamakichiChop"
   if string.sub(name,1,6)=="Ready_" and (includeSummon or not summonSpell) then model:SetAttribute(name,0) end
  end
 end
end
function Service.Execute(player: Player,raw: any): (boolean,string)
 if not RunService:IsStudio() or player.Parent~=Players then return false,"Команды доступны только в Studio." end
 local command=Parser.parse(raw);if not command then return false,"Неизвестная команда. Введите help." end
 if command.name=="help" then return true,help end
 if command.name=="solo" then
  local match=require(script.Parent.MatchService).GetState()
  if not match or match.phase=="Finished" then return false,"Перезапустите Play для нового матча." end
  workspace:SetAttribute("DeveloperSoloMode",true)
  return true,"Одиночный тест включён. Матч начнётся после подготовки."
 end
 local profile=Progression.Get(player);local s=Naruto.Get(player)
 if not profile or not s then return false,"Дождитесь появления героя." end
 if command.name=="rikudo" then
  if player:GetAttribute("HeroId")~="OrangeNinja" then return false,"Команда rikudo доступна только Наруто." end
  local match=require(script.Parent.MatchService).GetState()
  if not match or match.phase~="InProgress" or not player.Character or not require(script.Parent.DamageService).CanAct(player.Character) then
   return false,"Дождитесь начала матча и появления живого героя."
  end
  local raised,message=Service.Execute(player,"level "..math.max(27,profile.Level))
  if not raised then return false,message end
  while Learning.reason(profile,"KCM")==nil do Learning.learn(profile,"KCM") end
  Progression.Publish(player)
  local ok,reason=Kcm.StudioEnableRikudo(player)
  if not ok then return false,"Не удалось включить Рикудо: завершите текущую технику или оглушение и повторите rikudo. ("..reason..")" end
  return true,if reason=="AlreadyActive" then "Рикудо уже активен, чакра пополнена. F8 закрыть → X выйти → rikudo для повторного перехода."
   else "Рикудо включён без ожидания Хагоромо. F8 закрыть; C → V — выйти. Для повторного перехода: rikudo."
 elseif command.name=="level" then
  local target=command.level :: number
  if target<profile.Level then return false,"Команда повышает уровень. Для сброса перезапустите Play." end
  local xp=-profile.CurrentXP
  for level=profile.Level,target-1 do xp+=Rules.required(level) end
  local gained=Rules.addXP(profile,math.max(0,xp))
  local match=require(script.Parent.TeamService).GetState()
  Progression.Publish(player);Progression.Changed:Fire(player,"XP",gained,if match then match.roundId else nil)
  return true,"Уровень: "..profile.Level..". Очки навыков: "..profile.SkillPoints.."."
 elseif command.name=="learnall" then
  for _,id in Learning.order(tostring(player:GetAttribute("HeroId"))) do while Learning.reason(profile,id,tostring(player:GetAttribute("HeroId")))==nil do Learning.learn(profile,id,tostring(player:GetAttribute("HeroId"))) end end
  Progression.Publish(player)
  return true,"Изучены все навыки, доступные на текущем уровне."
 elseif command.name=="nocd" then
  noCooldown[player]=command.enabled==true;player:SetAttribute("DeveloperNoCooldown",command.enabled)
  if command.enabled then cooldowns(player) end
  return true,if command.enabled then "КД героя отключены. Гамакичи сохраняет обычные КД." else "Обычные КД героя включены для следующих применений."
 elseif command.name=="refresh" then
  cooldowns(player,true);s.pool.mana=s.pool.maximum
  local humanoid=if player.Character then player.Character:FindFirstChildOfClass("Humanoid") else nil
  if humanoid and humanoid.Health>0 then humanoid.Health=humanoid.MaxHealth end
  return true,"HP, чакра и перезарядки восстановлены."
 end
 return false,"Неизвестная команда."
end
function Service.Start()
 if started or not RunService:IsStudio() then return end;started=true
 local remote=Instance.new("RemoteEvent");remote.Name="DeveloperCommand";remote.Parent=RS
 remote.OnServerEvent:Connect(function(player,raw,...)
  if not RunService:IsStudio() or select("#",...)~=0 then return end
  local now=os.clock();if now<(requests[player] or 0) then return end;requests[player]=now+.15
  local ok,message=Service.Execute(player,raw);remote:FireClient(player,ok,message)
 end)
 RunService.Heartbeat:Connect(function()
  for player,enabled in noCooldown do if enabled and player.Parent==Players then cooldowns(player) end end
 end)
 Players.PlayerRemoving:Connect(function(player) noCooldown[player]=nil;requests[player]=nil end)
end
return Service
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="222">
          <Properties>
            <string name="Name">EconomyService</string>
            <string name="Source"><![CDATA[--!strict
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config.ProgressionConfig)
local Rules = require(Shared.Game.ProgressionRules).configure(Config, require(Shared.Config.ItemConfig).Items)
local Teams = require(script.Parent.TeamService)
local Economy = { GoldChanged = Instance.new("BindableEvent"), GoldSpent = Instance.new("BindableEvent") }
local balances: { [Player]: number } = {}
local function roundId(): number? local state = Teams.GetState(); return if state then state.roundId else nil end
function Economy.IsEligible(player: Player): boolean
 local state = Teams.GetState()
 local id = player:GetAttribute("TeamId")
 return player.Parent == game:GetService("Players") and state ~= nil and state.phase == "InProgress"
  and Teams.IsParticipant(player) and typeof(id) == "string" and Teams.IsActive(id) and player:GetAttribute("Eliminated") ~= true
end
function Economy.GetGold(player: Player): number return balances[player] or 0 end
function Economy.ResetPlayerEconomy(player: Player)
 balances[player] = Config.StartingGold; Economy.GoldChanged:Fire(player, Config.StartingGold, 0, "Reset", roundId())
end
function Economy.CanAfford(player: Player, amount: number): boolean
 return balances[player] ~= nil and Rules.validAmount(amount) and Economy.GetGold(player) >= amount
end
function Economy.AddGold(player: Player, amount: number, reason: string): number
 if not Economy.IsEligible(player) or balances[player] == nil then return 0 end
 local before = balances[player]
 local after = Rules.balanceAfter(before, amount, false); if not after then return 0 end
 balances[player] = after
 if after ~= before then Economy.GoldChanged:Fire(player, after, after - before, reason, roundId()) end
 return after - before
end
function Economy.SpendGold(player: Player, amount: number, reason: string): boolean
 if not Economy.IsEligible(player) or balances[player] == nil then return false end
 local before = balances[player]
 local after = Rules.balanceAfter(before, amount, true); if not after then return false end
 -- No yield between balance validation and commit.
 balances[player] = after; Economy.GoldChanged:Fire(player, after, after - before, reason, roundId())
 Economy.GoldSpent:Fire(player, amount, reason); return true
end
function Economy.Remove(player: Player) balances[player] = nil end
return Economy
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="223">
          <Properties>
            <string name="Name">FighterStateService</string>
            <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config.CombatConfig)
local State = require(Shared.Combat.CombatState)
local Life = require(script.Parent.CombatLifeService)
local Heroes = require(Shared.Config.HeroConfig)
local Structures = require(Shared.Game.StructureRules)
local Sleep = require(Shared.Abilities.SleepState)

type Movement = {
	walkSpeed: number, jumpPower: number, jumpHeight: number, autoRotate: boolean,
	ownershipAuto: boolean, owner: Player?, ownershipChanged: boolean,
}
type NetworkLease = { automatic: boolean, owner: Player?, untilAt: number }
export type Fighter = {
	character: Model, humanoid: Humanoid, root: BasePart, player: Player?,
	sleep: Sleep.Status?, logic: State.Fighter, profile: Config.AttackProfile, profileId: string,
	attackLifeId: any?, attackRoundId: any?, attackProfileId: string?, revision: number, connections: { RBXScriptConnection }, movement: Movement?, networkLease: NetworkLease?,
	wakeOnlyAttackId: number?,
	castLockUntil: number?,
}

local FighterStateService = { Changed = Instance.new("BindableEvent") }
local fighters: { [Model]: Fighter } = {}
local playerConnections: { [Player]: { RBXScriptConnection } } = {}
local started = false
local walkSpeeds: {[Model]: number}=setmetatable({}, {__mode="k"})
local function effectiveSpeed(model: Model,speed: number): number
 if model:GetAttribute("CombatDisabled")==true then return 0 end
 local gravity=model:GetAttribute("GravitySlowUntil");if typeof(gravity)=="number" and gravity>Workspace:GetServerTimeNow() then speed*=.6 end
 local rinnegan=model:GetAttribute("RinneganSlowUntil");if typeof(rinnegan)=="number" and rinnegan>Workspace:GetServerTimeNow() then speed*=.6 end
 local poison=model:GetAttribute("SnakePoisonUntil");if typeof(poison)=="number" and poison>Workspace:GetServerTimeNow() then speed*=((model:GetAttribute("SnakePoisonMove") or 1) :: number) end
 local ends=model:GetAttribute("OilUntil"); local multiplier=model:GetAttribute("OilMoveMultiplier")
 return if typeof(ends)=="number" and ends>Workspace:GetServerTimeNow() and typeof(multiplier)=="number" then speed*math.clamp(multiplier,0,1) else speed
end

local function restoreMovement(fighter: Fighter)
	if fighter.sleep and fighter.sleep.active then return end
	if fighter.castLockUntil and fighter.castLockUntil>Workspace:GetServerTimeNow() then return end
	local saved = fighter.movement
	if not saved then return end
	fighter.movement = nil
	local humanoid, root = fighter.humanoid, fighter.root
	if humanoid.Parent then
		humanoid.WalkSpeed = effectiveSpeed(fighter.character,walkSpeeds[fighter.character] or saved.walkSpeed)
		humanoid.JumpPower = saved.jumpPower
		humanoid.JumpHeight = saved.jumpHeight
		humanoid.AutoRotate = saved.autoRotate
	end
	if saved.ownershipChanged and not fighter.networkLease and root.Parent and root:CanSetNetworkOwnership() then
		if saved.ownershipAuto then
			root:SetNetworkOwnershipAuto()
		else
			root:SetNetworkOwner(if saved.owner and saved.owner.Parent == Players then saved.owner else nil)
		end
	end
end

-- Stun/Sleep and ranged displacement share one original ownership baseline.
function FighterStateService.LeaseNetworkOwnership(fighter: Fighter, untilAt: number)
 local root=fighter.root
 if untilAt~=untilAt or math.abs(untilAt)==math.huge or not root.Parent or not root:CanSetNetworkOwnership() then return end
 local lease=fighter.networkLease
 if not lease then
  local control=fighter.movement
  lease={automatic=if control then control.ownershipAuto else root:GetNetworkOwnershipAuto(),
   owner=if control then control.owner else root:GetNetworkOwner(),untilAt=untilAt}
  fighter.networkLease=lease
 else lease.untilAt=math.max(lease.untilAt,untilAt) end
 root:SetNetworkOwner(nil)
end
local function releaseNetworkLease(fighter: Fighter, now: number, force: boolean?)
 local lease=fighter.networkLease
 if not lease or (not force and now<lease.untilAt) then return end
 fighter.networkLease=nil
 local control=fighter.movement
 if control then
  control.ownershipAuto=lease.automatic; control.owner=lease.owner; control.ownershipChanged=true
 else
  local root=fighter.root
  if root.Parent and root:CanSetNetworkOwnership() then
   if lease.automatic then root:SetNetworkOwnershipAuto()
   else root:SetNetworkOwner(if lease.owner and lease.owner.Parent==Players then lease.owner else nil) end
  end
 end
end
function FighterStateService.ReleaseNetworkOwnership(fighter: Fighter)
 releaseNetworkLease(fighter,Workspace:GetServerTimeNow(),true)
end

function FighterStateService.Snapshot(fighter: Fighter)
	local logic = fighter.logic
	return {
		character = fighter.character, profileId = fighter.profileId, revision = fighter.revision,
		roundId = fighter.character:GetAttribute("RoundId"),
		mode = logic.mode, lastAttackAt = logic.lastAttackAt,
		nextAttackAt = logic.nextAttackAt, stunUntil = logic.stunUntil, attackSerial = logic.attackSerial,
	}
end

function FighterStateService.Publish(fighter: Fighter)
	fighter.revision += 1
	fighter.character:SetAttribute("CombatState", fighter.logic.mode)
	fighter.character:SetAttribute("ComboStep", nil) -- Retire the legacy replicated combo counter.
	fighter.character:SetAttribute("CombatNextAttackAt", fighter.logic.nextAttackAt)
	fighter.character:SetAttribute("CombatStunUntil", fighter.logic.stunUntil)
	fighter.character:SetAttribute("CombatProfileId", fighter.profileId)
	fighter.character:SetAttribute("CombatLastAttackAt", fighter.logic.lastAttackAt)
	fighter.character:SetAttribute("CombatAttackEndsAt", if fighter.logic.active then fighter.logic.active.endsAt else 0)
	fighter.character:SetAttribute("CombatAttackHitAt", if fighter.logic.active then fighter.logic.active.hitAt else 0)
	fighter.character:SetAttribute("CombatAttackSerial", fighter.logic.attackSerial)
	FighterStateService.Changed:Fire(fighter)
end

-- Morphs cannot carry an unfinished swing or buffered input into another profile.
-- Preserve the existing cooldown and stun deadlines; switching forms is not an attack reset.
function FighterStateService.SetAttackProfile(fighter: Fighter, profileId: string, exactProfile: Config.AttackProfile?): boolean
	if fighters[fighter.character] ~= fighter then return false end
	local profile = exactProfile or Config.Profiles[profileId]
	if not profile then return false end
	fighter.logic.active = nil
	fighter.logic.buffered = nil
	if fighter.logic.mode == "Attacking" then fighter.logic.mode = "Idle" end
	fighter.attackLifeId = nil; fighter.attackRoundId = nil; fighter.attackProfileId = nil
	fighter.wakeOnlyAttackId = nil
	fighter.profileId = profileId; fighter.profile = profile
	FighterStateService.Publish(fighter)
	return true
end

function FighterStateService.Remove(character: Model)
	local fighter = fighters[character]
	if not fighter then return end
	fighters[character] = nil
 releaseNetworkLease(fighter,Workspace:GetServerTimeNow(),true)
 fighter.sleep=nil;fighter.castLockUntil=nil; character:SetAttribute("SleepUntil",nil)
 character:SetAttribute("RinneganSlowUntil",nil);character:SetAttribute("SasukeGenjutsuUntil",nil)
	State.Kill(fighter.logic)
	for _, connection in fighter.connections do connection:Disconnect() end
	restoreMovement(fighter)
end

function FighterStateService.GetWalkSpeed(character: Model): number
 local fighter=fighters[character]; local hp=character:FindFirstChildOfClass("Humanoid")
 return walkSpeeds[character] or (if fighter and fighter.movement then fighter.movement.walkSpeed elseif hp then hp.WalkSpeed else 0)
end
function FighterStateService.Get(character: Model): Fighter?
	return fighters[character]
end
function FighterStateService.Reset()
	for character in fighters do FighterStateService.Remove(character) end
end

function FighterStateService.SetWalkSpeed(character: Model, speed: number)
 walkSpeeds[character]=speed
	local fighter = fighters[character]
	if fighter and fighter.movement then
		fighter.movement.walkSpeed = speed
	else
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if humanoid then humanoid.WalkSpeed = effectiveSpeed(character,speed) end
	end
end

function FighterStateService.GetOrCreate(character: Model): Fighter?
	if Structures.isStructure(character:GetAttribute("EntityKind")) then return nil end
	if fighters[character] then return fighters[character] end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart")
	if not character:IsDescendantOf(Workspace) or not humanoid or not root or not root:IsA("BasePart") then return nil end
	if not humanoid:FindFirstChildOfClass("Animator") then
		Instance.new("Animator").Parent = humanoid
	end
	local fighter: Fighter = {
		character = character, humanoid = humanoid, root = root, player = Players:GetPlayerFromCharacter(character),
		sleep = nil, logic = State.new(), profileId = Config.DefaultProfile, profile = Config.Profiles[Config.DefaultProfile],
		revision = 0, connections = {}, movement = nil, networkLease = nil,
	}
	local heroId = character:GetAttribute("HeroId")
	local hero = if typeof(heroId) == "string" then Heroes.Heroes[heroId] else nil
	if fighter.player and hero then
		fighter.profileId = hero.Profile
		fighter.profile = Config.Profiles[hero.Profile] or Config.Profiles[Config.DefaultProfile]
	end
	fighters[character] = fighter
	Life.Register(character)
	table.insert(fighter.connections, humanoid.Died:Connect(function()
		State.Kill(fighter.logic)
		restoreMovement(fighter)
		FighterStateService.Publish(fighter)
	end))
	table.insert(fighter.connections, character.AncestryChanged:Connect(function()
		if not character:IsDescendantOf(Workspace) then FighterStateService.Remove(character) end
	end))
	if humanoid.Health <= 0 then State.Kill(fighter.logic) end
	FighterStateService.Publish(fighter)
	return fighter
end

local function lockMovement(fighter: Fighter)
	local humanoid, root = fighter.humanoid, fighter.root
	if not fighter.movement then
		local canOwn = root:CanSetNetworkOwnership()
		fighter.movement = {
			walkSpeed = humanoid.WalkSpeed, jumpPower = humanoid.JumpPower,
			jumpHeight = humanoid.JumpHeight, autoRotate = humanoid.AutoRotate,
			ownershipAuto = if fighter.networkLease then fighter.networkLease.automatic elseif canOwn then root:GetNetworkOwnershipAuto() else true,
			owner = if fighter.networkLease then fighter.networkLease.owner elseif canOwn then root:GetNetworkOwner() else nil, ownershipChanged = canOwn,
		}
		if canOwn then root:SetNetworkOwner(nil) end
	end
	humanoid.WalkSpeed = 0
	humanoid.JumpPower = 0
	humanoid.JumpHeight = 0
	humanoid.Jump = false
	humanoid.AutoRotate = false
	if not root.Anchored then
		local vertical = root.AssemblyLinearVelocity.Y
		if vertical ~= vertical or math.abs(vertical) == math.huge then vertical = 0 end
		root.AssemblyLinearVelocity = Vector3.new(0, math.clamp(vertical, -fighter.profile.MaxKnockbackSpeed, fighter.profile.MaxKnockbackSpeed), 0)
	end
end
function FighterStateService.LockCast(fighter: Fighter, untilAt: number)
 fighter.castLockUntil=untilAt
 if untilAt>Workspace:GetServerTimeNow() then lockMovement(fighter)
 elseif fighter.logic.mode~="Stunned" then restoreMovement(fighter) end
end
function FighterStateService.Sleep(fighter: Fighter, now: number)
 if fighter.humanoid.Health<=0 then return end
 fighter.sleep=Sleep.new(now)
 fighter.logic.active=nil; fighter.logic.buffered=nil
 if fighter.logic.mode=="Attacking" then fighter.logic.mode="Idle" end
 fighter.character:SetAttribute("SleepUntil",now+3)
 lockMovement(fighter); FighterStateService.Publish(fighter)
end
function FighterStateService.WakeSleep(fighter: Fighter)
 local status=fighter.sleep; if not status then return end
 Sleep.wake(status,true,0); fighter.sleep=nil
 if status.wakeSlowDuration and fighter.humanoid.Health>0 then
  fighter.character:SetAttribute("RinneganSlowUntil",Workspace:GetServerTimeNow()+status.wakeSlowDuration)
 end
 fighter.character:SetAttribute("SleepUntil",nil);fighter.character:SetAttribute("SasukeGenjutsuUntil",nil)
 if fighter.logic.mode~="Stunned" then restoreMovement(fighter) end
 FighterStateService.Publish(fighter)
end
local function applyStun(fighter: Fighter, duration: number, interrupt: boolean)
	if fighter.humanoid.Health <= 0 or fighter.logic.mode == "Dead" then return end
	local now = Workspace:GetServerTimeNow()
	State.Stun(fighter.logic, now, duration, interrupt)
	lockMovement(fighter)
	FighterStateService.Publish(fighter)
end

function FighterStateService.Stun(fighter: Fighter, duration: number, interrupt: boolean)
	applyStun(fighter, math.clamp(duration, 0, fighter.profile.MaxStunDuration), interrupt)
end
function FighterStateService.StunSpell(fighter: Fighter, duration: number)
	if duration ~= duration or duration <= 0 or duration == math.huge then return end
	applyStun(fighter, duration, false)
end

function FighterStateService.Update(fighter: Fighter, now: number)
 releaseNetworkLease(fighter,now)
 if fighter.castLockUntil then
  if now>=fighter.castLockUntil or fighter.humanoid.Health<=0 then
   fighter.castLockUntil=nil;if fighter.logic.mode~="Stunned" then restoreMovement(fighter) end
  else lockMovement(fighter) end
 end
 local slow=fighter.character:GetAttribute("RinneganSlowUntil")
 if typeof(slow)=="number" and (now>=slow or fighter.humanoid.Health<=0) then
  fighter.character:SetAttribute("RinneganSlowUntil",nil)
  FighterStateService.SetWalkSpeed(fighter.character,FighterStateService.GetWalkSpeed(fighter.character))
 end
 if fighter.sleep and (fighter.humanoid.Health<=0 or Sleep.update(fighter.sleep,now)) then FighterStateService.WakeSleep(fighter) end
	if fighter.humanoid.Health <= 0 then
		if fighter.logic.mode ~= "Dead" then
			State.Kill(fighter.logic)
			restoreMovement(fighter)
			FighterStateService.Publish(fighter)
		end
		return
	end
	if fighter.sleep and fighter.sleep.active then lockMovement(fighter) end
	if State.Update(fighter.logic, now) then
		if fighter.logic.mode ~= "Stunned" then restoreMovement(fighter) end
		FighterStateService.Publish(fighter)
	end
end

function FighterStateService.GetAll(): { [Model]: Fighter }
	return fighters
end

local function bindPlayer(player: Player)
	if playerConnections[player] then return end
	local function bindCharacter(character: Model)
		task.spawn(function()
			local humanoid = character:WaitForChild("Humanoid", Config.CharacterReadyTimeout)
			local root = character:WaitForChild("HumanoidRootPart", Config.CharacterReadyTimeout)
			local deadline = os.clock() + Config.CharacterReadyTimeout
			while player.Character == character and player.Parent == Players and not character:IsDescendantOf(Workspace) and os.clock() < deadline do
				game:GetService("RunService").Heartbeat:Wait()
			end
			if humanoid and root and player.Parent == Players and player.Character == character then
				FighterStateService.GetOrCreate(character)
			end
		end)
	end
	playerConnections[player] = {
		player.CharacterAdded:Connect(bindCharacter),
		player.CharacterRemoving:Connect(FighterStateService.Remove),
	}
	if player.Character then bindCharacter(player.Character) end
end

function FighterStateService.Start()
	if started then return end
	started = true
	Players.PlayerAdded:Connect(bindPlayer)
	Players.PlayerRemoving:Connect(function(player: Player)
		if player.Character then FighterStateService.Remove(player.Character) end
		for character, fighter in fighters do
			if fighter.player == player then FighterStateService.Remove(character) end
		end
		local connections = playerConnections[player]
		if connections then
			for _, connection in connections do connection:Disconnect() end
		end
		playerConnections[player] = nil
	end)
	for _, player in Players:GetPlayers() do bindPlayer(player) end
end

return FighterStateService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="224">
          <Properties>
            <string name="Name">GamakichiService</string>
            <string name="Source"><![CDATA[--!strict
-- Autonomous combat summon: local enemies, then towers. Follow is an explicit recall.
local Players=game:GetService("Players")
local Shared=game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Domain=require(Shared.Abilities.GamakichiState)
local Commands=require(Shared.Abilities.CloneCommands)
local Units=require(Shared.Abilities.WorldUnits)
local Fighters=require(script.Parent.FighterStateService)
local Damage=require(script.Parent.DamageService)
local Targets=require(script.Parent.AbilityTargetService)
local Spells=require(Shared.Abilities.GamakichiSpells)
local Oil=require(script.Parent.OilStatusService)
local Hitboxes=require(script.Parent.HitboxService)
local Navigation=require(script.Parent.CloneNavigation)
local Collision=require(script.Parent.SummonCollision)
local Autonomy=require(Shared.Abilities.CloneAutonomyPolicy)
local Appearance=require(Shared.GamakichiAppearance)
local Structures=require(script.Parent.StructureService)
type Record={autoTarget: Model?,nextScan:number,returning:boolean,recallUntil:number,manualRequest:number,owner: Player, character: Model, model: Model, root: BasePart, humanoid: Humanoid,
 state: Domain.State, cast: Domain.Cast, commands: Commands.State, commandRequest: number, nextHit: number, hitAt: number?, target: Model?, spells: Spells.State, oilTarget: Model?, oilLife: any, center: Vector3?}
local records: {[Player]: Record}={}
local Service={Visual=Instance.new("BindableEvent")}
function Service.Get(player: Player): Record? return records[player] end
function Service.Remove(player: Player)
 local r=records[player]; if not r then return end
 records[player]=nil
 Oil.ClearSource(tostring(player.UserId)..":"..tostring(r.cast.id)); Spells.cancel(r.spells)
 if r.state.active==r.cast then Domain.cancel(r.state) end
 Navigation.Remove(r.model); Fighters.Remove(r.model); r.model:Destroy()
 if r.character.Parent then r.character:SetAttribute("GamakichiCount",0); r.character:SetAttribute("GamakichiAdult",false) end
end
function Service.Reset() for player in records do Service.Remove(player) end; Oil.Reset() end
function Service.Spawn(player: Player, character: Model, state: Domain.State, cast: Domain.Cast, commands: Commands.State)
 Service.Remove(player)
 local source=character:FindFirstChild("HumanoidRootPart") :: BasePart
 local folder=workspace:FindFirstChild("HeroSummons")
 if not folder then folder=Instance.new("Folder"); folder.Name="HeroSummons"; folder.Parent=workspace end
 local model=Instance.new("Model"); model.Name="Gamakichi"
 local function part(name: string,size: Vector3,offset: Vector3,color: Color3): Part
  local p=Instance.new("Part"); p.Name=name; p.Size=size; p.Color=color; p.Anchored=true; p.CanCollide=false; p.CanTouch=false
  p.Position=offset; p.Parent=model; if name~="HumanoidRootPart" then p.CanQuery=false; p:SetAttribute("HeroCosmetic",true) end; return p
 end
 local size=if cast.profile.adult then 1.4 else 1
 local root=part("HumanoidRootPart",Vector3.new(5,3,5)*size,Vector3.zero,Color3.fromRGB(176,78,40))
 root.Transparency=1
 Appearance.Build(model,root,cast.profile.adult)
 local hp=Instance.new("Humanoid"); hp.RequiresNeck=false; hp.BreakJointsOnDeath=false
 hp.HipHeight=0
 hp.EvaluateStateMachine=false -- Navigation owns movement; no automatic collision changes.
 hp.MaxHealth=cast.profile.health; hp.Health=cast.profile.health; hp.DisplayName=if cast.profile.adult then "Гамакичи · взрослый" else "Гамакичи"
 hp.Parent=model; model.PrimaryPart=root
 model:SetAttribute("EntityKind","Summon"); model:SetAttribute("NativeGamakichi",true); model:SetAttribute("SummonOwner",player.UserId)
 model:SetAttribute("TeamId",character:GetAttribute("TeamId")); model:SetAttribute("RoundId",character:GetAttribute("RoundId"))
 model:SetAttribute("SummonArmor",cast.profile.armor); model:SetAttribute("SummonRank",cast.rank)
 model:SetAttribute("Mana",cast.profile.mana); model:SetAttribute("MaxMana",cast.profile.mana)
 model:SetAttribute("OilImplemented",true); model:SetAttribute("ChoppingImplemented",cast.profile.adult)
 Collision.Apply(model); model.PrimaryPart=root
 Navigation.Register(model,root,hp)
 Navigation.Place(model,character,source.CFrame,Domain.Policy.SpawnOffset)
 model.Parent=folder
 records[player]={autoTarget=nil,nextScan=0,returning=false,recallUntil=0,manualRequest=0,owner=player,character=character,model=model,root=root,humanoid=hp,state=state,cast=cast,commands=commands,commandRequest=commands.lastRequest,nextHit=0,hitAt=nil,target=nil,spells=Spells.new(),oilTarget=nil,oilLife=nil,center=nil}
 Fighters.GetOrCreate(model); character:SetAttribute("GamakichiCount",1); character:SetAttribute("GamakichiAdult",cast.profile.adult); character:SetAttribute("Ready_GamakichiOil",0); character:SetAttribute("Ready_GamakichiChop",0)
end
local function publish(r: Record)
 r.character:SetAttribute("Ready_GamakichiOil",r.spells.oilReady)
 r.character:SetAttribute("Ready_GamakichiChop",r.spells.chopReady)
 r.character:SetAttribute("GamakichiAdult",r.cast.profile.adult)
 r.model:SetAttribute("Channeling",r.spells.channel~=nil)
end
local function affected(r: Record,center: Vector3,radius: number): {Model}
 local result={}
 for model,fighter in Fighters.GetAll() do
  local kind=model:GetAttribute("EntityKind")
  if (kind=="Hero" or kind=="Minion" or kind=="Summon") and Damage.CanDamage(r.model,model)
   and not model:FindFirstChildOfClass("ForceField") and (fighter.root.Position-center).Magnitude<=Units.toStuds(radius)
   and Targets.Visible(r.model,model,center+Vector3.new(0,.1,0),fighter.root.Position) then table.insert(result,model) end
 end
 return result
end
function Service.TrySpell(player: Player,id: string,request: number,now: number,target: any,automatic: boolean?): (boolean,string)
 local r=records[player]
 if not r or r.character~=player.Character or not Domain.live(r.state,r.cast,now) or not Damage.CanAct(r.character) or not Damage.CanAct(r.model) then return false,"Unavailable" end
 if not automatic then
  if request~=request or request%1~=0 or request<1 or request==math.huge then return false,"Malformed" end
  if request<=r.manualRequest then return false,"Replay" end
  r.manualRequest=request
 end
 local fighter=Fighters.Get(r.model); if not fighter or (fighter.logic.mode=="Stunned" or (fighter.sleep and fighter.sleep.active)) then return false,"Busy" end
 if not Hitboxes.IsFiniteCFrame(r.root.CFrame) then return false,"Unavailable" end
 local point: Vector3
 local selected: Model?=nil
 if id=="GamakichiOil" then
  if typeof(target)~="Instance" then return false,"Target" end
  local instance=target :: Instance
  if not instance:IsA("Model") or not Damage.CanDamage(r.model,instance) then return false,"Target" end
  selected=instance
  local root=instance:FindFirstChild("HumanoidRootPart"); local kind=instance:GetAttribute("EntityKind")
  if not root or not root:IsA("BasePart") or (kind~="Hero" and kind~="Minion" and kind~="Summon") or instance:FindFirstChildOfClass("ForceField") then return false,"Target" end
  point=root.Position
 elseif id=="GamakichiChop" and typeof(target)=="Vector3" then point=target
 else return false,"Malformed" end
 if not Hitboxes.IsFiniteCFrame(CFrame.new(point)) then return false,"Target" end
 local distance=(point-r.root.Position).Magnitude
 local range=if id=="GamakichiOil" then Spells.Oil.Range else Spells.Chopping.Range
 if distance>Units.toStuds(range) or not Targets.Visible(r.model,r.model,r.root.Position,point+Vector3.new(0,.1,0)) then return false,"Target" end
 local accepted,reason=Spells.request(r.spells,id,now,r.spells.lastRequest+1,r.cast.profile.adult,distance/Units.toStuds(Spells.Oil.ProjectileSpeed))
 if not accepted then return false,reason end
 local facing=(point-r.root.Position)*Vector3.new(1,0,1)
 if facing.Magnitude>.01 then r.model:PivotTo(CFrame.lookAt(r.root.Position,r.root.Position+facing)) end
 r.hitAt=nil; r.target=nil
 r.model:SetAttribute("SummonSpell",id);r.model:SetAttribute("SummonSpellAt",now)
 if selected then
  r.oilTarget=selected; r.oilLife=selected:GetAttribute("LifeId")
  Service.Visual:Fire({source=r.model,kind="GamakichiOil",position=r.root.Position,destination=point,duration=distance/Units.toStuds(Spells.Oil.ProjectileSpeed)})
 else r.center=point; r.model:SetAttribute("ChannelWave",0); Service.Visual:Fire({source=r.model,kind="GamakichiChannel",position=point,radius=Units.toStuds(Spells.Chopping.Radius)}) end
 publish(r); return true,"Accepted"
end
function Service.Update(now: number,delta: number)
 Oil.Update(now)
 for player,r in records do
  if player.Parent~=Players or player.Character~=r.character or not Damage.CanAct(r.character)
   or not r.model.Parent or r.humanoid.Health<=0 or not Domain.live(r.state,r.cast,now) then Service.Remove(player); continue end
  if not Navigation.Settle(r.model,r.character,delta) then Navigation.Stop(r.model);r.model:SetAttribute("SummonBehavior","Landing");continue end
  local intent=Commands.resolve(r.commands)
  if r.commandRequest~=r.commands.lastRequest then
   r.commandRequest=r.commands.lastRequest;r.hitAt=nil;r.target=nil;r.autoTarget=nil;r.nextScan=0
   r.returning=intent.mode=="Follow";r.recallUntil=now+Autonomy.RecallGrace
   if intent.mode=="Hold" or intent.mode=="Follow" then Spells.cancel(r.spells);r.oilTarget=nil;r.center=nil end
  end
  local fighter=Fighters.Get(r.model)
  if fighter and (fighter.logic.mode=="Stunned" or (fighter.sleep and fighter.sleep.active)) then Navigation.Stop(r.model); r.hitAt=nil; r.target=nil; Spells.cancel(r.spells); r.oilTarget=nil; r.center=nil; publish(r); continue end
  r.humanoid.Health=math.min(r.humanoid.MaxHealth,r.humanoid.Health+r.cast.profile.regen*delta)
  if Spells.claimOil(r.spells,now) then
   local target=r.oilTarget; r.oilTarget=nil
   if target and target:GetAttribute("LifeId")==r.oilLife and Damage.CanDamage(r.model,target) then
    local root=target:FindFirstChild("HumanoidRootPart")
    if root and root:IsA("BasePart") and Targets.Visible(r.model,target,r.root.Position,root.Position) then
     for _,victim in affected(r,root.Position,Spells.Oil.Radius) do Oil.Apply(victim,tostring(player.UserId)..":"..tostring(r.cast.id),now) end
     Service.Visual:Fire({source=r.model,kind="GamakichiOilImpact",position=root.Position,radius=Units.toStuds(Spells.Oil.Radius)})
    end
   end
  end
  local wave=Spells.claimWave(r.spells,now)
  if wave and r.center then
   local victims=affected(r,r.center,Spells.Chopping.Radius)
   local raw=Spells.waveDamage(#victims)
   for _,victim in victims do local hp=victim:FindFirstChildOfClass("Humanoid"); if hp then Damage.Apply(r.model,hp,raw) end end
   r.model:SetAttribute("ChannelWave",wave)
   Service.Visual:Fire({source=r.model,kind="GamakichiChopImpact",position=r.center,radius=Units.toStuds(Spells.Chopping.Radius),wave=wave})
  end
  publish(r)
  if r.spells.channel or r.spells.flight then Navigation.Stop(r.model); continue end
  if intent.mode=="Idle" or intent.mode=="Hold" then r.hitAt=nil;r.target=nil;r.autoTarget=nil;r.model:SetAttribute("SummonBehavior",intent.mode);Navigation.Stop(r.model);continue end
  local ownerRoot=r.character:FindFirstChild("HumanoidRootPart")
  if not ownerRoot or not ownerRoot:IsA("BasePart") then continue end
  local ownerDistance=(ownerRoot.Position-r.root.Position).Magnitude
  -- Only the explicit Follow order recalls the toad. Owner motion is not an AI goal.
  if r.returning and ownerDistance<Domain.Policy.FollowDistance+1 and now>=r.recallUntil then r.returning=false end
  local function valid(candidate:Model?,range:number,visible:boolean?):boolean
   if not candidate or not candidate.Parent or not Damage.CanDamage(r.model,candidate) or candidate:FindFirstChildOfClass("ForceField") then return false end
   local cr=candidate:FindFirstChild("HumanoidRootPart")
   return cr~=nil and cr:IsA("BasePart") and (cr.Position-r.root.Position).Magnitude<=range
    and (visible==false or Targets.Visible(r.model,candidate,r.root.Position,cr.Position))
  end
  local target:Model?=nil
  if not r.returning and intent.targetId then
   for candidate in Fighters.GetAll() do if candidate:GetAttribute("AbilityEntityId")==intent.targetId and valid(candidate,Autonomy.PursueRadius) then target=candidate;break end end
  end
  if not target and not r.returning then
   local current=r.autoTarget
   local isTower=current~=nil and current:GetAttribute("EntityKind")=="Tower"
   if not valid(current,if isTower then math.huge else Autonomy.PursueRadius,not isTower) then r.autoTarget=nil end
   if now>=r.nextScan then
    r.nextScan=now+Autonomy.ScanInterval
    -- A nearby living enemy preempts siege; never waste oil/chopping on a building.
    local unit:Model?=nil
    for _,enemy in Targets.InCone(r.model,r.root.CFrame,Autonomy.AcquireRadius,-1,false,math.huge) do
     local candidate=enemy.Parent
     if candidate and candidate:IsA("Model") and valid(candidate,Autonomy.AcquireRadius) then unit=candidate;break end
    end
    if r.autoTarget and r.autoTarget:GetAttribute("EntityKind")~="Tower" then
     -- Retain a valid unit target until it dies/leaves pursuit range.
    elseif unit then r.autoTarget=unit
    else
     local nearest:Model?=nil;local best=math.huge
     for model,tower in Structures.GetAll() do
      if tower.kind~="Tower" or not Structures.Alive(tower) or not valid(model,math.huge,false) then continue end
      local distance=(tower.root.Position-r.root.Position).Magnitude
      if distance<best or (distance==best and nearest~=nil and model.Name<nearest.Name) then nearest=model;best=distance end
     end
     r.autoTarget=nearest
    end
   end
   target=r.autoTarget
  end
  r.model:SetAttribute("SummonBehavior",if target then (if target:GetAttribute("EntityKind")=="Tower" then "Siege" else "Attack") elseif r.returning then "Return" else "Guard")
  r.model:SetAttribute("SummonTarget",if target then target.Name else "")
  if target and target:GetAttribute("EntityKind")~="Tower" and not r.hitAt then
   local tr=target:FindFirstChild("HumanoidRootPart") :: BasePart
   local distance=(tr.Position-r.root.Position).Magnitude
   local oilUntil=(target:GetAttribute("OilUntil") or 0) :: number
   if now>=r.spells.oilReady and oilUntil<=now and distance<=Units.toStuds(Spells.Oil.Range) then
    if Service.TrySpell(player,"GamakichiOil",0,now,target,true) then Navigation.Stop(r.model);continue end
   elseif r.cast.profile.adult and now>=r.spells.chopReady and distance<=Units.toStuds(Spells.Chopping.Range) then
    if Service.TrySpell(player,"GamakichiChop",0,now,tr.Position,true) then Navigation.Stop(r.model);continue end
   end
  end
  if r.hitAt and now>=r.hitAt then
   local victim=r.target; r.hitAt=nil; r.target=nil
   local root=if victim then victim:FindFirstChild("HumanoidRootPart") else nil
   if victim and root and root:IsA("BasePart") and Damage.CanDamage(r.model,victim)
    and (root.Position-r.root.Position).Magnitude<=Units.toStuds(100)+(root.Size.X+r.root.Size.X)/2
    and Targets.Visible(r.model,victim,r.root.Position,root.Position) then
    local hp=victim:FindFirstChildOfClass("Humanoid"); if hp then Damage.ApplyAttack(r.model,hp,r.cast.profile.rawDamage) end
   end
  end
  local destination=if target then target:FindFirstChild("HumanoidRootPart") elseif r.returning then ownerRoot else nil
  if not destination or not destination:IsA("BasePart") then Navigation.Stop(r.model);continue end
  local stop=if target then Units.toStuds(100)+(r.root.Size.X+destination.Size.X)/2 else Domain.Policy.FollowDistance
  local distance=destination.Position-r.root.Position
  local inRange=target~=nil and distance.Magnitude<=stop and Targets.Visible(r.model,target,r.root.Position,destination.Position)
  local function face(direction:Vector3)
   local flat=direction*Vector3.new(1,0,1)
   if flat.Magnitude>.01 then
    local desired=CFrame.lookAt(r.root.Position,r.root.Position+flat)
    r.model:PivotTo(r.root.CFrame:Lerp(desired,1-math.exp(-12*math.clamp(delta,0,.1))))
   end
  end
  if inRange and now>=r.nextHit and not r.hitAt then
   r.nextHit=now+Domain.Policy.AttackInterval;r.hitAt=now+Domain.Policy.DamagePoint;r.target=target;r.model:SetAttribute("SummonSwingAt",now)
  end
  if r.hitAt or inRange then Navigation.Stop(r.model);face(distance)
  else
   local before=r.root.Position
   local moving=Navigation.Step(r.model,r.character,target or r.character,destination,stop,now,delta,Units.toStuds(r.cast.profile.speed)*Oil.Movement(r.model,now))
   r.model:SetAttribute("SummonMoving",moving)
   if moving then face(r.root.Position-before) end
  end
 end
end
return Service
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="225">
          <Properties>
            <string name="Name">GameModeService</string>
            <string name="Source"><![CDATA[--!strict
local Config = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared").Config.GameModeConfig)
local GameModeService = {}
function GameModeService.MinimumPerTeam(): number
	if game:GetService("RunService"):IsStudio() then
		return math.clamp(Config.StudioMinimumPerTeam, 1, Config.TeamCapacity)
	end
	return Config.TeamCapacity
end
function GameModeService.MinimumPlayers(): number
	if GameModeService.IsSoloTest() then return 1 end
	return #Config.Teams * GameModeService.MinimumPerTeam()
end
function GameModeService.IsSoloTest(): boolean
	return game:GetService("RunService"):IsStudio() and (Config.DebugSoloMode or workspace:GetAttribute("DeveloperSoloMode")==true)
end
function GameModeService.TeamIds(): { string }
	local ids = {}; for _, team in Config.Teams do table.insert(ids, team.Id) end; return ids
end
return GameModeService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="226">
          <Properties>
            <string name="Name">HeroAppearanceService</string>
            <string name="Source"><![CDATA[--!strict
local Shared=game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Data=require(Shared.Config.CreatorVisualData)
local Forms=require(Shared.Config.NarutoFormVisualData)
local Factory=require(Shared.CreatorVisualFactory)
local KuramaAvatar=require(Shared.KuramaAvatar)
local Appearance={}
local bound: {[Model]: {RBXScriptConnection}}=setmetatable({}, {__mode="k"})
local function dress(model: Model)
 if model:GetAttribute("HeroId")=="Sasuke" then require(script.Parent.SasukeAppearanceService).Apply(model);return end
 local head=model:FindFirstChild("Head")
 if not head or not head:IsA("BasePart") or not model:FindFirstChild("UpperTorso") then return end
 local form=if model:GetAttribute("KuramaActive")==true then "Kurama" elseif model:GetAttribute("KcmActive")==true then "KCM" elseif model:GetAttribute("SagePhase")=="Active" then "Sage" else "Normal"
 if form=="KCM" and model:GetAttribute("KcmRank")==3 then form="Rikudo" end
 local version="CreatorStore-v5:"..form
 if model:GetAttribute("HeroAppearanceVersion")==version and model:FindFirstChild("HeroAppearance") then return end
 local sage=form=="Sage"
 local kcm=form=="KCM" or form=="Rikudo"
 -- Keep the physical head and its rig joints; the imported face supplies the visible head.
 head.Transparency=1
 local previous=model:FindFirstChild("HeroAppearance")
 for _,item in model:GetChildren() do
  if item:IsA("Accessory") or item:IsA("Shirt") or item:IsA("Pants") or item:IsA("ShirtGraphic") then item:Destroy() end
 end
 for _,item in head:GetChildren() do if item:IsA("Decal") then item:Destroy() end end
 for _,item in model:GetChildren() do if item:IsA("BasePart") and item.Name~="HumanoidRootPart" and item.Name~="KuramaCombatBody" then
  item.Transparency=if item.Name=="Head" or form=="Kurama" then 1 else 0
  item.Color=if kcm then Color3.fromRGB(255,184,31) else Color3.fromRGB(255,204,153);item.Material=Enum.Material.SmoothPlastic
 end end
 local shirt=Instance.new("Shirt");shirt.ShirtTemplate=if form=="Rikudo" then "rbxassetid://6510073285" elseif kcm then "rbxassetid://7923921567" elseif sage then "rbxassetid://7472900840" else "rbxassetid://6764794671";shirt.Parent=model
 local pants=Instance.new("Pants");pants.PantsTemplate=if form=="Rikudo" then "rbxassetid://6510069460" elseif kcm then "rbxassetid://7923927930" elseif sage then "rbxassetid://7472928447" else "rbxassetid://3237352364";pants.Parent=model
 -- Build off-tree so clients never observe a deliberately empty costume.
 local folder=Instance.new("Folder");folder.Name="HeroAppearance"
 if sage or kcm then
  -- A classic head supports this store face decal. The avatar's dynamic head does not.
  local faceHead=Instance.new("Part");faceHead.Name=form.."FaceHead";faceHead.Size=Vector3.new(2,1,1)
  faceHead.Color=if kcm then Color3.fromRGB(255,202,71) else Color3.fromRGB(255,204,153);faceHead.Material=Enum.Material.SmoothPlastic
  faceHead.CanCollide=false;faceHead.CanTouch=false;faceHead.CanQuery=false;faceHead.Massless=true
  faceHead:SetAttribute("HeroCosmetic",true);faceHead:SetAttribute("CosmeticBody","Head");faceHead:SetAttribute("CosmeticOffset",CFrame.identity)
  faceHead.CFrame=head.CFrame;faceHead.Parent=folder
  local mesh=Instance.new("SpecialMesh");mesh.MeshType=Enum.MeshType.Head;mesh.Scale=Vector3.one*1.25;mesh.Parent=faceHead
  local face=Instance.new("Decal");face.Name=form.."Face";face.Texture=if kcm then "rbxassetid://9477576334" else "rbxassetid://9449064416";face.Face=Enum.NormalId.Front;face.Parent=faceHead
  local weld=Instance.new("WeldConstraint");weld.Part0=head;weld.Part1=faceHead;weld.Parent=faceHead
 end
 for _,spec in Forms[form] or Data.appearance do
  if spec.form~="All" and spec.form~=form then continue end
  local body=model:FindFirstChild(spec.body)
  if not body or not body:IsA("BasePart") then continue end
  local part,mesh=Factory.Part(spec);part:SetAttribute("HeroCosmetic",true)
  local offset=Factory.Frame(spec.cf)
  if form=="Kurama" then KuramaAvatar.Style(part,mesh);offset=KuramaAvatar.Offset(offset) end
  part:SetAttribute("CosmeticBody",spec.body);part:SetAttribute("CosmeticOffset",offset)
  part.CFrame=body.CFrame*offset;part.Parent=folder
  local weld=Instance.new("Weld");weld.Name="FormVisualWeld";weld.Part0=body;weld.Part1=part;weld.C0=offset;weld.Parent=part
 end
 if form=="Kurama" then local root=model:FindFirstChild("HumanoidRootPart");if root and root:IsA("BasePart") then KuramaAvatar.Markings(folder,root) end end
 if form=="Rikudo" then
  local torso=model:FindFirstChild("UpperTorso") :: BasePart
  for i=1,9 do
   local angle=(i-1)*math.pi*2/9
   local offset=CFrame.new(math.cos(angle)*1.9,.2+math.sin(angle)*1.9,1.25)
   local orb=Instance.new("Part");orb.Name="TruthSeekingOrb"..i;orb.Shape=Enum.PartType.Ball;orb.Size=Vector3.one*.42
   orb.Color=Color3.fromRGB(12,10,17);orb.Material=Enum.Material.SmoothPlastic;orb.Massless=true
   orb.CanCollide=false;orb.CanTouch=false;orb.CanQuery=false;orb:SetAttribute("HeroCosmetic",true)
   orb:SetAttribute("CosmeticBody","UpperTorso");orb:SetAttribute("CosmeticOffset",offset);orb.CFrame=torso.CFrame*offset;orb.Parent=folder
   local weld=Instance.new("Weld");weld.Name="FormVisualWeld";weld.Part0=torso;weld.Part1=orb;weld.C0=offset;weld.Parent=orb
  end
 end
 for _,part in folder:GetChildren() do
  if part:IsA("BasePart") then part:SetAttribute("AppearanceTransparency",part.Transparency) end
 end
 folder:SetAttribute("AppearanceVersion",version)
 folder:SetAttribute("AppearanceForm",form)
 folder:SetAttribute("AppearanceParts",#folder:GetChildren())
 folder:SetAttribute("AppearanceDescendants",#folder:GetDescendants())
 if previous then previous.Name="PreviousHeroAppearance" end
 folder.Parent=model
 model:SetAttribute("HeroVisualForm",form)
 model:SetAttribute("HeroAppearanceVersion",version)
 -- Each client retains its own loaded visual until the next one is ready.
 -- This grace window also covers replication of the new folder and its children.
 if previous then game:GetService("Debris"):AddItem(previous,3) end
end
function Appearance.Apply(model: Model)
 dress(model)
 if bound[model] then return end
 local connections={};bound[model]=connections
 for _,attribute in {"SagePhase","KcmActive","KcmRank","KuramaActive","SasukeMode","SusanooForm","GarudaActive"} do
  table.insert(connections,model:GetAttributeChangedSignal(attribute):Connect(function() dress(model) end))
 end
 model.Destroying:Once(function() for _,connection in connections do connection:Disconnect() end;bound[model]=nil end)
end
return Appearance
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="227">
          <Properties>
            <string name="Name">HeroProgressionService</string>
            <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config.ProgressionConfig)
local Items = require(Shared.Config.ItemConfig)
local Logic = require(Shared.Game.ProgressionRules)
local Rules = Logic.configure(Config, Items.Items)
local Economy = require(script.Parent.EconomyService)
local Teams = require(script.Parent.TeamService)
local Learning = require(Shared.Abilities.SkillLearning)
local Progression = { Changed = Instance.new("BindableEvent") }
local records: { [Player]: Logic.Profile } = {}
local folders: { [Player]: Folder } = {}
local notice: RemoteEvent? = nil
local started = false
function Progression.Get(player: Player): Logic.Profile? return records[player] end
function Progression.GetFolder(player: Player): Folder? return folders[player] end
function Progression.Notify(player: Player, xp: number, gold: number, levels: number)
 local match = Teams.GetState()
 if notice and player.Parent == Players and match then notice:FireClient(player, xp, gold, levels, match.roundId) end
end
function Progression.Publish(player: Player)
 local data, folder = records[player], folders[player]; if not data or not folder then return end
 for _, key in { "Level", "CurrentXP", "TotalKills", "TotalDeaths", "TotalMinionKills", "Assists" } do
  folder:SetAttribute(key, (data :: any)[key])
 end
 folder:SetAttribute("SkillPoints", data.SkillPoints)
 for _, id in Learning.order(tostring(player:GetAttribute("HeroId"))) do
  folder:SetAttribute("Rank_"..id, data.Learned[id] or 0)
  folder:SetAttribute("LearnReason_"..id, Learning.reason(data,id,tostring(player:GetAttribute("HeroId"))) or "Ready")
 end
 folder:SetAttribute("XPToNextLevel", Rules.required(data.Level)); folder:SetAttribute("Gold", Economy.GetGold(player))
 for id in Items.Items do folder:SetAttribute("Own_" .. id, data.Owned[id] == true) end
 folder:SetAttribute("Revision", ((folder:GetAttribute("Revision") or 0) :: number) + 1)
end
function Progression.ResetPlayer(player: Player)
 records[player] = Rules.new(); Economy.ResetPlayerEconomy(player)
 local match = Teams.GetState()
 Progression.Publish(player); Progression.Changed:Fire(player, "Reset", 0, if match then match.roundId else nil)
end
function Progression.ResetMatch()
 for _, player in Players:GetPlayers() do Progression.ResetPlayer(player) end
end
function Progression.AddXP(player: Player, amount: number): number
 local data = records[player]; if not data or not Economy.IsEligible(player) then return 0 end
 local levels, accepted = Rules.addXP(data, amount)
 if accepted > 0 then
  local match = Teams.GetState()
  Progression.Publish(player); Progression.Changed:Fire(player, "XP", levels, if match then match.roundId else nil)
  Progression.Notify(player, accepted, 0, levels)
 end
 return levels
end
function Progression.Increment(player: Player, key: string)
 local data = records[player]; if not data or not Economy.IsEligible(player) then return end
 if key == "TotalKills" then data.TotalKills += 1
 elseif key == "TotalDeaths" then data.TotalDeaths += 1
 elseif key == "TotalMinionKills" then data.TotalMinionKills += 1
 elseif key == "Assists" then data.Assists += 1 else return end
 Progression.Publish(player)
end
function Progression.Equip(player: Player, id: string): boolean
 local data, item = records[player], Items.Items[id]
 if not data or not item or not item.Permanent or data.Owned[id] or not Economy.IsEligible(player) then return false end
 data.Owned[id] = true
 local match = Teams.GetState()
 Progression.Publish(player); Progression.Changed:Fire(player, "Equipment", 0, if match then match.roundId else nil); return true
end
function Progression.Start()
 if started then return end; started = true
 notice = Instance.new("RemoteEvent"); notice.Name = "HeroNotice"; notice.Parent = game:GetService("ReplicatedStorage")
 Economy.GoldChanged.Event:Connect(function(player: Player, _balance: number, delta: number, reason: string, roundId: number?)
  local match = Teams.GetState(); if match and roundId ~= match.roundId then return end
  Progression.Publish(player)
  if delta > 0 and reason ~= "Reset" then Progression.Notify(player, 0, delta, 0) end
 end)
 local function add(player: Player)
  local folder = Instance.new("Folder"); folder.Name = "HeroState"; folder.Parent = player; folders[player] = folder
  Progression.ResetPlayer(player)
 end
 Players.PlayerAdded:Connect(add)
 Players.PlayerRemoving:Connect(function(player)
  records[player] = nil; Economy.Remove(player)
  if folders[player] then folders[player]:Destroy(); folders[player] = nil end
 end)
 for _, player in Players:GetPlayers() do add(player) end
end
return Progression
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="228">
          <Properties>
            <string name="Name">HeroService</string>
            <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ContentProvider = game:GetService("ContentProvider")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config.HeroConfig)
local Combat = require(Shared.Config.CombatConfig)
local Ids = require(Shared.Config.AnimationIds)
local Appearance = require(script.Parent.HeroAppearanceService)
local HeroService = {}
local connections: { [Player]: { RBXScriptConnection } } = {}
local prepared: { [Model]: boolean } = setmetatable({}, { __mode = "k" })
local started = false
local selections:{[Player]:number}={}
local choosing:{[Player]:boolean}={}
function HeroService.Assign(player: Player, model: Model)
	local id = player:GetAttribute("HeroId")
	if typeof(id) ~= "string" or not Config.Heroes[id] then id = Config.DefaultHero end
	local hero = Config.Heroes[id :: string]
	player:SetAttribute("HeroId", id); model:SetAttribute("HeroId", id)
	model:SetAttribute("CombatProfileId", hero.Profile)
end
local function prepare(player: Player, model: Model)
	HeroService.Assign(player, model)
	task.spawn(function()
		local humanoid = model:WaitForChild("Humanoid", Combat.CharacterReadyTimeout)
		local head = model:WaitForChild("Head", Combat.CharacterReadyTimeout)
		if player.Character ~= model or not head or not humanoid or not humanoid:IsA("Humanoid") then return end
		if humanoid.RigType ~= Enum.HumanoidRigType.R15 then warn("[Heroes] OrangeNinja needs R15; synchronize default.project.json"); return end
		Appearance.Apply(model)
		if prepared[model] then return end; prepared[model] = true
		local animator = humanoid:FindFirstChildOfClass("Animator") or Instance.new("Animator")
		animator.Parent = humanoid
		local profile = Combat.Profiles[tostring(model:GetAttribute("CombatProfileId"))]
		local set = if profile then Ids[profile.AnimationSet] else nil
		-- Only explicitly configured, accessible tracks suppress the procedural fallback.
		for key, asset in set or {} do
			if not string.match(asset, "^rbxassetid://[1-9]%d*$") then continue end
			task.spawn(function()
				local animation = Instance.new("Animation"); animation.AnimationId = asset
				local loaded = false
				local ok = pcall(function()
					ContentProvider:PreloadAsync({ animation }, function(_, status) loaded = status == Enum.AssetFetchStatus.Success end)
				end)
				animation:Destroy()
				if model.Parent and player.Character == model then model:SetAttribute("TrackReady_" .. key, ok and loaded) end
			end)
		end
	end)
end
local function bind(player: Player)
	if connections[player] then return end
	player:SetAttribute("HeroId", Config.DefaultHero)
	connections[player] = {
		player.CharacterAdded:Connect(function(model) prepare(player, model) end),
		player.CharacterAppearanceLoaded:Connect(function(model) prepare(player, model) end),
	}
	if player.Character then prepare(player, player.Character) end
end
function HeroService.Start()
	if started then return end; started = true
	game:GetService("StarterPlayer").LoadCharacterAppearance = false
 local selection=Instance.new("RemoteEvent");selection.Name="HeroSelection";selection.Parent=game.ReplicatedStorage
 selection.OnServerEvent:Connect(function(player:Player,id:any,...:any)
  if select("#",...)~=0 or typeof(id)~="string" or not Config.Heroes[id] or choosing[player] then return end
  local now=os.clock();if now-(selections[player] or -10)<2 then return end;selections[player]=now
  local model=player.Character;local root=if model then model:FindFirstChild("HumanoidRootPart") else nil
  local hp=if model then model:FindFirstChildOfClass("Humanoid") else nil
  if not hp or hp.Health<=0 then selection:FireClient(player,false,"Дождитесь возрождения героя");return end
  local spawn=player.RespawnLocation;local state=require(script.Parent.TeamService).GetState()
  if not state or not model or not root or not root:IsA("BasePart") or not spawn or (root.Position-spawn.Position).Magnitude>30 then selection:FireClient(player,false,"Выбор героя доступен на своей базе");return end
  if player:GetAttribute("HeroChosenRound")==state.roundId and not game:GetService("RunService"):IsStudio() then selection:FireClient(player,false,"Герой уже выбран на этот матч");return end
  if model:GetAttribute("CombatState")=="Stunned" then return end
  choosing[player]=true;player:SetAttribute("HeroChosenRound",state.roundId);player:SetAttribute("HeroId",id)
  local progression=require(script.Parent.HeroProgressionService);local profile=progression.Get(player)
  if profile then profile.Learned={};profile.SkillPoints=profile.Level;progression.Publish(player) end
  selection:FireClient(player,true,id)
  task.spawn(function() local ok,err=pcall(function() player:LoadCharacterAsync() end);choosing[player]=nil;if not ok then warn("[Heroes] Respawn failed",err) end end)
 end)
	Players.PlayerAdded:Connect(bind)
	Players.PlayerRemoving:Connect(function(player)
		for _, connection in connections[player] or {} do connection:Disconnect() end
		connections[player] = nil
	end)
	for _, player in Players:GetPlayers() do bind(player) end
end
return HeroService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="229">
          <Properties>
            <string name="Name">HitboxService</string>
            <string name="Source"><![CDATA[--!strict

local Workspace = game:GetService("Workspace")
local Config = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared").Config.CombatConfig)

local Damage = require(script.Parent.DamageService)
local HitboxService = {}

local function bodyRadius(character: Model): number
	local radius = character:GetAttribute("CombatBodyRadius")
	return if typeof(radius) == "number" and radius == radius and radius > 0 and radius < math.huge then radius else 0
end

function HitboxService.IsFiniteCFrame(frame: CFrame): boolean
	for _, value in { frame:GetComponents() } do
		if value ~= value or math.abs(value) == math.huge then
			return false
		end
	end
	return true
end

local function findHumanoid(part: BasePart): Humanoid?
	if part:GetAttribute("HeroCosmetic") == true or part:GetAttribute("StructureCosmetic") == true then return nil end
	-- Accessories and held weapons must not extend the victim's hurtbox.
	if part:FindFirstAncestorWhichIsA("Accessory") or part:FindFirstAncestorWhichIsA("Tool") then
		return nil
	end
	local ancestor: Instance? = part.Parent
	while ancestor and ancestor ~= Workspace do
		if ancestor:IsA("Model") then
			local humanoid = ancestor:FindFirstChildOfClass("Humanoid")
			if humanoid then
				return humanoid
			end
		end
		ancestor = ancestor.Parent
	end
	return nil
end

function HitboxService.GetTargets(attacker: Model, root: BasePart, profile: Config.AttackProfile, admitWake: ((Model)->boolean)?): ({ Humanoid }, CFrame, Vector3)
	local origin = root.CFrame
	local dimensions, offset = profile.HitboxSize, profile.HitboxOffset
	local size = Vector3.new(dimensions.X, dimensions.Y, dimensions.Z)
	local box = origin * CFrame.new(offset.X, offset.Y, offset.Z)
	if not HitboxService.IsFiniteCFrame(origin) then
		return {}, box, size
	end
	local overlap = OverlapParams.new()
	overlap.FilterType = Enum.RaycastFilterType.Exclude
	overlap.FilterDescendantsInstances = { attacker }
	overlap.MaxParts = 0

	-- Orientation and position are sampled at the authoritative impact time.
	local parts = Workspace:GetPartBoundsInBox(box, size, overlap)
	local targets: { Humanoid } = {}
	local seen: { [Humanoid]: boolean } = {}

	local rayParams = RaycastParams.new()
	rayParams.FilterType = Enum.RaycastFilterType.Exclude
	-- Other fighters in the same swing must not occlude a multi-target hit.
	local occlusionFilter: { Instance } = { attacker }
	local filtered: { [Instance]: boolean } = { [attacker] = true }
	for _, part in parts do
		local humanoid = findHumanoid(part)
		local model = if humanoid then humanoid.Parent else nil
		if model and not filtered[model] then
			filtered[model] = true
			table.insert(occlusionFilter, model)
		end
	end
	rayParams.FilterDescendantsInstances = occlusionFilter
	rayParams.RespectCanCollide = true

	for _, part in parts do
		local humanoid = findHumanoid(part)
		if not humanoid or seen[humanoid] then
			continue
		end
		seen[humanoid] = true
		local character = humanoid.Parent
		if not character or not character:IsA("Model") or character == attacker or humanoid.Health <= 0 then
			continue
		end
		if (not Damage.CanDamage(attacker, character) and (not admitWake or not admitWake(character)))
			or character:FindFirstChildOfClass("ForceField") then continue end
		local targetRoot = character:FindFirstChild("HumanoidRootPart")
		if not targetRoot or not targetRoot:IsA("BasePart") or not HitboxService.IsFiniteCFrame(targetRoot.CFrame) then
			continue
		end
		local delta = targetRoot.Position - origin.Position
		-- The overlap already touched a real hurtbox. A giant's root must not reject a hit on its flank.
		local radius = bodyRadius(character)
		if delta.Magnitude > profile.MaxTargetDistance + radius then continue end
		if delta.Magnitude > Config.PositionEpsilon and origin.LookVector:Dot(delta) < delta.Magnitude * profile.MinimumForwardDot - radius then continue end
		-- A nearby limb alone must not let an attack pass through a solid wall.
		local obstruction = Workspace:Raycast(origin.Position, targetRoot.Position - origin.Position, rayParams)
		if not obstruction or obstruction.Instance:IsDescendantOf(character) then
			table.insert(targets, humanoid)
		end
	end
 -- A player can explicitly wake one sleeping ally. Default callers remain enemy-only.
 -- Choose the closest admitted interaction; overlap iteration order is unspecified.
 table.sort(targets, function(a: Humanoid, b: Humanoid): boolean
  local first = (a.Parent :: Model):FindFirstChild("HumanoidRootPart") :: BasePart
  local second = (b.Parent :: Model):FindFirstChild("HumanoidRootPart") :: BasePart
  return math.max(0,(first.Position - origin.Position).Magnitude-bodyRadius(a.Parent :: Model))
   < math.max(0,(second.Position - origin.Position).Magnitude-bodyRadius(b.Parent :: Model))
 end)
 while #targets > profile.MaxTargets do table.remove(targets) end
 return targets, box, size
end

return HitboxService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="230">
          <Properties>
            <string name="Name">ItemShopService</string>
            <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config.ProgressionConfig)
local Items = require(Shared.Config.ItemConfig)
local Rules = require(Shared.Game.ProgressionRules).configure(Config, Items.Items)
local Progression = require(script.Parent.HeroProgressionService)
local Economy = require(script.Parent.EconomyService)
local Stats = require(script.Parent.CharacterStatsService)
local Limiter = require(script.Parent.RequestLimiter)
local Teams = require(script.Parent.TeamService)
local RoundProtocol = require(Shared.Game.RoundProtocol)
type Session = { bucket: Limiter.Bucket, lastId: number, busy: boolean }
local Shop = {}
local shops: { [string]: BasePart } = {}
local sessions: { [Player]: Session } = {}
local remote: RemoteEvent? = nil
local started = false
function Shop.GetLocation(teamId: string): BasePart? return shops[teamId] end
function Shop.Availability(player: Player): (Humanoid?, string?)
 if not Economy.IsEligible(player) then return nil, "Unavailable" end
 local model = player.Character
 local match = Teams.GetState()
 if not model or not match or model:GetAttribute("RoundId") ~= match.roundId or model:GetAttribute("CombatDisabled") == true then return nil, "Unavailable" end
 local humanoid = if model then model:FindFirstChildOfClass("Humanoid") else nil
 local root = if model then model:FindFirstChild("HumanoidRootPart") else nil
 if not humanoid or humanoid.Health <= 0 or not root or not root:IsA("BasePart") then return nil, "Dead" end
 local id = player:GetAttribute("TeamId")
 local shop = if typeof(id) == "string" then shops[id] else nil
 if not shop or not shop:IsDescendantOf(workspace) then return nil, "Unavailable" end
 local distance = (root.Position - shop.Position).Magnitude
 if distance ~= distance or distance > Config.ShopDistance then return nil, "TooFar" end
 return humanoid, nil
end
function Shop.TryPurchase(player: Player, ...: any): (boolean, string)
 if player.Parent ~= Players then return false, "Unavailable" end
 local now = workspace:GetServerTimeNow()
 local session = sessions[player]
 if not session then session = { bucket = Limiter.new(Config.ShopBurst, Config.ShopRequestsPerSecond, now), lastId = 0, busy = false }; sessions[player] = session end
 if not Limiter.Consume(session.bucket, now) then return false, "RateLimited" end
 local requestId, itemId = ...
 if select("#", ...) ~= 2 or typeof(requestId) ~= "number" or requestId ~= requestId or requestId < 1
  or requestId > Config.MaxRequestId or requestId % 1 ~= 0 or typeof(itemId) ~= "string" or #itemId > 48 then return false, "Malformed" end
 if requestId <= session.lastId then return false, "Replay" end
 session.lastId = requestId
 if not Items.Items[itemId] then return false, "UnknownItem" end
 if session.busy then return false, "Busy" end
 session.busy = true
 -- Entire transaction is non-yielding, including all server validation and mutations.
 local function transaction(): (boolean, string)
  local humanoid, reason = Shop.Availability(player)
  if not humanoid then return false, reason or "Unavailable" end
  local profile = Progression.Get(player); if not profile then return false, "Unavailable" end
  reason = Rules.purchaseReason(profile, Economy.GetGold(player), itemId, humanoid.Health, humanoid.MaxHealth)
  if reason then return false, reason end
  local item = Items.Items[itemId]
  if not Economy.SpendGold(player, item.Cost, "Purchase:" .. itemId) then return false, "NotEnoughGold" end
  if item.Permanent then
   assert(Progression.Equip(player, itemId), "Validated equipment transaction failed")
   Stats.RecalculateStats(player)
  elseif item.Heal then
   humanoid.Health = math.min(humanoid.MaxHealth, humanoid.Health + item.Heal)
  end
  return true, "Purchased"
 end
 local ok, success, reason = pcall(transaction)
 session.busy = false
 if not ok then warn("[Shop] " .. tostring(success)); return false, "Unavailable" end
 return success, reason
end
function Shop.ResetSessions() table.clear(sessions) end
function Shop.HandleRequest(player: Player, ...: any): (boolean, string)
 local args = table.pack(...)
 local match = Teams.GetState()
 if not match or not RoundProtocol.accepts(match.roundId, args[args.n]) then return false, "StaleRound" end
 return Shop.TryPurchase(player, table.unpack(args, 1, args.n - 1))
end
function Shop.Start(arena: Folder)
 if started then return end; started = true
 remote = Instance.new("RemoteEvent"); remote.Name = "ItemShop"; remote.Parent = ReplicatedStorage
 local locations = arena:FindFirstChild("Shops"); assert(locations, "Map.Shops missing")
 for _, part in locations:GetChildren() do
  if not part:IsA("BasePart") then continue end
  local id = part:GetAttribute("TeamId"); assert(typeof(id) == "string", "Shop needs TeamId")
  shops[id] = part
  local prompt = part:FindFirstChildOfClass("ProximityPrompt"); assert(prompt, "Shop needs ProximityPrompt")
  prompt.Triggered:Connect(function(player)
   local humanoid = Shop.Availability(player)
   local match = Teams.GetState()
   if humanoid and player:GetAttribute("TeamId") == id and remote and match then remote:FireClient(player, "Open", nil, nil, nil, match.roundId) end
  end)
 end
 ;(remote :: RemoteEvent).OnServerEvent:Connect(function(player: Player, ...: any)
  local requestId = ...
  local success, reason = Shop.HandleRequest(player, ...)
  -- Invalid floods receive no amplification; well-formed requests get a bounded response.
  if typeof(requestId) == "number" and requestId == requestId and requestId >= 1 and requestId <= Config.MaxRequestId
   and reason ~= "RateLimited" and reason ~= "StaleRound" and remote then
   local match = Teams.GetState()
   remote:FireClient(player, "Result", requestId, success, reason, if match then match.roundId else nil)
  end
 end)
 Players.PlayerRemoving:Connect(function(player) sessions[player] = nil end)
end
return Shop
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="231">
          <Properties>
            <string name="Name">JungleService</string>
            <string name="Source"><![CDATA[--!strict
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config.JungleConfig)
local MapConfig = require(Shared.Config.MapConfig)
local Rules = require(Shared.Game.JungleRules)
local Factory = require(script.Parent.MinionFactory)
local Fighters = require(script.Parent.FighterStateService)
local Damage = require(script.Parent.DamageService)
local Teams = require(script.Parent.TeamService)
local Life = require(script.Parent.CombatLifeService)
type Camp = { id: string, home: Vector3, logic: Rules.Camp, model: Model?, target: Model?, nextAttack: number, returnAt: number, deadAt: number }
local Jungle = {}
local camps: { Camp } = {}
local container: Folder? = nil
function Jungle.GetAll(): { Camp } return camps end
local function remove(camp: Camp)
	local model = camp.model; if not model then return end
	Teams.RemoveNeutral(model); Fighters.Remove(model); Life.Remove(model); model:Destroy(); camp.model = nil
end
local function spawn(camp: Camp, now: number)
	local state = Teams.GetState(); if not state or state.phase ~= "InProgress" then return end
	remove(camp)
	local model = Factory.Create("Jungle", Config.TeamId, Color3.fromRGB(156, 121, 75), camp.home, Config.Stats)
	model.Name = "ForestGuardian_" .. camp.id; model:SetAttribute("NeutralCampId", camp.id)
	model:SetAttribute("RoundId", state.roundId)
	local humanoid = model:FindFirstChildOfClass("Humanoid") :: Humanoid
	humanoid.DisplayName = "Лесной страж"
	model.Parent = container; camp.model = model; camp.logic = Rules.new(); camp.target = nil; camp.nextAttack = now + 0.5; camp.returnAt = 0
	Teams.RegisterNeutral(model); Fighters.GetOrCreate(model); Life.Register(model)
	local root = model.PrimaryPart :: BasePart
	if root:CanSetNetworkOwnership() then root:SetNetworkOwner(nil) end
end
function Jungle.Stop()
	for _, camp in camps do
		camp.target = nil
		if camp.model then
			camp.model:SetAttribute("CombatDisabled", true)
			local humanoid = camp.model:FindFirstChildOfClass("Humanoid")
			if humanoid then humanoid:Move(Vector3.zero); humanoid.WalkSpeed = 0 end
		end
	end
end
function Jungle.Start(arena: Folder)
	if container then return end
	local folder = Instance.new("Folder"); folder.Name = "JungleCamps"; folder.Parent = workspace; container = folder
	local markers = Instance.new("Folder"); markers.Name = "Jungle"; markers.Parent = arena
	for _, definition in Config.Camps do
		local home = MapConfig.Origin + definition.Offset
		local marker = Instance.new("Part"); marker.Name = definition.Id; marker.Anchored = true
		marker.CanCollide = false; marker.CanQuery = false; marker.CanTouch = false
		marker.Size = Vector3.new(15, 0.15, 15); marker.Position = home - Vector3.new(0, 2.9, 0)
		marker.Color = Color3.fromRGB(93, 79, 54); marker.Material = Enum.Material.Ground; marker.Parent = markers
		table.insert(camps, { id = definition.Id, home = home, logic = {mode="Dead",respawnAt=0}, model=nil, target=nil, nextAttack=0, returnAt=0, deadAt=0 })
	end
	Damage.Applied.Event:Connect(function(attacker: Model, target: Model)
		for _, camp in camps do
			if camp.model ~= target or camp.logic.mode == "Returning" or camp.logic.mode == "Dead" then continue end
			local root = attacker:FindFirstChild("HumanoidRootPart")
			if root and root:IsA("BasePart") and (root.Position-camp.home).Magnitude <= Config.Leash then camp.target = attacker end
		end
	end)
end
function Jungle.Update(now: number)
	local state = Teams.GetState(); if not state or state.phase ~= "InProgress" then return end
	for _, camp in camps do
		local model = camp.model
		if model and not model.Parent then remove(camp); Rules.die(camp.logic, now, Config.RespawnDelay); model = nil end
		if model and model.Parent then
			local humanoid = model:FindFirstChildOfClass("Humanoid") :: Humanoid
			if humanoid.Health <= 0 and camp.logic.mode ~= "Dead" then Rules.die(camp.logic, now, Config.RespawnDelay); camp.deadAt = now; camp.target = nil end
			if camp.logic.mode == "Dead" and now - camp.deadAt >= Config.CorpseLifetime then remove(camp); model = nil end
		end
		if camp.logic.mode == "Dead" then
			if Rules.step(camp.logic, now, true, 0, false, 0, Config.Leash) == "Spawn" then spawn(camp, now) end
			continue
		end
		if not model or not model.Parent then remove(camp); Rules.die(camp.logic, now, Config.RespawnDelay); continue end
		local humanoid = model:FindFirstChildOfClass("Humanoid") :: Humanoid
		local root = model.PrimaryPart :: BasePart
		local fighter = Fighters.Get(model)
		if fighter and fighter.logic.mode ~= "Stunned" then Fighters.SetWalkSpeed(model,Config.Stats.WalkSpeed) end
		local target = camp.target
		if target and not Damage.CanDamage(model, target) then target = nil end
		if not target and camp.logic.mode ~= "Returning" then
			local nearest = Config.DetectionRange
			for candidate, candidateFighter in Fighters.GetAll() do
				if not Damage.CanDamage(model, candidate) then continue end
				local distance = (candidateFighter.root.Position - root.Position).Magnitude
				if distance < nearest then nearest = distance; target = candidate end
			end
		end
		local targetRoot = if target then target:FindFirstChild("HumanoidRootPart") else nil
		local valid = targetRoot ~= nil and targetRoot:IsA("BasePart")
		local targetPosition = if valid then (targetRoot :: BasePart).Position else camp.home
		local mode = Rules.step(camp.logic, now, true, (root.Position-camp.home).Magnitude, valid, (targetPosition-camp.home).Magnitude, Config.Leash)
		model:SetAttribute("AIState", mode); model:SetAttribute("CombatDisabled", mode == "Returning")
		if mode == "Returning" then
			camp.target = nil
			if camp.returnAt == 0 then camp.returnAt = now end
			-- Bounded recovery when terrain/physics prevents reaching the camp.
			if now - camp.returnAt > 6 then model:PivotTo(CFrame.new(camp.home)) end
			humanoid:MoveTo(camp.home)
		else
			camp.returnAt = 0; camp.target = target
			if mode == "Idle" then humanoid.Health = humanoid.MaxHealth; humanoid:MoveTo(camp.home) end
			if mode == "Chasing" and target and fighter and fighter.logic.mode ~= "Stunned" then
				if (targetPosition-root.Position).Magnitude > Config.AttackRange then humanoid:MoveTo(targetPosition)
				else
					humanoid:MoveTo(root.Position)
					if now >= camp.nextAttack then
						camp.nextAttack = now + Config.Stats.AttackCooldown
						local victim = target:FindFirstChildOfClass("Humanoid")
						if victim then Damage.ApplyAttack(model, victim, Config.Stats.Damage) end
					end
				end
			end
		end
	end
end
return Jungle
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="232">
          <Properties>
            <string name="Name">KnockbackService</string>
            <string name="Source"><![CDATA[--!strict

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config.CombatConfig)
local Structures = require(Shared.Game.StructureRules)
local Workspace = game:GetService("Workspace")
local KnockbackService = {}

-- Stun acquires temporary server ownership before this impulse is applied.
function KnockbackService.Apply(attacker: BasePart, target: BasePart, profile: Config.AttackProfile, speedOverride: number?, upOverride: number?)
	if target.Anchored or not target.Parent then return end
	if Structures.isStructure(target.Parent:GetAttribute("EntityKind")) then return end
	local delta = target.Position - attacker.Position
	local horizontal = Vector3.new(delta.X, 0, delta.Z)
	if horizontal.Magnitude < Config.PositionEpsilon then
		local look = attacker.CFrame.LookVector
		horizontal = Vector3.new(look.X, 0, look.Z)
	end
	if horizontal.Magnitude < Config.PositionEpsilon then return end
	local direction = horizontal.Unit
	local speed = speedOverride or profile.KnockbackVelocity
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { attacker.Parent :: Instance, target.Parent :: Instance }
	params.RespectCanCollide = true
	local size = profile.KnockbackProbeSize
	local wall = Workspace:Blockcast(target.CFrame, Vector3.new(size.X, size.Y, size.Z), direction * speed * profile.KnockbackWallProbeTime, params)
	if wall then
		speed = math.min(speed, math.max(0, wall.Distance - profile.KnockbackWallPadding) / profile.KnockbackWallProbeTime)
	end
	local desired = direction * speed + Vector3.new(0, upOverride or profile.KnockbackUpVelocity, 0)
	if desired.Magnitude > profile.MaxKnockbackSpeed then desired = desired.Unit * profile.MaxKnockbackSpeed end
	local mass = target.AssemblyMass
	if mass <= 0 or mass == math.huge or mass ~= mass then return end
	local current = target.AssemblyLinearVelocity
	if current.Magnitude ~= current.Magnitude or current.Magnitude == math.huge then
		target.AssemblyLinearVelocity = Vector3.zero
		current = Vector3.zero
	end
	-- Set a bounded initial velocity via a mass-scaled delta impulse, never stack it.
	target:ApplyImpulse((desired - current) * mass)
end

return KnockbackService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="233">
          <Properties>
            <string name="Name">KuramaSwipeService</string>
            <string name="Source"><![CDATA[--!strict
local Shared=game.ReplicatedStorage:WaitForChild("Shared")
local Avatar=require(Shared.KuramaAvatar)
local Config=require(Shared.Config.KuramaAvatarConfig)
local Data=require(Shared.Config.NarutoFormVisualData)
local Factory=require(Shared.CreatorVisualFactory)
local Damage=require(script.Parent.DamageService)
local Visibility=require(script.Parent.AbilityTargetService)
local Hitboxes=require(script.Parent.HitboxService)
local M={}
local limbs:{Factory.Spec}={}
for _,spec in Data.Kurama do
 if string.find(spec.name,"Hand",1,true) or string.find(spec.name,"LowerArm",1,true) then table.insert(limbs,spec) end
end
local function humanoid(part:BasePart):Humanoid?
 if part:GetAttribute("HeroCosmetic")==true or part:GetAttribute("StructureCosmetic")==true or part:FindFirstAncestorWhichIsA("Accessory") or part:FindFirstAncestorWhichIsA("Tool") then return nil end
 local p:Instance?=part.Parent
 while p and p~=workspace do
  if p:IsA("Model") then local h=p:FindFirstChildOfClass("Humanoid");if h then return h end end;p=p.Parent
 end
 return nil
end
function M.Targets(attacker:Model,origin:CFrame,previous:CFrame,fromPhase:number,toPhase:number,serial:number,now:number):{Humanoid}
 local result:{Humanoid}={};local seen:{[Humanoid]:boolean}={}
 if not Hitboxes.IsFiniteCFrame(origin) then return result end
 local first=math.max(Config.SwipeStart,fromPhase);local last=math.min(Config.SwipeEnd,toPhase)
 if first>last or toPhase<Config.SwipeStart or fromPhase>Config.SwipeEnd then return result end
 -- Do not turn a teleport into a damaging trail across the map.
 if (origin.Position-previous.Position).Magnitude>8 then previous=origin end
 local count=math.clamp(math.ceil((last-first)/.012+(origin.Position-previous.Position).Magnitude/.5),1,48)
 local overlap=OverlapParams.new();overlap.FilterType=Enum.RaycastFilterType.Exclude;overlap.FilterDescendantsInstances={attacker}
 local side=if serial%2==0 then "Left" else "Right"
 for i=0,count do
  local t=i/count;local phase=first+(last-first)*t;local root=previous:Lerp(origin,t)
  for _,spec in limbs do
   if not string.find(spec.name,side,1,true) then continue end
   local box=root*Avatar.Motion(spec.name,Avatar.Offset(Factory.Frame(spec.cf)),now,0,phase,serial)
   local size=Factory.Vector(spec.size)*Config.Scale
   for _,part in workspace:GetPartBoundsInBox(box,size,overlap) do
    local h=humanoid(part);if not h or seen[h] then continue end
    local model=h.Parent
    if not model or not model:IsA("Model") or model==attacker or h.Health<=0 or not Damage.CanDamage(attacker,model) or model:FindFirstChildOfClass("ForceField") then continue end
    local target=model:FindFirstChild("HumanoidRootPart")
    if target and target:IsA("BasePart") and Visibility.Visible(attacker,model,origin.Position,target.Position) then seen[h]=true;table.insert(result,h) end
   end
  end
 end
 return result
end
return M
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="234">
          <Properties>
            <string name="Name">MapBuilder</string>
            <string name="Source"><![CDATA[--!strict
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config.MapConfig)
local Mode = require(Shared.Config.GameModeConfig)
local Progression = require(Shared.Config.ProgressionConfig)
local TowerFactory = require(script.Parent.TowerFactory)
local MapScenery = require(script.Parent.MapScenery)
local MapBuilder = {}
function MapBuilder.EnsureShops(map: Folder)
	local existing = map:FindFirstChild("Shops")
	assert(not existing or existing:IsA("Folder"), "Map.Shops must be a Folder")
	local shops = existing or Instance.new("Folder"); shops.Name = "Shops"; shops.Parent = map
	local spawns = map:FindFirstChild("SpawnPoints"); assert(spawns)
	for _, team in Mode.Teams do
		if shops:FindFirstChild(team.Id) then continue end
		local points = spawns:FindFirstChild(team.Id); assert(points)
		local hero = points:FindFirstChild("Hero"); assert(hero and hero:IsA("BasePart"))
		local offset = Progression.ShopOffset
		local shop = Instance.new("Part"); shop.Name = team.Id; shop.Size = Vector3.new(5, 3, 5); shop.Anchored = true
		shop.Position = hero.Position + Vector3.new(offset.X, offset.Y, offset.Z)
		shop.Color = Color3.fromRGB(226, 181, 68); shop.Material = Enum.Material.Metal
		shop:SetAttribute("TeamId", team.Id); shop.Parent = shops
		local prompt = Instance.new("ProximityPrompt"); prompt.Name = "ShopPrompt"; prompt.ActionText = "Магазин"
		prompt.ObjectText = team.Id .. " • предметы за Gold"; prompt.MaxActivationDistance = Progression.ShopPromptDistance
		prompt.HoldDuration = 0; prompt.RequiresLineOfSight = false; prompt.Parent = shop
	end
end
local function folder(parent: Instance, name: string): Folder
	local item = Instance.new("Folder"); item.Name = name; item.Parent = parent; return item
end
local function part(parent: Instance, name: string, size: Vector3, position: Vector3, color: Color3): Part
	local item = Instance.new("Part")
	item.Name = name; item.Anchored = true; item.Size = size; item.Position = Config.Origin + position
	item.Color = color; item.Material = Enum.Material.SmoothPlastic; item.TopSurface = Enum.SurfaceType.Smooth
	item.BottomSurface = Enum.SurfaceType.Smooth; item.Parent = parent; return item
end
function MapBuilder.Build(): Folder
	local existing = workspace:FindFirstChild("Map")
	if existing then
		assert(existing:IsA("Folder") and (existing:GetAttribute("SurvivalMapVersion") == Config.Version or existing:GetAttribute("AuthoredSurvivalMap") == true),
			"Workspace.Map is not a supported survival map; rename your existing container or supply an authored map")
		MapBuilder.EnsureShops(existing)
		TowerFactory.Build(existing)
		MapScenery.Ensure(existing)
		return existing
	end
	assert(Config.Generated, "Generated map disabled: provide Workspace.Map with AuthoredSurvivalMap=true")
	local map = Instance.new("Folder"); map.Name = "Map"; map:SetAttribute("SurvivalMapVersion", Config.Version)
	local ground = folder(map, "Ground"); local lanes = folder(map, "Lanes")
	local bases = folder(map, "Bases"); local spawns = folder(map, "SpawnPoints")
	local waypoints = folder(map, "Waypoints"); local decorations = folder(map, "Decorations")
	part(ground, "Arena", Config.GroundSize, Vector3.zero, Color3.fromRGB(82, 100, 66)).Material = Enum.Material.Grass
	local battlefield=part(ground,"ScorchedFront",Vector3.new(610,.06,130),Vector3.new(0,1.035,-270),Color3.fromRGB(134,122,98))
	battlefield.Material=Enum.Material.Ground;battlefield.CanCollide=false;battlefield.CanQuery=false
	-- Visible perimeter ridges stop characters from falling off the generated arena.
	for side=-1,1,2 do
		part(ground,"NorthSouthRidge"..side,Vector3.new(Config.GroundSize.X+12,18,8),Vector3.new(0,3,side*(Config.GroundSize.Z/2+4)),Color3.fromRGB(101,109,86)).Material=Enum.Material.Rock
		part(ground,"EastWestRidge"..side,Vector3.new(8,18,Config.GroundSize.Z),Vector3.new(side*(Config.GroundSize.X/2+4),3,0),Color3.fromRGB(101,109,86)).Material=Enum.Material.Rock
	end
	local routes = Config.Routes :: { [string]: { Vector3 } }
	for _, name in Config.LaneOrder do
		local lane = folder(lanes, name); local points = folder(waypoints, name)
		local route = routes[name]
		for index, position in route do
			local marker = part(points, tostring(index), Vector3.one, position, Color3.new(1, 1, 1))
			marker.Transparency = 1; marker.CanCollide = false; marker.CanQuery = false; marker.CanTouch = false
			if index < #route then
				local nextPosition = route[index + 1]
				local delta = nextPosition - position
				local road = part(lane, "Road" .. index, Vector3.new(Config.LaneWidth, 0.2, delta.Magnitude + Config.LaneWidth),
					(position + nextPosition) / 2 - Vector3.new(0, 2.85, 0), Color3.fromRGB(139, 124, 94))
				road.CFrame = CFrame.lookAt(road.Position, road.Position + delta)
				road.Material = Enum.Material.Ground
			end
		end
	end
	local paths=folder(map,"JunglePaths")
	for name,route in Config.Paths do
		local container=folder(paths,name)
		for i=1,#route-1 do
			local a,b=route[i],route[i+1];local delta=b-a
			local road=part(container,"Path"..i,Vector3.new(18,.08,delta.Magnitude+18),(a+b)/2-Vector3.new(0,2.88,0),Color3.fromRGB(109,107,77))
			road.CFrame=CFrame.lookAt(road.Position,road.Position+delta);road.Material=Enum.Material.Ground
			road.CanCollide=false;road.CanQuery=false
		end
	end
	local settings = Config.Teams :: { [string]: { Base: Vector3, Hero: Vector3, Reverse: boolean } }
	for _, team in Mode.Teams do
		local layout = settings[team.Id]; assert(layout, "Map layout missing for " .. team.Id)
		local model = Instance.new("Model"); model.Name = team.Id .. "Base"; model:SetAttribute("TeamId", team.Id)
		model:SetAttribute("EntityKind", "Base"); model.Parent = bases
		local root = part(model, "HumanoidRootPart", Vector3.new(6, 6, 6), layout.Base, team.Color)
		root.Material = Enum.Material.Neon; model.PrimaryPart = root
		local humanoid = Instance.new("Humanoid"); humanoid.RequiresNeck = false; humanoid.BreakJointsOnDeath = false
		humanoid.MaxHealth = Mode.BaseHealth; humanoid.Health = Mode.BaseHealth; humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		humanoid.Parent = model
		part(decorations, team.Id .. "Foundation", Vector3.new(23, 0.3, 23), layout.Base - Vector3.new(0, 2.85, 0), team.Color)
		local teamSpawns = folder(spawns, team.Id)
		local spawn = Instance.new("SpawnLocation"); spawn.Name = "Hero"; spawn.Anchored = true
		spawn.Size = Vector3.new(8, 1, 8); spawn.Position = Config.Origin + layout.Hero
		local facing = Config.Origin + layout.Base
		spawn.CFrame = CFrame.lookAt(spawn.Position, Vector3.new(facing.X, spawn.Position.Y, facing.Z))
		spawn.Color = team.Color; spawn.TeamColor = BrickColor.new(team.Color); spawn.Neutral = false
		spawn.AllowTeamChangeOnTouch = false; spawn.Duration = 0; spawn.Parent = teamSpawns
		for _, lane in Config.LaneOrder do
			local route = routes[lane]; local location = route[if layout.Reverse then #route else 1]
			local marker = part(teamSpawns, lane, Vector3.one, location, team.Color)
			marker.Transparency = 1; marker.CanCollide = false; marker.CanQuery = false; marker.CanTouch = false
		end
	end
	for index, position in Config.Obstacles do
		part(decorations, "Rock" .. index, Vector3.new(15, 8, 12), position, Color3.fromRGB(65, 72, 77)).Material = Enum.Material.Rock
	end
	map.Parent = workspace
	MapBuilder.EnsureShops(map)
	TowerFactory.Build(map)
	MapScenery.Ensure(map)
	return map
end
function MapBuilder.Route(map: Folder, lane: string, reverse: boolean): { Vector3 }
	local waypoints = map:FindFirstChild("Waypoints"); assert(waypoints, "Waypoints missing")
	local container = waypoints:FindFirstChild(lane); assert(container, "Route missing")
	local ordered = container:GetChildren()
	table.sort(ordered, function(a, b) return (tonumber(a.Name) or 0) < (tonumber(b.Name) or 0) end)
	local route = {}
	for _, item in ordered do if item:IsA("BasePart") then table.insert(route, item.Position) end end
	assert(#route >= 2, "Route requires at least two points")
	if reverse then
		local reversed = {}; for index = #route, 1, -1 do table.insert(reversed, route[index]) end
		return reversed
	end
	return route
end
return MapBuilder
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="235">
          <Properties>
            <string name="Name">MapScenery</string>
            <string name="Source"><![CDATA[--!strict
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config.MapConfig)
local Plan = require(Shared.Game.MapSceneryPlan)
local MapScenery = {}
local palette = {
	Bark = Color3.fromRGB(103, 72, 48), Leaf = Color3.fromRGB(52, 98, 65), LightLeaf = Color3.fromRGB(77, 120, 68),
	DarkLeaf = Color3.fromRGB(44, 66, 66), Ash = Color3.fromRGB(84, 81, 82), Rock = Color3.fromRGB(111, 115, 107),
	DarkRock = Color3.fromRGB(64, 65, 73), Moss = Color3.fromRGB(78, 104, 66), Plaster = Color3.fromRGB(211, 190, 146),
	Roof = Color3.fromRGB(68, 108, 91), Paper = Color3.fromRGB(226, 219, 185), Alliance = Color3.fromRGB(61, 94, 146),
	Enemy = Color3.fromRGB(148, 43, 52), Bone = Color3.fromRGB(163, 167, 144), Water = Color3.fromRGB(64, 131, 143),
	SandRock = Color3.fromRGB(153, 132, 103), Scorch = Color3.fromRGB(71, 65, 58), Canvas = Color3.fromRGB(194, 182, 135),
}
function MapScenery.Ensure(map: Folder)
	-- Authored maps own their appearance. Only decorate this generator's layout.
	if map:GetAttribute("AuthoredSurvivalMap") == true then return end
	local old = map:FindFirstChild("ShinobiScenery")
	if old and old:GetAttribute("SceneryVersion") == Plan.Version then return end
	assert(not old or old:GetAttribute("GeneratedScenery") == true, "ShinobiScenery is reserved for generated decor")
	local root = Instance.new("Folder")
	root.Name = "ShinobiScenery"
	root:SetAttribute("GeneratedScenery", true)
	root:SetAttribute("SceneryVersion", Plan.Version)
	local ok, failure = pcall(function()
		for _, piece in Plan.Build() do
			local item = Instance.new("Part")
			item.Name = piece.name
			item.Anchored = true
			item.CanCollide = piece.solid
			item.CanTouch = false
			item.CanQuery = piece.solid
			item.CastShadow = false -- Canopies cannot darken combat or hide targeting telegraphs.
			item.Size = Vector3.new(piece.sx, piece.sy, piece.sz)
			item.CFrame = CFrame.new(Config.Origin + Vector3.new(piece.x, piece.y, piece.z)) * CFrame.Angles(0, math.rad(piece.yaw), 0)
			if piece.pitch then item.CFrame*=CFrame.Angles(math.rad(piece.pitch),0,0) end
			item.Color = (palette :: { [string]: Color3 })[piece.palette]
			item.Material = (Enum.Material :: any)[piece.material]
			item.Shape = if piece.shape == "Ball" then Enum.PartType.Ball else Enum.PartType.Block
			if piece.shape == "Cylinder" then
				item.Shape=Enum.PartType.Cylinder
				item.Size=Vector3.new(piece.sy,piece.sx,piece.sz)
				item.CFrame*=CFrame.Angles(0,0,math.pi/2)
			end
			item.TopSurface = Enum.SurfaceType.Smooth
			item.BottomSurface = Enum.SurfaceType.Smooth
			item.Parent = root
		end
	end)
	if not ok then root:Destroy(); error(failure) end
	local function sign(name: string,position: Vector3,label: string,color: Color3)
		local marker=Instance.new("Part");marker.Name=name;marker.Anchored=true
		marker.Size=Vector3.new(2,9,2);marker.Position=Config.Origin+position
		marker.CanCollide=false;marker.CanQuery=false;marker.CanTouch=false
		marker.Material=Enum.Material.Wood;marker.Color=palette.Bark;marker.Parent=root
		local gui=Instance.new("BillboardGui");gui.Name="Wayfinding";gui.Size=UDim2.fromOffset(240,44)
		gui.StudsOffsetWorldSpace=Vector3.new(0,5,0);gui.MaxDistance=115;gui.AlwaysOnTop=false;gui.Parent=marker
		local text=Instance.new("TextLabel");text.Size=UDim2.fromScale(1,1);text.BackgroundColor3=Color3.fromRGB(26,33,29)
		text.BackgroundTransparency=.15;text.BorderSizePixel=0;text.Text=label;text.TextColor3=color
		text.Font=Enum.Font.GothamBold;text.TextSize=16;text.TextWrapped=true;text.Parent=gui
	end
	sign("AllianceCampSign",Vector3.new(-368,5,-46),"ЛАГЕРЬ АЛЬЯНСА",Color3.fromRGB(164,211,247))
	sign("WarFrontSign",Vector3.new(-45,5,-238),"ВЫЖЖЕННОЕ ПОЛЕ",Color3.fromRGB(230,204,150))
	sign("DivineRootsSign",Vector3.new(369,5,46),"КОРНИ ДРЕВА",Color3.fromRGB(233,175,166))
	for _,side in {-1,1} do
		sign("TopSign"..side,Vector3.new(side*320,5,-52),"ВЕРХНЯЯ ЛИНИЯ",Color3.fromRGB(231,222,186))
		sign("BottomSign"..side,Vector3.new(side*320,5,52),"НИЖНЯЯ ЛИНИЯ",Color3.fromRGB(231,222,186))
	end
	root:SetAttribute("PartCount", #root:GetChildren())
	if old then old:Destroy() end
	root.Parent = map
	local lighting=game:GetService("Lighting")
	lighting.ClockTime=14.5;lighting.Brightness=2.5
	lighting.Ambient=Color3.fromRGB(140,143,137);lighting.OutdoorAmbient=Color3.fromRGB(164,168,155)
	lighting.ExposureCompensation=.25
	lighting.FogColor=Color3.fromRGB(184,201,199);lighting.FogStart=650;lighting.FogEnd=1800
end
return MapScenery
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="236">
          <Properties>
            <string name="Name">MatchService</string>
            <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config.GameModeConfig)
local MinionConfig = require(Shared.Config.MinionConfig)
local Rules = require(Shared.Game.MatchState)
local Mode = require(script.Parent.GameModeService)
local Builder = require(script.Parent.MapBuilder)
local Teams = require(script.Parent.TeamService)
local Bases = require(script.Parent.BaseService)
local Damage = require(script.Parent.DamageService)
local AI = require(script.Parent.MinionAIService)
local Spawner = require(script.Parent.MinionSpawnerService)
local Progression = require(script.Parent.HeroProgressionService)
local Stats = require(script.Parent.CharacterStatsService)
local Rewards = require(script.Parent.RewardService)
local Shop = require(script.Parent.ItemShopService)
local Towers = require(script.Parent.TowerService)
local Structures = require(script.Parent.StructureService)
local TowerConfig = require(Shared.Config.TowerConfig)
local MapConfig = require(Shared.Config.MapConfig)
local Ability = require(script.Parent.AbilityService)
local Fighters = require(script.Parent.FighterStateService)
local Life = require(script.Parent.CombatLifeService)
local Jungle = require(script.Parent.JungleService)
local MatchService = {}
local state: Rules.State? = nil
local folder: Folder? = nil
local nextAI, nextSnapshot, nextDiagnostics = 0, 0, 0
local nextTower = 0
function MatchService.GetState(): Rules.State? return state end
function MatchService.ResetProgression()
	assert(not state or state.phase ~= "InProgress", "Reset progression only between matches")
	Progression.ResetMatch(); Rewards.Reset(); Shop.ResetSessions()
	require(script.Parent.AbilityService).Reset()
end
function MatchService.Publish()
	local current, replicated = state, folder
	if not current or not replicated then return end
	replicated:SetAttribute("Phase", current.phase); replicated:SetAttribute("StartedAt", current.startedAt)
	replicated:SetAttribute("RoundId", current.roundId)
	replicated:SetAttribute("FinishedAt", current.finishedAt); replicated:SetAttribute("Winner", current.winner or "")
	replicated:SetAttribute("Wave", current.wave); replicated:SetAttribute("ActiveNPCs", AI.GetCount())
	replicated:SetAttribute("PreparationEnds", current.preparationEnds); replicated:SetAttribute("MinimumPlayers", Mode.MinimumPlayers())
	for id, team in current.teams do
		local item = replicated:FindFirstChild(id)
		local base = Bases.Get(id)
		if item and base then
			item:SetAttribute("Kills", Rewards.GetTeamKills(id))
			item:SetAttribute("PlayerCount", team.count); item:SetAttribute("Capacity", Config.TeamCapacity)
			item:SetAttribute("Active", team.active); item:SetAttribute("Health", base.humanoid.Health)
			item:SetAttribute("MaxHealth", base.humanoid.MaxHealth)
			local remaining = Structures.Remaining(id)
			item:SetAttribute("TowersRemaining", remaining); item:SetAttribute("TowersTotal", #MapConfig.LaneOrder * #TowerConfig.Tiers)
			item:SetAttribute("BaseProtected", remaining > 0); base.model:SetAttribute("ProtectedByTowers", remaining > 0)
		end
	end
end
local function eliminate(id: string, roundId: number)
	local current = state; if not current then return end
	if roundId ~= current.roundId then return end
	if not Rules.eliminate(current, id, workspace:GetServerTimeNow()) then return end
	Teams.Eliminate(id); AI.RemoveTeam(id)
	if current.phase == "Finished" then
		Damage.SetEnabled(false); Jungle.Stop(); AI.SetRunning(false); Towers.CancelAll(); Ability.Reset(); Fighters.Reset(); Teams.Finish()
		print("[Match] Winner: " .. (current.winner or "Draw"))
	end
	MatchService.Publish()
end
function MatchService.Start()
	if state then return end
	Damage.SetEnabled(false)
	local arena = Builder.Build()
	local effects = workspace:FindFirstChild("Effects")
	assert(not effects or effects:IsA("Folder"), "Workspace.Effects must be a Folder")
	if not effects then local created = Instance.new("Folder"); created.Name = "Effects"; created.Parent = workspace end
	local initial = Rules.new(Mode.TeamIds()); state = initial
	Progression.Start(); Stats.Start(); Rewards.Start()
	Teams.Start(initial, arena); Bases.Start(arena); Spawner.Start(arena)
	Towers.Start(arena); Jungle.Start(arena)
	Shop.Start(arena); require(script.Parent.AbilityLearningService).Start()
	local replicated = Instance.new("Folder"); replicated.Name = "SurvivalState"
	for _, definition in Config.Teams do
		local item = Instance.new("Folder"); item.Name = definition.Id
		item:SetAttribute("DisplayName", definition.DisplayName)
		item:SetAttribute("Color", definition.Color); item.Parent = replicated
	end
	local shots = Instance.new("RemoteEvent"); shots.Name = "MinionShot"; shots.Parent = replicated
	local towerEvents = Instance.new("RemoteEvent"); towerEvents.Name = "TowerEvent"; towerEvents.Parent = replicated
	Towers.Event.Event:Connect(function(kind: string, model: Model, origin: Vector3, destination: Vector3, teamId: string, lane: string, roundId: number)
		if roundId ~= initial.roundId then return end
		towerEvents:FireAllClients(kind, model, origin, destination, teamId, lane, roundId)
		if kind == "Destroyed" then MatchService.Publish() end
	end)
	AI.Shot.Event:Connect(function(origin: Vector3, target: Vector3, kind: string, id: string, model: Model, roundId: number)
		if roundId ~= initial.roundId then return end
		shots:FireAllClients(origin, target, kind, id, model, roundId)
	end)
	replicated.Parent = ReplicatedStorage; folder = replicated
	Bases.Destroyed.Event:Connect(eliminate)
	MatchService.Publish()
	RunService.Heartbeat:Connect(function()
		local current = state; if not current then return end
		local now = workspace:GetServerTimeNow()
		Teams.Update(now)
		local ready = if Mode.IsSoloTest() then Teams.Count() >= 1 else Teams.Ready(Mode.MinimumPerTeam())
		local eligible = if ready then Teams.Count() else 0
		if Rules.advance(current, now, eligible, Mode.MinimumPlayers(), Config.PreparationTime, MinionConfig.FirstWaveDelay) then
			if current.phase == "InProgress" then Teams.LockRoster(); Damage.SetEnabled(true); AI.SetRunning(true) end
			MatchService.Publish()
		end
		if Rules.waveDue(current, now, MinionConfig.WaveInterval) then Spawner.Wave(current.wave); MatchService.Publish() end
		if now >= nextAI then
			nextAI = now + MinionConfig.UpdateInterval
			local before = os.clock(); AI.Update(now); Jungle.Update(now)
			workspace:SetAttribute("SurvivalAIUpdateMs", (os.clock() - before) * 1000)
		end
		if now >= nextSnapshot then nextSnapshot = now + Config.SnapshotInterval; MatchService.Publish() end
		Rewards.Update(now)
		if now >= nextTower then nextTower = now + TowerConfig.UpdateInterval; Towers.Update(now) end
		if MinionConfig.DebugPerformance and now >= nextDiagnostics then
			nextDiagnostics = now + MinionConfig.DiagnosticInterval
			print(string.format("[Minions] active=%d cap=%d updateMs=%.2f", AI.GetCount(), MinionConfig.MaxActiveNPCs, workspace:GetAttribute("SurvivalAIUpdateMs") :: number))
		end
	end)
end
return MatchService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="237">
          <Properties>
            <string name="Name">MeditationCloneService</string>
            <string name="Source"><![CDATA[--!strict
-- Entity adapter. Owner validation and mana credit are injected by NarutoAbilityService.
local Shared=game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Domain=require(Shared.Abilities.MeditationState)
local Units=require(Shared.Abilities.WorldUnits)
local Fighters=require(script.Parent.FighterStateService)
local Collision=require(script.Parent.SummonCollision)
type Record={model: Model, humanoid: Humanoid, owner: Player, character: Model, state: Domain.State, clone: Domain.Clone, valid: ()->boolean, credit: (number)->(), connection: RBXScriptConnection?}
local records: {[Model]: Record}={}
local Service={}
function Service.GetAll(): {[Model]: Record} return records end
-- Kurama pulses credit the owned domain pool, never just its replicated display.
function Service.RestoreMana(model: Model, amount: number): boolean
 local record=records[model]
 if not record or not model:IsDescendantOf(workspace) or record.humanoid.Health<=0 or not record.valid() then return false end
 if not Domain.restore(record.state,record.clone,workspace:GetServerTimeNow(),amount) then return false end
 model:SetAttribute("Mana",record.clone.mana)
 return true
end
local function remove(record: Record, now: number, transfer: boolean)
 if records[record.model]~=record then return end
 records[record.model]=nil
 if record.connection then record.connection:Disconnect() end
 local amount=Domain.settle(record.state,record.clone,now,transfer and record.valid())
 if amount>0 then record.credit(amount) end
 Fighters.Remove(record.model); record.model:Destroy()
end
function Service.ClearOwner(owner: Player)
 for _,record in records do if record.owner==owner then remove(record,workspace:GetServerTimeNow(),false) end end
end
function Service.Reset()
 for _,record in records do remove(record,workspace:GetServerTimeNow(),false) end
end
function Service.Recall(owner: Player, now: number)
 for _,record in records do if record.owner==owner then remove(record,now,true) end end
end
function Service.Spawn(owner: Player, character: Model, state: Domain.State, clones: {Domain.Clone}, valid: ()->boolean, credit: (number)->())
 local sourceRoot=character:FindFirstChild("HumanoidRootPart")
 if not sourceRoot or not sourceRoot:IsA("BasePart") then
  for _,clone in clones do Domain.settle(state,clone,workspace:GetServerTimeNow(),false) end
  return
 end
 for index,clone in clones do
  local archivable=character.Archivable; character.Archivable=true
  local model=character:Clone(); character.Archivable=archivable
  -- Remove inherited combat/VFX tags and state, keep only identity/team/round.
  for _,tag in game:GetService("CollectionService"):GetTags(model) do game:GetService("CollectionService"):RemoveTag(model,tag) end
  for key in model:GetAttributes() do
   if key~="TeamId" and key~="RoundId" and key~="HeroId" then model:SetAttribute(key,nil) end
  end
  for _,item in model:GetDescendants() do
   if item:IsA("LuaSourceContainer") or item:IsA("Tool") or item:IsA("ForceField") then item:Destroy()
   elseif item:IsA("BasePart") then item.CanCollide=false; item.CanTouch=false; item.Massless=true end
  end
  local root=model:FindFirstChild("HumanoidRootPart")
  local humanoid=model:FindFirstChildOfClass("Humanoid")
  if not root or not root:IsA("BasePart") or not humanoid then
   Domain.settle(state,clone,workspace:GetServerTimeNow(),false); model:Destroy(); continue
  end
  model.Name="MeditationClone"
  model:SetAttribute("EntityKind","Summon"); model:SetAttribute("NativeMeditationClone",true)
  model:SetAttribute("SummonOwner",owner.UserId); model:SetAttribute("CombatDisabled",false)
  model:SetAttribute("MeditationExpiresAt",clone.expiresAt); model:SetAttribute("Mana",clone.mana); model:SetAttribute("MaxMana",clone.maximum)
  humanoid.MaxHealth=1; humanoid.Health=1; humanoid.WalkSpeed=0; humanoid.AutoRotate=false
  humanoid.BreakJointsOnDeath=false; humanoid.DisplayDistanceType=Enum.HumanoidDisplayDistanceType.None
  root.Anchored=true; model.PrimaryPart=root
  -- Side placement in studs; clamp against walls. Kurama retains larger offset policy.
  local distance=Units.toStuds(if clone.maximum==2000 then 300 else 100)
  local offset=sourceRoot.CFrame.RightVector*(if index==1 then -distance else distance)
  local params=RaycastParams.new(); params.FilterType=Enum.RaycastFilterType.Exclude; params.FilterDescendantsInstances={character}; params.RespectCanCollide=true
  local wall=workspace:Blockcast(sourceRoot.CFrame,sourceRoot.Size,offset,params)
  if wall then offset=offset.Unit*math.max(0,wall.Distance-.1) end
  local folder=workspace:FindFirstChild("HeroSummons")
  if not folder then folder=Instance.new("Folder"); folder.Name="HeroSummons"; folder.Parent=workspace end
  Collision.Apply(model)
  model:PivotTo(character:GetPivot()+offset); model.Parent=folder
  -- A built-in seated meditation pose; no external animation/asset dependency.
  humanoid.Sit=true
  local record: Record={model=model,humanoid=humanoid,owner=owner,character=character,state=state,clone=clone,valid=valid,credit=credit,connection=nil}
  records[model]=record
  record.connection=humanoid.Died:Connect(function() remove(record,workspace:GetServerTimeNow(),true) end)
  Fighters.GetOrCreate(model)
 end
end
function Service.Update(now: number)
 for _,record in records do
  if not record.valid() or not Domain.live(record.state,record.clone) or not record.model.Parent then remove(record,now,false)
  elseif record.humanoid.Health<=0 or now>=record.clone.expiresAt then remove(record,now,true)
  else Domain.update(record.state,record.clone,now); record.model:SetAttribute("Mana",record.clone.mana) end
 end
end
return Service
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="238">
          <Properties>
            <string name="Name">MinionAIService</string>
            <string name="Source"><![CDATA[--!strict
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Players = game:GetService("Players")
local Config = require(Shared.Config.MinionConfig)
local MapConfig = require(Shared.Config.MapConfig)
local Fighters = require(script.Parent.FighterStateService)
local Damage = require(script.Parent.DamageService)
local Teams = require(script.Parent.TeamService)
local Bases = require(script.Parent.BaseService)
local Structures = require(script.Parent.StructureService)
export type Minion = {
	model: Model, humanoid: Humanoid, root: BasePart, teamId: string, kind: string, lane: string,
	stats: Config.Stats, route: { Vector3 }, waypoint: number, target: Model?, mode: string,
	nextAttack: number, spawnedAt: number, deadAt: number?, lastPosition: Vector3,
	progressAt: number, recoveries: number, recoveryUntil: number, recoveryGoal: Vector3?,
	serial: number, combatTarget: Model?, combatOffset: Vector3?,
	laneAssault: boolean, passUntil: number, passGoal: Vector3?, passes: number,
	connections: { RBXScriptConnection },
}
local AI = { Shot = Instance.new("BindableEvent") }
local records: { [Model]: Minion } = {}
local grid: { [string]: { Model } } = {}
local active = 0
local running = false
local serial = 0
local function flat(v: Vector3): Vector3 return v*Vector3.new(1,0,1) end
local function setMode(npc: Minion, mode: string)
	if npc.mode ~= mode then npc.mode = mode; npc.model:SetAttribute("AIState", mode) end
end
local function dead(npc: Minion)
	if npc.deadAt then return end
	active -= 1; npc.deadAt = workspace:GetServerTimeNow(); npc.target = nil
	npc.model:SetAttribute("MinionDiedAt", npc.deadAt)
	setMode(npc, "Dead"); npc.model:SetAttribute("CombatDisabled", true)
	npc.model:SetAttribute("TargetName", "")
	for _, item in npc.model:GetDescendants() do if item:IsA("BasePart") then item.CanCollide=false end end
	npc.humanoid:Move(Vector3.zero)
end
function AI.Remove(model: Model)
	local npc = records[model]; if not npc then return end
	if not npc.deadAt then active -= 1 end
	records[model] = nil
	for _, connection in npc.connections do connection:Disconnect() end
	Fighters.Remove(model); model:Destroy()
end
function AI.Register(model: Model, teamId: string, kind: string, lane: string, route: { Vector3 }, stats: Config.Stats)
	if records[model] then return end
	local match = Teams.GetState(); if match then model:SetAttribute("RoundId", match.roundId) end
	local root = model:FindFirstChild("HumanoidRootPart") :: BasePart
	local humanoid = model:FindFirstChildOfClass("Humanoid") :: Humanoid
	local now = workspace:GetServerTimeNow()
	serial += 1
	local npc: Minion = { model = model, humanoid = humanoid, root = root, teamId = teamId, kind = kind, lane = lane,
		stats = stats, route = route, waypoint = 1, target = nil, mode = "Spawning",
		nextAttack = now + Config.SpawnGrace, spawnedAt = now, deadAt = nil,
		lastPosition = root.Position, progressAt = now, recoveries = 0, recoveryUntil = 0, recoveryGoal = nil, connections = {},
		serial=serial,combatTarget=nil,combatOffset=nil,laneAssault=false,passUntil=0,passGoal=nil,passes=0 }
	records[model] = npc; active += 1
	model:SetAttribute("Lane", lane); model:SetAttribute("AIState", "Spawning"); model:SetAttribute("Waypoint", 1)
	if root:CanSetNetworkOwnership() then root:SetNetworkOwner(nil) end
	Fighters.GetOrCreate(model)
	table.insert(npc.connections, humanoid.Died:Connect(function() dead(npc) end))
	table.insert(npc.connections, model.AncestryChanged:Connect(function()
		if not model:IsDescendantOf(workspace) then AI.Remove(model) end
	end))
end
function AI.GetCount(): number return active end
function AI.Reset()
	running = false
	for model in records do AI.Remove(model) end
	table.clear(grid); active = 0
end
function AI.GetAll(): { [Model]: Minion } return records end
function AI.SetRunning(value: boolean)
	running = value
	if not value then
		for _, npc in records do
			npc.target = nil; npc.humanoid:MoveTo(npc.root.Position); npc.humanoid.WalkSpeed = 0
			npc.model:SetAttribute("CombatDisabled", true)
		end
	end
end
function AI.RemoveTeam(id: string)
	local remove = {}; for model, npc in records do if npc.teamId == id then table.insert(remove, model) end end
	for _, model in remove do AI.Remove(model) end
end
local function cell(position: Vector3): string
	return math.floor(position.X / Config.SpatialCellSize) .. ":" .. math.floor(position.Z / Config.SpatialCellSize)
end
local function rebuildGrid()
	table.clear(grid)
	for model, fighter in Fighters.GetAll() do
		if fighter.humanoid.Health > 0 and model.Parent then
			local key = cell(fighter.root.Position)
			local bucket = grid[key]
			if not bucket then bucket = {}; grid[key] = bucket end
			table.insert(bucket, model)
		end
	end
end
local function selectTarget(npc: Minion): Model?
	local nearestNPC, nearestHero: Model? = nil, nil
	local npcDistance, heroDistance = math.huge, math.huge
	local radius = npc.stats.DetectionRange
	local origin = npc.root.Position
	local minX, maxX = math.floor((origin.X - radius) / Config.SpatialCellSize), math.floor((origin.X + radius) / Config.SpatialCellSize)
	local minZ, maxZ = math.floor((origin.Z - radius) / Config.SpatialCellSize), math.floor((origin.Z + radius) / Config.SpatialCellSize)
	for x = minX, maxX do for z = minZ, maxZ do
		for _, model in grid[x .. ":" .. z] or {} do
			if not Damage.CanDamage(npc.model, model) then continue end
			local root = model:FindFirstChild("HumanoidRootPart")
			if not root or not root:IsA("BasePart") then continue end
			local distance = (root.Position - origin).Magnitude
			if distance > radius then continue end
			if model:GetAttribute("EntityKind") == "Minion" then
				if distance < npcDistance then nearestNPC = model; npcDistance = distance end
			elseif distance < heroDistance then nearestHero = model; heroDistance = distance end
		end
	end end
	if nearestNPC then return nearestNPC end
	if nearestHero then return nearestHero end
	-- Once a wave reaches its lane defenses, the newly unlocked tower is its
	-- objective even beyond local detection range. Never return to an old waypoint.
	local ownTower: Model? = nil; local ownTier=math.huge
	for model, tower in Structures.GetAll() do
		if tower.kind=="Tower" and tower.lane==npc.lane and Structures.Alive(tower) and Damage.CanDamage(npc.model,model) then
			local level=(model:GetAttribute("TowerTier") or 1) :: number
			if level<ownTier then ownTower=model;ownTier=level end
		end
	end
	if ownTower then
		local root=ownTower.PrimaryPart
		if root and (npc.laneAssault or (root.Position-origin).Magnitude<=math.max(npc.stats.DetectionRange,Config.StructureDetectionRange)) then return ownTower end
	end
	local selected: Model? = nil; local distance = math.huge
	for model, tower in Structures.GetAll() do
		if tower.kind ~= "Tower" or not Structures.Alive(tower) then continue end
		if ownTower and tower.lane~=npc.lane then continue end
		local separation = (tower.root.Position - origin).Magnitude
		local sameLane = tower.lane == npc.lane
		if separation <= (if sameLane then math.max(npc.stats.DetectionRange,Config.StructureDetectionRange) else npc.stats.AttackRange)
			and (separation < distance or (separation == distance and selected ~= nil and model.Name < selected.Name))
			and Damage.CanDamage(npc.model, model) then selected = model; distance = separation end
	end
	if selected then return selected end
	for _, base in Bases.GetAll() do
		local separation = (base.root.Position - origin).Magnitude
		if separation <= npc.stats.AttackRange and separation < distance and Damage.CanDamage(npc.model, base.model) then
			selected = base.model; distance = separation
		end
	end
	return selected
end
local function baseGoal(npc: Minion): Vector3?
	local selected: Vector3? = nil; local nearest = math.huge
	-- Once the lane route is complete, help another lane if its towers still shield the core.
	-- Own-lane towers always take precedence; the outer route keeps cross-lane travel away from rocks.
	local ownLane = false
	for model, tower in Structures.GetAll() do
		if tower.kind ~= "Tower" or not Structures.Alive(tower) or not Damage.CanDamage(npc.model, model) then continue end
		local sameLane = tower.lane == npc.lane
		local distance = (tower.root.Position - npc.root.Position).Magnitude
		if (sameLane and not ownLane) or (sameLane == ownLane and distance < nearest) then
			selected = tower.root.Position; nearest = distance; ownLane = sameLane
		end
	end
	if selected then return selected end
	for _, base in Bases.GetAll() do
		if Teams.IsActive(base.teamId) and base.teamId ~= npc.teamId and Structures.CanReceive(base.model) then
			local distance = (base.root.Position - npc.root.Position).Magnitude
			if distance < nearest then selected = base.root.Position; nearest = distance end
		end
	end
	return selected
end
local function visible(npc: Minion, target: Model, position: Vector3): boolean
	local params = RaycastParams.new(); params.FilterType = Enum.RaycastFilterType.Exclude
	local excluded: { Instance } = { npc.model, target, npc.model.Parent :: Instance }
	-- Actors do not obstruct a confirmed shot; solid map geometry still does.
	for _, player in Players:GetPlayers() do
		if player.Character then table.insert(excluded, player.Character) end
	end
	params.FilterDescendantsInstances = excluded
	params.RespectCanCollide = true
	return workspace:Raycast(npc.root.Position, position - npc.root.Position, params) == nil
end
local function crowded(npc: Minion, radius: number?): boolean
	for _, peer in records do
		if peer~=npc and not peer.deadAt and math.abs(peer.root.Position.Y-npc.root.Position.Y)<4
			and flat(peer.root.Position-npc.root.Position).Magnitude<(radius or Config.Separation-.2) then return true end
	end
	return false
end
local function combatGoal(npc: Minion, target: Model, center: Vector3): Vector3?
	if npc.combatTarget~=target then
		npc.combatTarget=target;npc.combatOffset=nil;npc.passUntil=0;npc.passGoal=nil;npc.recoveryUntil=0
	end
	local overlap=OverlapParams.new();overlap.FilterType=Enum.RaycastFilterType.Exclude
	overlap.FilterDescendantsInstances={npc.model.Parent :: Instance};overlap.RespectCanCollide=true
	overlap.CollisionGroup="SurvivalMinions"
	local function free(offset: Vector3): boolean
		for _, other in records do
			if other~=npc and not other.deadAt and other.combatTarget==target and other.combatOffset
				and (offset-other.combatOffset).Magnitude<Config.Separation then return false end
		end
		return #workspace:GetPartBoundsInBox(CFrame.new(center+offset),Vector3.new(Config.BodyDiameter,4,Config.BodyDiameter),overlap)==0
	end
	local radius=npc.stats.AttackRange-.6
	if npc.combatOffset and npc.combatOffset.Magnitude<=radius+.01 and free(npc.combatOffset) then return center+npc.combatOffset end
	-- Full melee positions must not strand the rest of a wave at the old tower.
	-- Reserve spaced waiting rings and promote them as inner positions become free.
	for ring=0,3 do
		if ring>0 and npc.combatOffset and math.abs(npc.combatOffset.Magnitude-(radius+ring*Config.Separation))<.01
			and free(npc.combatOffset) then return center+npc.combatOffset end
		local best: Vector3?=nil;local score=math.huge
		local count=12+ring*6
		for i=0,count-1 do
			local angle=i*2*math.pi/count;local offset=Vector3.new(math.cos(angle),0,math.sin(angle))*(radius+ring*Config.Separation)
			if free(offset) then
				local distance=flat(center+offset-npc.root.Position).Magnitude
				if distance<score then best=offset;score=distance end
			end
		end
		if best then npc.combatOffset=best;return center+best end
	end
	npc.combatOffset=nil;return nil
end
local function steer(npc: Minion, goal: Vector3): Vector3
	local delta=flat(goal-npc.root.Position);if delta.Magnitude<.2 then return goal end
	local forward=delta.Unit;local force=Vector3.zero
	for _, peer in records do
		if peer==npc or peer.deadAt or math.abs(peer.root.Position.Y-npc.root.Position.Y)>4 then continue end
		local away=flat(npc.root.Position-peer.root.Position);local distance=away.Magnitude
		if distance>=Config.AvoidanceRadius then continue end
		if distance<.01 then away=Vector3.new(if npc.serial<peer.serial then -1 else 1,0,0);distance=.01 end
		if distance<Config.Separation then force+=away.Unit*((Config.Separation-distance)/Config.Separation)*2 end
		local ahead=-away:Dot(forward)
		if ahead>0 and ahead<Config.AvoidanceRadius and (away+forward*ahead).Magnitude<Config.BodyDiameter then
			local side=if npc.serial%2==0 then 1 else -1
			force+=Vector3.new(-forward.Z,0,forward.X)*side*(1-distance/Config.AvoidanceRadius)
		end
	end
	local direction=forward+force
	-- The far side of a tower needs a route beside its solid base, not MoveTo
	-- through its center. Keep the detour outside the full horizontal footprint.
	local ray=RaycastParams.new();ray.FilterType=Enum.RaycastFilterType.Exclude
	ray.FilterDescendantsInstances={npc.model.Parent :: Instance};ray.RespectCanCollide=true;ray.CollisionGroup="SurvivalMinions"
	local hit=workspace:Blockcast(CFrame.new(npc.root.Position),Vector3.new(Config.BodyDiameter,4,Config.BodyDiameter),forward*math.min(delta.Magnitude,6),ray)
	if hit and hit.Instance:IsA("BasePart") then
		local obstacle=hit.Instance;local radial=flat(npc.root.Position-obstacle.Position)
		if radial.Magnitude>.1 then
			local toward=flat(goal-obstacle.Position)
			local cross=radial.X*toward.Z-radial.Z*toward.X
			local side=if math.abs(cross)>.1 then (if cross>0 then 1 else -1) else (if npc.serial%2==0 then 1 else -1)
			local clearance=Vector2.new(obstacle.Size.X,obstacle.Size.Z).Magnitude/2+Config.BodyDiameter/2+.4
			local tangent=Vector3.new(-radial.Unit.Z,0,radial.Unit.X)*side
			local around=obstacle.Position+radial.Unit*clearance+tangent*3
			direction=flat(around-npc.root.Position).Unit+force*.4
		end
	end
	return if direction.Magnitude>.1 then npc.root.Position+direction.Unit*math.min(delta.Magnitude,6) else npc.root.Position
end
local function move(npc: Minion, goal: Vector3, now: number)
	setMode(npc, "Moving")
	local displacement = (npc.root.Position - npc.lastPosition) * Vector3.new(1, 0, 1)
	if displacement.Magnitude >= Config.ProgressDistance then
		npc.lastPosition = npc.root.Position; npc.progressAt = now
	end
	local congestion=crowded(npc,Config.AvoidanceRadius)
	-- A stationary ally must not suppress recovery forever. Use a short, stable
	-- passing maneuver while retaining collisions and the lane objective.
	if congestion and now-npc.progressAt>=1.2 and now>=npc.passUntil then
		local delta=flat(goal-npc.root.Position)
		if delta.Magnitude>.1 then
			npc.passes+=1
			local side=if (npc.serial+npc.passes)%2==0 then 1 else -1
			npc.passGoal=npc.root.Position+Vector3.new(-delta.Unit.Z,0,delta.Unit.X)*side*Config.Separation+delta.Unit*2
			npc.passUntil=now+1;npc.progressAt=now
		end
	end
	if now - npc.progressAt >= Config.StuckTime and not congestion then
		npc.recoveries += 1; npc.progressAt = now
		if npc.recoveries > Config.MaxRecoveryAttempts then
			warn(string.format("[Minions] Despawn stuck %s lane=%s waypoint=%d", npc.model.Name, npc.lane, npc.waypoint))
			AI.Remove(npc.model); return
		end
		local delta = goal - npc.root.Position
		local side = Vector3.new(-delta.Z, 0, delta.X)
		if side.Magnitude > 0.01 then side = side.Unit else side = Vector3.zAxis end
		npc.recoveryGoal = npc.root.Position + side * Config.RecoveryOffset * (if npc.recoveries % 2 == 1 then 1 else -1)
		npc.recoveryUntil = now + 1
		warn(string.format("[Minions] Recovery %d/%d: %s %s", npc.recoveries, Config.MaxRecoveryAttempts, npc.model.Name, npc.lane))
	end
	local destination=if now<npc.passUntil and npc.passGoal then npc.passGoal
		elseif now < npc.recoveryUntil and npc.recoveryGoal then npc.recoveryGoal else goal
	npc.humanoid:MoveTo(steer(npc,destination))
end
-- Project onto the lane polyline. Between distant towers keep every bend;
-- a global assault objective must never turn into a shortcut through the jungle.
local function laneGoal(npc: Minion, objective: Vector3?): Vector3?
	local function project(position: Vector3): (number, number)
		local best=math.huge;local index=1;local fraction=0
		for i=1,#npc.route-1 do
			local a=npc.route[i];local delta=flat(npc.route[i+1]-a)
			local t=math.clamp(flat(position-a):Dot(delta)/delta:Dot(delta),0,1)
			local distance=flat(position-a-delta*t).Magnitude
			if distance<best then best=distance;index=i;fraction=t end
		end
		return index,fraction
	end
	local segment,t=project(npc.root.Position)
	if objective then
		local targetSegment=project(objective)
		if targetSegment<=segment then return nil end
	end
	local index=segment+1
	if t>.97 then index+=1 end
	if index>#npc.route then return nil end
	if npc.waypoint~=index then npc.waypoint=index;npc.recoveries=0;npc.model:SetAttribute("Waypoint",index) end
	local point=npc.route[index];local direction=flat(point-npc.route[index-1]).Unit
	return point+Vector3.new(-direction.Z,0,direction.X)*((npc.model:GetAttribute("LaneOffset") or 0) :: number)
end
function AI.Update(now: number)
	-- Corpse cleanup also runs after the match has stopped.
	local remove = {}
	for model, npc in records do
		if npc.deadAt and now - npc.deadAt >= Config.CorpseLifetime then table.insert(remove, model) end
	end
	for _, model in remove do AI.Remove(model) end
	if not running then return end
	rebuildGrid()
	for model, npc in records do
		if npc.deadAt or now - npc.spawnedAt < Config.SpawnGrace then continue end
		if npc.humanoid.Health <= 0 then dead(npc); continue end
		if npc.root.Position.Y < MapConfig.Origin.Y - 15 then AI.Remove(model); continue end
		local fighter = Fighters.Get(model)
		if not fighter or fighter.logic.mode == "Stunned" or (fighter.sleep and fighter.sleep.active) then
			npc.progressAt = now; npc.lastPosition = npc.root.Position; continue
		end
		if not Damage.CanAct(model) then continue end
		local target = selectTarget(npc)
		npc.target = target; model:SetAttribute("TargetName", if target then target.Name else "")
		local goal: Vector3? = nil
		if target then
			if target:GetAttribute("EntityKind")=="Tower" and target:GetAttribute("Lane")==npc.lane then npc.laneAssault=true end
			local targetRoot = target:FindFirstChild("HumanoidRootPart") :: BasePart
			local position=targetRoot.Position
			if target:GetAttribute("EntityKind")=="Tower" and target:GetAttribute("Lane")==npc.lane and flat(position-npc.root.Position).Magnitude>30 then
				local routeGoal=laneGoal(npc,position)
				if routeGoal then
					npc.combatTarget=nil;npc.combatOffset=nil
					move(npc,routeGoal,now);continue
				end
			end
			goal = combatGoal(npc,target,position)
			if (position - npc.root.Position).Magnitude <= npc.stats.AttackRange and visible(npc, target, position) and not crowded(npc) then
				setMode(npc, "Attacking"); npc.humanoid:MoveTo(npc.root.Position); npc.progressAt = now
				if now >= npc.nextAttack then
					npc.nextAttack = now + npc.stats.AttackCooldown
					-- Presentation timestamp only; the existing server damage/cooldown stays authoritative.
					model:SetAttribute("MinionAttackAt", now)
					local humanoid = target:FindFirstChildOfClass("Humanoid")
					if humanoid and Damage.ApplyAttack(model, humanoid, npc.stats.Damage) > 0 then
						AI.Shot:Fire(npc.root.Position, position, npc.kind, npc.teamId, target, model:GetAttribute("RoundId"))
					end
				end
				continue
			end
			if goal and flat(goal-npc.root.Position).Magnitude<.8 and (position-npc.root.Position).Magnitude>npc.stats.AttackRange then
				-- An occupied melee front has a real waiting position. Arrival is
				-- progress, not a stuck MoveTo that should eventually delete the unit.
				setMode(npc,"Waiting");npc.humanoid:MoveTo(npc.root.Position);npc.progressAt=now
				npc.passUntil=0;npc.recoveryUntil=0;continue
			end
		else
			npc.combatTarget=nil;npc.combatOffset=nil
			goal = laneGoal(npc,nil) or baseGoal(npc)
		end
		if goal then move(npc, goal, now)
		else npc.humanoid:MoveTo(npc.root.Position);npc.progressAt=now end
	end
end
return AI
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="239">
          <Properties>
            <string name="Name">MinionAppearance</string>
            <string name="Source"><![CDATA[--!strict
-- Original primitive silhouettes; cosmetic parts never participate in combat queries/physics.
local Appearance = {}
function Appearance.Apply(model: Model, kind: string, teamId: string)
	local zetsu = teamId == "Red"
	model:SetAttribute("MinionVisual", if zetsu then "WhiteZetsu" else "Alliance")
	local torso = model:FindFirstChild("Torso") :: BasePart
	local head = model:FindFirstChild("Head") :: BasePart
	local leftArm = model:FindFirstChild("Left Arm") :: BasePart
	local rightArm = model:FindFirstChild("Right Arm") :: BasePart
	local pale = Color3.fromRGB(224, 233, 208)
	local cloth = Color3.fromRGB(39, 49, 65)
	local green = Color3.fromRGB(88, 111, 77)
	local dark = Color3.fromRGB(39, 65, 48)
	local steel = Color3.fromRGB(152, 165, 174)
	local folder = Instance.new("Folder"); folder.Name = "MinionCosmetics"; folder.Parent = model
	local function detail(name: string, parent: BasePart, size: Vector3, offset: CFrame, color: Color3, shape: Enum.PartType?): Part
		local part = Instance.new("Part"); part.Name = name; part.Size = size; part.Color = color
		part.Material = Enum.Material.SmoothPlastic; part.Shape = shape or Enum.PartType.Block
		part.TopSurface = Enum.SurfaceType.Smooth; part.BottomSurface = Enum.SurfaceType.Smooth
		part.CanCollide = false; part.CanTouch = false; part.CanQuery = false; part.Massless = true
		part.CastShadow = false; part.CFrame = parent.CFrame * offset; part.Parent = folder
		local weld = Instance.new("WeldConstraint"); weld.Part0 = parent; weld.Part1 = part; weld.Parent = part
		return part
	end
	for _, item in model:GetChildren() do
		if item:IsA("BasePart") and item.Name ~= "HumanoidRootPart" then item.Color = if zetsu then pale else cloth end
	end
	head.Color = if zetsu then pale else Color3.fromRGB(218, 177, 141)
	if zetsu then
		-- Split organic face, leaf collar and a spine distinguish these from uniformed shinobi.
		detail("FaceGrowth", head, Vector3.new(.55, .95, .14), CFrame.new(-.5, 0, -.52), Color3.fromRGB(163, 187, 139))
		for _, side in { -1, 1 } do
			detail("LeafCollar", torso, Vector3.new(.55, 1.8, 1.4), CFrame.new(side * 1.05, .75, .25) * CFrame.Angles(0, 0, -side * .4), dark, Enum.PartType.Ball)
			detail("RootVein", torso, Vector3.new(.12, 1.6, .12), CFrame.new(side * .5, -.05, -.55) * CFrame.Angles(0, 0, side * .25), green)
			detail("Eye", head, Vector3.new(.19, .12, .09), CFrame.new(side * .37, .12, -.56), Color3.fromRGB(78, 93, 42))
		end
		detail("Spine", torso, Vector3.new(.35, 1.85, .35), CFrame.new(0, 0, .63), green)
		if kind == "Ranged" then
			detail("SeedPod", torso, Vector3.new(1.3, 1.3, .8), CFrame.new(0, .2, .95), dark, Enum.PartType.Ball)
			detail("SeedArm", rightArm, Vector3.new(1.14, 1.25, 1.14), CFrame.new(0, -.3, 0), green, Enum.PartType.Ball)
		else
			for _, arm in { leftArm, rightArm } do
				detail("RootBlade", arm, Vector3.new(.2, 1.5, .35), CFrame.new(0, -.65, -.65) * CFrame.Angles(-.3, 0, 0), dark)
			end
		end
	else
		detail("FlakVest", torso, Vector3.new(2.12, 1.65, 1.15), CFrame.new(0, .12, 0), green)
		detail("VestSeam", torso, Vector3.new(.1, 1.5, .09), CFrame.new(0, .1, -.62), dark)
		for _, side in { -1, 1 } do
			detail("VestPouch", torso, Vector3.new(.65, .55, .22), CFrame.new(side * .53, -.22, -.66), Color3.fromRGB(116, 133, 92))
			detail("Eye", head, Vector3.new(.17, .09, .08), CFrame.new(side * .36, .03, -.54), cloth)
			local leg = model:FindFirstChild((if side == -1 then "Left" else "Right") .. " Leg") :: BasePart
			detail("ShinWrap", leg, Vector3.new(1.04, .6, 1.04), CFrame.new(0, -.35, 0), Color3.fromRGB(179, 184, 165))
		end
		detail("ForeheadCloth", head, Vector3.new(2.03, .32, 1.03), CFrame.new(0, .27, 0), cloth)
		detail("AlliancePlate", head, Vector3.new(1.05, .27, .1), CFrame.new(0, .27, -.57), steel)
		-- A simple original linked-bars insignia, rather than an external decal asset.
		detail("AllianceMark", head, Vector3.new(.38, .07, .03), CFrame.new(0, .27, -.635) * CFrame.Angles(0, 0, .35), dark)
		detail("Belt", torso, Vector3.new(2.08, .23, 1.1), CFrame.new(0, -.82, 0), dark)
		if kind == "Ranged" then
			detail("Scroll", torso, Vector3.new(.65, 1.8, .65), CFrame.new(0, 0, .95) * CFrame.Angles(0, 0, .5), Color3.fromRGB(200, 183, 136), Enum.PartType.Cylinder)
			detail("SealCuff", rightArm, Vector3.new(1.08, .55, 1.08), CFrame.new(0, -.5, 0), steel)
		else
			detail("KunaiHandle", rightArm, Vector3.new(.16, .6, .16), CFrame.new(0, -1.1, -.4), dark)
			detail("KunaiBlade", rightArm, Vector3.new(.24, .65, .1), CFrame.new(0, -1.7, -.4), steel)
		end
	end
end
return Appearance
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="240">
          <Properties>
            <string name="Name">MinionFactory</string>
            <string name="Source"><![CDATA[--!strict
local Physics = game:GetService("PhysicsService")
local Config = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared").Config.MinionConfig)
local Appearance = require(script.Parent.MinionAppearance)
local Factory = {}
local registered = false
function Factory.Create(kind: string, teamId: string, color: Color3, position: Vector3, stats: Config.Stats): Model
	if not registered then
		if not Physics:IsCollisionGroupRegistered("SurvivalMinions") then Physics:RegisterCollisionGroup("SurvivalMinions") end
		Physics:CollisionGroupSetCollidable("SurvivalMinions", "SurvivalMinions", true)
		registered = true
	end
	local model = Instance.new("Model"); model.Name = teamId .. kind
	model:SetAttribute("TeamId", teamId); model:SetAttribute("EntityKind", "Minion"); model:SetAttribute("MinionType", kind)
	local function part(name: string, size: Vector3, offset: Vector3, visible: boolean): Part
		local item = Instance.new("Part"); item.Name = name; item.Size = size; item.Position = position + offset
		item.Color = color; item.Material = Enum.Material.SmoothPlastic
		item.TopSurface = Enum.SurfaceType.Smooth; item.BottomSurface = Enum.SurfaceType.Smooth
		item.CollisionGroup = "SurvivalMinions"; item.CanCollide = name == "Torso"; item.CanTouch = false
		item.Transparency = if visible then 0 else 1; item.Parent = model
		return item
	end
	local root = part("HumanoidRootPart", Vector3.new(2, 2, 1), Vector3.zero, false)
	local torso = part("Torso", Vector3.new(2, 2, 1), Vector3.zero, true)
	local head = part("Head", Vector3.new(2, 1, 1), Vector3.new(0, 1.5, 0), true)
	head.Color = if kind == "Ranged" then Color3.fromRGB(255, 217, 105) else color:Lerp(Color3.new(1, 1, 1), 0.3)
	local function joint(name: string, parent: BasePart, child: BasePart, offset: Vector3): Motor6D
		local motor = Instance.new("Motor6D"); motor.Name = name; motor.Part0 = parent; motor.Part1 = child
		motor.C0 = CFrame.new(offset); motor.Parent = parent
		return motor
	end
	joint("RootJoint", root, torso, Vector3.zero); joint("Neck", torso, head, Vector3.new(0, 1.5, 0))
	-- Rotation-independent body clearance; limbs/cosmetics do not snag each other.
	local body=part("CrowdBody",Vector3.new(4.5,Config.BodyDiameter,Config.BodyDiameter),Vector3.zero,false)
	body.Shape=Enum.PartType.Cylinder;body.CFrame=root.CFrame*CFrame.Angles(0,0,math.pi/2)
	body.CanCollide=true;body.CanQuery=false;body.Massless=true
	body.CustomPhysicalProperties=PhysicalProperties.new(.7,0,0,100,100)
	local bodyWeld=Instance.new("WeldConstraint");bodyWeld.Part0=root;bodyWeld.Part1=body;bodyWeld.Parent=body
	for _, side in { -1, 1 } do
		local label = if side == -1 then "Left" else "Right"
		local arm = part(label .. " Arm", Vector3.new(1, 2, 1), Vector3.new(side * 1.5, 0, 0), true)
		local leg = part(label .. " Leg", Vector3.new(1, 2, 1), Vector3.new(side * 0.5, -2, 0), true)
		-- Rotate around shoulders/hips while preserving all original part positions and sizes.
		local shoulder = joint(label .. " Shoulder", torso, arm, Vector3.new(side * 1.5, .75, 0))
		shoulder.C1 = CFrame.new(0, .75, 0)
		local hip = joint(label .. " Hip", torso, leg, Vector3.new(side * 0.5, -1, 0))
		hip.C1 = CFrame.new(0, 1, 0)
	end
	local humanoid = Instance.new("Humanoid"); humanoid.MaxHealth = stats.MaxHealth; humanoid.Health = stats.MaxHealth
	-- Prevent two walking rigs from using one another as ladders.
	humanoid:SetStateEnabled(Enum.HumanoidStateType.Climbing, false)
	humanoid.AutoJumpEnabled = false
	humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping,false);humanoid.JumpPower=0;humanoid.JumpHeight=0
	humanoid.WalkSpeed = stats.WalkSpeed; humanoid.BreakJointsOnDeath = false; humanoid.DisplayName = teamId .. " " .. kind
	humanoid.HealthDisplayDistance = 45; humanoid.NameDisplayDistance = 30; humanoid.Parent = model
	model.PrimaryPart = root
	Appearance.Apply(model, kind, teamId)
	return model
end
return Factory
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="241">
          <Properties>
            <string name="Name">MinionSpawnerService</string>
            <string name="Source"><![CDATA[--!strict
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config.MinionConfig)
local MapConfig = require(Shared.Config.MapConfig)
local Mode = require(Shared.Config.GameModeConfig)
local AI = require(script.Parent.MinionAIService)
local Factory = require(script.Parent.MinionFactory)
local Teams = require(script.Parent.TeamService)
local Builder = require(script.Parent.MapBuilder)
local Spawner = {}
local map: Folder? = nil
local container: Folder? = nil
function Spawner.Start(arena: Folder)
	if container then return end
	map = arena
	local existing = workspace:FindFirstChild("NPCs")
	assert(not existing or existing:IsA("Folder"), "Workspace.NPCs must be a Folder")
	local root = (existing or Instance.new("Folder")) :: Folder; root.Name = "NPCs"; root.Parent = workspace
	local owned = root:FindFirstChild("SurvivalMinions")
	assert(not owned, "SurvivalMinions container already exists")
	local created = Instance.new("Folder"); created.Name = "SurvivalMinions"; created.Parent = root; container = created
end
function Spawner.Spawn(teamId: string, lane: string, kind: string, slot: number): Model?
	local arena, parent = map, container
	if not arena or not parent or not Teams.IsActive(teamId) or AI.GetCount() >= Config.MaxActiveNPCs then return nil end
	local state = Teams.GetState(); if not state or state.phase ~= "InProgress" then return nil end
	local types: { [string]: Config.Stats } = Config.Types
	local stats = types[kind]; assert(stats, "Unknown minion type")
	local settings = MapConfig.Teams :: { [string]: { Base: Vector3, Hero: Vector3, Reverse: boolean } }
	local layout = settings[teamId]; assert(layout, "Missing route direction")
	local route = Builder.Route(arena, lane, layout.Reverse)
	local points = arena:FindFirstChild("SpawnPoints"); assert(points)
	local teamPoints = points:FindFirstChild(teamId); assert(teamPoints)
	local marker = teamPoints:FindFirstChild(lane)
	assert(marker and marker:IsA("BasePart"), "Minion spawn missing")
	local color = Color3.new(1, 1, 1)
	for _, definition in Mode.Teams do if definition.Id == teamId then color = definition.Color end end
	local direction=(route[2]-route[1])*Vector3.new(1,0,1)
	local lateral=Vector3.new(-direction.Z,0,direction.X).Unit
	local offset=((slot-1)%3-1)*Config.SpawnSpacing
	local position = marker.Position + lateral*offset - direction.Unit*math.floor((slot-1)/3)*Config.SpawnSpacing
	local model = Factory.Create(kind, teamId, color, position, stats); model.Parent = parent
	model:SetAttribute("LaneOffset",offset)
	AI.Register(model, teamId, kind, lane, route, stats)
	return model
end
function Spawner.Wave(number: number)
	local ids = Teams.GetActiveTeams()
	-- Rotate team ordering when the shared cap leaves only a partial wave.
	for slot, kind in Config.WaveComposition do
		for _, lane in MapConfig.LaneOrder do
			for offset = 1, #ids do
				local index = ((offset + number - 2) % #ids) + 1
				Spawner.Spawn(ids[index], lane, kind, slot)
			end
		end
	end
end
return Spawner
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="242">
          <Properties>
            <string name="Name">NarutoAbilityService</string>
            <string name="Source"><![CDATA[--!strict
-- Application layer for source-derived base melee variants. Domain modules own timers/rules;
-- Roblox services own entities, input admission, resource transactions and world effects.
local Players = game:GetService("Players")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Definitions = require(Shared.Abilities.NarutoDefinitions)
local Units = require(Shared.Abilities.WorldUnits)
local Rasengan = require(Shared.Abilities.RasenganState)
local Q = Rasengan.configure(Definitions.Rasengan)
local Variants=require(Shared.Abilities.RasenganVariants)
local Sleep=require(script.Parent.NarutoSleepService)
local Shuriken=require(script.Parent.RasenshurikenMeleeService)
local Thrown=require(script.Parent.RasenshurikenThrowService)
local ThrowRules=require(Shared.Abilities.RasenshurikenThrowRules)
local CloneState = require(Shared.Abilities.CloneState)
local W = CloneState.configure(Definitions.Clones)
local Commands = require(Shared.Abilities.CloneCommands)
local Resource = require(Shared.Abilities.NarutoResources)
local AttributeConfig = require(Shared.Config.AttributeConfig)
local ResourceRules = Resource.configure(Definitions.Hero, AttributeConfig.Mana)
local Sasuke=require(Shared.Abilities.SasukeDefinitions)
local SasukeResources=Resource.configure(Sasuke.Hero,AttributeConfig.Mana)

local Fighters = require(script.Parent.FighterStateService)
local Combat = require(script.Parent.CombatService)
local Hitboxes = require(script.Parent.HitboxService)
local Damage = require(script.Parent.DamageService)
local Stats = require(script.Parent.CharacterStatsService)
local Progression = require(script.Parent.HeroProgressionService)
local Teams = require(script.Parent.TeamService)
local Summons = require(script.Parent.NarutoSummonService)
local Displacement = require(script.Parent.AbilityDisplacementService)
local RankPolicy=require(Shared.Abilities.NarutoRankPolicy)
local ClonePlan=require(Shared.Abilities.CloneCastPlan)
local Sage=require(Shared.Abilities.SageState)
local Meditation=require(Shared.Abilities.MeditationState)
local MeditationClones=require(script.Parent.MeditationCloneService)
local GamaDomain=require(Shared.Abilities.GamakichiState)
local Gama=require(script.Parent.GamakichiService)
local Kcm=require(script.Parent.NarutoKcmService)
local Kurama=require(script.Parent.NarutoKuramaService)
local Ranged=require(script.Parent.NarutoRangedService)
type Session = { variants: Variants.State, shurikenSnapshot: number, meditation: Meditation.State, meditationMode: boolean, meditationRecallAt: number, sage: Sage.State, gama: GamaDomain.State, q: Rasengan.State, clones: CloneState.State, commands: Commands.State, pool: Resource.Pool,
	sageTechniquesReady: boolean, character: Model?, target: Model?, life: number, selfStun: boolean, selfControlUntil: number,
	preparationStunned: boolean, nextPublish: number, connections: { RBXScriptConnection } }
local Service = { Visual = Instance.new("BindableEvent") }
local sessions: { [Player]: Session } = {}
local started = false
-- KCM worker injects its authoritative current form, without dependency cycles.
-- Called at clone creation; existing clones retain their original profile on morph.
local meditationForm: (Player)->Meditation.Form = function(_player) return "Ordinary" end
function Service.ConfigureMeditationForms(provider: (Player)->Meditation.Form) meditationForm=provider end
local function roundId(): number local match = Teams.GetState(); return if match then match.roundId else 0 end
local function values(player: Player): Resource.Values
	local character = player.Character
	local bonus = if character then character:GetAttribute("StrengthBonus") else nil
	local rules=if player:GetAttribute("HeroId")=="Sasuke" then SasukeResources else ResourceRules
	return rules.values(Stats.Get(player).Level, if typeof(bonus) == "number" and bonus == bonus and math.abs(bonus) < math.huge then bonus else 0)
end
function Service.GetStats(player: Player): (number, number) return Stats.Get(player).Level, values(player).strength end
function Service.Get(player: Player): Session? return sessions[player] end
function Service.IsAbility(id: string): boolean return id=="MeditationCast" or id=="RasenshurikenThrow" or Ranged.IsAbility(id) or Kcm.IsAbility(id) or id == "MeditationToggle" or id == "MeditationRecall" or id == "ShadowSleep" or id == "Odama" or id == "Rasenshuriken" or id == "SageMode" or id == "GamakichiOil" or id == "GamakichiChop" or id == "Gamakichi" or id == "Rasengan" or id == "ShadowClones" or id == "CloneCommand" end
function Service.Ready(player: Player): { [string]: number }
	local session = sessions[player]; local toad=Gama.Get(player); local ranged=Ranged.Ready(player)
	return if session then { RikudoHY=ranged.RikudoHY or 0, RikudoHZ=ranged.RikudoHZ or 0, KuramaForm=if player.Character then (player.Character:GetAttribute("Ready_KuramaForm") or 0) :: number else 0, KCM=if player.Character then (player.Character:GetAttribute("Ready_KCM") or 0) :: number else 0, KcmDash=if player.Character then (player.Character:GetAttribute("Ready_KcmDash") or 0) :: number else 0, MeditationRecall=session.meditationRecallAt, Odama=session.variants.cooldowns.Odama or 0, Rasenshuriken=session.variants.cooldowns.Rasenshuriken or 0, SageMode=session.sage.cooldownAt, Rasengan = session.q.cooldownAt, ShadowClones = session.clones.cooldownAt, Gamakichi=session.gama.cooldownAt, GamakichiOil=if toad then toad.spells.oilReady else 0, GamakichiChop=if toad then toad.spells.chopReady else 0 } else {}
end
local function publish(player: Player, session: Session, now: number)
	local model = session.character; if not model or model ~= player.Character then return end
	local cast = session.q.active
	model:SetAttribute("SummonOrder", Commands.resolve(session.commands).mode)
	local sage=session.sage.active
 model:SetAttribute("MeditationMode",session.meditationMode)
 model:SetAttribute("Ready_MeditationRecall",session.meditationRecallAt)
 local meditationCount=0; for _ in session.meditation.clones do meditationCount+=1 end
 model:SetAttribute("MeditationCloneCount",meditationCount)
 model:SetAttribute("SageHealthProvisional",sage~=nil and sage.rank==3)
 model:SetAttribute("RasenganVariant",if cast then cast.variant else "")
 model:SetAttribute("RasenganVariantUntil",if cast and cast.variant=="Rasengan" then cast.expiresAt elseif cast and cast.variant=="Odama" then cast.startedAt+1 else 0)
 model:SetAttribute("Ready_Odama",session.variants.cooldowns.Odama or 0)
 model:SetAttribute("Ready_Rasenshuriken",session.variants.cooldowns.Rasenshuriken or 0)
 model:SetAttribute("Ready_SageMode",session.sage.cooldownAt)
 model:SetAttribute("SagePhase",if sage then sage.phase else "")
 model:SetAttribute("SageTechniquesReady",session.sageTechniquesReady)
 model:SetAttribute("SageRank",if sage then sage.rank else 0)
 model:SetAttribute("SageReadyAt",if sage then sage.readyAt else 0)
 model:SetAttribute("SageExpiresAt",if sage then sage.expiresAt else 0)
 model:SetAttribute("SageAuraUntil",if sage then sage.auraUntil else 0)
 if sage then game:GetService("CollectionService"):AddTag(model,"NarutoSage") else game:GetService("CollectionService"):RemoveTag(model,"NarutoSage") end
 model:SetAttribute("Ready_Gamakichi",session.gama.cooldownAt)
	model:SetAttribute("GamakichiCount",if Gama.Get(player) then 1 else 0)
	model:SetAttribute("Mana", session.pool.mana); model:SetAttribute("MaxMana", session.pool.maximum)
	model:SetAttribute("Strength", values(player).strength); model:SetAttribute("NativeStatsProvisional", true)
	model:SetAttribute("Ready_Rasengan", session.q.cooldownAt); model:SetAttribute("Ready_ShadowClones", session.clones.cooldownAt)
	model:SetAttribute("RasenganPhase", if cast then cast.phase else "")
	model:SetAttribute("RasenganHeld", Q.hasMarker(session.q, now))
	model:SetAttribute("RasenganVisible", Q.hasMarker(session.q, now) and cast ~= nil and now >= cast.startedAt + Definitions.Rasengan.HandEffectDelay)
	model:SetAttribute("RasenganStartedAt", if cast then cast.startedAt else 0)
	model:SetAttribute("RasenganReadyAt", if cast then cast.readyAt else 0)
	model:SetAttribute("RasenganImpactAt", if cast then cast.impactAt or 0 else 0)
	model:SetAttribute("RasenganSelfPauseUntil", session.selfControlUntil)
	model:SetAttribute("RasenganExpiresAt", if cast then cast.expiresAt else 0)
	model:SetAttribute("NarutoCastId", session.q.serial)
	local cloneCount = 0; for _ in session.clones.clones do cloneCount += 1 end
	model:SetAttribute("NativeCloneCount", cloneCount)
	model:SetAttribute("NarutoPausedUntil", session.selfControlUntil)
	if model:GetAttribute("NativePose") == true then
		local ends = model:GetAttribute("AbilityEndsAt")
		if not cast or typeof(ends) ~= "number" or now >= ends then
			model:SetAttribute("NativePose", nil); model:SetAttribute("AbilityId", "")
		end
	end
	session.nextPublish = now + 0.1
end
local function cancelQ(player: Player, session: Session, now: number)
	Variants.cancel(session.variants); Rasengan.cancel(session.q); session.target = nil; session.selfControlUntil = 0; publish(player, session, now)
end
local function selfStun(session: Session, fighter: Fighters.Fighter, now: number, duration: number)
	session.selfControlUntil = now + duration; session.selfStun = true
	Fighters.StunSpell(fighter, duration)
	session.selfStun = false
end
local function clearSage(session: Session)
 Sage.cancel(session.sage)
 session.sageTechniquesReady=false
 local model=session.character
 if model then
  Stats.SetLayer(model,"NarutoSage",nil)
  game:GetService("CollectionService"):RemoveTag(model,"NarutoSage")
  for _,key in {"SagePhase","SageRank","SageReadyAt","SageExpiresAt","SageAuraUntil"} do model:SetAttribute(key,nil) end
 end
end
local function invalidate(player: Player, session: Session)
 Ranged.Invalidate(player)
 MeditationClones.ClearOwner(player)
 Meditation.invalidate(session.meditation,roundId(),session.life+1)
 Variants.cancel(session.variants)
 clearSage(session)
	Gama.Remove(player); GamaDomain.cancel(session.gama)
	session.life += 1; Sage.newLife(session.sage,roundId(),session.life); Rasengan.newLife(session.q, session.life); CloneState.newLife(session.clones, session.life)
	Commands.suspend(session.commands); session.target = nil; session.selfControlUntil = 0
	publish(player, session, workspace:GetServerTimeNow())
end
local function bind(player: Player): Session
	local existing = sessions[player]; if existing then return existing end
	local now, owner = workspace:GetServerTimeNow(), tostring(player.UserId)
	local session: Session = { variants=Variants.new(), shurikenSnapshot=0, meditation=Meditation.new(owner,roundId(),0), meditationMode=false, meditationRecallAt=0, sage=Sage.new(owner,roundId(),0), gama=GamaDomain.new(), q = Rasengan.new(owner, roundId(), 0), clones = CloneState.new(owner, roundId(), 0),
		sageTechniquesReady=false, commands = Commands.new(owner, roundId(), 0), pool = Resource.new(values(player), now), character = nil, target = nil,
		life = 0, selfStun = false, selfControlUntil = 0, preparationStunned = false, nextPublish = 0, connections = {} }
	sessions[player] = session
	local function added(model: Model)
		invalidate(player, session); session.character = model; session.preparationStunned = false
		session.pool = Resource.new(values(player), workspace:GetServerTimeNow())
		Commands.newLife(session.commands, roundId(), session.life)
		publish(player, session, workspace:GetServerTimeNow())
	end
	session.connections = {
		player.CharacterAdded:Connect(added),
		player.CharacterRemoving:Connect(function(model)
			if session.character == model then invalidate(player, session); session.character = nil end
		end),
	}
	if player.Character then added(player.Character) end
	return session
end
function Service.TryCast(player: Player, id: string, requestId: number, now: number, targetValue: any): (boolean, string)
	if id=="ShadowSleep" then return false,"Unsupported" end
	local session = bind(player); local model = player.Character
	local fighter = if model then Fighters.GetOrCreate(model) else nil
 local meditationCast=id=="MeditationCast"
 if meditationCast then id="SageMode" end

	if not model or not fighter then return false, "Unavailable" end
	if fighter.sleep and fighter.sleep.active then return false, "Busy" end
	Resource.recalculate(session.pool, values(player), now)
	if Ranged.IsAbility(id) then return Ranged.TryCast(player,id,requestId,now,targetValue) end
	if Kcm.IsAbility(id) then return Kcm.TryCast(player,id,requestId,now,targetValue) end
	if Kcm.Blocked(model,id) then return false,"Form" end
 if id=="MeditationToggle" or id=="MeditationRecall" then
  if targetValue~=nil then return false,"Malformed" end
  if fighter.logic.mode~="Idle" or session.selfControlUntil>now then return false,"Busy" end
  if id=="MeditationToggle" then
   session.meditationMode=not session.meditationMode
  else
   if now<session.meditationRecallAt then return false,"Cooldown" end
   if next(session.meditation.clones)==nil then return false,"Unavailable" end
   session.meditationRecallAt=now+Meditation.Policy.RecallCooldown
   MeditationClones.Recall(player,now)
  end
  publish(player,session,now); return true,"Accepted"
 end
	if id=="GamakichiOil" or id=="GamakichiChop" then return Gama.TrySpell(player,id,requestId,now,targetValue) end
	if id == "CloneCommand" then
		if typeof(targetValue) == "string" then
			local accepted, reason = Commands.order(session.commands, tostring(player.UserId), roundId(), session.life, requestId, targetValue)
			if accepted then publish(player, session, now) end
			return accepted, reason
		end
		if typeof(targetValue) ~= "Instance" then return false, "Target" end
		local instance = targetValue :: Instance
		if not instance:IsA("Model") then return false, "Target" end
		local target = instance :: Model; local root = target:FindFirstChild("HumanoidRootPart")
		local valid = root ~= nil and root:IsA("BasePart") and Damage.CanDamage(model, target)
			and (root.Position - fighter.root.Position).Magnitude <= Units.toStuds(Definitions.Clones.RangeWarcraft)
		if not valid or not Fighters.Get(target) then return false, "Target" end
		local accepted, reason = Commands.command(session.commands, tostring(player.UserId), roundId(), session.life, requestId, Summons.EntityId(target), true)
		if accepted then publish(player, session, now) end
		return accepted, reason
	end
	if (fighter.sleep and fighter.sleep.active) or fighter.logic.mode ~= "Idle" or fighter.logic.nextAttackAt > now or session.selfControlUntil > now
		or (model:GetAttribute("AbilityId") ~= nil and model:GetAttribute("AbilityId") ~= "") then return false, "Busy" end
	if id=="RasenshurikenThrow" then
        local cast=session.q.active;local sage=session.sage.active;local profile=Progression.Get(player)
        if typeof(targetValue)~="Vector3" then return false,"Malformed" end
        if not cast or not ThrowRules.allowed(if profile then profile.Learned.Rasengan or 0 else 0,session.sageTechniquesReady and sage~=nil and sage.phase=="Active" and now<sage.expiresAt,cast.variant,cast.phase,now,cast.readyAt,cast.expiresAt) then return false,"Unavailable" end
        local life,epoch=session.life,roundId()
        local ok=Thrown.Begin(model,targetValue,now,function() return values(player).strength end,function()
            return player.Character==model and session.life==life and roundId()==epoch and Damage.CanAct(model)
        end)
        if not ok then return false,"Target" end
        model:SetAttribute("RasenshurikenThrowAt",now)
        cancelQ(player,session,now)
        return true,"Accepted"
    elseif id=="Odama" or id=="Rasenshuriken" then
        if targetValue~=nil then return false,"Malformed" end
        local sage=session.sage.active
        if meditationForm(player)~="Ordinary" or (sage~=nil and sage.phase~="Active") then return false,"FormAdapterUnverified" end
        local cast=session.q.active; if not cast or cast.phase=="Consumed" then return false,"Window" end
        local profile=Progression.Get(player)
        local rank=if profile then profile.Learned.Rasengan or 0 else 0
        local choice,reason,debit=Variants.select(session.variants,id,rank,cast.startedAt,now,session.pool.mana,cast.variant=="Rasengan")
        if not choice then return false,reason end
        assert(Resource.spend(session.pool,debit))
        cast.variant=id; cast.phase="Preparing"; cast.startedAt=now; cast.readyAt=choice.readyAt; cast.expiresAt=choice.expiresAt
        cast.stun=Variants.stun(id); cast.impactDelay=if id=="Rasenshuriken" then .5 else 1
        session.preparationStunned=false
        if id=="Rasenshuriken" then session.shurikenSnapshot=values(player).strength; selfStun(session,fighter,now,1.5) end
        publish(player,session,now); return true,"Accepted"
    elseif id=="SageMode" then
        if targetValue~=nil then return false,"Malformed" end
        if session.q.active then return false,"Busy" end
        local profile=Progression.Get(player)
        local sage,reason,debit=Sage.request(session.sage,now,requestId,if profile then profile.Learned.SageMode or 0 else 0,Stats.Get(player).Level,session.pool.mana,meditationCast or session.meditationMode)
        if not sage then return false,reason end
        assert(Resource.spend(session.pool,debit))
        selfStun(session,fighter,now,sage.readyAt-now)
        publish(player,session,now); return true,"Accepted"
    elseif id == "Gamakichi" then
        if targetValue~=nil then return false,"Malformed" end
        local profile=Progression.Get(player)
        local cast,reason,debit=GamaDomain.request(session.gama,now,requestId,if profile then profile.Learned.Gamakichi or 0 else 0,session.pool.mana)
        if not cast then return false,reason end
        assert(Resource.spend(session.pool,debit))
        Gama.Spawn(player,model,session.gama,cast,session.commands)
        publish(player,session,now); return true,"Accepted"
    elseif id == "Rasengan" then
        if Stats.Get(player).Level < Definitions.Rasengan.RequiredLevel then return false, "Level" end
		if targetValue ~= nil then return false, "Malformed" end
		local cast, reason, debit = Q.request(session.q, now, requestId, session.pool.mana, true)
		if not cast then return false, reason end
		cast.sagePrepared=session.sageTechniquesReady and meditationForm(player)=="Ordinary"
		Variants.cancel(session.variants)
		assert(Resource.spend(session.pool, debit), "Q debit must commit without yielding")
		session.preparationStunned = false
		publish(player, session, now); return true, "Accepted"
	elseif id == "ShadowClones" then
        local profile=Progression.Get(player)
        local rank=if profile then profile.Learned.ShadowClones or 0 else 0
        if session.pool.mana<200 then return false,"Mana" end
        local variant="OrdinarySelf"
        -- Canon-first Naruto kit: the Warcraft enemy-target sleep branch is retired.
        if typeof(targetValue)=="Instance" then return false,"Target"
        elseif targetValue~=nil then
            if typeof(targetValue)~="Vector3" or not Hitboxes.IsFiniteCFrame(CFrame.new(targetValue)) then return false,"Target" end
            if (targetValue-fighter.root.Position).Magnitude>Units.toStuds(2000) then return false,"Target" end
            variant="OrdinaryPoint"
        end
        local plan,planReason=RankPolicy.ordinaryClonePlan(rank,variant)
        if not plan then return false,planReason end
        local resourcePlan=ClonePlan.create(rank,if variant=="OrdinarySelf" then "Self" else "Point",session.pool.mana,session.pool.maximum,meditationForm(player)=="Kurama")
        if not resourcePlan then return false,"Mana" end
        plan.count=resourcePlan.count
        local extra=resourcePlan.extraManaDrain
        if session.pool.mana<plan.manaCost then return false,"Mana" end
		local burst, reason = W.begin(session.clones, now, requestId, plan.count, plan.cooldown)
		if not burst then return false, reason end
		assert(Resource.spend(session.pool, plan.manaCost+extra), "W debit must commit without yielding")
		model:SetAttribute("NativePose", true); model:SetAttribute("AbilityId", "ShadowClones")
		model:SetAttribute("AbilityStartedAt", now); model:SetAttribute("AbilityEndsAt", now + 0.25)
		publish(player, session, now); return true, "Accepted"
	end
	return false, "Unsupported"
end
function Service.Reset()
	Ranged.Reset(); Kcm.Reset()
	Sleep.Reset(); Shuriken.Reset(); Thrown.Reset(); Summons.Reset(); Gama.Reset(); Displacement.Reset(); MeditationClones.Reset()
	for player, session in sessions do
		Meditation.invalidate(session.meditation,roundId(),session.life+1); session.meditationMode=false; session.meditationRecallAt=0
		session.variants=Variants.new(); clearSage(session); Sage.reset(session.sage,roundId(),session.life+1); session.gama=GamaDomain.new()
		session.life += 1; Rasengan.reset(session.q, roundId(), session.life); CloneState.reset(session.clones, roundId(), session.life)
		Commands.newLife(session.commands, roundId(), session.life); session.target = nil; session.selfControlUntil = 0
		session.pool = Resource.new(values(player), workspace:GetServerTimeNow()); publish(player, session, workspace:GetServerTimeNow())
	end
end
function Service.Update(now: number)
	Kcm.Update()
	for player, session in sessions do
		Resource.recalculate(session.pool, values(player), now)
		local model = session.character; local fighter = if model then Fighters.Get(model) else nil
		if model and fighter then
			if not Damage.CanAct(model) or fighter.logic.mode == "Dead" then
				if session.sage.active or next(session.meditation.clones) or session.q.active or session.clones.burst or session.commands.active then invalidate(player, session) end
			else
                local preparing=session.sage.active
                if preparing and preparing.meditation and not preparing.clonesSpawned and now>=preparing.cloneSpawnAt and now<preparing.readyAt then
                    preparing.clonesSpawned=true
                    local ownerCharacter=model; local life=session.life; local epoch=roundId()
                    local clones=Meditation.spawn(session.meditation,now,preparing.rank,Stats.Get(player).Level,meditationForm(player))
                    MeditationClones.Spawn(player,model,session.meditation,clones,function()
                        local humanoid=ownerCharacter:FindFirstChildOfClass("Humanoid")
                        return sessions[player]==session and player.Parent==Players and player.Character==ownerCharacter and session.life==life and roundId()==epoch and humanoid~=nil and humanoid.Health>0 and Damage.CanAct(ownerCharacter)
                    end,function(amount: number)
                        Resource.recalculate(session.pool,values(player),workspace:GetServerTimeNow())
                        session.pool.mana=math.min(session.pool.maximum,session.pool.mana+amount)
                    end)
                end
				if Sage.expire(session.sage,now) then
                    if not Kcm.IsRikudo(player) then session.sageTechniquesReady=false end
                    Stats.SetLayer(model,"NarutoSage",nil)
                    game:GetService("CollectionService"):RemoveTag(model,"NarutoSage")
                end
                local activated=Sage.activate(session.sage,now)
                if activated then
                    session.sageTechniquesReady=true
                    Kcm.SageActivated(player)
                    local modifier=Sage.modifier(activated.rank); assert(modifier)
                    Stats.SetLayer(model,"NarutoSage",{health=modifier.health,armor=modifier.armor,attack=modifier.attack,speed=Units.toStuds(modifier.speedWarcraft)})
                    if not activated.meditation then session.pool.mana=math.min(session.pool.maximum,session.pool.mana+Sage.Source.ManaRestore[activated.rank]) end
                    publish(player,session,now)
                end
                -- A lobby/temporary combat lock may have suspended intents before the
				-- round became playable. Resume only the current live owner's clean group.
				if not session.commands.active then Commands.newLife(session.commands, roundId(), session.life) end
				local cast = session.q.active
				if cast and not session.preparationStunned and now >= cast.startedAt + 1 and now < cast.readyAt then
					session.preparationStunned = true; selfStun(session, fighter, now, math.max(0, cast.readyAt - now))
				end
				Q.update(session.q, now); cast = session.q.active
				if cast then
					local targetId = Q.claimControl(session.q, cast, now)
					local target = session.target
					if targetId and target and Damage.CanDamage(model, target) then
						local targetRoot = target:FindFirstChild("HumanoidRootPart")
						if targetRoot and targetRoot:IsA("BasePart") then
							local facing = (targetRoot.Position - fighter.root.Position) * Vector3.new(1,0,1)
							if facing.Magnitude > .001 then fighter.root.CFrame = CFrame.lookAt(fighter.root.Position, fighter.root.Position + facing) end
						end
						local victim = Fighters.GetOrCreate(target)
						if victim then Fighters.StunSpell(victim, cast.stun) end
						selfStun(session, fighter, now, if cast.variant=="Rasenshuriken" then 1.5 else cast.impactDelay)
						local round, life = session.q.round, session.q.life
						local consumedCast: Rasengan.Cast = cast
						if cast.variant~="Rasenshuriken" then Displacement.Begin(model, target, now, 2, 1, 1, 18, 0.03, function()
							return session.q.round == round and session.q.life == life and (session.q.active == consumedCast or consumedCast.impacted) and Damage.CanDamage(model, target)
						end, function() Service.Visual:Fire({kind="RasenganFinish",source=model,variant=consumedCast.variant,castId=consumedCast.id,position=target:GetPivot().Position}) end,
						function() Service.Visual:Fire({kind="RasenganTrail",source=model,variant=consumedCast.variant,castId=consumedCast.id,position=target:GetPivot().Position}) end) end
					end
					local impacted = Q.claimImpact(session.q, cast, now)
					if impacted and target then
						local humanoid = target:FindFirstChildOfClass("Humanoid")
						local level, strength = Service.GetStats(player); local raw = Variants.damage(cast.variant,level,strength,cast.sagePrepared)
						if humanoid and raw then
							if cast.variant=="Rasenshuriken" then
                                local round,life=session.q.round,session.q.life
                                Shuriken.Begin(model,target,now,function() return session.q.round==round and session.q.life==life and Damage.CanAct(model) end,function() return values(player).strength end,session.shurikenSnapshot)
                            else
                                local dealt=Damage.Apply(model, humanoid, raw)
                                if dealt>0 then Service.Visual:Fire({kind="RasenganImpact",source=model,variant=cast.variant,castId=cast.id,position=target:GetPivot().Position}) end
                            end
						end
						session.target = nil
					end
				end
				local burst = session.clones.burst
				if burst then
					local clone = W.spawnOne(session.clones, burst, now, true, Q.hasMarker(session.q, now) and (session.q.active :: Rasengan.Cast).variant~="Rasenshuriken")
					if clone then Summons.Spawn(player, model, session.clones, clone, session.commands) end
				end
			end
		end
		CloneState.expire(session.clones, now)
		if now >= session.nextPublish then publish(player, session, now) end
	end
	Ranged.Update(now); Sleep.Update(now); Shuriken.Update(now); Thrown.Update(now); Displacement.Update(now)
end
function Service.Start()
	if started then return end; started = true
	Kcm.Start({
		mana=function(player) local s=sessions[player]; return if s then s.pool.mana else 0 end,
		restoreMana=function(player,amount) local s=sessions[player]; if s then s.pool.mana=math.min(s.pool.maximum,s.pool.mana+amount) end end,
		spendMana=function(player,amount) local s=sessions[player]; return s~=nil and Resource.spend(s.pool,amount) end,
		busy=function(player)
			local s=sessions[player]; if not s then return true end
			local sage=s.sage.active
			return Ranged.Busy(player) or s.q.active~=nil or s.clones.burst~=nil or s.selfControlUntil>workspace:GetServerTimeNow() or (sage~=nil and sage.phase=="Preparing")
		end,
		sage=function(player)
			local s=sessions[player]; local cast=if s then s.sage.active else nil; local now=workspace:GetServerTimeNow()
			return if cast and cast.phase=="Active" then math.max(0,cast.expiresAt-now) else 0, cast~=nil and cast.phase=="Active" and cast.auraUntil>now
		end,
        setSageReady=function(player,ready)
            local s=sessions[player]; if not s then return end
            s.sageTechniquesReady=ready
            if s.character then s.character:SetAttribute("SageTechniquesReady",ready) end
        end,
	})
 Ranged.Start({mana=function(p) return bind(p).pool.mana end,spend=function(p,n) return Resource.spend(bind(p).pool,n) end,
  strength=function(p) return values(p).strength end,
  busy=function(p) local s=bind(p);return s.q.active~=nil or s.clones.burst~=nil or s.selfControlUntil>workspace:GetServerTimeNow() or (s.sage.active~=nil and s.sage.active.phase=="Preparing") end,
  pause=function(p,d) local s=bind(p);local f=if p.Character then Fighters.Get(p.Character) else nil;if f then selfStun(s,f,workspace:GetServerTimeNow(),d) end end})
 Ranged.Visual.Event:Connect(function(message) Service.Visual:Fire(message) end)
 Thrown.Visual.Event:Connect(function(message) Service.Visual:Fire(message) end)
 Kurama.Visual.Event:Connect(function(message) Service.Visual:Fire(message) end)
 Service.ConfigureMeditationForms(Kcm.MeditationForm)
 Kurama.ConfigureSummonManaReceiver(MeditationClones.RestoreMana)
 Shuriken.Visual.Event:Connect(function(message) Service.Visual:Fire(message) end)
 Gama.Visual.Event:Connect(function(message) Service.Visual:Fire(message) end)
	Players.PlayerAdded:Connect(function(player) bind(player) end)
	Players.PlayerRemoving:Connect(function(player)
		Ranged.Remove(player); Kcm.Remove(player)
		local session = sessions[player]; if not session then return end
		MeditationClones.ClearOwner(player); Meditation.invalidate(session.meditation,roundId(),session.life+1)
		Gama.Remove(player)
		invalidate(player, session); Summons.ClearOwner(player)
		for _, connection in session.connections do connection:Disconnect() end
		sessions[player] = nil
	end)
	Progression.Changed.Event:Connect(function(player: Player, reason: string)
		local session = sessions[player]; if not session then return end
		if reason == "Reset" then session.pool = Resource.new(values(player), workspace:GetServerTimeNow()) end
	end)
	Fighters.Changed.Event:Connect(function(fighter: Fighters.Fighter)
		local player = fighter.player; local session = if player then sessions[player] else nil
		if player and session and session.character == fighter.character and not session.selfStun then
			if fighter.logic.mode == "Dead" then invalidate(player, session)
			elseif fighter.logic.mode == "Stunned" or (fighter.sleep and fighter.sleep.active) then cancelQ(player, session, workspace:GetServerTimeNow()) end
		end
	end)
	Combat.AttackStarted.Event:Connect(function(fighter: Fighters.Fighter)
		local player = fighter.player; local session = if player then sessions[player] else nil
		if not player or not session then return end
		local candidates = Hitboxes.GetTargets(fighter.character, fighter.root, fighter.profile)
		local chosen: Model? = nil; local nearest = math.huge
		for _, humanoid in candidates do
			local target = humanoid.Parent
			if target and target:IsA("Model") and not target:FindFirstChildOfClass("ForceField") and Damage.CanDamage(fighter.character, target) then
				local root = target:FindFirstChild("HumanoidRootPart")
				if root and root:IsA("BasePart") then
					local distance = (root.Position - fighter.root.Position).Magnitude
					if distance < nearest then nearest = distance; chosen = target end
				end
			end
		end
		Kcm.OnAttackStarted(player,chosen~=nil)
	end)
	Combat.SetAttackGuard(function(fighter: Fighters.Fighter): boolean
		local session=if fighter.player then sessions[fighter.player] else nil
		return not session or not Q.blocksBasicAttack(session.q,workspace:GetServerTimeNow())
	end)
	Combat.SetContactHandler(function(fighter: Fighters.Fighter, chosen: Model): boolean
		local player = fighter.player; local session = if player then sessions[player] else nil
		if not player or not session then return false end
		Commands.assist(session.commands, Summons.EntityId(chosen), true)
		local cast = session.q.active
		local targetRoot = chosen:FindFirstChild("HumanoidRootPart")
		-- CombatService already verified the real hitbox, team, wall and ForceField.
		-- A second, shorter centre-distance gate used to let ordinary M1 hit first.
		if cast and targetRoot and targetRoot:IsA("BasePart") then
			local kind = chosen:GetAttribute("EntityKind")
			if Q.attack(session.q, cast, workspace:GetServerTimeNow(), Summons.EntityId(chosen), true, kind ~= "Hero" and kind ~= "Minion" and kind ~= "Summon") then
				session.target = chosen; session.selfControlUntil = workspace:GetServerTimeNow() + 0.01 + cast.impactDelay
				publish(player, session, workspace:GetServerTimeNow())
				Service.Visual:Fire({kind="RasenganContact",source=fighter.character,target=chosen,variant=cast.variant,castId=cast.id,position=targetRoot.Position})
				return true -- One prepared spell replaces this strike, retaining its original damage.
			end
		end
		return false
	end)
	local last = workspace:GetServerTimeNow()
	game:GetService("RunService").Heartbeat:Connect(function()
		local now = workspace:GetServerTimeNow(); local delta = math.max(0, now - last); last = now
		Summons.Update(now, delta, Service.GetStats)
		Gama.Update(now,delta)
        MeditationClones.Update(now)
	end)
	for _, player in Players:GetPlayers() do bind(player) end
end
return Service
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="243">
          <Properties>
            <string name="Name">NarutoKcmService</string>
            <string name="Source"><![CDATA[--!strict
-- Concrete server ports for KCM. NarutoAbilityService provides only mana/busy/Sage seams.
local Players=game:GetService("Players")
local Shared=game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config=require(Shared.Abilities.NarutoKcmConfig)
local Domain=require(Shared.Abilities.NarutoKcmState).configure(Config)
local Adapter=require(Shared.Abilities.NarutoKcmAdapter)
local RangedDomain=require(Shared.Abilities.NarutoRangedState)
local Gameplay=require(Shared.Abilities.NarutoKcmGameplay)
local Kurama=require(script.Parent.NarutoKuramaService)
local Units=require(Shared.Abilities.WorldUnits)
local Stats=require(script.Parent.CharacterStatsService)
local Progression=require(script.Parent.HeroProgressionService)
local Fighters=require(script.Parent.FighterStateService)
local Damage=require(script.Parent.DamageService)
local Targets=require(script.Parent.AbilityTargetService)
local Hitboxes=require(script.Parent.HitboxService)
local Teams=require(script.Parent.TeamService)
export type Hooks={mana: (Player)->number,restoreMana: (Player,number)->(),spendMana: (Player,number)->boolean,
 busy: (Player)->boolean,sage: (Player)->(number,boolean),setSageReady: (Player,boolean)->()}
type Record={player: Player,token: Adapter.Token?,model: Model?,dash: Gameplay.DashState,hagoromo: Gameplay.Hagoromo,
 epoch: number,lastRequest: number,sageEntryBlocked: boolean}
local records: {[string]: Record}={}
local visuals: {[Adapter.Token]: Highlight}={}
local models: {[Adapter.Token]: Model}={}
local hooks: Hooks?=nil
type Runtime=typeof(Adapter.configure(Domain,{} :: Adapter.Ports,{} :: Adapter.MorphPolicy))
local runtime: Runtime?=nil
local S={}
local function round(): number local match=Teams.GetState(); return if match then match.roundId else 0 end
local function snapshot(owner: string): Adapter.Snapshot?
 local r=records[owner]; local h=hooks; if not r or not h then return nil end
 local p=r.player; local model=p.Character; local profile=Progression.Get(p)
 local fighter=if model then Fighters.Get(model) else nil
 if not model or not profile or not fighter then return nil end
 local match=Teams.GetState(); local left,aura=h.sage(p)
 if left<=0 then r.sageEntryBlocked=false end
 local live=Damage.CanAct(model)
 return {life=(model:GetAttribute("LifeId") or 0) :: number,epoch=round(),eligible=p.Parent==Players and p:GetAttribute("HeroId")=="OrangeNinja"
  and match~=nil and match.phase=="InProgress" and Teams.IsParticipant(p),
  canCast=live and not (fighter.sleep and fighter.sleep.active) and fighter.logic.mode=="Idle" and fighter.logic.nextAttackAt<=workspace:GetServerTimeNow()
   and not fighter.root.Anchored and not h.busy(p),
  context={level=profile.Level,rank=profile.Learned.KCM or 0,hagoromo=r.hagoromo.granted,alive=live,
   fullKurama=Kurama.IsActive(p),kuramaCooldown=Kurama.IsLocked(p),sageRemaining=left,sageAuraPresent=aura},
  allowed={kcm=(profile.Learned.KCM or 0)>0 and not r.sageEntryBlocked,gamakichi=(profile.Learned.Gamakichi or 0)>0,
   sage=(profile.Learned.SageMode or 0)>0,dash=true,sharing=false,fullKurama=profile.Level>=21}}
end
local function owned(token: Adapter.Token): Model?
 local model=models[token]; local p=Players:GetPlayerByUserId(tonumber(token.owner) or 0)
 if model and p and p.Character==model and model:GetAttribute("LifeId")==token.life
  and model:GetAttribute("RoundId")==token.epoch then return model end
 return nil
end
function S.Start(h: Hooks)
 if runtime then return end; hooks=h
 local ports: Adapter.Ports={now=function() return workspace:GetServerTimeNow() end,read=snapshot,
  kuramaPulse=function(token) local r=records[token.owner]; if r then Kurama.Pulse(r.player) end end,
  publish=function(token,chakra,mask,cooldownAt)
   local model=owned(token); if not model then return end
   model:SetAttribute("KuramaChakra",chakra); model:SetAttribute("KuramaChakraThreshold",900+100*Stats.Get(records[token.owner].player).Level)
   model:SetAttribute("Ready_KCM",cooldownAt)
   model:SetAttribute("KuramaFormAllowed",mask.fullKurama)
   model:SetAttribute("KcmAllowed",mask.kcm); model:SetAttribute("KcmDashReady",mask.dash)
   model:SetAttribute("KcmGamakichiAllowed",mask.gamakichi); model:SetAttribute("KcmSageAllowed",mask.sage)
  end,
  effect=function(token,kind,id)
   local model=owned(token); if not model then return end
   if kind=="Entered" then
    if model:GetAttribute("KcmRank")==3 then h.setSageReady(records[token.owner].player,true) end
    model:SetAttribute("KcmActive",true); model:SetAttribute("KcmCastId",id)
    local highlight=Instance.new("Highlight"); highlight.Archivable=false; highlight.Name="NarutoKcmAura"; highlight.Adornee=model
    highlight.FillColor=Color3.fromRGB(255,179,30); highlight.OutlineColor=Color3.fromRGB(255,230,110)
    highlight.FillTransparency=.8; highlight.DepthMode=Enum.HighlightDepthMode.Occluded; highlight.Parent=model; visuals[token]=highlight
   elseif kind=="Exited" then
    h.setSageReady(records[token.owner].player,false)
    model:SetAttribute("KcmActive",false); model:SetAttribute("KcmCastId",nil)
    local r=records[token.owner]; if r then r.sageEntryBlocked=false end
   end
  end,
  reapplySage=function(_token) end, -- Additive owned layers remain composed; never snapshot/restart Sage.
  restoreMana=function(token,amount) local model=owned(token); if model then h.restoreMana(records[token.owner].player,amount) end end,
  revokeSharing=function(_token) end, -- Sharing branch is deliberately unavailable in snapshot.allowed.
  fault=function(token,reason) warn("KCM "..token.owner..": "..reason) end,
 }
 local policy: Adapter.MorphPolicy={enabled=true,
  apply=function(token,rank)
   local r=records[token.owner]; local model=if r then r.player.Character else nil; local m=Gameplay.modifier(rank)
   if not model or not m or model:GetAttribute("LifeId")~=token.life or round()~=token.epoch then return false end
   models[token]=model
   Stats.SetLayer(model,"NarutoKcm",{health=m.health,armor=m.armor,attack=m.attack,speed=Units.toStuds(m.speedWarcraft)})
   model:SetAttribute("RikudoActive",rank==3)
   model:SetAttribute("KcmRank",rank); model:SetAttribute("KcmPolicy",Gameplay.Policy.Id)
   return true
  end,
  remove=function(token,_rank)
   local model=models[token]
   if model then
    Stats.SetLayer(model,"NarutoKcm",nil)
    model:SetAttribute("RikudoActive",false)
    model:SetAttribute("KcmActive",false); model:SetAttribute("KcmDashReady",false); model:SetAttribute("KcmRank",0)
   end
   local visual=visuals[token]; if visual then visual:Destroy(); visuals[token]=nil end
  end,
 }
 runtime=Adapter.configure(Domain,ports,policy)
 Kurama.Start({
  chakra=function(p) local r=records[tostring(p.UserId)]; return if runtime and r and r.token then runtime.Chakra(r.token) else nil end,
  spend=function(p,amount) local r=records[tostring(p.UserId)]; return runtime~=nil and r~=nil and r.token~=nil and runtime.SpendChakra(r.token,amount) end,
  kcm=function(p) local r=records[tostring(p.UserId)]; return runtime~=nil and r~=nil and r.token~=nil and runtime.IsActive(r.token) end,
  busy=h.busy,restoreMana=h.restoreMana,
  released=function(p)
   local r=records[tostring(p.UserId)]
   if r then r.sageEntryBlocked=false end -- A01F release explicitly restores A017, independently of Sage's timer.
  end,
 })
end
local function record(p: Player): Record
 assert(runtime)
 local key=tostring(p.UserId); local r=records[key]
 if not r then
  local created: Record={player=p,token=nil,model=nil,dash=Gameplay.newDash(),hagoromo=Gameplay.newHagoromo(),epoch=round(),lastRequest=0,sageEntryBlocked=false}
  records[key]=created; r=created
 end
 if r.epoch~=round() then
  if r.token then runtime.Remove(r.token); models[r.token]=nil end
  r.token=nil; r.dash=Gameplay.newDash(); r.hagoromo=Gameplay.newHagoromo(); r.epoch=round(); r.lastRequest=0; r.sageEntryBlocked=false
 end
 return r
end
local function refresh(p: Player): Record?
 if not runtime then return nil end
 local r=record(p); local profile=Progression.Get(p); local model=p.Character
 local alive=model~=nil and Damage.CanAct(model)
 if profile then
  local event=Gameplay.updateHagoromo(r.hagoromo,workspace:GetServerTimeNow(),profile.Level,alive)
  if event=="Cutscene" and model then local fighter=Fighters.Get(model); if fighter then Fighters.StunSpell(fighter,1) end end
  local folder=Progression.GetFolder(p)
  if folder then folder:SetAttribute("HagoromoUnlocked",r.hagoromo.granted); folder:SetAttribute("HagoromoReadyAt",r.hagoromo.deadline or 0) end
 end
 if r.token then
  local ok=runtime.Update(r.token)
  if not ok then models[r.token]=nil; r.token=nil end
 end
 if not r.token and alive then
  local token=runtime.Bind(tostring(p.UserId))
  if token then r.token=token; r.model=model; if model then models[token]=model end; runtime.Update(token) end
 end
 if model then
  model:SetAttribute("Ready_KcmDash",r.dash.cooldownAt); model:SetAttribute("HagoromoUnlocked",r.hagoromo.granted)
 end
 return r
end
function S.RikudoGrant(p: Player,now: number): (RangedDomain.Grant?,number?)
 if Kurama.IsActive(p) or Kurama.IsLocked(p) then return nil,nil end
 local r=refresh(p);local rt=runtime
 if not rt or not r or not r.token then return nil,nil end
 local rank,castId=rt.ActiveCast(r.token);local model=owned(r.token);local profile=Progression.Get(p)
 if rank~=3 or not castId or not model or not profile or not r.hagoromo.granted
  or (profile.Learned.KCM or 0)~=3 or profile.Level<27 then return nil,nil end
 return {abilityId="",ownerId=tostring(p.UserId),round=r.token.epoch,life=r.token.life,form="Ewrd",
  kcmRank=3,heroLevel=profile.Level,hagoromo=true,expiresAt=now+.1},castId
end
function S.IsAbility(id: string): boolean return id=="KuramaForm" or id=="KCM" or id=="KcmCancel" or id=="KcmDash" or id=="KuramaConvert" end
-- A09J activation disables A017; the source KCM exit action can restore it.
-- Keep this admission action separate from independently composed stat layers.
function S.SageActivated(p: Player)
 local r=records[tostring(p.UserId)]; if r then r.sageEntryBlocked=true end
end
function S.MeditationForm(p: Player): "Ordinary" | "KCM" | "Kurama"
 if Kurama.IsActive(p) then return "Kurama" end
 local r=records[tostring(p.UserId)]
 return if runtime and r and r.token and runtime.IsActive(r.token) then "KCM" else "Ordinary"
end
function S.IsRikudo(p: Player): boolean
 local r=records[tostring(p.UserId)]
 return runtime~=nil and r~=nil and r.token~=nil and runtime.ActiveRank(r.token)==3
end
function S.OnAttackStarted(p: Player,hasTarget: boolean) Kurama.AttackStarted(p,hasTarget) end
function S.Blocked(model: Model,id: string): boolean
 local player=Players:GetPlayerFromCharacter(model)
 return player~=nil and ((S.MeditationForm(player)=="KCM" and id=="Gamakichi") or (S.IsRikudo(player) and id=="SageMode"))
end
function S.TryCast(p: Player,id: string,request: number,now: number,target: any): (boolean,string)
 local r=refresh(p); local h=hooks; if not runtime or not r or not r.token or not h then return false,"Unavailable" end
 if request<=r.lastRequest then return false,"Replay" end; r.lastRequest=request
 local token=r.token; local model=p.Character; if not model then return false,"Unavailable" end
 if id=="KuramaForm" then return Kurama.TryCast(p,request,now,target)
 elseif id=="KCM" then
  if target~=nil then return false,"Malformed" end
  local ok,reason=runtime.Enter(token)
  return ok,reason
 elseif id=="KcmCancel" then
  if target~=nil then return false,"Malformed" end
  return runtime.Cancel(token,(model:GetAttribute("KcmCastId") or 0) :: number)
 elseif id=="KuramaConvert" then
  if target~=nil then return false,"Malformed" end
  return runtime.Convert(token)
 elseif id~="KcmDash" then return false,"Unsupported" end
 local snap=snapshot(tostring(p.UserId)); if not snap or not snap.canCast then return false,"Busy" end
 local fighter=Fighters.Get(model); if not fighter then return false,"Unavailable" end
 local destination: Vector3; local victim: Model?=nil
 if typeof(target)=="Vector3" then destination=target
 elseif typeof(target)=="Instance" then
  local selected=target :: Instance; if not selected:IsA("Model") then return false,"Target" end
  victim=selected; local root=selected:FindFirstChild("HumanoidRootPart")
  local kind=selected:GetAttribute("EntityKind")
  if not root or not root:IsA("BasePart") or (kind~="Hero" and kind~="Minion" and kind~="Summon")
   or not Damage.CanDamage(model,selected) or selected:FindFirstChildOfClass("ForceField") then return false,"Target" end
  destination=root.Position
 else return false,"Target" end
 if not Hitboxes.IsFiniteCFrame(CFrame.new(destination)) then return false,"Target" end
 local start=fighter.root.Position; local distance=(destination-start).Magnitude
 if distance>Units.toStuds(Gameplay.Dash.RangeWarcraft) or math.abs(destination.Y-start.Y)>12 then return false,"Range" end
 if not Targets.Visible(model,victim or model,start,destination) then return false,"Blocked" end
 if victim then
  local delta=(start-destination)*Vector3.new(1,0,1)
  if delta.Magnitude>.01 then destination+=delta.Unit*3 end
 end
 local ray=RaycastParams.new(); ray.FilterType=Enum.RaycastFilterType.Exclude; ray.FilterDescendantsInstances={model}
 if victim then ray.FilterDescendantsInstances={model,victim} end
 ray.RespectCanCollide=true
 local ground=workspace:Raycast(destination+Vector3.new(0,6,0),Vector3.new(0,-18,0),ray)
 if not ground or ground.Normal.Y<.5 then return false,"Ground" end
 destination=Vector3.new(destination.X,ground.Position.Y+fighter.humanoid.HipHeight+fighter.root.Size.Y/2,destination.Z)
 local movement=destination-start
 if movement.Magnitude>.01 and workspace:Blockcast(fighter.root.CFrame,fighter.root.Size*.8,movement,ray) then return false,"Blocked" end
 local strength=(model:GetAttribute("Strength") or Stats.Get(p).Strength) :: number
 local ok,reason,cost,damage=Gameplay.dash(r.dash,now,request,runtime.IsActive(token),
  runtime.IsDashReady(token),h.mana(p),distance/Units.StudsPerWarcraftUnit,if victim then "Unit" else "Point",strength)
 if not ok then return false,reason end
 assert(h.spendMana(p,cost)); fighter.root.CFrame=CFrame.new(destination)*fighter.root.CFrame.Rotation
 fighter.root.AssemblyLinearVelocity=Vector3.zero
 if victim and damage then local hp=victim:FindFirstChildOfClass("Humanoid"); if hp then Damage.Apply(model,hp,damage) end end
 model:SetAttribute("Ready_KcmDash",r.dash.cooldownAt)
 return true,"Accepted"
end
function S.StudioResetCooldowns(p: Player)
 if not game:GetService("RunService"):IsStudio() then return end
 local r=records[tostring(p.UserId)]
 if r then r.dash.cooldownAt=0;if runtime and r.token then runtime.ResetCooldown(r.token) end end
end
function S.StudioEnableRikudo(p: Player): (boolean,string)
 if not game:GetService("RunService"):IsStudio() or p.Parent~=Players then return false,"StudioOnly" end
 local rt=runtime;local r=refresh(p);local snap=snapshot(tostring(p.UserId))
 if not rt or not r or not r.token or not snap or not snap.eligible or not snap.canCast then return false,"Busy" end
 if snap.context.level<27 or snap.context.rank~=3 then return false,"Rank" end
 -- Real owner-scoped progression and domain state; never fake replicated form flags.
 r.hagoromo.granted=true;r.hagoromo.deadline=nil;r.hagoromo.cutsceneAt=nil;r.sageEntryBlocked=false
 if rt.ActiveRank(r.token)==3 then
  rt.CreditChakra(r.token,math.max(0,900+100*snap.context.level-(rt.Chakra(r.token) or 0)))
  refresh(p);return true,"AlreadyActive"
 end
 Kurama.Remove(p)
 -- Close a lower KCM rank through normal cleanup before binding a fresh cast token.
 if rt.IsActive(r.token) then
  local old=r.token;rt.Remove(old);models[old]=nil;r.token=nil
 end
 r=refresh(p);if not r or not r.token then return false,"Unavailable" end
 local token=r.token
 rt.ResetCooldown(token)
 rt.CreditChakra(token,math.max(0,900+100*snap.context.level-(rt.Chakra(token) or 0)))
 return rt.Enter(token)
end
function S.Update()
 if runtime then for _,p in Players:GetPlayers() do refresh(p) end; Kurama.Update(workspace:GetServerTimeNow()) end
end
function S.Remove(p: Player)
 assert(runtime)
 local key=tostring(p.UserId); local r=records[key]
 if r and r.token then runtime.Remove(r.token); models[r.token]=nil end
 Kurama.Remove(p); records[key]=nil
end
function S.Reset()
 Kurama.Reset()
 if runtime then runtime.Reset() end
 for _,r in records do r.token=nil; r.dash=Gameplay.newDash(); r.hagoromo=Gameplay.newHagoromo(); r.epoch=round(); r.lastRequest=0; r.sageEntryBlocked=false end
 table.clear(models); table.clear(visuals)
end
return S
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="244">
          <Properties>
            <string name="Name">NarutoKuramaService</string>
            <string name="Source"><![CDATA[--!strict
local Players=game:GetService("Players")
local Shared=game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Form=require(Shared.Abilities.NarutoKuramaState)
local CombatConfig=require(Shared.Config.CombatConfig)
local Avatar=require(Shared.Config.KuramaAvatarConfig)
local Units=require(Shared.Abilities.WorldUnits)
local Structures=require(Shared.Game.StructureRules)
local Stats=require(script.Parent.CharacterStatsService)
local Fighters=require(script.Parent.FighterStateService)
local Teams=require(script.Parent.TeamService)
local Damage=require(script.Parent.DamageService)
local Hitboxes=require(script.Parent.HitboxService)
export type Hooks={chakra: (Player)->number?,spend: (Player,number)->boolean,kcm: (Player)->boolean,
 busy: (Player)->boolean,restoreMana: (Player,number)->(),released: (Player)->()}
type PreviousCombat={id: string,profile: CombatConfig.AttackProfile}
type Record={state: Form.State,model: Model?,visual: Highlight?,body: BasePart?,previousCombat: PreviousCombat?,
 cleanupConnections: {RBXScriptConnection},lastRequest: number,applied: boolean}
local records: {[Player]: Record}={}
local retained: {[string]: {epoch: number,balance: Form.Balance}}={}
local hooks: Hooks?=nil
local rng=Random.new()
local summonMana: ((Model,number)->boolean)?=nil
local S={Visual=Instance.new("BindableEvent")}
local function epoch(): number local m=Teams.GetState(); return if m then m.roundId else 0 end
local function valid(p: Player,r: Record): boolean
 local model=r.model
 return p.Parent==Players and model~=nil and p.Character==model and model:GetAttribute("LifeId")==r.state.life
  and epoch()==r.state.epoch and Damage.CanAct(model)
end
local function teardown(r: Record)
 if not r.applied and not r.visual and not r.body and not r.previousCombat then return end; r.applied=false
 for _,connection in r.cleanupConnections do connection:Disconnect() end
 table.clear(r.cleanupConnections)
 if r.body then r.body:Destroy();r.body=nil end
 local model=r.model
 if model then
  model:SetAttribute("CombatBodyRadius",nil)
  local fighter=Fighters.Get(model);local previous=r.previousCombat
  if fighter and previous then Fighters.SetAttackProfile(fighter,previous.id,previous.profile) end
  Stats.SetLayer(model,"NarutoKurama",nil); Stats.SetLayer(model,"NarutoKuramaThreeHead",nil)
  model:SetAttribute("KuramaActive",false); model:SetAttribute("KuramaProcPending",false)
 end
 r.previousCombat=nil
 if r.visual then r.visual:Destroy(); r.visual=nil end
end
local function applyBody(r: Record,fighter: Fighters.Fighter)
 local model=fighter.character
 r.previousCombat={id=fighter.profileId,profile=fighter.profile}
 Fighters.SetAttackProfile(fighter,"Kurama")
 local body=Instance.new("Part");body.Name="KuramaCombatBody";body.Transparency=1;body.CastShadow=false
 body.Size=Vector3.new(Avatar.BodySize.X,Avatar.BodySize.Y,Avatar.BodySize.Z)
 body.CFrame=fighter.root.CFrame*CFrame.new(Avatar.BodyOffset.X,Avatar.BodyOffset.Y,Avatar.BodyOffset.Z)
 body.Anchored=false;body.Massless=true;body.CanCollide=true;body.CanQuery=true;body.CanTouch=false
 body.CollisionGroup="SurvivalHeroes";body:SetAttribute("HeroCosmetic",false)
 local weld=Instance.new("WeldConstraint");weld.Part0=fighter.root;weld.Part1=body;weld.Parent=body
 body.Parent=model;r.body=body
 model:SetAttribute("CombatBodyRadius",Avatar.BodyRadius)
 table.insert(r.cleanupConnections,fighter.humanoid.Died:Connect(function() teardown(r) end))
 table.insert(r.cleanupConnections,model.AncestryChanged:Connect(function()
  if not model:IsDescendantOf(workspace) then teardown(r) end
 end))
 table.insert(r.cleanupConnections,model.Destroying:Connect(function() teardown(r) end))
end
local function events(r: Record,list: {Form.Event})
 local h=hooks
 for _,e in list do
  if e.kind=="Exited" then teardown(r)
  elseif e.kind=="Released" and h and r.model then
   local p=Players:GetPlayerFromCharacter(r.model)
   if p and p.Character==r.model and r.model:GetAttribute("LifeId")==r.state.life and epoch()==r.state.epoch then h.released(p) end
  end
 end
 local model=r.model; if model then model:SetAttribute("KuramaLocked",Form.isLocked(r.state)) end
end
local function record(p: Player,now: number): Record
 local r=records[p]; local model=p.Character; local life=if model then (model:GetAttribute("LifeId") or 0) :: number else 0
 if not r then
  local owner=tostring(p.UserId); local saved=retained[owner]
  local created: Record={state=Form.new(owner,epoch(),life,now,if saved and saved.epoch==epoch() then saved.balance else nil),model=model,visual=nil,
   body=nil,previousCombat=nil,cleanupConnections={},lastRequest=0,applied=false}
  retained[owner]=nil
  r=created; records[p]=created
 elseif r.state.epoch~=epoch() or r.state.life~=life or r.model~=model then
  events(r,Form.newLife(r.state,epoch(),life,now))
  r.model=model; r.lastRequest=0
 end
 return r
end
function S.Start(h: Hooks) hooks=h end
function S.ConfigureSummonManaReceiver(receiver: (Model,number)->boolean) summonMana=receiver end
function S.IsActive(p: Player): boolean
 local r=records[p]; local c=if r then r.state.active else nil
 return r~=nil and r.applied and c~=nil and c.buff and (c.externalBuff or workspace:GetServerTimeNow()<c.expiresAt) and valid(p,r)
end
function S.IsLocked(p: Player): boolean
 local r=records[p]; local model=if r then r.model else nil
 return r~=nil and model~=nil and r.state.epoch==epoch() and model==p.Character and model:GetAttribute("LifeId")==r.state.life and Form.isLocked(r.state)
end
function S.TryCast(p: Player,request: number,now: number,target: any): (boolean,string)
 local h=hooks; if not h then return false,"Unavailable" end
 if target~=nil then return false,"Malformed" end
 local r=record(p,now); local model=p.Character; local fighter=if model then Fighters.Get(model) else nil
 if not model or not fighter or not valid(p,r) or p:GetAttribute("HeroId")~="OrangeNinja" then return false,"Unavailable" end
 if request~=request or request%1~=0 or request<1 or request==math.huge then return false,"Malformed" end
 if request<=r.lastRequest then return false,"Replay" end; r.lastRequest=request
 events(r,Form.update(r.state,now,true))
 local before=table.clone(r.state)
 local accepted,reason,cost=Form.request(r.state,now,{level=Stats.Get(p).Level,alive=true,
  canCast=fighter.logic.mode=="Idle" and fighter.logic.nextAttackAt<=now and not fighter.root.Anchored and not h.busy(p),
  kcm=h.kcm(p),chakra=h.chakra(p) or 0})
 if not accepted then return false,reason end
 -- Resource owner and policy application are synchronous; no client debit/attributes are accepted.
 if not h.spend(p,cost) then r.state=before; return false,"Chakra" end
 r.applied=true
 applyBody(r,fighter)
 local m=Form.modifier()
 Stats.SetLayer(model,"NarutoKurama",{health=m.health,armor=m.armor,attack=m.attack,speed=Units.toStuds(m.speedWarcraft)})
 model:SetAttribute("KuramaActive",true); model:SetAttribute("KuramaLocked",true)
 model:SetAttribute("KuramaCastId",r.state.serial); model:SetAttribute("KuramaExpiresAt",now+Form.Duration)
 model:SetAttribute("Ready_KuramaForm",r.state.cooldownAt); model:SetAttribute("KuramaPolicy",Form.Policy.Retention)
 local v=Instance.new("Highlight"); v.Name="NarutoKuramaAura"; v.Archivable=false; v.Adornee=model
 v.FillColor=Color3.fromRGB(255,202,70); v.OutlineColor=Color3.fromRGB(255,237,146); v.FillTransparency=1;v.OutlineTransparency=.45
 v.DepthMode=Enum.HighlightDepthMode.Occluded; v.Parent=model; r.visual=v
 return true,"Accepted"
end
-- Attack intent with an admitted target, before landed M1 damage. Structures may be initial targets.
function S.AttackStarted(p: Player,hasTarget: boolean)
 local r=records[p]; if not r or not S.IsActive(p) then return end
 local model=r.model; if not model then return end
 local root=model:FindFirstChild("HumanoidRootPart"); if not root or not root:IsA("BasePart") or not Hitboxes.IsFiniteCFrame(root.CFrame) then return end
 local at=root.Position
 if Form.attackStart(r.state,workspace:GetServerTimeNow(),rng:NextNumber(1,100),model:GetAttribute("NativeNarutoClone")==true,hasTarget,at.X,at.Y,at.Z) then
  model:SetAttribute("KuramaProcPending",true)
 end
end
-- Called on the EXISTING separate-chakra resource1s phase, after its strict threshold admission.
function S.Pulse(p: Player)
 local r=records[p]; local h=hooks; if not r or not h or not S.IsActive(p) then return end
 local model=r.model; if not model then return end
 local root=model:FindFirstChild("HumanoidRootPart"); if not root or not root:IsA("BasePart") then return end
 local receiver=summonMana
 for target,fighter in Fighters.GetAll() do
  local kind=target:GetAttribute("EntityKind")
  if not Structures.isStructure(kind) and not Teams.IsEnemy(model,target)
   and Teams.GetId(model)==Teams.GetId(target) and (fighter.root.Position-root.Position).Magnitude<=Units.toStuds(400) then
   -- Source predicate has no alive test. Roblox safety: never resurrect dead Humanoids.
   if fighter.humanoid.Health>0 then fighter.humanoid.Health=math.min(fighter.humanoid.MaxHealth,fighter.humanoid.Health+20) end
   local player=Players:GetPlayerFromCharacter(target)
   if player then h.restoreMana(player,20)
   elseif target:GetAttribute("NativeGamakichi")==true then
    local mana,maxMana=target:GetAttribute("Mana"),target:GetAttribute("MaxMana")
    if typeof(mana)=="number" and typeof(maxMana)=="number" then target:SetAttribute("Mana",math.min(maxMana,mana+20)) end
   elseif receiver then receiver(target,20) end -- Optional authoritative meditation/other-mana-owner seam, never edit presentation mana.
  end
 end
end
function S.ObserveBuff(p: Player,life: number,round: number,cast: number,present: boolean): boolean
 local r=records[p]
 if not r or r.state.life~=life or r.state.epoch~=round or not valid(p,r) then return false end
 return Form.observeBuff(r.state,cast,present)
end
function S.ObserveBuffRemoved(p: Player,life: number,round: number,cast: number): boolean
 local r=records[p]
 if not r or r.state.life~=life or r.state.epoch~=round or not valid(p,r) then return false end
 return Form.buffRemoved(r.state,cast)
end
function S.Update(now: number)
 for p in records do
  local r=record(p,now)
  local alive=valid(p,r)
  events(r,Form.update(r.state,now,alive))
  local model=r.model
  if model then model:SetAttribute("Ready_KuramaForm",r.state.cooldownAt) end
  if alive and model then
   local hp=model:FindFirstChildOfClass("Humanoid")
   local proc,amount=Form.claimProc(r.state,now,if hp then hp.MaxHealth else 0)
   if proc and amount then
    model:SetAttribute("KuramaProcPending",false)
    local center=Vector3.new(proc.x,proc.y,proc.z)
    S.Visual:Fire({kind="KuramaShockwave",character=model,center=center,radius=Units.toStuds(Form.ProcRadius),startAt=now,castId=proc.id})
    for target,fighter in Fighters.GetAll() do
     local kind=target:GetAttribute("EntityKind")
     if not Structures.isStructure(kind) and Damage.CanDamage(model,target)
      and (fighter.root.Position-center).Magnitude<=Units.toStuds(Form.ProcRadius) then Damage.Apply(model,fighter.humanoid,amount) end
    end
   end
   model:SetAttribute("Ready_KuramaForm",r.state.cooldownAt)
  end
 end
end
function S.Remove(p: Player)
 local r=records[p]; if r then
  events(r,Form.update(r.state,workspace:GetServerTimeNow(),false)); teardown(r)
  retained[tostring(p.UserId)]={epoch=r.state.epoch,balance=Form.balance(r.state)}
  records[p]=nil
 end
end
function S.StudioResetCooldowns(p: Player)
 if not game:GetService("RunService"):IsStudio() then return end
 local r=records[p];if not r then return end
 r.state.cooldownAt=0;r.state.threeHeadAt=0
 if r.state.active and not r.state.active.buff then r.state.active=nil end
 if r.model then r.model:SetAttribute("Ready_KuramaForm",0);r.model:SetAttribute("KuramaLocked",Form.isLocked(r.state)) end
end
function S.Reset()
 for p,r in records do
  local model=r.model; S.Remove(p)
  if model then model:SetAttribute("Ready_KuramaForm",0); model:SetAttribute("KuramaExpiresAt",0); model:SetAttribute("KuramaCastId",nil) end
 end
 table.clear(retained)
end
return S
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="245">
          <Properties>
            <string name="Name">NarutoRangedService</string>
            <string name="Source"><![CDATA[--!strict
-- Server-owned HY/HZ transaction/world adapter. Source policies: docs/NARUTO-RANGED-RUNTIME.md.
local Players=game:GetService("Players")
local Shared=game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Domain=require(Shared.Abilities.NarutoRangedState)
local Units=require(Shared.Abilities.WorldUnits)
local Kcm=require(script.Parent.NarutoKcmService)
local Fighters=require(script.Parent.FighterStateService)
local Damage=require(script.Parent.DamageService)
local Teams=require(script.Parent.TeamService)
local Hitboxes=require(script.Parent.HitboxService)
local Structures=require(Shared.Game.StructureRules)
export type Hooks={mana:(Player)->number,spend:(Player,number)->boolean,strength:(Player)->number,
 busy:(Player)->boolean,pause:(Player,number)->()}
type Presentation={key:string,origin:Vector3,target:Vector3}
type Record={state:Domain.State,model:Model,kcmCast:number?,presentations:{[number]:Presentation}}
type Ownership={model:Model,untilAt:number}
local records:{[Player]:Record}={}
local retained:{[string]:{round:number,balance:Domain.Balance}}={}
local ownership:{[BasePart]:Ownership}={}
local hooks:Hooks?=nil
local S={Visual=Instance.new("BindableEvent"),Event=Instance.new("BindableEvent")}
local function epoch():number local match=Teams.GetState();return if match then match.roundId else 0 end
local function raw(point:Vector3):Domain.Point return {x=point.X/Units.StudsPerWarcraftUnit,z=point.Z/Units.StudsPerWarcraftUnit} end
local function finish(r:Record,id:number)
 local p=r.presentations[id];if not p then return end
 r.presentations[id]=nil;S.Visual:Fire({kind="RikudoEnd",key=p.key})
end
local function cancel(r:Record)
 for _,cast in r.state.casts do Domain.cancel(r.state,cast) end
 for id in r.presentations do finish(r,id) end
 r.model:SetAttribute("RangedPreparingUntil",nil);r.model:SetAttribute("RangedCastStartedAt",nil)
end
local function bind(p:Player,now:number):Record?
 local model=p.Character;local life=if model then model:GetAttribute("LifeId") else nil
 if not model or typeof(life)~="number" then return nil end
 local r=records[p]
 if not r then
  local owner=tostring(p.UserId);local saved=retained[owner]
  local created:Record={state=Domain.new(owner,epoch(),life,now,if saved and saved.round==epoch() then saved.balance else nil),model=model,kcmCast=nil,presentations={}};records[p]=created;r=created
  retained[owner]=nil
 elseif r.model~=model or r.state.life~=life or r.state.round~=epoch() then
  cancel(r)
  if r.state.round~=epoch() then Domain.reset(r.state,epoch(),life) else Domain.newLife(r.state,epoch(),life) end
  r.model=model;r.kcmCast=nil
 end
 return r
end
function S.IsAbility(id:string):boolean return id=="RikudoHY" or id=="RikudoHZ" end
function S.Ready(p:Player):{[string]:number}
 local r=records[p];return if r then {RikudoHY=r.state.cooldowns.A0HY or 0,RikudoHZ=r.state.cooldowns.A0HZ or 0} else {}
end
function S.Busy(p:Player):boolean
 local r=records[p];if not r then return false end
 local now=workspace:GetServerTimeNow()
 for _,c in r.state.casts do if now<c.unpauseAt then return true end end
 return false
end
function S.Invalidate(p:Player) local r=records[p];if r then cancel(r) end end
function S.Remove(p:Player)
 local r=records[p];if r then
  cancel(r);retained[tostring(p.UserId)]={round=r.state.round,balance=Domain.balance(r.state)}
  Domain.close(r.state);records[p]=nil
 end
end
function S.Inspect(p:Player):Domain.State? local r=records[p];return if r then r.state else nil end
local function publish(r:Record,grant:Domain.Grant?)
 local model=r.model
 model:SetAttribute("RikudoRangedGranted",grant~=nil)
 model:SetAttribute("Ready_RikudoHY",r.state.cooldowns.A0HY or 0)
 model:SetAttribute("Ready_RikudoHZ",r.state.cooldowns.A0HZ or 0)
end
function S.TryCast(p:Player,id:string,requestId:number,now:number,target:any):(boolean,string)
 local h=hooks;local r=bind(p,now)
 if not h or not r or not S.IsAbility(id) then return false,"Unavailable" end
 local grant,kcmCast=Kcm.RikudoGrant(p,now)
 if not grant or not kcmCast then publish(r,nil);return false,"Rikudo" end
 if r.kcmCast and r.kcmCast~=kcmCast then cancel(r) end;r.kcmCast=kcmCast
 local fighter=Fighters.Get(r.model)
 if not fighter or not Damage.CanAct(r.model) or fighter.logic.mode~="Idle" or fighter.logic.nextAttackAt>now
  or (fighter.sleep and fighter.sleep.active) or fighter.root.Anchored or h.busy(p) or S.Busy(p) then return false,"Busy" end
 if typeof(target)~="Vector3" or not Hitboxes.IsFiniteCFrame(CFrame.new(target)) then return false,"Target" end
 local point=target :: Vector3;local origin=fighter.root.Position
 if (point-origin).Magnitude>Units.toStuds(Domain.RangeWarcraft) then return false,"Range" end
 local ray=RaycastParams.new();ray.FilterType=Enum.RaycastFilterType.Exclude
 local ignored:{Instance}={};for model in Fighters.GetAll() do table.insert(ignored,model) end
 ray.FilterDescendantsInstances=ignored;ray.RespectCanCollide=true
 local ground=workspace:Raycast(point+Vector3.new(0,12,0),Vector3.new(0,-36,0),ray)
 if not ground then return false,"Ground" end
 point=Vector3.new(point.X,ground.Position.Y,point.Z)
 if (point-origin).Magnitude>Units.toStuds(Domain.RangeWarcraft) then return false,"Range" end
 local code=if id=="RikudoHY" then "A0HY" else "A0HZ"
 grant.abilityId=code
 local cast,reason,debit=Domain.request(r.state,now,requestId,code,h.mana(p),raw(origin),raw(point),grant,true)
 if not cast then publish(r,grant);return false,reason end
 assert(h.spend(p,debit),"Ranged state/debit must commit without yielding")
 local key=string.format("%s:%d:%d:%d:%d",r.state.ownerId,r.state.round,r.state.life,kcmCast,cast.id)
 local visualOrigin=origin+Vector3.new(0,1,0)
 r.presentations[cast.id]={key=key,origin=visualOrigin,target=point+Vector3.new(0,1,0)}
 r.model:SetAttribute("RangedPreparingUntil",now+1.5);r.model:SetAttribute("RangedCastStartedAt",now)
 h.pause(p,1.5);publish(r,grant)
 S.Visual:Fire({kind="RikudoStart",key=key,caster=r.model,abilityId=code,origin=visualOrigin,
  target=point+Vector3.new(0,1,0),startedAt=now,releaseAt=cast.releaseAt,life=r.state.life})
 return true,"Accepted"
end
local function allied(a:Model,b:Model):boolean
 if a==b then return true end
 local first,second=Teams.GetId(a),Teams.GetId(b)
 return first~=nil and first==second
end
local function move(model:Model,root:BasePart,center:Vector3,amount:number,now:number)
 if root.Anchored then return end
 local flat=(center-root.Position)*Vector3.new(1,0,1);if flat.Magnitude<.001 then return end
 local step=flat.Unit*(if amount>0 then math.min(amount,flat.Magnitude) else amount)
 local ray=RaycastParams.new();ray.FilterType=Enum.RaycastFilterType.Exclude;ray.FilterDescendantsInstances={model};ray.RespectCanCollide=true
 local hit=workspace:Blockcast(root.CFrame,root.Size*.8,step,ray)
 if hit then step=step.Unit*math.max(0,math.min(step.Magnitude,hit.Distance-.03)) end
 if root:CanSetNetworkOwnership() then
  local saved=ownership[root]
  if not saved then
   saved={model=model,untilAt=now+.4};ownership[root]=saved
  end
  saved.untilAt=now+.4
  local fighter=Fighters.Get(model); if fighter then Fighters.LeaseNetworkOwnership(fighter,saved.untilAt) end
 end
 root.CFrame+=step
end
local function restore(now:number,force:boolean?)
 for root,saved in ownership do
  if force or now>=saved.untilAt or not root.Parent then
   ownership[root]=nil
   local fighter=Fighters.Get(saved.model)
   if fighter then Fighters.ReleaseNetworkOwnership(fighter) end
  end
 end
end
local function apply(p:Player,r:Record,e:Domain.Event,now:number)
 local view=r.presentations[e.id];if not view then return end
 if p.Character~=r.model or e.life~=r.state.life or e.round~=epoch() or not Damage.CanAct(r.model) then cancel(r);return end
 local center=Vector3.new(Units.toStuds(e.center.x),view.target.Y,Units.toStuds(e.center.z))
 if e.kind=="Arrived" then
  S.Visual:Fire({kind="RikudoArrived",key=view.key,position=center,at=e.at})
 elseif e.kind=="DamagePulse" or e.kind=="Motion" then
  local radius=Units.toStuds(e.radius)
  local affected=0
  for model,victim in Fighters.GetAll() do
   local flat=(victim.root.Position-center)*Vector3.new(1,0,1)
   -- Safe adaptation: absent source null groups introduce no live exclusion groups.
   if flat:Dot(flat)<=radius*radius and Damage.CanAct(model) and Domain.eligible(e.filter or "",allied(r.model,model),
    Teams.IsEnemy(r.model,model),Structures.isStructure(model:GetAttribute("EntityKind")),false) then
    if e.damage then Damage.Apply(r.model,victim.humanoid,e.damage) end
    if e.displacement and victim.humanoid.Health>0 then move(model,victim.root,center,Units.toStuds(e.displacement),now) end
    affected+=1
   end
  end
  S.Event:Fire(p,e,affected)
  if e.kind=="DamagePulse" and (e.abilityId=="A0HZ" or e.pulse%4==1 or e.pulse==58) then
   S.Visual:Fire({kind="RikudoPulse",key=view.key,radius=radius,at=e.at})
  end
 elseif e.kind=="Completed" or e.kind=="Cancelled" then finish(r,e.id);S.Event:Fire(p,e,0) end
end
function S.Update(now:number)
 local h=hooks;if not h then return end
 for _,p in Players:GetPlayers() do
  local r=bind(p,now);if not r then continue end
  local grant,castId=Kcm.RikudoGrant(p,now)
  if not grant or (r.kcmCast and r.kcmCast~=castId) or not Damage.CanAct(r.model) then cancel(r) end
  r.kcmCast=castId;publish(r,grant)
  if grant then
   local events=Domain.update(r.state,now,function():number return h.strength(p) end)
   for _,e in events do apply(p,r,e,now) end
  end
 end
 restore(now)
end
function S.Reset()
 for _,r in records do cancel(r);Domain.reset(r.state,epoch(),r.state.life);publish(r,nil);r.kcmCast=nil end
 restore(workspace:GetServerTimeNow(),true)
 table.clear(retained)
end
function S.Start(h:Hooks) assert(not hooks,"Ranged hooks already configured");hooks=h end
return S
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="246">
          <Properties>
            <string name="Name">NarutoSleepService</string>
            <string name="Source"><![CDATA[--!strict
local Fighters=require(script.Parent.FighterStateService)
local Damage=require(script.Parent.DamageService)
local Teams=require(script.Parent.TeamService)
local Sleep=require(game.ReplicatedStorage.Shared.Abilities.SleepState)
local Service={}
local cosmetics: {[Model]: number}={}
function Service.CanWakeAlly(attacker: Model,target: Model): boolean
 if attacker==target or not Damage.CanAct(attacker) or not Damage.CanAct(target)
  or Teams.IsNeutral(attacker) or Teams.IsNeutral(target) or target:FindFirstChildOfClass("ForceField") then return false end
 local team=Teams.GetId(attacker)
 if not team or team~=Teams.GetId(target) or not Teams.IsActive(team) then return false end
 local kind=target:GetAttribute("EntityKind")
 if kind~="Hero" and kind~="Minion" and kind~="Summon" then return false end
 local fighter=Fighters.Get(target)
 return fighter~=nil and Sleep.isActive(fighter.sleep,workspace:GetServerTimeNow())
end
function Service.TryWakeAlly(attacker: Model,target: Model): boolean
 if not Service.CanWakeAlly(attacker,target) then return false end
 local fighter=Fighters.Get(target); assert(fighter)
 -- Wake is not damage: no rewards, offensive procs, or friendly-fire exception.
 Fighters.WakeSleep(fighter); return true
end
function Service.Apply(caster: Model,target: Model,now: number): boolean
 if not Damage.CanDamage(caster,target) or target:FindFirstChildOfClass("ForceField") then return false end
 local kind=target:GetAttribute("EntityKind")
 if kind~="Hero" and kind~="Minion" and kind~="Summon" then return false end
 local fighter=Fighters.GetOrCreate(target); if not fighter then return false end
 Fighters.Sleep(fighter,now)
 -- Five noncombat silhouettes: no humanoids, scripts, tags, collision or targeting.
 local folder=Instance.new("Model"); folder.Name="SleepCosmetics"
 local previous=caster.Archivable; caster.Archivable=true
 for i=1,5 do
  local copy=caster:Clone()
  for _,tag in game:GetService("CollectionService"):GetTags(copy) do game:GetService("CollectionService"):RemoveTag(copy,tag) end
  for name in copy:GetAttributes() do copy:SetAttribute(name,nil) end
  for _,item in copy:GetDescendants() do
   if item:IsA("LuaSourceContainer") or item:IsA("Humanoid") or item:IsA("Tool") then item:Destroy()
   elseif item:IsA("BasePart") then item.Anchored=true; item.CanCollide=false; item.CanTouch=false; item.CanQuery=false; item.Transparency=math.max(.5,item.Transparency) end
  end
  local angle=2*math.pi*i/5
  local point=fighter.root.Position+Vector3.new(math.cos(angle),0,math.sin(angle))*7.5
  copy:PivotTo(CFrame.lookAt(point,fighter.root.Position)); copy.Parent=folder
 end
 caster.Archivable=previous; folder.Parent=workspace; cosmetics[folder]=now+3
 return true
end
function Service.Update(now: number)
 for model,deadline in cosmetics do if now>=deadline then cosmetics[model]=nil; model:Destroy() end end
end
function Service.Reset()
 for model in cosmetics do model:Destroy() end; table.clear(cosmetics)
 for _,fighter in Fighters.GetAll() do Fighters.WakeSleep(fighter) end
end
Damage.Applied.Event:Connect(function(_attacker: Model,target: Model)
 local fighter=Fighters.Get(target); if fighter then Fighters.WakeSleep(fighter) end
end)
Damage.AttackAttempt.Event:Connect(function(_attacker: Model,target: Model)
 local fighter=Fighters.Get(target); if fighter then Fighters.WakeSleep(fighter) end
end)
return Service
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="247">
          <Properties>
            <string name="Name">NarutoSummonService</string>
            <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Definitions = require(Shared.Abilities.NarutoDefinitions)
local Units = require(Shared.Abilities.WorldUnits)
local Domain = require(Shared.Abilities.CloneState)
local Commands = require(Shared.Abilities.CloneCommands)
local Formulas = require(Shared.Abilities.NarutoRules).configure(Definitions)
local Combat = require(Shared.Config.CombatConfig)
local Fighters = require(script.Parent.FighterStateService)
local Damage = require(script.Parent.DamageService)
local Stats = require(script.Parent.CharacterStatsService)
local Targets = require(script.Parent.AbilityTargetService)
local Push = require(script.Parent.AbilityDisplacementService)
local Oil=require(script.Parent.OilStatusService)
local Navigation = require(script.Parent.CloneNavigation)
local Collision = require(script.Parent.SummonCollision)
local Autonomy = require(Shared.Abilities.CloneAutonomyPolicy)
local Formation = require(Shared.Abilities.CloneNavigationPolicy)
export type Record = { model: Model, root: BasePart, humanoid: Humanoid, owner: Player, state: Domain.State,
	clone: Domain.Clone, commands: Commands.State, nextHit: number, attackDamage: number,
	autoTarget: Model?, nextScan: number, lastOrder: number, recallUntil: number, returning: boolean,
	assignedTarget: Model?, lastStrike: number }
local Service = { Spawned = Instance.new("BindableEvent") }
local records: { [Model]: Record } = {}
local targetSerial = 0
local nextFormation = 0
local function coordinate(now: number)
	if now < nextFormation then return end; nextFormation = now + .2
	local groups: { [Model]: { Record } } = {}
	for _, record in records do
		local target = record.assignedTarget
		if target and record.humanoid.Health > 0 and Damage.CanDamage(record.model, target) then
			if not groups[target] then groups[target] = {} end
			table.insert(groups[target], record)
		end
	end
	for target, group in groups do
		-- Clones that have not struck yet get the next free place. Regular attack cooldowns remain intact.
		table.sort(group, function(a: Record, b: Record): boolean
			if a.lastStrike ~= b.lastStrike then return a.lastStrike < b.lastStrike end
			if a.owner.UserId ~= b.owner.UserId then return a.owner.UserId < b.owner.UserId end
			return a.clone.id < b.clone.id
		end)
		for index, record in group do Navigation.SetFrontline(record.model, target, index <= Formation.FrontlineLimit) end
	end
end
local function targetScore(record: Record, target: Model, root: BasePart, assistId: string?): number
	local assigned = 0
	for _, other in records do
		if other ~= record and other.assignedTarget == target and other.humanoid.Health > 0 then assigned += 1 end
	end
	return (root.Position - record.root.Position).Magnitude + assigned * Autonomy.CrowdCost
		- (if assistId and target:GetAttribute("AbilityEntityId") == assistId then Autonomy.AssistBonus else 0)
end
local function targetId(model: Model): string
	local id = model:GetAttribute("AbilityEntityId")
	if typeof(id) == "string" then return id end
	targetSerial += 1; id = "entity-" .. tostring(targetSerial); model:SetAttribute("AbilityEntityId", id); return id :: string
end
function Service.EntityId(model: Model): string return targetId(model) end
function Service.GetAll(): { [Model]: Record } return records end
function Service.GetCount(): number local count = 0; for _ in records do count += 1 end; return count end
function Service.Remove(model: Model)
	local record = records[model]; if not record then return end
	Navigation.Remove(model); records[model] = nil; Domain.remove(record.state, record.clone); Fighters.Remove(model); model:Destroy()
end
function Service.ClearOwner(player: Player)
	for model, record in records do if record.owner == player then Service.Remove(model) end end
end
function Service.Reset() for model in records do Service.Remove(model) end end
function Service.Spawn(player: Player, character: Model, state: Domain.State, clone: Domain.Clone, commands: Commands.State): Model?
	local sourceRoot = character:FindFirstChild("HumanoidRootPart"); local sourceHumanoid = character:FindFirstChildOfClass("Humanoid")
	if not sourceRoot or not sourceRoot:IsA("BasePart") or not sourceHumanoid or sourceHumanoid.Health <= 0 then Domain.remove(state, clone); return nil end
	local previous = character.Archivable; character.Archivable = true
	local model = character:Clone(); character.Archivable = previous
	local humanoid = model:FindFirstChildOfClass("Humanoid") :: Humanoid
	humanoid.EvaluateStateMachine = false
	for _, item in model:GetDescendants() do
		if item:IsA("LuaSourceContainer") or item:IsA("Tool") or item:IsA("ForceField") then item:Destroy()
		elseif item:IsA("BasePart") then item.CanCollide = false; item.CanTouch = false; item.Massless = true end
	end
	model:SetAttribute("OilUntil",nil); model:SetAttribute("OilMoveMultiplier",nil); model:SetAttribute("OilMissAt",nil); game:GetService("CollectionService"):RemoveTag(model,"GamakichiOilStatus")
	for _,key in {"SagePhase","SageRank","SageReadyAt","SageExpiresAt","SageAuraUntil"} do model:SetAttribute(key,nil) end
 game:GetService("CollectionService"):RemoveTag(model,"NarutoSage")
 model:SetAttribute("SleepUntil",nil); model:SetAttribute("RasenganVariant",nil); model:SetAttribute("RasenganVariantUntil",nil)
 require(script.Parent.HeroAppearanceService).Apply(model)
 model.Name = "ShadowClone"; model:SetAttribute("EntityKind", "Summon"); model:SetAttribute("NativeNarutoClone", true)
	model:SetAttribute("SummonOwner", player.UserId); model:SetAttribute("CombatDisabled", false)
	model:SetAttribute("AbilityId", ""); model:SetAttribute("AbilityEntityId", nil); model:SetAttribute("LifeId", nil)
	model:SetAttribute("RasenganPhase", ""); model:SetAttribute("RasenganSelfPauseUntil", 0)
	model:SetAttribute("CombatState", "Idle"); model:SetAttribute("RasenganHeld", clone.hasPayload); model:SetAttribute("RasenganVisible", clone.hasPayload)
	model:SetAttribute("RasenganExpiresAt", clone.expiresAt)
	model:SetAttribute("OutgoingDamageMultiplier", clone.outgoingMultiplier); model:SetAttribute("IncomingDamageMultiplier", clone.incomingMultiplier)
	local root = model:FindFirstChild("HumanoidRootPart") :: BasePart
	-- Navigation owns movement. Collision groups also protect against copied-rig
	-- initialization restoring CanCollide after these explicit flags are set.
	-- Explicit prototype inheritance policy: copy current/max HP once, without .05 scaling.
	humanoid.WalkSpeed=Stats.Get(player).WalkSpeed; humanoid.MaxHealth = sourceHumanoid.MaxHealth; humanoid.Health = sourceHumanoid.Health
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None; humanoid.BreakJointsOnDeath = false
	root.Anchored = true; model.PrimaryPart = root
	-- Give each new clone its own spawn position, including a mass cast.
	local offset = Vector3.zero
	for index = 1, 80 do
		local x, z = Formation.slot(index, math.max(4.2, sourceRoot.Size.X * 2), 3)
		local candidate = sourceRoot.CFrame:VectorToWorldSpace(Vector3.new(x, 0, z))
		local free = true
		for _, other in records do
			if (other.root.Position - (sourceRoot.Position + candidate)).Magnitude < 2.5 then free = false; break end
		end
		if free then offset = candidate; break end
	end
	local ray = RaycastParams.new(); ray.FilterType = Enum.RaycastFilterType.Exclude; ray.FilterDescendantsInstances = { character }; ray.RespectCanCollide = true
	local wall = workspace:Blockcast(sourceRoot.CFrame, sourceRoot.Size, offset, ray)
	if wall and offset.Magnitude > 0 then offset = offset.Unit * math.max(0, wall.Distance - 0.01) end
	local folder = workspace:FindFirstChild("HeroSummons")
	if not folder then folder = Instance.new("Folder"); folder.Name = "HeroSummons"; folder.Parent = workspace end
	Collision.Apply(model)
	model:PivotTo(character:GetPivot() + offset); model.Parent = folder
	local stats = Stats.Get(player)
	records[model] = { model = model, root = root, humanoid = humanoid, owner = player, state = state, clone = clone,
		assignedTarget = nil, lastStrike = 0,
		autoTarget = nil, nextScan = 0, lastOrder = commands.lastRequest, recallUntil = 0, returning = false,
		commands = commands, nextHit = 0, attackDamage = Combat.Profiles.OrangeNinja.CloneDamage * stats.AttackDamageMultiplier + stats.AttackDamageBonus }
	Navigation.Register(model, root, humanoid)
	Fighters.GetOrCreate(model); Service.Spawned:Fire(model)
	return model
end
function Service.Update(now: number, delta: number, sourceStats: (Player) -> (number, number))
	coordinate(now)
	for model, record in records do
		record.assignedTarget = nil
		local clone, owner = record.clone, record.owner
		if not model.Parent or record.humanoid.Health <= 0 or owner.Parent ~= Players or now >= clone.expiresAt
			or record.root.Position.Y < workspace.FallenPartsDestroyHeight
			or record.state.clones[clone.id] ~= clone then Service.Remove(model); continue end
		model:SetAttribute("RasenganHeld", clone.hasPayload); model:SetAttribute("RasenganVisible", clone.hasPayload)
		local character = owner.Character
		-- Gravity runs before orders/control locks, so Hold and owner death cannot freeze a falling clone.
		if not Navigation.Settle(model, character or model, delta) then
			model:SetAttribute("SummonBehavior", "Landing"); Navigation.Stop(model); continue
		end
		local fighter = Fighters.Get(model)
		if fighter and (fighter.logic.mode == "Stunned" or (fighter.sleep and fighter.sleep.active)) then Navigation.Stop(model); continue end
		local intent = Commands.resolve(record.commands)
		if record.lastOrder ~= record.commands.lastRequest then
			record.lastOrder = record.commands.lastRequest; record.autoTarget = nil; record.nextScan = 0
			record.returning = intent.mode == "Follow"
			record.recallUntil = if record.returning then now + Autonomy.RecallGrace else 0
		end
		if not character or not Damage.CanAct(character) or intent.mode == "Idle" or intent.mode == "Hold" then
			record.autoTarget = nil; model:SetAttribute("SummonBehavior", intent.mode); Navigation.Stop(model); continue
		end
		local ownerRoot = character:FindFirstChild("HumanoidRootPart")
		if not ownerRoot or not ownerRoot:IsA("BasePart") then Navigation.Stop(model); continue end
		local ownerDistance = (ownerRoot.Position - record.root.Position).Magnitude
		if ownerDistance > Autonomy.OwnerLeash then record.returning = true end
		if record.returning and ownerDistance < Autonomy.ReturnRadius and now >= record.recallUntil then record.returning = false end
		local target: Model? = nil
		if intent.targetId and intent.mode == "Command" then
			for candidate in Fighters.GetAll() do
				if candidate:GetAttribute("AbilityEntityId") == intent.targetId then target = candidate; break end
			end
			if not target or not Damage.CanDamage(model, target) then Commands.invalidateTarget(record.commands, intent.targetId); target = nil end
		end
		if not target and not record.returning then
			local current = record.autoTarget
			local currentRoot = if current then current:FindFirstChild("HumanoidRootPart") else nil
			if not current or not currentRoot or not currentRoot:IsA("BasePart") or not Damage.CanDamage(model, current)
				or (currentRoot.Position - record.root.Position).Magnitude > Autonomy.PursueRadius
				or (currentRoot.Position - ownerRoot.Position).Magnitude > Autonomy.OwnerLeash then record.autoTarget = nil end
			if now >= record.nextScan then
				record.nextScan = now + Autonomy.ScanInterval
				-- Rebalance with hysteresis: a moving crowd cannot strand clones on one enemy,
				-- while small distance changes do not make the entire group swap targets.
				local best = record.autoTarget
				local bestRoot = if best then best:FindFirstChild("HumanoidRootPart") else nil
				local bestScore = if best and bestRoot and bestRoot:IsA("BasePart") then targetScore(record, best, bestRoot, intent.targetId) - Autonomy.SwitchMargin else math.huge
				if now >= record.nextHit - 1.7 then
					for _, enemy in Targets.InCone(model, record.root.CFrame, Autonomy.AcquireRadius, -1, false, 16) do
						local candidate = enemy.Parent
						local candidateRoot = if candidate then candidate:FindFirstChild("HumanoidRootPart") else nil
						if candidate and candidate:IsA("Model") and candidateRoot and candidateRoot:IsA("BasePart")
							and (candidateRoot.Position - ownerRoot.Position).Magnitude <= Autonomy.OwnerLeash then
							local score = targetScore(record, candidate, candidateRoot, intent.targetId)
							if score < bestScore then best = candidate; bestScore = score end
						end
					end
				end
				record.autoTarget = best
			end
			target = record.autoTarget
		else record.autoTarget = nil end
		record.assignedTarget = target
		model:SetAttribute("SummonBehavior", if target then "Attack" elseif record.returning then "Return" else "Follow")
		model:SetAttribute("SummonTarget", if target then target.Name else "")
		local destination = if target then target:FindFirstChild("HumanoidRootPart") else character:FindFirstChild("HumanoidRootPart")
		if not destination or not destination:IsA("BasePart") then Navigation.Stop(model); continue end
		local distance = destination.Position - record.root.Position
		local flat = distance * Vector3.new(1, 0, 1)
		local stop = if target then Units.toStuds(50) + (record.root.Size.X + destination.Size.X) / 2 else record.root.Size.X * 3
		if flat.Magnitude > 0.001 then record.root.CFrame = CFrame.lookAt(record.root.Position, record.root.Position + flat) end
		if target and Navigation.CanStrike(model, target) and Damage.CanDamage(model, target) and distance.Magnitude <= stop + 0.01 and now >= record.nextHit and Targets.Visible(model, target, record.root.Position, destination.Position) then
			record.nextHit = now + 2 -- Hpal ua1c; M1 damage itself retains current prototype combat balance.
			record.lastStrike = now
			model:SetAttribute("SummonSwingAt", now); model:SetAttribute("SummonSwingStep", 1)
			local humanoid = target:FindFirstChildOfClass("Humanoid")
			if humanoid then
				local payload = Domain.takePayload(record.state, clone, now, targetId(target), true, target:GetAttribute("EntityKind") ~= "Hero" and target:GetAttribute("EntityKind") ~= "Minion" and target:GetAttribute("EntityKind") ~= "Summon")
				if payload and Domain.claimPayload(record.state, payload) then
					local level, strength = sourceStats(owner)
					local raw = Formulas.clonePayloadDamage(level, strength)
					if raw then Damage.Apply(character, humanoid, raw) end
					local round, life = record.state.round, record.state.life
					Push.Begin(character, target, now, 0.5, 0.5, 12, 12, 0.01, function()
						return record.state.round == round and record.state.life == life and Damage.CanDamage(character, target :: Model)
					end)
				end
				Damage.ApplyAttack(model, humanoid, record.attackDamage)
			end
		end
		local moving = Navigation.Step(model, character, target or character, destination, stop, now, delta,
			Units.toStuds(Definitions.NativeInference.BaseSpeedWarcraft) * Oil.Movement(model, now))
		model:SetAttribute("SummonMoving", moving)
	end
end
return Service
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="248">
          <Properties>
            <string name="Name">OilStatusService</string>
            <string name="Source"><![CDATA[--!strict
local Shared=game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Rules=require(Shared.Abilities.GamakichiSpells)
local Fighters=require(script.Parent.FighterStateService)
local Teams=require(script.Parent.TeamService)
type Record={state: Rules.Debuff,round: number}
local records: {[Model]: Record}={}
local random=Random.new()
local Service={}
local function publish(model: Model,r: Record,now: number)
 local ends=Rules.untilAt(r.state,now)
 local tags=game:GetService("CollectionService")
 if ends>now then tags:AddTag(model,"GamakichiOilStatus") else tags:RemoveTag(model,"GamakichiOilStatus") end
 model:SetAttribute("OilUntil",if ends>now then ends else nil)
 model:SetAttribute("OilMoveMultiplier",if ends>now then 1-Rules.Oil.MoveReduction else nil)
 Fighters.SetWalkSpeed(model,Fighters.GetWalkSpeed(model))
end
function Service.Apply(model: Model,key: string,now: number)
 local match=Teams.GetState(); local round=if match then match.roundId else 0
 local r=records[model]
 if not r or r.round~=round then r={state=Rules.debuff(),round=round}; records[model]=r end
 Rules.apply(r.state,key,now); publish(model,r,now)
end
function Service.ClearSource(key: string)
 local now=workspace:GetServerTimeNow()
 for model,r in records do Rules.clear(r.state,key); publish(model,r,now) end
end
function Service.Movement(model: Model,now: number): number
 local r=records[model]; return if r then Rules.movement(r.state,now) else 1
end
function Service.MissesAttack(model: Model): boolean
 local r=records[model]; local now=workspace:GetServerTimeNow()
 local missed=r~=nil and Rules.misses(r.state,now,random:NextNumber())
 if missed then model:SetAttribute("OilMissAt",now) end
 return missed
end
function Service.Update(now: number)
 local match=Teams.GetState()
 for model,r in records do
  local hp=model:FindFirstChildOfClass("Humanoid")
  if not model.Parent or not hp or hp.Health<=0 or (match and (match.roundId~=r.round or match.phase~="InProgress")) then table.clear(r.state.grants) end
  if Rules.untilAt(r.state,now)==0 then publish(model,r,now); records[model]=nil end
 end
end
function Service.Reset()
 local now=workspace:GetServerTimeNow()
 for model,r in records do table.clear(r.state.grants); publish(model,r,now) end
 table.clear(records)
end
return Service
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="249">
          <Properties>
            <string name="Name">RasenshurikenMeleeService</string>
            <string name="Source"><![CDATA[--!strict
-- Bounded melee-only adapter. 0.04 cadence over 3.5s is an explicit scheduling policy.
local Shared=game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local V=require(Shared.Abilities.RasenganVariants)
local AreaRules=require(Shared.Abilities.RasenshurikenThrowRules)
local Structures=require(Shared.Game.StructureRules)
local Units=require(Shared.Abilities.WorldUnits)
local Fighters=require(script.Parent.FighterStateService)
local Damage=require(script.Parent.DamageService)
type Area={id:number,at:number,caster: Model,target: Model,nextAt: number,untilAt: number,tick: number,valid: ()->boolean,strength: ()->number}
local areas: {Area}={}
local serial=0
local Service={Visual=Instance.new("BindableEvent")}
function Service.Begin(caster: Model,target: Model,now: number,valid: ()->boolean,strength: ()->number,snapshot: number)
 if not valid() then return end
 local hp=caster:FindFirstChildOfClass("Humanoid")
 if hp then hp:TakeDamage(V.selfDamage(snapshot)) end
 if not valid() then return end
 serial-=1
 Service.Visual:Fire({kind="RasenshurikenArea",id=serial,startAt=now,source=target,position=target:GetPivot().Position,radius=Units.toStuds(300)})
 table.insert(areas,{id=serial,at=now,caster=caster,target=target,nextAt=now,untilAt=now+3.5,tick=0,valid=valid,strength=strength})
end
function Service.Update(now: number)
 for i=#areas,1,-1 do
  local area=areas[i]
  if not area.valid() or not area.target.Parent then Service.Visual:Fire({kind="RasenshurikenAreaEnd",id=area.id,position=Vector3.zero});table.remove(areas,i); continue end
  while area.nextAt<=now and area.nextAt<area.untilAt do
   local root=area.target:FindFirstChild("HumanoidRootPart"); if not root or not root:IsA("BasePart") then break end
   local center=root.Position
   local radius=Units.toStuds(AreaRules.radiusForTick(area.tick+1))
   for model,victim in Fighters.GetAll() do
    local offset=center-victim.root.Position
    if offset.Magnitude<=radius and not Structures.isStructure(model:GetAttribute("EntityKind")) and Damage.CanDamage(area.caster,model) then
     Damage.Apply(area.caster,victim.humanoid,AreaRules.pulse(area.strength()))
     local flat=offset*Vector3.new(1,0,1)
     if flat.Magnitude>.001 and not victim.root.Anchored then
      local step=flat.Unit*math.min(Units.toStuds(4),flat.Magnitude)
      local ray=RaycastParams.new(); ray.FilterType=Enum.RaycastFilterType.Exclude; ray.FilterDescendantsInstances={model,area.caster}; ray.RespectCanCollide=true
      if not workspace:Blockcast(victim.root.CFrame,victim.root.Size,step,ray) then victim.root.CFrame+=step end
     end
    end
   end
   area.tick+=1; area.nextAt=area.at+area.tick*AreaRules.Interval
  end
  if now>=area.untilAt then table.remove(areas,i) end
 end
end
function Service.Reset() table.clear(areas) end
return Service
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="250">
          <Properties>
            <string name="Name">RasenshurikenThrowService</string>
            <string name="Source"><![CDATA[--!strict
local Shared=game.ReplicatedStorage.Shared
local Rules=require(Shared.Abilities.RasenshurikenThrowRules)
local Units=require(Shared.Abilities.WorldUnits)
local Structures=require(Shared.Game.StructureRules)
local Damage=require(script.Parent.DamageService)
local Fighters=require(script.Parent.FighterStateService)
type Flight={id:number,source:Model,origin:Vector3,direction:Vector3,at:number,distance:number,strength:()->number,valid:()->boolean}
type Area={id:number,tick:number,source:Model,position:Vector3,at:number,nextAt:number,strength:()->number,valid:()->boolean}
local flights:{Flight}={};local areas:{Area}={};local serial=0
local S={Visual=Instance.new("BindableEvent")}
local function params(source:Model):RaycastParams
 local p=RaycastParams.new();p.FilterType=Enum.RaycastFilterType.Exclude;p.RespectCanCollide=true
 local excluded:{Instance}={source}
 for model in Fighters.GetAll() do table.insert(excluded,model) end
 p.FilterDescendantsInstances=excluded;return p
end
function S.Begin(source:Model,aim:Vector3,now:number,strength:()->number,valid:()->boolean):boolean
 local root=source:FindFirstChild("HumanoidRootPart")
 if not root or not root:IsA("BasePart") or not Rules.finite(aim.X) or not Rules.finite(aim.Y) or not Rules.finite(aim.Z) then return false end
 local origin=root.Position+Vector3.new(0,2,0);local delta=aim-origin
 if delta.Magnitude<.1 or #flights>=32 then return false end
 serial+=1
 local flight:Flight={id=serial,source=source,origin=origin,direction=delta.Unit,at=now+Rules.Windup,distance=0,strength=strength,valid=valid}
 table.insert(flights,flight)
 S.Visual:Fire({kind="RasenshurikenFlight",id=serial,source=source,position=origin,direction=flight.direction,releaseAt=flight.at,speed=Rules.Speed,range=Rules.Range})
 return true
end
function S.Update(now:number)
 for i=#flights,1,-1 do
  local f=flights[i]
  if not f.valid() then S.Visual:Fire({kind="RasenshurikenFlightEnd",id=f.id,position=f.origin});table.remove(flights,i);continue end
  if now<f.at then continue end
  local distance=math.min(Rules.Range,(now-f.at)*Rules.Speed)
  local from=f.origin+f.direction*f.distance;local travel=distance-f.distance
  if travel<=0 then continue end
  local ray=workspace:Spherecast(from,.8,f.direction*travel,params(f.source))
  local nearest=if ray then ray.Distance else travel+1
  local hit:Model?=nil
  for model,fighter in Fighters.GetAll() do
   if not Damage.CanDamage(f.source,model) then continue end
   local offset=fighter.root.Position-from;local along=math.clamp(offset:Dot(f.direction),0,travel)
   local radius=math.min(4,math.max(fighter.root.Size.X,fighter.root.Size.Y,fighter.root.Size.Z)*.5)+.8
   if (offset-f.direction*along).Magnitude<=radius and along<nearest then nearest=along;hit=model end
  end
  f.distance=distance
  if hit or ray or distance>=Rules.Range then
   local position=from+f.direction*math.min(travel,nearest)
   if hit then local fighter=Fighters.Get(hit);if fighter then Fighters.StunSpell(fighter,4.5) end end
   table.insert(areas,{id=f.id,tick=0,source=f.source,position=position,at=now+Rules.ImpactDelay,nextAt=now+Rules.ImpactDelay,strength=f.strength,valid=f.valid})
   S.Visual:Fire({kind="RasenshurikenDetonate",id=f.id,position=position,radius=Units.toStuds(Rules.Radius),startAt=now+Rules.ImpactDelay,duration=Rules.Duration})
   table.remove(flights,i)
  end
 end
 for i=#areas,1,-1 do
  local a=areas[i]
  if not a.valid() or now>=a.at+Rules.Duration then S.Visual:Fire({kind="RasenshurikenAreaEnd",id=a.id,position=a.position});table.remove(areas,i);continue end
  while a.nextAt<=now and a.nextAt<a.at+Rules.Duration do
   local radius=Units.toStuds(Rules.radiusForTick(a.tick+1))
   local rayParams=params(a.source)
   for model,fighter in Fighters.GetAll() do
    local delta=fighter.root.Position-a.position
    if delta.Magnitude<=radius and not Structures.isStructure(model:GetAttribute("EntityKind")) and Damage.CanDamage(a.source,model) and (delta.Magnitude<.01 or not workspace:Raycast(a.position,delta,rayParams)) then
     Damage.Apply(a.source,fighter.humanoid,Rules.pulse(a.strength()))
     local pull=-delta*Vector3.new(1,0,1)
     if pull.Magnitude>.001 and not fighter.root.Anchored then
      local step=pull.Unit*math.min(Units.toStuds(4),pull.Magnitude)
      if not workspace:Blockcast(fighter.root.CFrame,fighter.root.Size,step,rayParams) then fighter.root.CFrame+=step end
     end
    end
   end
   a.tick+=1;a.nextAt=a.at+a.tick*Rules.Interval
  end
 end
end
function S.Reset() table.clear(flights);table.clear(areas) end
return S
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="251">
          <Properties>
            <string name="Name">RequestLimiter</string>
            <string name="Source"><![CDATA[--!strict

-- Pure token bucket. Its instances live only on the server, one per player.
export type Bucket = {
	tokens: number,
	updatedAt: number,
	capacity: number,
	refillRate: number,
}

local RequestLimiter = {}

function RequestLimiter.new(capacity: number, refillRate: number, now: number): Bucket
	assert(capacity > 0 and refillRate > 0, "Rate limit must be positive")
	return { tokens = capacity, updatedAt = now, capacity = capacity, refillRate = refillRate }
end

function RequestLimiter.Consume(bucket: Bucket, now: number): boolean
	local elapsed = math.max(0, now - bucket.updatedAt)
	bucket.tokens = math.min(bucket.capacity, bucket.tokens + elapsed * bucket.refillRate)
	bucket.updatedAt = math.max(bucket.updatedAt, now)
	if bucket.tokens < 1 then
		return false
	end
	bucket.tokens -= 1
	return true
end

return RequestLimiter
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="252">
          <Properties>
            <string name="Name">RewardService</string>
            <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config.ProgressionConfig)
local Rules = require(Shared.Game.RewardRules)
local Life = require(script.Parent.CombatLifeService)
local Teams = require(script.Parent.TeamService)
local Progression = require(script.Parent.HeroProgressionService)
local Economy = require(script.Parent.EconomyService)
local Reward = {}
local started = false
local nextPassive = 0
-- Match scoreboard projection survives individual profile removal/reconnect.
local teamKills: { [string]: number } = {}
function Reward.GetTeamKills(id: string): number return teamKills[id] or 0 end
local awarded: { [Model]: number } = setmetatable({}, { __mode = "k" })
local function death(event: Life.Death)
 if awarded[event.model] == event.lifeId then return end
 awarded[event.model] = event.lifeId
 local state = Teams.GetState()
 if not state or event.roundId ~= state.roundId or state.phase ~= "InProgress" or not (Teams.IsActive(event.teamId) or Teams.IsNeutral(event.model)) then return end
 -- Elimination and match shutdown never turn into bounty events.
 if event.killer and not Teams.IsActive(event.killer.teamId) then event.killer = nil end
 local samples: { Rules.PlayerSample } = {}
 local recipients: { [number]: Player } = {}
 for _, player in Players:GetPlayers() do
  recipients[player.UserId] = player
  local model = player.Character
  local humanoid = if model then model:FindFirstChildOfClass("Humanoid") else nil
  local root = if model then model:FindFirstChild("HumanoidRootPart") else nil
  table.insert(samples, { userId = player.UserId, teamId = tostring(player:GetAttribute("TeamId") or ""),
   active = Economy.IsEligible(player), alive = humanoid ~= nil and humanoid.Health > 0,
   inRange = root ~= nil and root:IsA("BasePart") and (root.Position - event.position).Magnitude <= Config.XPRange })
 end
 local minion = (Config.MinionRewards :: { [string]: Rules.Reward })[event.minionType]
 local plan = Rules.plan(event, samples, minion, Config.HeroReward, Config.AssistReward, true)
 for id, grant in plan do
  local player = recipients[id]
  if grant.XP > 0 then Progression.AddXP(player, grant.XP) end
  if grant.Gold > 0 then Economy.AddGold(player, grant.Gold, if grant.Assists > 0 then "Assist" else "Kill") end
  if grant.Kills > 0 then
   Progression.Increment(player, "TotalKills")
   local teamId = tostring(player:GetAttribute("TeamId") or "")
   teamKills[teamId] = (teamKills[teamId] or 0) + grant.Kills
  end
  if grant.Deaths > 0 then Progression.Increment(player, "TotalDeaths") end
  if grant.MinionKills > 0 then Progression.Increment(player, "TotalMinionKills") end
  if grant.Assists > 0 then Progression.Increment(player, "Assists") end
 end
end
function Reward.Update(now: number)
 local state = Teams.GetState()
 if not state or state.phase ~= "InProgress" then nextPassive = 0; return end
 if nextPassive == 0 then nextPassive = state.startedAt + Config.PassiveInterval end
 if now < nextPassive then return end
 nextPassive = now + Config.PassiveInterval
 for _, player in Players:GetPlayers() do Economy.AddGold(player, Config.PassiveGold, "Passive") end
end
function Reward.Reset() nextPassive = 0; table.clear(awarded); table.clear(teamKills); Life.ResetHistory() end
function Reward.Start()
 if started then return end; started = true
 Life.Died.Event:Connect(death)
end
return Reward
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="253">
          <Properties>
            <string name="Name">SasukeAbilityService</string>
            <string name="Source"><![CDATA[--!strict
-- Server-owned casts. Imported assets contain visual data only, never executable code.
local Players=game:GetService("Players")
local Run=game:GetService("RunService")
local Shared=game.ReplicatedStorage:WaitForChild("Shared")
local D=require(Shared.Abilities.SasukeDefinitions)
local Presentation=require(Shared.Abilities.SasukePresentation)
local Fire=require(script.Parent.SasukeFireService)
local Advanced=require(script.Parent.SasukeAdvancedService)
local Rules=require(Shared.Abilities.SasukeRules)
local Units=require(Shared.Abilities.WorldUnits)
local Stats=require(script.Parent.CharacterStatsService)
local Progress=require(script.Parent.HeroProgressionService)
local Resource=require(script.Parent.NarutoAbilityService)
local Damage=require(script.Parent.DamageService)
local Fighters=require(script.Parent.FighterStateService)
local Combat=require(script.Parent.CombatService)
local Service={Visual=Instance.new("BindableEvent")}
local sessions:{[Player]:any}={}
local actors:{[Model]:Humanoid}={}
local areas:{any}={}
local shots:{any}={}
local gravityAffected:{[Model]:boolean}={}
local started=false
local shotSerial=0
local areaSerial=0
local function clock():number return workspace:GetServerTimeNow() end
local function root(model:Model):BasePart? local r=model:FindFirstChild("HumanoidRootPart");return if r and r:IsA("BasePart") then r else nil end
local function valid(s:any):boolean return s.model==s.player.Character and s.model.Parent~=nil and Damage.CanAct(s.model) end
local function emit(s:any,id:string,position:Vector3,radius:number,duration:number,extra:any?)
 Service.Visual:Fire({kind="Sasuke",id=id,character=s.model,position=position,radius=radius,duration=duration,extra=extra,at=clock()})
end
local function session(player:Player):any
 local s=sessions[player]
 if not s or s.model~=player.Character then
  s={player=player,model=player.Character,ready={},mode=0,form=0,formUntil=0,held=false,heldUntil=0,readyAt=0,variant="Chidori",kirinAt=0,kirinUntil=0,kirinDamage=0,boosts=0,spheres={},sphereUntil=0,beasts=0,absorbed={},garuda=false,katanaUntil=0,nextTick=clock(),used={},pendingUntil=0}
  sessions[player]=s
 end
 return s
end
function Service.Ready(player:Player):{[string]:number} local s=sessions[player];return if s then s.ready else {} end
local function publish(s:any)
 local m=s.model;if not m or not m.Parent then return end
 m:SetAttribute("SasukeMode",s.mode);m:SetAttribute("SusanooForm",s.form)
 m:SetAttribute("ChidoriHeld",s.held);m:SetAttribute("ChidoriReadyAt",s.readyAt);m:SetAttribute("ChidoriVariant",s.variant)
 m:SetAttribute("KirinReadyAt",s.kirinAt);m:SetAttribute("KirinUntil",s.kirinUntil)
 m:SetAttribute("ChibakuCount",#s.spheres);m:SetAttribute("SasukeBijuu",s.beasts);m:SetAttribute("GarudaActive",s.garuda)
 m:SetAttribute("SasukeCastUntil",s.pendingUntil);m:SetAttribute("AmenotejikaraSelectingUntil",if s.amenoTarget then s.amenoUntil else 0)
 for id in D.Spells do
  local summon=if id=="AodaBind" or id=="AodaGuardSelf" then require(script.Parent.SasukeSummonService).Get(m) else nil
  m:SetAttribute("Ready_"..id,if summon then summon.constrictAt else s.ready[D.cooldownKey(id)] or 0)
 end
end
local function form(s:any,value:number,untilAt:number)
 if s.form~=value then s.model:SetAttribute("SusanooFormAt",clock()) end
 s.form=value;s.formUntil=untilAt
 local stats=Stats.Get(s.player)
 Stats.SetLayer(s.model,"SasukeForm",if value==0 then nil else {health=if value==3 then 600 elseif value==4 then math.min(2000,200+200*s.beasts) else 0,armor=if value>=3 then 90 else 0,attack=if value>=3 then 300 elseif value==2 then .5*stats.Agility else .2*stats.Agility,speed=if value>=3 then Units.toStuds(100) else 0})
 local f=Fighters.GetOrCreate(s.model);if f then Fighters.SetAttackProfile(f,if value>=3 then "SasukeSusanoo" else "Sasuke") end
 publish(s)
end
local Enton=require(script.Parent.SasukeEntonService)
local Summons=require(script.Parent.SasukeSummonService)
local function off(s:any)
 Enton.Cancel(s);s.amaterasuComboUntil=0
 Advanced.Cancel(s);s.amenoTarget=nil;s.amenoBonusUntil=0
 Fire.Cancel(s,clock());s.model:SetAttribute("AmaterasuCoatingUntil",0)
 if s.blackArea then s.blackArea.controlUntil=0 end;s.model:SetAttribute("AmaterasuControlUntil",0)
 s.mode=0;s.garuda=false;s.model:SetAttribute("GarudaActive",false);s.held=false;s.spheres={};s.sphereGoal=nil
 s.technique=nil;s.pendingUntil=0
 local f=Fighters.Get(s.model);if f then Fighters.LockCast(f,0) end
 emit(s,"ChibakuEnd",s.model:GetPivot().Position,0,.1)
 local humanoid=s.model:FindFirstChildOfClass("Humanoid");if humanoid and s.groundHip then humanoid.HipHeight=s.groundHip end
 Stats.SetLayer(s.model,"SasukeFlight",nil);form(s,0,0)
end
local function hurt(s:any,target:Model,amount:number,stun:number?):number
 local h=actors[target] or target:FindFirstChildOfClass("Humanoid");if not h then return 0 end
 local dealt=Damage.Apply(s.model,h,amount)
 if dealt>0 and stun and stun>0 then local f=Fighters.GetOrCreate(target);if f then Fighters.StunSpell(f,stun) end end
 return dealt
end
local function inArea(s:any,point:Vector3,radius:number,amount:number,stun:number?,seen:{[Model]:boolean}?)
 for model in actors do local r=root(model)
  if r and (r.Position-point).Magnitude<=radius and Damage.CanDamage(s.model,model) and (not seen or not seen[model]) then
   if seen then seen[model]=true end;hurt(s,model,amount,stun)
  end
 end
end
local function area(s:any,id:string,point:Vector3,radius:number,total:number,duration:number,follow:boolean?)
 if id=="Amaterasu" then Fire.Area(s,point,radius,total,clock(),follow);return end
 areaSerial+=1
 table.insert(areas,{s=s,id=id,serial=areaSerial,point=point,radius=radius,damage=total/math.max(1,math.ceil(duration/.5)),ticks=math.max(1,math.ceil(duration/.5)),next=clock()+.5,follow=follow})
 emit(s,id,point,radius,duration,{follow=follow,areaSerial=areaSerial})
end
local function terrain(s:any,ignore:Model?):RaycastParams
 local p=RaycastParams.new();local list:{Instance}={s.model}
 for model in actors do table.insert(list,model) end
 if ignore then table.insert(list,ignore) end
 p.FilterDescendantsInstances=list;p.RespectCanCollide=true;return p
end
local function destination(s:any,point:Vector3,model:Model?):CFrame?
 local m=model or s.model;local r=root(m);local h=m:FindFirstChildOfClass("Humanoid");if not r or not h then return nil end
 local p=terrain(s,m);local hit=workspace:Raycast(point+Vector3.new(0,8,0),Vector3.new(0,-24,0),p)
 if not hit or hit.Normal.Y<.7 then return nil end
 local cf=CFrame.new(hit.Position+Vector3.new(0,h.HipHeight+r.Size.Y/2+.1,0))*r.CFrame.Rotation
 local overlap=OverlapParams.new();overlap.FilterDescendantsInstances=p.FilterDescendantsInstances;overlap.RespectCanCollide=true
 local height=math.min(4.5,2*h.HipHeight+r.Size.Y)
 if #workspace:GetPartBoundsInBox(cf,Vector3.new(3,height,3),overlap)>0 then return nil end
 return cf
end
local function later(s:any,delay:number,callback:()->())
 local model=s.model;task.delay(delay,function() if s.model==model and valid(s) then callback() end end)
end
local function charge(s:any,id:string,now:number)
 s.held=true;s.variant=id;s.readyAt=now+.8;s.heldUntil=now+15
 emit(s,"Charge",s.model:GetPivot().Position,1,.8);publish(s)
end
local function projectile(s:any,id:string,point:Vector3,speed:number,radius:number,amount:number,burn:number?,stun:number?,origin:Vector3?)
 local r=root(s.model);if not r then return end
 local from=origin or r.Position+r.CFrame.LookVector*2;local direction=point-from
 if direction.Magnitude<.1 then direction=r.CFrame.LookVector end
 local distance=math.min(direction.Magnitude,Units.toStuds(D.Spells[id].range))
 local endPoint=from+direction.Unit*distance
 shotSerial+=1
 table.insert(shots,{serial=shotSerial,s=s,id=id,point=from,finish=endPoint,direction=direction.Unit,remaining=distance,speed=speed,radius=radius,damage=amount,burn=burn,stun=stun,single=id=="ChidoriSenbon"})
 emit(s,"Projectile",from,radius,distance/speed,{finish=endPoint,spell=id,serial=shotSerial})
end
Fire.Configure({emit=emit,hurt=hurt,canDamage=Damage.CanDamage,actors=actors,terrain=terrain,root=root,valid=valid,resource=Resource.Get,fighter=Fighters.GetOrCreate})
Advanced.Configure({emit=emit,hurt=hurt,canDamage=Damage.CanDamage,actors=actors,terrain=terrain,root=root,valid=valid,stats=Stats.Get,fighter=Fighters.GetOrCreate,lease=Fighters.LeaseNetworkOwnership,lock=Fighters.LockCast})
Enton.Configure({emit=emit,hurt=hurt,canDamage=Damage.CanDamage,actors=actors,terrain=terrain,root=root,valid=valid,fire=Fire,fighter=Fighters.GetOrCreate,lease=Fighters.LeaseNetworkOwnership,lock=Fighters.LockCast})
function Service.TryCast(player:Player,id:string,_request:number,now:number,target:any):(boolean,string)
 local d=D.Spells[id];local profile=Progress.Get(player);local r=if player.Character then root(player.Character) else nil
 if not d or not profile or not r or player:GetAttribute("HeroId")~="Sasuke" then return false,"Unavailable" end
 local s=session(player);local pool=Resource.Get(player);if not pool or not valid(s) then return false,"Unavailable" end
 local f=Fighters.GetOrCreate(s.model);if not f or f.logic.mode=="Stunned" or (f.sleep and f.sleep.active) then return false,"Контроль" end
 local rank=profile.Learned[d.line] or 0
 local reason=Rules.reason(id,{rank=rank,mode=s.mode,held=s.held,readyAt=s.readyAt,now=now,form=s.form,kirinAt=s.kirinAt,kirinUntil=s.kirinUntil,spheres=#s.spheres,beasts=s.beasts,garuda=s.garuda})
 if reason then return false,reason end
 if id=="AodaBind" or id=="AodaGuardSelf" then
  local chosen=if id=="AodaGuardSelf" then s.model else target
  if typeof(chosen)~="Instance" or not (chosen :: Instance):IsA("Model") then return false,"Выберите союзника или врага" end
  return Summons.Command(s.model,chosen :: Model,now)
 end
 if s.pendingUntil>now and id~="KirinBoost" and id~="SasukeModeOff" then return false,"Подготовка" end
 local steering=id=="Amaterasu" and s.blackArea and now<s.blackArea.controlUntil
 local noCD=Run:IsStudio() and player:GetAttribute("DeveloperNoCooldown")==true
 local secondAmeno=id=="Amenotejikara" and s.amenoTarget~=nil and s.amenoUntil>now
 local toggle=(id=="Sharingan" and s.mode>0) or (id=="Garuda" and s.garuda) or (id=="SusanooRibs" and s.form==1)
 local key=D.cooldownKey(id)
 if not noCD and not steering and not secondAmeno and not toggle and (s.ready[key] or 0)>now then return false,"Способность восстанавливается" end
 if s.used[id] then return false,"Один раз за форму" end
 local point=r.Position;local victim:Model?=nil
 if d.target~="Self" then
  if typeof(target)=="Vector3" and d.target~="Enemy" then point=target
  elseif typeof(target)=="Instance" and (target :: Instance):IsA("Model") and d.target~="Point" and Damage.CanDamage(s.model,target) then
   if (target :: Model):FindFirstChildOfClass("ForceField") then return false,"Цель защищена" end
   victim=target;local tr=root(target);if not tr then return false,"Недоступная цель" end;point=tr.Position
  else return false,"Нужна цель" end
  local range=Units.toStuds(if id=="SasukeGenjutsu" and s.mode==3 then 500 else d.range)
  if point.X~=point.X or point.Y~=point.Y or point.Z~=point.Z or (point-r.Position).Magnitude>range+1 then return false,"Слишком далеко" end
 end
 if steering then Fire.Steer(s,point,now);return true,"Cast" end
 if id=="Kirin" and victim then local kind=(victim :: Model):GetAttribute("EntityKind");if kind=="Tower" or kind=="Core" or kind=="Structure" then return false,"Выберите бойца" end end
 local teleport:CFrame?=nil;local swapOther:CFrame?=nil
 if id=="Amenotejikara" then
  if secondAmeno and victim then
   teleport=destination(s,point);swapOther=destination(s,r.Position,victim)
   if not teleport or not swapOther then return false,"Нет свободной поверхности" end
  elseif secondAmeno then
   local selected=s.amenoTarget;local tr=if selected.Parent then root(selected) else nil
   if not tr or not Damage.CanDamage(s.model,selected) or selected:FindFirstChildOfClass("ForceField") or (tr.Position-r.Position).Magnitude>Units.toStuds(900) or (point-tr.Position).Magnitude>Units.toStuds(900) then return false,"Цель вышла из радиуса переноса" end
   teleport=destination(s,point,selected);if not teleport then return false,"Нет свободной поверхности" end
  elseif not victim then
   local delta=point-r.Position;if delta.Magnitude>Units.toStuds(900) then point=r.Position+delta.Unit*Units.toStuds(900) end
   teleport=destination(s,point);if not teleport then return false,"Нет свободной поверхности" end
  end
 end
 if id=="Garuda" and not s.garuda then
  if profile.Level<13 then return false,"Гаруда доступна с 13 уровня" end
  if s.mode>0 or s.held then return false,"Завершите додзюцу и Чидори перед полётом" end
 end
 if id=="ChidoriEiso" and workspace:Raycast(r.Position,point-r.Position,terrain(s)) then return false,"Цель за препятствием" end
 if id=="ChakraAbsorb" then return false,"В этой версии поля боя нет источников чакры хвостатых" end
 if id=="PerfectSusanoo" then return false,"Сначала нужен источник чакры хвостатого" end
 if id=="KirinBoost" and s.boosts>=2 then return false,"Гроза уже усилена дважды" end
 local cost=if secondAmeno or toggle or id=="SasukeModeOff" then 0 else D.cost(id,rank)
 if id=="CompleteSusanoo" then cost+=pool.pool.maximum*.25 end
 if pool.pool.mana<cost then return false,"Недостаточно чакры" end
 pool.pool.mana-=cost;pool.nextPublish=0
 if not secondAmeno then s.ready[key]=now+(if noCD then 0 else D.cooldown(id,rank)) end
 local stats=Stats.Get(player);local agi,level,strength=stats.Agility,stats.Level,stats.Strength
 local radius=Units.toStuds(d.radius)
 if id=="SasukeModeOff" then off(s)
 elseif id=="Sharingan" then if s.mode>0 then off(s) else s.mode=1 end
 elseif id=="Mangekyo" then s.mode=if s.mode>=2 then 1 elseif rank==5 then 3 else 2;if s.mode==1 then form(s,0,0) end
 elseif id=="SusanooRibs" then form(s,if s.form==1 then 0 else 1,0)
 elseif id=="Susanoo" then form(s,2,now+30)
 elseif id=="CompleteSusanoo" then
  s.pendingUntil=now+3;emit(s,"Transform",r.Position,7,3)
  s.technique={id=id,readyAt=now+3,life=s.model:GetAttribute("LifeId"),round=s.model:GetAttribute("RoundId")};Fighters.LockCast(f,s.pendingUntil)
 elseif id=="Chidori" or id=="SusanooChidori" then charge(s,id,now)
 elseif id=="OnyxChidori" or id=="AmaterasuChidori" then s.variant=id
 elseif id=="ChidoriKatana" then s.katanaUntil=now+20;s.model:SetAttribute("SasukeKatanaUntil",s.katanaUntil);Stats.RecalculateStats(player);emit(s,"Katana",r.Position,1,20)
 elseif id=="ChidoriNagashi" then
  Stats.SetLayer(s.model,"SasukeNagashi",{health=0,armor=100,attack=0,speed=0});s.nagashiUntil=now+4
  s.nagashiTick=now+.05;emit(s,"Nagashi",r.Position,radius,4,{follow=true})
 elseif id=="ChidoriSenbon" then
  s.held=false;local delta=(point-r.Position)*Vector3.new(1,0,1);local aim=if delta.Magnitude>.01 then CFrame.lookAt(r.Position,r.Position+delta) else r.CFrame
  for _=1,8 do
   local dir=(aim*CFrame.Angles(0,math.rad(-80+math.random()*160),0)).LookVector
   local from=r.Position+dir*Units.toStuds(50+math.random()*70)
   if workspace:Raycast(r.Position,from-r.Position,terrain(s)) then from=r.Position end
   projectile(s,id,point,90,.7,15+.5*agi,nil,nil,from)
  end
 elseif id=="ChidoriEiso" then
  s.held=false;s.pendingUntil=now+1.25
  s.technique={id=id,target=victim,hitAt=now+.75,damage=380+3*agi,round=s.model:GetAttribute("RoundId"),life=s.model:GetAttribute("LifeId"),targetLife=(victim :: Model):GetAttribute("LifeId")}
  Fighters.LockCast(f,s.pendingUntil)
  emit(s,"Charge",r.Position,1,.75)
 elseif id=="SasukeFireball" or id=="PhoenixFlowers" then Fire.Cast(s,id,point,rank,agi,now)
 elseif id=="KirinPrepare" then s.kirinAt=now+4.5;s.kirinUntil=now+19.5;s.kirinDamage=100+30*level+3*strength;s.boosts=0;emit(s,"KirinPrepare",r.Position,4,4.5)
 elseif id=="KirinBoost" then s.boosts+=1;s.kirinDamage+=100+strength;emit(s,"KirinPrepare",r.Position,4,1)
 elseif id=="Kirin" then
  local amount=s.kirinDamage;s.kirinUntil=0;Advanced.Kirin(s,victim :: Model,amount,now)
 elseif id=="Amaterasu" then
  Fire.Area(s,point,radius,800+5*agi,now,false,true);s.amaterasuComboUntil=now+1;s.amaterasuPoint=point
  s.model:SetAttribute("EntonComboUntil",now+1)
 elseif id=="AmaterasuWall" then
  if s.form==1 then Fire.Coat(s,now) else Fire.Area(s,point,radius,800+5*agi,now,true) end
 elseif id=="EntonMagatama" then Enton.Cast(s,point,agi,now,true)
 elseif id=="Enton" then
  Enton.Cast(s,point,agi,now)
 elseif id=="Extinguish" then
  Fire.Extinguish(point,radius);emit(s,"Extinguish",point,radius,.4)
 elseif id=="EntonPull" then
  Advanced.Pull(s,now,agi)
 elseif id=="SasukeGenjutsu" and victim then
  local vf=Fighters.GetOrCreate(victim)
  if vf then
   Fighters.Sleep(vf,now)
   if vf.sleep then
    vf.sleep.untilAt=now+(if s.mode>=2 then 4 else 3)
    vf.sleep.wakeSlowDuration=if s.mode==3 then 6 else nil
    (victim :: Model):SetAttribute("SleepUntil",vf.sleep.untilAt);(victim :: Model):SetAttribute("SasukeGenjutsuUntil",vf.sleep.untilAt)
   end
  end
  emit(s,"Genjutsu",point,2,1,{rinnegan=s.mode==3})
 elseif id=="Amenotejikara" then
  if secondAmeno then
   if victim and teleport and swapOther then s.model:PivotTo(teleport);(victim :: Model):PivotTo(swapOther)
   elseif teleport then s.amenoTarget:PivotTo(teleport) end
   s.amenoTarget=nil
  elseif victim then s.amenoTarget=victim;s.amenoUntil=now+4
  elseif teleport then s.model:PivotTo(teleport);s.amenoBonusUntil=now+1 end
  emit(s,"Teleport",point,3,.5)
 elseif id=="ChibakuTensei" then
  s.spheres={};s.sphereGoal=nil;s.sphereUntil=now+30;s.pendingUntil=now+3
  s.technique={id=id,origin=r.Position,spawnAt=now+1,readyAt=now+3,round=s.model:GetAttribute("RoundId"),life=s.model:GetAttribute("LifeId")}
  Fighters.LockCast(f,s.pendingUntil);emit(s,"ChibakuEnd",r.Position,0,.1)
 elseif id=="ChibakuMove" then
  local center=Vector3.zero;for _,p in s.spheres do center+=p end;center/=#s.spheres
  local movement=point-center;s.sphereGoal={};for i,p in s.spheres do s.sphereGoal[i]=p+movement end
  emit(s,"ChibakuMove",point,Units.toStuds(400),movement.Magnitude/Units.toStuds(500),{points=s.sphereGoal})
 elseif id=="ChibakuDrop" then
  local points=s.spheres;s.spheres={};s.sphereGoal=nil;emit(s,"ChibakuDrop",r.Position,radius,.9,{points=points})
  later(s,.9,function() local seen={};for _,p in points do inArea(s,p,radius,400+3*agi,nil,seen);emit(s,"ChibakuImpact",p,radius,.6) end end)
 elseif id=="Aoda" then
  local ok=require(script.Parent.SasukeSummonService).Spawn(s.model,player,rank,point)
  if not ok then pool.pool.mana+=cost;s.ready[key]=now;return false,"Нет места для призыва" end
  emit(s,"Summon",point,3,.7)
 elseif id=="Garuda" then
  s.garuda=not s.garuda;local humanoid=s.model:FindFirstChildOfClass("Humanoid");if humanoid then s.groundHip=s.groundHip or humanoid.HipHeight;humanoid.HipHeight=s.groundHip+(if s.garuda then 4 else 0) end
  s.model:SetAttribute("GarudaActive",s.garuda);Stats.SetLayer(s.model,"SasukeFlight",nil);Stats.RecalculateStats(player)
  emit(s,"Summon",r.Position,3,.7)
 elseif id=="SusanooTriple" or id=="IndraArrow" then
  s.used[id]=true;local amount=if id=="SusanooTriple" then 600+3*agi elseif s.beasts>=7 then 800+5*agi else 700+4*agi
  s.pendingUntil=now+1.5;emit(s,"KirinWarning",point,radius,1.5)
  later(s,1.5,function() projectile(s,id,point,Units.toStuds(750),radius,amount) end)
 end
 local duration=Presentation.Casts[id]
 if s.enton then duration=(s.pendingUntil :: number)-now end
 if duration then s.model:SetAttribute("SasukeCastPose",id);s.model:SetAttribute("SasukeCastPoseAt",now);s.model:SetAttribute("SasukeCastPoseUntil",now+duration) end
 publish(s);return true,"Cast"
end
function Service.Reset()
 Fire.Reset();Advanced.Reset();Enton.Reset()
 for _,s in sessions do if s.model and s.model.Parent then off(s) end end
 table.clear(sessions);table.clear(areas);table.clear(shots)
 require(script.Parent.SasukeSummonService).Reset()
end
function Service.Update(now:number)
 local slowed:{[Model]:boolean}={}
 for player,s in sessions do
  if not valid(s) then
   if s.model and s.model.Parent then off(s);Stats.SetLayer(s.model,"SasukeKatana",nil);Stats.SetLayer(s.model,"SasukeNagashi",nil) end
   sessions[player]=nil;continue
  end
  local dt=math.clamp(now-s.nextTick,0,.5);s.nextTick=now
  local pool=Resource.Get(player)
  if pool then
   local drain=(if s.mode>0 then 10 else 0)+(if s.mode>=2 then 2 else 0)+(if s.form==1 then 4 else 0)+(if s.garuda then pool.pool.maximum*.017 else 0)
   pool.pool.mana=math.max(0,pool.pool.mana-drain*dt)
   if pool.pool.mana<=0 and drain>0 then off(s) end
  end
  Fire.UpdateCast(s,now)
  Enton.UpdateCast(s,now)
  Advanced.UpdateCast(s,now);Advanced.Nagashi(s,now)
  local cast=s.technique
  if cast then
   local f=Fighters.Get(s.model)
   if not f or f.logic.mode=="Stunned" or (f.sleep and f.sleep.active) or cast.life~=s.model:GetAttribute("LifeId") or cast.round~=s.model:GetAttribute("RoundId") then
    s.technique=nil;s.pendingUntil=0;if f then Fighters.LockCast(f,0) end
    if cast.id=="ChibakuTensei" then s.spheres={};s.sphereGoal=nil;emit(s,"ChibakuEnd",cast.origin,0,.1) end
   elseif cast.id=="CompleteSusanoo" and now>=cast.readyAt then
    s.technique=nil;if s.mode>=2 then form(s,3,now+30);s.used={} end
   elseif cast.id=="ChidoriEiso" and now>=cast.hitAt then
    s.technique=nil
    local target=cast.target;local tr=if target.Parent then root(target) else nil;local own=root(s.model)
    if tr and own and Damage.CanDamage(s.model,target) and not target:FindFirstChildOfClass("ForceField") and cast.targetLife==target:GetAttribute("LifeId") then
     local delta=tr.Position-own.Position
     if delta.Magnitude<=Units.toStuds(600)+1 and not workspace:Raycast(own.Position,delta,terrain(s)) then
      hurt(s,target,cast.damage,2);emit(s,"Eiso",own.Position,.3,.5,{finish=tr.Position,target=target})
     end
    end
   elseif cast.id=="ChibakuTensei" then
    if not cast.spawned and now>=cast.spawnAt then
     cast.spawned=true
     for i=1,9 do local angle=i*math.pi*2/9
      table.insert(s.spheres,cast.origin+Vector3.new(math.cos(angle),0,math.sin(angle))*Units.toStuds(400+math.random()*600))
     end
     emit(s,"Chibaku",cast.origin,Units.toStuds(1000),math.max(.1,s.sphereUntil-now),{points=table.clone(s.spheres),rise=2})
    end
    if now>=cast.readyAt then s.technique=nil end
   end
  end
  if s.form~=1 then s.model:SetAttribute("AmaterasuCoatingUntil",0) end
  if s.blackArea then s.model:SetAttribute("AmaterasuControlUntil",s.blackArea.controlUntil) end
  if s.held and now>=s.heldUntil then s.held=false end
  if s.formUntil>0 and now>=s.formUntil then form(s,0,0);s.used={} end
  if s.katanaUntil>0 and now>=s.katanaUntil then s.katanaUntil=0;s.model:SetAttribute("SasukeKatanaUntil",nil);Stats.RecalculateStats(player) end
  if s.nagashiUntil and now>=s.nagashiUntil then s.nagashiUntil=nil;Stats.SetLayer(s.model,"SasukeNagashi",nil) end
  if #s.spheres>0 and now>=s.sphereUntil then s.spheres={};s.sphereGoal=nil;emit(s,"ChibakuEnd",s.model:GetPivot().Position,0,.1) end
  if s.sphereGoal then for i,point in s.spheres do local delta=s.sphereGoal[i]-point;local length=delta.Magnitude;if length>.01 then s.spheres[i]=point+delta.Unit*math.min(length,Units.toStuds(500)*dt) end end end
  if #s.spheres>0 then for target in actors do local tr=root(target)
   if tr and Damage.CanDamage(s.model,target) then for _,point in s.spheres do
    if (tr.Position-point).Magnitude<=Units.toStuds(500) then slowed[target]=true;break end
   end end
  end end
  if s.amenoTarget and now>=s.amenoUntil then s.amenoTarget=nil end
  publish(s)
 end
 for target in slowed do target:SetAttribute("GravitySlowUntil",now+.3);if not gravityAffected[target] then Fighters.SetWalkSpeed(target,Fighters.GetWalkSpeed(target)) end end
 for target in gravityAffected do if not slowed[target] and target.Parent then target:SetAttribute("GravitySlowUntil",nil);Fighters.SetWalkSpeed(target,Fighters.GetWalkSpeed(target)) end end
 gravityAffected=slowed
 for i=#areas,1,-1 do local a=areas[i]
  if not valid(a.s) or a.ticks<=0 then emit(a.s,"AreaEnd",a.point,a.radius,.1,{areaSerial=a.serial});table.remove(areas,i);continue end
  if now>=a.next then a.next+=.5;a.ticks-=1;if a.follow and root(a.s.model) then a.point=a.s.model:GetPivot().Position end;inArea(a.s,a.point,a.radius,a.damage) end
 end
 Fire.Update(now);Advanced.Update(now);Enton.Update(now)
 local dt=math.clamp(now-(Service :: any).lastUpdate,0,.1);(Service :: any).lastUpdate=now
 for i=#shots,1,-1 do local shot=shots[i]
  if not valid(shot.s) then table.remove(shots,i);continue end
  local step=math.min(shot.remaining,shot.speed*dt);local travel=shot.direction*step
  local params=terrain(shot.s);local wall=workspace:Raycast(shot.point,travel,params)
  local finish=if wall then wall.Position else shot.point+travel
  local contact:Model?=nil;local firstT=math.huge
  for model in actors do local tr=root(model)
   if tr and Damage.CanDamage(shot.s.model,model) then
    local delta=finish-shot.point;local t=if delta.Magnitude>.001 then math.clamp((tr.Position-shot.point):Dot(delta)/delta:Dot(delta),0,1) else 0
    if (tr.Position-shot.point-delta*t).Magnitude<=math.min(shot.radius,2)+1.5 and t<firstT then contact=model;firstT=t end
   end
  end
  if contact then finish=shot.point+(finish-shot.point)*firstT end
  shot.point=finish;shot.remaining-=step
  if contact or wall or shot.remaining<=.01 then
   local seen={};if contact then seen[contact]=true;hurt(shot.s,contact,shot.damage,shot.stun) end
   if not shot.single then inArea(shot.s,finish,shot.radius,shot.damage,shot.stun,seen) end
   emit(shot.s,"Impact",finish,shot.radius,.5,{spell=shot.id,serial=shot.serial})
   if shot.burn then area(shot.s,"Fire",finish,shot.radius,shot.burn,3) end
   table.remove(shots,i)
  end
 end
 require(script.Parent.SasukeSummonService).Update(now,dt)
end
function Service.Start()
 if started then return end;started=true;(Service :: any).lastUpdate=clock()
 local function add(item:Instance) if item:IsA("Humanoid") and item.Parent and item.Parent:IsA("Model") then actors[item.Parent]=item end end
 for _,item in workspace:GetDescendants() do add(item) end
 workspace.DescendantAdded:Connect(add);workspace.DescendantRemoving:Connect(function(item) if item:IsA("Humanoid") and item.Parent and item.Parent:IsA("Model") then actors[item.Parent]=nil end end)
 Players.PlayerRemoving:Connect(function(player) sessions[player]=nil end)
 Combat.AttackStarted.Event:Connect(function(f:Fighters.Fighter,target:Model?)
  local p=f.player;local s=if p then sessions[p] else nil
  if not p or not s or not target or not Damage.CanDamage(s.model,target) or target:FindFirstChildOfClass("ForceField") then return end
  local kind=target:GetAttribute("EntityKind");local unit=kind~="Tower" and kind~="Core" and kind~="Structure";local now=clock();local stats=Stats.Get(p)
  if unit then
   if (s.amenoBonusUntil or 0)>now then s.amenoBonusUntil=0;hurt(s,target,(if s.katanaUntil>now then 200 else 50)+stats.Agility) end
   if s.katanaUntil>now and (s.katanaProcAt or 0)<=now and math.random()<.14 then s.katanaProcAt=now+.3;local tf=Fighters.GetOrCreate(target);if tf then Fighters.StunSpell(tf,1) end end
   if s.form>=3 then hurt(s,target,stats.Agility);Advanced.Wave(s,target,now);return end
  end
  if s.mode==0 then return end
  local data=Progress.Get(p);local rank=if data then data.Learned.SasukeEyes or 0 else 0
  if rank<1 or math.random(1,100)>15+3*rank then return end
  local tr=root(target);if not tr then return end
  local from=f.root.Position;local start=math.random()*math.pi*2
  for i=0,7 do
   local angle=start+i*math.pi/4
   local cf=destination(s,tr.Position+Vector3.new(math.cos(angle),0,math.sin(angle))*Units.toStuds(70))
   if cf then
    s.model:PivotTo(CFrame.lookAt(cf.Position,Vector3.new(tr.Position.X,cf.Position.Y,tr.Position.Z)))
    f.root.AssemblyLinearVelocity=Vector3.zero
    emit(s,"Teleport",from,2,.3);emit(s,"Teleport",cf.Position,2,.3);break
   end
  end
  hurt(s,target,1.5*Stats.Get(p).Agility);emit(s,"Counter",tr.Position,2,.4)
 end)
 Combat.SetHeroHandlers("Sasuke",function(f,target)
  local p=f.player;if not p then return false end;local s=sessions[p];if not s then return false end;local now=clock();local stats=Stats.Get(p)
  if s.held and now>=s.readyAt and now<s.heldUntil then
   local variant=s.variant;local dealt=hurt(s,target,D.chidoriDamage(stats.Level,stats.Agility,variant),3)
   if dealt>0 then
    s.held=false;s.model:SetAttribute("ChidoriImpactAt",now);s.model:SetAttribute("ChidoriStrikeUntil",now+.3)
    local direction=target:GetPivot().Position-s.model:GetPivot().Position
    direction=if direction.Magnitude>.01 then direction.Unit else s.model:GetPivot().LookVector
    target:SetAttribute("ChidoriHitAt",now);target:SetAttribute("ChidoriHitDirection",direction)
    publish(s);emit(s,"ChidoriHit",target:GetPivot().Position,2,.55,{direction=direction,target=target,variant=variant})
    if variant=="AmaterasuChidori" then Fire.Ignite(s,target,800+5*stats.Agility,now) end
   end
   return true
  end
  return false
 end,function(f) local s=if f.player then sessions[f.player] else nil;return not s or (not s.garuda and s.pendingUntil<=clock() and (not s.held or clock()>=s.readyAt)) end)
 Damage.AttackAttempt.Event:Connect(function(attacker:Model,target:Model)
  local p=Players:GetPlayerFromCharacter(target);local s=if p then sessions[p] else nil
  if p and s and s.form==1 and ((s.model:GetAttribute("AmaterasuCoatingUntil") or 0) :: number)>clock() then Fire.Ignite(s,attacker,800+5*Stats.Get(p).Agility,clock()) end
 end)
 Damage.RegisterIncoming("Sasuke",function(target:Model,amount:number,kind:string?):number
  local p=Players:GetPlayerFromCharacter(target);local s=if p then sessions[p] else nil
  if not p or not s then return amount end
  if s.nagashiUntil and s.nagashiUntil>clock() and kind~="Attack" and kind~="Pure" then amount*=.6 end
  if s.form==0 or s.form>=3 then return amount end
  local pool=Resource.Get(p);if not pool or pool.pool.mana<amount*.2 then off(s);return amount end
  pool.pool.mana-=amount*.2
  local threshold=60+Stats.Get(p).Level
  return amount*(if amount<=threshold then (if s.form==1 then .6 else .1) else (if s.form==1 then .75 else .7))
 end)
end
return Service
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="254">
          <Properties>
            <string name="Name">SasukeAdvancedService</string>
            <string name="Source"><![CDATA[--!strict
-- Timed source mechanics. Context keeps server authority in SasukeAbilityService.
local Units=require(game.ReplicatedStorage.Shared.Abilities.WorldUnits)
local A={}
local ctx:any
local waves:{any}={}
function A.Configure(context:any) ctx=context end
local function combatant(s:any,target:Model):boolean
 local kind=target:GetAttribute("EntityKind")
 return kind~="Tower" and kind~="Core" and kind~="Structure" and not target:FindFirstChildOfClass("ForceField") and ctx.canDamage(s.model,target)
end
local function push(s:any,target:Model,delta:Vector3)
 local r=ctx.root(target);if not r or delta.Magnitude<.001 then return end
 local wall=workspace:Blockcast(r.CFrame,r.Size*.8,delta,ctx.terrain(s,target))
 if wall then delta=delta.Unit*math.max(0,wall.Distance-.1) end
 local f=ctx.fighter(target);if f then ctx.lease(f,workspace:GetServerTimeNow()+.15) end
 target:PivotTo(target:GetPivot()+delta)
end
function A.Cancel(s:any)
 if s.advanced then
  ctx.emit(s,"KirinCancel",s.model:GetPivot().Position,0,.1)
  s.advanced=nil;s.pendingUntil=0
  s.model:SetAttribute("SasukeCastPoseUntil",0)
  local f=ctx.fighter(s.model);if f then ctx.lock(f,0) end
 end
end
function A.Kirin(s:any,target:Model,amount:number,now:number)
 s.advanced={id="Kirin",target=target,life=s.model:GetAttribute("LifeId"),round=s.model:GetAttribute("RoundId"),targetLife=target:GetAttribute("LifeId"),at=now,damage=amount,pulse=0}
 s.pendingUntil=now+2.5
 local f=ctx.fighter(s.model);if f then ctx.lock(f,s.pendingUntil) end
 ctx.emit(s,"KirinWarning",ctx.root(target).Position,Units.toStuds(550),1.5,{target=target})
end
function A.Pull(s:any,now:number,agility:number)
 local origin=ctx.root(s.model).Position;local targets={}
 for target in ctx.actors do local r=ctx.root(target)
  if r and combatant(s,target) and (r.Position-origin).Magnitude<=Units.toStuds(500) then table.insert(targets,target) end
 end
 s.advanced={id="EntonPull",at=now,life=s.model:GetAttribute("LifeId"),round=s.model:GetAttribute("RoundId"),damage=650+3*agility,hit=false,last=now,targets=targets}
 s.pendingUntil=now+2.8
 local f=ctx.fighter(s.model);if f then ctx.lock(f,s.pendingUntil) end
 ctx.emit(s,"EntonGather",s.model:GetPivot().Position,Units.toStuds(500),.8,{follow=true})
end
function A.UpdateCast(s:any,now:number)
 local c=s.advanced;if not c then return end
 local f=ctx.fighter(s.model)
 if not ctx.valid(s) or not f or f.logic.mode=="Stunned" or (f.sleep and f.sleep.active) or c.life~=s.model:GetAttribute("LifeId") or c.round~=s.model:GetAttribute("RoundId") then A.Cancel(s);return end
 if c.id=="EntonPull" then
  local point=ctx.root(s.model).Position;local dt=math.clamp(now-c.last,0,.1);c.last=now
  if now<c.at+.8 then
   for _,target in c.targets do local r=ctx.root(target)
    if r and combatant(s,target) then local delta=point-r.Position;local length=delta.Magnitude
     if length>.01 then push(s,target,delta.Unit*math.min(length,Units.toStuds(if length>=Units.toStuds(134) then 400 else 50)*dt)) end
    end
   end
  elseif not c.hit then
   c.hit=true
   for target in ctx.actors do local r=ctx.root(target)
    if r and combatant(s,target) and (r.Position-point).Magnitude<=Units.toStuds(550) then ctx.hurt(s,target,c.damage,2) end
   end
   ctx.emit(s,"EntonPull",point,Units.toStuds(550),1)
  end
  if now>=s.pendingUntil then s.advanced=nil end
  return
 end
 if not c.point and now>=c.at+1.5 then
  local tr=if c.target.Parent then ctx.root(c.target) else nil
  if not tr or not combatant(s,c.target) or c.targetLife~=c.target:GetAttribute("LifeId") then A.Cancel(s);return end
  c.point=tr.Position
  ctx.emit(s,"Kirin",c.point,Units.toStuds(550),1)
 end
 if c.point then
  while c.pulse<10 and now+1e-5>=c.at+1.6+c.pulse*.1 do
   c.pulse+=1
   local weight=if c.pulse==1 then .5 elseif c.pulse==10 then .1 else .05
   for target in ctx.actors do local r=ctx.root(target)
    if r and combatant(s,target) and (r.Position-c.point).Magnitude<=Units.toStuds(550) then ctx.hurt(s,target,c.damage*weight) end
   end
  end
  if c.pulse==10 then s.advanced=nil end
 end
end
function A.Nagashi(s:any,now:number)
 if not s.nagashiUntil or now>=s.nagashiUntil then return end
 local previous=s.nagashiTick or now;s.nagashiTick=now
 if previous>now then s.nagashiTick=previous;return end
 local dt=math.clamp(now-previous,0,.1);local r=ctx.root(s.model);if not r then return end
 for target in ctx.actors do local tr=ctx.root(target)
  if tr and combatant(s,target) then local delta=tr.Position-r.Position
   if delta.Magnitude<=Units.toStuds(400) then
    ctx.hurt(s,target,ctx.stats(s.player).Agility*dt/0.96)
    local flat=delta*Vector3.new(1,0,1);if flat.Magnitude>.01 then push(s,target,flat.Unit*Units.toStuds(100)*dt) end
   end
  end
 end
end
function A.Wave(s:any,target:Model,now:number)
 if s.form<3 or (s.waveUntil or 0)>now or math.random()>0.2 then return end
 local r,tr=ctx.root(s.model),ctx.root(target);if not r or not tr then return end
 local flat=(tr.Position-r.Position)*Vector3.new(1,0,1);local dir=if flat.Magnitude>.01 then flat.Unit else r.CFrame.LookVector
 -- Source's 30 updates execute on alternate 0.02-second ticks: 1.2 seconds.
 local point=r.Position+dir*Units.toStuds(250);local duration=1.2
 s.waveUntil=now+duration
 table.insert(waves,{s=s,point=point,dir=dir,at=now,last=now,ends=now+duration,seen={},damage=150+ctx.stats(s.player).Agility})
 ctx.emit(s,"SusanooWave",point,Units.toStuds(500),duration,{finish=point+dir*Units.toStuds(990)})
end
function A.Update(now:number)
 for i=#waves,1,-1 do local w=waves[i]
  if not ctx.valid(w.s) or w.s.form<3 or now>=w.ends then table.remove(waves,i);continue end
  local dt=math.clamp(now-w.last,0,.1);w.last=now
  w.point+=w.dir*Units.toStuds(825)*dt
  for target in ctx.actors do local tr=ctx.root(target)
   if tr and combatant(w.s,target) and (tr.Position-w.point).Magnitude<=Units.toStuds(500) then
    if not w.seen[target] then w.seen[target]=true;ctx.hurt(w.s,target,w.damage) end
    push(w.s,target,w.dir*Units.toStuds(275)*dt)
   end
  end
 end
end
function A.Reset() table.clear(waves) end
return A
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="255">
          <Properties>
            <string name="Name">SasukeAppearanceService</string>
            <string name="Source"><![CDATA[--!strict
local Shared=game.ReplicatedStorage:WaitForChild("Shared")
local Data=require(Shared.Config.SasukeVisualData)
local Factory=require(Shared.CreatorVisualFactory)
local A={}
function A.Apply(model:Model)
 local head=model:FindFirstChild("Head");local root=model:FindFirstChild("HumanoidRootPart")
 if not head or not head:IsA("BasePart") or not root or not root:IsA("BasePart") then return end
 local mode=(model:GetAttribute("SasukeMode") or 0) :: number;local form=(model:GetAttribute("SusanooForm") or 0) :: number
 local flying=model:GetAttribute("GarudaActive")==true
 local version="Sasuke-v2:"..mode..":"..form..":"..tostring(flying)
 if model:GetAttribute("HeroAppearanceVersion")==version and model:FindFirstChild("HeroAppearance") then return end
 local previous=model:FindFirstChild("HeroAppearance")
 local folder=Instance.new("Folder");folder.Name="HeroAppearance"
 for _,item in model:GetChildren() do
  if item:IsA("Accessory") or item:IsA("Shirt") or item:IsA("Pants") then item:Destroy() end
  if item:IsA("BasePart") and item~=root then item.Transparency=if item==head then 1 else 0;item.Color=Color3.fromRGB(244,210,177) end
 end
 for _,item in head:GetChildren() do if item:IsA("Decal") then item:Destroy() end end
 local shirt=Instance.new("Shirt");shirt.ShirtTemplate=Data.shirt;shirt.Parent=model
 local pants=Instance.new("Pants");pants.PantsTemplate=Data.pants;pants.Parent=model
 local function attach(p:Part,body:BasePart,offset:CFrame)
  p.CanCollide=false;p.CanTouch=false;p.CanQuery=false;p.Massless=true
  p:SetAttribute("HeroCosmetic",true);p:SetAttribute("CosmeticBody",body.Name);p:SetAttribute("CosmeticOffset",offset)
  p:SetAttribute("AppearanceTransparency",p.Transparency);p.CFrame=body.CFrame*offset;p.Parent=folder
  local weld=Instance.new("Weld");weld.Name="FormVisualWeld";weld.Part0=body;weld.Part1=p;weld.C0=offset;weld.Parent=p
 end
 local face=Instance.new("Part");face.Name="SasukeFace";face.Size=Vector3.new(2,1,1);face.Color=head.Color
 local mesh=Instance.new("SpecialMesh");mesh.MeshType=Enum.MeshType.Head;mesh.Scale=Vector3.one*1.25;mesh.Parent=face
 attach(face,head,CFrame.identity)
 -- A clean geometric face avoids baking the store model's curse mark into every form.
 local function feature(name:string,size:Vector3,color:Color3,offset:CFrame)
  local p=Instance.new("Part");p.Name=name;p.Size=size;p.Color=color;p.Material=Enum.Material.SmoothPlastic;attach(p,head,offset)
 end
 for side=-1,1,2 do
  feature("EyeWhite",Vector3.new(.29,.13,.025),Color3.fromRGB(244,244,238),CFrame.new(side*.24,.04,-.635)*CFrame.Angles(0,0,side*.08))
  feature("Iris",Vector3.new(.105,.12,.032),Color3.fromRGB(22,23,30),CFrame.new(side*.24,.035,-.655))
  feature("Brow",Vector3.new(.32,.035,.028),Color3.fromRGB(27,26,35),CFrame.new(side*.24,.165,-.64)*CFrame.Angles(0,0,side*.12))
 end
 feature("Mouth",Vector3.new(.24,.022,.025),Color3.fromRGB(96,67,62),CFrame.new(0,-.23,-.64))
 for _,spec in Data.appearance do local body=model:FindFirstChild(spec.body)
  if body and body:IsA("BasePart") then local p=Factory.Part(spec :: any);attach(p,body,Factory.Frame(spec.cf)) end
 end
 if mode>0 then
  for i=-1,1,2 do
   local eye=Instance.new("Part");eye.Name=if i==1 and mode==3 then "RinneganEye" else "SharinganEye";eye.Shape=Enum.PartType.Ball
   eye.Size=Vector3.new(.14,.12,.025);eye.Color=if i==1 and mode==3 then Color3.fromRGB(168,112,255) else Color3.fromRGB(218,30,46);eye.Material=Enum.Material.Neon
   attach(eye,head,CFrame.new(i*.23,.06,-.635))
  end
 end
 if form==1 then
  for side=-1,1,2 do for i=1,4 do for segment=1,6 do
   local a,b=(segment-1)*math.pi/7,segment*math.pi/7
   local first=Vector3.new(side*math.sin(a)*2.2,.1+i*.48,math.cos(a)*1.9)
   local last=Vector3.new(side*math.sin(b)*2.2,.1+i*.48,math.cos(b)*1.9)
   local rib=Instance.new("Part");rib.Name="SusanooRib";rib.Size=Vector3.new(.18,.22,(last-first).Magnitude+.06);rib.Color=Color3.fromRGB(155,80,239);rib.Material=Enum.Material.Neon;rib.Transparency=.35
   attach(rib,root,CFrame.lookAt((first+last)/2,last))
  end end end
 elseif form>=2 then
  local scale=if form==2 then .15 else .23
  for _,spec in Data.susanoo do
   local lower=string.lower(spec.name)
   if string.find(lower,"wing") or (form==2 and string.find(lower,"leg")) then continue end
   local p,m=Factory.Part(spec :: any);p.Size*=scale;m.Scale*=scale;m.Offset*=scale;p.Transparency=math.max(p.Transparency,.42)
   local cf=Factory.Frame(spec.cf);local offset=CFrame.new(0,if form==2 then 4 else 14.5,0)*CFrame.Angles(0,math.pi/2,0)*(CFrame.new(cf.Position*scale)*cf.Rotation)
   p:SetAttribute("SusanooLimb",if string.find(lower,"rarm") then "Right" elseif string.find(lower,"larm") then "Left" else "Body")
   if string.find(lower,"rarm") or string.find(lower,"larm") then
    local side=if string.find(lower,"rarm") then 1 else -1
    p:SetAttribute("SusanooPivot",Vector3.new(side*10.7*scale,(if form==2 then 4 else 14.5)-6*scale,5.5*scale))
   end
   p:SetAttribute("SusanooChakra",true)
   attach(p,root,offset)
  end
 end
 if flying then
  for _,spec in Data.garuda do
   local p,m=Factory.Part(spec :: any);p.Name="Garuda"..spec.name;p.Size*=1.6;m.Scale*=1.6
   local cf=Factory.Frame(spec.cf)
   local offset=CFrame.new(0,-4,0)*CFrame.Angles(-math.pi/2,0,0)*(CFrame.new(cf.Position*1.6)*cf.Rotation)
   if string.find(spec.name,"Wing") then p:SetAttribute("GarudaWing",if spec.name=="LeftWing" then -1 else 1) end
   attach(p,root,offset)
  end
 end
 folder:SetAttribute("AppearanceVersion",version);folder:SetAttribute("AppearanceForm","Sasuke")
 folder:SetAttribute("AppearanceParts",#folder:GetChildren());folder:SetAttribute("AppearanceDescendants",#folder:GetDescendants())
 if previous then previous.Name="PreviousHeroAppearance" end
 folder.Parent=model;model:SetAttribute("HeroVisualForm","Sasuke:"..mode..":"..form);model:SetAttribute("HeroAppearanceVersion",version)
 if previous then game:GetService("Debris"):AddItem(previous,3) end
end
return A
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="256">
          <Properties>
            <string name="Name">SasukeEntonService</string>
            <string name="Source"><![CDATA[--!strict
-- Naruto Legend: delayed flame weapon, carrying arrow and Amaterasu combination.
local U=require(game.ReplicatedStorage.Shared.Abilities.WorldUnits)
local E={}
local c:any
local shots:{any}={}
local serial=0
function E.Configure(context:any) c=context end
local function enemy(s:any,m:Model):boolean
 local h=m:FindFirstChildOfClass("Humanoid");local kind=m:GetAttribute("EntityKind")
 return h~=nil and h.MaxHealth>200 and kind~="Tower" and kind~="Core" and kind~="Structure" and not m:FindFirstChildOfClass("ForceField") and c.canDamage(s.model,m)
end
local function valid(s:any,record:any):boolean
 return not not (c.valid(s) and s.mode>=2 and s.model:GetAttribute("LifeId")==record.life and s.model:GetAttribute("RoundId")==record.round)
end
function E.Cancel(s:any)
 if not s.enton then return end
 s.enton=nil;s.pendingUntil=0;s.model:SetAttribute("SasukeCastPoseUntil",0)
 local f=c.fighter(s.model);if f then c.lock(f,0) end
 c.emit(s,"EntonCancel",s.model:GetPivot().Position,0,.1)
end
function E.Cast(s:any,point:Vector3,agi:number,now:number,magatama:boolean?)
 local r=c.root(s.model);local delta=(point-r.Position)*Vector3.new(1,0,1)
 local dir=if delta.Magnitude>.01 then delta.Unit else r.CFrame.LookVector
 local combo=not magatama and s.mode==3 and s.amaterasuComboUntil and now<s.amaterasuComboUntil
  and s.amaterasuPoint and (point-s.amaterasuPoint).Magnitude<=U.toStuds(150)
 local kind=if combo then "Combo" elseif magatama then "Magatama" elseif s.form>=2 then "Arrow" else "Weapon"
 if combo then c.fire.ConsumeArea(s);s.amaterasuComboUntil=0 end
 local duration=if combo then 2.5 elseif magatama then 1 else .6
 s.enton={kind=kind,point=point,dir=dir,agi=agi,at=now,pulse=0,launched=false,life=s.model:GetAttribute("LifeId"),round=s.model:GetAttribute("RoundId")}
 s.pendingUntil=now+duration
 local f=c.fighter(s.model);if f then c.lock(f,s.pendingUntil) end
 r.CFrame=CFrame.lookAt(r.Position,r.Position+dir)
 if combo then c.emit(s,"EntonComboWarning",point,U.toStuds(350),1) end
end
function E.UpdateCast(s:any,now:number)
 local cast=s.enton;if not cast then return end
 local f=c.fighter(s.model)
 if not valid(s,cast) or not f or f.logic.mode=="Stunned" or (f.sleep and f.sleep.active) then E.Cancel(s);return end
 local age=now-cast.at
 if cast.kind=="Combo" then
  if age>=1 and not cast.launched then cast.launched=true;c.emit(s,"EntonCombo",cast.point,U.toStuds(350),1.5) end
  while cast.pulse<30 and age+1e-6>=1.05+cast.pulse*.05 do
   cast.pulse+=1
   for m in c.actors do local r=c.root(m);local kind=m:GetAttribute("EntityKind")
    if r and kind~="Tower" and kind~="Core" and kind~="Structure" and c.canDamage(s.model,m) and (r.Position-cast.point).Magnitude<=U.toStuds(350) then c.hurt(s,m,26+.17*cast.agi) end
   end
  end
 elseif not cast.launched and age+1e-6>= (if cast.kind=="Magatama" then 0 else .2) then
  cast.launched=true
  if cast.kind=="Magatama" then c.fire.Magatama(s,cast.point,cast.agi,now)
  else
   local arrow=cast.kind=="Arrow";local from=c.root(s.model).Position+cast.dir*U.toStuds(if arrow then 60 else 150)
   serial+=1
   local distance=if arrow then math.min(U.toStuds(1550),(cast.point-from).Magnitude+U.toStuds(550)) else U.toStuds(1000)
   local shot={s=s,kind=cast.kind,point=from,dir=cast.dir,agi=cast.agi,remaining=distance,seen={},contact=false,serial=-100000-serial,
    next=cast.at+(if arrow then .62 else .22),life=cast.life,round=cast.round}
   table.insert(shots,shot)
   c.emit(s,"Projectile",from,1,distance/U.toStuds(if arrow then 1500 else 1000)+(if arrow then .4 else 0),
    {finish=from+cast.dir*distance,spell=if arrow then "EntonArrow" else "EntonWeapon",serial=shot.serial,delay=if arrow then .4 else 0})
  end
 end
 if now>=s.pendingUntil then s.enton=nil end
end
local function finish(shot:any,now:number,patch:boolean)
 c.emit(shot.s,"Impact",shot.point,1,.5,{spell=if shot.kind=="Arrow" then "EntonArrow" else "EntonWeapon",serial=shot.serial})
 if patch then
  if shot.kind=="Arrow" then
   for i=1,6 do local a=i*math.pi/3;c.fire.Area(shot.s,shot.point+Vector3.new(math.cos(a),0,math.sin(a))*U.toStuds(100),U.toStuds(100),800+5*shot.agi,now,false,false,3) end
  else c.fire.Area(shot.s,shot.point,U.toStuds(100),800+5*shot.agi,now) end
 end
end
function E.Update(now:number)
 for i=#shots,1,-1 do local shot=shots[i]
  if not valid(shot.s,shot) then finish(shot,now,false);table.remove(shots,i);continue end
  local ended=false
  while now+1e-6>=shot.next and not ended do
   shot.next+=.02
   local step=math.min(shot.remaining,U.toStuds(if shot.kind=="Arrow" then 30 else 20))
   local wall=workspace:Raycast(shot.point,shot.dir*step,c.terrain(shot.s))
   local point=if wall then wall.Position else shot.point+shot.dir*step
   for target in c.actors do local tr=c.root(target)
    if tr and enemy(shot.s,target) and (tr.Position-shot.point).Magnitude<=U.toStuds(150) then
     c.fire.Ignite(shot.s,target,800+5*shot.agi,now)
     if shot.kind=="Arrow" then
      if not shot.seen[target] then
       shot.seen[target]=true;c.hurt(shot.s,target,300+3*shot.agi,1)
       if not shot.contact then shot.contact=true;shot.remaining=math.min(shot.remaining,U.toStuds(550)) end
      end
      local delta=(point-tr.Position)*Vector3.new(1,0,1)
      local block=if delta.Magnitude>.01 then workspace:Blockcast(tr.CFrame,tr.Size*.8,delta,c.terrain(shot.s,target)) else nil
      if not block then
       local f=c.fighter(target);if f then c.lease(f,now+.15) end
       target:PivotTo(target:GetPivot()+delta)
      end
     elseif not shot.contact then shot.contact=true;shot.remaining=math.min(shot.remaining,U.toStuds(100)) end
    end
   end
   shot.point=point;shot.remaining-=step
   if wall or shot.remaining<=.001 then ended=true;finish(shot,now,true) end
  end
  if ended then table.remove(shots,i) end
 end
end
function E.Reset()
 for _,shot in shots do finish(shot,workspace:GetServerTimeNow(),false) end
 table.clear(shots)
end
return E
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="257">
          <Properties>
            <string name="Name">SasukeFireService</string>
            <string name="Source"><![CDATA[--!strict
-- Authoritative fire casts and attached black-flame burns. No delayed callbacks survive a life.
local Shared=game.ReplicatedStorage:WaitForChild("Shared")
local F=require(Shared.Abilities.SasukeFireRules)
local U=require(Shared.Abilities.WorldUnits)
local Structures=require(Shared.Game.StructureRules)
local Fire={}
local c:any
local serial=0
local patches:{any}={}
local burns:{any}={}
local missiles:{any}={}
local random=Random.new()
local function nextSerial():number serial+=1;return -serial end
local function flat(v:Vector3):Vector3 return v*Vector3.new(1,0,1) end
local function direction(s:any,point:Vector3):Vector3
 local r=c.root(s.model);local delta=flat(point-r.Position)
 return if delta.Magnitude>.01 then delta.Unit else r.CFrame.LookVector
end
local function mouth(s:any,dir:Vector3):Vector3
 local head=s.model:FindFirstChild("Head")
 return (if head and head:IsA("BasePart") then head.Position else c.root(s.model).Position+Vector3.yAxis*1.5)+dir*.65
end
local function enemy(s:any,m:Model):boolean
 return not Structures.isStructure(m:GetAttribute("EntityKind")) and c.canDamage(s.model,m)
end
local function clearLine(s:any,a:Vector3,b:Vector3):boolean
 return workspace:Raycast(a,b-a,c.terrain(s))==nil
end
function Fire.Configure(context:any) c=context end
function Fire.Cancel(s:any,now:number)
 local cast=s.fire;if not cast then return end
 c.emit(s,"FireEnd",cast.origin,0,.1,{fireSerial=cast.serial})
 s.fire=nil;s.pendingUntil=math.min(s.pendingUntil,now)
 s.model:SetAttribute("SasukeCastPoseUntil",now)
 s.model:SetAttribute("SasukeFireUntil",0)
end
function Fire.Cast(s:any,id:string,point:Vector3,rank:number,agi:number,now:number)
 local dir=direction(s,point);local r=c.root(s.model)
 local cast={id=id,serial=nextSerial(),origin=r.Position,direction=dir,at=now,tick=0,sent=0,rank=rank,agi=agi,seen={}}
 s.fire=cast;s.pendingUntil=now+F.Duration;s.model:SetAttribute("SasukeFireUntil",s.pendingUntil)
 r.CFrame=CFrame.lookAt(r.Position,r.Position+dir)
 if id=="SasukeFireball" then c.emit(s,"FireBreath",mouth(s,dir),U.toStuds(500),F.Duration,{direction=dir,origin=r.Position,fireSerial=cast.serial}) end
end
local function launch(s:any,id:string,from:Vector3,dir:Vector3,rank:number,agi:number,now:number)
 local shot={s=s,id=id,serial=nextSerial(),point=from,origin=c.root(s.model).Position,direction=dir,remaining=U.toStuds(if id=="EntonMagatama" then 1500 else 1000),speed=U.toStuds(750),rank=rank,agi=agi,last=now}
 table.insert(missiles,shot)
 c.emit(s,"Projectile",from,.7,shot.remaining/shot.speed,{finish=from+dir*shot.remaining,spell=id,serial=shot.serial})
end
function Fire.Magatama(s:any,point:Vector3,agi:number,now:number)
 local aim=CFrame.lookAt(Vector3.zero,direction(s,point))
 for _,angle in {-50,-35,-20,-5,5,20,35,50} do
  local dir=(aim*CFrame.Angles(0,math.rad(angle),0)).LookVector
  local from=c.root(s.model).Position+dir*U.toStuds(100)
  launch(s,"EntonMagatama",from,dir,0,agi,now)
  local shot=missiles[#missiles];shot.remaining=U.toStuds(1500);shot.patchUntil=now+10
 end
end
function Fire.UpdateCast(s:any,now:number)
 local cast=s.fire;if not cast then return end
 local r=c.root(s.model);local fighter=c.fighter(s.model)
 if not c.valid(s) or not r or not fighter or fighter.logic.mode=="Stunned" or (fighter.sleep and fighter.sleep.active)
  or (r.Position-cast.origin).Magnitude>1.5 then Fire.Cancel(s,now);return end
 local age=math.min(F.Duration,now-cast.at)
 if cast.id=="PhoenixFlowers" then
  local due=F.phoenixDue(age)
  while cast.sent<due do
   cast.sent+=1
   local dir=(CFrame.lookAt(Vector3.zero,cast.direction)*CFrame.Angles(0,math.rad(random:NextNumber(-F.PhoenixSpread,F.PhoenixSpread)),0)).LookVector
   launch(s,"PhoenixFlowers",mouth(s,cast.direction),dir,cast.rank,cast.agi,now)
  end
 else
  -- Fixed simulation ticks preserve damage/mana under variable Heartbeat rates.
  local due=math.floor((age+1e-6)/F.Tick)
  while cast.tick<due do
   cast.tick+=1;local t=cast.tick*F.Tick
   local sustained=t>F.Warmup
   if sustained then
    local pool=c.resource(s.player)
    if not pool or pool.pool.mana<F.MinimumMana then Fire.Cancel(s,now);return end
    pool.pool.mana=math.max(0,pool.pool.mana-F.ManaPerSecond*F.Tick);pool.nextPublish=0
   end
   local center=cast.origin+cast.direction*U.toStuds(F.front(t))
   local radius=U.toStuds(F.radius(t))
   for target in c.actors do local tr=c.root(target)
    if tr and enemy(s,target) and math.abs(tr.Position.Y-cast.origin.Y)<radius then
     local delta=flat(tr.Position-cast.origin);local along=delta:Dot(cast.direction)
     local side=(delta-cast.direction*along).Magnitude
     local inside=if sustained then F.inBreath(along*16,side*16) else flat(tr.Position-center).Magnitude<=radius and not cast.seen[target]
     if inside and clearLine(s,mouth(s,cast.direction),tr.Position) then
      if not sustained then cast.seen[target]=true end
      c.hurt(s,target,if sustained then (16*cast.rank+cast.agi)*F.Tick else 35*cast.rank+cast.agi)
     end
    end
   end
  end
 end
 if now>=cast.at+F.Duration then Fire.Cancel(s,now) end
end
local function endBurn(index:number)
 local b=burns[index];c.emit(b.s,"FireEnd",b.target:GetPivot().Position,0,.1,{fireSerial=b.serial});table.remove(burns,index)
end
function Fire.Ignite(s:any,target:Model,total:number,now:number)
 if not enemy(s,target) or ((target:GetAttribute("AmaterasuCoatingUntil") or 0) :: number)>now then return end
 for _,b in burns do if b.s==s and b.target==target then return end end
 local b={s=s,target=target,serial=nextSerial(),damage=total/40,ticks=40,next=now+.25}
 table.insert(burns,b)
 c.emit(s,"BlackBurn",target:GetPivot().Position,1,F.BurnDuration,{target=target,fireSerial=b.serial})
end
function Fire.Area(s:any,point:Vector3,radius:number,total:number,now:number,follow:boolean?,controlled:boolean?,duration:number?)
 local a={s=s,point=point,radius=radius,total=total,serial=nextSerial(),untilAt=now+(duration or 10),last=now,follow=follow,seen={},controlUntil=if controlled then now+4 else 0}
 if controlled then a.activateAt=now+1;a.untilAt+=1 end
 table.insert(patches,a)
 if controlled then s.blackArea=a;s.model:SetAttribute("AmaterasuControlUntil",a.controlUntil) end
 c.emit(s,if controlled then "AmaterasuWarning" else "Amaterasu",point,radius,if controlled then 1 else duration or 10,{follow=follow,areaSerial=a.serial})
 return a
end
function Fire.ConsumeArea(s:any)
 local a=s.blackArea;if not a then return end
 for i=#patches,1,-1 do if patches[i]==a then
  c.emit(s,"AreaEnd",a.point,a.radius,.1,{areaSerial=a.serial});table.remove(patches,i)
 end end
 a.controlUntil=0;s.blackArea=nil;s.model:SetAttribute("AmaterasuControlUntil",0)
end
function Fire.Steer(s:any,point:Vector3,now:number):boolean
 local a=s.blackArea;if not a or now>=a.controlUntil or now>=a.untilAt then return false end
 a.goal=point
 c.emit(s,"AreaMove",a.point,a.radius,(point-a.point).Magnitude/U.toStuds(400),{areaSerial=a.serial,goal=point})
 return true
end
function Fire.Coat(s:any,now:number)
 s.model:SetAttribute("AmaterasuCoatingUntil",now+20)
 c.emit(s,"BlackCoating",s.model:GetPivot().Position,3,20,{target=s.model})
 for i=#burns,1,-1 do if burns[i].target==s.model then endBurn(i) end end
end
function Fire.Extinguish(point:Vector3,radius:number)
 for i=#patches,1,-1 do local a=patches[i]
  if (a.point-point).Magnitude<=radius then
   a.controlUntil=0;c.emit(a.s,"AreaEnd",a.point,a.radius,.1,{areaSerial=a.serial});table.remove(patches,i)
  end
 end
 for i=#burns,1,-1 do if (burns[i].target:GetPivot().Position-point).Magnitude<=radius then endBurn(i) end end
end
function Fire.Update(now:number)
 for i=#patches,1,-1 do local a=patches[i]
  if not c.valid(a.s) or now>=a.untilAt then
   a.controlUntil=0;c.emit(a.s,"AreaEnd",a.point,a.radius,.1,{areaSerial=a.serial});table.remove(patches,i);continue
  end
  local dt=math.max(0,now-a.last);a.last=now
  if a.activateAt then
   if now<a.activateAt then continue end
   a.activateAt=nil;c.emit(a.s,"Amaterasu",a.point,a.radius,math.max(.01,a.untilAt-now),{follow=a.follow,areaSerial=a.serial})
  end
  if a.follow then a.point=a.s.model:GetPivot().Position
  elseif a.goal then local delta=a.goal-a.point
   if delta.Magnitude>.01 then a.point+=delta.Unit*math.min(delta.Magnitude,U.toStuds(400)*dt) end
  end
  for target in c.actors do local tr=c.root(target)
   if tr and not a.seen[target] and (tr.Position-a.point).Magnitude<=a.radius and enemy(a.s,target) then
    a.seen[target]=true;Fire.Ignite(a.s,target,a.total,now)
   end
  end
 end
 for i=#burns,1,-1 do local b=burns[i];local h=b.target:FindFirstChildOfClass("Humanoid")
  if not c.valid(b.s) or not b.target.Parent or not h or h.Health<=0 or b.ticks<=0 then endBurn(i);continue end
  while b.ticks>0 and now>=b.next do b.next+=.25;b.ticks-=1;c.hurt(b.s,b.target,b.damage) end
 end
 for i=#missiles,1,-1 do local shot=missiles[i]
  if not c.valid(shot.s) then c.emit(shot.s,"Impact",shot.point,.7,.1,{spell=shot.id,serial=shot.serial});table.remove(missiles,i);continue end
  local step=math.min(shot.remaining,shot.speed*math.max(0,now-shot.last));shot.last=now
  local wall=workspace:Raycast(shot.point,shot.direction*step,c.terrain(shot.s))
  local finish=if wall then wall.Position else shot.point+shot.direction*step
  local contact:Model?=nil;local first=math.huge;local segment=finish-shot.point
  for target in c.actors do local tr=c.root(target)
   if tr and enemy(shot.s,target) then
    local t=if segment.Magnitude>.001 then math.clamp((tr.Position-shot.point):Dot(segment)/segment:Dot(segment),0,1) else 0
    if (tr.Position-shot.point-segment*t).Magnitude<=(if shot.id=="EntonMagatama" then U.toStuds(100) else 2.2) and t<first then contact=target;first=t end
   end
  end
  if contact then finish=shot.point+segment*first end
  shot.point=finish;shot.remaining-=step
  if contact or wall or shot.remaining<=.01 then
   if contact then
    if shot.id=="EntonMagatama" then Fire.Ignite(shot.s,contact,800+5*shot.agi,now)
    else c.hurt(shot.s,contact,F.phoenixDamage(shot.rank,shot.agi,flat(finish-shot.origin).Magnitude*16)) end
   end
   if shot.id=="EntonMagatama" then Fire.Area(shot.s,finish,U.toStuds(100),800+5*shot.agi,now,false,false,math.max(.01,shot.patchUntil-now)) end
   c.emit(shot.s,"Impact",finish,.7,.5,{spell=shot.id,serial=shot.serial});table.remove(missiles,i)
  end
 end
end
function Fire.Reset()
 for i=#burns,1,-1 do endBurn(i) end
 for _,a in patches do c.emit(a.s,"AreaEnd",a.point,a.radius,.1,{areaSerial=a.serial}) end
 table.clear(patches);table.clear(missiles)
end
return Fire
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="258">
          <Properties>
            <string name="Name">SasukeSummonService</string>
            <string name="Source"><![CDATA[--!strict
local Navigation=require(script.Parent.CloneNavigation)
local Collision=require(script.Parent.SummonCollision)
local Damage=require(script.Parent.DamageService)
local Appearance=require(game.ReplicatedStorage.Shared.AodaAppearance)
local S={}
local summons:{any}={}
local poisons:{any}={}
local Fighters=require(script.Parent.FighterStateService)
local Teams=require(script.Parent.TeamService)
local function release(s:any)
 Damage.ClearAodaGuard(s.model);s.channel=nil;s.model:SetAttribute("AodaConstrictUntil",0);s.model:SetAttribute("AodaGuardUntil",0)
end
local function remove(i:number) local s=summons[i];release(s);Navigation.Remove(s.model);s.model:Destroy();table.remove(summons,i) end
function S.Reset() for i=#summons,1,-1 do remove(i) end;table.clear(poisons) end
function S.Get(owner:Model):any
 for _,s in summons do if s.owner==owner then return s end end
 return nil
end
function S.Command(owner:Model,target:Model,now:number):(boolean,string)
 local s=S.Get(owner);if not s or not Damage.CanAct(s.model) or s.rank<6 then return false,"Нужна взрослая Аода" end
 local tr=target:FindFirstChild("HumanoidRootPart");local h=target:FindFirstChildOfClass("Humanoid")
 local kind=target:GetAttribute("EntityKind")
 if target==s.model or not tr or not tr:IsA("BasePart") or not h or not Damage.CanAct(target) or target:FindFirstChildOfClass("ForceField")
  or kind=="Tower" or kind=="Core" or kind=="Structure" then return false,"Выберите бойца" end
 local allied=Teams.GetId(owner)~=nil and Teams.GetId(owner)==Teams.GetId(target)
 if not allied and not Damage.CanDamage(s.model,target) then return false,"Недоступная цель" end
 if (tr.Position-s.root.Position).Magnitude>300/16 then return false,"Цель слишком далеко от Аоды" end
 if now<s.constrictAt or s.channel then return false,"Удушение/защита восстанавливается" end
 if ((s.model:GetAttribute("CombatStunUntil") or 0) :: number)>now or ((s.model:GetAttribute("SleepUntil") or 0) :: number)>now then return false,"Аода под контролем" end
 local ray=RaycastParams.new();ray.FilterDescendantsInstances={s.model,owner,target};ray.RespectCanCollide=true
 if workspace:Raycast(s.root.Position,tr.Position-s.root.Position,ray) then return false,"Путь Аоды перекрыт" end
 s.pendingBite=nil;s.model:SetAttribute("AodaStrikeAt",-100);s.constrictAt=now+30;s.channel={target=target,life=target:GetAttribute("LifeId"),untilAt=now+3,next=now+1,ticks=0,allied=allied}
 s.model:SetAttribute("Ready_AodaBind",s.constrictAt);owner:SetAttribute("Ready_AodaBind",s.constrictAt);owner:SetAttribute("Ready_AodaGuardSelf",s.constrictAt)
 Navigation.Stop(s.model);s.model:SetAttribute("SummonMoving",false);s.model:SetAttribute("AodaConstrictUntil",now+3)
 if allied then Damage.SetAodaGuard(target,s.model,now+3);s.model:SetAttribute("AodaGuardUntil",now+3)
 else local f=Fighters.GetOrCreate(target);if f then Fighters.StunSpell(f,4) end end
 return true,"Cast"
end
function S.Spawn(owner:Model,player:Player,rank:number,point:Vector3):boolean
 for i=#summons,1,-1 do if summons[i].owner==owner then remove(i) end end
 local folder=workspace:FindFirstChild("HeroSummons") or Instance.new("Folder");folder.Name="HeroSummons";folder.Parent=workspace
 local model=Instance.new("Model");model.Name="Аода";model:SetAttribute("NativeAoda",true);model:SetAttribute("EntityKind","Summon");model:SetAttribute("SummonOwner",player.UserId)
 model:SetAttribute("TeamId",owner:GetAttribute("TeamId"));model:SetAttribute("RoundId",owner:GetAttribute("RoundId"))
 model:SetAttribute("SummonArmor",if rank>=6 then 15 else 10)
 local root=Instance.new("Part");root.Name="HumanoidRootPart";root.Size=Vector3.new(3,4,3);root.Transparency=1;root.Anchored=true;root.Parent=model;model.PrimaryPart=root
 local h=Instance.new("Humanoid");h.MaxHealth=if rank>=6 then 1500 else 500;h.Health=h.MaxHealth;h.HipHeight=0;h.RequiresNeck=false;h.Parent=model
 Appearance.Build(model,root,rank>=6)
 model.Parent=folder;Collision.Apply(model);Navigation.Register(model,root,h)
 if not Navigation.Place(model,owner,CFrame.new(point),3) then Navigation.Remove(model);model:Destroy();return false end
 table.insert(summons,{model=model,root=root,h=h,owner=owner,untilAt=workspace:GetServerTimeNow()+10+5*(rank-1),rank=rank,damage=if rank>=6 then 101 else 41,attackAt=0,poisonAt=0,constrictAt=0,nextTarget=0,target=nil})
 return true
end
local function impact(s:any,now:number)
 local bite=s.pendingBite;if not bite or now<bite.impactAt then return end
 s.pendingBite=nil
 local target=bite.target;local tr=target:FindFirstChild("HumanoidRootPart")
 if not tr or not tr:IsA("BasePart") or target:GetAttribute("LifeId")~=bite.life or not Damage.CanDamage(s.model,target) then return end
 local delta=tr.Position-s.root.Position
 if (delta*Vector3.new(1,0,1)).Magnitude>230/16 or math.abs(delta.Y)>=5 then return end
 local ray=RaycastParams.new();ray.FilterDescendantsInstances={s.model,s.owner,target};ray.RespectCanCollide=true
 if workspace:Raycast(s.root.Position,delta,ray) then return end
 local hp=target:FindFirstChildOfClass("Humanoid");if hp then Damage.ApplyAttack(s.model,hp,s.damage) end
    if hp and target:GetAttribute("EntityKind")~="Tower" and target:GetAttribute("EntityKind")~="Core" then
     if now>=s.poisonAt then
      local adult=s.rank>=6;local duration=if adult then 15 else 7
      s.poisonAt=now+(if adult then 20 else 25)
      target:SetAttribute("SnakePoisonUntil",now+duration);target:SetAttribute("SnakePoisonMove",if adult then .9 else .95);target:SetAttribute("SnakePoisonAttack",if adult then .85 else .9);target:SetAttribute("SnakePoisonArmor",if adult then 4 else 1)
      Fighters.SetWalkSpeed(target,Fighters.GetWalkSpeed(target))
      table.insert(poisons,{source=s.model,target=target,hp=hp,next=now+1,ticks=duration,damage=if adult then 20 else 10})
     end
    end
end
function S.Update(now:number,dt:number)
 for i=#poisons,1,-1 do local poison=poisons[i]
  if poison.ticks<=0 or not Damage.CanDamage(poison.source,poison.target) then
   if poison.target.Parent and ((poison.target:GetAttribute("SnakePoisonUntil") or 0) :: number)<=now then Fighters.SetWalkSpeed(poison.target,Fighters.GetWalkSpeed(poison.target)) end
   table.remove(poisons,i)
  elseif now>=poison.next then poison.next+=1;poison.ticks-=1;Damage.Apply(poison.source,poison.hp,poison.damage) end
 end
 for i=#summons,1,-1 do local s=summons[i]
  if not s.owner.Parent or not Damage.CanAct(s.owner) or not s.model.Parent or s.h.Health<=0 or now>=s.untilAt then remove(i);continue end
  Navigation.Settle(s.model,s.owner,dt)
  local controlled=((s.model:GetAttribute("CombatStunUntil") or 0) :: number)>now or ((s.model:GetAttribute("SleepUntil") or 0) :: number)>now
  if controlled or s.channel then s.pendingBite=nil else impact(s,now) end
  local channel=s.channel
  if channel then
   local target=channel.target;local tr=target:FindFirstChild("HumanoidRootPart")
   if controlled or not tr or not tr:IsA("BasePart") or not Damage.CanAct(target) or target:GetAttribute("LifeId")~=channel.life
    or (channel.allied and Teams.GetId(target)~=Teams.GetId(s.owner)) or (not channel.allied and not Damage.CanDamage(s.model,target)) then release(s)
   else
    s.model:PivotTo(CFrame.new(tr.Position)*s.root.CFrame.Rotation)
    while not channel.allied and channel.ticks<5 and now+1e-5>=channel.next do
     channel.next+=.5;channel.ticks+=1;local hp=target:FindFirstChildOfClass("Humanoid");if hp then Damage.Apply(s.model,hp,50) end
    end
    if now>=channel.untilAt then release(s) end
   end
  end
  if not s.channel then
  if now>=s.nextTarget then
   s.nextTarget=now+.5;local best:Model?=nil;local score=math.huge
   for _,item in workspace:GetDescendants() do if item:IsA("Humanoid") and item.Parent and item.Parent:IsA("Model") then
    local target=item.Parent;local tr=target:FindFirstChild("HumanoidRootPart")
    if tr and tr:IsA("BasePart") and Damage.CanDamage(s.model,target) then
     local distance=(tr.Position-s.root.Position).Magnitude;local priority=distance+(if target:GetAttribute("EntityKind")=="Tower" then 60 else 0)
     if distance<120 and priority<score then best=target;score=priority end
    end
   end end;s.target=best
  end
  local target=s.target;local tr=if target then target:FindFirstChild("HumanoidRootPart") else nil
  if target and tr and tr:IsA("BasePart") and Damage.CanDamage(s.model,target) then
   Navigation.SetFrontline(s.model,target,true)
   local moving=if controlled or (s.channelUntil and s.channelUntil>now) then false else Navigation.Step(s.model,s.owner,target,tr,230/16,now,dt,if s.rank>=6 then 420/16 else 330/16)
   s.model:SetAttribute("SummonMoving",moving)
   local delta=(tr.Position-s.root.Position)*Vector3.new(1,0,1)
   if delta.Magnitude>.01 then s.model:PivotTo(CFrame.lookAt(s.root.Position,s.root.Position+delta)) end
   local ray=RaycastParams.new();ray.FilterDescendantsInstances={s.model,s.owner,target};ray.RespectCanCollide=true
   if not controlled and delta.Magnitude<=230/16 and math.abs(tr.Position.Y-s.root.Position.Y)<5 and not workspace:Raycast(s.root.Position,tr.Position-s.root.Position,ray) and now>=s.attackAt then
    s.attackAt=now+(if s.rank>=6 then 1.6 else 2);s.model:SetAttribute("AodaStrikeDistance",delta.Magnitude);s.model:SetAttribute("AodaStrikeAt",now)
    s.pendingBite={target=target,life=target:GetAttribute("LifeId"),impactAt=now+.22}

   end
  else Navigation.Stop(s.model);s.model:SetAttribute("SummonMoving",false) end
  end
 end
end
return S
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="259">
          <Properties>
            <string name="Name">StructureReset</string>
            <string name="Source"><![CDATA[--!strict
-- Capture only existing managed visuals. Unknown children are never deleted.
export type Snapshot = { restore: () -> () }
local Reset = {}
function Reset.capture(model: Model): Snapshot
	local actions: { () -> () } = {}
	for _, item in model:GetDescendants() do
		if model:GetAttribute("EntityKind") == "Tower" and item:GetAttribute("StructureCosmetic") == nil
			and (not item:IsA("PointLight") or not item.Parent or item.Parent:GetAttribute("StructureCosmetic") == nil) then continue end
		if item:IsA("BasePart") then
			local color, material, transparency = item.Color, item.Material, item.Transparency
			local collide, query, touch = item.CanCollide, item.CanQuery, item.CanTouch
			local frame, size = item.CFrame, item.Size
			table.insert(actions, function()
				if not item:IsDescendantOf(model) then return end
				item.Color = color; item.Material = material; item.Transparency = transparency
				item.CanCollide = collide; item.CanQuery = query; item.CanTouch = touch
				item.CFrame = frame; item.Size = size
			end)
		elseif item:IsA("PointLight") then
			local enabled, brightness = item.Enabled, item.Brightness
			table.insert(actions, function() if item:IsDescendantOf(model) then item.Enabled = enabled; item.Brightness = brightness end end)
		end
	end
	return { restore = function() for _, action in actions do action() end end }
end
function Reset.humanoid(model: Model, health: number): Humanoid
	local old = model:FindFirstChildOfClass("Humanoid")
	if old then old:Destroy() end
	local humanoid = Instance.new("Humanoid")
	-- Dead humanoids cannot be revived by assigning Health. Use a fresh one.
	humanoid.BreakJointsOnDeath = false; humanoid.RequiresNeck = false
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	humanoid.MaxHealth = health; humanoid.Health = health; humanoid.Parent = model
	return humanoid
end
return Reset
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="260">
          <Properties>
            <string name="Name">StructureService</string>
            <string name="Source"><![CDATA[--!strict
-- Registry and protection only: no dependencies on damage, combat, or tower scheduling.
local Rules = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared").Game.StructureRules)
export type Structure = { model: Model, humanoid: Humanoid, root: BasePart, teamId: string, lane: string, kind: string }
local Service = {}
local records: { [Model]: Structure } = {}
function Service.Register(model: Model): Structure
	if records[model] then return records[model] end
	local humanoid = model:FindFirstChildOfClass("Humanoid"); local root = model:FindFirstChild("HumanoidRootPart")
	assert(humanoid and root and root:IsA("BasePart") and Rules.isStructure(model:GetAttribute("EntityKind")), "Invalid structure")
	local record: Structure = { model = model, humanoid = humanoid, root = root, teamId = tostring(model:GetAttribute("TeamId")),
		lane = tostring(model:GetAttribute("Lane") or ""), kind = tostring(model:GetAttribute("EntityKind")) }
	records[model] = record; return record
end
function Service.GetAll(): { [Model]: Structure } return records end
function Service.Alive(record: Structure): boolean
	return record.model:IsDescendantOf(workspace) and record.root:IsDescendantOf(record.model)
		and record.humanoid.Parent == record.model and record.humanoid.Health > 0 and record.model:GetAttribute("IsDestroyed") ~= true
end
function Service.Remaining(teamId: string): number
	local count = 0
	for _, record in records do if record.kind == "Tower" and record.teamId == teamId and Service.Alive(record) then count += 1 end end
	return count
end
function Service.BlockingTier(model: Model): number?
	if model:GetAttribute("EntityKind") ~= "Tower" then return nil end
	local tier = (model:GetAttribute("TowerTier") or 1) :: number
	local blocked: number? = nil
	for other, record in records do
		local level = (other:GetAttribute("TowerTier") or 1) :: number
		if record.kind == "Tower" and record.teamId == model:GetAttribute("TeamId") and record.lane == model:GetAttribute("Lane")
			and level < tier and Service.Alive(record) then blocked = math.min(blocked or level, level) end
	end
	return blocked
end
function Service.CanReceive(model: Model): boolean
	local kind = model:GetAttribute("EntityKind")
	if kind == "Tower" then return Rules.canReceive(kind,0,if Service.BlockingTier(model) then 1 else 0) end
	if kind ~= "Base" then return true end
	return Rules.canReceive(kind, Service.Remaining(tostring(model:GetAttribute("TeamId"))))
end
function Service.Remove(model: Model) records[model] = nil end
return Service
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="261">
          <Properties>
            <string name="Name">SummonCollision</string>
            <string name="Source"><![CDATA[--!strict
-- Humanoid initialization may restore CanCollide on copied rig parts. Collision
-- groups are the authoritative nonblocking guarantee, independent of that flag.
local Physics = game:GetService("PhysicsService")
local Collision = {}
local ready = false
function Collision.Apply(model: Model)
	if not ready then
		for _, name in { "SurvivalHeroes", "SurvivalMinions", "SurvivalSummons" } do
			if not Physics:IsCollisionGroupRegistered(name) then Physics:RegisterCollisionGroup(name) end
		end
		for _, name in { "SurvivalHeroes", "SurvivalMinions", "SurvivalSummons" } do
			Physics:CollisionGroupSetCollidable("SurvivalSummons", name, false)
		end
		-- Keep Default collidable: navigation's world raycasts still see terrain.
		ready = true
	end
	for _, item in model:GetDescendants() do
		if item:IsA("BasePart") then
			item.CollisionGroup = "SurvivalSummons"
			item.CanCollide = false; item.CanTouch = false
		end
	end
end
return Collision
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="262">
          <Properties>
            <string name="Name">TeamService</string>
            <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local Teams = game:GetService("Teams")
local Physics = game:GetService("PhysicsService")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config.GameModeConfig)
local Rules = require(Shared.Game.MatchState)
local Roster = require(Shared.Game.MatchRoster)
local TeamService = {}
local neutral: { [Model]: boolean } = setmetatable({}, { __mode = "k" })
function TeamService.RegisterNeutral(model: Model) neutral[model] = true end
function TeamService.RemoveNeutral(model: Model) neutral[model] = nil end
function TeamService.IsNeutral(model: Model): boolean return neutral[model] == true end
local JungleRules = require(Shared.Game.JungleRules)
local state: Rules.State? = nil
local map: Folder? = nil
local teams: { [string]: Team } = {}
local roster: Roster.State? = nil
local connections: { [Player]: { RBXScriptConnection } } = {}
local deaths: { [Player]: RBXScriptConnection } = {}
local descendants: { [Player]: RBXScriptConnection } = {}
local pending: { [Player]: number } = {}
local loading: { [Player]: number } = {}
local resetRound = 1
function TeamService.GetId(model: Model): string?
	local player = Players:GetPlayerFromCharacter(model)
	local id = if player then player:GetAttribute("TeamId") else model:GetAttribute("TeamId")
	return if typeof(id) == "string" then id else nil
end
function TeamService.IsActive(id: string?): boolean
	local current = state
	return current ~= nil and id ~= nil and current.teams[id] ~= nil and current.teams[id].active
end
function TeamService.IsEnemy(first: Model, second: Model): boolean
	local current = state
	if not current then return first ~= second end -- Isolated M1 regression scene.
	if neutral[first] or neutral[second] then
		return JungleRules.hostile(neutral[first] == true, neutral[second] == true, TeamService.IsActive(TeamService.GetId(first)), TeamService.IsActive(TeamService.GetId(second)))
	end
	return Rules.enemy(current, TeamService.GetId(first), TeamService.GetId(second))
end
function TeamService.GetActiveTeams(): { string }
	return if state then Rules.active(state) else {}
end
function TeamService.GetState(): Rules.State? return state end
function TeamService.IsParticipant(player: Player): boolean
	local current, members = state, roster
	return current ~= nil and members ~= nil and Roster.teamOf(members, player.UserId) ~= nil
		and player.Parent == Players and player:GetAttribute("Spectating") ~= true
end
function TeamService.Count(): number
	return if roster then Roster.connectedCount(roster) else 0
end
function TeamService.Ready(minimumPerTeam: number): boolean
	return roster ~= nil and Roster.ready(roster, minimumPerTeam)
end
function TeamService.LockRoster()
	if roster then Roster.lock(roster) end
end
local function syncCounts()
	local current, members = state, roster
	if not current or not members then return end
	local counts = Roster.counts(members)
	for id, team in current.teams do team.count = counts[id] or 0 end
end
local function invalidateCharacter(player: Player)
	pending[player] = nil
	local character = player.Character
	if character then
		character:SetAttribute("CombatDisabled", true)
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if humanoid then humanoid.Health = 0 end
	end
end
local function canSpawn(player: Player): boolean
	local current = state
	local id = player:GetAttribute("TeamId")
	return player.Parent == Players and current ~= nil and current.phase ~= "Finished"
		and TeamService.IsParticipant(player) and typeof(id) == "string" and TeamService.IsActive(id)
end
local function characterAdded(player: Player, character: Model)
	local current = state; if not current then return end
	local epoch = loading[player] or current.roundId
	character:SetAttribute("RoundId", epoch)
	if deaths[player] then deaths[player]:Disconnect(); deaths[player] = nil end
	if descendants[player] then descendants[player]:Disconnect() end
	local function collision(item: Instance)
		if item:IsA("BasePart") and item.CollisionGroup == "Default" then item.CollisionGroup = "SurvivalHeroes" end
	end
	for _, item in character:GetDescendants() do collision(item) end
	descendants[player] = character.DescendantAdded:Connect(collision)
	local id = player:GetAttribute("TeamId")
	character:SetAttribute("TeamId", id); character:SetAttribute("EntityKind", "Hero")
	task.spawn(function()
		local humanoid = character:WaitForChild("Humanoid", 10)
		local root = character:WaitForChild("HumanoidRootPart", 10)
		if player.Character ~= character or player.Parent ~= Players then return end
		if not humanoid or not humanoid:IsA("Humanoid") or not root or not root:IsA("BasePart") then return end
		-- Humanoid treats other rigs as climbable geometry. Lane contact must stay planar.
		humanoid:SetStateEnabled(Enum.HumanoidStateType.Climbing, false)
		humanoid.AutoJumpEnabled = false
		if epoch ~= current.roundId or not canSpawn(player) then invalidateCharacter(player); return end
		local respawn = player.RespawnLocation
		if respawn then character:PivotTo(respawn.CFrame + Vector3.new(0, 4, 0)) end
		character:SetAttribute("CombatDisabled", false)
		deaths[player] = humanoid.Died:Connect(function()
			if epoch == current.roundId and player.Character == character and canSpawn(player) then pending[player] = workspace:GetServerTimeNow() + Config.RespawnTime end
		end)
	end)
end
local function add(player: Player)
	local current, arena = state, map
	assert(current and arena)
	player:SetAttribute("RoundId", current.roundId)
	local members = roster; assert(members)
	local id: string? = if current.phase ~= "Finished" then Roster.join(members, player.UserId) else nil
	local eliminated = id ~= nil and not TeamService.IsActive(id)
	if eliminated then id = nil end
	syncCounts()
	player.Neutral = true
	if id then
		player:SetAttribute("Spectating", false)
		player.Team = teams[id]; player.Neutral = false
		player:SetAttribute("TeamId", id); player:SetAttribute("Eliminated", false)
		local points = arena:FindFirstChild("SpawnPoints"); assert(points)
		local teamPoints = points:FindFirstChild(id); assert(teamPoints)
		local spawn = teamPoints:FindFirstChild("Hero")
		assert(spawn and spawn:IsA("SpawnLocation"), "Hero spawn missing for " .. id)
		player.RespawnLocation = spawn
		pending[player] = workspace:GetServerTimeNow()
	else
		-- Roblox permits clearing these object references; the API definitions omit nil.
		player.Team = nil :: any; player.RespawnLocation = nil :: any
		player:SetAttribute("TeamId", nil)
		player:SetAttribute("Spectating", true)
		player:SetAttribute("Eliminated", eliminated)
		invalidateCharacter(player)
	end
	if not connections[player] then connections[player] = {
		player.CharacterAdded:Connect(function(character) characterAdded(player, character) end),
		player.CharacterRemoving:Connect(function()
			if deaths[player] then deaths[player]:Disconnect(); deaths[player] = nil end
			if descendants[player] then descendants[player]:Disconnect(); descendants[player] = nil end
		end),
	} end
	if player.Character then characterAdded(player, player.Character) end
end
function TeamService.Eliminate(id: string)
	for _, player in Players:GetPlayers() do
		if player:GetAttribute("TeamId") == id then
			player:SetAttribute("Eliminated", true); invalidateCharacter(player)
		end
	end
end
function TeamService.Finish()
	table.clear(pending)
	for _, player in Players:GetPlayers() do
		local character = player.Character
		if character then
			character:SetAttribute("CombatDisabled", true)
			local humanoid = character:FindFirstChildOfClass("Humanoid")
			if humanoid then humanoid:Move(Vector3.zero); humanoid.WalkSpeed = 0; humanoid.JumpPower = 0; humanoid.JumpHeight = 0 end
		end
	end
end
function TeamService.Update(now: number)
	local current = state; if not current then return end
	-- Fill vacated lobby slots deterministically. A locked round accepts only its
	-- original members on reconnect; new arrivals spectate for the remainder of this match.
	if current.phase == "WaitingForPlayers" or current.phase == "Preparing" then
		local waiting = Players:GetPlayers()
		table.sort(waiting, function(a: Player, b: Player) return a.UserId < b.UserId end)
		for _, player in waiting do
			if TeamService.Count() >= #current.order * Config.TeamCapacity then break end
			if player:GetAttribute("Spectating") == true then add(player) end
		end
	end
	for player, due in pending do
		if now >= due and not loading[player] then
			pending[player] = nil
			if not canSpawn(player) then continue end
			local epoch = current.roundId
			loading[player] = epoch
			task.spawn(function()
				local ok, message = pcall(function() player:LoadCharacterAsync() end)
				loading[player] = nil
				if not ok then warn("[Teams] Character load failed: " .. tostring(message)) end
				if epoch ~= current.roundId then
					local model = player.Character
					if model and model:GetAttribute("RoundId") == epoch then model:Destroy(); player.Character = nil end
					if canSpawn(player) then pending[player] = workspace:GetServerTimeNow() end
				elseif not canSpawn(player) then invalidateCharacter(player)
				elseif not ok then pending[player] = workspace:GetServerTimeNow() + 2 end
			end)
		end
	end
end
function TeamService.Start(match: Rules.State, arena: Folder)
	if state then return end; state = match; map = arena; resetRound = match.roundId
	roster = Roster.new(match.order, Config.TeamCapacity)
	Players.CharacterAutoLoads = false
	for _, name in { "SurvivalHeroes", "SurvivalMinions" } do
		if not Physics:IsCollisionGroupRegistered(name) then Physics:RegisterCollisionGroup(name) end
	end
	-- Lane units body-block heroes; summons keep their separate nonblocking group.
	Physics:CollisionGroupSetCollidable("SurvivalHeroes", "SurvivalMinions", true)
	for _, definition in Config.Teams do
		local existing = Teams:FindFirstChild(definition.Id)
		assert(not existing or existing:IsA("Team"), "Team name occupied")
		local team = (existing or Instance.new("Team")) :: Team
		team.Name = definition.Id; team.TeamColor = BrickColor.new(definition.Color); team.AutoAssignable = false
		team.Parent = Teams; teams[definition.Id] = team
	end
	Players.PlayerAdded:Connect(add)
	Players.PlayerRemoving:Connect(function(player)
		local wasAssigned = roster ~= nil and Roster.teamOf(roster, player.UserId) ~= nil
		if roster then Roster.leave(roster, player.UserId) end
		if wasAssigned and match.phase == "Preparing" then
			match.phase = "WaitingForPlayers"; match.preparationEnds = 0
		end
		syncCounts()
		pending[player] = nil
		if deaths[player] then deaths[player]:Disconnect(); deaths[player] = nil end
		if descendants[player] then descendants[player]:Disconnect(); descendants[player] = nil end
		for _, connection in connections[player] or {} do connection:Disconnect() end
		connections[player] = nil
	end)
	for _, player in Players:GetPlayers() do add(player) end
end
function TeamService.Reset(roundId: number)
	local current = state; assert(current and current.roundId == roundId)
	if roundId <= resetRound then return end; resetRound = roundId
	table.clear(pending); roster = Roster.new(current.order, Config.TeamCapacity)
	for _, team in current.teams do team.count = 0 end
	local players = Players:GetPlayers()
	table.sort(players, function(a: Player, b: Player) return a.UserId < b.UserId end)
	for _, player in players do
		if deaths[player] then deaths[player]:Disconnect(); deaths[player] = nil end
		if descendants[player] then descendants[player]:Disconnect(); descendants[player] = nil end
		local character = player.Character
		if character then character:SetAttribute("CombatDisabled", true); character:Destroy(); player.Character = nil end
		player:SetAttribute("RoundId", roundId)
		add(player)
	end
end
return TeamService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="263">
          <Properties>
            <string name="Name">TowerFactory</string>
            <string name="Source"><![CDATA[--!strict
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config.TowerConfig)
local Map = require(Shared.Config.MapConfig)
local Mode = require(Shared.Config.GameModeConfig)
local Factory = {}
function Factory.Build(map: Folder): Folder
	local existing = map:FindFirstChild("Towers")
	assert(not existing or existing:IsA("Folder"), "Map.Towers must be a Folder")
	local container = existing or Instance.new("Folder"); container.Name = "Towers"; container.Parent = map
	local layouts = Config.Positions :: { [string]: { [string]: { { number } } } }
	for _, team in Mode.Teams do for _, lane in Map.LaneOrder do for tier, profile in Config.Tiers do
		local name = team.Id .. "_" .. lane .. (if tier == 1 then "" else "_T" .. tier)
		local previous = container:FindFirstChild(name)
		if previous then
			assert(previous:IsA("Model") and previous:GetAttribute("ManagedTower") == true, "Unknown object occupies tower slot " .. name)
			continue
		end
		local positions = layouts[team.Id] and layouts[team.Id][lane]
		local coordinates = positions and positions[tier]; assert(coordinates, "Tower layout missing: " .. name)
		local origin = Map.Origin + Vector3.new(coordinates[1], coordinates[2], coordinates[3])
		local model = Instance.new("Model"); model.Name = name
		model:SetAttribute("ManagedTower", true); model:SetAttribute("EntityKind", "Tower"); model:SetAttribute("TeamId", team.Id)
		model:SetAttribute("Lane", lane); model:SetAttribute("IsDestroyed", false); model:SetAttribute("TowerState", "Idle")
		model:SetAttribute("TowerTier", tier); model:SetAttribute("TowerTitle", profile.Name)
		model:SetAttribute("AttackDamage", Config.Damage * profile.DamageMultiplier)
		model:SetAttribute("AttackInterval", Config.AttackInterval * profile.IntervalMultiplier)
		model:SetAttribute("AttackRange", Config.Range)
		model:SetAttribute("CrystalSize", 2.6 + (tier-1)*.35)
		local shield=Instance.new("Highlight");shield.Name="ProtectionShield";shield.Adornee=model
		shield.FillColor=Color3.fromRGB(150,190,235);shield.FillTransparency=.87
		shield.OutlineColor=Color3.fromRGB(190,215,250);shield.OutlineTransparency=.35
		shield.DepthMode=Enum.HighlightDepthMode.Occluded;shield.Enabled=tier>1;shield.Parent=model
		local function part(partName: string, size: Vector3, offset: Vector3, color: Color3, hurtbox: boolean): Part
			local item = Instance.new("Part"); item.Name = partName; item.Size = size; item.Position = origin + offset
			item.Anchored = true; item.CanCollide = hurtbox; item.CanQuery = hurtbox; item.CanTouch = false
			item:SetAttribute("StructureCosmetic", not hurtbox); item.Color = color; item.Material = Enum.Material.Metal
			item.TopSurface = Enum.SurfaceType.Smooth; item.BottomSurface = Enum.SurfaceType.Smooth; item.Parent = model; return item
		end
		local root = part("HumanoidRootPart", Vector3.new(5, 6, 5), Vector3.zero, Color3.fromRGB(55, 64, 78), true)
		model.PrimaryPart = root
		part("Plinth", Vector3.new(8+tier-1, 1, 8+tier-1), Vector3.new(0, -2.5, 0), Color3.fromRGB(36, 43, 54), false)
		if profile.Height > 0 then
			part("UpperPillar", Vector3.new(5, profile.Height, 5), Vector3.new(0, 3+profile.Height/2, 0), Color3.fromRGB(55, 64, 78), false)
		end
		part("Capital", Vector3.new(7+tier-1, 1, 7+tier-1), Vector3.new(0, 3.5+profile.Height, 0), team.Color, false)
		for level = 1, tier do
			part("RankBand"..level, Vector3.new(5.3,.25,5.3), Vector3.new(0,1.4+(level-1)*1.5,0), Color3.fromRGB(230,192,98), false).Material=Enum.Material.Neon
		end
		for _, side in { -1, 1 } do
			part("TeamStripe", Vector3.new(0.22, 4, 2), Vector3.new(side * 2.6, 0, 0), team.Color, false).Material = Enum.Material.Neon
			part("Fin", Vector3.new(0.6, 4, 0.6), Vector3.new(side * 2.5, 5+profile.Height, 0), team.Color, false)
		end
		local crystal = part("Crystal", Vector3.one*(2.6+(tier-1)*.35), Vector3.new(0, 6.3+profile.Height, 0), team.Color, false)
		crystal.Material = Enum.Material.Neon; crystal.CFrame *= CFrame.Angles(0, math.pi / 4, math.pi / 4)
		local light = Instance.new("PointLight"); light.Color = team.Color; light.Brightness = 0.8; light.Range = 12; light.Parent = crystal
		local humanoid = Instance.new("Humanoid"); humanoid.RequiresNeck = false; humanoid.BreakJointsOnDeath = false
		humanoid.MaxHealth = Config.Health*profile.HealthMultiplier; humanoid.Health = humanoid.MaxHealth; humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		humanoid.Parent = model; model.Parent = container
	end end end
	return container :: Folder
end
return Factory
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="264">
          <Properties>
            <string name="Name">TowerRewardService</string>
            <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Rules = require(Shared.Game.TowerRules)
local Config = require(Shared.Config.TowerConfig)
local Economy = require(script.Parent.EconomyService)
local Teams = require(script.Parent.TeamService)
local Structures = require(script.Parent.StructureService)
local Reward = {}
local ledger: { [Model]: Rules.State } = setmetatable({}, { __mode = "k" })
local ledgerRound = 0
-- Called synchronously after confirmed damage, before a same-frame core kill can finish the match.
function Reward.Confirmed(attacker: Model, target: Model)
	local record = Structures.GetAll()[target]
	if not record or record.kind ~= "Tower" or record.humanoid.Health > 0 then return end
	local attackingTeam = tostring(attacker:GetAttribute("TeamId"))
	local match = Teams.GetState()
	if not match or match.phase ~= "InProgress" or attacker:GetAttribute("RoundId") ~= match.roundId
		or target:GetAttribute("RoundId") ~= match.roundId or not Teams.IsActive(attackingTeam) then return end
	if ledgerRound ~= match.roundId then table.clear(ledger); ledgerRound = match.roundId end
	local state = ledger[target]
	if not state then state = Rules.new(); Rules.destroy(state); ledger[target] = state end
	if not Rules.claimReward(state, attackingTeam ~= record.teamId) then return end
	for _, player in Players:GetPlayers() do
		if Rules.recipient(attackingTeam, tostring(player:GetAttribute("TeamId")), player.Parent == Players,
			Economy.IsEligible(player), player:GetAttribute("Eliminated") == true) then
			Economy.AddGold(player, Config.TeamGold, "TowerDestroyed")
		end
	end
end
return Reward
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="265">
          <Properties>
            <string name="Name">TowerService</string>
            <string name="Source"><![CDATA[--!strict
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Players = game:GetService("Players")
local Config = require(Shared.Config.TowerConfig)
local Rules = require(Shared.Game.TowerRules)
local Structures = require(script.Parent.StructureService)
local Fighters = require(script.Parent.FighterStateService)
local Damage = require(script.Parent.DamageService)
local Teams = require(script.Parent.TeamService)
local Factory = require(script.Parent.TowerFactory)
local Hitboxes = require(script.Parent.HitboxService)
local Reset = require(script.Parent.StructureReset)
export type Tower = { structure: Structures.Structure, logic: Rules.State, crystal: BasePart,
	label: TextLabel, fill: Frame, connections: { RBXScriptConnection } }
local Service = { Event = Instance.new("BindableEvent") }
local records: { [Model]: Tower } = {}
local ids: { [Model]: number } = setmetatable({}, { __mode = "k" })
local models: { [number]: Model } = setmetatable({}, { __mode = "v" })
local serial = 0
local started = false
local currentRound = 0
local arena: Folder? = nil
local visuals: { [Model]: Reset.Snapshot } = {}
local function idFor(model: Model): number
	if ids[model] then return ids[model] end
	serial += 1; ids[model] = serial; models[serial] = model; return serial
end
function Service.GetAll(): { [Model]: Tower } return records end
local function tier(model: Model)
	return Config.Tiers[math.clamp(math.floor((model:GetAttribute("TowerTier") or 1) :: number),1,#Config.Tiers)]
end
local function mode(tower: Tower, value: string)
	tower.structure.model:SetAttribute("TowerState", value)
	tower.structure.model:SetAttribute("ChargeEndsAt", if tower.logic.shot then tower.logic.contactAt else 0)
end
local function health(tower: Tower)
	local record = tower.structure
	record.model:SetAttribute("CurrentHealth", record.humanoid.Health)
	record.model:SetAttribute("MaxHealth", record.humanoid.MaxHealth)
	local profile = tier(record.model)
	local blocking = Structures.BlockingTier(record.model)
	record.model:SetAttribute("ProtectedByPreviousTower",blocking~=nil)
	record.model:SetAttribute("BlockingTowerTier",blocking or 0)
	local shield=record.model:FindFirstChild("ProtectionShield")
	if shield and shield:IsA("Highlight") then shield.Enabled=blocking~=nil and record.humanoid.Health>0 end
	tower.label.Text = string.format("%s • %s\n%s · %s  |  %d урона\n%d / %d", record.teamId, record.lane, profile.Mark, profile.Name,
		Config.Damage*profile.DamageMultiplier, math.ceil(record.humanoid.Health), record.humanoid.MaxHealth)
	if blocking then tower.label.Text ..= "\nЩИТ · сначала вышка "..Config.Tiers[blocking].Mark end
	tower.fill.Size = UDim2.fromScale(math.clamp(record.humanoid.Health / record.humanoid.MaxHealth, 0, 1), 1)
end
local function refreshProtection()
	for _, tower in records do if not tower.logic.destroyed then health(tower) end end
end
local function destroy(tower: Tower)
	if not Rules.destroy(tower.logic) then return end
	local record = tower.structure
	record.model:SetAttribute("IsDestroyed", true); mode(tower, "Destroyed")
	local shield=record.model:FindFirstChild("ProtectionShield")
	if shield and shield:IsA("Highlight") then shield.Enabled=false end
	for _, item in record.model:GetDescendants() do
		if item:IsA("BasePart") and item:GetAttribute("StructureCosmetic") ~= nil then
			item.CanCollide = false; item.CanQuery = false; item.CanTouch = false
			item.Transparency = if item.Name == "Plinth" then 0 else 1
			item.Material = Enum.Material.Slate; item.Color = Color3.fromRGB(47, 50, 58)
		elseif item:IsA("PointLight") and item.Parent and item.Parent:GetAttribute("StructureCosmetic") ~= nil then item.Enabled = false end
	end
	tower.label.Text = record.teamId .. " • " .. record.lane .. "\nБАШНЯ РАЗРУШЕНА"; tower.fill.Size = UDim2.fromScale(0, 1)
	refreshProtection()
	Service.Event:Fire("Destroyed", record.model, tower.crystal.Position, tower.crystal.Position, record.teamId, record.lane, currentRound)
end
local function valid(tower: Tower, model: Model): boolean
	local kind = tostring(model:GetAttribute("EntityKind"))
	if not (Config.TargetPriority :: { [string]: number })[kind] or (kind == "Summon" and not Config.AllowSummons) then return false end
	if kind == "Hero" then
		local player = Players:GetPlayerFromCharacter(model)
		if not player or player.Parent ~= Players or player:GetAttribute("Eliminated") == true then return false end
	end
	local root = model:FindFirstChild("HumanoidRootPart")
	if not root or not root:IsA("BasePart") or not Damage.CanDamage(tower.structure.model, model) then return false end
	if not Hitboxes.IsFiniteCFrame(root.CFrame) or not Hitboxes.IsFiniteCFrame(tower.structure.root.CFrame) then return false end
	if (root.Position - tower.structure.root.Position).Magnitude > Config.Range then return false end
	local excluded: { Instance } = { tower.structure.model, model }
	for actor in Fighters.GetAll() do table.insert(excluded, actor) end
	local summons = workspace:FindFirstChild("HeroSummons"); if summons then table.insert(excluded, summons) end
	local ray = RaycastParams.new(); ray.FilterType = Enum.RaycastFilterType.Exclude; ray.FilterDescendantsInstances = excluded; ray.RespectCanCollide = true
	-- Use the combat center for LOS so a short solid wall cannot be bypassed by the decorative crystal's height.
	return workspace:Raycast(tower.structure.root.Position, root.Position - tower.structure.root.Position, ray) == nil
end
function Service.CancelAll()
	for _, tower in records do
		Rules.cancel(tower.logic)
		if not tower.logic.destroyed then mode(tower, "Idle") end
	end
end
function Service.Update(now: number)
	local match = Teams.GetState()
	if not match or match.phase ~= "InProgress" then Service.CancelAll(); return end
	for model, tower in records do
		if not model:IsDescendantOf(workspace) or tower.structure.humanoid.Parent ~= model or not tower.structure.root:IsDescendantOf(model) then
			Rules.destroy(tower.logic); Structures.Remove(model)
			for _, connection in tower.connections do connection:Disconnect() end
			records[model] = nil; visuals[model] = nil; refreshProtection(); continue
		end
		if tower.structure.humanoid.Health <= 0 then destroy(tower) end
		if tower.logic.destroyed then continue end
		if not Damage.CanAct(model) then Rules.cancel(tower.logic); mode(tower, "Idle"); continue end
		local pending = tower.logic.shot
		if pending then
			local target = models[pending]
			local confirmed = Rules.contact(tower.logic, now, target ~= nil and valid(tower, target), true)
			if confirmed and target then
				local humanoid = target:FindFirstChildOfClass("Humanoid")
				local root = target:FindFirstChild("HumanoidRootPart")
				mode(tower, "Attacking"); model:SetAttribute("LastShotAt", now)
				if humanoid and root and root:IsA("BasePart") then
					local position = root.Position
					Damage.Apply(model, humanoid, Config.Damage*tier(model).DamageMultiplier)
					Service.Event:Fire("Shot", model, tower.crystal.Position, position, tower.structure.teamId, tower.structure.lane, currentRound)
				end
			elseif not tower.logic.shot then mode(tower, "Idle") end
			continue
		end
		local samples: { Rules.Candidate } = {}
		for actor, fighter in Fighters.GetAll() do
			table.insert(samples, { id = idFor(actor), kind = tostring(actor:GetAttribute("EntityKind")),
				distance = (fighter.root.Position - tower.structure.root.Position).Magnitude, valid = valid(tower, actor) })
		end
		local target = Rules.choose(tower.logic, samples, now, Config.TargetPriority, Config.AllowSummons)
		tower.logic.target = target
		if target and Rules.begin(tower.logic, target, now, Config.Windup, Config.AttackInterval*tier(model).IntervalMultiplier) then mode(tower, "Charging")
		elseif now >= ((model:GetAttribute("LastShotAt") or 0) :: number) + Config.Visual.ProjectileDuration then mode(tower, "Idle") end
	end
end
local function bindHealth(tower: Tower)
	local record, epoch = tower.structure, currentRound
	table.insert(tower.connections, record.humanoid.HealthChanged:Connect(function()
		if currentRound ~= epoch or tower.structure ~= record then return end
		health(tower); if record.humanoid.Health <= 0 then destroy(tower) end
	end))
end
local function register(model: Model)
	visuals[model] = Reset.capture(model); model:SetAttribute("RoundId", currentRound)
	local record = Structures.Register(model)
	local crystal = model:FindFirstChild("Crystal"); assert(crystal and crystal:IsA("BasePart"))
	local board = Instance.new("BillboardGui"); board.Name = "TowerHealth"; board.Size = UDim2.fromOffset(230, 88)
	board.StudsOffset = Vector3.new(0, 10+tier(model).Height, 0); board.MaxDistance = 105; board.AlwaysOnTop = true; board.Parent = record.root
	local label = Instance.new("TextLabel"); label.Size = UDim2.new(1, 0, 1, -8); label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBold; label.TextSize = 14; label.TextColor3 = Color3.new(1, 1, 1); label.TextStrokeTransparency = 0.25; label.Parent = board
	local track = Instance.new("Frame"); track.Size = UDim2.new(1, 0, 0, 5); track.Position = UDim2.new(0, 0, 1, -5)
	track.BackgroundColor3 = Color3.fromRGB(25, 28, 35); track.BorderSizePixel = 0; track.Parent = board
	local fill = Instance.new("Frame"); fill.BackgroundColor3 = crystal.Color; fill.BorderSizePixel = 0; fill.Parent = track
	local tower: Tower = { structure = record, logic = Rules.new(), crystal = crystal, label = label, fill = fill, connections = {} }
	records[model] = tower; health(tower)
	bindHealth(tower)
end
function Service.Reset(roundId: number)
	if roundId <= currentRound then return end
	Service.CancelAll(); currentRound = roundId
	table.clear(ids); table.clear(models); serial = 0
	for model, tower in records do
		for _, connection in tower.connections do connection:Disconnect() end; table.clear(tower.connections)
		visuals[model].restore(); Structures.Remove(model)
		Reset.humanoid(model, Config.Health*tier(model).HealthMultiplier)
		model:SetAttribute("RoundId", roundId); model:SetAttribute("IsDestroyed", false)
		model:SetAttribute("LastShotAt", 0); model:SetAttribute("CombatDisabled", false)
		tower.structure = Structures.Register(model); tower.logic = Rules.new()
		mode(tower, "Idle"); health(tower); bindHealth(tower)
	end
	local map = arena; assert(map)
	for _, model in Factory.Build(map):GetChildren() do
		if model:IsA("Model") and model:GetAttribute("ManagedTower") == true and not records[model] then register(model) end
	end
	refreshProtection()
end
function Service.Start(map: Folder)
	if started then return end; started = true
	arena = map
	local match = Teams.GetState(); currentRound = if match then match.roundId else 1
	local container = Factory.Build(map)
	for _, model in container:GetChildren() do
		if not model:IsA("Model") or model:GetAttribute("ManagedTower") ~= true then continue end
		register(model)
	end
	refreshProtection()
	Damage.Applied.Event:Connect(function(attacker: Model, victim: Model, amount: number, roundId: number?)
		if amount <= 0 or roundId ~= currentRound then return end
		local killed = records[victim]
		if killed and killed.structure.humanoid.Health <= 0 then
			destroy(killed)
		end
		if attacker:GetAttribute("EntityKind") ~= "Hero" or victim:GetAttribute("EntityKind") ~= "Hero" then return end
		local victimRoot = victim:FindFirstChild("HumanoidRootPart"); if not victimRoot or not victimRoot:IsA("BasePart") then return end
		local now = workspace:GetServerTimeNow()
		for _, tower in records do
			if victim:GetAttribute("TeamId") == tower.structure.teamId and (victimRoot.Position - tower.structure.root.Position).Magnitude <= Config.Range
				and valid(tower, attacker) then Rules.aggress(tower.logic, idFor(attacker), now, Config.AggroDuration, true) end
		end
	end)
end
return Service
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="266">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <token name="GameSettingsAvatar">1</token>
      <bool name="LoadCharacterAppearance">false</bool>
    </Properties>
    <Item class="StarterPlayerScripts" referent="267">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="268">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="Folder" referent="269">
          <Properties>
            <string name="Name">Controllers</string>
          </Properties>
          <Item class="ModuleScript" referent="270">
            <Properties>
              <string name="Name">AbilityController</string>
              <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Input = game:GetService("UserInputService")
local Gui = game:GetService("GuiService")
local RunService = game:GetService("RunService")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config.AbilityConfig)
local Sasuke=require(Shared.Abilities.SasukeDefinitions)
local SasukeRules=require(Shared.Abilities.SasukeRules)
local VFX = require(script.Parent.AbilityVFXController)
local Rounds = require(script.Parent.RoundController)
local Gama=require(Shared.Abilities.GamakichiState)
local Targeting=require(script.Parent.AbilityTargeting)
local Feedback=require(script.Parent.VFXController)
local quickKey: Enum.KeyCode? = nil
local UpgradeQueue=require(Shared.Abilities.RasenganUpgradeQueue)
local upgrades: UpgradeQueue.State? = nil
local upgradeCharacter: Model? = nil
local pendingAbility: string? = nil
local function clearUpgrades()
 if upgrades then UpgradeQueue.clear(upgrades) end
 upgrades=nil; upgradeCharacter=nil
end
local Controller = { Changed = Instance.new("BindableEvent") }
local remote: RemoteEvent? = nil
local serial, pendingId, pendingAt = 0, 0, 0
local corrections: { [string]: number } = {}
local correctionModel: Model? = nil
-- Corrections bridge replication latency; replicated deadlines remain authoritative after that window.
local correctionUntil = 0
local lastReason = ""
local selectingCommand: string? = nil
local needsTarget = Targeting.IsTargeted
function Controller.CancelCloneCommand()
	selectingCommand = nil; quickKey = nil; Targeting.Clear(); Players.LocalPlayer:SetAttribute("SelectingCloneTarget", nil); lastReason = ""
end
function Controller.SelectedAbility(): string? return selectingCommand end
function Controller.GetUpgradeQueue(): {string} return if upgrades then table.clone(upgrades.items) else {} end
function Controller.GetQueuedUpgrade(id: string): boolean
 local queue=upgrades
 return queue~=nil and not queue.closed and (queue.awaiting==id or table.find(queue.items,id)~=nil)
end
function Controller.IsSelectingCloneTarget(): boolean return selectingCommand~=nil end
function Controller.ClearCooldownCorrections()
 if not RunService:IsStudio() then return end
 corrections={};correctionUntil=0;Controller.Changed:Fire()
end
local function sasukeContinuation(id:string):boolean
 local m=Players.LocalPlayer.Character;if not m or m:GetAttribute("HeroId")~="Sasuke" then return false end
 return (id=="Amaterasu" and ((m:GetAttribute("AmaterasuControlUntil") or 0) :: number)>workspace:GetServerTimeNow()) or (id=="Garuda" and m:GetAttribute("GarudaActive")==true) or (id=="Sharingan" and ((m:GetAttribute("SasukeMode") or 0) :: number)>0) or (id=="SusanooRibs" and m:GetAttribute("SusanooForm")==1) or (id=="Amenotejikara" and ((m:GetAttribute("AmenotejikaraSelectingUntil") or 0) :: number)>workspace:GetServerTimeNow())
end
function Controller.Remaining(id: string): number
 if sasukeContinuation(id) then return 0 end
 if Sasuke.Spells[id] then id=Sasuke.cooldownKey(id) end
 if id=="ShadowSleep" then id="ShadowClones" elseif id=="MeditationCast" then id="SageMode" end
	if RunService:IsStudio() and Players.LocalPlayer:GetAttribute("DeveloperNoCooldown")==true then return 0 end
	local model = Players.LocalPlayer.Character; if not model then return 0 end
	local deadline = model:GetAttribute("Ready_" .. id)
	return math.max(0, math.max(if typeof(deadline) == "number" then deadline else 0,
		if correctionModel == model and workspace:GetServerTimeNow() < correctionUntil then corrections[id] or 0 else 0) - workspace:GetServerTimeNow())
end
function Controller.Unavailable(summonOrder: boolean?): string?
	local player = Players.LocalPlayer; local model = player.Character
	local humanoid = if model then model:FindFirstChildOfClass("Humanoid") else nil
	if not model or not humanoid or humanoid.Health <= 0 or model:GetAttribute("CombatDisabled") == true or player:GetAttribute("Eliminated") == true then return "Недоступно" end
	if player:GetAttribute("HeroSelectionOpen")==true then return "Выберите героя" end
	if player:GetAttribute("ShopOpen") == true then return "Закройте магазин" end
	if Input:GetFocusedTextBox() then return "Ввод текста" end
	-- Alt only exposes the cursor for HUD buttons and mouse targeting.
	if Gui.MenuIsOpen or player:GetAttribute("StatsOpen")==true or player:GetAttribute("DeveloperConsoleOpen")==true then return "Закройте меню" end
	local match = ReplicatedStorage:FindFirstChild("SurvivalState")
	if not match or match:GetAttribute("Phase") ~= "InProgress" then return "Ожидание матча" end
	if ((model:GetAttribute("SleepUntil") or 0) :: number)>workspace:GetServerTimeNow() then return "Sleep" end
	if not summonOrder and model:GetAttribute("CombatState") == "Stunned" then return "Контроль" end
	if not summonOrder and model:GetAttribute("AbilityId") ~= "" and model:GetAttribute("AbilityId") ~= nil then return "Подготовка" end
	local nextM1 = model:GetAttribute("CombatNextAttackAt")
	if not summonOrder and typeof(nextM1) == "number" and nextM1 > workspace:GetServerTimeNow() then return "Восстановление" end
	if pendingId > 0 and workspace:GetServerTimeNow() - pendingAt < 1.5 then return "Ожидание ответа" end
	return nil
end
function Controller.Cost(id: string): number
 if id=="Amaterasu" and sasukeContinuation(id) then return 0 end
 if sasukeContinuation(id) then return 0 end
 if Sasuke.Spells[id] then local state=Players.LocalPlayer:FindFirstChild("HeroState");return Sasuke.cost(id,if state then (state:GetAttribute("Rank_"..Sasuke.Spells[id].line) or 0) :: number else 0) end
 if id=="MeditationCast" then id="SageMode" end
 local state=Players.LocalPlayer:FindFirstChild("HeroState")
 return if id=="RikudoHY" or id=="RikudoHZ" then 1800 elseif id=="KcmDash" then 100 elseif id=="Odama" or id=="Rasenshuriken" or id=="ShadowSleep" then 200 elseif id=="SageMode" then 25 elseif id == "Rasengan" then 100 elseif id == "ShadowClones" then 200 elseif id=="Gamakichi" then Gama.rank(if state then (state:GetAttribute("Rank_Gamakichi") or 0) :: number else 0) or 0 else 0
end
function Controller.AbilityUnavailable(id: string): string?
 if Sasuke.Spells[id] then
  local common=Controller.Unavailable(id=="SasukeModeOff");if common then return common end
  local player=Players.LocalPlayer;local m=player.Character;local state=player:FindFirstChild("HeroState")
  if player:GetAttribute("HeroId")~="Sasuke" or not m or not state then return "Другой герой" end
  local function n(key:string):number return (m:GetAttribute(key) or 0) :: number end
  local reason=SasukeRules.reason(id,{rank=(state:GetAttribute("Rank_"..Sasuke.Spells[id].line) or 0) :: number,mode=n("SasukeMode"),held=m:GetAttribute("ChidoriHeld")==true,readyAt=n("ChidoriReadyAt"),now=workspace:GetServerTimeNow(),form=n("SusanooForm"),kirinAt=n("KirinReadyAt"),kirinUntil=n("KirinUntil"),spheres=n("ChibakuCount"),beasts=n("SasukeBijuu"),garuda=m:GetAttribute("GarudaActive")==true})
  if reason then return reason end
  if n("SasukeFireUntil")>workspace:GetServerTimeNow() and id~="SasukeModeOff" then return "Техника огня: движение прервёт её" end
  if id=="ChakraAbsorb" then return "На поле пока нет источников чакры хвостатых" end
  if n("Mana")<Controller.Cost(id) and id~="SasukeModeOff" then return "Недостаточно чакры" end
  return nil
 end
 if id=="MeditationCast" then return Controller.AbilityUnavailable("SageMode") end
	if not (Config.PrototypeEnabled :: { [string]: boolean })[id] then return "В разработке" end
	local unavailable = Controller.Unavailable(id=="CloneCommand" or id=="KcmCancel" or id=="GamakichiOil" or id=="GamakichiChop"); if unavailable then return unavailable end
	local player = Players.LocalPlayer; local model = player.Character; if not model then return "Недоступно" end
	if (id=="RikudoHY" or id=="RikudoHZ") and model:GetAttribute("RikudoRangedGranted")~=true then return "Нужен активный Рикудо" end
 local state = player:FindFirstChild("HeroState"); local level = if state then state:GetAttribute("Level") else nil
 local line=if id=="KcmDash" or id=="KcmCancel" then "KCM" elseif id=="MeditationToggle" or id=="MeditationRecall" then "SageMode" elseif id=="CloneCommand" then "ShadowClones" elseif id=="GamakichiOil" or id=="GamakichiChop" then "Gamakichi" else id
 if (id=="KCM" or id=="KcmDash" or id=="KcmCancel" or id=="GamakichiOil" or id=="GamakichiChop" or id=="Rasengan" or id=="ShadowClones" or id=="Gamakichi" or id=="SageMode" or id=="MeditationToggle" or id=="MeditationRecall" or id=="CloneCommand") and (not state or (if id=="CloneCommand" then math.max((state:GetAttribute("Rank_ShadowClones") or 0) :: number,(state:GetAttribute("Rank_Gamakichi") or 0) :: number) else ((state:GetAttribute("Rank_"..line) or 0) :: number))<1) then return "Не изучено" end
	if id == "Rasengan" and (typeof(level) ~= "number" or level < 4) then return "С уровня 4" end
	if id=="MeditationRecall" and (model:GetAttribute("MeditationCloneCount") or 0)==0 then return "Нет медитирующих клонов" end
	if id=="Odama" or id=="Rasenshuriken" then
  if model:GetAttribute("KcmActive")==true or model:GetAttribute("KuramaActive")==true or (model:GetAttribute("SagePhase")~=nil and model:GetAttribute("SagePhase")~="" and model:GetAttribute("SagePhase")~="Active") then return "Нужна обычная форма или готовый режим мудреца" end
  local rank=if state then (state:GetAttribute("Rank_Rasengan") or 0) :: number else 0
  local untilAt=(model:GetAttribute("RasenganVariantUntil") or 0) :: number
  local wanted=if id=="Odama" or model:GetAttribute("RasenganVariant")=="Rasengan" then "Rasengan" else "Odama"
  if rank<(if id=="Odama" then 2 else 3) then return if id=="Odama" then "Нужен II ранг Расенгана" else "Нужен III ранг Расенгана" end
  if model:GetAttribute("RasenganVariant")~=wanted then return if id=="Odama" then "Сначала Q — Расенган" else "Сначала Q — Расенган" end
  if untilAt<=workspace:GetServerTimeNow() then return "Окно усиления закрыто" end
 end
 if id=="RasenshurikenThrow" and (model:GetAttribute("SagePhase")~="Active" or model:GetAttribute("SageTechniquesReady")~=true or model:GetAttribute("RasenganVariant")~="Rasenshuriken" or model:GetAttribute("RasenganPhase")~="Holding") then return "Мудрец → Q → X → дождитесь формирования" end
 if id=="ShadowSleep" and (not state or ((state:GetAttribute("Rank_ShadowClones") or 0) :: number)<2) then return "Нужен II ранг клонов" end
	if id=="KuramaForm" then
  if typeof(level)~="number" or level<21 then return "Курама с уровня 21" end
  if model:GetAttribute("KcmActive")==true then return "Сначала выйдите из KCM / Рикудо: C → V" end
  if model:GetAttribute("KuramaLocked")==true then return "Форма Курамы уже действует" end
  if ((model:GetAttribute("KuramaChakra") or 0) :: number)<2500 then return "Нужно 2500 чакры Курамы" end
 end
 local kcm=model:GetAttribute("KcmActive")==true
 if id=="KCM" and not kcm and state and state:GetAttribute("Rank_KCM")==3 and model:GetAttribute("HagoromoUnlocked")~=true then return "Для Рикудо нужен дар Хагоромо" end
 if id=="KCM" and model:GetAttribute("KcmAllowed")~=true then
  if kcm then return "Режим уже действует • C → V — выйти" end
  return "Сначала завершите текущий режим"
 end
 if id=="KCM" and ((model:GetAttribute("KuramaChakra") or 0) :: number)<200 then return "Нужно 200 чакры Курамы" end
 if id=="KcmCancel" and not kcm then return "KCM не активен" end
 if id=="KcmDash" and model:GetAttribute("KcmDashReady")~=true then return "Рывок доступен в KCM" end
 if id=="Gamakichi" and kcm then return "Недоступно в KCM" end
 if id=="KuramaConvert" and (typeof(level)~="number" or level<16 or ((model:GetAttribute("KuramaChakra") or 0) :: number)<200) then return "Уровень 16 и 200 чакры Курамы" end

 local mana = model:GetAttribute("Mana")
 if id=="SageMode" and model:GetAttribute("SagePhase")~="" and model:GetAttribute("SagePhase")~=nil then return "Режим уже действует" end
 if id=="SageMode" and model:GetAttribute("RikudoActive")==true then return "В Рикудо нельзя заново включить режим мудреца" end
 local cost = Controller.Cost(id)
	if cost > 0 and (typeof(mana) ~= "number" or mana < cost) then return "Недостаточно маны" end
	if id == "CloneCommand" and (model:GetAttribute("NativeCloneCount") or 0) == 0 and (model:GetAttribute("GamakichiCount") or 0)==0 then return "Нет клонов" end
 if (id=="GamakichiOil" or id=="GamakichiChop") and (model:GetAttribute("GamakichiCount") or 0)==0 then return "Нет Гамакичи" end
 if id=="GamakichiChop" and model:GetAttribute("GamakichiAdult")~=true then return "Только взрослый Гамакичи" end
 return nil
end
local function reject(reason: string): boolean
 lastReason=reason; Controller.Changed:Fire(); return false
end
function Controller.BeginTarget(id: string): boolean
 if not needsTarget(id) then return false end
 local reason=Controller.AbilityUnavailable(id)
 if reason then return reject(reason) end
 if Controller.Remaining(id)>0 then return reject("Способность восстанавливается") end
 quickKey=nil; selectingCommand=id; Players.LocalPlayer:SetAttribute("SelectingCloneTarget",true)
 lastReason="ЛКМ — применить · ПКМ / Esc — отмена"; Controller.Changed:Fire(); return true
end
function Controller.BeginCloneCommand(): boolean return Controller.BeginTarget("CloneCommand") end
function Controller.PickCloneTarget(point: Vector2?): Model? return Targeting.PickModel(point) end
function Controller.ConfirmTarget(): boolean
 if not selectingCommand then return false end
 local target,reason=Targeting.Evaluate(selectingCommand)
 if reason then return reject(reason) end
 return Controller.TryCast(selectingCommand,target)
end
function Controller.Command(mode: string): boolean
 if mode=="Follow" or mode=="Hold" then return Controller.TryCast("CloneCommand",mode) end
 if not Controller.BeginCloneCommand() then return false end
 return Controller.ConfirmTarget()
end
local function dispatch(id: string, selectedTarget: any): boolean
	if not remote or not Config.Abilities[id] then return false end
	local reason=Controller.AbilityUnavailable(id); if reason then return reject(reason) end
	if Controller.Remaining(id)>0 then return reject("Способность восстанавливается") end
	local model = Players.LocalPlayer.Character; if not model then return false end
	local target = if needsTarget(id) or id=="RasenshurikenThrow" then selectedTarget else nil
	if needsTarget(id) and not target then return Controller.BeginTarget(id) end
	serial += 1; if serial > Config.MaxRequestId then return false end
	pendingId = serial; pendingAt = workspace:GetServerTimeNow(); pendingAbility=id; lastReason = ""
	if selectingCommand then
		selectingCommand = nil; quickKey=nil; Targeting.Clear()
		-- Consume the target-selection click for every InputBegan listener this frame.
		RunService.PreRender:Once(function()
			if not selectingCommand then Players.LocalPlayer:SetAttribute("SelectingCloneTarget", nil) end
		end)
	end
	if target then remote:FireServer(serial, model, id, target, Rounds.Current())
	else remote:FireServer(serial, model, id, Rounds.Current()) end
	Controller.Changed:Fire(); return true
end
local function queueUpgrade(id: string): boolean
 local player=Players.LocalPlayer; local model=player.Character
 if not model then return reject("Недоступно") end
 local now=workspace:GetServerTimeNow()
 local unavailable=Controller.Unavailable()
 if unavailable and unavailable~="Ожидание ответа" then clearUpgrades(); return reject(unavailable) end
 if unavailable=="Ожидание ответа" and pendingAbility~="Rasengan" and pendingAbility~="Odama" and pendingAbility~="Rasenshuriken" then
  return reject(unavailable)
 end
 if model:GetAttribute("KcmActive")==true or model:GetAttribute("KuramaActive")==true
  or (model:GetAttribute("SagePhase")~=nil and model:GetAttribute("SagePhase")~="" and model:GetAttribute("SagePhase")~="Active") then
  clearUpgrades(); return reject("Нужна обычная форма или готовый режим мудреца")
 end
 local hero=player:FindFirstChild("HeroState")
 local rank=if hero then (hero:GetAttribute("Rank_Rasengan") or 0) :: number else 0
 if rank<(if id=="Odama" then 2 else 3) then return reject(if id=="Odama" then "Нужен II ранг Расенгана" else "Нужен III ранг Расенгана") end
 local queue=upgrades
 -- Repeated presses on a submitted/queued step never send a second request.
 if queue and not queue.closed and (queue.awaiting==id or queue.stage==id or table.find(queue.items,id)) then return true end
 if Controller.Remaining(id)>0 then return reject("Способность восстанавливается") end
 if ((model:GetAttribute("Mana") or 0) :: number)<200 then return reject("Для усиления нужно ещё 200 чакры") end
 if not queue or queue.closed or upgradeCharacter~=model then
  local variant=model:GetAttribute("RasenganVariant")
  if variant~="Rasengan" and variant~="Odama" then return reject(if id=="Odama" then "Сначала Q — Расенган" else "Сначала Q — Расенган") end
  queue=UpgradeQueue.new((model:GetAttribute("NarutoCastId") or 0) :: number,variant,
   (model:GetAttribute("RasenganVariantUntil") or 0) :: number,nil)
  upgrades=queue; upgradeCharacter=model
 end
 assert(queue)
 local ok,reason=UpgradeQueue.enqueue(queue,id,now)
 if not ok then return reject(if reason=="Window" then "Окно усиления закрыто" else "Сначала Q — Расенган") end
 lastReason=""; Controller.Changed:Fire(); return true
end
function Controller.TryCast(id: string, selectedTarget: any): boolean
 if id=="Odama" or id=="Rasenshuriken" then return queueUpgrade(id) end
 local ok=dispatch(id,selectedTarget)
 if ok then
  clearUpgrades()
  if id=="Rasengan" then
   local model=Players.LocalPlayer.Character
   if model then
    upgradeCharacter=model
    upgrades=UpgradeQueue.new(((model:GetAttribute("NarutoCastId") or 0) :: number)+1,"Rasengan",workspace:GetServerTimeNow()+1.25,"Rasengan")
   end
  end
 end
 return ok
end
function Controller.TryThrowRasenshuriken(): boolean
 local model=Players.LocalPlayer.Character
 if not model or model:GetAttribute("SageTechniquesReady")~=true or model:GetAttribute("SagePhase")~="Active" or model:GetAttribute("RasenganVariant")~="Rasenshuriken" then return false end
 if model:GetAttribute("RasenganPhase")~="Holding" or ((model:GetAttribute("RasenganReadyAt") or 0) :: number)>workspace:GetServerTimeNow() then return true end
 local camera=require(script.Parent.CameraController);local ray=camera.GetAimRay()
 if not ray then return true end
 local params=RaycastParams.new();params.FilterType=Enum.RaycastFilterType.Exclude;params.FilterDescendantsInstances={model}
 local hit=workspace:Raycast(ray.Origin,ray.Direction*120,params)
 dispatch("RasenshurikenThrow",if hit then hit.Position else ray.Origin+ray.Direction*120)
 return true
end
local function flushUpgrades()
 local queue=upgrades; if not queue then return end
 local player=Players.LocalPlayer; local model=player.Character; local now=workspace:GetServerTimeNow()
 local hp=if model then model:FindFirstChildOfClass("Humanoid") else nil
 if model~=upgradeCharacter or not model or not hp or hp.Health<=0 or model:GetAttribute("CombatDisabled")==true
  or Gui.MenuIsOpen or Input:GetFocusedTextBox() or player:GetAttribute("ShopOpen")==true or player:GetAttribute("StatsOpen")==true
  or model:GetAttribute("KcmActive")==true or model:GetAttribute("KuramaActive")==true
  or (model:GetAttribute("SagePhase")~=nil and model:GetAttribute("SagePhase")~="" and model:GetAttribute("SagePhase")~="Active") or UpgradeQueue.expired(queue,now) then
  clearUpgrades(); return
 end
 local cast=(model:GetAttribute("NarutoCastId") or 0) :: number
 -- A base request creates the next cast; replication can precede or trail Result.
 if queue.awaiting=="Rasengan" and cast==queue.castId-1 then return end
 if not UpgradeQueue.observe(queue,cast,tostring(model:GetAttribute("RasenganVariant")),
  (model:GetAttribute("RasenganVariantUntil") or 0) :: number,now) then clearUpgrades(); return end
 if pendingId>0 then return end
 local nextId=UpgradeQueue.next(queue,now); if not nextId then return end
 local reason=Controller.AbilityUnavailable(nextId)
 if reason or Controller.Remaining(nextId)>0 then clearUpgrades(); reject(reason or "Способность восстанавливается"); return end
 if dispatch(nextId,nil) then UpgradeQueue.sent(queue,nextId,now) else clearUpgrades() end
end
function Controller.GetMessage(): string
 local model=Players.LocalPlayer.Character
 if lastReason~="" then return lastReason end
 if model and model:GetAttribute("RasenganHeld")==true then
  local variant=tostring(model:GetAttribute("RasenganVariant"))
  if variant=="Rasenshuriken" and model:GetAttribute("SageTechniquesReady")==true and model:GetAttribute("SagePhase")=="Active" then return "Расенсюрикен · ЛКМ — бросить по прицелу" end
  local name=if variant=="Odama" then "Одама Расенган" elseif variant=="Rasenshuriken" then "Расенсюрикен" else "Расенган"
  local nextId=if variant=="Rasengan" then "Odama" elseif variant=="Odama" then "Rasenshuriken" else nil
  if nextId and not Controller.AbilityUnavailable(nextId) and Controller.Remaining(nextId)<=0 then
   local hero=Players.LocalPlayer:FindFirstChild("HeroState")
   local third=hero~=nil and ((hero:GetAttribute("Rank_Rasengan") or 0) :: number)>=3
   return if nextId=="Odama" then (if third then "Z — Одама / X — Расенсюрикен · +200 чакры" else "Z — Одама · +200 чакры") else "X — усилить до Расенсюрикена · +200 чакры"
  end
  local phase=model:GetAttribute("RasenganPhase")
  return if phase=="Consumed" then name..": попадание" elseif phase=="Preparing" then name..": формирование в руке…" else name.." готов · подойдите к врагу и нажмите ЛКМ"
 end
 return if model and model:GetAttribute("MeditationMode")==true then "Медитация: T → T · вернуть чакру: T → Z" else ""
end
function Controller.GetFormStatus(): string
 local model=Players.LocalPlayer.Character; if not model then return "" end
 if model:GetAttribute("HeroId")=="Sasuke" then return if ((model:GetAttribute("SasukeFireUntil") or 0) :: number)>workspace:GetServerTimeNow() then "Огненная техника • движение прерывает" elseif ((model:GetAttribute("AmaterasuControlUntil") or 0) :: number)>workspace:GetServerTimeNow() then "Управление Аматерасу • F → F и новая цель" elseif model:GetAttribute("ChidoriHeld")==true then "Чидори в руке • первое попадание ЛКМ расходует заряд" else "" end
 local chakra=model:GetAttribute("KuramaChakra"); if typeof(chakra)~="number" then return "" end
 local now=workspace:GetServerTimeNow()
 local layers={}
 if model:GetAttribute("KuramaActive")==true then
  table.insert(layers,string.format("Форма Курамы %.0fс",math.max(0,((model:GetAttribute("KuramaExpiresAt") or now) :: number)-now)))
 elseif model:GetAttribute("KcmActive")==true then
  local rank=model:GetAttribute("KcmRank")
  table.insert(layers,if rank==3 then "Рикудо" elseif rank==2 then "KCM II" else "KCM I")
 end
 if model:GetAttribute("SagePhase")=="Active" then
  local remaining=math.max(0,((model:GetAttribute("SageExpiresAt") or now) :: number)-now)
  table.insert(layers,string.format("%s %.0fс",if model:GetAttribute("SageTechniquesReady")==true then "Мудрец" else "Бонусы мудреца",remaining))
 elseif model:GetAttribute("SagePhase")=="Preparing" then table.insert(layers,"Сбор природной энергии") end
 return string.format("Чакра Курамы %d | %s",math.floor(chakra),if #layers>0 then table.concat(layers," + ") else "C — режимы · T — чакра")
end
function Controller.Start()
	if remote then return end
	Rounds.Watch(function() pendingId = 0; pendingAbility=nil; clearUpgrades(); corrections = {}; correctionModel = nil; Controller.CancelCloneCommand(); Controller.Changed:Fire() end)
	local event = ReplicatedStorage:WaitForChild("HeroAbility", 15); assert(event and event:IsA("RemoteEvent"), "HeroAbility missing")
	remote = event; VFX.Start()
	RunService.Heartbeat:Connect(function()
  flushUpgrades()
		if selectingCommand then
   if Controller.AbilityUnavailable(selectingCommand) then Controller.CancelCloneCommand(); Controller.Changed:Fire()
   else
    local reason=Targeting.Preview(selectingCommand)
    lastReason=(reason or "Цель доступна")..(if quickKey then " · ЛКМ — рывок · ПКМ — отмена" else " · ЛКМ — применить · ПКМ / Esc — отмена")
   end
  end
	end)
	event.OnClientEvent:Connect(function(message: any)
		if not Rounds.Accepts(message.roundId) then return end
		if message.kind == "DamageFeedback" then Feedback.DamageFeedback(message); return end
		if message.kind ~= "Result" then VFX.Event(message); return end
		if message.character ~= Players.LocalPlayer.Character or message.requestId ~= pendingId then return end
		pendingId = 0; pendingAbility=nil; if not message.accepted then clearUpgrades() end; correctionModel = message.character; corrections = message.ready; correctionUntil = workspace:GetServerTimeNow() + 1.5
		local reasons: { [string]: string } = { Window="Окно усиления закрыто", Rank="Нужен следующий ранг Расенгана", FormAdapterUnverified="Усиления доступны в обычной форме", Unlearned="Способность не изучена", Rikudo="Нужен активный Рикудо", Hagoromo="Требуется дар Хагоромо", Chakra="Недостаточно чакры Курамы", Form="Недоступно в текущей форме", Range="Слишком далеко", Blocked="Путь перекрыт", Ground="Выберите устойчивую поверхность", Busy = "Дождитесь завершения действия", Cooldown = "Способность восстанавливается",
			Unavailable = "Сейчас недоступно", RateLimited = "Слишком часто", Replay = "Запрос уже обработан", Mana = "Недостаточно маны",
			Level = "Требуется уровень 4", Target = "Выберите доступного врага", Unsupported = "Ещё не доступно", UnsupportedTarget = "Эта ветка ещё не доступна" }
		lastReason = if message.accepted then "" else reasons[message.reason] or "Запрос отклонён"
		Controller.Changed:Fire()
	end)
	Players.LocalPlayer.CharacterAdded:Connect(function() pendingId = 0; pendingAbility=nil; clearUpgrades(); corrections = {}; correctionModel = nil; Controller.CancelCloneCommand() end)
 Input.InputBegan:Connect(function(input,processed)
  if selectingCommand and input.KeyCode==Enum.KeyCode.Escape then Controller.CancelCloneCommand();Controller.Changed:Fire();return end
  if processed or Input:GetFocusedTextBox() or Gui.MenuIsOpen then return end
  if selectingCommand then
   if input.UserInputType==Enum.UserInputType.MouseButton2 then Controller.CancelCloneCommand();Controller.Changed:Fire();return end
   if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then
    local gui=Players.LocalPlayer:FindFirstChildOfClass("PlayerGui")
    local abilityGui=if gui then gui:FindFirstChild("AbilityHUD") else nil
    if gui and abilityGui then for _,object in gui:GetGuiObjectsAtPosition(input.Position.X,input.Position.Y) do if object:IsDescendantOf(abilityGui) then return end end end
    Controller.ConfirmTarget()
   end
  end
 end)
 Input.WindowFocusReleased:Connect(function() clearUpgrades(); Controller.CancelCloneCommand() end)
 Players.LocalPlayer.CharacterRemoving:Connect(function() clearUpgrades(); Controller.CancelCloneCommand() end)
end
return Controller
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="271">
            <Properties>
              <string name="Name">AbilityDescriptions</string>
              <string name="Source"><![CDATA[--!strict
-- Player-facing descriptions shared by main and temporary ability slots.
return {
 MeditationCast="T → T начинает подготовку режима мудреца с медитирующими клонами. В отличие от C → C, энергия накапливается в клонах вместо мгновенного восстановления маны. T → Z возвращает их энергию. Общие условия и перезарядка режима мудреца сохраняются.",
 RasenshurikenThrow="Сначала включите режим мудреца и сформируйте Расенсюрикен: Q → X. Когда он готов в руке, ЛКМ бросает его по прицелу. В полёте раскрывает синий купол в области фактического урона.",
 KcmDash="Доступен в активном KCM или Рикудо. F → F, выберите место прицелом и подтвердите ЛКМ. ПКМ / Esc отменяет выбор.",
 KcmCancel="Завершает активный KCM или Рикудо. C → V возвращает обычную форму; самостоятельные бонусы мудреца сохраняют свой таймер. Эта команда не отменяет полную Кураму.",
 KuramaConvert="С уровня 16 переводит 200 отдельной чакры Курамы в 200 обычной маны способностей. T → X — применить. Нужен достаточный запас чакры Курамы.",
 MeditationToggle="Стрелка вправо переключает назначение кнопки 4: обычный режим мудреца или медитация с клонами. Включите медитацию, затем нажмите 4 для подготовки медитирующих клонов. T → Z возвращает их накопленную энергию. Нужна изученная линия режима мудреца.",
 MeditationRecall="T → Z возвращает накопленную энергию медитирующих клонов. Доступно, когда у Наруто есть такие клоны; боевые теневые клоны этой командой не отзываются.",
 Rasengan="Собирает вращающуюся чакру в ладони. После формирования подойдите к врагу и ударьте ЛКМ. Промах сохраняет заряд.\nПосле Q выберите Z — Одама или X — Расенсюрикен напрямую. Варианты появляются над Q; выбранная техника меняет значок Q. Пока сфера формируется, удерживайте ЛКМ: удар начнётся после готовности. Без выбора остаётся обычный Расенган.",
 Odama="Увеличивает обычный Расенган до огромной сферы. Наруто поддерживает её второй рукой и наносит мощный удар вблизи.\nТребуется II ранг Расенгана. Q → Z. Доплата 200 чакры; всего 300. Урон: 250 + 3 × сила. ЛКМ по врагу — применить.",
 Rasenshuriken="Добавляет стихию ветра: над ладонью вращаются четыре острые лопасти. Попадание создаёт расширяющуюся сферу режущих потоков вокруг врага.\nТребуется III ранг. Q → X, Одама не требуется. Доплата 200 чакры; всего 300. В обычной форме — удар ЛКМ вблизи с уроном владельцу. В режиме мудреца — ЛКМ бросает по прицелу на расстояние до 110 studs. При попадании раскрывается синий купол; бросок не ранит владельца.",
 ShadowClones="Создаёт теневых клонов. Они распределяются между видимыми врагами в радиусе 28 студов, окружают их и занимают свободные места для атаки. Если враг один, клоны сменяют друг друга после ударов. После гибели цели выбирают новую.\nБез врагов следуют за Наруто; при удалении дальше 48 студов возвращаются. Призванные в воздухе клоны приземляются. E → X — приоритетная цель; E → V — за мной; E → B — стоять без атак. После возврата снова ищут врагов. Количество и длительность зависят от ранга. На IV ранге обычный призыв создаёт 30 клонов, если после оплаты остаётся 30% максимальной маны; иначе — 7. Массовый призыв дополнительно расходует эти 30%.",
 Gamakichi="Призывает Гамакичи. Ранг определяет силу и возраст жабы. Она самостоятельно ищет видимых врагов вокруг себя: выпускает масло, сближается, взрослая жаба применяет рубящие удары. Если рядом нет противников, идёт к ближайшей вражеской вышке и бьёт её обычными атаками. При появлении врага переключается с вышки на него. Общие команды E → X / V / B имеют приоритет; «Стоять» прекращает автоматические атаки и прокаст, «За мной» отзывает её из боя. К Наруто не привязана: его удаление не прерывает бой. После явного отзыва снова действует самостоятельно.\nR → Z — выбрать врага для масла. Взрослая жаба получает R → X — серию ударов мечом по области. ЛКМ подтверждает цель, ПКМ отменяет.",
 SageMode="Наруто неподвижно собирает природную энергию: 10 / 7 / 4 секунды по рангу. Усиление действует 51 секунду, аура — первые 47. Даёт здоровье, броню, урон и скорость; восстанавливает 200 / 350 / 500 маны.\nМожно включить поверх KCM I–II или полной Курамы: бонусы складываются, таймер мудреца идёт отдельно. В Рикудо новый режим мудреца недоступен. При выходе из KCM бонусы мудреца сохраняются до конца таймера, но его техники отключаются.\nВ обычной форме доступны Q → Z — Одама и Q → X — Расенсюрикен. T → T — медитация; T → Z — вернуть чакру из медитирующих клонов.",
 KCM="Ранги: KCM I, KCM II, Рикудо. Вход расходует 200 чакры Курамы, поддержание — 40 в секунду. Это отдельный запас от маны способностей.\nДля сочетания сначала включите KCM I–II, затем режим мудреца: их бонусы складываются. Сам режим мудреца блокирует новый вход в KCM; выход из KCM или завершение полной Курамы снимают эту блокировку. Рикудо не позволяет заново включить мудреца. Полная Курама и KCM одновременно недоступны.\nF → F — прицелиться для рывка. C → V — выйти. T → X — обменять 200 чакры Курамы на 200 маны.",
 KuramaForm="Полная форма Курамы с уровня 21. Требует 2500 чакры Курамы, действует 30 секунд, перезарядка — 160 секунд. Даёт +2500 здоровья, +20 брони и +90 урона.\nЛКМ — широкий взмах лапой: каждый враг, которого заденут кисть или предплечье, получает урон один раз за взмах. Базовый интервал — 2 секунды; ловкость ускоряет атаки. Иногда начало атаки вызывает ударную волну: враги в радиусе 18,75 студов получают урон в размере 4% максимального здоровья Курамы до учёта защиты. Золотое кольцо показывает границу волны.\nБонусы режима мудреца складываются с этой формой и сохраняют свой таймер. KCM одновременно включить нельзя. В этой форме призыв создаёт ровно 4 клона без дополнительного расхода 30% маны. После завершения формы снова можно включить KCM.",
 CloneCommand="Направляет клонов и Гамакичи на вражескую цель под прицелом. Если цели нет, выберите её и подтвердите ЛКМ.\nE → V возвращает призывов к владельцу; E → B оставляет их на месте без автоматических атак. Союзников атаковать нельзя.",
 GamakichiOil="Гамакичи выпускает масло в выбранного врага; эффект распространяется на врагов рядом с ним. Замедление начинается после прилёта, а не при нажатии.\nНаведите прицел, нажмите R → Z и подтвердите ЛКМ. ПКМ / Esc — отмена.",
 GamakichiChop="Взрослый Гамакичи проводит четыре последовательных удара мечом по выбранной области. Урон проходит волнами.\nR → X — выбрать область, ЛКМ — подтвердить. Требуется взрослый призыв. ПКМ / Esc — отмена.",
 RikudoHY="Временная техника Рикудо: мощная атака по выбранной точке. Требуется активная форма и 1800 чакры. F → Z → прицел → ЛКМ. ПКМ / Esc — отмена.",
 RikudoHZ="Временная техника Рикудо с областью поражения. Требуется активная форма и 1800 чакры. F → X → прицел → ЛКМ. ПКМ / Esc — отмена.",
}
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="272">
            <Properties>
              <string name="Name">AbilityFamilyController</string>
              <string name="Source"><![CDATA[--!strict
local Players=game:GetService("Players")
local Input=game:GetService("UserInputService")
local Gui=game:GetService("GuiService")
local RunService=game:GetService("RunService")
local Shared=game.ReplicatedStorage:WaitForChild("Shared")
local NarutoFamilies=require(Shared.Abilities.AbilityFamilies)
local SasukeFamilies=require(Shared.Abilities.SasukeFamilies)
local Sasuke=require(Shared.Abilities.SasukeDefinitions)
local Families:any=NarutoFamilies
local Config=require(Shared.Config.AbilityConfig)
local Controller=require(script.Parent.AbilityController)
local Learning=require(script.Parent.LearningController)
local View=require(script.Parent.MobaHUDView)
local Icons=require(script.Parent.HUDIcons)
local Descriptions=require(script.Parent.AbilityDescriptions)
local Module={}
local started=false
function Module.Start(panel:Frame)
 if started then return end;started=true
 local player=Players.LocalPlayer
 Families=if player:GetAttribute("HeroId")=="Sasuke" then SasukeFamilies else NarutoFamilies
 local function isSasuke():boolean return player:GetAttribute("HeroId")=="Sasuke" end
 local opened:string?=nil;local hovered:string?=nil;local hoveredFamily:string?=nil;local hoveredEntry:NarutoFamilies.Entry?=nil
 local roots:{[string]:TextButton}={};local choices:{TextButton}={};local learnButtons:{{button:TextButton,id:string}}={}
 local strip=View.frame(panel,"FamilyChoices",UDim2.fromOffset(450,194),UDim2.fromOffset(240,-202));strip.Visible=false;strip.ZIndex=6;View.border(strip,View.Gold)
 local title=View.label(strip,"Title",UDim2.fromOffset(372,21),UDim2.fromOffset(7,1),13);title.TextXAlignment=Enum.TextXAlignment.Left;title.TextColor3=View.Gold
 local footer=View.label(strip,"Hint",UDim2.fromOffset(436,18),UDim2.fromOffset(7,175),11);footer.Text="Клавиша — выбор · ЛКМ — цель · ПКМ — отмена · Alt — курсор"
 local tip=View.frame(panel,"FamilyTooltip",UDim2.fromOffset(440,260),UDim2.fromOffset(240,-470));tip.Visible=false;tip.ZIndex=10;View.border(tip,View.Gold)
 local hoverEpoch=0;local tipHovered=false
 local function retainHover() hoverEpoch+=1 end
 local function leaveHover()
  hoverEpoch+=1;local epoch=hoverEpoch
  task.delay(.18,function() if hoverEpoch==epoch and not tipHovered then hovered=nil;hoveredFamily=nil;hoveredEntry=nil end end)
 end
 tip.MouseEnter:Connect(function() tipHovered=true;retainHover() end)
 tip.MouseLeave:Connect(function() tipHovered=false;leaveHover() end)
 local scroll=Instance.new("ScrollingFrame");scroll.Name="Scroll";scroll.Size=UDim2.new(1,-16,1,-16);scroll.Position=UDim2.fromOffset(8,8);scroll.BackgroundTransparency=1;scroll.BorderSizePixel=0;scroll.ScrollBarThickness=4;scroll.CanvasSize=UDim2.new();scroll.AutomaticCanvasSize=Enum.AutomaticSize.Y;scroll.Parent=tip
 local tipText=View.label(scroll,"Text",UDim2.new(1,-8,0,0),UDim2.new(),15);tipText.AutomaticSize=Enum.AutomaticSize.Y;tipText.TextWrapped=true;tipText.TextTruncate=Enum.TextTruncate.None;tipText.TextXAlignment=Enum.TextXAlignment.Left;tipText.TextYAlignment=Enum.TextYAlignment.Top
 local function makeButton(parent:Instance,name:string,x:number,y:number,w:number,h:number):TextButton
  local b=Instance.new("TextButton");b.Name=name;b.Text="";b.Size=UDim2.fromOffset(w,h);b.Position=UDim2.fromOffset(x,y);b.BackgroundColor3=View.Card;b.BorderSizePixel=0;b.Parent=parent;View.border(b,View.Gold);return b
 end
 local function icon(button:TextButton,id:string)
  if button:GetAttribute("IconId")==id then return end
  button:SetAttribute("IconId",id);local symbol=button:FindFirstChild("Symbol") :: Frame
  symbol:ClearAllChildren();Icons.draw(symbol,id)
 end
 local function labelName(entry:NarutoFamilies.Entry):string
  if entry.id=="KCM" then
   local hero=player:FindFirstChild("HeroState");local rank=if hero then hero:GetAttribute("Rank_KCM") else 0
   return if rank==3 then "Рикудо" elseif rank==2 then "KCM II" else "KCM I"
  end
  return entry.name
 end
 local function close()
  opened=nil;strip.Visible=false;hovered=nil;hoveredEntry=nil;player:SetAttribute("AbilityFamily",nil)
 end
 local function blocked():boolean
  local c=player.Character;local h=if c then c:FindFirstChildOfClass("Humanoid") else nil
  return not h or h.Health<=0 or Input:GetFocusedTextBox()~=nil or Gui.MenuIsOpen or player:GetAttribute("HeroSelectionOpen")==true or player:GetAttribute("ShopOpen")==true or player:GetAttribute("StatsOpen")==true or player:GetAttribute("DeveloperConsoleOpen")==true
 end
 local function open(key:string)
  if blocked() then return end
  Controller.CancelCloneCommand();opened=key;hovered=nil;hoveredEntry=nil;hoveredFamily=nil;player:SetAttribute("AbilityFamily",key)
  local family=Families.Definitions[key];local height=if #family.entries>6 then 194 else 118;strip.Size=UDim2.fromOffset(450,height);strip.Position=UDim2.fromOffset(240,-height-8);footer.Position=UDim2.fromOffset(7,height-19);tip.Position=UDim2.fromOffset(240,-height-276);strip.Visible=true;title.Text=family.name..(if key=="E" then " • команды всем боевым призывам" else " • выберите продолжение")
  for i,b in choices do
   local entry=family.entries[i];b.Visible=entry~=nil;b:SetAttribute("AbilityId",if entry then entry.id else nil)
   if entry then
    (b:FindFirstChild("Key") :: TextLabel).Text=entry.key
    icon(b,if entry.id=="MeditationCast" then "MeditationToggle" else entry.id)
   end
  end
 end
 local function rootPress(key:string)
  if blocked() then return end
  open(key)
  if key=="Q" then
   local c=player.Character
   if isSasuke() then
    if not c or c:GetAttribute("ChidoriHeld")~=true then Controller.TryCast("Chidori") end
   elseif not c or c:GetAttribute("RasenganHeld")~=true then Controller.TryCast("Rasengan") end
  end
 end
 local function activate(entry:NarutoFamilies.Entry)
  if blocked() then return end
  local old=opened;close()
  local ok=if entry.command then Controller.Command(entry.command)
   elseif entry.id=="CloneCommand" then Controller.BeginCloneCommand() else Controller.TryCast(entry.id)
  if not ok and old then
   -- Keep the explanation/choices visible without erasing the rejection message.
   opened=old;strip.Visible=true;player:SetAttribute("AbilityFamily",old)
  end
 end
 local function addLearn(parent:TextButton,id:string)
  local plus=makeButton(parent,"Learn",parent.Size.X.Offset-18,-19,18,18);plus.Text="+";plus.TextSize=17;plus.TextColor3=View.Gold;plus.ZIndex=5
  local entry={button=plus,id=id};plus.Activated:Connect(function() Learning.TryLearn(entry.id) end);table.insert(learnButtons,entry)
 end
 for i,key in Families.Order do
  local family=Families.Definitions[key]
  local b=makeButton(panel,"Family"..key,240+(i-1)*75,32,70,78);roots[key]=b
  View.frame(b,"Symbol",UDim2.fromOffset(48,48),UDim2.fromOffset(11,3));icon(b,family.icon)
  local keyText=View.label(b,"Key",UDim2.fromOffset(24,18),UDim2.fromOffset(2,-18),15);keyText.Text=key;keyText.TextColor3=View.Gold
  local name=View.label(b,"Name",UDim2.fromOffset(68,25),UDim2.fromOffset(1,50),11);name.Text=family.name;name.TextWrapped=true
  local status=View.label(b,"Status",UDim2.fromOffset(48,20),UDim2.fromOffset(11,18),15);status.TextStrokeTransparency=.1;status.ZIndex=3
  b.Activated:Connect(function() local _,entry=Families.resolve(opened,key);if entry then activate(entry) else rootPress(key) end end)
  b.MouseEnter:Connect(function() retainHover();hoveredFamily=key;hovered=nil;hoveredEntry=nil;scroll.CanvasPosition=Vector2.zero end)
  b.MouseLeave:Connect(leaveHover)
  if key=="Q" then addLearn(b,if isSasuke() then "SasukeLightning" else "Rasengan") elseif key=="E" then addLearn(b,if isSasuke() then "SasukeFire" else "ShadowClones") elseif key=="R" then addLearn(b,if isSasuke() then "SasukeSummon" else "Gamakichi") elseif key=="C" then addLearn(b,"SasukeEyes") end
 end
 for i=1,12 do
  local b=makeButton(strip,"Choice"..i,((i-1)%6)*75+2,25+math.floor((i-1)/6)*75,70,71);choices[i]=b
  View.frame(b,"Symbol",UDim2.fromOffset(25,25),UDim2.fromOffset(4,3))
  local key=View.label(b,"Key",UDim2.fromOffset(34,23),UDim2.fromOffset(32,3),16);key.TextColor3=View.Gold
  local name=View.label(b,"Name",UDim2.fromOffset(66,26),UDim2.fromOffset(2,29),11);name.TextWrapped=true
  View.label(b,"State",UDim2.fromOffset(66,14),UDim2.fromOffset(2,55),10)
  b.Activated:Connect(function() if opened then local entry=Families.Definitions[opened].entries[i];if entry then activate(entry) end end end)
  b.MouseEnter:Connect(function() retainHover();hovered=b:GetAttribute("AbilityId") :: string?;hoveredEntry=if opened then Families.Definitions[opened].entries[i] else nil;hoveredFamily=nil;scroll.CanvasPosition=Vector2.zero end)
  b.MouseLeave:Connect(leaveHover)
 end
 -- Mode learning remains visible on its own choice, independent of the six families.
 local sageLearn=makeButton(strip,"LearnSage",386,2,27,20);sageLearn.Text="4+";sageLearn.TextColor3=View.Gold;sageLearn.TextSize=17;sageLearn.ZIndex=5
 local kcmLearn=makeButton(strip,"LearnKCM",418,2,27,20);kcmLearn.Text="5+";kcmLearn.TextColor3=View.Gold;kcmLearn.TextSize=17;kcmLearn.ZIndex=5
 sageLearn.Activated:Connect(function() Learning.TryLearn("SageMode") end);kcmLearn.Activated:Connect(function() Learning.TryLearn("KCM") end)
 local function overHUD(input:InputObject):boolean
  local gui=player:FindFirstChildOfClass("PlayerGui");if not gui then return false end
  for _,object in gui:GetGuiObjectsAtPosition(input.Position.X,input.Position.Y) do if object:IsDescendantOf(panel.Parent :: Instance) then return true end end
  return false
 end
 Input.InputBegan:Connect(function(input,processed)
  if blocked() then close();return end
  if input.UserInputType==Enum.UserInputType.MouseButton2 or input.KeyCode==Enum.KeyCode.Escape then close();return end
  if processed then return end
  if input.UserInputType==Enum.UserInputType.MouseButton1 then if not overHUD(input) then close() end;return end
  local key=input.KeyCode.Name
  if Input:IsKeyDown(Enum.KeyCode.LeftControl) or Input:IsKeyDown(Enum.KeyCode.RightControl) then local id=Families.learning(key);if id then Learning.TryLearn(id) end;return end
  local kind,entry=Families.resolve(opened,key)
  if entry then activate(entry)
  elseif kind=="Open" then rootPress(key)
  elseif not opened and (key=="Z" or key=="X") and player.Character and player.Character:GetAttribute("RasenganHeld")==true then
   Controller.TryCast(if key=="Z" then "Odama" else "Rasenshuriken")
  end
 end)
 Input.WindowFocusReleased:Connect(close);player.CharacterRemoving:Connect(close);require(script.Parent.RoundController).Watch(close)
 local nextUpdate=0;local lastForm=""
 RunService.Heartbeat:Connect(function()
  local now=workspace:GetServerTimeNow();if now<nextUpdate then return end;nextUpdate=now+.1
  local c=player.Character;local hero=player:FindFirstChild("HeroState")
  local desired=if isSasuke() then SasukeFamilies else NarutoFamilies
  if Families~=desired then
   Families=desired;close()
   for key,b in roots do local family=Families.Definitions[key];icon(b,family.icon);(b:FindFirstChild("Name") :: TextLabel).Text=family.name end
   for i,entry in learnButtons do entry.id=if isSasuke() then Sasuke.LearningOrder[i] else ({"Rasengan","ShadowClones","Gamakichi","SasukeEyes"})[i] end
  end
  local form=if c then tostring(c:GetAttribute("HeroVisualForm"))..":"..tostring(c:GetAttribute("LifeId"))..":"..tostring(c:GetAttribute("SageTechniquesReady")) else ""
  if form~=lastForm then close();Controller.CancelCloneCommand();lastForm=form end
  if blocked() then close() end
  for _,learn in learnButtons do learn.button.Visible=(learn.id~="SasukeEyes" or isSasuke()) and hero~=nil and hero:GetAttribute("LearnReason_"..learn.id)=="Ready" end
  sageLearn.Visible=not isSasuke() and opened=="C" and hero~=nil and hero:GetAttribute("LearnReason_SageMode")=="Ready"
  kcmLearn.Visible=not isSasuke() and opened=="C" and hero~=nil and hero:GetAttribute("LearnReason_KCM")=="Ready"
  for key,b in roots do
   b.BackgroundColor3=if key==opened then Color3.fromRGB(100,77,35) else View.Card
   local status=b:FindFirstChild("Status") :: TextLabel;status.Text=""
   if isSasuke() then
    if key=="Q" then local held=c and c:GetAttribute("ChidoriHeld")==true;local remaining=Controller.Remaining("Chidori");status.Text=if held then "ЧИДОРИ" elseif remaining>0 then tostring(math.ceil(remaining)) else "";status.TextSize=10
    elseif key=="C" and c then local mode=c:GetAttribute("SasukeMode");status.Text=if mode==3 then "РИННЕГАН" elseif mode==2 then "МАНГЕКЁ" elseif mode==1 then "ШАРИНГАН" else "";status.TextSize=9 end
   elseif key=="Q" then
    local held=c~=nil and c:GetAttribute("RasenganHeld")==true
    local variant=if held and c then tostring(c:GetAttribute("RasenganVariant")) else "Rasengan"
    icon(b,if Config.Abilities[variant] then variant else "Rasengan")
    local remaining=Controller.Remaining("Rasengan")
    status.Text=if held and c then (if now<((c:GetAttribute("RasenganReadyAt") or 0) :: number) then "…" else "ГОТОВ") elseif remaining>0 then tostring(math.ceil(remaining)) else ""
    status.TextColor3=if held then Color3.fromRGB(150,240,255) else View.Text
   elseif key=="R" and c and ((c:GetAttribute("GamakichiCount") or 0) :: number)>0 then status.Text=if c:GetAttribute("SummonOrder")=="Hold" then "СТОИТ" else "АВТО";status.TextSize=11
   elseif key=="C" and c then status.Text=if c:GetAttribute("KuramaActive")==true then "КУРАМА" elseif c:GetAttribute("KcmActive")==true then (if c:GetAttribute("KcmRank")==3 then "РИКУДО" else "KCM") elseif c:GetAttribute("SagePhase")=="Active" then "МУДРЕЦ" else "";status.TextSize=10 end
  end
  if opened then
   for i,b in choices do
    local entry=Families.Definitions[opened].entries[i];if not entry then continue end
    (b:FindFirstChild("Name") :: TextLabel).Text=labelName(entry)
    local reason=Controller.AbilityUnavailable(entry.id);local remaining=Controller.Remaining(entry.id)
    local active=c~=nil and ((entry.id=="KCM" and c:GetAttribute("KcmActive")==true) or (entry.id=="KuramaForm" and c:GetAttribute("KuramaActive")==true) or (entry.id=="SageMode" and c:GetAttribute("SagePhase")=="Active"))
    local state=b:FindFirstChild("State") :: TextLabel
    state.Text=if active then "АКТИВЕН" elseif remaining>0 then math.ceil(remaining).." с" elseif reason then "Недоступно" else "Готово"
    state.TextColor3=if not reason and remaining<=0 then Color3.fromRGB(120,224,158) else Color3.fromRGB(210,167,130)
   end
  end
  tip.Visible=(hovered~=nil or hoveredFamily~=nil) and not blocked()
  if hoveredFamily then
   local family=Families.Definitions[hoveredFamily];local text=family.name.." ["..family.key.."]\n\n"..family.hint.."\n\n"
   for _,entry in family.entries do text..=family.key.." → "..entry.key.."  "..labelName(entry).."\n" end
   if hoveredFamily=="Q" and isSasuke() then text..="\n90 чакры • КД 60 с • молния I, уровень 4\n"..Sasuke.Spells.Chidori.description.."\n" end
   if hoveredFamily=="Q" and not isSasuke() then text..="\n100 маны • "..(Controller.AbilityUnavailable("Rasengan") or "Готово").."\n"..Descriptions.Rasengan.."\n" end
   tipText.Text=text.."\nПервое нажатие открывает выбор"..(if hoveredFamily=="Q" then (if isSasuke() then " и формирует Чидори." else " и формирует Расенган.") else ", чакра не расходуется.")
  elseif hovered then
   local id=hovered;local def=Config.Abilities[id]
   local resource=if id=="KuramaForm" then "2500 чакры Курамы" elseif id=="KCM" then "200 чакры Курамы • 40/с" elseif id=="KuramaConvert" then "200 чакры Курамы → 200 маны" else Controller.Cost(id).." маны"
   local entry=hoveredEntry
   local name=if Sasuke.Spells[id] then Sasuke.Spells[id].name elseif entry then labelName(entry) else def.Name
   local binding=if entry and opened then opened.." → "..entry.key else def.KeyLabel
   local description=if entry and entry.command=="Follow" then "Возвращает всех боевых клонов и Гамакичи к Наруто. После возвращения клоны снова ищут врагов рядом с владельцем, а Гамакичи самостоятельно сражается и атакует вышки." elseif entry and entry.command=="Hold" then "Оставляет всех боевых клонов и Гамакичи на текущих позициях без автоматических атак. E → V отзывает их к Наруто и возобновляет автобой; E → X задаёт цель." else (if Sasuke.Spells[id] then Sasuke.Spells[id].description.."\nРанг "..Sasuke.Spells[id].rank.." • "..Sasuke.Learning[Sasuke.Spells[id].line].name else (Descriptions :: {[string]:string})[id] or "")
   if Sasuke.Spells[id] then local d=Sasuke.Spells[id];local rank=if hero then (hero:GetAttribute("Rank_"..d.line) or 0) :: number else 0;resource..=" • КД "..Sasuke.cooldown(id,rank).." с" end
   tipText.Text=name.." ["..binding.."]\n"..resource.."\n"..(Controller.AbilityUnavailable(id) or (if Controller.Remaining(id)>0 then "КД "..math.ceil(Controller.Remaining(id)).." с" else "Готово")).."\n\n"..description
  end
 end)
end
return Module
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="273">
            <Properties>
              <string name="Name">AbilityHUDController</string>
              <string name="Source"><![CDATA[--!strict
local Players=game:GetService("Players")
local RunService=game:GetService("RunService")
local UserInput=game:GetService("UserInputService")
local Shared=game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Items=require(Shared.Config.ItemConfig)
local Combat=require(Shared.Config.CombatConfig)
local BasicRules=require(Shared.Combat.BasicAttackRules)
local Attributes=require(Shared.Config.AttributeConfig)
local Controller=require(script.Parent.AbilityController)
local Learning=require(script.Parent.LearningController)
local View=require(script.Parent.MobaHUDView)
local Layout=require(script.Parent.HUDLayout)
local Icons=require(script.Parent.HUDIcons)
local HUD={}
local started=false
function HUD.Start()
 if started then return end; started=true; Controller.Start(); Learning.Start()
 local player=Players.LocalPlayer
 local starter=game:GetService("StarterGui")
 starter:SetCoreGuiEnabled(Enum.CoreGuiType.Health,false); starter:SetCoreGuiEnabled(Enum.CoreGuiType.PlayerList,false)
 local gui=Instance.new("ScreenGui"); gui.Name="AbilityHUD"; gui.ResetOnSpawn=false; gui.DisplayOrder=8
 gui.ScreenInsets=Enum.ScreenInsets.None; gui.ZIndexBehavior=Enum.ZIndexBehavior.Sibling; gui.Parent=player:WaitForChild("PlayerGui")
 local panel=View.frame(gui,"Abilities",UDim2.fromOffset(Layout.ConsoleWidth,Layout.ConsoleHeight),UDim2.fromScale(.5,1)); panel.AnchorPoint=Vector2.new(.5,1)
 View.border(panel,View.Gold); local scale=Instance.new("UIScale"); scale.Parent=panel
 local portrait=View.portrait(panel,UDim2.fromOffset(108,132),UDim2.fromOffset(4,25))
 local hero=View.label(panel,"HeroName",UDim2.fromOffset(108,22),UDim2.fromOffset(4,2),13); hero.Text="NARUTO"
 local level=View.label(panel,"Level",UDim2.fromOffset(30,26),UDim2.fromOffset(82,130),17); level.BackgroundTransparency=0; level.BackgroundColor3=View.Background; level.TextColor3=View.Gold
 local xpTrack=View.frame(panel,"XP",UDim2.fromOffset(108,4),UDim2.fromOffset(4,159)); xpTrack.BackgroundColor3=View.Card
 local xpFill=View.frame(xpTrack,"Fill",UDim2.fromScale(0,1),UDim2.new()); xpFill.BackgroundColor3=View.Gold
 local stats=View.label(panel,"CombatStats",UDim2.fromOffset(116,124),UDim2.fromOffset(119,29),13); stats.TextXAlignment=Enum.TextXAlignment.Left; stats.TextYAlignment=Enum.TextYAlignment.Top
 local kda=View.label(panel,"KDA",UDim2.fromOffset(116,22),UDim2.fromOffset(119,2),12)
 local points=View.label(panel,"SkillPoints",UDim2.fromOffset(336,16),UDim2.fromOffset(240,0),12); points.TextColor3=View.Gold
 local gold=View.label(panel,"Gold",UDim2.fromOffset(186,27),UDim2.fromOffset(704,128),17); gold.TextColor3=View.Gold
 local statsToggle=Instance.new("TextButton"); statsToggle.Name="StatsToggle"; statsToggle.Text="I  Характеристики"; statsToggle.Size=UDim2.fromOffset(116,23); statsToggle.Position=UDim2.fromOffset(119,137); statsToggle.TextSize=10; statsToggle.BackgroundColor3=View.Card; statsToggle.TextColor3=View.Gold; statsToggle.Parent=panel
 local statsPanel=View.frame(panel,"CharacterStats",UDim2.fromOffset(350,350),UDim2.fromOffset(0,-360)); statsPanel.Visible=false; View.border(statsPanel,View.Gold)
 local statsText=View.label(statsPanel,"Values",UDim2.new(1,-24,1,-24),UDim2.fromOffset(12,12),14); statsText.TextXAlignment=Enum.TextXAlignment.Left; statsText.TextYAlignment=Enum.TextYAlignment.Top
 local function toggle() statsPanel.Visible=not statsPanel.Visible; player:SetAttribute("StatsOpen",statsPanel.Visible) end
 statsToggle.Activated:Connect(toggle)
 UserInput.InputBegan:Connect(function(input,processed) if not processed and not UserInput:GetFocusedTextBox() and input.KeyCode==Enum.KeyCode.I then toggle() end end)
 local function bar(name: string,y: number,color: Color3): (Frame,TextLabel)
  local track=View.frame(panel,name,UDim2.fromOffset(450,17),UDim2.fromOffset(240,y)); track.BackgroundColor3=View.Card
  local fill=View.frame(track,"Fill",UDim2.fromScale(1,1),UDim2.new()); fill.BackgroundColor3=color
  local text=View.label(track,"Value",UDim2.fromScale(1,1),UDim2.new(),12); text.TextStrokeTransparency=.35; return fill,text
 end
 local hpFill,hpText=bar("Health",124,Color3.fromRGB(74,144,57))
 local mpFill,mpText=bar("Mana",143,Color3.fromRGB(42,105,171))
 local inventory: {{frame: Frame, name: TextLabel, id: string?}}={}
 for index=1,6 do
  local x,y=Layout.item(index)
  local slot=View.frame(panel,"Item"..index,UDim2.fromOffset(58,48),UDim2.fromOffset(x,y)); slot.BackgroundColor3=View.Card
  local name=View.label(slot,"Name",UDim2.new(1,0,0,20),UDim2.new(0,0,1,-20),9); name.ZIndex=2; name.TextWrapped=true; name.TextTruncate=Enum.TextTruncate.None; name.TextStrokeTransparency=.15
  View.border(slot,Color3.fromRGB(91,97,103)); table.insert(inventory,{frame=slot,name=name,id=nil})
 end
 local itemTitle=View.label(panel,"Inventory",UDim2.fromOffset(186,22),UDim2.fromOffset(704,0),11); itemTitle.Text="ПРЕДМЕТЫ"
 local message=View.label(gui,"AbilityMessage",UDim2.fromOffset(620,28),UDim2.new(.5,0,1,-180),14); message.AnchorPoint=Vector2.new(.5,1); message.TextColor3=View.Gold; message.TextStrokeTransparency=.3
 local commands=View.label(gui,"SummonCommands",UDim2.fromOffset(620,24),UDim2.new(.5,0,1,-220),13); commands.AnchorPoint=Vector2.new(.5,1); commands.TextColor3=View.Gold; commands.TextStrokeTransparency=.3
 require(script.Parent.AbilityFamilyController).Start(panel)
 local nextUpdate=0
 RunService.Heartbeat:Connect(function()
  local now=workspace:GetServerTimeNow(); if now<nextUpdate then return end; nextUpdate=now+.1
  local camera=workspace.CurrentCamera
  if camera then
   scale.Scale=Layout.scale(camera.ViewportSize.X,camera.ViewportSize.Y)
   local strip=panel:FindFirstChild("FamilyChoices");local deck=if strip and strip:IsA("Frame") and strip.Visible then strip.Size.Y.Offset+8 else Layout.DeckHeight
   message.Position=UDim2.new(.5,0,1,-((Layout.ConsoleHeight+deck)*scale.Scale+12)); message.Size=UDim2.fromOffset(math.min(900,camera.ViewportSize.X-24),40)
  end
  local model=player.Character; View.updatePortrait(portrait,model)
  commands.Visible=model~=nil and (((model:GetAttribute("NativeCloneCount") or 0) :: number)>0 or ((model:GetAttribute("GamakichiCount") or 0) :: number)>0)
  commands.Position=message.Position-UDim2.fromOffset(0,40)
  local order=tostring(if model then model:GetAttribute("SummonOrder") or "Follow" else "Follow")
  commands.Text="E → X — атаковать · E → V — ко мне · E → B — стоять  ["..(if order=="Hold" then "Стоять" elseif order=="Command" then "Атака" else "Автобой").."]"
  local state=player:FindFirstChild("HeroState")
  local function number(name: string): number local value=if state then state:GetAttribute(name) else nil; return if typeof(value)=="number" then value else 0 end
  local function shown(name: string,format: string): string local value=if state then state:GetAttribute(name) else nil; return if typeof(value)=="number" then string.format(format,value) else "—" end
  local humanoid=if model then model:FindFirstChildOfClass("Humanoid") else nil
  local hp=if humanoid then humanoid.Health else 0; local maximum=if humanoid then humanoid.MaxHealth else 1
  local mana=if model then model:GetAttribute("Mana") else nil; local maxMana=if model then model:GetAttribute("MaxMana") else nil
  local mp=if typeof(mana)=="number" then mana else 0; local maxMP=if typeof(maxMana)=="number" then maxMana else 1
  hpFill.Size=UDim2.fromScale(math.clamp(hp/math.max(1,maximum),0,1),1); hpText.Text=string.format("%d / %d",math.ceil(hp),maximum)
  mpFill.Size=UDim2.fromScale(math.clamp(mp/math.max(1,maxMP),0,1),1); mpText.Text=string.format("%d / %d",math.floor(mp),maxMP)
  level.Text=shown("Level","%d"); gold.Text=shown("Gold","%d GOLD")
  kda.Text=string.format("K/D/A  %d / %d / %d",number("TotalKills"),number("TotalDeaths"),number("Assists"))
  xpFill.Size=UDim2.fromScale(if number("XPToNextLevel")==0 then 1 else math.clamp(number("CurrentXP")/number("XPToNextLevel"),0,1),1)
  local profile=Combat.Profiles[if model then tostring(model:GetAttribute("CombatProfileId")) else "OrangeNinja"] or Combat.Profiles.OrangeNinja
  local rawAttack=profile.Damage*number("AttackDamageMultiplier")+number("AttackDamageBonus")
  local attacksPerSecond=BasicRules.speed(profile,number("Agility"))/profile.AttackCooldown
  stats.Text="STR  "..shown("Strength","%.1f").."\nAGI  "..shown("Agility","%.1f").."\nINT   "..shown("Intelligence","%.1f")..string.format("\nАтака %.1f · %.2f/с",rawAttack,attacksPerSecond).."\nБроня  "..shown("Defense","%.1f").."\nСкор.  "..shown("WalkSpeed","%.1f")
  hero.Text=if player:GetAttribute("HeroId")=="Sasuke" then "SASUKE" else "NARUTO"
  statsText.Text=hero.Text.."  •  Уровень "..shown("Level","%d").."\nXP "..shown("CurrentXP","%d").." / "..shown("XPToNextLevel","%d").."\nОчки навыков: "..shown("SkillPoints","%d").."\n\n"..stats.Text.."\n\nМножитель M1  "..shown("AttackDamageMultiplier","x%.2f").."\nБонус M1  "..shown("AttackDamageBonus","+%.0f").."\nРеген. маны  "..shown("ManaRegen","%.2f/с")
  statsText.Text..=string.format("\n\n1 силы → +%d здоровья\n1 ловкости → +1 скорости атаки\n1 интеллекта → +%d маны\nИнтервал атаки: %.2f с",Attributes.HealthPerStrength,Attributes.Mana.ManaPerIntelligence,1/math.max(.01,attacksPerSecond))
  local owned={}; for _,id in Items.Order do if state and state:GetAttribute("Own_"..id)==true then table.insert(owned,id) end end
  for index,slot in inventory do
   local id=owned[index]
   if slot.id~=id then
    local old=slot.frame:FindFirstChild("Icon"); if old then old:Destroy() end
    if id then Icons.draw(slot.frame,id) end
    slot.id=id
   end
   slot.name.Text=if id then Items.Items[id].Name else "—"
  end
  local notice=if Learning.GetMessage()~="" then Learning.GetMessage() else Controller.GetMessage()
  local formStatus=Controller.GetFormStatus()
  local familyTip=panel:FindFirstChild("FamilyTooltip")
  message.Visible=not (familyTip and familyTip:IsA("GuiObject") and familyTip.Visible)
  if not message.Visible then commands.Visible=false end
  message.Text=if notice~="" and formStatus~="" then notice.."\n"..formStatus else notice..formStatus
  points.Text=if number("SkillPoints")>0 then string.format((if player:GetAttribute("HeroId")=="Sasuke" then "+ %d  •  Ctrl+1–4 / + для обучения" else "+ %d  •  Ctrl+1–5 / + для обучения"),number("SkillPoints")) else "НАВЫКИ"

 end)
end
return HUD
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="274">
            <Properties>
              <string name="Name">AbilityTargeting</string>
              <string name="Source"><![CDATA[--!strict
-- Preview only: server services still decide legality, resources and hits.
local Players = game:GetService("Players")
local Input = game:GetService("UserInputService")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Units = require(Shared.Abilities.WorldUnits)
local Definitions = require(Shared.Abilities.NarutoDefinitions)
local Spells = require(Shared.Abilities.GamakichiSpells)
local Kcm = require(Shared.Abilities.NarutoKcmGameplay)
local Ranged = require(Shared.Abilities.NarutoRangedState)
local Sasuke=require(Shared.Abilities.SasukeDefinitions)
local SasukePresentation=require(Shared.Abilities.SasukePresentation)
local Targeting = {}
local folder: Folder? = nil
local ring: {Part} = {}
local line: Part? = nil
local marker: Part? = nil
local growthRing: {Part} = {}
local highlight: Highlight? = nil
local validColor, invalidColor = Color3.fromRGB(94,225,205), Color3.fromRGB(255,104,98)
-- NarutoRangedState starts both explosions at 636 WC; HY expands by 4 for 58 pulses.
local rangedRadius, hyMaximumRadius = 636, 636 + 4*58
local actors: {[Model]: boolean} = {}
local function actorAdded(item: Instance)
	if item:IsA("Humanoid") and item.Parent and item.Parent:IsA("Model") then actors[item.Parent] = true end
end
for _, item in workspace:GetDescendants() do actorAdded(item) end
workspace.DescendantAdded:Connect(actorAdded)
workspace.DescendantRemoving:Connect(function(item)
	if item:IsA("Humanoid") and item.Parent and item.Parent:IsA("Model") then actors[item.Parent] = nil end
end)

function Targeting.IsTargeted(id: string): boolean
	return (Sasuke.Spells[id]~=nil and Sasuke.Spells[id].target~="Self") or id == "CloneCommand" or id == "ShadowSleep" or id == "GamakichiOil" or id == "GamakichiChop" or id == "KcmDash" or id == "RikudoHY" or id == "RikudoHZ"
end
local function exclusions(): {Instance}
	local player = Players.LocalPlayer
	local excluded: {Instance} = {}
	if player.Character then table.insert(excluded, player.Character) end
	if folder then table.insert(excluded, folder) end
	local summons = workspace:FindFirstChild("HeroSummons")
	if summons then for _, model in summons:GetChildren() do
		if model:GetAttribute("TeamId") == player:GetAttribute("TeamId") then table.insert(excluded, model) end
	end end
	return excluded
end
function Targeting.Pick(point: Vector2?): RaycastResult?
	local camera = workspace.CurrentCamera; if not camera then return nil end
	local mouse = point or Input:GetMouseLocation()
	local ray = if Input.MouseBehavior == Enum.MouseBehavior.LockCenter
		then camera:ViewportPointToRay(camera.ViewportSize.X/2, camera.ViewportSize.Y/2)
		else camera:ScreenPointToRay(mouse.X, mouse.Y)
	local params = RaycastParams.new(); params.FilterDescendantsInstances = exclusions()
	return workspace:Raycast(ray.Origin, ray.Direction*500, params)
end
local function modelAt(hit: RaycastResult?): Model?
	local item = if hit then hit.Instance :: Instance else nil
	while item and item ~= workspace do
		if item:IsA("Model") and item:FindFirstChildOfClass("Humanoid") then return item end
		item = item.Parent
	end
	return nil
end
function Targeting.PickModel(point: Vector2?): Model? return modelAt(Targeting.Pick(point)) end
local function terrainParams(): RaycastParams
	local ignored = exclusions()
	for actor in actors do table.insert(ignored, actor) end
	local params = RaycastParams.new(); params.FilterDescendantsInstances = ignored; params.RespectCanCollide = true
	return params
end
function Targeting.Geometry(id: string): (BasePart?, number, number)
	local player = Players.LocalPlayer
	local model = player.Character
	if id == "GamakichiOil" or id == "GamakichiChop" or id=="AodaBind" then
		model = nil
		local summons = workspace:FindFirstChild("HeroSummons")
		if summons then for _, child in summons:GetChildren() do
			if child:IsA("Model") and (if id=="AodaBind" then child:GetAttribute("NativeAoda") else child:GetAttribute("NativeGamakichi")) == true and child:GetAttribute("SummonOwner") == player.UserId then model = child; break end
		end end
	end
	local root = if model then model:FindFirstChild("HumanoidRootPart") else nil
	local range = if id == "GamakichiOil" then Spells.Oil.Range elseif id == "GamakichiChop" then Spells.Chopping.Range
		elseif id == "KcmDash" then Kcm.Dash.RangeWarcraft elseif id == "RikudoHY" or id == "RikudoHZ" then Ranged.RangeWarcraft else Definitions.Clones.RangeWarcraft
	local radius = if id == "GamakichiChop" then Spells.Chopping.Radius elseif id == "GamakichiOil" then Spells.Oil.Radius
		elseif id == "RikudoHY" or id == "RikudoHZ" then rangedRadius else 0
	if Sasuke.Spells[id] then range=Sasuke.Spells[id].range;radius=SasukePresentation.radius(id,Sasuke.Spells[id].radius);if id=="SasukeGenjutsu" and model and model:GetAttribute("SasukeMode")==3 then range=500 end end
	return if root and root:IsA("BasePart") then root else nil, Units.toStuds(range), Units.toStuds(radius)
end
function Targeting.Evaluate(id: string, point: Vector2?): (any, string?, Vector3?)
	local hit = Targeting.Pick(point); if not hit then return nil, "Наведите прицел на цель или землю", nil end
	local model = modelAt(hit)
	local area = (Sasuke.Spells[id]~=nil and Sasuke.Spells[id].target=="Point") or id == "GamakichiChop" or id == "RikudoHY" or id == "RikudoHZ"
	local target: any = if area then hit.Position elseif id == "KcmDash" or id=="Amenotejikara" then model or hit.Position else model
	if not target then return nil, "Наведите прицел на врага", hit.Position end
	local origin, range = Targeting.Geometry(id); if not origin then return nil, "Источник способности недоступен", hit.Position end
	local position = hit.Position
	if area then
		-- Aiming at a torso anchors the area to the floor under it, not to its side normal.
		local ground = workspace:Raycast(position+Vector3.new(0,12,0),Vector3.new(0,-36,0),terrainParams())
		if not ground then return nil, "Наведите прицел на землю", position end
		position = ground.Position; target = position
	end
	if typeof(target) == "Instance" then
		local targetModel = target :: Model
		local hp = targetModel:FindFirstChildOfClass("Humanoid")
		local root = targetModel:FindFirstChild("HumanoidRootPart")
		local ownTeam = Players.LocalPlayer:GetAttribute("TeamId")
		if not hp or hp.Health <= 0 or not root or not root:IsA("BasePart") or targetModel:FindFirstChildOfClass("ForceField")
			or targetModel:GetAttribute("CombatDisabled") == true or targetModel:GetAttribute("IsDestroyed") == true
			or (id~="AodaBind" and ownTeam ~= nil and targetModel:GetAttribute("TeamId") == ownTeam) then return nil, "Недоступная цель", hit.Position end
		local kind = targetModel:GetAttribute("EntityKind")
		if id ~= "CloneCommand" and kind ~= "Hero" and kind ~= "Minion" and kind ~= "Summon" then return nil, "Выберите бойца", hit.Position end
		position = root.Position
	end
	if (position-origin.Position).Magnitude > range then return nil, "Слишком далеко", position end
 local character=Players.LocalPlayer.Character
 if id=="Amenotejikara" and typeof(target)=="Vector3" and character and ((character:GetAttribute("AmenotejikaraSelectingUntil") or 0) :: number)<=workspace:GetServerTimeNow() then
  local delta=position-origin.Position;if delta.Magnitude>Units.toStuds(900) then position=origin.Position+delta.Unit*Units.toStuds(900);target=position end
 end
	-- Only these techniques use server terrain visibility checks. Clone orders,
	-- Sleep and ranged ultimates must not acquire a new client-only LOS restriction.
	if id == "KcmDash" or id == "GamakichiOil" or id == "GamakichiChop" then
		local destination = if id == "KcmDash" then position else position+Vector3.new(0,.1,0)
		if workspace:Raycast(origin.Position, destination-origin.Position, terrainParams()) then return nil, "Путь перекрыт", position end
	end
	if id == "KcmDash" then
		if math.abs(position.Y-origin.Position.Y)>12 then return nil, "Слишком большой перепад высоты", position end
		local destination = position
		if typeof(target) == "Instance" then
			local flat = (origin.Position-destination)*Vector3.new(1,0,1)
			if flat.Magnitude>.01 then destination += flat.Unit*3 end
		end
		local params = RaycastParams.new(); params.RespectCanCollide = true
		local ignored: {Instance} = {}; if Players.LocalPlayer.Character then table.insert(ignored,Players.LocalPlayer.Character :: Model) end
		if typeof(target) == "Instance" then table.insert(ignored,target) end
		params.FilterDescendantsInstances = ignored
		local ground = workspace:Raycast(destination+Vector3.new(0,6,0),Vector3.new(0,-18,0),params)
		if not ground or ground.Normal.Y<.5 then return nil, "Выберите устойчивую поверхность", position end
		local humanoid = if origin.Parent then origin.Parent:FindFirstChildOfClass("Humanoid") else nil
		destination = Vector3.new(destination.X,ground.Position.Y+(if humanoid then humanoid.HipHeight else 2)+origin.Size.Y/2,destination.Z)
		local movement = destination-origin.Position
		if movement.Magnitude>.01 and workspace:Blockcast(origin.CFrame,origin.Size*.8,movement,params) then return nil, "Путь перекрыт", destination end
		position = destination
	end
	return target, nil, position
end
function Targeting.Clear()
	if folder then folder:Destroy(); folder = nil end
	table.clear(ring); table.clear(growthRing); line = nil; marker = nil; highlight = nil
	Players.LocalPlayer:SetAttribute("AimTargetValid", nil)
end
local function part(name: string): Part
	local p = Instance.new("Part"); p.Name = name; p.Anchored = true; p.CanCollide = false; p.CanQuery = false; p.CanTouch = false
	p.Material = Enum.Material.Neon; p.CastShadow = false; p.Transparency = .35; p.Parent = folder; return p
end
function Targeting.Preview(id: string): string?
	if not folder then
		local created = Instance.new("Folder"); created.Name = "LocalAbilityAim"; created.Parent = workspace; folder = created
		for _ = 1,32 do table.insert(ring, part("Range")) end
		for _ = 1,32 do table.insert(growthRing, part("ExpansionLimit")) end
		line = part("Direction"); marker = part("Area"); marker.Shape = Enum.PartType.Cylinder
		highlight = Instance.new("Highlight"); highlight.DepthMode = Enum.HighlightDepthMode.Occluded; highlight.FillTransparency = .85; highlight.Parent = folder
	end
	local target, reason, position = Targeting.Evaluate(id)
	local root, range, radius = Targeting.Geometry(id)
	local color = if reason then invalidColor else validColor
 if not reason and Sasuke.Spells[id] then color=if id=="Kirin" or string.find(id,"Chidori") then Color3.fromRGB(126,216,255) elseif id=="SasukeFireball" or id=="PhoenixFlowers" then Color3.fromRGB(255,159,70) else Color3.fromRGB(191,128,255) end
	Players.LocalPlayer:SetAttribute("AimTargetValid", reason == nil)
	if root then
		local floor = workspace:Raycast(root.Position,Vector3.new(0,-20,0),terrainParams())
		local center = if floor then floor.Position+Vector3.new(0,.08,0) else root.Position-Vector3.new(0,2.6,0)
		for i,p in ring do
			local a,b = (i-1)*math.pi/16, i*math.pi/16
			local first = center+Vector3.new(math.cos(a),0,math.sin(a))*range
			local last = center+Vector3.new(math.cos(b),0,math.sin(b))*range
			p.Size = Vector3.new(.08,.08,(last-first).Magnitude); p.CFrame = CFrame.lookAt((first+last)/2,last); p.Color = color
		end
		if line then
			line.Transparency = if position then .4 else 1
			if position and (position-root.Position).Magnitude > .01 then
				line.Size = Vector3.new(.08,.08,(position-root.Position).Magnitude); line.CFrame = CFrame.lookAt((root.Position+position)/2, position); line.Color = color
			end
		end
	end
	if marker then
		marker.Transparency = if position then .8 else 1
		if position then marker.Size = Vector3.new(.06,math.max(1,radius*2),math.max(1,radius*2)); marker.CFrame = CFrame.new(position+Vector3.new(0,.08,0))*CFrame.Angles(0,0,math.pi/2); marker.Color = color end
	end
	local boundaryParams=if Sasuke.Spells[id] and radius>0 then terrainParams() else nil
	for i,p in growthRing do
		local boundary=Sasuke.Spells[id]~=nil and radius>0 and id~="ChidoriEiso" and id~="Enton"
		p.Transparency = if (id == "RikudoHY" or boundary) and position then .25 else 1
		if (id == "RikudoHY" or boundary) and position then
			local a,b = (i-1)*math.pi/16, i*math.pi/16
			local size=if boundary then radius else Units.toStuds(hyMaximumRadius)
			local first = position+Vector3.new(math.cos(a),0,math.sin(a))*size
			local last = position+Vector3.new(math.cos(b),0,math.sin(b))*size
			if boundary then local aHit=workspace:Raycast(first+Vector3.new(0,5,0),Vector3.new(0,-25,0),boundaryParams);local bHit=workspace:Raycast(last+Vector3.new(0,5,0),Vector3.new(0,-25,0),boundaryParams);if aHit then first=aHit.Position+Vector3.new(0,.1,0) end;if bHit then last=bHit.Position+Vector3.new(0,.1,0) end end
			p.Size=Vector3.new(.1,.1,(last-first).Magnitude); p.CFrame=CFrame.lookAt((first+last)/2,last); p.Color=color
		end
	end
 if (id=="SasukeFireball" or id=="PhoenixFlowers" or id=="EntonMagatama") and root and position and marker then
  marker.Transparency=1
  local delta=(position-root.Position)*Vector3.new(1,0,1)
  if delta.Magnitude>.01 then
   local dir=delta.Unit;local side=dir:Cross(Vector3.yAxis)
   for i,p in growthRing do
    local function edge(index:number):Vector3
     local half=index<=16;local t=if half then index/16 else (32-index)/16
     local along=if id=="SasukeFireball" then 1125*t else 1000*t
     local width=0
     if id=="SasukeFireball" then
      for _,circle in {{100,100},{300,300},{675,450}} do width=math.max(width,math.sqrt(math.max(0,circle[2]^2-(along-circle[1])^2))) end
     else local angle=math.rad(if id=="PhoenixFlowers" then 25 else 50);width=math.sin(angle)*along;along*=math.cos(angle) end
     local pos=root.Position+dir*Units.toStuds(along)+side*Units.toStuds(width*(if half then 1 else -1))
     local hit=workspace:Raycast(pos+Vector3.yAxis*5,-Vector3.yAxis*25,terrainParams())
     return if hit then hit.Position+Vector3.yAxis*.1 else pos-Vector3.yAxis*2.5
    end
    local a,b=edge(i-1),edge(i)
    p.Transparency=.4;p.Color=color;p.Size=Vector3.new(.1,.1,math.max(.01,(b-a).Magnitude));p.CFrame=CFrame.lookAt((a+b)/2,b)
   end
  end
 elseif id=="Enton" and root and position and marker then
  local delta=position-root.Position;local distance=math.min(range,delta.Magnitude)
  if distance>.01 then
   local finish=root.Position+delta.Unit*distance;local hit=workspace:Raycast(root.Position,finish-root.Position,terrainParams());if hit then finish=hit.Position end
   marker.Shape=Enum.PartType.Block;marker.Size=Vector3.new(radius*2,.06,math.max(.1,(finish-root.Position).Magnitude));marker.CFrame=CFrame.lookAt((root.Position+finish)/2,finish);marker.Transparency=.78
  end
 elseif marker then marker.Shape=Enum.PartType.Cylinder end
	if highlight then highlight.Adornee = if typeof(target) == "Instance" then target else nil; highlight.FillColor = color; highlight.OutlineColor = color end
	return reason
end
return Targeting
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="275">
            <Properties>
              <string name="Name">AbilityVFXController</string>
              <string name="Source"><![CDATA[--!strict
-- Original Roblox presentation following the map's timing/attachment sequence.
local Players=game:GetService("Players")
local RunService=game:GetService("RunService")
local Shared=game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config=require(Shared.Config.AbilityConfig)
local Definition=require(Shared.Abilities.NarutoDefinitions).Rasengan
local Rounds=require(script.Parent.RoundController)
local Ranged=require(script.Parent.NarutoRangedVFXController)
local RasenganArt=require(script.Parent.RasenganVisual)
local ChakraAura=require(script.Parent.ChakraAuraVisual)
local KuramaArt=require(script.Parent.KuramaVisual)
local FlightArt=require(script.Parent.RasenshurikenFlightVisual)
local AreaRules=require(Shared.Abilities.RasenshurikenThrowRules)
local Units=require(Shared.Abilities.WorldUnits)
type Effect={areaId:number?,parts:{BasePart},at:number,untilAt:number,origin:Vector3,model:Model?,kind:string,destination:Vector3?,radius:number?,caster:Model?,orb:RasenganArt.Orb?,burst:RasenganArt.Burst?}
type Helper={model:Model,cast:number}
local effects:{Effect}={}
local orbs:{[Model]:Effect}={}
local helpers:{[Model]:Helper}={}
local oilHighlights:{[Model]:Highlight}={}
local sageHighlights:{[Model]:Highlight}={}
local folder:Folder?=nil
local VFX={}
local started=false
local function part(name:string,color:Color3,size:Vector3): Part
	local p=Instance.new("Part"); p.Name=name; p.Anchored=true; p.CanCollide=false; p.CanTouch=false; p.CanQuery=false
	p.Color=color; p.Size=size; p.Material=Enum.Material.Neon; p.CastShadow=false; p.Parent=folder; return p
end
local function remove(index:number)
	local effect=effects[index]; if effect.model then orbs[effect.model]=nil end
	if effect.orb then RasenganArt.Destroy(effect.orb) end
	if effect.burst then effect.burst.group:Destroy() end
	for _,p in effect.parts do p:Destroy() end; table.remove(effects,index)
end
local function create(position:Vector3,kind:string,model:Model?,variant:string?): Effect?
	local camera=workspace.CurrentCamera
	if #effects>=Config.Visual.MaxEffects or (camera and (camera.CFrame.Position-position).Magnitude>Config.Visual.ViewDistance) then return nil end
	local now=workspace:GetServerTimeNow()
	local effect:Effect={parts={},at=now,untilAt=now+(if kind=="Area" then 3.5 elseif kind=="Orb" then 20 elseif kind=="Finish" then .7 else .5),origin=position,model=model,kind=kind}
	if kind=="Orb" and model and folder then
  local detailed=model:GetAttribute("NativeNarutoClone")~=true and (not camera or (camera.CFrame.Position-position).Magnitude<90)
  effect.orb=RasenganArt.Create(folder,model,detailed); table.insert(effects,effect); return effect
 end
 if (kind=="Contact" or kind=="Impact" or kind=="Finish") and folder then
  local burst=RasenganArt.Burst(folder,position,variant or "Rasengan",kind,now); effect.burst=burst
  effect.untilAt=now+burst.duration; table.insert(effects,effect); return effect
 end
 local count=if kind=="Oil" then 1 elseif kind=="Area" then 97 elseif kind=="Chop" then 24 elseif kind=="Smoke" then 14 elseif kind=="Channel" or kind=="OilImpact" then 4 else 8
	for i=1,count do
		local p=part(if kind=="Orb" then "RasenganSpiral" else "Rasengan"..kind,Color3.fromRGB(110,211,255),Vector3.one*.2)
		if kind=="Oil" or kind=="OilImpact" then p.Shape=Enum.PartType.Ball; p.Color=Color3.fromRGB(82,49,24); p.Material=Enum.Material.SmoothPlastic; p.Size=Vector3.one*.8
		elseif kind=="Area" then p.Color=Color3.fromRGB(205,248,255); if i==1 then p.Shape=Enum.PartType.Ball;p.Material=Enum.Material.ForceField;p.Color=Color3.fromRGB(30,125,255) end
		elseif kind=="Channel" or kind=="Chop" then if kind=="Channel" then p.Shape=Enum.PartType.Cylinder end; p.Color=Color3.fromRGB(218,241,255)
		elseif kind=="Smoke" then p.Shape=Enum.PartType.Ball; p.Material=Enum.Material.SmoothPlastic; p.Color=Color3.fromRGB(193,207,214)
		elseif kind=="Finish" and i==1 then p.Shape=Enum.PartType.Cylinder
		else p.Shape=Enum.PartType.Ball end
		table.insert(effect.parts,p)
	end
	table.insert(effects,effect); return effect
end
local function removeHelper(source:Model,poof:boolean)
	local helper=helpers[source]; if not helper then return end
	if poof and helper.model.Parent then create(helper.model:GetPivot().Position,"Smoke",nil) end
	helper.model:Destroy(); helpers[source]=nil
end
local function helper(source:Model,cast:number)
	if helpers[source] then return end
	local root=source:FindFirstChild("HumanoidRootPart"); if not root or not root:IsA("BasePart") then return end
	local old=source.Archivable; source.Archivable=true; local copy=source:Clone(); source.Archivable=old
 local copiedHumanoid=copy:FindFirstChildOfClass("Humanoid"); if copiedHumanoid then copiedHumanoid.EvaluateStateMachine=false end
	for _,item in copy:GetDescendants() do
		if item:IsA("LuaSourceContainer") or item:IsA("Tool") or item:IsA("ForceField") then item:Destroy()
		elseif item:IsA("BasePart") then item.CanCollide=false; item.CanTouch=false; item.CanQuery=false; item.Massless=true end
	end
	copy.Name="RasenganPreparationHelper"; copy:SetAttribute("RasenganHelper",true); copy:SetAttribute("RasenganPhase","")
	copy:SetAttribute("RasenganVisible",false); copy:SetAttribute("RasenganHeld",false); copy:SetAttribute("EntityKind","Cosmetic")
	local copyRoot=copy:FindFirstChild("HumanoidRootPart") :: BasePart; copyRoot.Anchored=true
	local humanoid=copy:FindFirstChildOfClass("Humanoid"); if humanoid then humanoid.DisplayDistanceType=Enum.HumanoidDisplayDistanceType.None end
	-- Cosmetic choreography: the helper works beside the palm, not seven studs away.
	local position=root.Position+root.CFrame.RightVector*2.3+root.CFrame.LookVector*.6
	copy:PivotTo(CFrame.lookAt(position,root.Position)); copy.Parent=folder
	helpers[source]={model=copy,cast=cast}; create(position,"Smoke",nil)
end
local function visible(model:Model,now:number): boolean
	if model:GetAttribute("NativeNarutoClone")==true then return model:GetAttribute("RasenganVisible")==true end
	local at=model:GetAttribute("RasenganStartedAt")
	return model:GetAttribute("RasenganHeld")==true and typeof(at)=="number" and now>=at+.08
end
function VFX.Event(message:any)
 if folder and message.kind=="KuramaShockwave" then KuramaArt.Event(message,folder);return end
 if folder then FlightArt.Event(message,folder) end
 if message.kind=="RasenshurikenAreaEnd" then
  for i=#effects,1,-1 do if effects[i].areaId==message.id then remove(i) end end;return
 end
 if message.kind=="RasenshurikenDetonate" then
  local e=create(message.position,"Area",nil);if e then e.radius=message.radius;e.areaId=message.id;e.at=message.startAt;e.untilAt=e.at+AreaRules.Duration end;return
 end
 local variant=if typeof(message.variant)=="string" then message.variant else "Rasengan"
 if variant~="Odama" and variant~="Rasenshuriken" then variant="Rasengan" end
 if typeof(message.kind)=="string" and string.sub(message.kind,1,6)=="Rikudo" then Ranged.Event(message);return end
	if typeof(message.position)~="Vector3" then return end
	if message.kind=="GamakichiOil" or message.kind=="GamakichiOilImpact" or message.kind=="GamakichiChannel" or message.kind=="GamakichiChopImpact" then
		local kind=if message.kind=="GamakichiOil" then "Oil" elseif message.kind=="GamakichiOilImpact" then "OilImpact" elseif message.kind=="GamakichiChannel" then "Channel" else "Chop"
		local effect=create(message.position,kind,nil)
		if effect then
			effect.destination=if typeof(message.destination)=="Vector3" then message.destination else nil
			effect.radius=if typeof(message.radius)=="number" then message.radius else 1
			local source=message.source
			if typeof(source)=="Instance" then local instance=source :: Instance; if instance:IsA("Model") then effect.caster=instance end end
			if kind=="Oil" and typeof(message.duration)=="number" then effect.untilAt=effect.at+math.max(.03,message.duration) end
		end
	elseif message.kind=="Smoke" then create(message.position,"Smoke",nil)
	elseif message.kind=="RasenshurikenArea" then
  local e=create(message.position,"Area",nil);if e then e.radius=message.radius;e.caster=message.source;e.areaId=message.id;e.at=message.startAt or e.at;e.untilAt=e.at+AreaRules.Duration end
 elseif message.kind=="RasenganContact" then create(message.position,"Contact",nil,variant)
	elseif message.kind=="RasenganImpact" then create(message.position,"Impact",nil,variant)
	elseif message.kind=="RasenganFinish" then create(message.position,"Finish",nil,variant)
	elseif message.kind=="RasenganTrail" then create(message.position,"Trail",nil) end
end
function VFX.GetDiagnostics(model:Model): (boolean,boolean)
	return helpers[model]~=nil,orbs[model]~=nil
end
function VFX.Start()
 Ranged.Start()
	if started then return end; started=true
	local created=Instance.new("Folder"); created.Name="LocalHeroVFX"; created.Parent=workspace; folder=created
	Rounds.Watch(function()
        KuramaArt.Clear()
        FlightArt.Clear()
		for i=#effects,1,-1 do remove(i) end
		for model in helpers do removeHelper(model,false) end
	end)
	RunService.PreRender:Connect(function(dt)
		local now=workspace:GetServerTimeNow(); local match=game:GetService("ReplicatedStorage"):FindFirstChild("SurvivalState")
		local active=match~=nil and match:GetAttribute("Phase")=="InProgress"
        ChakraAura.Update(created,now)
        KuramaArt.Update(now)
        FlightArt.Update(now,dt)
		local sageTagged:{[Model]:boolean}={}
        if active then for _,model in game:GetService("CollectionService"):GetTagged("NarutoSage") do
            if model:IsA("Model") and model.Parent then
                local hp=model:FindFirstChildOfClass("Humanoid")
                local untilAt=model:GetAttribute("SageAuraUntil")
                if hp and hp.Health>0 and typeof(untilAt)=="number" and now<untilAt then
                    sageTagged[model]=true
                    if not sageHighlights[model] then
                        local h=Instance.new("Highlight"); h.Name="SageAura"; h.Adornee=model; h.DepthMode=Enum.HighlightDepthMode.Occluded
                        h.FillColor=Color3.fromRGB(231,140,42); h.OutlineColor=Color3.fromRGB(250,195,75); h.FillTransparency=.88; h.OutlineTransparency=.45; h.Parent=folder; sageHighlights[model]=h
                    end
                end
            end
        end end
        for model,h in sageHighlights do if not sageTagged[model] then h:Destroy(); sageHighlights[model]=nil end end
        local tagged:{[Model]:boolean}={}
		if active then for _,model in game:GetService("CollectionService"):GetTagged("GamakichiOilStatus") do
			if model:IsA("Model") and model.Parent and ((model:GetAttribute("OilUntil") or 0) :: number)>now then
				tagged[model]=true
				if not oilHighlights[model] then
					local h=Instance.new("Highlight"); h.Name="OilStatus"; h.FillColor=Color3.fromRGB(92,55,21); h.FillTransparency=.45; h.OutlineTransparency=.6; h.DepthMode=Enum.HighlightDepthMode.Occluded; h.Adornee=model; h.Parent=folder; oilHighlights[model]=h
				end
			end
		end end
		for model,h in oilHighlights do if not tagged[model] then h:Destroy(); oilHighlights[model]=nil end end
		local function source(model:Model)
			local humanoid=model:FindFirstChildOfClass("Humanoid"); if not active or not humanoid or humanoid.Health<=0 then removeHelper(model,false); return end
			local at=model:GetAttribute("RasenganStartedAt"); local ready=model:GetAttribute("RasenganReadyAt"); local cast=model:GetAttribute("NarutoCastId")
			if model:GetAttribute("NativeNarutoClone")~=true and typeof(at)=="number" and typeof(ready)=="number" and typeof(cast)=="number" and model:GetAttribute("RasenganPhase")=="Preparing"
				and now>=at+Definition.VariantWindow and now<ready then
				local old=helpers[model]; if old and old.cast~=cast then removeHelper(model,false) end
				helper(model,cast)
			else removeHelper(model,true) end
			if visible(model,now) and not orbs[model] then
				local effect=create(model:GetPivot().Position,"Orb",model); if effect then orbs[model]=effect end
			end
		end
		for _,player in Players:GetPlayers() do if player.Character then source(player.Character) end end
		local summons=workspace:FindFirstChild("HeroSummons")
		if summons then for _,model in summons:GetChildren() do if model:IsA("Model") then source(model) end end end
		for model in helpers do if not model:IsDescendantOf(workspace) then removeHelper(model,false) end end
		for index=#effects,1,-1 do
			local effect=effects[index]; local model=effect.model
			local humanoid=if model then model:FindFirstChildOfClass("Humanoid") else nil
			if not active or now>=effect.untilAt or (effect.caster and not effect.caster.Parent) or (model and (not model.Parent or not humanoid or humanoid.Health<=0 or not visible(model,now))) then remove(index); continue end
			local elapsed=now-effect.at
			if model then
				local hand=model:FindFirstChild("RightHand"); if not hand or not hand:IsA("BasePart") then remove(index); continue end
                if effect.orb then RasenganArt.Update(effect.orb,model,hand,now,dt) end
            elseif effect.burst then
                RasenganArt.UpdateBurst(effect.burst,effect.origin,now)
			else
				local progress=math.clamp(elapsed/(effect.untilAt-effect.at),0,1)
				for i,p in effect.parts do
					local angle=i*math.pi/4; local finish=effect.kind=="Finish"
					if effect.kind=="Oil" and effect.destination then
						p.Position=effect.origin:Lerp(effect.destination,progress)+Vector3.new(0,(effect.destination-effect.origin).Magnitude*.05*4*progress*(1-progress),0)
					elseif effect.kind=="Area" then
                        local radius=Units.toStuds(AreaRules.radius(elapsed))
                        if radius<=0 then p.Transparency=1;continue end
                        if effect.caster then effect.origin=effect.caster:GetPivot().Position end
                        local envelope=math.min(1,(1-progress)*5)
                        if i==1 then
                            p.Size=Vector3.one*radius*2; p.Position=effect.origin; p.Transparency=1-envelope*.72
                        elseif i<=73 then
                            local band=math.floor((i-2)/24);local segment=(i-2)%24
                            local rotation=CFrame.new(effect.origin)*CFrame.Angles(band*1.05,elapsed*.7,band*.85)
                            local spin=segment*math.pi/12+elapsed*(if band%2==0 then 11 else -9)
                            local bandRadius=math.max(0,radius-.15)
                            local a=rotation:PointToWorldSpace(Vector3.new(math.cos(spin)*bandRadius,math.sin(spin)*bandRadius,0))
                            local b=rotation:PointToWorldSpace(Vector3.new(math.cos(spin+.28)*bandRadius,math.sin(spin+.28)*bandRadius,0))
                            p.Size=Vector3.new(.06,.12,(b-a).Magnitude);p.CFrame=CFrame.lookAt((a+b)/2,b);p.Transparency=1-envelope*(.55+.3*math.sin(segment*.4)^2)
                        else
                            local spin=i*2.399+elapsed*17;local r=radius*(.2+((i*17)%19)/25)
                            local a=effect.origin+Vector3.new(math.cos(spin)*r,math.sin(i+elapsed*9)*radius*.7,math.sin(spin)*r)
                            local b=a+Vector3.new(math.cos(spin+1)*radius*.35,.35,math.sin(spin+1)*radius*.35)
                            local limit=math.max(.01,radius-.15)
                            local da,db=a-effect.origin,b-effect.origin
                            if da.Magnitude>limit then a=effect.origin+da.Unit*limit end
                            if db.Magnitude>limit then b=effect.origin+db.Unit*limit end
                            p.Size=Vector3.new(.025,.04,(b-a).Magnitude);p.CFrame=CFrame.lookAt((a+b)/2,b);p.Transparency=1-envelope*.8
                        end
                    elseif effect.kind=="Chop" then
                        local radius=(effect.radius or 4)*(.45+progress*.55)
                        local rotation=CFrame.new(effect.origin)*CFrame.Angles(.25,elapsed*2,math.rad(55))
                        local angle=(i-1)/23*math.pi*1.4
                        local a=rotation:PointToWorldSpace(Vector3.new(math.cos(angle)*radius,math.sin(angle)*radius,0))
                        local b=rotation:PointToWorldSpace(Vector3.new(math.cos(angle+.2)*radius,math.sin(angle+.2)*radius,0))
                        p.Size=Vector3.new(.07,.25,(b-a).Magnitude);p.CFrame=CFrame.lookAt((a+b)/2,b);p.Transparency=progress
                    elseif effect.kind=="Smoke" then
                        local spread=progress*3.3;local angle=i*2.399
                        p.Position=effect.origin+Vector3.new(math.cos(angle)*spread,math.sin(i)*.7+progress*2,math.sin(angle)*spread)
                        p.Size=Vector3.one*(.7+math.sin(i)^2+progress*1.7);p.Transparency=.15+progress*.85
                    elseif effect.kind=="Channel" or effect.kind=="OilImpact" then
						local radius=(effect.radius or 1)*(if effect.kind=="Area" then 1+math.min(elapsed/1.6,1)*2/3 elseif effect.kind=="Channel" then 1 else progress)
                        if effect.kind=="Area" and effect.caster then effect.origin=effect.caster:GetPivot().Position end
						if effect.kind=="OilImpact" then p.Position=effect.origin+Vector3.new(math.cos(angle)*radius,0,math.sin(angle)*radius); p.Transparency=progress
						else p.Size=Vector3.new(.1,radius*2,radius*2); p.CFrame=CFrame.new(effect.origin+Vector3.new(0,.12+i*.02,0))*CFrame.Angles(0,0,math.pi/2); p.Transparency=.7+progress*.3 end
					elseif finish and i==1 then
						p.Size=Vector3.new(.12,2+progress*8,2+progress*8); p.CFrame=CFrame.new(effect.origin-Vector3.new(0,2.8,0))*CFrame.Angles(0,0,math.pi/2); p.Transparency=.35+progress*.65
					else
						p.Position=effect.origin+Vector3.new(math.cos(angle)*progress*(if finish then 4 else 2),progress*(if finish then -2 else 1.5),math.sin(angle)*progress*(if finish then 4 else 2))
						p.Size=Vector3.one*(.3+progress*(if finish then 1.4 else 1)); p.Transparency=.2+progress*.8
					end
				end
			end
		end
	end)
end
return VFX
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="276">
            <Properties>
              <string name="Name">AnimationController</string>
              <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config.CombatConfig)
local AnimationIds = require(Shared.Config.AnimationIds)
local Motion = require(script.Parent.HeroMotionController)

type Loaded = { track: AnimationTrack, animation: Animation, marker: RBXScriptConnection }
local AnimationController = {}
local animator: Animator? = nil
local tracks: { [string]: Loaded } = {}
local warned: { [string]: boolean } = {}
local current: AnimationTrack? = nil
local currentRequest = 0
local currentStep = 0
local currentSet = ""
local endsAt = 0
local generation = 0
local diedConnection: RBXScriptConnection? = nil
local markerCallback: (() -> ())? = nil
local logicalPlayCount = 0
local started = false

function AnimationController.Stop(requestId: number?)
	if requestId and requestId ~= currentRequest then return end
	Motion.StopPrediction(requestId)
	if current then current:Stop(Config.AnimationFadeTime) end
	current = nil
	currentRequest = 0
	endsAt = 0
end

local function clearCharacter()
	generation += 1
	AnimationController.Stop()
	if diedConnection then diedConnection:Disconnect(); diedConnection = nil end
	for _, loaded in tracks do
		loaded.marker:Disconnect()
		loaded.track:Destroy()
		loaded.animation:Destroy()
	end
	table.clear(tracks)
	animator = nil
end

local function warnOnce(key: string, message: string)
	if warned[key] then return end
	warned[key] = true
	warn("[CombatAnimations] " .. message)
end

local function loadTrack(profile: Config.AttackProfile, step: number): AnimationTrack?
	local animationKey = profile.AnimationKey
	local key = profile.AnimationSet .. "." .. animationKey
	local cached = tracks[key]
	if cached then return cached.track end
	local set = AnimationIds[profile.AnimationSet]
	local assetId = if set then set[animationKey] else nil
	if not assetId or not string.match(assetId, "^rbxassetid://[1-9]%d*$") then
		return nil
	end
	local owner = animator
	if not owner then return nil end
	local animation = Instance.new("Animation")
	animation.Name = animationKey
	animation.AnimationId = assetId
	local success, result = pcall(function() return owner:LoadAnimation(animation) end)
	if not success then
		animation:Destroy()
		warnOnce(key, "Cannot load " .. key .. ": " .. tostring(result))
		return nil
	end
	local track = result :: AnimationTrack
	track.Priority = Enum.AnimationPriority.Action
	track.Looped = false
	local marker = track:GetMarkerReachedSignal("Hit"):Connect(function()
		-- This marker may drive a local cue, never a request or damage decision.
		if current == track and markerCallback then markerCallback() end
	end)
	tracks[key] = { track = track, animation = animation, marker = marker }
	return track
end

local function bindCharacter(model: Model)
	clearCharacter()
	local token = generation
	task.spawn(function()
		local humanoid = model:WaitForChild("Humanoid", Config.CharacterReadyTimeout)
		if token ~= generation or not humanoid or not humanoid:IsA("Humanoid") then return end
		if humanoid.RigType ~= Enum.HumanoidRigType.R15 then
			warnOnce("Rig", "R15 is required for the configured animations. Set the experience avatar type to R15.")
			return
		end
		local serverAnimator = humanoid:WaitForChild("Animator", Config.CharacterReadyTimeout)
		if token ~= generation then return end
		if not serverAnimator or not serverAnimator:IsA("Animator") then
			warnOnce("Animator", "Server-created Animator missing; local Animator will not be created.")
			return
		end
		animator = serverAnimator
		diedConnection = humanoid.Died:Connect(function() AnimationController.Stop() end)
		local profile = Config.Profiles[Config.DefaultProfile]
		loadTrack(profile, 1)
	end)
end

function AnimationController.Play(requestId: number, step: number, profile: Config.AttackProfile, startedAt: number, attackDuration: number?): boolean
	local duration = attackDuration or profile.AttackDuration
	local now = workspace:GetServerTimeNow()
	local elapsed = math.max(0, now - startedAt)
	if elapsed >= duration then return false end
	if currentRequest == requestId and currentStep == step then
		-- Confirm the prediction without replaying the track from frame zero.
		if currentSet ~= profile.AnimationSet then
			if current then current:Stop(Config.AnimationFadeTime) end
			currentSet = profile.AnimationSet
			current = loadTrack(profile, step)
			if current then
				current:Play(Config.AnimationFadeTime)
				if current.Length > 0 then current.TimePosition = math.min(elapsed, current.Length) end
			end
		end
		if current and current.Length > 0 and math.abs(current.TimePosition - elapsed) > Config.AnimationCorrectionThreshold then
			current.TimePosition = math.min(elapsed, current.Length)
		end
		endsAt = startedAt + duration
		Motion.Predict(requestId, profile.AnimationKey, startedAt, duration)
		return false
	end
	AnimationController.Stop()
	currentRequest, currentStep, currentSet = requestId, step, profile.AnimationSet
	endsAt = startedAt + duration
	logicalPlayCount += 1
	Motion.Predict(requestId, profile.AnimationKey, startedAt, duration)
	local track = loadTrack(profile, step)
	if track then
		current = track
		track:Play(Config.AnimationFadeTime)
		if track.Length > 0 then track.TimePosition = math.min(elapsed, track.Length) end
	end
	return true
end

function AnimationController.GetLogicalPlayCount(): number
	return logicalPlayCount
end

function AnimationController.Start(onMarker: () -> ())
	if started then return end
	started = true
	Motion.Start()
	markerCallback = onMarker
	Players.LocalPlayer.CharacterAdded:Connect(bindCharacter)
	Players.LocalPlayer.CharacterRemoving:Connect(clearCharacter)
	if Players.LocalPlayer.Character then bindCharacter(Players.LocalPlayer.Character) end
	RunService.Heartbeat:Connect(function()
		if currentRequest ~= 0 and workspace:GetServerTimeNow() >= endsAt then AnimationController.Stop() end
	end)
end

return AnimationController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="277">
            <Properties>
              <string name="Name">AodaVisualController</string>
              <string name="Source"><![CDATA[--!strict
local Run=game:GetService("RunService")
local Shared=game.ReplicatedStorage.Shared
local Clips:{[string]:{duration:number,frames:{{[string]:CFrame}}}}=require(Shared.AodaClips) :: any
local Reaction=require(Shared.Combat.HitReaction)
local M={};local started=false
local cached:{[Model]:{skin:MeshPart,bones:{Bone},phase:number}}=setmetatable({},{__mode="k"}) :: any
function M.Start()
 if started then return end;started=true
 Run.RenderStepped:Connect(function(dt)
  local folder=workspace:FindFirstChild("HeroSummons");if not folder then return end
  local now=workspace:GetServerTimeNow()
  for _,model in folder:GetChildren() do
   if not model:IsA("Model") or model:GetAttribute("NativeAoda")~=true then continue end
   local root=model:FindFirstChild("HumanoidRootPart")
   if not root or not root:IsA("BasePart") then continue end
   local rec=cached[model]
   if not rec then
    local skin=model:FindFirstChild("AodaSkin")
    if not skin or not skin:IsA("MeshPart") then continue end
    local bones:{Bone}={}
    for _,b in skin:GetDescendants() do if b:IsA("Bone") then table.insert(bones,b) end end
    rec={skin=skin,bones=bones,phase=0};cached[model]=rec
   end
   local controlled=math.max((model:GetAttribute("CombatStunUntil") or 0) :: number,(model:GetAttribute("SleepUntil") or 0) :: number)>now
   local moving=model:GetAttribute("SummonMoving")==true and not controlled
   local strike=now-((model:GetAttribute("AodaStrikeAt") or -100) :: number)
   local coiling=((model:GetAttribute("AodaConstrictUntil") or 0) :: number)>now and not controlled
   local clip=if moving then Clips.Slither else Clips.Idle
   rec.phase=(rec.phase+dt/(if moving then Clips.Slither.duration else Clips.Idle.duration))%1
   local age=rec.phase*clip.duration
   if coiling then clip=Clips.Coil;age=now%clip.duration
   elseif not controlled and strike>=0 and strike<Clips.Bite.duration then clip=Clips.Bite;age=strike end
   local frame=math.clamp(age/clip.duration*(#clip.frames-1),0,#clip.frames-1)
   local a=math.floor(frame)+1;local b=math.min(a+1,#clip.frames)
   local scale=(model:GetAttribute("AodaScale") or 1) :: number
   local alpha=1-math.exp(-(if coiling then 14 else 30)*dt)
   for _,bone in rec.bones do
    local one=clip.frames[a][bone.Name];local two=clip.frames[b][bone.Name]
    if one and two then
     local goal=one:Lerp(two,frame%1)
     -- Blender spine Y is the snake's length axis. Match the lunge to its victim.
     if clip==Clips.Bite and (bone.Name=="Head" or string.sub(bone.Name,1,5)=="Spine") then
      local distance=(model:GetAttribute("AodaStrikeDistance") or (11.4*scale)) :: number
      local reach=math.clamp((distance/scale-3.4)/8,.12,2.1)
      goal=CFrame.new(goal.Position*Vector3.new(1,reach,1))*goal.Rotation
     end
     goal=CFrame.new(goal.Position*scale)*goal.Rotation
     bone.Transform=bone.Transform:Lerp(goal,alpha)
    end
   end
   rec.skin.CFrame=root.CFrame*Reaction.Offset(model,"Root",now)*(rec.skin:GetAttribute("AodaOffset") :: CFrame)
  end
 end)
end
return M
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="278">
            <Properties>
              <string name="Name">CameraController</string>
              <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local Input = game:GetService("UserInputService")
local Gui = game:GetService("GuiService")
local RunService = game:GetService("RunService")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config.CameraConfig)
local Rules = require(Shared.Combat.CombatCameraRules)
local Kurama = require(Shared.Config.KuramaAvatarConfig)

local Controller = {}
local player = Players.LocalPlayer
local started, focused, active = false, true, false
local enabled = true
local yaw, pitch = 0, math.rad(Config.InitialPitch)
local followed: Model? = nil
local previousHumanoid: Humanoid? = nil
local previousAutoRotate = true
local previousCamera: Camera? = nil
local previousType = Enum.CameraType.Custom
local pivot: Vector3? = nil
local distance = Config.Distance
local reticle: ScreenGui? = nil
local hiddenParts: { [BasePart]: number } = {}
local fadedSummons: { [Model]: { [BasePart]: number } } = {}
local nextOcclusion = 0

local function showSummon(model: Model)
	local parts = fadedSummons[model]
	if not parts then return end
	for part, transparency in parts do
		if part.Parent then part.LocalTransparencyModifier = transparency end
	end
	fadedSummons[model] = nil
end

local function updateSummonOcclusion(camera: Camera)
	local now = os.clock()
	if now < nextOcclusion then return end
	nextOcclusion = now + .05
	local blocking: { [Model]: boolean } = {}
	local summons = workspace:FindFirstChild("HeroSummons")
	local team = player:GetAttribute("TeamId")
	if summons then
		for _, model in summons:GetChildren() do
			if not model:IsA("Model") or not (model:GetAttribute("SummonOwner") == player.UserId
				or (team ~= nil and model:GetAttribute("TeamId") == team)) then continue end
			local root = model:FindFirstChild("HumanoidRootPart")
			local humanoid = model:FindFirstChildOfClass("Humanoid")
			if not root or not root:IsA("BasePart") or not humanoid or humanoid.Health <= 0 then continue end
			local relative = camera.CFrame:PointToObjectSpace(root.Position)
			local depth = -relative.Z
			-- Bounds include the toad's head and a narrow corridor around the reticle.
			-- Only nearby friendly bodies fade; enemies retain normal combat readability.
			local radius = math.max(root.Size.X, root.Size.Y, root.Size.Z) * .65 + 1
			if depth > -radius and depth < 40 and Vector2.new(relative.X, relative.Y).Magnitude < radius + math.max(0,depth)*.035 then
				blocking[model] = true
				local saved = fadedSummons[model]
				if not saved then saved = {}; fadedSummons[model] = saved end
				for _, part in model:GetDescendants() do
					if part:IsA("BasePart") then
						if saved[part] == nil then saved[part] = part.LocalTransparencyModifier end
						part.LocalTransparencyModifier = math.max(saved[part], .75)
					end
				end
			end
		end
	end
	for model in fadedSummons do if not blocking[model] then showSummon(model) end end
end

local function showCharacter()
	for part, transparency in hiddenParts do
		if part.Parent then part.LocalTransparencyModifier = transparency end
	end
	table.clear(hiddenParts)
end

function Controller.IsCaptured(): boolean
	return started and enabled and active and Input.KeyboardEnabled and Rules.captured(focused, Gui.MenuIsOpen, Input:GetFocusedTextBox() ~= nil,
		player:GetAttribute("ShopOpen") == true or player:GetAttribute("HeroSelectionOpen")==true, player:GetAttribute("StatsOpen") == true,
		player:GetAttribute("CombatCursorFree") == true or player:GetAttribute("DeveloperConsoleOpen") == true)
end

function Controller.GetAimRay(): Ray?
	local camera = workspace.CurrentCamera
	if not camera then return nil end
	return camera:ViewportPointToRay(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
end

local function restore()
	showCharacter()
	for model in fadedSummons do showSummon(model) end
	nextOcclusion = 0
	if previousHumanoid and previousHumanoid.Parent then previousHumanoid.AutoRotate = previousAutoRotate end
	previousHumanoid = nil
	if previousCamera and previousCamera.Parent then previousCamera.CameraType = previousType end
	previousCamera = nil
	followed, pivot, active = nil, nil, false
	Input.MouseBehavior = Enum.MouseBehavior.Default
	Input.MouseIconEnabled = true
	if reticle then reticle.Enabled = false end
end

function Controller.SetEnabled(value: boolean)
	enabled = value
	if not value then restore() end
end

local function setting(name: string, fallback: number, minimum: number, maximum: number): number
	return Rules.setting(player:GetAttribute("CombatCamera" .. name), fallback, minimum, maximum)
end

local function exclusions(character: Model): { Instance }
	local excluded: { Instance } = { character }
	-- Summons, characters and VFX must never pump the camera in and out.
	for _, name in { "HeroSummons", "LocalHeroVFX", "Effects", "JungleCamps", "NPCs" } do
		local object = workspace:FindFirstChild(name)
		if object then table.insert(excluded, object) end
	end
	for _, other in Players:GetPlayers() do
		if other.Character and other.Character ~= character then table.insert(excluded, other.Character) end
	end
	return excluded
end

function Controller.Start()
	if started or not Input.KeyboardEnabled then return end
	started = true
	local gui = Instance.new("ScreenGui")
	gui.Name = "CombatReticle"; gui.ResetOnSpawn = false; gui.ScreenInsets = Enum.ScreenInsets.None; gui.DisplayOrder = 5
	for _, axis in { true, false } do
		local line = Instance.new("Frame")
		line.Name = if axis then "Horizontal" else "Vertical"
		line.AnchorPoint = Vector2.new(0.5, 0.5); line.Position = UDim2.fromScale(0.5, 0.5)
		line.Size = UDim2.fromOffset(if axis then 11 else 2, if axis then 2 else 11)
		line.BorderSizePixel = 0; line.BackgroundColor3 = Color3.fromRGB(240, 244, 250); line.BackgroundTransparency = 0.2
		local outline = Instance.new("UIStroke"); outline.Thickness = 1; outline.Transparency = 0.35; outline.Parent = line
		line.Parent = gui
	end
	gui.Parent = player:WaitForChild("PlayerGui"); reticle = gui
	Input.WindowFocusReleased:Connect(function() focused = false; player:SetAttribute("CombatCursorFree", false) end)
	Input.WindowFocused:Connect(function() focused = true end)
	Input.InputBegan:Connect(function(input, processed)
		if input.KeyCode == Enum.KeyCode.LeftAlt and not processed and not Input:GetFocusedTextBox() then player:SetAttribute("CombatCursorFree", true) end
	end)
	Input.InputEnded:Connect(function(input)
		if input.KeyCode == Enum.KeyCode.LeftAlt then player:SetAttribute("CombatCursorFree", false) end
	end)
	player.CharacterRemoving:Connect(restore)
	RunService:BindToRenderStep("CombatShoulderCamera", Enum.RenderPriority.Camera.Value + 1, function(dt)
		if not enabled then return end
		local model = player.Character
		local humanoid = if model then model:FindFirstChildOfClass("Humanoid") else nil
		local root = if model then model:FindFirstChild("HumanoidRootPart") else nil
		local camera = workspace.CurrentCamera
		if not model or not humanoid or not root or not root:IsA("BasePart") or humanoid.Health <= 0 or not camera then
			if active then restore() end
			return
		end
		if followed ~= model then
			local look = root.CFrame.LookVector
			yaw = math.atan2(-look.X, -look.Z); pitch = math.rad(Config.InitialPitch)
			followed = model; pivot = nil; distance = Config.Distance
			previousHumanoid = humanoid; previousAutoRotate = humanoid.AutoRotate
		end
		if previousCamera ~= camera then
			if previousCamera and previousCamera.Parent then previousCamera.CameraType = previousType end
			previousCamera, previousType = camera, camera.CameraType
		end
		active = true
		camera.CameraType = Enum.CameraType.Scriptable
		humanoid.AutoRotate = false
		local captured = Controller.IsCaptured()
		Input.MouseBehavior = if captured then Enum.MouseBehavior.LockCenter else Enum.MouseBehavior.Default
		Input.MouseIconEnabled = not captured; gui.Enabled = captured
		local hitUntil = player:GetAttribute("CombatHitUntil")
		local validTarget = player:GetAttribute("AimTargetValid")
		local color = if typeof(hitUntil) == "number" and hitUntil > workspace:GetServerTimeNow() then Color3.fromRGB(255, 211, 101)
			elseif validTarget == true then Color3.fromRGB(119, 234, 157)
			elseif validTarget == false then Color3.fromRGB(244, 102, 100) else Color3.fromRGB(240, 244, 250)
		for _, line in gui:GetChildren() do if line:IsA("Frame") then line.BackgroundColor3 = color end end
		if captured then
			local delta = Input:GetMouseDelta()
			local sensitivity = math.rad(setting("Sensitivity", Config.Sensitivity, 0.03, 1))
			yaw -= delta.X * sensitivity
			pitch = math.clamp(pitch - delta.Y * sensitivity, math.rad(Config.MinimumPitch), math.rad(Config.MaximumPitch))
		end
		local rotation = CFrame.Angles(0, yaw, 0) * CFrame.Angles(pitch, 0, 0)
		local fox = model:GetAttribute("HeroVisualForm") == "Kurama"
  local susanoo=((model:GetAttribute("SusanooForm") or 0) :: number)>=3
		local desiredPivot = root.Position + Vector3.new(0, if fox then Kurama.CameraHeight elseif susanoo then 8 else setting("Height", Config.Height, 0.5, 6), 0)
		local oldPivot = pivot
		pivot = if not oldPivot or (oldPivot - desiredPivot).Magnitude > Config.TeleportDistance then desiredPivot
			else oldPivot:Lerp(desiredPivot, Rules.alpha(setting("Smoothing", Config.Smoothing, 0, 60), dt))
		local focus = (pivot :: Vector3) + CFrame.Angles(0, yaw, 0):VectorToWorldSpace(humanoid.CameraOffset)
		local desiredOffset = -rotation.LookVector * (if fox then Kurama.CameraDistance elseif susanoo then 23 else setting("Distance", Config.Distance, 4, 24))
			+ rotation.RightVector * setting("Shoulder", Config.Shoulder, -3, 3)
		local params = RaycastParams.new(); params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = exclusions(model); params.RespectCanCollide = true
		local wall = workspace:Spherecast(focus, Config.CollisionRadius, desiredOffset, params)
		local safeDistance = if wall then math.max(0, wall.Distance - Config.CollisionPadding) else desiredOffset.Magnitude
		-- A new obstruction retracts immediately; leaving a wall restores distance gradually.
		distance = if safeDistance < distance then safeDistance else distance + (safeDistance - distance) * Rules.alpha(Config.ReturnSpeed, dt)
		camera.CFrame = CFrame.new(focus + desiredOffset.Unit * distance) * rotation
		camera.Focus = CFrame.new(focus)
		updateSummonOcclusion(camera)
		-- At a very close wall the camera can enter the avatar. Hide only local
		-- character geometry until there is room again; other players still see it.
		if distance < 2 then
			for _, part in model:GetDescendants() do
				if part:IsA("BasePart") then
					if hiddenParts[part] == nil then hiddenParts[part] = part.LocalTransparencyModifier end
					part.LocalTransparencyModifier = 1
				end
			end
		elseif next(hiddenParts) ~= nil then showCharacter() end
		-- Server-owned control/knockback keeps its orientation. Never unanchor or change WalkSpeed.
		if captured and humanoid.WalkSpeed > 0 and not humanoid.PlatformStand and not humanoid.Sit and not root.Anchored
			and model:GetAttribute("CombatState") ~= "Stunned" then
			root.CFrame = CFrame.new(root.Position) * CFrame.Angles(0, yaw, 0)
		end
	end)
end

return Controller
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="279">
            <Properties>
              <string name="Name">ChakraAuraVisual</string>
              <string name="Source"><![CDATA[--!strict
local Players=game:GetService("Players")
local Kurama=require(script.Parent.KuramaVisual)
local Aura={}
type Layer={folder:Folder,parts:{Part},at:number}
type State={folder:Folder,layers:{[string]:Layer}}
local states:{[Model]:State}={}
local function updateLayer(state:State,form:string,enabled:boolean,root:BasePart,now:number)
 local layer=state.layers[form]
 if not enabled then
  if layer then layer.folder:Destroy();state.layers[form]=nil end
  return
 end
 if not layer then
  local f=Instance.new("Folder");f.Name=form.."Aura";f.Parent=state.folder
  local parts:{Part}={}
  for _=1,18 do
   local p=Instance.new("Part");p.Name="ChakraStream";p.Anchored=true;p.CanCollide=false;p.CanQuery=false;p.CanTouch=false;p.CastShadow=false;p.Material=Enum.Material.Neon;p.Parent=f;table.insert(parts,p)
  end
  local created:Layer={folder=f,parts=parts,at=now};layer=created;state.layers[form]=created
 end
 local t=now-layer.at
 for i,p in layer.parts do
  local phase=(t*(if form=="Kurama" then 1.2 else .55)+i/18)%1
  local angle=i*2.399+t*.7
  local radius=(if form=="Kurama" then 1.5 else 2.2)+math.sin(phase*math.pi)*.5
  local pos=root.Position+Vector3.new(math.cos(angle)*radius,-2.7+phase*6,math.sin(angle)*radius)
  p.Color=if form=="Kurama" then Color3.fromRGB(255,151,25) else Color3.fromRGB(231,174,80)
  p.Size=Vector3.new(.035,if form=="Kurama" then .7+phase else .18,.035)
  p.CFrame=CFrame.new(pos)*CFrame.Angles(0,angle,math.sin(angle)*.3)
  p.Transparency=.25+math.abs(phase-.5)*1.4
 end
end
function Aura.Update(parent:Folder,now:number)
 local live:{[Model]:boolean}={}
 for _,player in Players:GetPlayers() do
  local model=player.Character
  if not model then continue end
  local root=model:FindFirstChild("HumanoidRootPart");local hp=model:FindFirstChildOfClass("Humanoid")
  local chakra=model:GetAttribute("KcmActive")==true or model:GetAttribute("KuramaActive")==true
  local sagePhase=model:GetAttribute("SagePhase");local auraUntil=model:GetAttribute("SageAuraUntil")
  -- Sage's visible aura ends before its stat layer. Morphs do not replace that independent timer.
  local sage=sagePhase=="Preparing" or (sagePhase=="Active" and typeof(auraUntil)=="number" and now<auraUntil)
  local camera=workspace.CurrentCamera
  if not (chakra or sage) or not root or not root:IsA("BasePart") or not hp or hp.Health<=0 or (camera and (root.Position-camera.CFrame.Position).Magnitude>120) then continue end
  live[model]=true
  if model:GetAttribute("HeroVisualForm")=="Kurama" then Kurama.Avatar(model,root,now) end
  local state=states[model]
  if not state then
   local f=Instance.new("Folder");f.Name="ChakraAura";f.Parent=parent
   local createdState:State={folder=f,layers={}};state=createdState;states[model]=createdState
  end
  updateLayer(state,"Kurama",chakra,root,now)
  updateLayer(state,"Sage",sage,root,now)
 end
 for model,state in states do if not live[model] then state.folder:Destroy();states[model]=nil end end
end
return Aura
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="280">
            <Properties>
              <string name="Name">ChakraParticleVisual</string>
              <string name="Source"><![CDATA[--!strict
local Data=require(game:GetService("ReplicatedStorage").Shared.Config.ChakraParticleData)
local Visual={}
export type Layer={emitter: ParticleEmitter, sizes: {{number}}}
export type State={layers: {Layer}, radius: number}
local function sequence(keys: {{number}}, radius: number?): NumberSequence
 local points: {NumberSequenceKeypoint}={}
 for _,k in keys do table.insert(points,NumberSequenceKeypoint.new(k[1],if radius then math.min(2.4,k[2]*2.5)*radius else k[2],0)) end
 return NumberSequence.new(points)
end
function Visual.Create(parent: BasePart): State
 local attachment=Instance.new("Attachment");attachment.Name="CreatorChakra";attachment.Parent=parent
 local state: State={layers={},radius=0}
 for _,spec in Data do
  local e=Instance.new("ParticleEmitter");e.Name=spec.name;e.Texture=spec.texture
  e.Rate=math.min(30,spec.rate*.6);e.Lifetime=NumberRange.new(spec.lifetime[1],spec.lifetime[2])
  e.Rotation=NumberRange.new(spec.rotation[1],spec.rotation[2]);e.RotSpeed=NumberRange.new(spec.rotSpeed[1],spec.rotSpeed[2])
  e.Speed=NumberRange.new(0);e.LockedToPart=true;e.Orientation=Enum.ParticleOrientation.FacingCamera
  e.LightEmission=1;e.LightInfluence=0;e.Transparency=sequence(spec.transparency)
  local colors: {ColorSequenceKeypoint}={}
  for _,k in spec.color do table.insert(colors,ColorSequenceKeypoint.new(k[1],if string.find(spec.name,"golden") then Color3.fromRGB(125,225,255) else Color3.new(k[2],k[3],k[4]))) end
  e.Color=ColorSequence.new(colors);e.Size=sequence(spec.size,.04);e.Parent=attachment
  table.insert(state.layers,{emitter=e,sizes=spec.size})
 end
 return state
end
function Visual.Update(state: State,radius: number)
 if math.abs(radius-state.radius)<.015 then return end
 state.radius=radius
 for _,layer in state.layers do layer.emitter.Size=sequence(layer.sizes,radius) end
end
return Visual
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="281">
            <Properties>
              <string name="Name">CombatController</string>
              <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config.CombatConfig)
local Debug = require(Shared.Config.DebugConfig)
local AttackRules = require(Shared.Combat.BasicAttackRules)
local Protocol = require(Shared.Combat.CombatProtocol)
local Animations = require(script.Parent.AnimationController)
local VFX = require(script.Parent.VFXController)
local Rounds = require(script.Parent.RoundController)

type Pending = { id: number, step: number, sentAt: number, startAt: number, played: boolean, character: Model }
local CombatController = {}
local attackRemote: RemoteEvent? = nil
local snapshot: Protocol.Snapshot? = nil
local pending: Pending? = nil
local requestSerial = 0
local localNextAttackAt = 0
local localStep = 0
local queuedUntil = 0
local currentProfile = Config.Profiles[Config.DefaultProfile]
local seenStarted: { [Model]: number } = setmetatable({}, { __mode = "k" })
local seenHits: { [Model]: {id:number,targets:{[Model]:boolean}} } = setmetatable({}, { __mode = "k" })
local abilityConnection: RBXScriptConnection? = nil

function CombatController.NextRequestId(): number
	requestSerial += 1
	assert(requestSerial <= Config.MaxRequestId, "Combat request ID limit reached")
	return requestSerial
end

local function reset()
	Animations.Stop()
	snapshot, pending = nil, nil
	localNextAttackAt, localStep, queuedUntil = 0, 0, 0
	currentProfile = Config.Profiles[Config.DefaultProfile]
end

local function reconcile(incoming: Protocol.Snapshot): boolean
	if incoming.character ~= Players.LocalPlayer.Character then return false end
	if snapshot and incoming.revision < snapshot.revision then return false end
	snapshot = incoming
	local profiles: { read [string]: Config.AttackProfile } = Config.Profiles
	currentProfile = profiles[incoming.profileId] or Config.Profiles[Config.DefaultProfile]
	localNextAttackAt = incoming.nextAttackAt
	localStep = 1
	if incoming.mode == "Stunned" or incoming.mode == "Dead" then
		Animations.Stop()
		pending = nil
		queuedUntil = 0
	end
	return true
end

local function attackSpeed(): number
 local stats = Players.LocalPlayer:FindFirstChild("HeroState")
 local agility = if stats then stats:GetAttribute("Agility") else 0
 return AttackRules.speed(currentProfile, if typeof(agility) == "number" then agility else 0)
end
local function playPrediction(intent: Pending)
	if intent.played then return end
	intent.played = true
	Animations.Play(intent.id, intent.step, currentProfile, intent.startAt, currentProfile.AttackDuration / attackSpeed())
	VFX.Swing(intent.character, intent.step)
end

local function onEvent(message: Protocol.Event)
	local incoming = message.snapshot
	if incoming and not Rounds.Accepts(incoming.roundId) then return end
	local character = if incoming then incoming.character else message.character
	if message.kind == "Rejected" then
		if incoming then reconcile(incoming) end
		if pending and pending.id == message.requestId and character == pending.character then
			Animations.Stop(pending.id)
			pending = nil
			queuedUntil = 0
			localNextAttackAt = if snapshot then snapshot.nextAttackAt else workspace:GetServerTimeNow()
		end
		return
	end
	if not incoming or not character then return end
	local localCharacter = character == Players.LocalPlayer.Character
	if localCharacter and not reconcile(incoming) then return end

	if message.kind == "Buffered" then
		-- Keep one pending intent. It is played at the due time, never at the early click.
		if pending and pending.id == message.requestId then pending.startAt = incoming.nextAttackAt end
	elseif message.kind == "Started" then
		local attack = message.attack
		if not attack or (seenStarted[character] or 0) >= attack.id then return end
		seenStarted[character] = attack.id
		if localCharacter then
			local predicted = pending
			local alreadyPlayed = predicted and predicted.id == attack.requestId and predicted.played and predicted.step == attack.step
			Animations.Play(attack.requestId, attack.step, currentProfile, attack.startedAt, attack.endsAt - attack.startedAt)
			if not alreadyPlayed and workspace:GetServerTimeNow() < attack.endsAt then VFX.Swing(character, attack.step) end
			if predicted and predicted.id == attack.requestId then pending = nil end
		else
			VFX.Swing(character, attack.step)
		end
		if Debug.LogCombat then print(string.format("[Combat] confirmed %s M1-%d", character.Name, attack.step)) end
	elseif message.kind == "Hit" then
		local attackId, step, hits = message.attackId, message.step, message.hits
		if not attackId or not step or not hits then return end
		local seen=seenHits[character]
		if seen and seen.id>attackId then return end
		if not seen or seen.id~=attackId then seen={id=attackId,targets={}};seenHits[character]=seen end
		local heavy = character:GetAttribute("CombatProfileId")=="Kurama"
		for _, hit in hits do
			if not seen.targets[hit.character] and hit.character.Parent then
				seen.targets[hit.character]=true;VFX.Hit(hit.character, hit.position, heavy)
			end
		end
		if localCharacter and #hits > 0 then VFX.Shake(heavy) end
		if message.hitboxCFrame and message.hitboxSize then VFX.DebugBox(message.hitboxCFrame, message.hitboxSize) end
	end
end

function CombatController.TryAttack(): boolean
	local remote = attackRemote
	local character = Players.LocalPlayer.Character
	local humanoid = if character then character:FindFirstChildOfClass("Humanoid") else nil
	if not remote or not character or not humanoid or humanoid.Health <= 0 then return false end
	if character:GetAttribute("CombatDisabled") == true then return false end
	if character:GetAttribute("AbilityId") and character:GetAttribute("AbilityId") ~= "" then return false end
	local match = ReplicatedStorage:FindFirstChild("SurvivalState")
	if match and match:GetAttribute("Phase") ~= "InProgress" then return false end
	local now = workspace:GetServerTimeNow()
	local rasenganPhase=character:GetAttribute("RasenganPhase")
	if rasenganPhase=="Consumed" or (character:GetAttribute("RasenganHeld")==true and now<((character:GetAttribute("RasenganReadyAt") or 0) :: number)) then return false end
	local authoritative = snapshot
	-- Form changes publish their profile even before the next combat-event snapshot.
	currentProfile = Config.Profiles[tostring(character:GetAttribute("CombatProfileId"))] or currentProfile
	if not authoritative then
		currentProfile = Config.Profiles[tostring(character:GetAttribute("CombatProfileId"))] or currentProfile
	end
	if authoritative and (authoritative.mode == "Dead" or (authoritative.mode == "Stunned" and now < authoritative.stunUntil)) then return false end
	if not authoritative and character:GetAttribute("CombatState") == "Stunned" then return false end
	if pending then
		-- Only an additional real click near recovery can occupy this one local slot.
		if queuedUntil == 0 and now >= localNextAttackAt - currentProfile.InputBufferWindow and now <= localNextAttackAt then
			queuedUntil = localNextAttackAt + currentProfile.InputBufferWindow
		end
		return false
	end
	if now < localNextAttackAt - currentProfile.InputBufferWindow then return false end
	local step = 1
	local dueAt = math.max(now, localNextAttackAt)
	local intent: Pending = {
		id = CombatController.NextRequestId(), step = step, sentAt = now,
		startAt = dueAt, played = false, character = character,
	}
	pending = intent
	queuedUntil = 0
	if dueAt <= now then
		playPrediction(intent)
		localStep = step
		localNextAttackAt = now + currentProfile.AttackCooldown / attackSpeed()
	end
	if match then remote:FireServer(intent.id, character, Rounds.Current()) else remote:FireServer(intent.id, character) end
	return true
end

-- Holding repeats only once recovery ends. It never fills a future input buffer.
function CombatController.TryHeldAttack(): boolean
	if pending or workspace:GetServerTimeNow() < localNextAttackAt then return false end
	return CombatController.TryAttack()
end

function CombatController.GetDiagnostics()
	return { pendingRequestId = if pending then pending.id else 0, queued = queuedUntil > 0 }
end

function CombatController.Start()
	if attackRemote then return end
	Rounds.Watch(function() reset(); table.clear(seenStarted); table.clear(seenHits) end)
	local folder = ReplicatedStorage:WaitForChild(Protocol.FolderName, Config.CharacterReadyTimeout)
	assert(folder, "CombatRemotes missing: check Server/Main")
	local request = folder:WaitForChild(Protocol.BasicAttackName, Config.CharacterReadyTimeout)
	local events = folder:WaitForChild(Protocol.EventName, Config.CharacterReadyTimeout)
	assert(request and request:IsA("RemoteEvent") and events and events:IsA("RemoteEvent"), "Combat protocol v2 remotes missing")
	attackRemote = request
	VFX.Start()
	Animations.Start(function()
		local character = Players.LocalPlayer.Character
		if character then VFX.Swing(character, localStep) end
	end)
	Players.LocalPlayer.CharacterAdded:Connect(reset)
	Players.LocalPlayer.CharacterRemoving:Connect(reset)
	local function bindAbilities(character: Model)
		if abilityConnection then abilityConnection:Disconnect() end
		abilityConnection = character:GetAttributeChangedSignal("AbilityId"):Connect(function()
			if character ~= Players.LocalPlayer.Character then return end
			if character:GetAttribute("AbilityId") ~= "" then Animations.Stop(); pending = nil; queuedUntil = 0 end
		end)
	end
	Players.LocalPlayer.CharacterAdded:Connect(bindAbilities)
	Players.LocalPlayer.CharacterRemoving:Connect(function()
		if abilityConnection then abilityConnection:Disconnect(); abilityConnection = nil end
	end)
	if Players.LocalPlayer.Character then bindAbilities(Players.LocalPlayer.Character) end
	events.OnClientEvent:Connect(onEvent)
	RunService.Heartbeat:Connect(function()
		local now = workspace:GetServerTimeNow()
		local intent = pending
		if intent then
			if intent.character ~= Players.LocalPlayer.Character or now - intent.sentAt > Config.PredictionTimeout then
				Animations.Stop(intent.id)
				pending = nil
				queuedUntil = 0
				localNextAttackAt = if snapshot then snapshot.nextAttackAt else now
			elseif not intent.played and now >= intent.startAt then
				playPrediction(intent)
			end
		elseif queuedUntil > 0 then
			if now > queuedUntil then
				queuedUntil = 0
			elseif now >= localNextAttackAt - currentProfile.InputBufferWindow then
				queuedUntil = 0
				CombatController.TryAttack()
			end
		end
	end)
end

return CombatController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="282">
            <Properties>
              <string name="Name">DeveloperConsoleController</string>
              <string name="Source"><![CDATA[--!strict
local Controller={}
function Controller.Start()
 if not game:GetService("RunService"):IsStudio() then return end
 local player=game:GetService("Players").LocalPlayer
 local input=game:GetService("UserInputService")
 local remote=game:GetService("ReplicatedStorage"):WaitForChild("DeveloperCommand",15)
 if not remote or not remote:IsA("RemoteEvent") then return end
 local gui=Instance.new("ScreenGui");gui.Name="DeveloperConsole";gui.ResetOnSpawn=false;gui.DisplayOrder=100;gui.Parent=player:WaitForChild("PlayerGui")
 local hint=Instance.new("TextButton");hint.Name="Toggle";hint.Text="DEV · F8";hint.Size=UDim2.fromOffset(96,30);hint.Position=UDim2.new(1,-108,0,60)
 hint.BackgroundColor3=Color3.fromRGB(28,35,45);hint.TextColor3=Color3.fromRGB(255,211,110);hint.Font=Enum.Font.GothamBold;hint.TextSize=14;hint.Parent=gui
 local panel=Instance.new("Frame");panel.Name="Panel";panel.Size=UDim2.new(.9,0,0,290);panel.Position=UDim2.new(.5,0,.18,0);panel.AnchorPoint=Vector2.new(.5,0)
 panel.BackgroundColor3=Color3.fromRGB(20,25,33);panel.Visible=false;panel.Parent=gui
 local limit=Instance.new("UISizeConstraint");limit.MaxSize=Vector2.new(620,290);limit.Parent=panel
 local title=Instance.new("TextLabel");title.Size=UDim2.new(1,-28,0,36);title.Position=UDim2.fromOffset(14,8);title.BackgroundTransparency=1
 title.Text="РЕЖИМ РАЗРАБОТКИ · F8 закрыть";title.Font=Enum.Font.GothamBold;title.TextSize=16;title.TextColor3=Color3.fromRGB(255,211,110);title.Parent=panel
 local output=Instance.new("TextLabel");output.Name="Output";output.Position=UDim2.fromOffset(16,50);output.Size=UDim2.new(1,-32,0,160)
 output.BackgroundTransparency=1;output.TextWrapped=true;output.TextXAlignment=Enum.TextXAlignment.Left;output.TextYAlignment=Enum.TextYAlignment.Top
 output.Font=Enum.Font.Gotham;output.TextSize=17;output.TextColor3=Color3.fromRGB(232,237,244);output.Parent=panel
 local box=Instance.new("TextBox");box.Name="Command";box.Position=UDim2.new(0,16,1,-58);box.Size=UDim2.new(1,-32,0,42)
 box.Text="";box.PlaceholderText="Например: level 30    ·    Enter — выполнить";box.ClearTextOnFocus=false;box.Font=Enum.Font.Code;box.TextSize=18
 box.BackgroundColor3=Color3.fromRGB(35,44,57);box.TextColor3=Color3.new(1,1,1);box.Parent=panel
 local function toggle()
  panel.Visible=not panel.Visible;player:SetAttribute("DeveloperConsoleOpen",panel.Visible)
  if panel.Visible then remote:FireServer("help");box:CaptureFocus() else box:ReleaseFocus() end
 end
 hint.Activated:Connect(toggle)
 input.InputBegan:Connect(function(key,processed)
  if key.KeyCode==Enum.KeyCode.F8 and (not processed or panel.Visible) then toggle() end
 end)
 box.FocusLost:Connect(function(enter)
  if not enter or not panel.Visible or box.Text=="" then return end
  remote:FireServer(box.Text);box.Text=""
  task.defer(function() if panel.Visible then box:CaptureFocus() end end)
 end)
 remote.OnClientEvent:Connect(function(ok: boolean,message: string)
  output.Text=message;output.TextColor3=if ok then Color3.fromRGB(225,238,244) else Color3.fromRGB(255,148,123)
  if ok then require(script.Parent.AbilityController).ClearCooldownCorrections() end
 end)
end
return Controller
]]></string>
            </Properties>
