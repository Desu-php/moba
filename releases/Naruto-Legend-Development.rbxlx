          <Item class="ModuleScript" referent="290">
            <Properties>
              <string name="Name">InputController</string>
              <string name="Source"><![CDATA[--!strict

local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local CombatController = require(script.Parent.CombatController)
local Camera = require(script.Parent.CameraController)
local Abilities = require(script.Parent.AbilityController)
local CameraRules = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared").Combat.CombatCameraRules)
local interruptKeys: { [string]: boolean } = {}
for _,key in {"Q","E","R","F","C","T","Z","X","V","B","I"} do interruptKeys[key]=true end

local InputController = {}
local started = false
local held = false
local nextPoll = 0

function InputController.Start()
	if started then
		return
	end
	started = true
	local player = game:GetService("Players").LocalPlayer
	local function configureMovement(character: Model)
		local humanoid = character:WaitForChild("Humanoid", 10)
		if player.Character ~= character or not humanoid or not humanoid:IsA("Humanoid") then return end
		-- SetStateEnabled does not replicate; apply on the physics-owning client too.
		humanoid:SetStateEnabled(Enum.HumanoidStateType.Climbing, false)
		humanoid.AutoJumpEnabled = false
	end
	player.CharacterAdded:Connect(configureMovement)
	if player.Character then task.spawn(configureMovement, player.Character) end
	if UserInputService.KeyboardEnabled then
		-- Own PC locomotion so user-selected ClickToMove never competes with aim clicks.
		-- The existing Humanoid still applies authoritative speed, jump and control locks.
		task.spawn(function()
			local scripts = player:WaitForChild("PlayerScripts")
			local module = scripts:WaitForChild("PlayerModule", 15)
			if module and module:IsA("ModuleScript") then
				-- Roblox injects PlayerModule at runtime, outside the Rojo source map.
				local loadRuntimeModule: any = require
				local defaultPlayer = loadRuntimeModule(module)
				defaultPlayer:GetControls():Disable()
			end
		end)
		RunService:BindToRenderStep("CombatMovement", Enum.RenderPriority.Character.Value + 1, function()
			local character = player.Character
			local humanoid = if character then character:FindFirstChildOfClass("Humanoid") else nil
			if not humanoid then return end
			if not Camera.IsCaptured() or humanoid.Health <= 0 then player:Move(Vector3.zero, false); humanoid.Jump = false; return end
			local x = (if UserInputService:IsKeyDown(Enum.KeyCode.D) then 1 else 0) - (if UserInputService:IsKeyDown(Enum.KeyCode.A) then 1 else 0)
			local z = (if UserInputService:IsKeyDown(Enum.KeyCode.S) then 1 else 0) - (if UserInputService:IsKeyDown(Enum.KeyCode.W) then 1 else 0)
			x, z = CameraRules.move(x, z)
			player:Move(Vector3.new(x, 0, z), true)
			humanoid.Jump = UserInputService:IsKeyDown(Enum.KeyCode.Space)
		end)
	end
	UserInputService.InputBegan:Connect(function(input: InputObject, gameProcessed: boolean)
		-- A skill/command key interrupts a held attack; it cannot manufacture M1.
		if interruptKeys[input.KeyCode.Name] then held = false end
		if gameProcessed or not Camera.IsCaptured() then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			if game:GetService("Players").LocalPlayer:GetAttribute("SelectingCloneTarget") == true then return end
			local playerGui = game:GetService("Players").LocalPlayer:FindFirstChildOfClass("PlayerGui")
			local abilityGui = if playerGui then playerGui:FindFirstChild("AbilityHUD") else nil
			if playerGui and abilityGui then
				for _, object in playerGui:GetGuiObjectsAtPosition(input.Position.X, input.Position.Y) do
					if object:IsDescendantOf(abilityGui) then return end
				end
			end
			if Abilities.TryThrowRasenshuriken() then held=false; return end
			held = true
			CombatController.TryAttack()
		end
	end)
	UserInputService.InputEnded:Connect(function(input: InputObject)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then held = false end
	end)
	UserInputService.WindowFocusReleased:Connect(function() held = false end)
	player.CharacterAdded:Connect(function() held = false end)
	player.CharacterRemoving:Connect(function() held = false end)
	require(script.Parent.RoundController).Watch(function() held = false end)
	RunService.Heartbeat:Connect(function()
		if not held or os.clock() < nextPoll then return end
		nextPoll = os.clock() + 0.05
		local player = game:GetService("Players").LocalPlayer
		if not Camera.IsCaptured() or player:GetAttribute("SelectingCloneTarget") == true then
			held = false; return
		end
		CombatController.TryHeldAttack()
	end)
end

return InputController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="291">
            <Properties>
              <string name="Name">KuramaVisual</string>
              <string name="Source"><![CDATA[--!strict
local Shared=game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Players=game:GetService("Players")
local Avatar=require(Shared.KuramaAvatar)
local Config=require(Shared.Config.KuramaAvatarConfig)
local Visual={}
type Wave={folder:Folder,parts:{Part},center:Vector3,radius:number,at:number}
local waves:{Wave}={}
local function claws(part:BasePart,enabled:boolean)
 if not part:GetAttribute("KuramaTrailsReady") then
  part:SetAttribute("KuramaTrailsReady",true)
  for i=-1,1 do
   local a=Instance.new("Attachment");a.Position=Vector3.new(i*part.Size.X*.32,0,-part.Size.Z*.46);a.Parent=part
   local b=Instance.new("Attachment");b.Position=a.Position+Vector3.new(.24,.08,.15);b.Parent=part
   local trail=Instance.new("Trail");trail.Name="KuramaClawTrail";trail.Attachment0=a;trail.Attachment1=b
   trail.Color=ColorSequence.new(Color3.fromRGB(255,239,142),Color3.fromRGB(255,147,18))
   trail.Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,.1),NumberSequenceKeypoint.new(1,1)})
   trail.Lifetime=.22;trail.LightEmission=1;trail.FaceCamera=true;trail.MinLength=.04;trail.Enabled=false;trail.Parent=part
  end
 end
 for _,child in part:GetChildren() do if child:IsA("Trail") then child.Enabled=enabled end end
end
function Visual.Avatar(model:Model,root:BasePart,now:number)
 local costume=model:FindFirstChild("DisplayedHeroAppearance")
 if not costume or costume:GetAttribute("AppearanceForm")~="Kurama" then return end
 local move=math.clamp(Vector3.new(root.AssemblyLinearVelocity.X,0,root.AssemblyLinearVelocity.Z).Magnitude/22,0,1)
 local started,ends=model:GetAttribute("CombatLastAttackAt"),model:GetAttribute("CombatAttackEndsAt")
 local phase:number?=nil
 if model:GetAttribute("CombatState")=="Attacking" and typeof(started)=="number" and typeof(ends)=="number" and ends>started and now<ends then
  phase=math.clamp((now-started)/(ends-started),0,1)
 end
 local serial=(model:GetAttribute("CombatAttackSerial") or 0) :: number
 for _,part in costume:GetChildren() do
  if not part:IsA("BasePart") then continue end
  local weld=part:FindFirstChild("FormVisualWeld");local base=part:GetAttribute("CosmeticOffset")
  if not weld or not weld:IsA("Weld") or typeof(base)~="CFrame" then continue end
  weld.C0=Avatar.Motion(part.Name,base,now,move,phase,serial)
  -- The giant tail fan must not hide the crosshair and enemies from its owner.
  if model==Players.LocalPlayer.Character and string.find(part.Name,"Tail",1,true) then
   local camera=workspace.CurrentCamera
   local behind=camera~=nil and root.CFrame:PointToObjectSpace(camera.CFrame.Position).Z>0
   part.LocalTransparencyModifier=if behind then .62 else 0
  end
  if string.find(part.Name,"Hand",1,true) then
   local side=if string.find(part.Name,"Left",1,true) then -1 else 1
   claws(part,phase~=nil and phase>=Config.SwipeStart and phase<=Config.SwipeEnd and side==(if serial%2==0 then -1 else 1))
  end
 end
end
function Visual.Event(message:any,parent:Folder)
 if message.kind~="KuramaShockwave" or typeof(message.center)~="Vector3" or typeof(message.radius)~="number"
  or typeof(message.startAt)~="number" or message.radius<=0 or message.radius>50 then return end
 local now=workspace:GetServerTimeNow();if now-message.startAt>.65 then return end
 local camera=workspace.CurrentCamera;if camera and (camera.CFrame.Position-message.center).Magnitude>220 then return end
 while #waves>=6 do local old=table.remove(waves,1);if old then old.folder:Destroy() end end
 local group=Instance.new("Folder");group.Name="KuramaShockwave";group.Parent=parent
 local params=RaycastParams.new();params.FilterType=Enum.RaycastFilterType.Exclude
 if typeof(message.character)=="Instance" then params.FilterDescendantsInstances={message.character} end
 params.RespectCanCollide=true
 local ground=workspace:Raycast(message.center,Vector3.new(0,-20,0),params)
 local center=if ground then ground.Position+Vector3.new(0,.12,0) else message.center-Vector3.new(0,2.8,0)
 local parts:{Part}={}
 for _=1,48 do
  local p=Instance.new("Part");p.Name="ShockwaveEdge";p.Anchored=true;p.CanCollide=false;p.CanTouch=false;p.CanQuery=false
  p.CastShadow=false;p.Material=Enum.Material.Neon;p.Color=Color3.fromRGB(255,205,79);p.Parent=group;table.insert(parts,p)
 end
 group:SetAttribute("DamageRadius",message.radius)
 table.insert(waves,{folder=group,parts=parts,center=center,radius=message.radius,at=message.startAt})
end
function Visual.Update(now:number)
 for i=#waves,1,-1 do
  local wave=waves[i];local age=now-wave.at
  if age>=.65 or not wave.folder.Parent then wave.folder:Destroy();table.remove(waves,i);continue end
  -- Inset by half the line width so even the ring's outer edge stays in the damage area.
  local radius=math.max(0,wave.radius-.07)*math.clamp(age/.12,0,1)
  for j,p in wave.parts do
   local a=(j-1)*math.pi*2/48;local b=j*math.pi*2/48
   local from=wave.center+Vector3.new(math.cos(a)*radius,0,math.sin(a)*radius)
   local to=wave.center+Vector3.new(math.cos(b)*radius,0,math.sin(b)*radius)
   p.Size=Vector3.new(.12,.10,math.max(.01,(to-from).Magnitude));p.CFrame=CFrame.lookAt((from+to)/2,to)
   p.Transparency=math.clamp(age/.65,0,1)
  end
 end
end
function Visual.Clear() for _,wave in waves do wave.folder:Destroy() end;table.clear(waves) end
return Visual
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="292">
            <Properties>
              <string name="Name">LearningController</string>
              <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local Controller = {}
local remote: RemoteEvent? = nil
local serial, messageUntil = 0, 0
local message = ""
local reasons: { [string]: string } = { Learned="Способность изучена", NoPoints="Нет очков обучения", Level="Недостаточный уровень", NotImplemented="Ранг пока недоступен", Replay="Повторный запрос", StaleLife="Герой изменился", RateLimited="Слишком часто" }
function Controller.GetMessage(): string return if os.clock()<messageUntil then message else "" end
function Controller.Start()
	if remote then return end
	local event=game:GetService("ReplicatedStorage"):WaitForChild("AbilityLearning",15)
	assert(event and event:IsA("RemoteEvent")); remote=event
	event.OnClientEvent:Connect(function(_ok: boolean,reason: string) message=reasons[reason] or "Обучение недоступно"; messageUntil=os.clock()+3 end)
end
function Controller.TryLearn(id: string)
	local player=Players.LocalPlayer; local model=player.Character
	local state=game:GetService("ReplicatedStorage"):FindFirstChild("SurvivalState")
	if not remote or not model or not state then return end
	serial += 1
	remote:FireServer(serial,model,model:GetAttribute("LifeId"),id,state:GetAttribute("RoundId"))
end
return Controller
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="293">
            <Properties>
              <string name="Name">MinionMotionController</string>
              <string name="Source"><![CDATA[--!strict
local RunService = game:GetService("RunService")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Poses = require(Shared.Combat.MinionPoses)
local Reaction = require(Shared.Combat.HitReaction)
type Rig = { root: BasePart, humanoid: Humanoid, joints: { Motor6D }, nextAt: number, deathAt: number?, neutral: boolean }
local Motion = {}
local rigs: { [Model]: Rig } = {}
local connection: RBXScriptConnection? = nil
local nextScan = 0
local names = { RootJoint = true, Neck = true, ["Left Shoulder"] = true, ["Right Shoulder"] = true, ["Left Hip"] = true, ["Right Hip"] = true }
local function reset(rig: Rig)
	for _, joint in rig.joints do if joint.Parent then joint.Transform = CFrame.identity end end
	rig.neutral = true
end
local function scan()
	local npcs = workspace:FindFirstChild("NPCs")
	local folder = if npcs then npcs:FindFirstChild("SurvivalMinions") else nil
	if not folder then return end
	for _, model in folder:GetChildren() do
		if not model:IsA("Model") or model:GetAttribute("EntityKind") ~= "Minion" then continue end
		local rig = rigs[model]
		local complete = rig ~= nil and #rig.joints == 6
		if rig then
			for _, joint in rig.joints do if not joint:IsDescendantOf(model) then complete = false; break end end
		end
		if complete then continue end
		local root = model:FindFirstChild("HumanoidRootPart")
		local humanoid = model:FindFirstChildOfClass("Humanoid")
		if not root or not root:IsA("BasePart") or not humanoid then continue end
		local joints: { Motor6D } = {}
		for _, item in model:GetDescendants() do
			if item:IsA("Motor6D") and names[item.Name] then table.insert(joints, item) end
		end
		if rig then reset(rig) end
		rigs[model] = { root = root, humanoid = humanoid, joints = joints, nextAt = 0, deathAt = if rig then rig.deathAt else nil, neutral = true }
	end
end
function Motion.Stop()
	if connection then connection:Disconnect(); connection = nil end
	for _, rig in rigs do reset(rig) end
	table.clear(rigs); nextScan = 0
end
function Motion.Start()
	if connection then return end
	-- One shared loop, no Animation instances, per-NPC event connections, or server pose replication.
	connection = RunService.PreSimulation:Connect(function()
		local now = workspace:GetServerTimeNow()
		if now >= nextScan then nextScan = now + .5; scan() end
		local camera = workspace.CurrentCamera
		for model, rig in rigs do
			if not model:IsDescendantOf(workspace) or not rig.root:IsDescendantOf(model) or not rig.humanoid:IsDescendantOf(model) then
				reset(rig); rigs[model] = nil; continue
			end
			if now < rig.nextAt then continue end
			local distance = if camera then (camera.CFrame.Position - rig.root.Position).Magnitude else math.huge
			local visible = false
			if camera and distance <= Poses.FarDistance then
				local _, onScreen = camera:WorldToViewportPoint(rig.root.Position); visible = onScreen
			end
			rig.nextAt = now + Poses.Interval(distance, visible)
			if not visible or distance > Poses.FarDistance then
				if not rig.neutral then reset(rig) end
				continue
			end
			local velocity = rig.root.AssemblyLinearVelocity * Vector3.new(1, 0, 1)
			local at = model:GetAttribute("MinionAttackAt")
			local dead = rig.humanoid.Health <= 0 or model:GetAttribute("AIState") == "Dead"
			local state, phase = Poses.State(dead, model:GetAttribute("CombatState") == "Stunned", model:GetAttribute("CombatDisabled") == true,
				velocity.Magnitude, now, if typeof(at) == "number" then at else nil)
			if dead then
				local diedAt = model:GetAttribute("MinionDiedAt")
				rig.deathAt = if typeof(diedAt) == "number" then diedAt else rig.deathAt or now
				phase = math.clamp((now - (rig.deathAt :: number)) / Poses.DeathDuration, 0, 1)
			end
			local angles = Poses.Sample(state, now, phase, model:GetAttribute("MinionType") == "Ranged", model:GetAttribute("MinionVisual") == "WhiteZetsu")
			for _, joint in rig.joints do
				local rotation = angles[joint.Name]
				if joint.Parent and rotation then joint.Transform = CFrame.Angles(rotation[1], rotation[2], rotation[3])*Reaction.Offset(model,joint.Name,now) end
			end
			rig.neutral = false
		end
	end)
end
return Motion
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="294">
            <Properties>
              <string name="Name">MobaHUDView</string>
              <string name="Source"><![CDATA[--!strict
local View = {}
View.Background = Color3.fromRGB(20, 24, 29)
View.Card = Color3.fromRGB(35, 41, 47)
View.Gold = Color3.fromRGB(224, 182, 102)
View.Text = Color3.fromRGB(229, 229, 220)
function View.frame(parent: Instance, name: string, size: UDim2, position: UDim2): Frame
	local f = Instance.new("Frame"); f.Name = name; f.Size = size; f.Position = position
	f.BackgroundColor3 = View.Background; f.BorderSizePixel = 0; f.Parent = parent; return f
end
function View.label(parent: Instance, name: string, size: UDim2, position: UDim2, textSize: number): TextLabel
	local t = Instance.new("TextLabel"); t.Name = name; t.Size = size; t.Position = position
	t.BackgroundTransparency = 1; t.Font = Enum.Font.GothamMedium; t.TextSize = textSize; t.TextColor3 = View.Text
	t.Text = ""; t.TextTruncate = Enum.TextTruncate.AtEnd; t.Parent = parent; return t
end
function View.border(parent: GuiObject, color: Color3)
	local stroke = Instance.new("UIStroke"); stroke.Color = color; stroke.Transparency = .35; stroke.Parent = parent
end
export type Portrait = { viewport: ViewportFrame, source: Model?, copy: Model?, appearance: string,
 generation:number,pending:string?,pendingSource:Model? }
function View.portrait(parent: Instance, size: UDim2, position: UDim2): Portrait
	local viewport = Instance.new("ViewportFrame"); viewport.Name = "Portrait"; viewport.Size = size; viewport.Position = position
	viewport.BackgroundColor3 = View.Card; viewport.BorderSizePixel = 0; viewport.LightDirection = Vector3.new(-1,-1,-2)
	viewport.Ambient = Color3.fromRGB(180,180,180); viewport.Parent = parent
	return { viewport = viewport, source = nil, copy = nil, appearance = "",generation=0,pending=nil,pendingSource=nil }
end
function View.updatePortrait(portrait: Portrait, source: Model?)
	local costume = if source then source:FindFirstChild("HeroAppearance") else nil
 local appearance = if source then tostring(source:GetAttribute("HeroAppearanceVersion")) else ""
	if portrait.source == source and portrait.appearance == appearance and (not source or portrait.copy) then
  if portrait.pending then portrait.generation+=1;portrait.pending=nil;portrait.pendingSource=nil end
  return
 end
	if not source then
  portrait.generation+=1;portrait.pending=nil;portrait.pendingSource=nil
  portrait.source=nil;portrait.appearance="";portrait.copy=nil;portrait.viewport:ClearAllChildren();return
 end
 -- Keep the current portrait through partial replication and texture loading.
 if not costume or costume:GetAttribute("AppearanceVersion")~=appearance then return end
 local count=costume:GetAttribute("AppearanceParts")
 local descendants=costume:GetAttribute("AppearanceDescendants")
 if typeof(count)~="number" or #costume:GetChildren()<count or typeof(descendants)~="number" or #costume:GetDescendants()<descendants then return end
 if portrait.pendingSource==source and portrait.pending==appearance then return end
	local head = source:FindFirstChild("Head"); if not head or not head:IsA("BasePart") then portrait.source = nil; return end
 portrait.generation+=1;local generation=portrait.generation
 portrait.pending=appearance;portrait.pendingSource=source
 -- A fixed cosmetic bust keeps combat poses, helper clones and live effects out of the portrait.
 local copy=Instance.new("Model");copy.Name="HeroPortrait"
 local upper=source:FindFirstChild("UpperTorso")
 local torsoHeight=if upper and upper:IsA("BasePart") then upper.Size.Y else 1.6
 local headY=torsoHeight/2+head.Size.Y/2+.1
 local frames: {[string]: CFrame}={Head=CFrame.new(0,headY,0),UpperTorso=CFrame.identity,
  LowerTorso=CFrame.new(0,-1,0),LeftUpperArm=CFrame.new(-1.5,.1,0),RightUpperArm=CFrame.new(1.5,.1,0)}
 local kurama=costume:GetAttribute("AppearanceForm")=="Kurama"
 if kurama then frames.HumanoidRootPart=CFrame.identity end
 local function visualClone(original: BasePart, frame: CFrame): BasePart
  local part=original:Clone()
  local target=original:GetAttribute("AppearanceTransparency")
  if typeof(target)=="number" then part.Transparency=target end
  for _,child in part:GetDescendants() do
   if not child:IsA("DataModelMesh") and not child:IsA("Decal") and not child:IsA("SurfaceAppearance") then child:Destroy() end
  end
  part.Anchored=true;part.CanCollide=false;part.CanTouch=false;part.CanQuery=false
  part.LocalTransparencyModifier=0;part.CFrame=frame;part.Parent=copy;return part
 end
 for name,frame in frames do
  local original=source:FindFirstChild(name)
  if original and original:IsA("BasePart") then visualClone(original,frame) end
 end
 if costume then for _,original in costume:GetChildren() do
  if not original:IsA("BasePart") then continue end
  local body=original:GetAttribute("CosmeticBody");local offset=original:GetAttribute("CosmeticOffset")
  if typeof(body)=="string" and frames[body] and typeof(offset)=="CFrame" then visualClone(original,frames[body]*offset) end
 end end
 for _,item in source:GetChildren() do if item:IsA("Shirt") or item:IsA("Pants") then item:Clone().Parent=copy end end
 local sourceHumanoid=source:FindFirstChildOfClass("Humanoid")
 if sourceHumanoid then
  local humanoid=sourceHumanoid:Clone();humanoid:ClearAllChildren();humanoid.AutomaticScalingEnabled=false
  humanoid.DisplayDistanceType=Enum.HumanoidDisplayDistanceType.None;humanoid.Parent=copy
 end
 local world=Instance.new("WorldModel");copy.Parent=world
 local camera=Instance.new("Camera");camera.FieldOfView=35
 camera.CFrame=CFrame.lookAt(Vector3.new(0,headY+.3,-4.8),Vector3.new(0,headY-.25,0))
 if kurama then
  -- Frame the fox's face, rather than the invisible humanoid head inside its body.
  local config=require(game:GetService("ReplicatedStorage").Shared.Config.KuramaAvatarConfig)
  local lift=Vector3.new(0,config.Lift,0)
  camera.CFrame=CFrame.lookAt(Vector3.new(0,2,-12)*config.Scale+lift,Vector3.new(0,.8,-2)*config.Scale+lift)
 end
 -- Build and preload a replacement off-screen, then swap in one non-yielding step.
 task.spawn(function()
  local ready=pcall(function() game:GetService("ContentProvider"):PreloadAsync({copy}) end)
  if not ready or portrait.generation~=generation or not portrait.viewport.Parent or not source.Parent
   or source:GetAttribute("HeroAppearanceVersion")~=appearance then world:Destroy();camera:Destroy();return end
  portrait.viewport:ClearAllChildren()
  world.Parent=portrait.viewport;camera.Parent=portrait.viewport;portrait.viewport.CurrentCamera=camera
  portrait.copy=copy;portrait.source=source;portrait.appearance=appearance;portrait.pending=nil;portrait.pendingSource=nil
 end)
end
return View
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="295">
            <Properties>
              <string name="Name">NarutoRangedVFXController</string>
              <string name="Source"><![CDATA[--!strict
-- Original procedural art. Seven/nine visuals remain one authoritative damage zone.
local Run=game:GetService("RunService")
local Units=require(game:GetService("ReplicatedStorage"):WaitForChild("Shared").Abilities.WorldUnits)
local Rounds=require(script.Parent.RoundController)
type Projectile={core:Part,a:Part,b:Part}
type Effect={folder:Folder,caster:Model,life:number,code:string,origin:Vector3,target:Vector3,
 startedAt:number,releaseAt:number,arrivalAt:number?,center:Vector3,projectiles:{Projectile},ring:{Part},radius:number}
local active:{[string]:Effect}={}
local starts,arrivals,pulses,ends=0,0,0,0
local started=false
local V={}
local function remove(key:string)
 local e=active[key];if e then active[key]=nil;e.folder:Destroy() end
end
local function clear() for key in active do remove(key) end end
local function part(parent:Folder,name:string,color:Color3):Part
 local p=Instance.new("Part");p.Name=name;p.Anchored=true;p.CanCollide=false;p.CanTouch=false;p.CanQuery=false
 p.CastShadow=false;p.Material=Enum.Material.Neon;p.Color=color;p.Size=Vector3.one;p.Parent=parent;return p
end
function V.Diagnostics():(number,number,{number})
 local n,parts=0,0;for _,e in active do n+=1;parts+=#e.projectiles*3+#e.ring end
 return n,parts,{starts,arrivals,pulses,ends}
end
function V.Event(message:any)
 if typeof(message.key)~="string" then return end
 local key=message.key
 if message.kind=="RikudoEnd" then ends+=1;remove(key);return end
 if message.kind=="RikudoStart" then
  if typeof(message.caster)~="Instance" or not (message.caster :: Instance):IsA("Model")
   or typeof(message.origin)~="Vector3" or typeof(message.target)~="Vector3" then return end
  local camera=workspace.CurrentCamera
  if camera and (camera.CFrame.Position-message.origin).Magnitude>260 then return end
  remove(key)
  local count=0;local oldest:string?=nil;local at=math.huge
  for id,e in active do count+=1;if e.startedAt<at then at=e.startedAt;oldest=id end end
  if count>=12 and oldest then remove(oldest) end
  local folder=Instance.new("Folder");folder.Name="RikudoRasenshurikenVFX";folder.Parent=workspace
  local e:Effect={folder=folder,caster=message.caster :: Model,life=message.life,code=message.abilityId,
   origin=message.origin,target=message.target,startedAt=message.startedAt,releaseAt=message.releaseAt,
   arrivalAt=nil,center=message.target,projectiles={},ring={},radius=0}
  local color=if e.code=="A0HY" then Color3.fromRGB(107,216,255) else Color3.fromRGB(187,138,255)
  for _=1,(if e.code=="A0HY" then 7 else 9) do
   local core=part(folder,"ChakraCore",Color3.fromRGB(38,31,65));core.Shape=Enum.PartType.Ball
   table.insert(e.projectiles,{core=core,a=part(folder,"WindBlade",color),b=part(folder,"WindBlade",color)})
  end
  for _=1,16 do local p=part(folder,"DamageZoneEdge",color);p.Transparency=1;table.insert(e.ring,p) end
  active[key]=e;starts+=1;return
 end
 local e=active[key];if not e then return end
 if message.kind=="RikudoArrived" and typeof(message.position)=="Vector3" then
  e.arrivalAt=message.at;e.center=message.position;arrivals+=1
 elseif message.kind=="RikudoPulse" and typeof(message.radius)=="number" then
  e.radius=message.radius;pulses+=1
 end
end
function V.Start()
 if started then return end;started=true;Rounds.Watch(clear)
 Run.RenderStepped:Connect(function()
  local now=workspace:GetServerTimeNow()
  for key,e in active do
   local hp=e.caster:FindFirstChildOfClass("Humanoid")
   if not e.caster.Parent or not hp or hp.Health<=0 or e.caster:GetAttribute("LifeId")~=e.life or now>e.startedAt+10 then remove(key);continue end
   local delta=(e.target-e.origin)*Vector3.new(1,0,1)
   local length=delta.Magnitude;local direction=if length>.001 then delta.Unit else Vector3.xAxis
   local preparing=now<e.releaseAt
   local travel=math.min(length,math.max(0,now-e.releaseAt)*Units.toStuds(1000))
   local center=if e.arrivalAt then e.center else e.origin+direction*travel+Vector3.new(0,(e.target.Y-e.origin.Y)*(if length>.001 then travel/length else 1),0)
   local spread=Units.toStuds(300)*(if preparing then .15 else 1)
   local size=if e.code=="A0HY" then 1.05 else 1.45
   local elapsed=if e.arrivalAt then math.max(0,now-e.arrivalAt) else 0
   local radius=if e.arrivalAt then Units.toStuds(636+4*(if e.code=="A0HY" then math.min(58,math.floor((elapsed+.03)/.06)) else math.min(116,math.floor(elapsed/.03)+1))) else 0
   radius=math.max(radius,e.radius)
   for i,p in e.projectiles do
    local angle=(i-2)*math.pi*2/(#e.projectiles-1)
    local offset=if i==1 then Vector3.zero else Vector3.new(math.cos(angle),0,math.sin(angle))*spread
    local point=center+offset
    if e.arrivalAt then point=e.center+offset*.3+Vector3.new(0,math.sin(now*6+i)*.4,0) end
    p.core.Size=Vector3.one*size*(if preparing then .7 else 1);p.core.CFrame=CFrame.new(point)
    local cf=CFrame.new(point)*CFrame.Angles(0,now*15+i,0)
    p.a.Size=Vector3.new(size*3.8,.1,size*.28);p.b.Size=Vector3.new(size*.28,.1,size*3.8)
    p.a.CFrame=cf;p.b.CFrame=cf
   end
   for i,p in e.ring do
    if radius<=0 then p.Transparency=1;continue end
    local a=(i-1)*math.pi/8;local b=i*math.pi/8
    local first=e.center+Vector3.new(math.cos(a)*radius,-.85,math.sin(a)*radius)
    local second=e.center+Vector3.new(math.cos(b)*radius,-.85,math.sin(b)*radius)
    p.Size=Vector3.new(.12,.12,(second-first).Magnitude);p.CFrame=CFrame.lookAt((first+second)/2,second);p.Transparency=.22
   end
  end
 end)
end
return V
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="296">
            <Properties>
              <string name="Name">RasenganEvolutionHUD</string>
              <string name="Source"><![CDATA[--!strict
-- A permanent explanation of the existing 1 -> Z -> X technique, not new spells.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local GuiService = game:GetService("GuiService")
local Controller = require(script.Parent.AbilityController)
local View = require(script.Parent.MobaHUDView)
local Icons = require(script.Parent.HUDIcons)
local Layout = require(script.Parent.HUDLayout)

local HUD = {}
local started = false
local ids = { "Rasengan", "Odama", "Rasenshuriken" }
local names = { "Расенган", "Одама Расенган", "Расенсюрикен" }
local keys = { "1", "Z", "X" }
local colors = { Color3.fromRGB(81,189,255), Color3.fromRGB(105,220,255), Color3.fromRGB(192,250,255) }
type Card = { button: TextButton, stroke: UIStroke, key: TextLabel, state: TextLabel, progress: Frame, icon: Frame }
local function number(model: Instance?, name: string): number
	local n = if model then model:GetAttribute(name) else nil
	return if typeof(n) == "number" then n else 0
end

function HUD.Start(gui: ScreenGui)
	if started then return end; started = true
	local player = Players.LocalPlayer
	local panel = View.frame(gui,"RasenganEvolution",UDim2.fromOffset(278,294),UDim2.new(0,18,1,-190))
	panel.AnchorPoint = Vector2.new(0,1); panel.BackgroundTransparency = .08
	local corner = Instance.new("UICorner"); corner.CornerRadius = UDim.new(0,8); corner.Parent = panel
	local outline = Instance.new("UIStroke"); outline.Color = Color3.fromRGB(62,100,124); outline.Transparency = .3; outline.Parent = panel
	local scale = Instance.new("UIScale"); scale.Parent = panel
	local header = View.label(panel,"Heading",UDim2.new(1,-24,0,32),UDim2.fromOffset(12,3),12)
	header.TextWrapped = true
	header.TextXAlignment = Enum.TextXAlignment.Left; header.Font = Enum.Font.GothamBold
	local footer = View.label(panel,"Instruction",UDim2.new(1,-24,0,47),UDim2.fromOffset(12,241),12)
	footer.TextWrapped = true
	footer.TextColor3 = Color3.fromRGB(179,198,212); footer.TextXAlignment = Enum.TextXAlignment.Left
	local cards: {Card} = {}
	for i,id in ids do
		local button = Instance.new("TextButton"); button.Name = id; button.Text = ""
		button.Position = UDim2.fromOffset(12,38+(i-1)*68); button.Size = UDim2.fromOffset(254,60)
		button.BackgroundColor3 = Color3.fromRGB(28,37,49); button.BorderSizePixel = 0; button.Parent = panel
		local round = Instance.new("UICorner"); round.CornerRadius = UDim.new(0,5); round.Parent = button
		local stroke = Instance.new("UIStroke"); stroke.Color = colors[i]; stroke.Transparency = .7; stroke.Parent = button
		local iconHolder = View.frame(button,"Symbol",UDim2.fromOffset(44,44),UDim2.fromOffset(7,10))
		local icon = Icons.draw(iconHolder,id)
		local name = View.label(button,"Name",UDim2.fromOffset(190,22),UDim2.fromOffset(57,5),13)
		name.TextXAlignment = Enum.TextXAlignment.Left; name.Font = Enum.Font.GothamBold; name.Text = names[i]
		local state = View.label(button,"State",UDim2.fromOffset(190,20),UDim2.fromOffset(57,30),11)
		state.TextXAlignment = Enum.TextXAlignment.Left
		local key = View.label(iconHolder,"Key",UDim2.fromOffset(18,18),UDim2.fromOffset(-3,-5),12)
		key.BackgroundTransparency = 0; key.BackgroundColor3 = Color3.fromRGB(9,17,25); key.Font = Enum.Font.GothamBold; key.Text = keys[i]; key.ZIndex = 3
		local progress = View.frame(button,"Window",UDim2.new(0,0,0,3),UDim2.new(0,0,1,-3)); progress.BackgroundColor3 = colors[i]
		button.Activated:Connect(function() Controller.TryCast(id) end)
		cards[i] = {button=button,stroke=stroke,key=key,state=state,progress=progress,icon=icon}
		if i<3 then
			local arrow = View.label(panel,"Arrow"..i,UDim2.fromOffset(20,12),UDim2.fromOffset(129,96+(i-1)*68),11)
			arrow.Text = "↓"; arrow.TextColor3 = colors[i+1]
		end
	end
	RunService.RenderStepped:Connect(function()
		local model = player.Character
		local humanoid = if model then model:FindFirstChildOfClass("Humanoid") else nil
		panel.Visible = humanoid ~= nil and humanoid.Health>0 and player:GetAttribute("ShopOpen")~=true
			and player:GetAttribute("StatsOpen")~=true and not GuiService.MenuIsOpen and (not model or model:GetAttribute("RikudoRangedGranted")~=true)
		if not panel.Visible then return end
		local camera = workspace.CurrentCamera
		if camera then
			scale.Scale = math.clamp(camera.ViewportSize.Y/900,.72,1)
			panel.Position = UDim2.new(0,18,1,-(Layout.ConsoleHeight*Layout.scale(camera.ViewportSize.X,camera.ViewportSize.Y)+18))
		end
		local now = workspace:GetServerTimeNow()
		local profile = player:FindFirstChild("HeroState")
		local rank = number(profile,"Rank_Rasengan")
		local phase = if model then model:GetAttribute("RasenganPhase") else nil
		local variant = if model then model:GetAttribute("RasenganVariant") else nil
		local current = if typeof(variant)=="string" then table.find(ids,variant) or 0 else 0
		local active = current>0 and (phase=="Preparing" or phase=="Holding" or phase=="Consumed")
		local ordinary = model ~= nil and model:GetAttribute("KcmActive")~=true and model:GetAttribute("KuramaActive")~=true
			and (model:GetAttribute("SagePhase")==nil or model:GetAttribute("SagePhase")=="")
		local window = if active and ordinary then math.max(0,number(model,"RasenganVariantUntil")-now) else 0
		local nextIndex = if current<3 and window>0 then current+1 else 0
		local ready = math.max(0,number(model,"RasenganReadyAt")-now,if phase~="Consumed" then number(model,"RasenganSelfPauseUntil")-now else 0)
		header.Text = "РАСЕНГАН  /  ЦЕПОЧКА УСИЛЕНИЙ"
		header.TextColor3 = colors[1]
		footer.Text = "1 → Z → X  ·  На каждое усиление — 1 секунда.  Alt — курсор."
		if not ordinary then
			footer.Text = "Усиления Z и X доступны в обычной форме Наруто."
		elseif rank==0 then
			footer.Text = "Изучите Расенган: Ctrl + 1 с уровня 4. Одама — ранг II, Расенсюрикен — III."
		end
		if active then
			header.Text = string.upper(names[current])..(if phase=="Consumed" then "  /  ПОПАДАНИЕ" elseif ready>0 then "  /  ФОРМИРОВАНИЕ" else "  /  ГОТОВ К УДАРУ")
			header.TextColor3 = colors[current]
			footer.Text = if phase=="Consumed" then "Контакт подтверждён — техника завершается."
				elseif ready>0 then string.format("Формирование %.1f с · затем подойдите к врагу и нажмите ЛКМ.",ready)
				else string.format("Подойдите к врагу: ЛКМ — удар. Заряд сохранится ещё %.1f с.",math.max(0,number(model,"RasenganExpiresAt")-now))
			if nextIndex>0 and rank>=nextIndex then
				local reason = Controller.AbilityUnavailable(ids[nextIndex])
				if not reason and Controller.Remaining(ids[nextIndex])<=0 then
					header.Text = "НАЖМИТЕ "..keys[nextIndex].."  →  "..string.upper(names[nextIndex])
					footer.Text = string.format("Усилить за +200 чакры · окно %.1f с. Без усиления сохранится %s.",window,names[current])
				end
			end
		end
		for i,id in ids do
			local card = cards[i]
			local reason = Controller.AbilityUnavailable(id)
			local cooldown = Controller.Remaining(id)
			local isCurrent = active and current==i
			local available = (i==1 or ordinary) and rank>=i and reason==nil and cooldown<=0 and ((i==1 and not active) or nextIndex==i)
			local complete = active and current>i
			card.button.AutoButtonColor = available; card.button.Active = true
			card.button.BackgroundColor3 = if isCurrent then Color3.fromRGB(26,67,88) elseif available then Color3.fromRGB(28,59,72) else Color3.fromRGB(26,32,42)
			card.stroke.Transparency = if available then .1+.12*math.sin(now*10) elseif isCurrent then .1 else .78
			card.stroke.Thickness = if available or isCurrent then 2 else 1
			card.key.TextColor3 = if available then Color3.fromRGB(255,233,143) else colors[i]
			card.state.TextColor3 = if available then Color3.fromRGB(255,233,143) elseif isCurrent then colors[i] else Color3.fromRGB(159,177,191)
			card.progress.Size = UDim2.new(if nextIndex==i and rank>=i then math.clamp(window,0,1) else 0,0,0,3)
			card.state.Text = if rank<i then (if i==1 then "Изучить: Ctrl + 1" else "Нужен ранг "..(if i==2 then "II" else "III"))
				elseif isCurrent then (if phase=="Consumed" then "Удар" elseif ready>0 then string.format("Формирование %.1f с",ready) else "ЛКМ — удар")
				elseif complete then "✓ Усилено"
				elseif Controller.GetQueuedUpgrade(id) then "Нажатие принято…"
				elseif i>1 and not ordinary then "Обычная форма"
				elseif cooldown>0 then string.format("Перезарядка %.0f с",math.ceil(cooldown))
				elseif active and i==current+1 and window<=0 then "Окно усиления закрыто"
				elseif number(model,"Mana")<(if i==1 then 100 else 200) then "Не хватает чакры"
				elseif available then (if i==1 then "Начать · 100 чакры" else string.format("НАЖМИТЕ %s · %.1f с",keys[i],window))
				elseif nextIndex==i and reason then reason
				elseif i==1 and not active and reason then reason
				else (if i==1 then "100 чакры" elseif i==2 then "После 1 · +200 чакры" else "После Z · +200 чакры")
		end
	end)
end
return HUD
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="297">
            <Properties>
              <string name="Name">RasenganVisual</string>
              <string name="Source"><![CDATA[--!strict
-- Chakra currents with a reviewed Creator Store wind-blade mesh. See docs/CREATOR-ASSETS.md.
local Shared=game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local StoreData=require(Shared.Config.CreatorVisualData)
local Factory=require(Shared.CreatorVisualFactory)
local Particles=require(script.Parent.ChakraParticleVisual)
local Visual = {}
local cyan = Color3.fromRGB(80,198,255)
local ice = Color3.fromRGB(213,250,255)
local white = Color3.fromRGB(248,255,255)
type Current = { part: Part, ring: number, segment: number }
export type Orb = { group: Model, core: Part, plasma: Part, glow: Part, currents: {Current}, storeBlade: Part, storeMesh: SpecialMesh,
 particles: Particles.State?, light: PointLight, variant: string, changedAt: number, radius: number, detailed: boolean, size: number }
export type Burst = { group: Model, parts: {Part}, at: number, duration: number, radius: number, variant: string }
local function part(parent: Instance, name: string, color: Color3): Part
 local p=Instance.new("Part"); p.Name=name; p.Anchored=true; p.CanCollide=false; p.CanTouch=false; p.CanQuery=false
 p.Material=Enum.Material.Neon; p.Color=color; p.CastShadow=false; p.Size=Vector3.one*.1; p.Parent=parent; return p
end
local function sphere(parent: Instance, name: string, color: Color3, transparency: number): Part
 local p=part(parent,name,color); p.Shape=Enum.PartType.Ball; p.Transparency=transparency; return p
end
function Visual.Create(parent: Instance, source: Model, detailed: boolean): Orb
 local group=Instance.new("Model"); group.Name="RasenganChakra"; group:SetAttribute("Source",source.Name); group.Parent=parent
 -- Saturated, deliberately low-value Neon avoids both white clipping and the
 -- directional shadow of an opaque plastic ball. Geometric currents need no Beam texture.
 local core=sphere(group,"ChakraCore",Color3.fromRGB(10,85,135),.08)
 local plasma=sphere(group,"BluePlasma",Color3.fromRGB(18,96,163),.78)
 local glow=sphere(group,"ChakraHalo",Color3.fromRGB(10,65,145),.95)
 local currents: {Current}={}
 for ring=1,if detailed then 0 else 2 do for segment=1,if detailed then 24 else 8 do
  local current=part(group,"RotatingChakraCurrent",Color3.fromRGB(92,198,245))
  table.insert(currents,{part=current,ring=ring,segment=segment})
 end end
 local storeBlade,storeMesh=Factory.Part(StoreData.blade)
 storeBlade.Name="CreatorStoreWindBlades";storeBlade.Anchored=true;storeBlade.Transparency=1
 storeBlade.Material=Enum.Material.Neon;storeBlade.Color=Color3.fromRGB(145,230,255);storeBlade.Parent=group
 local light=Instance.new("PointLight"); light.Color=cyan; light.Range=5; light.Brightness=.22; light.Shadows=false; light.Parent=core
 return {group=group,core=core,plasma=plasma,glow=glow,currents=currents,storeBlade=storeBlade,storeMesh=storeMesh,light=light,
  particles=if detailed then Particles.Create(core) else nil,variant="",changedAt=0,radius=.1,detailed=detailed,size=0}
end
function Visual.Update(state: Orb, source: Model, hand: BasePart, now: number, dt: number)
 local attr=source:GetAttribute("RasenganVariant")
 local variant=if attr=="Odama" or attr=="Rasenshuriken" then attr else "Rasengan"
 if variant~=state.variant then
  state.variant=variant; state.changedAt=now; state.group:SetAttribute("Variant",variant)
  state.group.Name=if variant=="Odama" then "OdamaRasenganChakra" elseif variant=="Rasenshuriken" then "RasenshurikenChakra" else "RasenganChakra"
 end
 local ready=source:GetAttribute("RasenganReadyAt"); local started=source:GetAttribute("RasenganStartedAt")
 -- CFrame stores float32 values. Unix-sized angles erase small ring offsets and
 -- frame-to-frame movement; keep all rotations relative to this short-lived cast.
 local animationTime=if typeof(started)=="number" then math.max(0,now-started) else now%100
 local preparation=if typeof(ready)=="number" and typeof(started)=="number" then math.clamp((now-started)/math.max(.1,ready-started),0,1) else 1
 local charge=if source:GetAttribute("RasenganPhase")=="Preparing" then .16+.84*preparation^1.2 else 1
 local targetRadius=(if variant=="Odama" then 2.15 elseif variant=="Rasenshuriken" then .95 else .66)*charge
 state.radius+=(targetRadius-state.radius)*(1-math.exp(-16*math.min(dt,.1)))
 local radius=math.max(.04,state.radius)
 local upgrade=math.max(0,1-(now-state.changedAt)/.35)
 local offset=if variant=="Odama" then Vector3.new(0,-1.9,-.3) elseif variant=="Rasenshuriken" then Vector3.new(0,-1,-.25) else Vector3.new(0,-.85,-.35)
 local position=hand.CFrame:PointToWorldSpace(offset)
 local center=CFrame.new(position)
 state.core.CFrame=center; state.plasma.CFrame=center; state.glow.CFrame=center
 local pulse=1+math.sin(animationTime*17)*.018
 state.core.Size=Vector3.one*radius*1.64*pulse
 state.plasma.Size=Vector3.one*radius*1.93
 state.glow.Size=Vector3.one*radius*(2.15+upgrade*.35)
 state.core.Color=if variant=="Rasenshuriken" then Color3.fromRGB(12,104,151) else Color3.fromRGB(10,85,135)
 state.plasma.Color=if variant=="Rasenshuriken" then Color3.fromRGB(24,113,177) else Color3.fromRGB(18,96,163)
 state.glow.Transparency=.96-upgrade*.035
 state.light.Range=math.min(8,radius*3+2); state.light.Brightness=.18+upgrade*.12
 if state.particles then Particles.Update(state.particles,radius);state.core.Transparency=.65;state.plasma.Transparency=.93 end
 state.size=radius*2
 -- Three independently rotating, tapered arcs form a readable spherical vortex.
 -- All are outside the plasma shell, so even opaque-volume ordering cannot hide them.
 local segmentCount=if state.detailed then 24 else 8
 for _,current in state.currents do
  local ring,index=current.ring,current.segment
  local rotation=center*CFrame.Angles(ring*.92+animationTime*.21,ring*1.16+animationTime*.14,ring*.73)
  local spin=(if ring%2==0 then -1 else 1)*animationTime*(if variant=="Odama" then 4.7 else 6.8)
  local span=math.pi*1.58
  local angle=spin+(index-1)*span/segmentCount
  local nextAngle=angle+span/segmentCount*1.05
  local r=radius*(1.025+(ring-1)*.018)
  local a=rotation:PointToWorldSpace(Vector3.new(math.cos(angle)*r,math.sin(angle)*r,0))
  local b=rotation:PointToWorldSpace(Vector3.new(math.cos(nextAngle)*r,math.sin(nextAngle)*r,0))
  local tail=(index-1)/segmentCount
  local thickness=radius*(.065-.03*tail)
  local p=current.part
  p.Size=Vector3.new(thickness,thickness,(b-a).Magnitude*1.08)
  p.CFrame=CFrame.lookAt((a+b)/2,b)
  p.Transparency=if state.particles then 1 else .05+tail*.68
 end
 local shuriken=variant=="Rasenshuriken"
 if shuriken then
  local root=source:FindFirstChild("HumanoidRootPart")
  local facing=if root and root:IsA("BasePart") then root.CFrame.Rotation else CFrame.identity
  -- Tilted wind-disc remains recognisable from the shoulder camera, with its
  -- normal independent of wrist rotation so all four points remain readable.
  local bladeFrame=center*facing*CFrame.Angles(math.rad(-35),0,0)*CFrame.Angles(0,animationTime*10,0)
  local size=math.clamp(radius/.95,0,1)
  -- The store mesh is 20.72 studs wide at its authored scale. Fit the same 7.3-stud disc.
  local factor=7.3/StoreData.blade.size[1]*size
  state.storeBlade.CFrame=bladeFrame
  state.storeMesh.Scale=Factory.Vector(StoreData.blade.scale)*factor
  state.storeBlade.Transparency=.3
 else
  state.storeBlade.Transparency=1
 end
end
function Visual.Destroy(state: Orb) state.group:Destroy() end
function Visual.Burst(parent: Instance, position: Vector3, variant: string, kind: string, now: number): Burst
 local group=Instance.new("Model"); group.Name=variant..kind; group.Parent=parent
 local parts: {Part}={}
 local radius=if variant=="Odama" then 6 elseif variant=="Rasenshuriken" then 5 else 3.2
 local duration=if kind=="Contact" then .24 elseif kind=="Impact" then .48 else .62
 if kind=="Contact" then radius*=.42 end
 for index=1,if kind=="Contact" then 9 else 19 do
  local p=if index<=3 then sphere(group,"PressureShell",if index==1 then white else cyan,.3) else part(group,"ChakraSpiral",ice)
  p.Position=position; table.insert(parts,p)
 end
 return {group=group,parts=parts,at=now,duration=duration,radius=radius,variant=variant}
end
function Visual.UpdateBurst(state: Burst, position: Vector3, now: number)
 local t=math.clamp((now-state.at)/state.duration,0,1)
 for index,p in state.parts do
  if index<=3 then
   p.Size=Vector3.one*math.max(.03,state.radius*(.15+t*(if index==1 then .7 else 1.3)))
   p.Position=position; p.Transparency=math.clamp((if index==1 then .25 else .72)+t*.75,0,1)
  else
   local angle=(index-4)*math.pi*2/(#state.parts-3)+t*3.3
   local nextAngle=angle+.22
   local r=state.radius*(.15+t)
   local height=math.sin(angle*2)*(1-t)*state.radius*.35
   local a=position+Vector3.new(math.cos(angle)*r,height,math.sin(angle)*r)
   local b=position+Vector3.new(math.cos(nextAngle)*r,height+.12,math.sin(nextAngle)*r)
   p.Size=Vector3.new(.045,.045,(b-a).Magnitude);p.CFrame=CFrame.lookAt((a+b)/2,b);p.Transparency=t
  end
 end
end
return Visual
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="298">
            <Properties>
              <string name="Name">RasenshurikenFlightVisual</string>
              <string name="Source"><![CDATA[--!strict
local Art=require(script.Parent.RasenganVisual)
type Flight={orb:Art.Orb,model:Model,hand:Part,source:Model?,origin:Vector3,direction:Vector3,at:number,speed:number,range:number}
local flights:{[number]:Flight}={}
local V={}
local function remove(id:number)
 local f=flights[id];if f then Art.Destroy(f.orb);f.model:Destroy();flights[id]=nil end
end
function V.Event(message:any,parent:Folder)
 if message.kind=="RasenshurikenFlightEnd" or message.kind=="RasenshurikenDetonate" then remove(message.id);return end
 if message.kind~="RasenshurikenFlight" then return end
 local count=0;for _ in flights do count+=1 end;if count>=32 then return end
 local m=Instance.new("Model");m.Name="ThrownRasenshuriken";m:SetAttribute("RasenganVariant","Rasenshuriken");m:SetAttribute("RasenganPhase","Holding");m:SetAttribute("RasenganStartedAt",message.releaseAt)
 local hand=Instance.new("Part");hand.Name="HumanoidRootPart";hand.Parent=m
 flights[message.id]={orb=Art.Create(parent,m,true),model=m,hand=hand,source=message.source,origin=message.position,direction=message.direction,at=message.releaseAt,speed=message.speed,range=message.range}
end
function V.Update(now:number,dt:number)
 for id,f in flights do
  if now>f.at+f.range/f.speed+.5 or not f.source or not f.source.Parent then remove(id);continue end
  local pos=f.origin+f.direction*math.clamp((now-f.at)*f.speed,0,f.range)
  f.hand.CFrame=CFrame.lookAt(pos,pos+f.direction)*CFrame.new(0,1,.25)
  local hand=f.source:FindFirstChild("RightHand")
  Art.Update(f.orb,f.model,if now<f.at and hand and hand:IsA("BasePart") then hand else f.hand,now,dt)
 end
end
function V.Clear() for id in flights do remove(id) end end
return V
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="299">
            <Properties>
              <string name="Name">RoundController</string>
              <string name="Source"><![CDATA[--!strict
local Storage = game:GetService("ReplicatedStorage")
local Protocol = require(Storage:WaitForChild("Shared").Game.RoundProtocol)
local Controller = {}
local callbacks: { () -> () } = {}
local bound: Instance? = nil
local function clear() for _, callback in callbacks do callback() end end
local function bind(state: Instance)
	if bound or state.Name ~= "SurvivalState" then return end; bound = state
	state:GetAttributeChangedSignal("RoundId"):Connect(clear)
	state:GetAttributeChangedSignal("Phase"):Connect(function()
		local phase = state:GetAttribute("Phase")
		if phase == "Finished" then clear() end
	end)
end
function Controller.Current(): number?
	local state = Storage:FindFirstChild("SurvivalState")
	return if state then state:GetAttribute("RoundId") :: number? else nil
end
function Controller.Accepts(roundId: any): boolean
	local state = Storage:FindFirstChild("SurvivalState")
	local isolated = game:GetService("RunService"):IsStudio() and workspace:GetAttribute("CombatOnlyTest") == true
	return Protocol.acceptsClient(Controller.Current(), roundId, if state then state:GetAttribute("Phase") else nil, isolated)
end
function Controller.Watch(callback: () -> ())
	table.insert(callbacks, callback)
end
Storage.ChildAdded:Connect(bind)
local state = Storage:FindFirstChild("SurvivalState"); if state then bind(state) end
return Controller
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="300">
            <Properties>
              <string name="Name">SasukeFireCastFX</string>
              <string name="Source"><![CDATA[--!strict
local F=require(game.ReplicatedStorage.Shared.Abilities.SasukeFireRules)
local Flame=require(script.Parent.SasukeFlameFX)
local FX={}
local active:{any}={}
local function source(folder:Folder,point:Vector3,scale:number,black:boolean):Part
 local p=Instance.new("Part");p.Name="FlameSource";p.Size=Vector3.one*.1;p.Anchored=true
 p.CanCollide=false;p.CanTouch=false;p.CanQuery=false;p.CastShadow=false;p.Transparency=1;p.Position=point;p.Parent=folder
 Flame.Attach(p,scale,black,false);return p
end
function FX.Clear() for _,e in active do e.folder:Destroy() end;table.clear(active) end
function FX.Message(m:any,parent:Folder):boolean
 if m.id=="FireEnd" then
  for i=#active,1,-1 do if active[i].serial==m.extra.fireSerial then active[i].folder:Destroy();table.remove(active,i) end end
  return true
 end
 if m.id~="FireBreath" and m.id~="BlackBurn" and m.id~="BlackCoating" then return false end
 local f=Instance.new("Folder");f.Name=m.id;f.Parent=parent
 local e:any={id=m.id,folder=f,at=m.at,untilAt=m.at+m.duration,serial=m.extra.fireSerial,caster=m.character,target=m.extra.target,origin=m.position,direction=m.extra.direction,nodes={},spine={},rails={}}
 table.insert(active,e)
 if e.id=="FireBreath" then
  e.ground=m.extra.origin.Y-2.5
  for i=1,18 do
   local scale=if i==1 then 1.2 else 2+i*.32
   local p=source(f,e.origin,scale,false);table.insert(e.nodes,p)
   if i%6==0 then Flame.Light(p,scale,false) end
  end
  for i=1,9 do
   local p=source(f,e.origin,.7+i*.65,false)
   for _,v in p:GetChildren() do if v:IsA("ParticleEmitter") then
    v.EmissionDirection=Enum.NormalId.Front;v.Speed=NumberRange.new(12,24);v.Acceleration=Vector3.yAxis*2
    if v.Name=="FlameTongues" then v.Rate=28;v:Emit(8) end
   end end
   table.insert(e.spine,p)
  end
  -- Lightweight outline follows the expanding front, then the three reference circles.
  for _=1,72 do local p=Instance.new("Part");p.Name="DamageBoundary";p.Anchored=true;p.CanCollide=false;p.CanTouch=false;p.CanQuery=false;p.CastShadow=false
   p.Material=Enum.Material.Neon;p.Color=Color3.fromRGB(255,125,30);p.Transparency=.7;p.Parent=f;table.insert(e.rails,p)
  end
 else
  for i=1,if e.id=="BlackCoating" then 8 else 4 do table.insert(e.nodes,source(f,m.position,if e.id=="BlackCoating" then 1.7 else .9,true)) end
 end
 return true
end
function FX.Update(now:number)
 for i=#active,1,-1 do local e=active[i]
  local target=e.target or e.caster;local h=if target and target.Parent then target:FindFirstChildOfClass("Humanoid") else nil
  if now>=e.untilAt or not h or h.Health<=0 or (e.id=="BlackCoating" and ((target:GetAttribute("AmaterasuCoatingUntil") or 0) :: number)<=now) then
   e.folder:Destroy();table.remove(active,i);continue
  end
  local age=math.max(0,now-e.at)
  if e.id=="FireBreath" then
   local dir=e.direction;local side=dir:Cross(Vector3.yAxis);local center=e.origin+dir*(F.front(age)/16)
   for j,p in e.nodes do
    if age<1 then
     local radius=F.radius(age)/16;local angle=j*2.399
     p.Position=if j==1 then e.origin else center+side*(math.cos(angle)*radius*.65)+dir*(math.sin(angle)*radius*.55)+Vector3.yAxis*((j%3)*.7)
    else
     local fraction=(j-1)/17;local along=fraction*1060;local width=0
     for _,circle in {{100,100},{300,300},{675,450}} do width=math.max(width,math.sqrt(math.max(0,circle[2]^2-(along-circle[1])^2))) end
     p.Position=e.origin+dir*(along/16)+side*(math.sin(j*2.399+now*.8)*width/16*.7)+Vector3.yAxis*(math.sin(now*6+j)*.35)
    end
    p.CFrame=CFrame.lookAt(p.Position,p.Position+dir)
   end
   for j,p in e.spine do
    local along=(j-1)/8*(if age<1 then F.front(age)/16 else 62)
    local pos=e.origin+dir*along
    p.CFrame=CFrame.lookAt(pos,pos+dir)
   end
   for j,p in e.rails do
    local group=math.ceil(j/24);local index=(j-1)%24;local offset:number;local radius:number
    if age<1 then offset=F.front(age)/16;radius=F.radius(age)/16;p.Transparency=if group==1 then .65 else 1
    else local circle=({{100,100},{300,300},{675,450}})[group];offset=circle[1]/16;radius=circle[2]/16;p.Transparency=.78 end
    local base=e.origin+dir*offset;local a=index*math.pi/12;local b=(index+1)*math.pi/12
    local first=Vector3.new(base.X+math.cos(a)*radius,e.ground,base.Z+math.sin(a)*radius)
    local last=Vector3.new(base.X+math.cos(b)*radius,e.ground,base.Z+math.sin(b)*radius)
    p.Size=Vector3.new(.09,.09,(last-first).Magnitude);p.CFrame=CFrame.lookAt((first+last)/2,last)
   end
  else
   local root=target:FindFirstChild("HumanoidRootPart")
   if root and root:IsA("BasePart") then for j,p in e.nodes do local angle=j*math.pi*2/#e.nodes+now*.7
    local radius=if e.id=="BlackCoating" then 2.4 else .65
    p.Position=root.Position+Vector3.new(math.cos(angle)*radius,if e.id=="BlackCoating" then -.4 else (j%2)-.7,math.sin(angle)*radius)
   end end
  end
 end
end
return FX
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="301">
            <Properties>
              <string name="Name">SasukeFlameFX</string>
              <string name="Source"><![CDATA[--!strict
-- Local cosmetic particles only. Built-in textures need no uploaded asset permissions.
local Flame={}
local warm=ColorSequence.new({
 ColorSequenceKeypoint.new(0,Color3.fromRGB(255,245,184)),
 ColorSequenceKeypoint.new(.22,Color3.fromRGB(255,190,49)),
 ColorSequenceKeypoint.new(.6,Color3.fromRGB(245,73,12)),
 ColorSequenceKeypoint.new(1,Color3.fromRGB(85,15,7)),
})
local dark=ColorSequence.new({
 ColorSequenceKeypoint.new(0,Color3.fromRGB(8,3,13)),
 ColorSequenceKeypoint.new(.65,Color3.fromRGB(16,5,23)),
 ColorSequenceKeypoint.new(1,Color3.fromRGB(65,23,79)),
})
local function size(s:number):NumberSequence
 return NumberSequence.new({NumberSequenceKeypoint.new(0,s*.45),NumberSequenceKeypoint.new(.18,s,.18*s),NumberSequenceKeypoint.new(.65,s*.65,.15*s),NumberSequenceKeypoint.new(1,0)})
end
local function emitter(p:BasePart,name:string,texture:string):ParticleEmitter
 local v=Instance.new("ParticleEmitter");v.Name=name;v.Texture="rbxasset://textures/particles/"..texture..".dds"
 v.EmissionDirection=Enum.NormalId.Top;v.Orientation=Enum.ParticleOrientation.FacingCamera
 v.Rotation=NumberRange.new(-180,180);v.RotSpeed=NumberRange.new(-65,65)
 v.LightInfluence=0;v.LockedToPart=false;v.VelocityInheritance=0
 v.Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,1),NumberSequenceKeypoint.new(.12,.12),NumberSequenceKeypoint.new(.65,.35),NumberSequenceKeypoint.new(1,1)})
 v.Parent=p;return v
end
function Flame.Attach(p:BasePart,scale:number,black:boolean,projectile:boolean):{ParticleEmitter}
 local layers={}
 local tongues=emitter(p,"FlameTongues","fire_main")
 tongues.Color=if black then dark else warm; tongues.LightEmission=if black then 0 else .8
 tongues.Size=size(scale*1.65);tongues.Lifetime=NumberRange.new(.22,.48)
 tongues.Speed=NumberRange.new(scale*1.4,scale*3.2);tongues.Acceleration=Vector3.new(0,scale*3,0)
 tongues.SpreadAngle=Vector2.new(26,26);tongues.Rate=if projectile then 60 else 16
 if projectile then tongues.EmissionDirection=Enum.NormalId.Back;tongues.SpreadAngle=Vector2.new(18,18) end
 table.insert(layers,tongues)
 local heart=emitter(p,"FlameHeart","fire_main")
 heart.Color=if black then dark else warm;heart.LightEmission=if black then 0 else 1
 heart.Size=size(scale*.9);heart.Lifetime=NumberRange.new(.12,.23);heart.Speed=NumberRange.new(scale*.3,scale)
 heart.Acceleration=Vector3.new(0,scale*2,0);heart.SpreadAngle=Vector2.new(40,40);heart.Rate=if projectile then 38 else 12
 table.insert(layers,heart)
 local smoke=emitter(p,"Soot","smoke_main")
 smoke.Color=ColorSequence.new(Color3.fromRGB(60,48,43),Color3.fromRGB(30,28,30))
 smoke.Size=NumberSequence.new({NumberSequenceKeypoint.new(0,scale*.6),NumberSequenceKeypoint.new(1,scale*2.4)})
 smoke.Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,1),NumberSequenceKeypoint.new(.2,.8),NumberSequenceKeypoint.new(1,1)})
 smoke.Lifetime=NumberRange.new(.45,.85);smoke.Speed=NumberRange.new(scale*.4,scale)
 smoke.Acceleration=Vector3.new(0,scale*4,0);smoke.SpreadAngle=Vector2.new(30,30);smoke.Rate=if projectile then 9 else 3
 table.insert(layers,smoke)
 local sparks=emitter(p,"RisingEmbers","sparkles_main")
 sparks.Color=if black then ColorSequence.new(Color3.fromRGB(113,46,153)) else warm
 sparks.LightEmission=1;sparks.Size=NumberSequence.new({NumberSequenceKeypoint.new(0,.1*scale),NumberSequenceKeypoint.new(1,0)})
 sparks.Lifetime=NumberRange.new(.3,.7);sparks.Speed=NumberRange.new(scale*2,scale*5)
 sparks.Acceleration=Vector3.new(0,scale*3,0);sparks.SpreadAngle=Vector2.new(45,45);sparks.Rate=if projectile then 12 else 3
 table.insert(layers,sparks)
 return layers
end
function Flame.Light(p:BasePart,scale:number,black:boolean):PointLight
 local light=Instance.new("PointLight");light.Color=if black then Color3.fromRGB(104,40,160) else Color3.fromRGB(255,148,46)
 light.Brightness=if black then .4 else 1.5;light.Range=math.min(20,scale*5);light.Shadows=false;light.Parent=p;return light
end
function Flame.Burst(p:BasePart,scale:number,black:boolean?)
 local layers=Flame.Attach(p,scale,black==true,false)
 for _,v in layers do
  v.Enabled=false;v.SpreadAngle=Vector2.new(180,180)
  v.Speed=NumberRange.new(scale*2,scale*6)
  v:Emit(if v.Name=="FlameTongues" then 32 elseif v.Name=="FlameHeart" then 18 elseif v.Name=="Soot" then 8 else 24)
 end
 Flame.Light(p,scale,black==true)
end
return Flame
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="302">
            <Properties>
              <string name="Name">SasukeSpellEffects</string>
              <string name="Source"><![CDATA[--!strict
-- Server messages supply centres, radii, endpoints and timestamps. No client damage.
local Shared=game.ReplicatedStorage:WaitForChild("Shared")
local Rules=require(Shared.Abilities.SasukePresentation)
local Flame=require(script.Parent.SasukeFlameFX)
local FireCast=require(script.Parent.SasukeFireCastFX)
local Combat=require(Shared.Config.CombatConfig)
local FX={}
local active:{any}={}
local avatars:{[Model]:any}={}
local actors:{[Model]:boolean}={}
local parent:Folder
local violet=Color3.fromRGB(155,78,240)
local blue=Color3.fromRGB(125,214,255)
local fire=Color3.fromRGB(255,117,27)
local handled={Amaterasu=true,Fire=true,KirinPrepare=true,KirinWarning=true,Kirin=true,Transform=true,
 Katana=true,Nagashi=true,Genjutsu=true,Teleport=true,EntonPull=true,Eiso=true,Projectile=true,Impact=true,
 ChibakuDrop=true,ChibakuImpact=true,Extinguish=true,AreaEnd=true,EntonPierce=true,Summon=true,EntonGather=true,SusanooWave=true,EntonCombo=true,EntonComboWarning=true,AmaterasuWarning=true}
local function make(f:Instance,name:string,size:Vector3,cf:CFrame,color:Color3,alpha:number?):Part
 local p=Instance.new("Part");p.Name=name;p.Anchored=true;p.CanCollide=false;p.CanTouch=false;p.CanQuery=false;p.CastShadow=false
 p.Size=size;p.CFrame=cf;p.Color=color;p.Material=Enum.Material.Neon;p.Transparency=alpha or 0;p.Parent=f;return p
end
local function ball(f:Instance,name:string,size:Vector3,point:Vector3,color:Color3,alpha:number?):Part
 local p=make(f,name,size,CFrame.new(point),color,alpha)
 -- SpecialMesh keeps non-uniform flame/neck proportions; Part.Shape Ball does not.
 local mesh=Instance.new("SpecialMesh");mesh.MeshType=Enum.MeshType.Sphere;mesh.Parent=p
 return p
end
local function line(f:Instance,name:string,a:Vector3,b:Vector3,color:Color3,width:number,alpha:number?):Part
 return make(f,name,Vector3.new(width,width,math.max(.01,(b-a).Magnitude)),CFrame.lookAt((a+b)/2,b),color,alpha)
end
local function floor(point:Vector3,caster:Model?):Vector3
 local ignore:{Instance}={parent};if caster then table.insert(ignore,caster) end
 for model in actors do table.insert(ignore,model) end
 local p=RaycastParams.new();p.FilterDescendantsInstances=ignore;p.RespectCanCollide=true
 local hit=workspace:Raycast(point+Vector3.new(0,6,0),Vector3.new(0,-40,0),p)
 return if hit then hit.Position+Vector3.new(0,.12,0) else point
end
local function ring(e:any,center:Vector3,radius:number,color:Color3)
 -- Boundary stays fixed. Interior animation never advertises a larger hit area.
 for i=1,32 do local a,b=(i-1)*math.pi/16,i*math.pi/16
  local first=floor(center+Vector3.new(math.cos(a),0,math.sin(a))*radius,e.caster)
  local last=floor(center+Vector3.new(math.cos(b),0,math.sin(b))*radius,e.caster)
  line(e.folder,"DamageBoundary",first,last,color,.11,.2)
 end
 local mark=floor(center,e.caster)
 line(e.folder,"AimCentre",mark-Vector3.new(.7,0,0),mark+Vector3.new(.7,0,0),color,.1,.25)
 line(e.folder,"AimCentre",mark-Vector3.new(0,0,.7),mark+Vector3.new(0,0,.7),color,.1,.25)
end
local function bolt(f:Instance,a:Vector3,b:Vector3,color:Color3,width:number,seed:number)
 local delta=b-a;local last=a
 for i=1,10 do local t=i/10
  local nextPoint=a+delta*t+Vector3.new(math.sin(i*5+seed),0,math.cos(i*3+seed))*math.sin(t*math.pi)*math.min(1,delta.Magnitude*.06)
  line(f,"LightningArc",last,nextPoint,color,width,.15);last=nextPoint
 end
end
local function dragon(e:any)
 e.dragon={}
 local body=Color3.fromRGB(37,116,187)
 local function piece(name:string,offset:Vector3,size:Vector3,color:Color3,rotation:CFrame?,angular:boolean?)
  local p=if angular then make(e.folder,name,size,CFrame.new(e.point+offset),color,.12) else ball(e.folder,name,size,e.point+offset,color,.12)
  p.Material=Enum.Material.SmoothPlastic
  table.insert(e.dragon,{part=p,offset=offset,rotation=rotation});return p
 end
 -- Overlapping tapered neck, broad canine muzzle and branching antlers. Darker
 -- body preserves the silhouette under bloom; only eyes and mane emit light.
 for i=1,8 do
  local width=5-i*.42
  piece("LightningNeck",Vector3.new(math.sin(i*.52)*3,i*2.1,2+i*.35),Vector3.new(width,5,width),body,CFrame.Angles(0,0,-math.cos(i*.52)*.3))
 end
 piece("KirinHead",Vector3.zero,Vector3.new(7,4.8,6),body)
 piece("KirinMuzzle",Vector3.new(0,-1,-3),Vector3.new(4.7,2.2,4),Color3.fromRGB(65,156,219),nil,true)
 piece("KirinNose",Vector3.new(0,-.5,-5),Vector3.new(3.5,.8,.6),Color3.fromRGB(15,50,95),nil,true)
 piece("KirinJaw",Vector3.new(0,-2.6,-2.7),Vector3.new(3.6,.7,3.9),body,CFrame.Angles(.14,0,0),true)
 for sign=-1,1,2 do
  piece("KirinEye",Vector3.new(sign*2.5,.3,-2.5),Vector3.new(.8,.45,.65),Color3.fromRGB(255,245,180)).Material=Enum.Material.Neon
  piece("KirinBrow",Vector3.new(sign*2.4,.9,-2.8),Vector3.new(2,.55,1),body,CFrame.Angles(0,0,-sign*.3),true)
  piece("KirinHorn",Vector3.new(sign*2.7,3.8,1),Vector3.new(.65,6,.65),blue,CFrame.Angles(.25,0,-sign*.35),true)
  piece("AntlerBranch",Vector3.new(sign*4,4,1.5),Vector3.new(.4,3,.4),blue,CFrame.Angles(.4,0,-sign*.9),true)
  for i=1,4 do
   local mane=piece("LightningMane",Vector3.new(sign*(3.3+i*.3),.5+i*.65,1+i*.5),Vector3.new(.4,3+i*.5,.5),blue,CFrame.Angles(.55,0,-sign*(.6+i*.12)),true)
   mane.Material=Enum.Material.Neon;mane.Transparency=.35
  end
  for i=1,2 do piece("KirinFang",Vector3.new(sign*1.5,-1.8,-2-i),Vector3.new(.35,.9,.4),blue,nil,true) end
 end
 local root=if e.caster then e.caster:FindFirstChild("HumanoidRootPart") else nil
 local facing=if root and root:IsA("BasePart") then (root.Position-e.point)*Vector3.new(1,0,1) else Vector3.zAxis
 e.dragonFacing=if facing.Magnitude>.01 then CFrame.lookAt(Vector3.zero,facing) else CFrame.identity
end
function FX.Start(folder:Folder,models:{[Model]:boolean}) parent=folder;actors=models end
function FX.Clear()
 FireCast.Clear()
 for _,e in active do e.folder:Destroy() end;table.clear(active)
 for _,e in avatars do e.folder:Destroy() end;table.clear(avatars)
end
function FX.Avatar(model:Model,now:number)
 local form=(model:GetAttribute("SusanooForm") or 0) :: number
 local h=model:FindFirstChildOfClass("Humanoid");local root=model:FindFirstChild("HumanoidRootPart")
 local e=avatars[model]
 if form<=0 or not model.Parent or not h or h.Health<=0 or not root or not root:IsA("BasePart") then
  if e then e.folder:Destroy();avatars[model]=nil end;return
 end
 if not e then
  local f=Instance.new("Folder");f.Name="SusanooAura";f.Parent=parent
  e={folder=f,wisps={},boundary={}};avatars[model]=e
  for _=1,10 do table.insert(e.wisps,ball(f,"ChakraFlare",Vector3.new(.3,2,.3),root.Position,violet,.7)) end
  e.blade=make(f,"ChakraBlade",Vector3.one,CFrame.new(root.Position),violet,.4)
  e.core=make(f,"BladeCore",Vector3.one,CFrame.new(root.Position),Color3.fromRGB(213,177,255),.35)
  for _=1,5 do table.insert(e.boundary,make(f,"AttackFootprint",Vector3.one,CFrame.new(root.Position),violet,1)) end
 end
 local at=(model:GetAttribute("CombatLastAttackAt") or 0) :: number
 local ends=(model:GetAttribute("CombatAttackEndsAt") or 0) :: number
 local hit=(model:GetAttribute("CombatAttackHitAt") or 0) :: number
 local duration=math.max(.001,ends-at);local phase=(now-at)/duration
 local swing=Rules.susanooSwing(phase,(hit-at)/duration)
 local rise=math.clamp((now-((model:GetAttribute("SusanooFormAt") or now) :: number))/.7,0,1)
 for i,p in e.wisps do local a=i*2.399+now*.8;local radius=if form>=3 then 4 else 2.3
  p.Position=root.Position+Vector3.new(math.cos(a)*radius,((now*.6+i*.13)%1)*(if form>=3 then 13 else 4)*rise-1,math.sin(a)*radius)
  p.Size=Vector3.new(.22,if form>=3 then 3 else 1.4,.22);p.Transparency=.65+.2*math.sin(now*2+i)^2
 end
 local appearance=model:FindFirstChild("DisplayedHeroAppearance");local hand=if appearance then appearance:FindFirstChild("Rarm2") else nil
 local show=form>=3 and hand and hand:IsA("BasePart")
 if show and hand and hand:IsA("BasePart") then
  local from=hand.Position
  local rest=from+root.CFrame.LookVector*6
  local contact=root.CFrame:PointToWorldSpace(Vector3.new(0,.4,-14))
  local tip=rest:Lerp(contact,swing);local cf=CFrame.lookAt((from+tip)/2,tip);local length=(tip-from).Magnitude
  e.blade.CFrame=cf;e.blade.Size=Vector3.new(.4,.8,length);e.blade.Transparency=.45
  e.core.CFrame=cf;e.core.Size=Vector3.new(.12,.3,length);e.core.Transparency=.35
 else e.blade.Transparency=1;e.core.Transparency=1 end
 -- Clip the box by the same forward-angle requirement as server target selection.
 local profile=Combat.Profiles.SasukeSusanoo
 local half=profile.HitboxSize.X/2;local depth=profile.HitboxSize.Z
 local near=half/math.tan(math.acos(profile.MinimumForwardDot))
 local corners={Vector3.zero,Vector3.new(half,0,-near),Vector3.new(half,0,-depth),Vector3.new(-half,0,-depth),Vector3.new(-half,0,-near)}
 for i,p in e.boundary do
  p.Transparency=if form>=3 and phase>=0 and phase<.65 then .45 else 1
  local a=root.CFrame:PointToWorldSpace(corners[i]);local b=root.CFrame:PointToWorldSpace(corners[i%5+1])
  a-=Vector3.new(0,h.HipHeight+root.Size.Y/2-.15,0);b-=Vector3.new(0,h.HipHeight+root.Size.Y/2-.15,0)
  p.CFrame=CFrame.lookAt((a+b)/2,b);p.Size=Vector3.new(.08,.08,(b-a).Magnitude)
 end
end
function FX.Message(m:any):boolean
 if FireCast.Message(m,parent) then return true end
 if m.id=="KirinCancel" or m.id=="EntonCancel" then
  for i=#active,1,-1 do local e=active[i]
   if e.caster==m.character and (e.id=="KirinWarning" or e.id=="Kirin" or e.id=="EntonGather" or e.id=="EntonComboWarning" or e.id=="EntonCombo") then e.folder:Destroy();table.remove(active,i) end
  end
  return true
 end
 if m.id=="AreaMove" then
  for _,e in active do if e.extra.areaSerial==m.extra.areaSerial then
   e.moveFrom=m.position;e.moveGoal=m.extra.goal;e.moveAt=m.at;e.moveDuration=math.max(.01,m.duration)
  end end
  return true
 end
 if not handled[m.id] then return false end
 if m.id=="AreaEnd" then
  for i=#active,1,-1 do local e=active[i];if m.extra and e.extra and e.extra.areaSerial==m.extra.areaSerial then e.folder:Destroy();table.remove(active,i) end end
  return true
 end
 if m.id=="Impact" then
  for i=#active,1,-1 do local e=active[i];if e.id=="Projectile" and e.extra.serial==m.extra.serial then e.folder:Destroy();table.remove(active,i) end end
 end
 if m.id=="Extinguish" then return true end -- AreaEnd identifies exactly which server areas were removed.
 local f=Instance.new("Folder");f.Name=m.id;f.Parent=parent
 local e:any={id=m.id,folder=f,caster=m.character,point=m.position,at=m.at or workspace:GetServerTimeNow(),duration=math.max(.1,m.duration or .5),radius=m.radius or 1,extra=m.extra or {},parts={},flames={},clouds={}}
 f:SetAttribute("DamageRadius",e.radius);f:SetAttribute("ServerCentre",e.point)
 f:SetAttribute("ServerStartedAt",e.at);f:SetAttribute("ServerExpiresAt",e.at+e.duration)
 if #active>=64 then active[1].folder:Destroy();table.remove(active,1) end
 table.insert(active,e)
 local r=e.radius;local ground=floor(e.point,e.caster)
 if e.id=="Amaterasu" or e.id=="Fire" or e.id=="EntonCombo" then
  local black=e.id~="Fire";local tint=if black then violet else fire
  ring(e,e.point,r,tint)
  local patch=make(f,"ScorchedArea",Vector3.new(.03,r*1.9,r*1.9),CFrame.new(ground)*CFrame.Angles(0,0,math.pi/2),Color3.fromRGB(14,9,20),.65);patch.Shape=Enum.PartType.Cylinder
  local count=math.clamp(math.floor(r*r*.22),8,24)
  for i=1,count do local angle=i*2.399;local distance=Rules.flameRadius(math.max(.1,r-1.6),i,count)
   local base=floor(e.point+Vector3.new(math.cos(angle),0,math.sin(angle))*distance,e.caster)
   local scale=math.min(2.2,math.max(.65,r*.22))*(.8+(i%4)*.12)
   local core=make(f,"FlameSource",Vector3.one*.15,CFrame.new(base),tint,1)
   Flame.Attach(core,scale,black,false)
   if i%8==0 then Flame.Light(core,scale,black) end
   table.insert(e.flames,{base=base,core=core,scale=scale})
  end
 elseif e.id=="SusanooWave" then
  e.moveFrom=e.point;e.moveGoal=e.extra.finish;e.moveAt=e.at;e.moveDuration=e.duration
  ring(e,e.point,r,violet)
  local dir=e.extra.finish-e.point;local cf=CFrame.lookAt(e.point,e.point+dir)
  for i=1,13 do local x=(i-7)/6
   local offset=cf:VectorToWorldSpace(Vector3.new(x*r,2+5*(1-x*x),-3*(1-x*x)))
   local p=ball(f,"ShockCrest",Vector3.new(2,5,1),e.point+offset,violet,.65);table.insert(e.parts,p)
  end
 elseif e.id=="EntonComboWarning" or e.id=="AmaterasuWarning" then
  ring(e,e.point,r,violet)
 elseif e.id=="EntonGather" then
  ring(e,e.point,r,violet)
  for i=1,12 do local a=i*math.pi/6
   table.insert(e.parts,ball(f,"GravityStream",Vector3.new(.25,.25,2),e.point+Vector3.new(math.cos(a)*r,1,math.sin(a)*r),violet,.35))
  end
 elseif e.id=="KirinWarning" then
  ring(e,e.point,r,blue);dragon(e)
  for i=1,7 do local a=i*2.399
   table.insert(e.clouds,ball(f,"StormCloud",Vector3.new(13,3,10),e.point+Vector3.new(math.cos(a)*r*.45,35+i%3,math.sin(a)*r*.45),Color3.fromRGB(38,51,72),.58))
  end
 elseif e.id=="Kirin" or e.id=="ChibakuImpact" or e.id=="Impact" then
  local tint=if e.id=="Kirin" then blue elseif e.id=="ChibakuImpact" or (e.extra.spell=="EntonMagatama" or e.extra.spell=="EntonWeapon" or e.extra.spell=="EntonArrow") then violet elseif e.extra.spell=="SasukeFireball" or e.extra.spell=="PhoenixFlowers" then fire else blue
  ring(e,e.point,r,tint)
  if e.id=="Kirin" then bolt(f,e.point+Vector3.new(0,45,0),e.point,Color3.fromRGB(221,249,255),.8,3) end
  local fireImpact=e.id=="Impact" and ((e.extra.spell=="EntonMagatama" or e.extra.spell=="EntonWeapon" or e.extra.spell=="EntonArrow") or e.extra.spell=="SasukeFireball" or e.extra.spell=="PhoenixFlowers")
  for i=1,if fireImpact then 0 else 8 do local a=i*math.pi/4
   bolt(f,e.point,e.point+Vector3.new(math.cos(a),.03,math.sin(a))*math.max(.1,r-.8),tint,.13,i)
  end
  e.flash=ball(f,"ImpactCore",Vector3.one*math.min(4,r),e.point,tint,.25)
  if fireImpact then
   e.flash.Transparency=1;Flame.Burst(e.flash,math.clamp(r*.45,1,3.5),(e.extra.spell=="EntonMagatama" or e.extra.spell=="EntonWeapon" or e.extra.spell=="EntonArrow"))
  else
   local light=Instance.new("PointLight");light.Range=math.min(24,r*2);light.Brightness=3;light.Color=tint;light.Parent=e.flash
  end
 elseif e.id=="KirinPrepare" then
  e.rising=ball(f,"SkyFire",Vector3.one*1.8,e.point+Vector3.new(0,2,0),fire,1);Flame.Attach(e.rising,1.7,false,true);Flame.Light(e.rising,1.7,false)
  for i=1,4 do table.insert(e.clouds,ball(f,"GatheringCloud",Vector3.new(8,2,6),e.point+Vector3.new(math.sin(i*2)*7,24,math.cos(i*2)*7),Color3.fromRGB(45,54,73),.7)) end
 elseif e.id=="Projectile" then
  local black=(e.extra.spell=="EntonMagatama" or e.extra.spell=="EntonWeapon" or e.extra.spell=="EntonArrow")
  local fiery=black or e.extra.spell=="SasukeFireball" or e.extra.spell=="PhoenixFlowers"
  local size=if e.extra.spell=="EntonArrow" then 2 elseif e.extra.spell=="EntonWeapon" then 1.5 elseif e.extra.spell=="SasukeFireball" then 3.4 elseif fiery then 1 else .22
  e.body=ball(f,if fiery then "FireballCore" else "LightningNeedle",Vector3.one*size,e.point,if fiery then Color3.fromRGB(255,222,117) else blue,.05)
  e.shell=ball(f,"ProjectileShell",Vector3.one*size*1.3,e.point,if fiery then fire else blue,.5)
  e.tail=line(f,"ProjectileTail",e.point,e.point+Vector3.new(0,0,1),if fiery then fire else blue,if fiery then size*.45 else .12,.55)
  if fiery then
   e.fiery=true;e.flameSize=size
   e.body.Transparency=1;e.shell.Transparency=1;e.tail.Transparency=1
   e.body.Size=Vector3.one*size*.35
   local delta=e.extra.finish-e.point
   if delta.Magnitude>.01 then e.body.CFrame=CFrame.lookAt(e.point,e.extra.finish) end
   local layers=Flame.Attach(e.body,size*.8,black,true)
   for _,v in layers do v:Emit(if v.Name=="FlameTongues" then 12 else 4) end
   e.fireLight=Flame.Light(e.body,size,black)
   if e.extra.spell=="EntonArrow" or e.extra.spell=="EntonWeapon" then
    e.weapon=make(f,"BlackFlameShaft",Vector3.new(.4,.4,if e.extra.spell=="EntonArrow" then 8 else 5),CFrame.new(e.point),Color3.fromRGB(17,7,25),.1)
    e.tip=make(f,"FlameArrowHead",Vector3.new(2,.6,3),CFrame.new(e.point),violet,.3)
    local mesh=Instance.new("SpecialMesh");mesh.MeshType=Enum.MeshType.Wedge;mesh.Parent=e.tip
    Flame.Attach(e.weapon,.7,true,false)
   end
  end
 elseif e.id=="ChibakuDrop" then
  for _,point in e.extra.points do ring(e,point,r,Color3.fromRGB(235,117,150));table.insert(e.parts,ball(f,"FallingCore",Vector3.one*4,point+Vector3.new(0,18,0),Color3.fromRGB(53,46,65),.05)) end
 elseif e.id=="Eiso" then
  bolt(f,e.point,e.extra.finish,blue,.22,1)
  line(f,"LightningSpear",e.point,e.extra.finish,Color3.fromRGB(230,250,255),.12,.1)
 elseif e.id=="Katana" then
  for i=1,6 do table.insert(e.parts,make(f,"SwordLightning",Vector3.new(.045,.045,.7),CFrame.new(e.point),blue,.1)) end
 elseif e.id=="EntonPierce" then
  local lance=line(f,"BlackFlameLance",e.extra.from,e.point,Color3.fromRGB(16,7,27),.65,.25)
  Flame.Attach(lance,.7,true,false)
  line(f,"VioletLanceEdge",e.extra.from,e.point,violet,.85,.75)
 elseif e.id=="Summon" then
  for i=1,9 do local a=i*2.399
   local p=ball(f,"SummonSmoke",Vector3.one*2,e.point+Vector3.new(math.cos(a)*2,i%3*.5,math.sin(a)*2),Color3.fromRGB(202,205,215),.35)
   p.Material=Enum.Material.SmoothPlastic;table.insert(e.parts,p)
  end
 elseif e.id=="Nagashi" or e.id=="EntonPull" then
  ring(e,e.point,r,if e.id=="Nagashi" then blue else violet)
  for i=1,12 do local a=i*math.pi/6
   if e.id=="Nagashi" then bolt(f,e.point,e.point+Vector3.new(math.cos(a)*math.max(.1,r-.6),.5,math.sin(a)*math.max(.1,r-.6)),blue,.1,i)
   else
    local p=make(f,"BlackFlameSpike",Vector3.new(.7,4,.7),CFrame.new(ground+Vector3.new(math.cos(a)*4,1.8,math.sin(a)*4))*CFrame.Angles(math.cos(a)*.4,0,math.sin(a)*.4),Color3.fromRGB(19,8,29),.05)
    local mesh=Instance.new("SpecialMesh");mesh.MeshType=Enum.MeshType.Wedge;mesh.Parent=p
    Flame.Attach(p,.8,true,false)
   end
  end
 elseif e.id=="Transform" then
  -- Vertical chakra, deliberately no ground danger circle for a self buff.
  for i=1,14 do local a=i*2.399
   local p=ball(f,"SusanooChakra",Vector3.new(.5,4,.5),e.point+Vector3.new(math.cos(a)*3,0,math.sin(a)*3),violet,.65)
   table.insert(e.parts,p)
  end
 elseif e.id=="Genjutsu" then
  e.eye=ball(f,"Sharingan",Vector3.new(2,.15,2),e.point+Vector3.new(0,3.5,0),if e.extra.rinnegan then violet else Color3.fromRGB(203,37,55),.25)
  for i=1,3 do local a=i*math.pi*2/3
   ball(f,"Tomoe",Vector3.one*.25,e.eye.Position+Vector3.new(math.cos(a)*.55,.1,math.sin(a)*.55),Color3.fromRGB(10,6,13))
  end
 elseif e.id=="Teleport" then
  for i=1,7 do local a=i*math.pi*2/7;line(f,"SpaceFracture",e.point+Vector3.new(math.cos(a)*2,-2,math.sin(a)*2),e.point+Vector3.new(math.cos(a+.4)*2,3,math.sin(a+.4)*2),violet,.08,.2) end
 end
 return true
end
function FX.Update(now:number)
 FireCast.Update(now)
 for model,e in avatars do if not model.Parent then e.folder:Destroy();avatars[model]=nil end end
 for i=#active,1,-1 do local e=active[i];local t=math.clamp((now-e.at)/e.duration,0,1)
  local h=if e.caster and e.caster.Parent then e.caster:FindFirstChildOfClass("Humanoid") else nil
  if t>=1 or not e.folder.Parent or (e.caster and (not e.caster.Parent or (h and h.Health<=0))) then e.folder:Destroy();table.remove(active,i);continue end
  local tracked=if e.id=="KirinWarning" and e.extra.target and e.extra.target.Parent then e.extra.target:FindFirstChild("HumanoidRootPart") else nil
  if (e.extra.follow and e.caster) or e.moveGoal or tracked then
   local point=if tracked then tracked.Position elseif e.moveGoal then e.moveFrom:Lerp(e.moveGoal,math.clamp((now-e.moveAt)/e.moveDuration,0,1)) else e.caster:GetPivot().Position;local delta=point-e.point
   for _,p in e.folder:GetChildren() do if p:IsA("BasePart") then p.CFrame+=delta end end
   for _,v in e.flames do v.base+=delta end;e.point=point;e.folder:SetAttribute("ServerCentre",point)
  end
  if e.id=="Amaterasu" or e.id=="Fire" or e.id=="EntonCombo" then
   for j,v in e.flames do
    v.core.Position=v.base+Vector3.new(math.sin(now*3+j)*.12,0,math.cos(now*4+j)*.12)
    local light=v.core:FindFirstChildOfClass("PointLight")
    if light then light.Brightness=(if e.id=="Amaterasu" then .4 else 1.5)*(.85+.15*math.sin(now*17+j)) end
   end
  elseif e.id=="KirinWarning" then
   local height=26*(1-t^3)+3
   for _,v in e.dragon do v.part.CFrame=CFrame.new(e.point+Vector3.new(0,height,0))*e.dragonFacing*CFrame.new(v.offset)*(v.rotation or CFrame.identity) end
   for j,p in e.clouds do p.Transparency=.58+math.sin(now*10+j)*.08 end
  elseif e.id=="EntonGather" then
   for j,p in e.parts do local a=j*math.pi/6;local radial=e.radius*(1-t)
    local pos=e.point+Vector3.new(math.cos(a)*radial,1,math.sin(a)*radial);p.CFrame=CFrame.lookAt(pos,e.point);p.Transparency=.3+.5*t
   end
  elseif e.id=="KirinPrepare" then
   local pos=e.point+Vector3.new(0,2+25*math.min(1,t*3),0)
   e.rising.CFrame=CFrame.lookAt(pos,pos+Vector3.yAxis);e.rising.Transparency=1
   for _,v in e.rising:GetChildren() do
    if v:IsA("ParticleEmitter") then v.Enabled=t<.65
    elseif v:IsA("PointLight") then v.Brightness=1.5*(1-t) end
   end
  elseif e.id=="Projectile" then
   local delay=e.extra.delay or 0;t=math.clamp((now-e.at-delay)/math.max(.01,e.duration-delay),0,1)
   local delta=e.extra.finish-e.point;local pos=e.point+delta*t;local dir=if delta.Magnitude>.01 then delta.Unit else Vector3.zAxis
   e.body.CFrame=CFrame.lookAt(pos,pos+dir);e.shell.Position=pos
   if e.weapon then e.weapon.CFrame=e.body.CFrame;e.tip.CFrame=e.body.CFrame*CFrame.new(0,0,-e.weapon.Size.Z/2) end
   if e.fiery then e.fireLight.Brightness=1.5+math.sin(now*23)*.25 end
   local tail=pos-dir*math.min(5,delta.Magnitude*t+1);e.tail.Size=Vector3.new(e.tail.Size.X,e.tail.Size.Y,math.max(.1,(pos-tail).Magnitude));e.tail.CFrame=CFrame.lookAt((pos+tail)/2,pos)
  elseif e.id=="Katana" then
   local hand=e.caster:FindFirstChild("RightHand")
   if hand and hand:IsA("BasePart") then for j,p in e.parts do p.CFrame=hand.CFrame*CFrame.new(.09+math.sin(now*25+j)*.12,-.14,-.6-j*.6)*CFrame.Angles(0,0,math.sin(now*20+j)*.5) end end
  elseif e.id=="Transform" then
   local point=e.caster:GetPivot().Position
   for j,p in e.parts do local a=j*2.399+now*.9;p.Position=point+Vector3.new(math.cos(a)*(3+t*2),((now*2+j*.5)%1)*12,math.sin(a)*(3+t*2));p.Transparency=.5+.3*math.sin(now+j)^2 end
  elseif e.id=="ChibakuDrop" then
   for j,p in e.parts do p.Position=e.extra.points[j]+Vector3.new(0,18*(1-t*t),0) end
  elseif e.id=="Summon" then
   for j,p in e.parts do local a=j*2.399;p.Position=e.point+Vector3.new(math.cos(a)*(2+t*2),j%3*.5+t*1.5,math.sin(a)*(2+t*2));p.Size=Vector3.one*(2+t*2);p.Transparency=.35+.65*t end
  else
   if e.flash then local light=e.flash:FindFirstChildOfClass("PointLight");if light then light.Brightness=3*(1-t)^2 end end
   for _,p in e.folder:GetChildren() do if p:IsA("BasePart") and p.Name~="DamageBoundary" then p.Transparency=math.max(p.Transparency,t) end end
  end
 end
end
return FX
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="303">
            <Properties>
              <string name="Name">SasukeVFXController</string>
              <string name="Source"><![CDATA[--!strict
local Run=game:GetService("RunService")
local Shared=game.ReplicatedStorage:WaitForChild("Shared")
local Data=require(Shared.Config.SasukeParticleData) :: any
local Spells=require(script.Parent.SasukeSpellEffects)
local Presentation=require(Shared.Abilities.SasukePresentation)
local V={}
local effects:{any}={}
local held:{[Model]:Folder}={}
local swordTrails:{[Model]:{trail:Trail,base:Attachment,tip:Attachment}}={}
local models:{[Model]:boolean}={}
local folder:Folder
local function part(parent:Instance,name:string,color:Color3,size:Vector3,cf:CFrame):Part
 local p=Instance.new("Part");p.Name=name;p.Size=size;p.CFrame=cf;p.Color=color;p.Anchored=true;p.Material=Enum.Material.Neon;p.CanCollide=false;p.CanTouch=false;p.CanQuery=false;p.CastShadow=false;p.Parent=parent;return p
end
local function particles(parent:Instance,kind:string)
 for i,s in Data[kind] or {} do
  if i>4 then break end
  local p=Instance.new("ParticleEmitter");p.Name=s.name;p.Texture=s.texture
  local colors={};for _,v in s.color do table.insert(colors,ColorSequenceKeypoint.new(v[1],Color3.new(v[2],v[3],v[4]))) end
  local sizes={};for _,v in s.size do table.insert(sizes,NumberSequenceKeypoint.new(v[1],math.min(v[2],2),math.min(v[3],.3))) end
  local transparency={};for _,v in s.transparency do table.insert(transparency,NumberSequenceKeypoint.new(v[1],v[2],v[3])) end
  p.Color=ColorSequence.new(colors);p.Size=NumberSequence.new(sizes);p.Transparency=NumberSequence.new(transparency)
  p.Lifetime=NumberRange.new(math.min(s.lifetime[1],.4),math.min(s.lifetime[2],.7));p.Speed=NumberRange.new(0,math.min(s.speed[2],2))
  p.Rate=math.min(s.rate,25);p.LightEmission=s.light;p.SpreadAngle=Vector2.new(s.spread[1],s.spread[2]);p.Parent=parent
 end
end
local function lightning(parent:Instance,a:Vector3,b:Vector3,color:Color3,seed:number)
 local delta=b-a
 for i=1,9 do
  local x=(i-1)/9;local y=i/9
  local function at(t:number):Vector3 return a+delta*t+Vector3.new(math.sin(t*73+seed),math.cos(t*49+seed),0)*math.sin(t*math.pi)*.5 end
  local first,last=at(x),at(y);part(parent,"Lightning",color,Vector3.new(.09,.09,(last-first).Magnitude),CFrame.lookAt((first+last)/2,last))
 end
end
function V.Message(message:any)
 if message.kind~="Sasuke" or typeof(message.position)~="Vector3" then return end
 if message.id=="AreaEnd" or message.id=="FireEnd" then Spells.Message(message);return end
 local camera=workspace.CurrentCamera;if camera and (camera.CFrame.Position-message.position).Magnitude>300 then return end
 if message.id=="ChibakuDrop" then
  for i=#effects,1,-1 do local e=effects[i];if e.id=="Chibaku" and e.caster==message.character then e.folder:Destroy();table.remove(effects,i) end end
 end
 if Spells.Message(message) then return end
 if #effects>=48 then effects[1].folder:Destroy();table.remove(effects,1) end
 local id=message.id;local radius=math.clamp(message.radius or 1,.1,125)
 if id=="Extinguish" then
  for i=#effects,1,-1 do local e=effects[i];if e.id=="Amaterasu" and (e.point-message.position).Magnitude<=radius then e.folder:Destroy();table.remove(effects,i) end end;return
 end
 if id=="ChibakuMove" then
  for _,e in effects do if e.id=="Chibaku" and e.caster==message.character then
   e.moveAt=workspace:GetServerTimeNow();e.moveDuration=message.duration;e.movePoints=message.extra.points;e.moveFrom={}
   for i,p in e.parts do e.moveFrom[i]=p.Position end
  end end;return
 end
 if id=="ChibakuEnd" or id=="ChibakuDrop" or id=="Chibaku" then
  for i=#effects,1,-1 do local e=effects[i];if e.caster==message.character and e.id=="Chibaku" then e.folder:Destroy();table.remove(effects,i) end end
 end
 if id=="ChibakuEnd" then return end
 local f=Instance.new("Folder");f.Name=id;f.Parent=folder
 if id=="Impact" and message.extra then for i=#effects,1,-1 do local e=effects[i];if e.id=="Projectile" and e.extra and e.extra.serial==message.extra.serial then e.folder:Destroy();table.remove(effects,i) end end end
 local color=if id=="Amaterasu" then Color3.fromRGB(40,13,66) elseif id=="Fire" or (message.extra and (message.extra.spell=="SasukeFireball" or message.extra.spell=="PhoenixFlowers")) then Color3.fromRGB(255,125,30) else Color3.fromRGB(144,113,255)
 local parts={};local origin=message.position
 if id=="Projectile" then
  local p=part(f,"Projectile",color,Vector3.one*math.min(radius*2,4),CFrame.new(origin));p.Shape=Enum.PartType.Ball;table.insert(parts,p)
  local light=Instance.new("PointLight");light.Color=color;light.Range=10;light.Brightness=2;light.Parent=p
 elseif id=="Eiso" then lightning(f,origin,message.extra.finish,Color3.fromRGB(170,230,255),os.clock())
 elseif id=="ChidoriHit" then
  local direction=if message.extra and typeof(message.extra.direction)=="Vector3" then message.extra.direction else Vector3.zAxis
  local frame=CFrame.lookAt(origin,origin+direction)
  local tint=if message.extra and message.extra.variant=="OnyxChidori" then Color3.fromRGB(178,117,255) elseif message.extra and message.extra.variant=="AmaterasuChidori" then Color3.fromRGB(113,61,167) else Color3.fromRGB(154,225,255)
  local flash=part(f,"ContactFlash",Color3.fromRGB(232,250,255),Vector3.one*.85,CFrame.new(origin));flash.Shape=Enum.PartType.Ball;table.insert(parts,flash)
  local light=Instance.new("PointLight");light.Color=tint;light.Range=9;light.Brightness=4;light.Parent=flash
  for i=1,9 do
   local angle=i*2.399
   local offset=frame:VectorToWorldSpace(Vector3.new(math.cos(angle)*1.5,math.sin(angle)*1.5,-(1+i%3)*.7))
   lightning(f,origin,origin+offset,tint,i*3.1)
  end
  local caster=message.character;local hand=if caster then caster:FindFirstChild("LeftHand") else nil
  if hand and hand:IsA("BasePart") then lightning(f,hand.Position,origin,tint,1) end
  particles(flash,"Chidori")
  for _,emitter in flash:GetChildren() do if emitter:IsA("ParticleEmitter") then emitter.Enabled=false;emitter:Emit(12) end end
 elseif id=="Kirin" then
  lightning(f,origin+Vector3.new(0,65,0),origin,Color3.fromRGB(160,218,255),os.clock())
  local p=part(f,"LightningDome",Color3.fromRGB(150,210,255),Vector3.one*radius*2,CFrame.new(origin));p.Shape=Enum.PartType.Ball;p.Transparency=.7;table.insert(parts,p)
 elseif id=="Chibaku" then
  for _,point in message.extra.points do local p=part(f,"GravityCore",Color3.fromRGB(25,20,37),Vector3.one*3,CFrame.new(point));p.Shape=Enum.PartType.Ball;table.insert(parts,p) end
 elseif id=="ChibakuDrop" then
  for _,point in message.extra.points do local p=part(f,"FallingCore",Color3.fromRGB(63,55,71),Vector3.one*4,CFrame.new(point+Vector3.new(0,18,0)));p.Shape=Enum.PartType.Ball;table.insert(parts,p) end
 elseif id=="ChibakuMove" then
  for _,point in message.extra.points do local p=part(f,"GravityCore",Color3.fromRGB(25,20,37),Vector3.one*3,CFrame.new(point+Vector3.new(0,18,0)));p.Shape=Enum.PartType.Ball;table.insert(parts,p) end
 else
  local ring=part(f,"ExactArea",color,Vector3.new(.08,radius*2,radius*2),CFrame.new(origin+Vector3.new(0,.08,0))*CFrame.Angles(0,0,math.pi/2));ring.Shape=Enum.PartType.Cylinder;ring.Transparency=.7;table.insert(parts,ring)
  if id=="Amaterasu" or id=="Fire" then
   for i=1,18 do local angle=i*2.399;local r=radius*math.sqrt(i/19)
    local p=part(f,"Flame",color,Vector3.new(.5,2.5,.5),CFrame.new(origin+Vector3.new(math.cos(angle)*r,1,math.sin(angle)*r)));p.Transparency=.15;table.insert(parts,p)
    if id=="Amaterasu" and i<=4 then particles(p,"Amaterasu") end
   end
  elseif id=="Nagashi" or id=="Counter" then
   for i=1,8 do local angle=i*math.pi/4;lightning(f,origin,origin+Vector3.new(math.cos(angle),0,math.sin(angle))*radius,Color3.fromRGB(170,235,255),i) end
  end
 end
 table.insert(effects,{folder=f,id=id,point=origin,at=message.at or workspace:GetServerTimeNow(),duration=math.clamp(message.duration or .5,.1,30),parts=parts,extra=message.extra,caster=message.character})
end
function V.Start()
 folder=Instance.new("Folder");folder.Name="LocalSasukeVFX";folder.Parent=workspace
 Spells.Start(folder,models)
 local remote=game.ReplicatedStorage:WaitForChild("HeroAbility") :: RemoteEvent
 remote.OnClientEvent:Connect(V.Message)
 local function add(item:Instance) if item:IsA("Humanoid") and item.Parent and item.Parent:IsA("Model") then models[item.Parent]=true end end
 for _,item in workspace:GetDescendants() do add(item) end
 workspace.DescendantAdded:Connect(add);workspace.DescendantRemoving:Connect(function(item) if item:IsA("Humanoid") and item.Parent and item.Parent:IsA("Model") then models[item.Parent]=nil end end)
 Run.RenderStepped:Connect(function()
  local now=workspace:GetServerTimeNow()
  Spells.Update(now)
  for model in models do
   if not model.Parent then models[model]=nil;continue end
   if model:GetAttribute("HeroId")~="Sasuke" then continue end
   Spells.Avatar(model,now)
   local hand=model:FindFirstChild("LeftHand") or model:FindFirstChild("RightHand")
   local variant=model:GetAttribute("ChidoriVariant")
   if variant=="SusanooChidori" then local costume=model:FindFirstChild("DisplayedHeroAppearance");hand=if costume then costume:FindFirstChild("Larm2") or hand else hand end
   local active=model:GetAttribute("ChidoriHeld")==true or ((model:GetAttribute("ChidoriStrikeUntil") or 0) :: number)>now
   if active and hand and hand:IsA("BasePart") then
    local f=held[model]
    if not f then
     f=Instance.new("Folder");f.Name="ChidoriHeld";f.Parent=folder;held[model]=f
     local orb=part(f,"Core",Color3.fromRGB(213,245,255),Vector3.one*.45,hand.CFrame);orb.Shape=Enum.PartType.Ball;particles(orb,"Chidori")
     local light=Instance.new("PointLight");light.Color=Color3.fromRGB(130,205,255);light.Brightness=2;light.Range=8;light.Parent=orb
     for _=1,12 do part(f,"Arc",Color3.fromRGB(144,215,255),Vector3.one*.1,hand.CFrame) end
    end
    local index=0
    for _,p in f:GetChildren() do if p:IsA("BasePart") then
     if p.Name=="Core" then p.CFrame=hand.CFrame;p.Size=Vector3.one*(if variant=="SusanooChidori" then 1.8 else .45);p.Color=if variant=="OnyxChidori" then Color3.fromRGB(155,80,255) elseif variant=="AmaterasuChidori" then Color3.fromRGB(47,15,77) else Color3.fromRGB(213,245,255) else index+=1;local a=now*17+index*2.399
      local endPoint=hand.Position+Vector3.new(math.sin(a),math.cos(a*1.3),math.cos(a))*(if variant=="SusanooChidori" then 3 else 1.1)
      p.Size=Vector3.new(.045,.045,(endPoint-hand.Position).Magnitude);p.CFrame=CFrame.lookAt((endPoint+hand.Position)/2,endPoint)
     end
    end end
   elseif held[model] then held[model]:Destroy();held[model]=nil end
   local appearance=model:FindFirstChild("DisplayedHeroAppearance")
   local root=model:FindFirstChild("HumanoidRootPart")
   local attackAt=(model:GetAttribute("CombatLastAttackAt") or 0) :: number
   local swordHand=model:FindFirstChild("RightHand")
   if swordHand and swordHand:IsA("BasePart") and not swordTrails[model] then
    local base=Instance.new("Attachment");base.Name="SasukeSwordTrailBase";base.Position=Vector3.new(.088,-.144,-.6);base.Parent=swordHand
    local tip=Instance.new("Attachment");tip.Name="SasukeSwordTrailTip";tip.Position=Vector3.new(.088,-.144,-4.5);tip.Parent=swordHand
    local trail=Instance.new("Trail");trail.Name="SwordArc";trail.Attachment0=base;trail.Attachment1=tip;trail.Lifetime=.12;trail.MinLength=.06
    trail.Color=ColorSequence.new(Color3.fromRGB(180,216,245));trail.Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,.65),NumberSequenceKeypoint.new(1,1)})
    trail.LightEmission=.4;trail.FaceCamera=true;trail.Enabled=false;trail.Parent=swordHand
    swordTrails[model]={trail=trail,base=base,tip=tip}
   end
   local sword=swordTrails[model]
   if sword then
    local ends=(model:GetAttribute("CombatAttackEndsAt") or 0) :: number
    local phase=(now-attackAt)/math.max(.001,ends-attackAt)
    sword.trail.Enabled=not active and ((model:GetAttribute("SusanooForm") or 0) :: number)<3 and phase>.12 and phase<.7 and now<ends
   end
   if appearance and root and root:IsA("BasePart") then for _,p in appearance:GetChildren() do
    if p:IsA("BasePart") and p:GetAttribute("CosmeticBody")=="RightHand" then
     local offset=p:GetAttribute("CosmeticOffset");local handPart=model:FindFirstChild("RightHand")
     if typeof(offset)=="CFrame" and handPart and handPart:IsA("BasePart") then
      local weld=p:FindFirstChild("FormVisualWeld");if weld then weld:Destroy() end;p.Anchored=true
      local casting=((model:GetAttribute("SasukeCastPoseUntil") or 0) :: number)>now and model:GetAttribute("SasukeCastPose")~="ChidoriKatana"
      local grip=if casting then root.CFrame*CFrame.new(1,-.7,.8)*CFrame.Angles(0,math.pi/2,.12) else handPart.CFrame
      p.CFrame=grip*offset
     end
    end
    if p:IsA("BasePart") and p:GetAttribute("GarudaWing") then
     local w=p:FindFirstChild("FormVisualWeld");local offset=p:GetAttribute("CosmeticOffset")
     if typeof(offset)=="CFrame" then
      if w then w:Destroy() end;p.Anchored=true
      p.CFrame=root.CFrame*CFrame.new(0,-4,0)*CFrame.Angles(0,0,math.sin(now*7)*.35*(p:GetAttribute("GarudaWing") :: number))*CFrame.new(0,4,0)*offset
     end
    end
    if p:IsA("BasePart") and p:GetAttribute("SusanooChakra")==true then
    local w=p:FindFirstChild("FormVisualWeld");local offset=p:GetAttribute("CosmeticOffset")
    if typeof(offset)=="CFrame" then
     -- Animate the displayed cosmetic copy, never the server character assembly.
     if w then w:Destroy() end;p.Anchored=true
     local ends=(model:GetAttribute("CombatAttackEndsAt") or 0) :: number
     local hit=(model:GetAttribute("CombatAttackHitAt") or 0) :: number
     local duration=math.max(.001,ends-attackAt)
     local phase=(now-attackAt)/duration;local swing=Presentation.susanooSwing(phase,(hit-attackAt)/duration)
     local pivot=p:GetAttribute("SusanooPivot")
     local side=if p:GetAttribute("SusanooLimb")=="Right" then 1 else -1
     local angle=if side==1 then swing*1.25 else swing*.3
     p.CFrame=root.CFrame*(if typeof(pivot)=="Vector3" then CFrame.new(pivot)*CFrame.Angles(angle,0,-side*swing*.2)*CFrame.new(-pivot)*offset else offset)
    end
   end end end
  end
  for model,f in held do if not models[model] then f:Destroy();held[model]=nil end end
  for model,sword in swordTrails do if not models[model] then sword.trail:Destroy();sword.base:Destroy();sword.tip:Destroy();swordTrails[model]=nil end end
  for i=#effects,1,-1 do local e=effects[i];local progress=(now-e.at)/e.duration
   if progress>=1 or not e.folder.Parent or (e.caster and not e.caster.Parent) then e.folder:Destroy();table.remove(effects,i);continue end
   if e.id=="ChidoriHit" then
    for _,p in e.folder:GetChildren() do if p:IsA("BasePart") then
     p.Transparency=math.clamp(progress*1.8,0,1)
     local light=p:FindFirstChildOfClass("PointLight");if light then light.Brightness=4*(1-progress) end
    end end
   end
   if e.extra and e.extra.follow and e.caster and e.caster.Parent then
    local point=e.caster:GetPivot().Position;local delta=point-e.point
    for _,p in e.folder:GetChildren() do if p:IsA("BasePart") then p.CFrame+=delta end end;e.point=point
   end
   for j,p in e.parts do
    if e.id=="Projectile" and e.extra then p.Position=e.point:Lerp(e.extra.finish,math.clamp(progress,0,1))
    elseif e.id=="Chibaku" and e.moveAt then p.Position=e.moveFrom[j]:Lerp(e.movePoints[j]+Vector3.new(0,18,0),math.clamp((now-e.moveAt)/math.max(.01,e.moveDuration),0,1))
    elseif e.id=="Chibaku" then p.Position=e.extra.points[j]+Vector3.new(0,18*math.clamp((now-e.at)/(e.extra.rise or 2),0,1),0)
    elseif e.id=="ChibakuDrop" then p.Position=e.extra.points[j]+Vector3.new(0,18*(1-progress),0)
    elseif e.id=="Amaterasu" or e.id=="Fire" then if j>1 then p.Size=Vector3.new(.5,1.5+math.sin(now*13+j)^2*2,.5) end
    elseif e.id~="Chibaku" and e.id~="ChibakuMove" then p.Transparency=math.max(p.Transparency,progress) end
   end
  end
 end)
 require(script.Parent.RoundController).Watch(function() Spells.Clear();for _,e in effects do e.folder:Destroy() end;table.clear(effects) end)
end
return V
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="304">
            <Properties>
              <string name="Name">SurvivalHUDController</string>
              <string name="Source"><![CDATA[--!strict
local Players=game:GetService("Players")
local RS=game:GetService("ReplicatedStorage")
local RunService=game:GetService("RunService")
local Shared=RS:WaitForChild("Shared")
local Minions=require(Shared.Config.MinionConfig)
local VFX=require(script.Parent.VFXController)
local Rounds=require(script.Parent.RoundController)
local View=require(script.Parent.MobaHUDView)
local Layout=require(script.Parent.HUDLayout)
local HUD={}
local started=false
function HUD.Start()
	if started then return end; started=true
	task.spawn(function()
		local state=RS:WaitForChild("SurvivalState",30); if not state then return end
		local player=Players.LocalPlayer
		local gui=Instance.new("ScreenGui"); gui.Name="SurvivalHUD"; gui.ResetOnSpawn=false; gui.DisplayOrder=5
		gui.ScreenInsets=Enum.ScreenInsets.None; gui.Parent=player:WaitForChild("PlayerGui")
		local panel=View.frame(gui,"MatchPanel",UDim2.fromOffset(Layout.TopWidth,Layout.TopHeight),UDim2.new(.5,0,0,0)); panel.AnchorPoint=Vector2.new(.5,0)
		local scale=Instance.new("UIScale"); scale.Parent=panel
		local clock=View.label(panel,"Clock",UDim2.fromOffset(140,20),UDim2.fromOffset(390,25),15)
		local score=View.label(panel,"Score",UDim2.fromOffset(140,27),UDim2.fromOffset(390,0),23); score.TextColor3=View.Gold
		local status=View.label(gui,"Status",UDim2.fromOffset(460,25),UDim2.new(.5,0,0,82),14); status.AnchorPoint=Vector2.new(.5,0); status.TextColor3=View.Gold
		local slots: { {frame: Frame,portrait: View.Portrait,name: TextLabel,condition: TextLabel,shade: Frame,team: string,index: number} }={}
		for side,team in {"Blue","Red"} do
			for index=1,5 do
				local x=if side==1 then (index-1)*76+4 else 536+(index-1)*76
				local cell=View.frame(panel,team..index,UDim2.fromOffset(72,46),UDim2.fromOffset(x,0)); View.border(cell,if side==1 then Color3.fromRGB(81,151,112) else Color3.fromRGB(186,82,74))
				local portrait=View.portrait(cell,UDim2.fromOffset(70,44),UDim2.fromOffset(1,0))
				local shade=View.frame(cell,"Dead",UDim2.fromOffset(70,44),UDim2.fromOffset(1,0)); shade.BackgroundTransparency=.35; shade.Visible=false
				local condition=View.label(cell,"Condition",UDim2.fromOffset(70,22),UDim2.fromOffset(1,11),11); condition.ZIndex=3
				local name=View.label(cell,"Player",UDim2.fromOffset(70,13),UDim2.fromOffset(1,30),9)
				table.insert(slots,{frame=cell,portrait=portrait,name=name,condition=condition,shade=shade,team=team,index=index})
			end
		end
		local ending=View.frame(gui,"Result",UDim2.fromOffset(420,140),UDim2.fromScale(.5,.38)); ending.AnchorPoint=Vector2.new(.5,.5); ending.Visible=false; View.border(ending,View.Gold)
		local endingScale=Instance.new("UIScale"); endingScale.Parent=ending
		local result=View.label(ending,"ResultText",UDim2.new(1,-24,0,58),UDim2.fromOffset(12,16),30)
		local explanation=View.label(ending,"Explanation",UDim2.new(1,-24,0,42),UDim2.fromOffset(12,80),14); explanation.TextWrapped=true
		local notice=View.label(gui,"TowerNotice",UDim2.fromOffset(500,28),UDim2.new(.5,0,0,112),14); notice.AnchorPoint=Vector2.new(.5,0); notice.TextColor3=View.Gold
		local noticeUntil=0
		Rounds.Watch(function() noticeUntil=0; notice.Visible=false end)
		local towerEvents=state:WaitForChild("TowerEvent") :: RemoteEvent
		towerEvents.OnClientEvent:Connect(function(kind: string,_model: Model,_origin: Vector3,_destination: Vector3,id: string,_lane: string,epoch: number)
			if not Rounds.Accepts(epoch) then return end
			if kind=="Destroyed" then notice.Text=if id==player:GetAttribute("TeamId") then "Ваша башня разрушена" else "Вражеская башня разрушена"; noticeUntil=os.clock()+4 end
		end)
		local nextUpdate=0
		RunService.Heartbeat:Connect(function()
			local now=workspace:GetServerTimeNow(); if now<nextUpdate then return end; nextUpdate=now+.2
			local phase=state:GetAttribute("Phase"); local finished=phase=="Finished"
			local start=state:GetAttribute("StartedAt"); local finish=state:GetAttribute("FinishedAt")
			local elapsed=if typeof(start)=="number" and start>0 then math.max(0,(if finished and typeof(finish)=="number" then finish else now)-start) else 0
			clock.Text=string.format("%02d:%02d",math.floor(elapsed/60),math.floor(elapsed%60))
			local members: {[string]: {Player}}={Blue={},Red={}}
			for _,member in Players:GetPlayers() do
				local id=member:GetAttribute("TeamId")
				if typeof(id)=="string" and members[id] and member:GetAttribute("Spectating")~=true then
					table.insert(members[id],member)
				end
			end
			for _,team in members do table.sort(team,function(a: Player,b: Player) return a.UserId<b.UserId end) end
			local blue=state:FindFirstChild("Blue"); local red=state:FindFirstChild("Red")
			score.Text=string.format("%d   :   %d",if blue then (blue:GetAttribute("Kills") or 0) :: number else 0,if red then (red:GetAttribute("Kills") or 0) :: number else 0)
			for _,slot in slots do
				local member=members[slot.team][slot.index]; local model=if member then member.Character else nil
				View.updatePortrait(slot.portrait,model)
				slot.name.Text=if member then member.DisplayName else "Пусто"
				local humanoid=if model then model:FindFirstChildOfClass("Humanoid") else nil
				local dead=member~=nil and (not humanoid or humanoid.Health<=0)
				slot.shade.Visible=dead; slot.condition.Text=if not member then "—" elseif dead then "Погиб" else ""
			end
			status.Text=if phase=="WaitingForPlayers" then "Ожидание игроков" elseif phase=="Preparing" then "Начало через "..math.max(0,math.ceil((state:GetAttribute("PreparationEnds") :: number)-now)) elseif not finished and player:GetAttribute("Spectating")==true then "Наблюдение" else ""
			ending.Visible=finished
			local winner=state:GetAttribute("Winner"); local team=player:GetAttribute("TeamId")
			result.Text=if winner==team then "ПОБЕДА" elseif typeof(team)=="string" then "ПОРАЖЕНИЕ" else "МАТЧ ЗАВЕРШЁН"
			result.TextColor3=if winner==team then Color3.fromRGB(127,192,111) else View.Gold
			local winningTeam=if typeof(winner)=="string" then state:FindFirstChild(winner) else nil
			explanation.Text=if winningTeam then tostring(winningTeam:GetAttribute("DisplayName")).."\n"..(if winner==team then "Вражеский трон разрушен" elseif typeof(team)=="string" then "Ваш трон разрушен" else "Трон разрушен") else "Трон разрушен"
			notice.Visible=not finished and os.clock()<noticeUntil
			local camera=workspace.CurrentCamera
			if camera then
				local width=camera.ViewportSize.X; scale.Scale=Layout.scale(width,camera.ViewportSize.Y); endingScale.Scale=math.min(1,(width-24)/420)
				status.Position=UDim2.new(.5,0,0,Layout.TopHeight*scale.Scale+7); status.Size=UDim2.fromOffset(math.min(460,width-16),25)
				notice.Position=UDim2.new(.5,0,0,Layout.TopHeight*scale.Scale+35); notice.Size=UDim2.fromOffset(math.min(500,width-16),28)
			end
		end)
		local shots=state:WaitForChild("MinionShot") :: RemoteEvent
		shots.OnClientEvent:Connect(function(origin: Vector3,destination: Vector3,kind: string,id: string,target: Model,epoch: number)
			if not Rounds.Accepts(epoch) then return end
			local team=state:FindFirstChild(id); local color=if team then team:GetAttribute("Color") else Color3.new(1,1,1)
			if kind=="Ranged" then VFX.Projectile(origin,destination,color :: Color3,Minions.ProjectileDuration) end
			if target and target.Parent then VFX.Hit(target,destination,false) end
		end)
	end)
end
return HUD
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="305">
            <Properties>
              <string name="Name">TowerVFXController</string>
              <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Config = require(ReplicatedStorage:WaitForChild("Shared").Config.TowerConfig)
local Rounds = require(script.Parent.RoundController)
type Effect = { object: BasePart, tween: Tween, endsAt: number }
local Controller = {}
local started = false
local effects: { Effect } = {}
local function remove(index: number)
	local effect = effects[index]; effect.tween:Cancel(); effect.object:Destroy(); table.remove(effects, index)
end
function Controller.GetActiveCount(): number return #effects end
function Controller.Start()
	if started then return end; started = true
	Rounds.Watch(function() for i = #effects, 1, -1 do remove(i) end end)
	task.spawn(function()
		local state = ReplicatedStorage:WaitForChild("SurvivalState", 30); if not state then return end
		local event = state:WaitForChild("TowerEvent") :: RemoteEvent
		local folder = Instance.new("Folder"); folder.Name = "LocalTowerVFX"; folder.Parent = workspace
		event.OnClientEvent:Connect(function(kind: string, _model: Model, origin: Vector3, destination: Vector3, teamId: string, _lane: string, roundId: number)
			if not Rounds.Accepts(roundId) then return end
			local camera = workspace.CurrentCamera
			if camera and (origin - camera.CFrame.Position).Magnitude > Config.Visual.ViewDistance then return end
			while #effects >= Config.Visual.MaxEffects do remove(1) end
			local team = state:FindFirstChild(teamId)
			local color = if team then team:GetAttribute("Color") else Color3.new(1, 1, 1)
			local object = Instance.new("Part"); object.Name = "Tower" .. kind; object.Shape = Enum.PartType.Ball
			object.Anchored = true; object.CanCollide = false; object.CanQuery = false; object.CanTouch = false; object.CastShadow = false
			object.Material = Enum.Material.Neon; object.Color = color :: Color3; object.Position = origin
			object.Size = Vector3.one * (if kind == "Destroyed" then 3 else 0.85); object.Parent = folder
			local duration = if kind == "Destroyed" then Config.Visual.RuinFlashLifetime else Config.Visual.ProjectileDuration
			local tween = TweenService:Create(object, TweenInfo.new(duration, Enum.EasingStyle.Quad), {
				Position = destination, Size = Vector3.one * (if kind == "Destroyed" then 12 else 0.25), Transparency = 1,
			})
			table.insert(effects, { object = object, tween = tween, endsAt = os.clock() + duration }); tween:Play()
		end)
		RunService.PreRender:Connect(function()
			for index = #effects, 1, -1 do if os.clock() >= effects[index].endsAt then remove(index) end end
			local map = workspace:FindFirstChild("Map"); local towers = if map then map:FindFirstChild("Towers") else nil
			if not towers then return end
			local now = workspace:GetServerTimeNow()
			for _, model in towers:GetChildren() do
				if model:GetAttribute("ManagedTower") ~= true then continue end
				local crystal = model:FindFirstChild("Crystal")
				if not crystal or not crystal:IsA("BasePart") then continue end
				local light = crystal:FindFirstChildOfClass("PointLight")
				local charging = model:GetAttribute("TowerState") == "Charging"
				local chargeEnd = (model:GetAttribute("ChargeEndsAt") or 0) :: number
				local progress = if charging then math.clamp(1 - (chargeEnd - now) / Config.Windup, 0, 1) else 0
				crystal.Size = Vector3.one * (((model:GetAttribute("CrystalSize") or 2.6) :: number) + progress * 1.5)
				if light then light.Brightness = 0.8 + progress * 5 end
			end
		end)
	end)
end
return Controller
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="306">
            <Properties>
              <string name="Name">VFXController</string>
              <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config.VFXConfig)
local Debug = require(Shared.Config.DebugConfig)
local Rounds = require(script.Parent.RoundController)

type Effect = { object: Instance, expiresAt: number, tweens: { Tween } }
local VFXController = {}
local effects: { Effect } = {}
local debugEffects: { Effect } = {}
local folder: Folder? = nil
local started = false
local shakeEnabled = Config.CameraShakeEnabled
local shakeUntil = 0
local shakeDuration = 0
local shakeAmplitude = 0
local shakeHumanoid: Humanoid? = nil
local cameraOffset = Vector3.zero
local lastHitSound = 0

local function dispose(effect: Effect)
	for _, tween in effect.tweens do tween:Cancel() end
	effect.object:Destroy()
end
function VFXController.Clear()
	for _, effect in effects do dispose(effect) end; table.clear(effects)
	for _, effect in debugEffects do dispose(effect) end; table.clear(debugEffects)
	shakeUntil = 0; shakeAmplitude = 0
	if shakeHumanoid and shakeHumanoid.Parent then shakeHumanoid.CameraOffset = Vector3.zero end
	shakeHumanoid = nil; cameraOffset = Vector3.zero
end
Rounds.Watch(VFXController.Clear)

local function remember(object: Instance, lifetime: number, tweens: { Tween }, debugEffect: boolean?)
	local list = if debugEffect then debugEffects else effects
	local limit = if debugEffect then Debug.MaxDebugHitboxes else Config.MaxEffects
	while #list >= limit do
		local oldest = table.remove(list, 1)
		if oldest then dispose(oldest) end
	end
	table.insert(list, { object = object, expiresAt = os.clock() + lifetime, tweens = tweens })
end

local function part(name: string, position: Vector3, size: Vector3, color: Color3): Part
	local object = Instance.new("Part")
	object.Name = name
	object.Anchored = true
	object.CanCollide = false
	object.CanQuery = false
	object.CanTouch = false
	object.CastShadow = false
	object.Material = Enum.Material.Neon
	object.Color = color
	object.Size = size
	object.Position = position
	return object
end

function VFXController.Swing(character: Model, step: number)
 if character:GetAttribute("CombatProfileId")=="Kurama" then return end -- Fox claw trails follow the authoritative articulated paw.
	local handName = if step % 2 == 0 then "LeftHand" else "RightHand"
	local hand = character:FindFirstChild(handName) or character:FindFirstChild("Right Arm")
	if not hand then return end
	local glow = Instance.new("Highlight")
	glow.Name = "PredictedSwingCue"
	glow.Adornee = hand
	glow.DepthMode = Enum.HighlightDepthMode.Occluded
	glow.FillColor = Config.NormalColor
	glow.FillTransparency = 0.45
	glow.OutlineTransparency = 1
	glow.Parent = folder
	remember(glow, Config.SwingLifetime, {})
end

function VFXController.Projectile(origin: Vector3, destination: Vector3, color: Color3, duration: number)
	local shot = part("MinionProjectile", origin, Vector3.one * 0.45, color)
	shot.Shape = Enum.PartType.Ball; shot.Parent = folder
	local tween = TweenService:Create(shot, TweenInfo.new(duration, Enum.EasingStyle.Linear), { Position = destination })
	tween:Play(); remember(shot, duration, { tween })
end

function VFXController.Hit(character: Model, position: Vector3, heavy: boolean)
	local lifetime = if heavy then Config.HeavyLifetime else Config.HitLifetime
	local color = if heavy then Config.HeavyColor else Config.NormalColor
	local group = Instance.new("Folder")
	group.Name = "ConfirmedHit"
	group.Parent = folder
	local tweens: { Tween } = {}
	local sphere = part("Flash", position, Vector3.one * Config.HitSize, color)
	sphere.Shape = Enum.PartType.Ball
	sphere.Parent = group
	local flashTween = TweenService:Create(sphere, TweenInfo.new(lifetime), {
		Size = Vector3.one * (if heavy then Config.HeavyExpansion else Config.HitExpansion), Transparency = 1,
	})
	table.insert(tweens, flashTween)
	flashTween:Play()
	local reaction = Instance.new("Highlight")
	reaction.Adornee = character
	reaction.DepthMode = Enum.HighlightDepthMode.Occluded
	reaction.FillColor = Config.ReactionColor
	reaction.FillTransparency = 0.65
	reaction.OutlineTransparency = 1
	reaction.Parent = group
	for index = 1, Config.SparkCount do
		local angle = (index / Config.SparkCount) * math.pi * 2
		local direction = Vector3.new(math.cos(angle), math.sin(angle), 0)
		local spark = part("Spark", position, Vector3.new(0.06, 0.06, Config.SparkLength), color)
		spark.CFrame = CFrame.lookAt(position, position + direction)
		spark.Parent = group
		local tween = TweenService:Create(spark, TweenInfo.new(lifetime), {
			Position = position + direction * Config.SparkTravel, Transparency = 1,
		})
		table.insert(tweens, tween)
		tween:Play()
	end
	remember(group, lifetime, tweens)
end

-- Only the server's Damage.Applied path sends these messages. Predicted swings
-- never create numbers, hit markers, impact sound or camera feedback.
function VFXController.DamageFeedback(message: any)
	if typeof(message.amount) ~= "number" or message.amount <= 0 or typeof(message.position) ~= "Vector3" then return end
	local target = message.target
	if typeof(target) ~= "Instance" or not target:IsA("Model") then return end
	local camera = workspace.CurrentCamera
	if camera and (camera.CFrame.Position-message.position).Magnitude > 240 then return end
	local anchor = part("ConfirmedDamage", message.position+Vector3.new(0,2,0), Vector3.one*.1, Config.NormalColor)
	anchor.Transparency = 1; anchor.Parent = folder
	local gui = Instance.new("BillboardGui"); gui.Size = UDim2.fromOffset(100,40); gui.AlwaysOnTop = false; gui.Adornee = anchor; gui.Parent = anchor
	local label = Instance.new("TextLabel"); label.Size = UDim2.fromScale(1,1); label.BackgroundTransparency = 1
	label.Text = tostring(math.floor(message.amount+.5)); label.TextColor3 = Config.NormalColor; label.TextSize = 22; label.Font = Enum.Font.GothamBold; label.TextStrokeTransparency = .35; label.Parent = gui
	local rise = TweenService:Create(anchor,TweenInfo.new(.65),{Position=anchor.Position+Vector3.new(0,2.5,0)})
	local fade = TweenService:Create(label,TweenInfo.new(.65),{TextTransparency=1,TextStrokeTransparency=1})
	rise:Play(); fade:Play(); remember(anchor,.7,{rise,fade})
	VFXController.Hit(target,message.position,false)
	-- Rate-limit presentation, not damage: every target still gets its own number.
	if os.clock()-lastHitSound >= .09 then
		lastHitSound=os.clock(); VFXController.Shake(false)
		Players.LocalPlayer:SetAttribute("CombatHitUntil",workspace:GetServerTimeNow()+.13)
		local sound=Instance.new("Sound"); sound.SoundId="rbxasset://sounds/impact_water.mp3"; sound.Volume=.22; sound.PlaybackSpeed=1.8; sound.Parent=anchor; sound:Play()
	end
end

local function stopShake()
	if shakeHumanoid and shakeHumanoid.Parent then shakeHumanoid.CameraOffset = cameraOffset end
	shakeHumanoid = nil
	shakeUntil = 0
	shakeAmplitude = 0
end

function VFXController.Shake(heavy: boolean)
	if not shakeEnabled then return end
	local character = Players.LocalPlayer.Character
	local humanoid = if character then character:FindFirstChildOfClass("Humanoid") else nil
	if not humanoid or humanoid.Health <= 0 then return end
	if shakeHumanoid ~= humanoid then
		stopShake()
		shakeHumanoid = humanoid
		cameraOffset = humanoid.CameraOffset
	end
	shakeDuration = if heavy then Config.HeavyShakeDuration else Config.ShakeDuration
	shakeUntil = os.clock() + shakeDuration
	shakeAmplitude = math.max(shakeAmplitude, if heavy then Config.HeavyShakeAmplitude else Config.ShakeAmplitude)
end

function VFXController.SetCameraShakeEnabled(enabled: boolean)
	shakeEnabled = enabled
	if not enabled then stopShake() end
end

function VFXController.DebugBox(frame: CFrame, size: Vector3)
	if not Debug.DebugHitboxes then return end
	local box = part("DebugHitbox", frame.Position, size, Color3.fromRGB(85, 215, 255))
	box.CFrame = frame
	box.Transparency = 0.8
	box.Parent = folder
	remember(box, Debug.HitboxLifetime, {}, true)
end

function VFXController.GetActiveCount(): number
	return #effects
end

function VFXController.Start()
	if started then return end
	started = true
	local container = Instance.new("Folder")
	container.Name = "LocalCombatVFX"
	local existing = workspace:FindFirstChild("Effects")
	local effectsRoot = if existing and existing:IsA("Folder") then existing else Instance.new("Folder")
	effectsRoot.Name = "Effects"; effectsRoot.Parent = workspace
	container.Parent = effectsRoot
	folder = container
	Players.LocalPlayer.CharacterRemoving:Connect(function()
		stopShake()
		for _, list in { effects, debugEffects } do
			for _, effect in list do dispose(effect) end
			table.clear(list)
		end
	end)
	RunService:BindToRenderStep("CombatCameraFeedback", Enum.RenderPriority.Camera.Value - 1, function()
		local humanoid = shakeHumanoid
		if not humanoid then return end
		local now = os.clock()
		if now >= shakeUntil or not humanoid.Parent or humanoid.Health <= 0 then stopShake(); return end
		local amplitude = shakeAmplitude * math.clamp((shakeUntil - now) / shakeDuration, 0, 1)
		humanoid.CameraOffset = cameraOffset + Vector3.new(math.sin(now * Config.ShakeFrequency), math.cos(now * Config.ShakeFrequency * 1.3), 0) * amplitude
	end)
	RunService.Heartbeat:Connect(function()
		local now = os.clock()
		for _, list in { effects, debugEffects } do
			for index = #list, 1, -1 do
				if now >= list[index].expiresAt then
					local expired = table.remove(list, index)
					if expired then dispose(expired) end
				end
			end
		end
	end)
end

return VFXController
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="LocalScript" referent="307">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[--!strict

local CombatController = require(script.Parent.Controllers.CombatController)
local InputController = require(script.Parent.Controllers.InputController)

require(script.Parent.Controllers.CameraController).Start()
CombatController.Start()
InputController.Start()
if not (game:GetService("RunService"):IsStudio() and workspace:GetAttribute("CombatOnlyTest") == true) then
	require(script.Parent.Controllers.HeroAppearanceTransition).Start()
	task.spawn(function() require(script.Parent.Controllers.DeveloperConsoleController).Start() end)
	task.spawn(function() require(script.Parent.Controllers.HeroSelectionController).Start() end)
 task.spawn(function() require(script.Parent.Controllers.SasukeVFXController).Start() end)
 require(script.Parent.Controllers.SurvivalHUDController).Start()
	require(script.Parent.Controllers.HeroHUDController).Start()
	require(script.Parent.Controllers.AbilityHUDController).Start()
	require(script.Parent.Controllers.TowerVFXController).Start()
	require(script.Parent.Controllers.MinionMotionController).Start()
 require(script.Parent.Controllers.GamakichiVisualController).Start()
 require(script.Parent.Controllers.AodaVisualController).Start()
end
print("[Anime Battlegrounds] Client ready; left mouse button attacks")
]]></string>
