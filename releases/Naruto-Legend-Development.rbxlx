      <Item class="Folder" referent="33">
        <Properties>
          <string name="Name">Combat</string>
        </Properties>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">AbilityState</string>
            <string name="Source"><![CDATA[--!strict
-- A life owns its casts. No delayed callback can claim an old or cancelled cast.
export type Definition = { read Cooldown: number, read Windup: number, read Duration: number }
export type Cast = { id: number, life: number, abilityId: string, requestId: number,
	startedAt: number, impactAt: number, endsAt: number, impacted: boolean }
export type State = { life: number, serial: number, active: Cast?, ready: { [string]: number } }
local Rules = {}
function Rules.new(life: number): State return { life = life, serial = 0, active = nil, ready = {} } end
function Rules.remaining(state: State, id: string, now: number): number return math.max(0, (state.ready[id] or 0) - now) end
function Rules.request(state: State, id: string, definition: Definition, now: number, requestId: number,
	mode: string, nextM1: number, allowed: boolean): (Cast?, string)
	if not allowed or mode == "Dead" or mode == "Stunned" then return nil, "Unavailable" end
	if state.active or mode ~= "Idle" or now < nextM1 then return nil, "Busy" end
	if Rules.remaining(state, id, now) > 0 then return nil, "Cooldown" end
	state.serial += 1
	local cast: Cast = { id = state.serial, life = state.life, abilityId = id, requestId = requestId,
		startedAt = now, impactAt = now + definition.Windup, endsAt = now + definition.Duration, impacted = false }
	state.active = cast; state.ready[id] = now + definition.Cooldown
	return cast, "Accepted"
end
function Rules.current(state: State, cast: Cast): boolean
	return state.life == cast.life and state.active == cast and state.serial == cast.id
end
function Rules.claim(state: State, cast: Cast, now: number): boolean
	if not Rules.current(state, cast) or cast.impacted or now < cast.impactAt or now >= cast.endsAt then return false end
	cast.impacted = true; return true
end
function Rules.contactOpen(state: State, cast: Cast, now: number, window: number): boolean
	return Rules.current(state, cast) and not cast.impacted and now >= cast.impactAt
		and now <= cast.impactAt + window and now < cast.endsAt
end
function Rules.cancel(state: State) state.active = nil end
function Rules.finish(state: State, cast: Cast, now: number): boolean
	if not Rules.current(state, cast) or now < cast.endsAt then return false end
	state.active = nil; return true
end
function Rules.newLife(state: State, life: number)
	state.life = life; state.active = nil -- Cooldowns persist across respawn; a new match creates a new state.
end
return Rules
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">BasicAttackRules</string>
            <string name="Source"><![CDATA[--!strict
-- Naruto balance: the actual AGI stat improves attack rate. No combo progression.
export type Profile = { read AttackCooldown: number, read AttackSpeedPerAgility: number, read MaxAttacksPerSecond: number }
local Rules = {}
function Rules.speed(profile: Profile, agility: number): number
 if agility ~= agility or math.abs(agility) == math.huge then agility = 0 end
 return math.min(1 + math.max(0, agility) * profile.AttackSpeedPerAgility, profile.MaxAttacksPerSecond * profile.AttackCooldown)
end
return Rules
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">CombatCameraRules</string>
            <string name="Source"><![CDATA[--!strict
local Rules = {}

function Rules.setting(value: any, fallback: number, minimum: number, maximum: number): number
	if typeof(value) ~= "number" or value ~= value or math.abs(value) == math.huge then return fallback end
	return math.clamp(value, minimum, maximum)
end

function Rules.alpha(rate: number, dt: number): number
	if rate <= 0 then return 1 end
	return 1 - math.exp(-rate * math.max(0, dt))
end

function Rules.move(x: number, z: number): (number, number)
	local length = math.sqrt(x * x + z * z)
	if length > 1 then return x / length, z / length end
	return x, z
end

function Rules.captured(focused: boolean, menu: boolean, text: boolean, shop: boolean, stats: boolean, cursor: boolean): boolean
	return focused and not (menu or text or shop or stats or cursor)
end

return Rules
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">CombatProtocol</string>
            <string name="Source"><![CDATA[--!strict

-- Match request: (monotonic requestId, current Character, RoundId), no combat parameters.
-- Isolated CombatOnlyTest keeps the two-argument protocol.
-- CombatEvent is server -> clients only; see docs/COMBAT.md for packet fields.
export type Snapshot = {
	roundId: number?,
	character: Model, profileId: string, revision: number, mode: string,
	lastAttackAt: number, nextAttackAt: number, stunUntil: number, attackSerial: number,
}
export type Attack = { id: number, requestId: number, step: number, startedAt: number, hitAt: number, endsAt: number }
export type Event = {
	kind: string, snapshot: Snapshot?, character: Model?, requestId: number?, reason: string?,
	attack: Attack?, attackId: number?, step: number?,
	hits: { { character: Model, position: Vector3 } }?, hitboxCFrame: CFrame?, hitboxSize: Vector3?,
}
return table.freeze({
	FolderName = "CombatRemotes",
	BasicAttackName = "BasicAttack",
	EventName = "CombatEvent",
})
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">CombatState</string>
            <string name="Source"><![CDATA[--!strict

-- Pure state machine. No timers, Instances, network calls or client authority.
export type Mode = "Idle" | "Attacking" | "Stunned" | "Dead"
export type Profile = {
	read AttackCooldown: number, read InputBufferWindow: number, read HitDelay: number, read AttackDuration: number,
}
export type Attack = {
	id: number, requestId: number, step: number, startedAt: number,
	hitAt: number, endsAt: number, hitClaimed: boolean,
}
export type Buffer = { requestId: number, dueAt: number, expiresAt: number }
export type Fighter = {
	mode: Mode, lastAttackAt: number, nextAttackAt: number,
	stunUntil: number, attackSerial: number, active: Attack?, buffered: Buffer?,
}

local CombatState = {}

function CombatState.new(): Fighter
	return {
		mode = "Idle", lastAttackAt = 0, nextAttackAt = 0,
		stunUntil = 0, attackSerial = 0, active = nil, buffered = nil,
	}
end

function CombatState.Update(state: Fighter, now: number): boolean
	if state.mode == "Stunned" and now >= state.stunUntil then
		state.mode = "Idle"
		state.stunUntil = 0
		return true
	end
	local attack = state.active
	if state.mode == "Attacking" and attack and now >= attack.endsAt then
		state.mode = "Idle"
		state.active = nil
		return true
	end
	return false
end

function CombatState.Request(state: Fighter, profile: Profile, now: number, requestId: number, speedMultiplier: number?): (string, string?)
	CombatState.Update(state, now)
	if state.mode == "Dead" or state.mode == "Stunned" then
		return "Rejected", state.mode
	end
	if state.buffered then
		return "Rejected", "BufferFull"
	end
	if now < state.nextAttackAt or state.mode == "Attacking" then
		local remaining = state.nextAttackAt - now
		if remaining > 0 and remaining <= profile.InputBufferWindow then
			state.buffered = { requestId = requestId, dueAt = state.nextAttackAt, expiresAt = state.nextAttackAt + profile.InputBufferWindow }
			return "Buffered", nil
		end
		return "Rejected", "Cooldown"
	end
	local speed = speedMultiplier or 1
	if speed ~= speed or speed <= 0 or speed == math.huge then return "Rejected", "InvalidSpeed" end
	state.attackSerial += 1
	state.lastAttackAt = now
	state.nextAttackAt = now + math.max(profile.AttackCooldown, profile.AttackDuration) / speed
	state.mode = "Attacking"
	state.active = {
		id = state.attackSerial, requestId = requestId, step = 1, startedAt = now,
		hitAt = now + profile.HitDelay / speed,
		endsAt = now + profile.AttackDuration / speed, hitClaimed = false,
	}
	return "Started", nil
end

function CombatState.ClaimHit(state: Fighter, now: number): Attack?
	local attack = state.active
	if state.mode ~= "Attacking" or not attack or attack.hitClaimed or now < attack.hitAt or now >= attack.endsAt then
		return nil
	end
	attack.hitClaimed = true
	return attack
end

function CombatState.TakeBuffer(state: Fighter, now: number): (number?, boolean)
	local buffer = state.buffered
	if not buffer or now < buffer.dueAt then
		return nil, false
	end
	state.buffered = nil
	return buffer.requestId, now <= buffer.expiresAt and state.mode == "Idle"
end

function CombatState.Stun(state: Fighter, now: number, duration: number, _interrupt: boolean)
	if state.mode == "Dead" then
		return
	end
	state.mode = "Stunned"
	state.active = nil
	state.buffered = nil
	-- Overlap replaces the deadline, rather than stacking durations or old timers.
	state.stunUntil = math.max(state.stunUntil, now + duration)
	state.nextAttackAt = math.max(state.nextAttackAt, state.stunUntil)
end

function CombatState.Kill(state: Fighter)
	state.mode = "Dead"
	state.lastAttackAt = 0
	state.nextAttackAt = 0
	state.stunUntil = 0
	state.active = nil
	state.buffered = nil
end

return CombatState
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">HeroPoses</string>
            <string name="Source"><![CDATA[--!strict
-- Original joint-angle choreography. Pure math; radians, R15 Motor6D names.
export type Pose = { [string]: { number } }
local Poses = {}
local function angles(x: number, y: number?, z: number?): { number } return { x, y or 0, z or 0 } end
function Poses.sample(key: string, time: number, phase: number): Pose
	local breathe = math.sin(time * 2.4)
	local pose: Pose = { Waist = angles(-0.05 + breathe * 0.025), Neck = angles(0.02),
		LeftShoulder = angles(0.12, 0, -0.12), RightShoulder = angles(0.12, 0, 0.12),
		LeftElbow = angles(0.14), RightElbow = angles(0.14) }
	if key == "Run" then
		local stride = math.sin(time * 13)
		pose.Waist = angles(-0.43, stride * 0.035); pose.Neck = angles(0.3)
		pose.LeftShoulder = angles(-1.05, 0, -0.13); pose.RightShoulder = angles(-1.05, 0, 0.13)
		pose.LeftElbow = angles(0.12); pose.RightElbow = angles(0.12)
		pose.LeftHip = angles(stride * 0.9); pose.RightHip = angles(-stride * 0.9)
		pose.LeftKnee = angles(-math.max(0, -stride) * 1.05); pose.RightKnee = angles(-math.max(0, stride) * 1.05)
	elseif key == "Stun" then
		pose.Waist = angles(0.23, 0, math.sin(time * 32) * 0.035); pose.Neck = angles(-0.25)
		pose.LeftShoulder = angles(-0.3, 0, -0.35); pose.RightShoulder = angles(-0.3, 0, 0.35)
		pose.LeftKnee = angles(-0.22); pose.RightKnee = angles(-0.22)
	elseif key=="Meditation" then
        local breath=math.sin(time*2)*.025
        pose.Waist=angles(.05+breath); pose.Neck=angles(-.1-breath)
        pose.LeftHip=angles(1.2,0,-.6); pose.RightHip=angles(1.2,0,.6)
        pose.LeftKnee=angles(-1.7); pose.RightKnee=angles(-1.7)
        pose.LeftShoulder=angles(.4,0,.3); pose.RightShoulder=angles(.4,0,-.3)
        pose.LeftElbow=angles(.9); pose.RightElbow=angles(.9)
    elseif key=="SagePrepare" then
        pose.Waist=angles(.08); pose.Neck=angles(-.08)
        pose.LeftShoulder=angles(.9,-.15,.6); pose.RightShoulder=angles(.9,.15,-.6)
        pose.LeftElbow=angles(1.6); pose.RightElbow=angles(1.6)
        pose.LeftWrist=angles(0,0,.3); pose.RightWrist=angles(0,0,-.3)
    elseif key == "ShadowClones" then
		local seal = math.clamp(phase / 0.16, 0, 1) * (1 - math.clamp((phase - 0.62) / 0.38, 0, 1))
		local sign = math.sin(phase * math.pi * 6) * 0.2 * seal
		pose.LeftShoulder = angles(1.05 * seal, -0.15, 0.7 * seal); pose.RightShoulder = angles(1.05 * seal, 0.15, -0.7 * seal)
		pose.LeftElbow = angles((1.45 + sign) * seal); pose.RightElbow = angles((1.45 - sign) * seal)
		pose.LeftWrist = angles(0, sign, 0.55 * seal); pose.RightWrist = angles(0, -sign, -0.55 * seal)
		pose.Waist = angles(-0.18 * seal); pose.Neck = angles(0.12 * seal)
	elseif key == "RasenganPrepare" or key == "RasenganHelper" or key == "OdamaPrepare" or key == "RasenshurikenPrepare" then
		local circle = time * 13
		local gather = math.clamp(phase / .6, 0, 1)
		gather = gather * gather * (3 - 2 * gather)
		pose.Waist = angles(-.08, -.18); pose.Neck = angles(.1)
		pose.RightShoulder = angles(.65,-.2,-.18); pose.RightElbow = angles(1.25)
		pose.LeftShoulder = angles(1.05,-.2,.65); pose.LeftElbow = angles(1.5)
		pose.RightWrist = angles(-.12,0,-.1)
		pose.LeftWrist = angles(math.sin(circle)*.2,math.cos(circle)*.25,.2)
		if key == "OdamaPrepare" then
			-- The support hand moves outward as the sphere grows, rather than
			-- repeating the small-ball stirring gesture throughout the upgrade.
			pose.Waist = angles(-.12,-.24); pose.Neck = angles(.05)
			pose.RightShoulder = angles(.65+.45*gather,-.1,-.4)
			pose.RightElbow = angles(1.25-.8*gather)
			pose.LeftShoulder = angles(1.1,.45,.35)
			pose.LeftElbow = angles(1.5-.8*gather)
			pose.LeftWrist = angles(-.15,0,.45)
		elseif key == "RasenshurikenPrepare" then
			-- Lift the wind blade above the right shoulder: readable in the
			-- third-person silhouette without turning it into a thrown attack.
			pose.Waist = angles(-.05,-.18); pose.Neck = angles(-.12*gather)
			pose.RightShoulder = angles(.65+2.05*gather,-.12,-.32)
			pose.RightElbow = angles(1.25-1.05*gather)
			pose.RightWrist = angles(-.1,0,-.1)
			pose.LeftShoulder = angles(.9,-.15,.55)
			pose.LeftElbow = angles(1.3)
		end
	elseif key == "RasenshurikenThrow" then
        local wind=math.clamp(phase/.4375,0,1)
        local release=math.clamp((phase-.4375)/.23,0,1)
        pose.Waist=angles(-.1-.25*release,-.5*wind+.95*release)
        pose.Neck=angles(.1)
        pose.RightShoulder=angles(2.7+.35*wind-1.7*release,-.15,-.35)
        pose.RightElbow=angles(.25+.65*wind-.85*release)
        pose.LeftShoulder=angles(.7-.4*release,0,.7);pose.LeftElbow=angles(1.1)
        pose.RightHip=angles(.3*release);pose.LeftHip=angles(-.25*release)
    elseif key == "RasenganStrike" or key == "OdamaStrike" or key == "RasenshurikenStrike" then
		local extend = math.clamp(phase/.2,0,1)
		pose.Waist = angles(-.2,.35*extend); pose.Neck = angles(.08)
		pose.RightShoulder = angles(.6+1.1*extend,-.1,-.15); pose.RightElbow = angles(.9*(1-extend))
		pose.RightWrist = angles(-.1,0,-.1)
		pose.LeftShoulder = angles(.45,0,.35); pose.LeftElbow = angles(1.2)
		if key == "OdamaStrike" then
			pose.Waist = angles(-.32,.18*extend)
			pose.RightShoulder = angles(1.1+.5*extend,-.1,-.32); pose.RightElbow = angles(.45*(1-extend))
			pose.LeftShoulder = angles(1.15+.3*extend,.45,.3); pose.LeftElbow = angles(.65*(1-extend))
			pose.LeftWrist = angles(-.15,0,.45)
		elseif key == "RasenshurikenStrike" then
			pose.Waist = angles(-.24,.4*extend)
			pose.RightShoulder = angles(2.7-1.05*extend,-.12,-.32); pose.RightElbow = angles(.2*(1-extend))
			pose.LeftShoulder = angles(.6,0,.65); pose.LeftElbow = angles(1.25)
		end
		pose.RightHip = angles(.25); pose.LeftHip = angles(-.2)
	elseif string.match(key, "^Punch%d$") or key == "HeavyPunch" then
		local heavy = key == "HeavyPunch"
		local contact = if heavy then 0.327 else if key == "Punch3" then 0.4 else 0.357
		local thrust = if phase < contact * 0.4 then -0.25 * phase / (contact * 0.4)
			elseif phase <= contact then -0.25 + 1.25 * math.clamp((phase - contact * 0.4) / (contact * 0.6), 0, 1)
			else 1 - math.clamp((phase - contact) / (1 - contact), 0, 1)
		local left = key == "Punch2"
		local sign = if left then -1 else 1
		pose.Waist = angles(if heavy then -0.3 * thrust else -0.08, sign * (-0.35 + thrust * (if heavy then 1.2 else 0.7)))
		pose[left and "LeftShoulder" or "RightShoulder"] = angles((if key == "Punch3" then 2.1 else 1.6) * thrust, sign * 0.18, sign * 0.16)
		pose[left and "LeftElbow" or "RightElbow"] = angles(1.35 * (1 - thrust))
		pose[left and "RightShoulder" or "LeftShoulder"] = angles(0.65, 0, sign * 0.2)
		pose[left and "RightElbow" or "LeftElbow"] = angles(1.3)
		if heavy then pose.RightHip = angles(0.55 * thrust); pose.LeftHip = angles(-0.35 * thrust)
		elseif key == "Punch3" then pose.RightHip = angles(0.3 * thrust); pose.RightKnee = angles(-0.4 * thrust) end
	end
	return pose
end
function Poses.holdRasengan(pose: Pose, time: number, variant: string?): Pose
	-- Upper-body overlay deliberately leaves hips/knees/ankles untouched so all
	-- three techniques can be carried while moving under existing server rules.
	pose.RightShoulder = angles(.55,-.25,-.22)
	pose.RightElbow = angles(1.15 + math.sin(time*3)*.025)
	pose.RightWrist = angles(-.15,0,-.1)
	if variant == "Odama" then
		pose.Waist = angles(-.12,-.24)
		pose.RightShoulder = angles(1.1,-.1,-.4); pose.RightElbow = angles(.45)
		pose.LeftShoulder = angles(1.1,.45,.35); pose.LeftElbow = angles(.7)
		pose.LeftWrist = angles(-.15,0,.45)
	elseif variant == "Rasenshuriken" then
		pose.Waist = angles(-.07,-.18); pose.Neck = angles(-.1)
		pose.RightShoulder = angles(2.7,-.12,-.32); pose.RightElbow = angles(.2)
		pose.LeftShoulder = angles(.9,-.15,.55); pose.LeftElbow = angles(1.3)
	end
	return pose
end
return Poses
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">MinionPoses</string>
            <string name="Source"><![CDATA[--!strict
-- Pure choreography, radians. Server hit timestamps are the only attack trigger.
export type Pose = { [string]: { number } }
local Poses = { AttackDuration = .38, DeathDuration = .65, NearDistance = 85, FarDistance = 220 }
function Poses.State(dead: boolean, stunned: boolean, disabled: boolean, speed: number, now: number, attackAt: number?): (string, number)
	if dead then return "Dead", 0 end
	if stunned then return "Stun", 0 end
	if disabled then return "Idle", 0 end
	if attackAt and now >= attackAt and now - attackAt < Poses.AttackDuration then return "Attack", (now - attackAt) / Poses.AttackDuration end
	return if speed > 1.2 then "Run" else "Idle", 0
end
function Poses.Interval(distance: number, visible: boolean): number
	if not visible or distance > Poses.FarDistance then return .25 end
	return if distance > Poses.NearDistance then .1 else 1 / 30
end
function Poses.Sample(state: string, time: number, phase: number, ranged: boolean, zetsu: boolean): Pose
	local breathe = math.sin(time * 2.6) * .025
	local pose: Pose = { RootJoint = { breathe, 0, 0 }, Neck = { -breathe, 0, 0 },
		["Left Shoulder"] = { .1, 0, -.1 }, ["Right Shoulder"] = { .1, 0, .1 },
		["Left Hip"] = { 0, 0, 0 }, ["Right Hip"] = { 0, 0, 0 } }
	if state == "Run" then
		local stride = math.sin(time * 12)
		pose.RootJoint = { -.18, 0, stride * .025 }; pose.Neck = { .15, 0, 0 }
		pose["Left Hip"] = { stride * .65, 0, 0 }; pose["Right Hip"] = { -stride * .65, 0, 0 }
		pose["Left Shoulder"] = { if zetsu then -stride * .45 else -.7, 0, -.16 }
		pose["Right Shoulder"] = { if zetsu then stride * .45 else -.7, 0, .16 }
	elseif state == "Attack" then
		-- Contact starts at phase zero, matching the existing instant server hit; then recover.
		local strike = (1 - math.clamp(phase, 0, 1)) ^ 2
		pose.RootJoint = { -.15 * strike, -.25 * strike, 0 }
		pose["Right Shoulder"] = { (if ranged then 1.25 else 1.65) * strike, -.25 * strike, -.2 * strike }
		pose["Left Shoulder"] = { (if ranged then 1.1 else .3) * strike, 0, .25 * strike }
	elseif state == "Dead" then
		local fall = math.clamp(phase, 0, 1)
		pose.RootJoint = { .15 * fall, 0, 1.45 * fall }; pose.Neck = { .3 * fall, 0, 0 }
		pose["Left Shoulder"] = { .2, 0, -.45 * fall }; pose["Right Shoulder"] = { .2, 0, .45 * fall }
	elseif state == "Stun" then
		pose.RootJoint = { .15, 0, 0 }; pose.Neck = { -.15, 0, 0 }
	end
	return pose
end
return table.freeze(Poses)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">RigJoints</string>
            <string name="Source"><![CDATA[--!strict
-- Both Roblox avatar joint generations use Transform. Never rewrite RigAttachments.
export type Joint = Motor6D | AnimationConstraint
export type Entry = { joint: Joint, key: string }
local Rig = {}
local names: { [string]: string } = {
	LowerTorso = "Root", UpperTorso = "Waist", Head = "Neck",
	LeftUpperArm = "LeftShoulder", LeftLowerArm = "LeftElbow", LeftHand = "LeftWrist",
	RightUpperArm = "RightShoulder", RightLowerArm = "RightElbow", RightHand = "RightWrist",
	LeftUpperLeg = "LeftHip", LeftLowerLeg = "LeftKnee", LeftFoot = "LeftAnkle",
	RightUpperLeg = "RightHip", RightLowerLeg = "RightKnee", RightFoot = "RightAnkle",
}
function Rig.Collect(model: Model): { Entry }
	local entries: { Entry } = {}; local seen: { [Instance]: boolean } = {}
	local descendants = model:GetDescendants()
	-- Prefer modern constraints if a migration rig happens to contain both types.
	for _, class in { "AnimationConstraint", "Motor6D" } do
		for _, item in descendants do
			if item.ClassName ~= class then continue end
			local joint: Joint; local child: Instance?
			if item:IsA("AnimationConstraint") then
				joint = item; child = if item.Attachment1 then item.Attachment1.Parent else nil
			elseif item:IsA("Motor6D") then joint = item; child = item.Part1
			else continue end
			if not child or not child:IsA("BasePart") or child.Parent ~= model or not names[child.Name] or seen[child] then continue end
			seen[child] = true; table.insert(entries, { joint = joint, key = names[child.Name] })
		end
	end
	return entries
end
return Rig
]]></string>
          </Properties>
        </Item>
      </Item>
