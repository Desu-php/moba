      <Item class="ModuleScript" referent="61">
        <Properties>
          <string name="Name">CreatorVisualFactory</string>
          <string name="Source"><![CDATA[--!strict
-- Rebuild only whitelisted visual properties; never load marketplace scripts at runtime.
local Factory = {}
export type Spec = { name: string, body: string, form: string, size: {number}, cf: {number}, color: {number},
 transparency: number, mesh: string, texture: string, scale: {number}, offset: {number},
 decals: {{face: string, texture: string, transparency: number}} }
function Factory.Vector(v: {number}): Vector3 return Vector3.new(v[1],v[2],v[3]) end
function Factory.Frame(v: {number}): CFrame
 return CFrame.new(v[1],v[2],v[3],v[4],v[5],v[6],v[7],v[8],v[9],v[10],v[11],v[12])
end
function Factory.Part(spec: Spec): (Part, SpecialMesh)
 local p=Instance.new("Part");p.Name=spec.name;p.Size=Factory.Vector(spec.size)
 p.CanCollide=false;p.CanTouch=false;p.CanQuery=false;p.Massless=true;p.CastShadow=false
 p.Color=Color3.new(spec.color[1],spec.color[2],spec.color[3]);p.Transparency=spec.transparency
 p.Material=Enum.Material.SmoothPlastic
 local mesh=Instance.new("SpecialMesh");mesh.MeshType=Enum.MeshType.FileMesh
 mesh.MeshId=spec.mesh;mesh.TextureId=spec.texture;mesh.Scale=Factory.Vector(spec.scale);mesh.Offset=Factory.Vector(spec.offset);mesh.Parent=p
 for _,value in spec.decals do
  local decal=Instance.new("Decal");decal.Face=(Enum.NormalId :: any)[value.face]
  decal.Texture=value.texture;decal.Transparency=value.transparency;decal.Parent=p
 end
 return p,mesh
end
return Factory
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="62">
        <Properties>
          <string name="Name">Game</string>
        </Properties>
        <Item class="ModuleScript" referent="63">
          <Properties>
            <string name="Name">DeveloperCommandRules</string>
            <string name="Source"><![CDATA[--!strict
local Rules={}
export type Command={name: string, level: number?, enabled: boolean?}
function Rules.parse(raw: any): Command?
 if type(raw)~="string" or #raw>100 then return nil end
 local words={} for word in string.lower(raw):gmatch("%S+") do table.insert(words,word) end
 if words[1]=="/dev" then table.remove(words,1) end
 local name=words[1]
 if name=="level" and #words==2 then
  local n=tonumber(words[2]);if not n or n~=n or n%1~=0 or n<1 or n>30 then return nil end
  return {name=name,level=n}
 elseif name=="nocd" and #words==2 and (words[2]=="on" or words[2]=="off") then return {name=name,enabled=words[2]=="on"}
 elseif #words==1 and (name=="help" or name=="refresh" or name=="learnall" or name=="solo" or name=="rikudo") then return {name=name} end
 return nil
end
return Rules
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="64">
          <Properties>
            <string name="Name">JungleRules</string>
            <string name="Source"><![CDATA[--!strict
-- Engine-independent camp lifecycle; all time and distances supplied by application.
export type Camp = { mode: string, respawnAt: number }
local Rules = {}
function Rules.new(): Camp return { mode = "Idle", respawnAt = 0 } end
function Rules.hostile(aNeutral: boolean, bNeutral: boolean, aActive: boolean, bActive: boolean): boolean
	return (aNeutral and not bNeutral and bActive) or (bNeutral and not aNeutral and aActive)
end
function Rules.die(camp: Camp, now: number, delay: number)
	if camp.mode == "Dead" then return end
	camp.mode = "Dead"; camp.respawnAt = now + delay
end
function Rules.step(camp: Camp, now: number, running: boolean, homeDistance: number, targetValid: boolean, targetHomeDistance: number, leash: number): string
	if not running then return "Stopped" end
	if camp.mode == "Dead" then return if now >= camp.respawnAt then "Spawn" else "Dead" end
	if camp.mode == "Returning" then
		if homeDistance <= 3 then camp.mode = "Idle" end
	elseif homeDistance > leash or (targetValid and targetHomeDistance > leash) then camp.mode = "Returning"
	elseif targetValid then camp.mode = "Chasing"
	elseif homeDistance > 3 then camp.mode = "Returning"
	else camp.mode = "Idle" end
	return camp.mode
end
return Rules
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="65">
          <Properties>
            <string name="Name">MapSceneryPlan</string>
            <string name="Source"><![CDATA[--!strict
-- Pure, deterministic presentation plan. Coordinates are relative to MapConfig.Origin.
-- Tall silhouettes stay outside the playable rectangle; the interior stays low.
local Plan = { Version = 2, PartBudget = 900 }
export type Piece = {
	name: string, x: number, y: number, z: number,
	sx: number, sy: number, sz: number, yaw: number,
	palette: string, shape: string, material: string,
}
function Plan.Build(): { Piece }
	local pieces: { Piece } = {}
	local function add(name: string, x: number, y: number, z: number, sx: number, sy: number, sz: number,
		palette: string, shape: string?, yaw: number?, material: string?)
		table.insert(pieces, { name = name, x = x, y = y, z = z, sx = sx, sy = sy, sz = sz,
			palette = palette, shape = shape or "Block", yaw = yaw or 0, material = material or "Slate" })
	end
	-- Presentation-only rock mass supports the distant village/forest silhouettes.
	-- Its top meets the existing arena surface; it never changes collision/navmesh.
	add("BackdropBedrock", 0, -19.05, 0, 460, 40, 420, "DarkRock", nil, nil, "Rock")
	local function tree(id: string, x: number, z: number, index: number)
		local h = 22 + (index % 4) * 3
		local enemy = x > 20
		add(id .. "Trunk", x, 1 + h / 2, z, 3.6, h, 3.6, if enemy then "Ash" else "Bark", nil, nil, "Wood")
		add(id .. "Crown", x, h + 2, z, 19, 13, 18, if enemy then "DarkLeaf" else "Leaf", "Ball", index * 17, "Grass")
		add(id .. "CrownTip", x + 3, h + 8, z + 1, 12, 9, 12, if enemy then "DarkLeaf" else "LightLeaf", "Ball", nil, "Grass")
		if enemy then
			add(id .. "Root", x - 3, 3, z, 10, 3, 4, "Ash", nil, 25, "Wood")
		end
	end
	-- Two staggered forest belts beyond the playable ground; no canopy over lanes.
	for side = -1, 1, 2 do
		for i = 0, 16 do
			local x = -176 + i * 22
			tree("Forest" .. side .. "_" .. i, x, side * (146 + (i % 2) * 9), i)
		end
		for i = 0, 8 do tree("Edge" .. side .. "_" .. i, side * 202, -112 + i * 28, i + 1) end
		for i = 0, 10 do
			local height = 18 + (i % 3) * 7
			add("Ridge" .. side .. "_" .. i, -180 + i * 36, height / 2 - 2, side * 180,
				42, height, 27, if i > 5 then "DarkRock" else "Rock", nil, (i % 3 - 1) * 12, "Rock")
			add("RidgeCap" .. side .. "_" .. i, -180 + i * 36, height - 3, side * 180,
				34, 4, 23, if i > 5 then "Ash" else "Moss", nil, (i % 3 - 1) * 12, "Grass")
		end
	end
	-- Alliance settlement: plaster houses, tiled overhangs, timber gate and banners.
	for i = 0, 3 do
		local z = -81 + i * 54
		add("VillageHouse" .. i, -191, 6, z, 18, 10, 20, "Plaster")
		add("VillageRoof" .. i, -191, 12, z, 23, 3, 25, "Roof", nil, nil, "Slate")
		add("VillageRoofTier" .. i, -191, 14, z, 17, 2, 19, "Roof")
		add("VillageDoor" .. i, -181.8, 4.2, z, 0.3, 6, 4, "Bark", nil, nil, "Wood")
		for window = -1, 1, 2 do
			add("VillageWindow" .. i .. "_" .. window, -181.7, 7, z + window * 6, 0.3, 3, 3, "Paper")
		end
	end
	for side = -1, 1, 2 do
		add("AllianceGatePost" .. side, -178, 8, side * 20, 4, 14, 4, "Bark", nil, nil, "Wood")
		add("AllianceBanner" .. side, -175.7, 11, side * 20, 0.4, 7, 3, "Alliance", nil, nil, "Fabric")
		add("AllianceBannerPlate" .. side, -175.4, 12.5, side * 20, 0.3, 1.3, 2.4, "Paper")
	end
	add("AllianceGateLintel", -178, 16, 0, 6, 3, 46, "Roof", nil, nil, "Wood")
	-- Enemy side: stone enclosure and pale, crooked root ribs, with red seals.
	for i = 0, 6 do
		local z = -90 + i * 30
		add("EnemyWall" .. i, 191, 5, z, 14, 8 + i % 3, 24, "DarkRock", nil, (i % 2) * 8, "Rock")
		add("EnemyRoot" .. i, 179 + i % 2 * 3, 10, z, 4, 18, 5, "Bone", nil, (i % 3 - 1) * 16, "Wood")
		add("EnemySeal" .. i, 176.8 + i % 2 * 3, 10, z, 0.4, 4, 2, "Enemy", nil, nil, "Fabric")
	end
	add("EnemyGateRib", 182, 21, 0, 8, 5, 50, "Ash", nil, nil, "Wood")
	-- A shallow visual stream overlays the existing solid floor, never Terrain water.
	add("River", 0, 1.035, 0, 11, 0.05, 246, "Water", nil, nil, "Glass")
	for _, z in { -84, 0, 84 } do
		add("BridgeDeck" .. z, 0, 1.28, z, 28, 0.08, 25, "Bark", nil, nil, "WoodPlanks")
		for side = -1, 1, 2 do
			add("BridgeEdge" .. z .. "_" .. side, 0, 1.7, z + side * 13.7, 28, 0.7, 0.8, "Rock")
		end
		for i = -5, 5 do
			add("BridgeBoard" .. z .. "_" .. i, i * 2.4, 1.34, z, 0.12, 0.04, 24.8, "Ash", nil, nil, "Wood")
		end
	end
	-- Low moss around existing rocks; no tall decoration in camp leash areas.
	for _, x in { -60, 60 } do
		for _, z in { -43, 43 } do
			add("RockMoss" .. x .. "_" .. z, x, 1.3, z, 18, 0.4, 15, "Moss", "Ball", nil, "Grass")
		end
	end
	assert(#pieces <= Plan.PartBudget, "Map scenery exceeds part budget")
	return pieces
end
return table.freeze(Plan)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="66">
          <Properties>
            <string name="Name">MatchRoster</string>
            <string name="Source"><![CDATA[--!strict
-- Round-scoped roster aggregate. Roblox Players, attributes and phase timing
-- belong to adapters; this module owns membership, capacity and readiness.
export type Member = { teamId: string, connected: boolean }
export type State = {
	order: { string }, capacity: number, locked: boolean,
	members: { [number]: Member },
}
local Roster = {}

function Roster.new(ids: { string }, capacity: number?): State
	local limit = capacity or 5
	assert(limit >= 1 and limit < math.huge and limit % 1 == 0, "Capacity must be a positive integer")
	assert(#ids >= 2, "At least two teams required")
	local seen: { [string]: boolean } = {}
	for _, id in ids do
		assert(id ~= "" and not seen[id], "Team IDs must be nonempty and unique")
		seen[id] = true
	end
	return { order = table.clone(ids), capacity = limit, locked = false, members = {} }
end

function Roster.counts(state: State): { [string]: number }
	local result: { [string]: number } = {}
	for _, id in state.order do result[id] = 0 end
	for _, member in state.members do
		if member.connected then result[member.teamId] += 1 end
	end
	return result
end

function Roster.teamOf(state: State, userId: number): string?
	local member = state.members[userId]
	return if member and member.connected then member.teamId else nil
end

function Roster.join(state: State, userId: number): string?
	-- Studio uses negative synthetic IDs; require integers, not positivity.
	assert(userId > -math.huge and userId < math.huge and userId % 1 == 0, "User ID must be a finite integer")
	local member = state.members[userId]
	if member then
		member.connected = true
		return member.teamId
	end
	if state.locked then return nil end
	local counts = Roster.counts(state)
	local selected: string? = nil
	for _, id in state.order do
		if counts[id] < state.capacity and (not selected or counts[id] < counts[selected]) then selected = id end
	end
	if selected then state.members[userId] = { teamId = selected, connected = true } end
	return selected
end

function Roster.leave(state: State, userId: number)
	local member = state.members[userId]
	if not member then return end
	if state.locked then member.connected = false else state.members[userId] = nil end
end

function Roster.lock(state: State)
	-- A disconnected slot remains reserved to its owner until the next round.
	-- A fresh aggregate is created at reset; no in-match replacement or switching.
	state.locked = true
end

function Roster.connectedCount(state: State): number
	local total = 0
	for _, count in Roster.counts(state) do total += count end
	return total
end

function Roster.ready(state: State, minimumPerTeam: number): boolean
	assert(minimumPerTeam >= 1 and minimumPerTeam % 1 == 0, "Minimum must be a positive integer")
	if minimumPerTeam > state.capacity then return false end
	for _, count in Roster.counts(state) do
		if count < minimumPerTeam then return false end
	end
	return true
end

return Roster
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="67">
          <Properties>
            <string name="Name">MatchState</string>
            <string name="Source"><![CDATA[--!strict
export type Phase = "WaitingForPlayers" | "Preparing" | "InProgress" | "Finished"
export type TeamState = { active: boolean, count: number }
export type State = {
	phase: Phase, teams: { [string]: TeamState }, order: { string },
	preparationEnds: number, startedAt: number, finishedAt: number,
	nextWaveAt: number, wave: number, winner: string?, roundId: number,
}
local Rules = {}
function Rules.new(ids: { string }): State
	assert(#ids >= 2, "At least two teams required")
	local teams = {}
	for _, id in ids do
		assert(not teams[id], "Duplicate team")
		teams[id] = { active = true, count = 0 }
	end
	return { phase = "WaitingForPlayers", teams = teams, order = table.clone(ids),
		preparationEnds = 0, startedAt = 0, finishedAt = 0, nextWaveAt = 0, wave = 0, winner = nil,
		roundId = 1 }
end
function Rules.active(state: State): { string }
	local result = {}
	for _, id in state.order do if state.teams[id].active then table.insert(result, id) end end
	return result
end
function Rules.assign(state: State, preferred: string?): string?
	if state.phase == "Finished" then return nil end
	if preferred and state.teams[preferred] then
		-- Rejoining an eliminated team cannot escape elimination.
		if state.teams[preferred].active then return preferred end
		return nil
	end
	local selected: string? = nil
	for _, id in state.order do
		local team = state.teams[id]
		if team.active and (not selected or team.count < state.teams[selected].count) then selected = id end
	end
	return selected
end
function Rules.enemy(state: State, first: string?, second: string?): boolean
	return first ~= nil and second ~= nil and first ~= second
		and state.teams[first] ~= nil and state.teams[second] ~= nil
		and state.teams[first].active and state.teams[second].active
end
function Rules.advance(state: State, now: number, players: number, minimum: number, preparation: number, firstWave: number): boolean
	if state.phase == "WaitingForPlayers" and players >= minimum then
		state.phase = "Preparing"
		state.preparationEnds = now + preparation
		return true
	elseif state.phase == "Preparing" then
		if players < minimum then state.phase = "WaitingForPlayers"; return true end
		if now >= state.preparationEnds then
			state.phase = "InProgress"; state.startedAt = now; state.nextWaveAt = now + firstWave
			return true
		end
	end
	return false
end
function Rules.waveDue(state: State, now: number, interval: number): boolean
	if state.phase ~= "InProgress" or now < state.nextWaveAt then return false end
	state.wave += 1
	-- No catch-up storm after a long frame.
	state.nextWaveAt = now + interval
	return true
end
function Rules.eliminate(state: State, id: string, now: number): boolean
	local team = state.teams[id]
	if state.phase ~= "InProgress" or not team or not team.active then return false end
	team.active = false
	local survivors = Rules.active(state)
	if #survivors <= 1 then
		state.phase = "Finished"; state.winner = survivors[1]; state.finishedAt = now
	end
	return true
end
-- Finished is terminal for this server. roundId remains an internal event epoch.
return Rules
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="68">
          <Properties>
            <string name="Name">ProgressionRules</string>
            <string name="Source"><![CDATA[--!strict
local Resource = require("../Abilities/NarutoResources")
export type Configuration = {
 read Attributes: Resource.Hero & { read BaseHealth: number, read HealthPerStrength: number }, read NativeMana: Resource.Native, read DamagePerStrength: number, read ArmorPerAgility: number,
 read StartingLevel: number, read MaxLevel: number, read XPBase: number, read XPPerLevel: number, read MaxGrant: number, read MaxGold: number,
 read BaseStats: { WalkSpeed: number, AttackDamageMultiplier: number, Defense: number },
 read DefenseScale: number,
}
export type Item = { Name: string, Description: string, Permanent: boolean, Cost: number, DamageBonus: number?, HealthBonus: number?, SpeedBonus: number?, DefenseBonus: number?, Heal: number? }
export type Profile = { Level: number, CurrentXP: number, SkillPoints: number, Learned: { [string]: number }, TotalKills: number, TotalDeaths: number, TotalMinionKills: number, Assists: number, Owned: { [string]: boolean } }
export type Stats = { MaxHealth: number, WalkSpeed: number, AttackDamageMultiplier: number, AttackDamageBonus: number, Defense: number, Level: number, Strength: number, RawStrength: number, Agility: number, RawAgility: number, Intelligence: number, MaxMana: number, ManaRegen: number }
local Module = {}
function Module.configure(Config: Configuration, items: { [string]: Item })
local Rules = {}
local Attributes = Resource.configure(Config.Attributes, Config.NativeMana)
function Rules.validAmount(amount: number): boolean
 if typeof(amount) ~= "number" then return false end
 return amount == amount and amount >= 0 and amount <= Config.MaxGrant and amount % 1 == 0
end
function Rules.new(): Profile
 return { Level = Config.StartingLevel, CurrentXP = 0, SkillPoints = Config.StartingLevel, Learned = {}, TotalKills = 0, TotalDeaths = 0, TotalMinionKills = 0, Assists = 0, Owned = {} }
end
function Rules.required(level: number): number
 return if level >= Config.MaxLevel then 0 else Config.XPBase + (level - 1) * Config.XPPerLevel
end
function Rules.addXP(profile: Profile, amount: number): (number, number)
 if not Rules.validAmount(amount) or profile.Level >= Config.MaxLevel then return 0, 0 end
 local levels = 0
 profile.CurrentXP += amount
 while profile.Level < Config.MaxLevel and profile.CurrentXP >= Rules.required(profile.Level) do
  profile.CurrentXP -= Rules.required(profile.Level); profile.Level += 1; levels += 1
 end
 if profile.Level >= Config.MaxLevel then profile.CurrentXP = 0 end
 profile.SkillPoints += levels
 return levels, amount
end
function Rules.stats(profile: Profile, strengthBonus: number?): Stats
 local levels = math.clamp(profile.Level, 1, Config.MaxLevel) - 1
 local base = Config.BaseStats
 local attributes = Attributes.values(levels + 1, strengthBonus or 0)
 local result = { MaxHealth = Config.Attributes.BaseHealth + Config.Attributes.HealthPerStrength * attributes.strength, WalkSpeed = base.WalkSpeed,
  AttackDamageMultiplier = base.AttackDamageMultiplier + math.max(0,attributes.strength - Config.Attributes.Strength) * Config.DamagePerStrength, AttackDamageBonus = 0, Defense = base.Defense + attributes.agility * Config.ArmorPerAgility, Level = profile.Level, Strength = attributes.strength, RawStrength = attributes.rawStrength, Agility = attributes.agility, RawAgility = attributes.rawAgility, Intelligence = attributes.intelligence, MaxMana = attributes.maxMana, ManaRegen = attributes.regen }
 for id, owned in profile.Owned do
  local item = items[id]
  if owned and item and item.Permanent then
   result.MaxHealth += item.HealthBonus or 0; result.WalkSpeed += item.SpeedBonus or 0
   result.AttackDamageMultiplier += item.DamageBonus or 0; result.Defense += item.DefenseBonus or 0
  end
 end
 return result
end
function Rules.mitigate(amount: number, defense: number): number
 return amount * Config.DefenseScale / (Config.DefenseScale + math.max(0, defense))
end
function Rules.balanceAfter(balance: number, amount: number, spend: boolean): number?
 if not Rules.validAmount(amount) then return nil end
 if spend then return if balance >= amount then balance - amount else nil end
 return math.min(Config.MaxGold, balance + amount)
end
function Rules.purchaseReason(profile: Profile, gold: number, id: string, health: number, maximum: number): string?
 local item = items[id]
 if not item then return "UnknownItem" end
 if item.Permanent and profile.Owned[id] then return "Purchased" end
 if item.Heal and health >= maximum then return "FullHealth" end
 if gold < item.Cost then return "NotEnoughGold" end
 return nil
end
return Rules
end
return Module
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="69">
          <Properties>
            <string name="Name">RewardLedger</string>
            <string name="Source"><![CDATA[--!strict
export type Actor = { userId: number?, teamId: string }
export type Hit = { actor: Actor, at: number }
export type Ledger = { claimed: boolean, last: Hit?, contributions: { [number]: Hit } }
local Ledger = {}
function Ledger.new(): Ledger return { claimed = false, last = nil, contributions = {} } end
function Ledger.record(ledger: Ledger, actor: Actor, victimTeam: string, now: number)
 if ledger.claimed or actor.teamId == victimTeam then return end
 local hit = { actor = actor, at = now }; ledger.last = hit
 if actor.userId then ledger.contributions[actor.userId] = hit end
end
function Ledger.claim(ledger: Ledger, now: number, window: number): (boolean, Actor?, { Actor })
 if ledger.claimed then return false, nil, {} end
 ledger.claimed = true
 local last = ledger.last
 local killer = if last and now - last.at >= 0 and now - last.at <= window then last.actor else nil
 local assists = {}
 for _, hit in ledger.contributions do
  if now - hit.at >= 0 and now - hit.at <= window and (not killer or hit.actor.userId ~= killer.userId) then
   table.insert(assists, hit.actor)
  end
 end
 table.clear(ledger.contributions); ledger.last = nil
 return true, killer, assists
end
function Ledger.forget(ledger: Ledger, userId: number)
 ledger.contributions[userId] = nil
 if ledger.last and ledger.last.actor.userId == userId then ledger.last = nil end
end
return Ledger
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="70">
          <Properties>
            <string name="Name">RewardRules</string>
            <string name="Source"><![CDATA[--!strict
export type Actor = { userId: number?, teamId: string }
export type Death = { read kind: string, read teamId: string, read victimUserId: number?, read killer: Actor?, read assists: { Actor } }
export type PlayerSample = { userId: number, teamId: string, active: boolean, alive: boolean, inRange: boolean }
export type Reward = { XP: number, Gold: number }
export type Grant = { XP: number, Gold: number, Kills: number, Deaths: number, MinionKills: number, Assists: number }
local Rules = {}
function Rules.plan(event: Death, players: { PlayerSample }, minion: Reward?, hero: Reward, assist: Reward, enabled: boolean): { [number]: Grant }
 local grants: { [number]: Grant } = {}
 if not enabled then return grants end
 local byId: { [number]: PlayerSample } = {}
 for _, player in players do if player.active then byId[player.userId] = player end end
 local function grant(id: number): Grant
  if not grants[id] then grants[id] = { XP = 0, Gold = 0, Kills = 0, Deaths = 0, MinionKills = 0, Assists = 0 } end
  return grants[id]
 end
 if event.kind == "Hero" and event.victimUserId and byId[event.victimUserId] then grant(event.victimUserId).Deaths = 1 end
 local killer = event.killer
 if not killer or killer.teamId == event.teamId then return grants end
 local killerPlayer = if killer.userId then byId[killer.userId] else nil
 if killerPlayer and killerPlayer.teamId ~= killer.teamId then killerPlayer = nil end
 if event.kind == "Minion" and minion then
  for _, player in players do
   if player.active and player.alive and player.inRange and player.teamId == killer.teamId then grant(player.userId).XP = minion.XP end
  end
  if killerPlayer then local g = grant(killerPlayer.userId); g.Gold = minion.Gold; g.MinionKills = 1 end
 elseif event.kind == "Hero" then
  if killerPlayer then local g = grant(killerPlayer.userId); g.XP = hero.XP; g.Gold = hero.Gold; g.Kills = 1 end
  for _, actor in event.assists do
   local player = if actor.userId then byId[actor.userId] else nil
   if player and player.teamId == actor.teamId and player.teamId ~= event.teamId and player ~= killerPlayer then
    local g = grant(player.userId); g.XP = assist.XP; g.Gold = assist.Gold; g.Assists = 1
   end
  end
 end
 return grants
end
return Rules
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="71">
          <Properties>
            <string name="Name">RoundProtocol</string>
            <string name="Source"><![CDATA[--!strict
local Protocol = {}
function Protocol.accepts(current: number, received: any): boolean
	return typeof(received) == "number" and received == current and received >= 1 and received % 1 == 0
end
function Protocol.acceptsClient(current: number?, received: any, phase: any, isolatedStudio: boolean): boolean
	if current == nil then return isolatedStudio and phase == nil and received == nil end
	return phase ~= "Finished" and Protocol.accepts(current, received)
end
return Protocol
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="72">
          <Properties>
            <string name="Name">StructureRules</string>
            <string name="Source"><![CDATA[--!strict
local Rules = {}
function Rules.isStructure(kind: any): boolean return kind == "Base" or kind == "Tower" end
function Rules.canReceive(kind: any, remainingTowers: number): boolean
	return kind ~= "Base" or remainingTowers <= 0
end
return Rules
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="73">
          <Properties>
            <string name="Name">TowerRules</string>
            <string name="Source"><![CDATA[--!strict
export type Candidate = { id: number, kind: string, distance: number, valid: boolean }
export type State = { target: number?, aggro: number?, aggroUntil: number, readyAt: number,
	shot: number?, contactAt: number, destroyed: boolean, rewarded: boolean }
local Rules = {}
function Rules.new(): State
	return { target = nil, aggro = nil, aggroUntil = 0, readyAt = 0, shot = nil, contactAt = 0, destroyed = false, rewarded = false }
end
function Rules.cancel(state: State)
	state.target = nil; state.shot = nil; state.aggro = nil; state.aggroUntil = 0
end
function Rules.aggress(state: State, attacker: number, now: number, duration: number, confirmedEnemyHero: boolean)
	if state.destroyed or not confirmedEnemyHero then return end
	state.aggro = attacker; state.aggroUntil = now + duration
	if state.shot and state.shot ~= attacker then state.shot = nil; state.readyAt = math.min(state.readyAt, now) end
end
function Rules.choose(state: State, candidates: { Candidate }, now: number, priority: { [string]: number }, allowSummons: boolean): number?
	if state.destroyed then return nil end
	local best: Candidate? = nil
	for _, candidate in candidates do
		local rank = priority[candidate.kind]
		if not candidate.valid or not rank or (candidate.kind == "Summon" and not allowSummons) then continue end
		if candidate.id == state.aggro and now < state.aggroUntil and candidate.kind == "Hero" then return candidate.id end
		local previous = best
		if not previous or rank < priority[previous.kind]
			or (rank == priority[previous.kind] and (candidate.distance < previous.distance - 0.001
				or (math.abs(candidate.distance - previous.distance) <= 0.001 and
					(candidate.id == state.target or (previous.id ~= state.target and candidate.id < previous.id))))) then best = candidate end
	end
	state.aggro = nil; state.aggroUntil = 0
	return if best then best.id else nil
end
function Rules.begin(state: State, target: number, now: number, windup: number, interval: number): boolean
	if state.destroyed or state.shot or now < state.readyAt then return false end
	state.target = target; state.shot = target; state.contactAt = now + windup; state.readyAt = now + interval; return true
end
function Rules.contact(state: State, now: number, targetValid: boolean, inProgress: boolean): number?
	if state.destroyed or not inProgress or not targetValid then state.shot = nil; return nil end
	if not state.shot or now < state.contactAt then return nil end
	local target = state.shot; state.shot = nil; return target
end
function Rules.destroy(state: State): boolean
	if state.destroyed then return false end
	state.destroyed = true; Rules.cancel(state); return true
end
function Rules.claimReward(state: State, enemyTeam: boolean): boolean
	if not state.destroyed or state.rewarded or not enemyTeam then return false end
	state.rewarded = true; return true
end
function Rules.recipient(attackingTeam: string, team: string, connected: boolean, active: boolean, eliminated: boolean): boolean
	return attackingTeam == team and connected and active and not eliminated
end
return Rules
]]></string>
