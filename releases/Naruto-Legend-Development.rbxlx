        <Item class="ModuleScript" referent="98">
          <Properties>
            <string name="Name">ChakraParticleData</string>
            <string name="Source"><![CDATA[--!strict
-- Visual snapshot: existing Workspace.Naruto Pack / Rasengan V2. No scripts imported.
