        <Item class="ModuleScript" referent="79">
          <Properties>
            <string name="Name">AbilityLearningService</string>
            <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Learning = require(Shared.Abilities.SkillLearning)
local Protocol = require(Shared.Game.RoundProtocol)
local Progression = require(script.Parent.HeroProgressionService)
local Teams = require(script.Parent.TeamService)
local Limiter = require(script.Parent.RequestLimiter)
type Session = { bucket: Limiter.Bucket, lastId: number, lastReply: number }
local sessions: { [Player]: Session } = {}
local Service = {}
local started = false
function Service.HandleRequest(player: Player, ...: any): (boolean, string)
	if player.Parent ~= Players then return false,"Unavailable" end
	local now = workspace:GetServerTimeNow()
	local session = sessions[player]
	if not session then session={bucket=Limiter.new(4,2,now),lastId=0,lastReply=0}; sessions[player]=session end
	if not Limiter.Consume(session.bucket,now) then return false,"RateLimited" end
	local id, character, life, ability, epoch = ...
	if select("#",...)~=5 or typeof(id)~="number" or id~=id or id%1~=0 or id<1 or id>2147483647
		or typeof(ability)~="string" or #ability>32 or typeof(character)~="Instance" or typeof(life)~="number" then return false,"Malformed" end
	if id<=session.lastId then return false,"Replay" end; session.lastId=id
	local model = character :: Instance
	local match=Teams.GetState()
	if not match or not Protocol.accepts(match.roundId,epoch) or not model:IsA("Model") or model~=player.Character
		or model:GetAttribute("RoundId")~=match.roundId or model:GetAttribute("LifeId")~=life then return false,"StaleLife" end
	if match.phase~="InProgress" or not Teams.IsParticipant(player) or not Teams.IsActive(Teams.GetId(model)) then return false,"Unavailable" end
	local profile=Progression.Get(player); if not profile then return false,"Unavailable" end
	-- Pure validation and point debit are non-yielding; no client ranks/points/stats accepted.
	local ok,reason=Learning.learn(profile,ability)
	if ok then Progression.Publish(player) end
	return ok,reason
end
function Service.Start()
	if started then return end; started=true
	local remote=Instance.new("RemoteEvent"); remote.Name="AbilityLearning"; remote.Parent=game:GetService("ReplicatedStorage")
	remote.OnServerEvent:Connect(function(player: Player,...: any)
		local args=table.pack(...); local ok,reason=Service.HandleRequest(player,table.unpack(args,1,args.n))
		local session=sessions[player]; local now=workspace:GetServerTimeNow()
		if session and (ok or now-session.lastReply>=0.25) then session.lastReply=now; remote:FireClient(player,ok,reason) end
	end)
	Players.PlayerRemoving:Connect(function(player) sessions[player]=nil end)
end
return Service
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="80">
          <Properties>
            <string name="Name">AbilityService</string>
            <string name="Source"><![CDATA[--!strict
-- Network/application boundary. Hero mechanics live in NarutoAbilityService/domain.
local Players = game:GetService("Players")
local Storage = game:GetService("ReplicatedStorage")
local Shared = Storage:WaitForChild("Shared")
local Config = require(Shared.Config.AbilityConfig)
local Heroes = require(Shared.Config.HeroConfig)
local Protocol = require(Shared.Game.RoundProtocol)
local Limiter = require(script.Parent.RequestLimiter)
local Teams = require(script.Parent.TeamService)
local Fighters = require(script.Parent.FighterStateService)
local Hitboxes = require(script.Parent.HitboxService)
local Damage = require(script.Parent.DamageService)
local Naruto = require(script.Parent.NarutoAbilityService)
type Session = { bucket: Limiter.Bucket, lastId: number, lastReply: number }
local sessions: {[Player]: Session} = {}
local remote: RemoteEvent? = nil
local started = false
local Ability = {}
local function sendAll(message: any)
	local match = Teams.GetState(); if not remote or not match or match.phase ~= "InProgress" then return end
	message.roundId = match.roundId; remote:FireAllClients(message)
end
function Ability.TryCast(player: Player, ...: any): (boolean,string)
	if player.Parent ~= Players then return false,"Unavailable" end
	local now = workspace:GetServerTimeNow()
	local session = sessions[player]
	if not session then session = {bucket=Limiter.new(Config.Burst,Config.RequestsPerSecond,now),lastId=0,lastReply=0}; sessions[player]=session end
	local allowed = Limiter.Consume(session.bucket,now)
	local id,character,abilityId,target = ...
	if typeof(id) ~= "number" or id ~= id or id%1 ~= 0 or id<1 or id>Config.MaxRequestId then return false,"Malformed" end
	local function result(ok: boolean,reason: string): (boolean,string)
		local match=Teams.GetState()
		if remote and (ok or now-session.lastReply>=Config.ReplyInterval) then
			session.lastReply=now; remote:FireClient(player,{kind="Result",requestId=id,character=player.Character,roundId=if match then match.roundId else nil,accepted=ok,reason=reason,ready=Naruto.Ready(player)})
		end
		return ok,reason
	end
	if not allowed then return result(false,"RateLimited") end
	local arity=select("#",...)
	if (arity~=3 and arity~=4) or (arity==4 and abilityId~="RasenshurikenThrow" and abilityId~="RikudoHY" and abilityId~="RikudoHZ" and abilityId~="KcmDash" and abilityId~="ShadowSleep" and abilityId~="CloneCommand" and abilityId~="ShadowClones" and abilityId~="GamakichiOil" and abilityId~="GamakichiChop")
		or typeof(character)~="Instance"
		or typeof(abilityId)~="string" or #abilityId>32 or not Config.Abilities[abilityId] then return result(false,"Malformed") end
	local instance=character :: Instance
	if not instance:IsA("Model") or instance~=player.Character then return result(false,"Malformed") end
	local model=instance :: Model
	if id<=session.lastId then return result(false,"Replay") end; session.lastId=id
	local hero=Heroes.Heroes[tostring(player:GetAttribute("HeroId"))]
	if not hero or not table.find(hero.Abilities,abilityId) then return result(false,"Unsupported") end
	local match=Teams.GetState(); local fighter=Fighters.GetOrCreate(model)
	if not match or match.phase~="InProgress" or not Teams.IsParticipant(player) or not fighter or not Damage.CanAct(model)
		or player:GetAttribute("Eliminated")==true or fighter.root.Anchored or not fighter.root:IsDescendantOf(model)
		or fighter.humanoid:GetState()==Enum.HumanoidStateType.Dead or not Hitboxes.IsFiniteCFrame(fighter.root.CFrame) then return result(false,"Unavailable") end
	Fighters.Update(fighter,now)
	if not Naruto.IsAbility(abilityId) then return result(false,"Unsupported") end
 local profile=require(script.Parent.HeroProgressionService).Get(player)
 local line=if abilityId=="RikudoHY" or abilityId=="RikudoHZ" then "KCM" elseif abilityId=="KcmDash" or abilityId=="KcmCancel" then "KCM" elseif abilityId=="RasenshurikenThrow" or abilityId=="Odama" or abilityId=="Rasenshuriken" then "Rasengan" elseif abilityId=="ShadowSleep" then "ShadowClones" elseif abilityId=="MeditationToggle" or abilityId=="MeditationRecall" then "SageMode" elseif abilityId=="CloneCommand" then "ShadowClones" elseif abilityId=="GamakichiOil" or abilityId=="GamakichiChop" then "Gamakichi" else abilityId
 if not profile or (abilityId~="KuramaConvert" and abilityId~="KuramaForm" and (if abilityId=="CloneCommand" then math.max(profile.Learned.ShadowClones or 0,profile.Learned.Gamakichi or 0) else profile.Learned[line] or 0)<1) then return result(false,"Unlearned") end
	return result(Naruto.TryCast(player,abilityId,id,now,target))
end
function Ability.HandleRequest(player: Player,...: any): (boolean,string)
	local args=table.pack(...); local match=Teams.GetState()
	if not match or not Protocol.accepts(match.roundId,args[args.n]) then return false,"StaleRound" end
	return Ability.TryCast(player,table.unpack(args,1,args.n-1))
end
function Ability.Reset() Naruto.Reset() end
function Ability.Start()
	if started then return end; started=true
	Naruto.Start(); Naruto.Visual.Event:Connect(sendAll)
	require(script.Parent.NarutoSummonService).Spawned.Event:Connect(function(model: Model) sendAll({kind="Smoke",position=model:GetPivot().Position}) end)
	local event=Instance.new("RemoteEvent"); event.Name="HeroAbility"; event.Parent=Storage; remote=event
	-- Confirmed damage only, private to its owning player. Summons report to their
	-- owner as well; one message per damage application avoids 5v5 broadcast spam.
	Damage.Applied.Event:Connect(function(source: Model, target: Model, amount: number, round: number?)
		local owner = Players:GetPlayerFromCharacter(source)
		local ownerId = source:GetAttribute("SummonOwner")
		if not owner and typeof(ownerId) == "number" then owner = Players:GetPlayerByUserId(ownerId) end
		local match = Teams.GetState()
		if not owner or owner.Parent ~= Players or not target.Parent or not match or match.phase ~= "InProgress" or round ~= match.roundId then return end
		event:FireClient(owner, { kind="DamageFeedback", source=source, target=target,
			position=target:GetPivot().Position, amount=amount, roundId=round })
	end)
	event.OnServerEvent:Connect(function(player,...: any) Ability.HandleRequest(player,...) end)
	Players.PlayerRemoving:Connect(function(player) sessions[player]=nil end)
	game:GetService("RunService").Heartbeat:Connect(function() Naruto.Update(workspace:GetServerTimeNow()) end)
end
return Ability
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="81">
          <Properties>
            <string name="Name">AbilityTargetService</string>
            <string name="Source"><![CDATA[--!strict
local Fighters = require(script.Parent.FighterStateService)
local Damage = require(script.Parent.DamageService)
local Hitboxes = require(script.Parent.HitboxService)
local Structures = require(script.Parent.StructureService)
local StructureRules = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared").Game.StructureRules)
type Candidate = { humanoid: Humanoid, distance: number }
local Targets = {}
function Targets.Visible(attacker: Model, target: Model, origin: Vector3, destination: Vector3): boolean
	local ray = RaycastParams.new(); ray.FilterType = Enum.RaycastFilterType.Exclude
	local excluded: { Instance } = { attacker, target }
	for model in Fighters.GetAll() do table.insert(excluded, model) end
	local summons = workspace:FindFirstChild("HeroSummons"); if summons then table.insert(excluded, summons) end
	ray.FilterDescendantsInstances = excluded; ray.RespectCanCollide = true
	return workspace:Raycast(origin, destination - origin, ray) == nil
end
function Targets.InCone(attacker: Model, origin: CFrame, range: number, forwardDot: number, includeStructures: boolean, maximum: number): { Humanoid }
	if not Hitboxes.IsFiniteCFrame(origin) then return {} end
	local candidates: { Candidate } = {}
	local seen: { [Humanoid]: boolean } = {}
	local function consider(model: Model, humanoid: Humanoid, root: BasePart)
		local kind = model:GetAttribute("EntityKind")
		if kind ~= "Hero" and kind ~= "Minion" and model:GetAttribute("NativeNarutoClone") ~= true
			and model:GetAttribute("NativeGamakichi")~=true and model:GetAttribute("NativeMeditationClone")~=true and not (includeStructures and StructureRules.isStructure(kind)) then return end
		if not Damage.CanDamage(attacker, model) or not Hitboxes.IsFiniteCFrame(root.CFrame) then return end
		local delta = root.Position - origin.Position
		if delta.Magnitude > range or seen[humanoid] then return end
		if delta.Magnitude > 0.001 and origin.LookVector:Dot(delta.Unit) < forwardDot then return end
		if not Targets.Visible(attacker, model, origin.Position, root.Position) then return end
		seen[humanoid] = true; table.insert(candidates, { humanoid = humanoid, distance = delta.Magnitude })
	end
	for model, fighter in Fighters.GetAll() do consider(model, fighter.humanoid, fighter.root) end
	if includeStructures then
		for model, record in Structures.GetAll() do consider(model, record.humanoid, record.root) end
	end
	table.sort(candidates, function(a: Candidate, b: Candidate) return a.distance < b.distance end)
	local result: { Humanoid } = {}
	for index = 1, math.min(maximum, #candidates) do table.insert(result, candidates[index].humanoid) end
	return result
end
function Targets.Nearest(attacker: Model, origin: CFrame, range: number, forwardDot: number, includeStructures: boolean): Humanoid?
	return Targets.InCone(attacker, origin, range, forwardDot, includeStructures, 1)[1]
end
return Targets
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="82">
          <Properties>
            <string name="Name">BaseService</string>
            <string name="Source"><![CDATA[--!strict
local Config = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared").Config.GameModeConfig)
local Structures = require(script.Parent.StructureService)
local Reset = require(script.Parent.StructureReset)
export type Base = { model: Model, humanoid: Humanoid, root: BasePart, teamId: string, destroyed: boolean }
local BaseService = { Destroyed = Instance.new("BindableEvent") }
local bases: { [string]: Base } = {}
local connections: { RBXScriptConnection } = {}
local arena: Folder? = nil
local visuals: { [Model]: Reset.Snapshot } = {}
local boards: { BillboardGui } = {}
local currentRound = 0
function BaseService.GetAll(): { [string]: Base } return bases end
function BaseService.Get(id: string): Base? return bases[id] end
function BaseService.Start(map: Folder, roundId: number?)
	if next(bases) ~= nil then return end
	arena = map; currentRound = roundId or 1
	local epoch = currentRound
	for _, definition in Config.Teams do
		local container = map:FindFirstChild("Bases"); assert(container, "Bases missing")
		local model = container:FindFirstChild(definition.Id .. "Base")
		assert(model and model:IsA("Model"), "Base model missing")
		local humanoid = model:FindFirstChildOfClass("Humanoid")
		local root = model:FindFirstChild("HumanoidRootPart")
		assert(humanoid and root and root:IsA("BasePart"), "Base requires Humanoid and root")
		if not visuals[model] then visuals[model] = Reset.capture(model) end
		model:SetAttribute("RoundId", epoch)
		model:SetAttribute("TeamId", definition.Id); model:SetAttribute("EntityKind", "Base")
		humanoid.MaxHealth = Config.BaseHealth; humanoid.Health = Config.BaseHealth
		local base: Base = { model = model, humanoid = humanoid, root = root, teamId = definition.Id, destroyed = false }
		bases[definition.Id] = base
		Structures.Register(model)
		local billboard = Instance.new("BillboardGui"); billboard.Name = "BaseHealth"
		billboard.Size = UDim2.fromOffset(200, 68); billboard.StudsOffset = Vector3.new(0, 6, 0)
		billboard.AlwaysOnTop = true; billboard.MaxDistance = 240; billboard.Parent = root
		table.insert(boards, billboard)
		local label = Instance.new("TextLabel"); label.Size = UDim2.fromScale(1, 0.65)
		label.BackgroundTransparency = 1; label.TextColor3 = Color3.new(1, 1, 1); label.TextStrokeTransparency = 0.4
		label.TextSize = 16; label.Font = Enum.Font.GothamBold; label.Parent = billboard
		local track = Instance.new("Frame"); track.Size = UDim2.fromScale(1, 0.2); track.Position = UDim2.fromScale(0, 0.75)
		track.BackgroundColor3 = Color3.fromRGB(30, 32, 40); track.BorderSizePixel = 0; track.Parent = billboard
		local fill = Instance.new("Frame"); fill.BackgroundColor3 = definition.Color; fill.BorderSizePixel = 0; fill.Parent = track
		local function update()
			if currentRound ~= epoch or bases[definition.Id] ~= base then return end
			model:SetAttribute("MaxHealth", humanoid.MaxHealth); model:SetAttribute("CurrentHealth", humanoid.Health)
			label.Text = definition.Id .. " CORE  " .. math.ceil(humanoid.Health) .. "/" .. humanoid.MaxHealth .. "\n"
				.. (if model:GetAttribute("ProtectedByTowers") == true then "Защищена башнями" else "База уязвима")
			fill.Size = UDim2.fromScale(math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1), 1)
			if humanoid.Health <= 0 and not base.destroyed then
				base.destroyed = true; model:SetAttribute("IsDestroyed", true)
				root.Color = Color3.fromRGB(40, 42, 45); root.Material = Enum.Material.Slate
				root.CanCollide = false; root.CanQuery = false
				BaseService.Destroyed:Fire(base.teamId, epoch)
			end
		end
		model:SetAttribute("IsDestroyed", false); update()
		table.insert(connections, humanoid.HealthChanged:Connect(update))
		table.insert(connections, model:GetAttributeChangedSignal("ProtectedByTowers"):Connect(update))
	end
end
function BaseService.Reset(roundId: number)
	if roundId <= currentRound then return end
	local map = arena; assert(map)
	for _, connection in connections do connection:Disconnect() end; table.clear(connections)
	for _, board in boards do board:Destroy() end; table.clear(boards)
	for _, base in bases do
		Structures.Remove(base.model); visuals[base.model].restore()
		Reset.humanoid(base.model, Config.BaseHealth)
	end
	table.clear(bases)
	BaseService.Start(map, roundId)
end
return BaseService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="83">
          <Properties>
            <string name="Name">CharacterStatsService</string>
            <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config.ProgressionConfig)
local Logic = require(Shared.Game.ProgressionRules)
local Rules = Logic.configure(Config, require(Shared.Config.ItemConfig).Items)
local Progression = require(script.Parent.HeroProgressionService)
local Fighters = require(script.Parent.FighterStateService)
local Teams = require(script.Parent.TeamService)
local Layers = require(Shared.Abilities.StatLayers)
local modifiers: {[Model]: Layers.Layers} = setmetatable({}, {__mode="k"})
local Stats = {}
local connections: { [Player]: { RBXScriptConnection } } = {}
local healthConnections: { [Player]: RBXScriptConnection } = {}
local bonusConnections: { [Player]: RBXScriptConnection } = {}
local applied: { [Player]: Model } = {}
local started = false
function Stats.Get(player: Player): Logic.Stats
 local model = player.Character
 local bonus = if model then model:GetAttribute("StrengthBonus") else nil
 local values=Rules.stats(Progression.Get(player) or Rules.new(), if typeof(bonus)=="number" and bonus==bonus and math.abs(bonus)<math.huge then bonus else 0)
 if model and modifiers[model] then
  local m=Layers.sum(modifiers[model]); values.MaxHealth+=m.health; values.Defense+=m.armor
  values.WalkSpeed+=m.speed; values.AttackDamageBonus+=m.attack
 end
 return values
end
function Stats.GetForModel(model: Model): Logic.Stats?
 local player = Players:GetPlayerFromCharacter(model)
 return if player and Progression.Get(player) then Stats.Get(player) else nil
end
function Stats.RecalculateStats(player: Player, fullHealth: boolean?, healing: number?)
 local model = player.Character; local profile = Progression.Get(player)
 if not model or not profile then return end
 local humanoid = model:FindFirstChildOfClass("Humanoid"); if not humanoid then return end
 local values = Stats.Get(player); local before = humanoid.Health
 humanoid.MaxHealth = values.MaxHealth
 if before > 0 then humanoid.Health = if fullHealth then values.MaxHealth else math.min(values.MaxHealth, before + (healing or 0)) end
 Fighters.SetWalkSpeed(model, values.WalkSpeed)
 local folder = Progression.GetFolder(player)
 if folder then
  local fields: { [string]: number } = { MaxHealth = values.MaxHealth, WalkSpeed = values.WalkSpeed,
   AttackDamageMultiplier = values.AttackDamageMultiplier, AttackDamageBonus = values.AttackDamageBonus, Defense = values.Defense, Level = values.Level, Strength = values.Strength, RawStrength = values.RawStrength, Agility = values.Agility, RawAgility = values.RawAgility, Intelligence = values.Intelligence, MaxMana = values.MaxMana, ManaRegen = values.ManaRegen }
  for key, value in fields do folder:SetAttribute(key, value) end
  folder:SetAttribute("CurrentHealth", humanoid.Health)
 end
end
function Stats.SetLayer(model: Model,key: string,modifier: Layers.Modifier?)
 local layers=modifiers[model]
 if not layers then if not modifier then return end; layers={}; modifiers[model]=layers end
 Layers.set(layers,key,modifier)
 local player=Players:GetPlayerFromCharacter(model)
 if player then Stats.RecalculateStats(player) end
end
local function bind(player: Player, model: Model)
 task.spawn(function()
  local humanoid = model:WaitForChild("Humanoid", 10)
  if not humanoid or not humanoid:IsA("Humanoid") or player.Character ~= model or player.Parent ~= Players or applied[player] == model then return end
  applied[player] = model
  if healthConnections[player] then healthConnections[player]:Disconnect() end
  if bonusConnections[player] then bonusConnections[player]:Disconnect() end
  bonusConnections[player]=model:GetAttributeChangedSignal("StrengthBonus"):Connect(function()
   if player.Character==model then Stats.RecalculateStats(player) end
  end)
  healthConnections[player] = humanoid.HealthChanged:Connect(function(health)
   if player.Character ~= model then return end
   local folder = Progression.GetFolder(player); if folder then folder:SetAttribute("CurrentHealth", health) end
  end)
  Stats.RecalculateStats(player, true)
 end)
end
function Stats.Start()
 if started then return end; started = true
 Progression.Changed.Event:Connect(function(player: Player, reason: string, levels: number, roundId: number?)
  local match = Teams.GetState(); if match and roundId ~= match.roundId then return end
  Stats.RecalculateStats(player, reason == "Reset", levels * Config.LevelHeal)
 end)
 local function add(player: Player)
  connections[player] = {
   player.CharacterAdded:Connect(function(model) bind(player, model) end),
   player.CharacterRemoving:Connect(function()
    if healthConnections[player] then healthConnections[player]:Disconnect(); healthConnections[player] = nil end
    if bonusConnections[player] then bonusConnections[player]:Disconnect(); bonusConnections[player]=nil end
    applied[player] = nil
   end),
  }
  if player.Character then bind(player, player.Character) end
 end
 Players.PlayerAdded:Connect(add)
 Players.PlayerRemoving:Connect(function(player)
  for _, c in connections[player] or {} do c:Disconnect() end
  if healthConnections[player] then healthConnections[player]:Disconnect() end
  if bonusConnections[player] then bonusConnections[player]:Disconnect(); bonusConnections[player]=nil end
  healthConnections[player] = nil; connections[player] = nil; applied[player] = nil
 end)
 for _, player in Players:GetPlayers() do add(player) end
end
return Stats
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="84">
          <Properties>
            <string name="Name">CloneNavigation</string>
            <string name="Source"><![CDATA[--!strict
local Pathfinding = game:GetService("PathfindingService")
local Policy = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared").Abilities.CloneNavigationPolicy)
export type Agent = {
	model: Model, root: BasePart, clock: Policy.Clock, target: Model?, slot: number?, goal: Vector3?,
	waypoints: { Vector3 }, waypoint: number, pathGoal: Vector3?, nextSlot: number,
	progressAt: number, progressPosition: Vector3, failures: number, serial: number, groundOffset: number, queued: boolean,
}
local Navigation = {}
local agents: { [Model]: Agent } = {}
local waiting: { { agent: Agent, generation: number } } = {}
local serial, active, nextRequest = 0, 0, 0
local function flat(v: Vector3): Vector3 return v * Vector3.new(1, 0, 1) end
local function unqueue(agent: Agent)
	agent.queued = false
	for index = #waiting, 1, -1 do if waiting[index].agent == agent then table.remove(waiting, index) end end
end
function Navigation.Register(model: Model, root: BasePart, humanoid: Humanoid)
	serial += 1
	agents[model] = { model = model, root = root, clock = Policy.new(), target = nil, slot = nil, goal = nil,
		waypoints = {}, waypoint = 1, pathGoal = nil, nextSlot = 0, progressAt = 0,
		progressPosition = root.Position, failures = 0, serial = serial,
		groundOffset = math.max(humanoid.HipHeight + root.Size.Y / 2, math.max(4, root.Size.Y) / 2 + 0.05), queued = false }
end
function Navigation.Remove(model: Model)
	local agent = agents[model]; if not agent then return end
	Policy.cancel(agent.clock); unqueue(agent); agents[model] = nil
end
function Navigation.Stop(model: Model)
	local agent = agents[model]; if not agent then return end
	if Policy.change(agent.clock, "idle") then
		agent.target = nil; agent.slot = nil; agent.goal = nil; table.clear(agent.waypoints); agent.pathGoal = nil; unqueue(agent)
	end
	model:SetAttribute("SummonMoving", false)
end
local function parameters(agent: Agent, owner: Model, target: Model): RaycastParams
	local excluded: { Instance } = { agent.model, owner, target }
	-- Registered clones and Gamakichi use explicit body clearance/peer avoidance.
	-- World geometry remains collidable, while summon bodies never block players.
	for model in agents do table.insert(excluded, model) end
	local ray = RaycastParams.new(); ray.FilterType = Enum.RaycastFilterType.Exclude
	ray.FilterDescendantsInstances = excluded; ray.RespectCanCollide = true
	return ray
end
local function ground(agent: Agent, point: Vector3, ray: RaycastParams): Vector3?
	local hit = workspace:Raycast(point + Vector3.new(0, 2, 0), Vector3.new(0, -10, 0), ray)
	if not hit or hit.Normal.Y < 0.7 then return nil end
	return Vector3.new(point.X, hit.Position.Y + agent.groundOffset, point.Z)
end
local function bodySize(agent: Agent): Vector3
	return Vector3.new(math.max(2.2, agent.root.Size.X), math.max(4, agent.root.Size.Y), math.max(2.2, agent.root.Size.Z))
end
local function bodyClear(agent: Agent, point: Vector3, ray: RaycastParams): boolean
	local overlap = OverlapParams.new(); overlap.FilterType = Enum.RaycastFilterType.Exclude
	overlap.FilterDescendantsInstances = ray.FilterDescendantsInstances; overlap.RespectCanCollide = true
	return #workspace:GetPartBoundsInBox(CFrame.new(point), bodySize(agent), overlap) == 0
end
local function clear(agent: Agent, origin: Vector3, goal: Vector3, ray: RaycastParams): boolean
	local delta = goal - origin
	if delta.Magnitude < 0.001 then return true end
	return workspace:Blockcast(CFrame.new(origin), bodySize(agent), delta, ray) == nil
end
local function available(agent: Agent, target: Model, index: number): boolean
	for _, other in agents do
		if other ~= agent and other.target == target and other.slot == index then return false end
	end
	return true
end
local function chooseGoal(agent: Agent, target: Model, destination: BasePart, radius: number, ray: RaycastParams, now: number): Vector3?
	local center = destination.Position
	local function candidate(index: number): Vector3?
		if not available(agent, target, index) then return nil end
		local x, z = Policy.slot(index, radius, 3)
		local point = ground(agent, center + Vector3.new(x, 0, z), ray)
		if not point then return nil end
		-- Blockcast omits initial overlap, so also validate destination body bounds.
		if not bodyClear(agent, point, ray) then return nil end
		if workspace:Raycast(point, center - point, ray) then return nil end
		return point
	end
	if now < agent.nextSlot and agent.goal then
		-- Translate the existing slot with a moving target between selection ticks.
		if agent.slot then
			local x, z = Policy.slot(agent.slot, radius, 3)
			return Vector3.new(center.X + x, agent.goal.Y, center.Z + z)
		end
		return agent.goal
	end
	agent.nextSlot = now + Policy.SlotInterval
	if agent.slot and agent.failures < 2 then
		-- A settled waiting clone must claim newly freed inner positions instead
		-- of keeping its outer reservation forever after a front clone dies.
		local innerBest: Vector3? = nil; local innerSlot: number? = nil; local innerDistance = math.huge
		for index = 1, math.floor((agent.slot - 1) / 8) * 8 do
			local point = candidate(index)
			if point then
				local distance = flat(point-agent.root.Position).Magnitude
				if distance < innerDistance then innerBest = point; innerSlot = index; innerDistance = distance end
			end
			if index % 8 == 0 and innerBest then break end
		end
		if innerBest then agent.slot = innerSlot; return innerBest end
		local point = candidate(agent.slot); if point then return point end
	end
	local best: Vector3? = nil; local bestSlot: number? = nil; local bestScore = math.huge
	-- Eight attack positions plus waiting rings for mass-clone casts. Occupied
	-- slots do not query geometry; stop after the first ring with a usable slot.
	for index = 1, 64 do
		local point = candidate(index)
		if point then
			local score = flat(point - agent.root.Position).Magnitude + math.floor((index - 1) / 8) * 20
			if index == agent.slot and agent.failures >= 2 then score += 100 end
			if score < bestScore then best = point; bestSlot = index; bestScore = score end
		end
		if index % 8 == 0 and best then break end
	end
	agent.slot = bestSlot; agent.failures = 0
	return best
end
local function request(requester: Agent, now: number)
	if not requester.queued and Policy.canRequest(requester.clock, now) then
		requester.queued = true
		table.insert(waiting, { agent = requester, generation = requester.clock.generation })
	end
	if active >= Policy.MaxConcurrent or now < nextRequest then return end
	local selected: Agent? = nil
	while #waiting > 0 do
		local entry = table.remove(waiting, 1); assert(entry); local candidate = entry.agent
		if entry.generation == candidate.clock.generation and candidate.queued and agents[candidate.model] == candidate then
			candidate.queued = false
			if candidate.goal and Policy.canRequest(candidate.clock, now) then selected = candidate; break end
		end
	end
	if not selected or not selected.goal then return end
	local agent, goal = selected, selected.goal
	nextRequest = now + Policy.RequestInterval; active += 1
	local generation = Policy.begin(agent.clock, now)
	local origin = agent.root.Position
	agent.pathGoal = goal
	task.spawn(function()
		local points: { Vector3 } = {}
		local path: Path? = nil
		local ok = pcall(function()
			local computed = Pathfinding:CreatePath({ AgentRadius = math.max(1.5, agent.root.Size.X / 2, agent.root.Size.Z / 2),
				AgentHeight = math.max(5, agent.root.Size.Y), AgentCanJump = false, AgentCanClimb = false, WaypointSpacing = 3 })
			path = computed; computed:ComputeAsync(origin, goal)
			if computed.Status ~= Enum.PathStatus.Success then return end
			for _, waypoint in computed:GetWaypoints() do
				if waypoint.Action ~= Enum.PathWaypointAction.Walk then table.clear(points); return end
				table.insert(points, waypoint.Position + Vector3.new(0, agent.groundOffset, 0))
			end
		end)
		if path then path:Destroy() end
		active -= 1
		local accepted = Policy.finish(agent.clock, generation, workspace:GetServerTimeNow(), ok and #points > 1)
		if not accepted or agents[agent.model] ~= agent then return end
		-- A completed calculation for an old moving goal cannot replace the current route.
		if not agent.goal or flat(agent.goal - goal).Magnitude > Policy.GoalDrift then agent.pathGoal = nil; return end
		if ok and #points > 1 then
			agent.waypoints = points; agent.waypoint = 2
		else
			table.clear(agent.waypoints); agent.pathGoal = nil; agent.failures += 1
		end
	end)
end
local function peerClear(agent: Agent, nextPosition: Vector3, destination: BasePart): boolean
	local origin, center = agent.root.Position, destination.Position
	if math.abs(center.Y-nextPosition.Y) < 4 and not Policy.clearPeer(origin.X,origin.Z,nextPosition.X,nextPosition.Z,
		center.X,center.Z,(agent.root.Size.X+destination.Size.X)/2+0.2) then return false end
	for _, other in agents do
		if other ~= agent and math.abs(other.root.Position.Y - nextPosition.Y) < 4 then
			local p = other.root.Position; local a = agent.root.Position
			local spacing = (agent.root.Size.X + other.root.Size.X) / 2 + 0.35
			if not Policy.clearPeer(a.X, a.Z, nextPosition.X, nextPosition.Z, p.X, p.Z, spacing) then return false end
		end
	end
	return true
end
function Navigation.Step(model: Model, owner: Model, target: Model, destination: BasePart, radius: number, now: number, delta: number, speed: number): boolean
	local agent = agents[model]; if not agent then return false end
	if agent.target ~= target then
		Policy.change(agent.clock, tostring(agent.clock.generation + 1))
		agent.target = target; agent.slot = nil; agent.goal = nil; agent.pathGoal = nil; unqueue(agent)
		table.clear(agent.waypoints); agent.nextSlot = 0; agent.failures = 0; agent.progressAt = now
		agent.progressPosition = agent.root.Position
	end
	local ray = parameters(agent, owner, target)
	agent.goal = chooseGoal(agent, target, destination, math.max(2.5, radius - 0.65), ray, now)
	local goal = agent.goal
	if not goal then return false end
	local position = agent.root.Position
	if flat(goal - position).Magnitude < 0.3 then agent.progressAt = now; return false end
	if flat(position - agent.progressPosition).Magnitude > 0.4 then
		agent.progressPosition = position; agent.progressAt = now
	elseif now - agent.progressAt > Policy.StuckTime then
		table.clear(agent.waypoints); agent.pathGoal = nil; agent.failures += 1; agent.progressAt = now
	end
	local aim = goal
	if not clear(agent, position, goal, ray) then
		while agent.waypoint <= #agent.waypoints and flat(agent.waypoints[agent.waypoint] - position).Magnitude < 0.5 do agent.waypoint += 1 end
		local waypoint = agent.waypoints[agent.waypoint]
		if waypoint then aim = waypoint else aim = position end
		if not agent.pathGoal or flat(agent.pathGoal - goal).Magnitude > Policy.GoalDrift or not waypoint then request(agent, now) end
	else
		table.clear(agent.waypoints); agent.pathGoal = nil; unqueue(agent)
	end
	local direction = flat(aim - position)
	if direction.Magnitude < 0.001 then return false end
	local length = math.min(direction.Magnitude, speed * math.clamp(delta, 0, 0.1))
	local forward = direction.Unit
	-- Look ahead beyond this frame's step. A short sidestep only at contact can
	-- oscillate against a settled melee ring; steer toward a tangent beside its
	-- nearest blocking body before reaching contact instead.
	local blockerRoot: BasePart? = nil; local nearest = math.huge
	local look = position + forward * math.min(direction.Magnitude, 6)
	for _, other in agents do
		local p = other.root.Position
		if other ~= agent and math.abs(p.Y-position.Y) < 4 then
			local spacing = (agent.root.Size.X + other.root.Size.X) / 2 + 0.5
			local distance = flat(p-position).Magnitude
			if distance < nearest and not Policy.clearPeer(position.X,position.Z,look.X,look.Z,p.X,p.Z,spacing) then
				blockerRoot = other.root; nearest = distance
			end
		end
	end
	local center = destination.Position
	if math.abs(center.Y-position.Y) < 4 and flat(center-position).Magnitude < nearest
		and not Policy.clearPeer(position.X,position.Z,look.X,look.Z,center.X,center.Z,(agent.root.Size.X+destination.Size.X)/2+0.5) then
		blockerRoot = destination
	end
	if blockerRoot then
		local side = if agent.serial % 2 == 0 then 1 else -1
		local spacing = (agent.root.Size.X + blockerRoot.Size.X) / 2 + 1
		local tangent = flat(blockerRoot.Position-position) + Vector3.new(-forward.Z,0,forward.X) * side * spacing
		if tangent.Magnitude > 0.001 then forward = tangent.Unit end
	end
	-- Deterministic side preference breaks symmetric head-on deadlocks; final sweep
	-- and peer segment checks are mandatory even for local avoidance steps.
	local side = if agent.serial % 2 == 0 then 1 else -1
	for _, angle in { 0, side * math.pi/4, -side * math.pi/4, side * math.pi/2, -side * math.pi/2 } do
		local rotated = Vector3.new(forward.X * math.cos(angle) - forward.Z * math.sin(angle), 0,
			forward.X * math.sin(angle) + forward.Z * math.cos(angle))
		local point = ground(agent, position + rotated * length, ray)
		if point and math.abs(point.Y - position.Y) <= length + 0.25 and clear(agent, position, point, ray)
			and bodyClear(agent, point, ray) and peerClear(agent, point, destination) then
			model:PivotTo(model:GetPivot() + (point - position)); return true
		end
	end
	return false
end
return Navigation
]]></string>
          </Properties>
