        <Item class="ModuleScript" referent="85">
          <Properties>
            <string name="Name">CloneService</string>
            <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config.AbilityConfig).Clones
local Damage = require(script.Parent.DamageService)
local Stats = require(script.Parent.CharacterStatsService)
local Targets = require(script.Parent.AbilityTargetService)
local Hitboxes = require(script.Parent.HitboxService)
local Collision = require(script.Parent.SummonCollision)
export type Clone = { model: Model, root: BasePart, humanoid: Humanoid, owner: Player, character: Model,
	expires: number, nextHit: number, hits: number }
local CloneService = { Spawned = Instance.new("BindableEvent") }
local records: { [Model]: Clone } = {}
local count, nextUpdate = 0, 0
function CloneService.GetCount(): number return count end
function CloneService.GetAll(): { [Model]: Clone } return records end
function CloneService.Remove(model: Model)
	if not records[model] then return end
	records[model] = nil; count -= 1; model:Destroy()
end
function CloneService.ClearOwner(player: Player)
	for model, record in records do if record.owner == player then CloneService.Remove(model) end end
end
function CloneService.Reset()
	for model in records do CloneService.Remove(model) end
	nextUpdate = 0
end
function CloneService.Spawn(player: Player, character: Model): number
	if player.Character ~= character or not Damage.CanAct(character) then return 0 end
	CloneService.ClearOwner(player)
	local root = character:FindFirstChild("HumanoidRootPart")
	if not root or not root:IsA("BasePart") or not Hitboxes.IsFiniteCFrame(root.CFrame) then return 0 end
	local folder = workspace:FindFirstChild("HeroSummons")
	if not folder then folder = Instance.new("Folder"); folder.Name = "HeroSummons"; folder.Parent = workspace end
	local spawned = 0
	for i = 1, Config.Count do
		if count >= Config.GlobalLimit then break end
		local previous = character.Archivable; character.Archivable = true
		local model = character:Clone(); character.Archivable = previous
		for _, item in model:GetDescendants() do
			if item:IsA("LuaSourceContainer") or item:IsA("Tool") or item:IsA("ForceField") then item:Destroy()
			elseif item:IsA("BasePart") then item.CanCollide = false; item.CanTouch = false; item.CanQuery = false; item.Massless = true end
		end
		model.Name = "ShadowClone"; model:SetAttribute("EntityKind", "Summon"); model:SetAttribute("SummonOwner", player.UserId)
		model:SetAttribute("CombatDisabled", false); model:SetAttribute("CombatState", "Idle")
		model:SetAttribute("AbilityId", ""); model:SetAttribute("LifeId", nil)
		model:SetAttribute("CombatLastAttackAt", 0); model:SetAttribute("CombatAttackEndsAt", 0)
		local cloneRoot = model:FindFirstChild("HumanoidRootPart") :: BasePart
		local humanoid = model:FindFirstChildOfClass("Humanoid") :: Humanoid
		humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None; humanoid.BreakJointsOnDeath = false
		humanoid.MaxHealth = 100; humanoid.Health = 100
		cloneRoot.Anchored = true; model.PrimaryPart = cloneRoot
		model:PivotTo(root.CFrame)
		local offset = root.CFrame.RightVector * (if i % 2 == 0 then Config.SpawnOffset else -Config.SpawnOffset) + root.CFrame.LookVector * Config.SpawnForward
		local ray = RaycastParams.new(); ray.FilterType = Enum.RaycastFilterType.Exclude; ray.FilterDescendantsInstances = { character, folder :: Instance }; ray.RespectCanCollide = true
		local wall = workspace:Blockcast(root.CFrame, Vector3.new(2, 4, 2), offset, ray)
		if wall then offset = offset.Unit * math.max(0, wall.Distance - 0.3) end
		Collision.Apply(model)
		model:PivotTo(root.CFrame + offset); model.Parent = folder
		local now = workspace:GetServerTimeNow()
		records[model] = { model = model, root = cloneRoot, humanoid = humanoid, owner = player, character = character,
			expires = now + Config.Lifetime, nextHit = now + Config.Interval, hits = 0 }
		count += 1; spawned += 1; CloneService.Spawned:Fire(model)
	end
	return spawned
end
function CloneService.Update(now: number)
	-- Cleanup is checked every server tick; target search is shared and capped at 10 Hz.
	for model, record in records do
		if not model.Parent or record.owner.Parent ~= Players or record.owner.Character ~= record.character
			or not Damage.CanAct(record.character) or now >= record.expires then CloneService.Remove(model) end
	end
	if now < nextUpdate then return end; nextUpdate = now + Config.UpdateInterval
	for model, record in records do
		local target = if record.hits < Config.MaxHits then Targets.Nearest(record.character, record.root.CFrame, Config.Radius, -1, false) else nil
		local targetModel = if target then target.Parent else nil
		local targetRoot = if targetModel then targetModel:FindFirstChild("HumanoidRootPart") else nil
		if not target or not targetModel or not targetModel:IsA("Model") or not targetRoot or not targetRoot:IsA("BasePart") then model:SetAttribute("SummonMoving", false); continue end
		local delta = targetRoot.Position - record.root.Position
		local horizontal = delta * Vector3.new(1, 0, 1)
		if horizontal.Magnitude > 0.001 then record.root.CFrame = CFrame.lookAt(record.root.Position, record.root.Position + horizontal) end
		if delta.Magnitude <= Config.Range then
			model:SetAttribute("SummonMoving", false)
			if now >= record.nextHit and Targets.Visible(record.character, targetModel, record.root.Position, targetRoot.Position) then
				record.nextHit = now + Config.Interval; record.hits += 1
				model:SetAttribute("SummonSwingAt", now); model:SetAttribute("SummonSwingStep", (record.hits - 1) % 2 + 1)
				local stats = Stats.GetForModel(record.character)
				Damage.Apply(record.character, target, Config.Damage * (if stats then stats.AttackDamageMultiplier else 1))
			end
		else
			model:SetAttribute("SummonMoving", true)
			if horizontal.Magnitude < 0.001 then continue end
			local step = horizontal.Unit * math.min(horizontal.Magnitude - Config.Range * 0.8, Config.Speed * Config.UpdateInterval)
			local ray = RaycastParams.new(); ray.FilterType = Enum.RaycastFilterType.Exclude
			ray.FilterDescendantsInstances = { record.character, model.Parent :: Instance, targetModel }; ray.RespectCanCollide = true
			local wall = workspace:Blockcast(record.root.CFrame, Vector3.new(2, 4, 2), step, ray)
			if not wall then model:PivotTo(record.root.CFrame + step) end
		end
	end
end
Players.PlayerRemoving:Connect(CloneService.ClearOwner)
return CloneService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="86">
          <Properties>
            <string name="Name">CombatLifeService</string>
            <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Ledger = require(Shared.Game.RewardLedger)
local Config = require(Shared.Config.ProgressionConfig)
local Structures = require(Shared.Game.StructureRules)
export type Death = { lifeId: number, roundId: number?, model: Model, victimUserId: number?, teamId: string, kind: string, minionType: string,
 position: Vector3, killer: Ledger.Actor?, assists: { Ledger.Actor } }
type Life = { id: number, model: Model, humanoid: Humanoid, ledger: Ledger.Ledger, scheduled: boolean, onDeath: (() -> ())?, connections: { RBXScriptConnection } }
local LifeService = { Died = Instance.new("BindableEvent") }
local lives: { [Model]: Life } = {}
local serial, generation = 0, 0
function LifeService.Remove(model: Model)
 local life = lives[model]; if not life then return end
 for _, connection in life.connections do connection:Disconnect() end
 lives[model] = nil
end
function LifeService.Register(model: Model)
	if lives[model] or Structures.isStructure(model:GetAttribute("EntityKind")) or model:GetAttribute("EntityKind") == "Summon" then return end
 local humanoid = model:FindFirstChildOfClass("Humanoid"); if not humanoid then return end
 serial += 1
 local life: Life = { id = serial, model = model, humanoid = humanoid, ledger = Ledger.new(), scheduled = false, connections = {} }
 lives[model] = life; model:SetAttribute("LifeId", serial)
 local function died()
  if life.scheduled then return end; life.scheduled = true
  local time = workspace:GetServerTimeNow()
  local position = model:GetPivot().Position
  local epoch = generation
  -- Defer until Damage.Apply has recorded the confirmed lethal damage.
  task.defer(function()
   if epoch ~= generation then return end
   local claimed, killer, assists = Ledger.claim(life.ledger, math.max(time, workspace:GetServerTimeNow()), Config.AttributionWindow)
   if not claimed then return end
   local player = Players:GetPlayerFromCharacter(model)
   local death: Death = { lifeId = life.id, roundId = model:GetAttribute("RoundId") :: number?, model = model, victimUserId = if player then player.UserId else nil,
    teamId = tostring(model:GetAttribute("TeamId") or ""), kind = tostring(model:GetAttribute("EntityKind") or ""),
    minionType = tostring(model:GetAttribute("MinionType") or ""), position = position, killer = killer, assists = assists }
   LifeService.Died:Fire(death)
  end)
 end
 life.onDeath = died
 table.insert(life.connections, humanoid.Died:Connect(died))
 table.insert(life.connections, model.AncestryChanged:Connect(function()
  if not model:IsDescendantOf(workspace) then LifeService.Remove(model) end
 end))
 if humanoid.Health <= 0 then died() end
end
function LifeService.Record(attacker: Model, victim: Model)
 LifeService.Register(victim)
 local life = lives[victim]; if not life then return end
 local player = Players:GetPlayerFromCharacter(attacker)
 if not player and (attacker:GetAttribute("NativeNarutoClone") == true or attacker:GetAttribute("NativeGamakichi")==true) then
  local owner = attacker:GetAttribute("SummonOwner")
  if typeof(owner) == "number" then player = Players:GetPlayerByUserId(owner) end
 end
 local actor: Ledger.Actor = { userId = if player then player.UserId else nil, teamId = tostring(attacker:GetAttribute("TeamId") or "") }
 Ledger.record(life.ledger, actor, tostring(victim:GetAttribute("TeamId") or ""), workspace:GetServerTimeNow())
 -- A freshly spawned Humanoid can reach zero HP before its first physics step
 -- without firing Died. Confirm death after recording the lethal hit; the same
 -- scheduled flag deduplicates the later engine event.
 if life.humanoid.Health <= 0 and life.onDeath then life.onDeath() end
end
function LifeService.ResetHistory()
 generation += 1
 for _, life in lives do life.ledger = Ledger.new() end
end
function LifeService.Reset()
 generation += 1
 for model in lives do LifeService.Remove(model) end
end
Players.PlayerRemoving:Connect(function(player)
 for _, life in lives do Ledger.forget(life.ledger, player.UserId) end
 if player.Character then LifeService.Remove(player.Character) end
end)
return LifeService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="87">
          <Properties>
            <string name="Name">CombatService</string>
            <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config.CombatConfig)
local Debug = require(Shared.Config.DebugConfig)
local Protocol = require(Shared.Combat.CombatProtocol)
local State = require(Shared.Combat.CombatState)
local Fighters = require(script.Parent.FighterStateService)
local Hitboxes = require(script.Parent.HitboxService)
local AttackRules = require(Shared.Combat.BasicAttackRules)
local RequestLimiter = require(script.Parent.RequestLimiter)
local Damage = require(script.Parent.DamageService)
local Sleep = require(script.Parent.NarutoSleepService)
local Stats = require(script.Parent.CharacterStatsService)
local Structures = require(Shared.Game.StructureRules)
local Teams = require(script.Parent.TeamService)
local RoundProtocol = require(Shared.Game.RoundProtocol)

type Session = { bucket: RequestLimiter.Bucket, lastRequestId: number, lastRejectAt: number }
local CombatService = { AttackStarted = Instance.new("BindableEvent") }
-- A prepared melee technique may replace the ordinary strike after the server
-- has verified contact. It must never consume itself merely on attack intent.
local contactHandler: ((Fighters.Fighter, Model) -> boolean)? = nil
function CombatService.SetContactHandler(handler: (Fighters.Fighter, Model) -> boolean)
	contactHandler = handler
end
local sessions: { [Player]: Session } = {}
local eventRemote: RemoteEvent? = nil
local started = false

local function broadcastState(fighter: Fighters.Fighter)
	local remote = eventRemote
	if remote then
		remote:FireAllClients({ kind = "State", snapshot = Fighters.Snapshot(fighter) })
	end
end

local function reject(player: Player, requestId: number, character: Model?, reason: string)
	local remote = eventRemote
	if not remote then return end
	local fighter = if character then Fighters.Get(character) else nil
	remote:FireClient(player, {
		kind = "Rejected", requestId = requestId, character = character, reason = reason,
		snapshot = if fighter then Fighters.Snapshot(fighter) else nil,
	})
end

local function announceStart(fighter: Fighters.Fighter)
	local attack, remote = fighter.logic.active, eventRemote
	if not attack or not remote then return end
	Fighters.Publish(fighter)
	fighter.attackLifeId = fighter.character:GetAttribute("LifeId")
	fighter.attackRoundId = fighter.character:GetAttribute("RoundId")
	fighter.wakeOnlyAttackId=nil
	local candidates=Hitboxes.GetTargets(fighter.character,fighter.root,fighter.profile,function(target)
		return Sleep.CanWakeAlly(fighter.character,target)
	end)
    local first=candidates[1]
    local model=if first then first.Parent else nil
    local wakeOnly=model~=nil and model:IsA("Model") and Sleep.TryWakeAlly(fighter.character,model)
    if wakeOnly then fighter.wakeOnlyAttackId=attack.id end
    for _,hp in candidates do
        local target=hp.Parent
        if target and target:IsA("Model") and Damage.CanDamage(fighter.character,target) then Damage.AttackAttempt:Fire(fighter.character,target) end
    end
    if not wakeOnly then CombatService.AttackStarted:Fire(fighter) end
	remote:FireAllClients({ kind = "Started", snapshot = Fighters.Snapshot(fighter), attack = attack })
	if Debug.LogCombat then
		print(string.format("[Combat] %s M1-%d request=%d", fighter.character.Name, attack.step, attack.requestId))
	end
end

local function canAttack(fighter: Fighters.Fighter): boolean
	return fighter.character:IsDescendantOf(Workspace)
		and Damage.CanAct(fighter.character)
		and not (fighter.sleep and fighter.sleep.active)
		and ((fighter.character:GetAttribute("NarutoPausedUntil") or 0) :: number) <= Workspace:GetServerTimeNow()
		and (fighter.character:GetAttribute("AbilityId") == nil or fighter.character:GetAttribute("AbilityId") == "")
		and fighter.humanoid.Health > 0
		and fighter.humanoid:GetState() ~= Enum.HumanoidStateType.Dead
		and fighter.root:IsDescendantOf(fighter.character)
		and not fighter.root.Anchored
		and Hitboxes.IsFiniteCFrame(fighter.root.CFrame)
end

local function attackSpeed(fighter: Fighters.Fighter): number
	local stats = Stats.GetForModel(fighter.character)
	return AttackRules.speed(fighter.profile, if stats then stats.Agility else 0)
end
-- Only request identity and the exact current character may come from the client.
function CombatService.TryAttack(player: Player, ...: any): string
	if player.Parent ~= Players then return "Rejected" end
	local now = Workspace:GetServerTimeNow()
	local session = sessions[player]
	if not session then
		session = {
			bucket = RequestLimiter.new(Config.RemoteLimit.Burst, Config.RemoteLimit.RequestsPerSecond, now),
			lastRequestId = 0, lastRejectAt = 0,
		}
		sessions[player] = session
	end
	local allowed = RequestLimiter.Consume(session.bucket, now)
	local requestId, characterValue = ...
	local validId = typeof(requestId) == "number" and requestId == requestId
		and requestId >= 1 and requestId <= Config.MaxRequestId and requestId % 1 == 0
	if not validId then return "Rejected" end
	if not allowed then
		if now - session.lastRejectAt >= Config.RemoteLimit.RejectReplyInterval then
			session.lastRejectAt = now
			reject(player, requestId, player.Character, "RateLimited")
		end
		return "Rejected"
	end
	if select("#", ...) ~= 2 or typeof(characterValue) ~= "Instance" then
		reject(player, requestId, player.Character, "Malformed")
		return "Rejected"
	end
	local character = characterValue :: Instance
	if not character:IsA("Model") or character ~= player.Character then
		reject(player, requestId, player.Character, "Malformed")
		return "Rejected"
	end
	if requestId <= session.lastRequestId then
		reject(player, requestId, character, "Replay")
		return "Rejected"
	end
	session.lastRequestId = requestId
	local fighter = Fighters.GetOrCreate(character)
	if not fighter or not canAttack(fighter) then
		reject(player, requestId, character, "Unavailable")
		return "Rejected"
	end
	Fighters.Update(fighter, now)
	local result, reason = State.Request(fighter.logic, fighter.profile, now, requestId, attackSpeed(fighter))
	if result == "Started" then
		announceStart(fighter)
	elseif result == "Buffered" then
		local remote = eventRemote
		if remote then remote:FireClient(player, { kind = "Buffered", requestId = requestId, snapshot = Fighters.Snapshot(fighter) }) end
	else
		reject(player, requestId, character, reason or "Unavailable")
	end
	return result
end

local function resolveHit(fighter: Fighters.Fighter, attack: State.Attack)
	-- This committed swing already woke its one ally at attack-start. It must not
	-- retarget an enemy at impact or consume a held Rasengan/offensive proc.
	if fighter.wakeOnlyAttackId==attack.id then return end
	if Fighters.Get(fighter.character) ~= fighter
		or fighter.attackLifeId ~= fighter.character:GetAttribute("LifeId")
		or fighter.attackRoundId ~= fighter.character:GetAttribute("RoundId")
		or not canAttack(fighter) then return end
	local profile = fighter.profile
	local targets, box, size = Hitboxes.GetTargets(fighter.character, fighter.root, profile)
	local hits = {}
	local stats = Stats.GetForModel(fighter.character)
	local multiplier = if stats then stats.AttackDamageMultiplier else 1
	for _, humanoid in targets do
		local character = humanoid.Parent
		if not character or not character:IsA("Model") then continue end
		local isStructure = Structures.isStructure(character:GetAttribute("EntityKind"))
		local victim = if isStructure then nil else Fighters.GetOrCreate(character)
		if not isStructure and not victim then continue end
		local handler = contactHandler
		if handler and handler(fighter, character) then continue end
		local dealt = Damage.ApplyAttack(fighter.character, humanoid, profile.Damage * multiplier + (if stats then stats.AttackDamageBonus else 0))
		-- Only confirmed server damage is a hit.
		if dealt <= 0 then continue end
		local position = character:GetPivot().Position
		table.insert(hits, { character = character, position = position })
	end
	local remote = eventRemote
	if remote then
		remote:FireAllClients({
			kind = "Hit", snapshot = Fighters.Snapshot(fighter), attackId = attack.id,
			step = attack.step, hits = hits,
			hitboxCFrame = if Debug.DebugHitboxes then box else nil,
			hitboxSize = if Debug.DebugHitboxes then size else nil,
		})
	end
end

local function heartbeat()
	local now = Workspace:GetServerTimeNow()
	for character, fighter in Fighters.GetAll() do
		if not character:IsDescendantOf(Workspace) then
			Fighters.Remove(character)
			continue
		end
		Fighters.Update(fighter, now)
		local attack = State.ClaimHit(fighter.logic, now)
		if attack then resolveHit(fighter, attack) end
		local requestId, valid = State.TakeBuffer(fighter.logic, now)
		if requestId then
			if valid and canAttack(fighter) then
				local result = State.Request(fighter.logic, fighter.profile, now, requestId, attackSpeed(fighter))
				if result == "Started" then announceStart(fighter) end
			elseif fighter.player then
				reject(fighter.player, requestId, character, "BufferExpired")
			end
		end
	end
end

-- Trusted server callers use TryAttack; network callers must carry the round.
function CombatService.HandleRequest(player: Player, ...: any): string
	local match = Teams.GetState()
	if not match then return CombatService.TryAttack(player, ...) end
	local args = table.pack(...)
	if not RoundProtocol.accepts(match.roundId, args[args.n]) then return "Rejected" end
	return CombatService.TryAttack(player, table.unpack(args, 1, args.n - 1))
end
function CombatService.Start()
	if started then return end
	local existingFolder = ReplicatedStorage:FindFirstChild(Protocol.FolderName)
	assert(not existingFolder or existingFolder:IsA("Folder"), "CombatRemotes must be a Folder")
	local folder = existingFolder or Instance.new("Folder")
	folder.Name = Protocol.FolderName
	local function makeRemote(name: string): RemoteEvent
		local existing = folder:FindFirstChild(name)
		assert(not existing or existing:IsA("RemoteEvent"), name .. " must be a RemoteEvent")
		local remote = (existing or Instance.new("RemoteEvent")) :: RemoteEvent
		remote.Name = name
		remote.Parent = folder
		return remote
	end
	local request = makeRemote(Protocol.BasicAttackName)
	eventRemote = makeRemote(Protocol.EventName)
	request.OnServerEvent:Connect(function(player: Player, ...: any)
		CombatService.HandleRequest(player, ...)
	end)
	Players.PlayerRemoving:Connect(function(player: Player) sessions[player] = nil end)
	Fighters.Changed.Event:Connect(broadcastState)
	Fighters.Start()
	RunService.Heartbeat:Connect(heartbeat)
	started = true
	folder.Parent = ReplicatedStorage
end

return CombatService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="88">
          <Properties>
            <string name="Name">DamageService</string>
            <string name="Source"><![CDATA[--!strict
local Teams = require(script.Parent.TeamService)
local Stats = require(script.Parent.CharacterStatsService)
local Life = require(script.Parent.CombatLifeService)
local Structures = require(script.Parent.StructureService)
local TowerRewards = require(script.Parent.TowerRewardService)
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Rules = require(Shared.Game.ProgressionRules).configure(require(Shared.Config.ProgressionConfig), require(Shared.Config.ItemConfig).Items)
local DamageService = { Applied = Instance.new("BindableEvent"), AttackAttempt = Instance.new("BindableEvent") }
local enabled = true
local Oil=require(script.Parent.OilStatusService)
function DamageService.SetEnabled(value: boolean) enabled = value end
function DamageService.CanAct(model: Model): boolean
	if not enabled or model:GetAttribute("CombatDisabled") == true or not model:IsDescendantOf(workspace) then return false end
	local state = Teams.GetState()
	local player = game:GetService("Players"):GetPlayerFromCharacter(model)
	if state and player and not Teams.IsParticipant(player) then return false end
	if state and (state.phase ~= "InProgress" or model:GetAttribute("RoundId") ~= state.roundId or not (Teams.IsNeutral(model) or Teams.IsActive(Teams.GetId(model)))) then return false end
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	return humanoid ~= nil and humanoid.Health > 0
end
function DamageService.CanDamage(attacker: Model, target: Model): boolean
return DamageService.CanAct(attacker) and DamageService.CanAct(target) and Teams.IsEnemy(attacker, target)
		and (target:GetAttribute("EntityKind") ~= "Summon" or target:GetAttribute("NativeNarutoClone") == true or target:GetAttribute("NativeGamakichi")==true or target:GetAttribute("NativeMeditationClone")==true)
		and target:GetAttribute("IsDestroyed") ~= true
		and Structures.CanReceive(target)
end
function DamageService.Apply(attacker: Model, humanoid: Humanoid, amount: number): number
	local target = humanoid.Parent
	if not target or not target:IsA("Model") or not DamageService.CanDamage(attacker, target) then return 0 end
	if amount ~= amount or amount <= 0 or amount == math.huge then return 0 end
	local before = humanoid.Health
	if attacker:GetAttribute("NativeNarutoClone") == true then amount *= (attacker:GetAttribute("OutgoingDamageMultiplier") :: number) end
	if target:GetAttribute("NativeNarutoClone") == true then amount *= (target:GetAttribute("IncomingDamageMultiplier") :: number) end
	local stats = Stats.GetForModel(target)
	if stats then amount = Rules.mitigate(amount, stats.Defense)
	elseif target:GetAttribute("NativeGamakichi")==true then amount=Rules.mitigate(amount,(target:GetAttribute("SummonArmor") or 0) :: number) end
	Life.Register(target)
	humanoid:TakeDamage(math.min(amount, before))
	local dealt = math.max(0, before - humanoid.Health)
	if dealt > 0 then
		TowerRewards.Confirmed(attacker, target)
		Life.Record(attacker, target)
		local match = Teams.GetState()
		DamageService.Applied:Fire(attacker, target, dealt, if match then match.roundId else nil)
	end
	return dealt
end
function DamageService.ApplyAttack(attacker: Model,humanoid: Humanoid,amount: number): number
 local target=humanoid.Parent; if target and target:IsA("Model") and DamageService.CanDamage(attacker,target) then DamageService.AttackAttempt:Fire(attacker,target) end
 if Oil.MissesAttack(attacker) then return 0 end
 return DamageService.Apply(attacker,humanoid,amount)
end
return DamageService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="89">
          <Properties>
            <string name="Name">DeveloperCommandService</string>
            <string name="Source"><![CDATA[--!strict
-- Studio-only command boundary. No arbitrary code, player targets, or live-server access.
local RunService=game:GetService("RunService")
local Players=game:GetService("Players")
local RS=game:GetService("ReplicatedStorage")
local Shared=RS:WaitForChild("Shared")
local Parser=require(Shared.Game.DeveloperCommandRules)
local Progression=require(script.Parent.HeroProgressionService)
local Rules=require(Shared.Game.ProgressionRules).configure(require(Shared.Config.ProgressionConfig),require(Shared.Config.ItemConfig).Items)
local Learning=require(Shared.Abilities.SkillLearning)
local Naruto=require(script.Parent.NarutoAbilityService)
local Kcm=require(script.Parent.NarutoKcmService)
local Kurama=require(script.Parent.NarutoKuramaService)
local Ranged=require(script.Parent.NarutoRangedService)
local Gama=require(script.Parent.GamakichiService)
local Service={}
local noCooldown: {[Player]: boolean}={}
local requests: {[Player]: number}={}
local started=false
local help="level 30 — уровень • learnall — изучить навыки\nrikudo — сразу включить Рикудо без Хагоромо\nnocd on / nocd off — убрать / вернуть КД\nrefresh — восстановить HP, чакру и КД\nsolo — начать тест одному • help — команды"
local function cooldowns(player: Player)
 local s=Naruto.Get(player)
 if s then
  s.q.cooldownAt=0;s.clones.cooldownAt=0;s.sage.cooldownAt=0;s.gama.cooldownAt=0;s.meditationRecallAt=0
  table.clear(s.variants.cooldowns);s.nextPublish=0
 end
 local toad=Gama.Get(player);if toad then toad.spells.oilReady=0;toad.spells.chopReady=0 end
 local ranged=Ranged.Inspect(player);if ranged then table.clear(ranged.cooldowns) end
 Kcm.StudioResetCooldowns(player);Kurama.StudioResetCooldowns(player)
 local model=player.Character
 if model then for name in model:GetAttributes() do if string.sub(name,1,6)=="Ready_" then model:SetAttribute(name,0) end end end
end
function Service.Execute(player: Player,raw: any): (boolean,string)
 if not RunService:IsStudio() or player.Parent~=Players then return false,"Команды доступны только в Studio." end
 local command=Parser.parse(raw);if not command then return false,"Неизвестная команда. Введите help." end
 if command.name=="help" then return true,help end
 if command.name=="solo" then
  local match=require(script.Parent.MatchService).GetState()
  if not match or match.phase=="Finished" then return false,"Перезапустите Play для нового матча." end
  workspace:SetAttribute("DeveloperSoloMode",true)
  return true,"Одиночный тест включён. Матч начнётся после подготовки."
 end
 local profile=Progression.Get(player);local s=Naruto.Get(player)
 if not profile or not s then return false,"Дождитесь появления героя." end
 if command.name=="rikudo" then
  local match=require(script.Parent.MatchService).GetState()
  if not match or match.phase~="InProgress" or not player.Character or not require(script.Parent.DamageService).CanAct(player.Character) then
   return false,"Дождитесь начала матча и появления живого героя."
  end
  local raised,message=Service.Execute(player,"level "..math.max(27,profile.Level))
  if not raised then return false,message end
  while Learning.reason(profile,"KCM")==nil do Learning.learn(profile,"KCM") end
  Progression.Publish(player)
  local ok,reason=Kcm.StudioEnableRikudo(player)
  if not ok then return false,"Не удалось включить Рикудо: завершите текущую технику или оглушение и повторите rikudo. ("..reason..")" end
  return true,if reason=="AlreadyActive" then "Рикудо уже активен, чакра пополнена. F8 закрыть → X выйти → rikudo для повторного перехода."
   else "Рикудо включён без ожидания Хагоромо. F8 закрыть; X — выйти. Для повторного перехода: rikudo."
 elseif command.name=="level" then
  local target=command.level :: number
  if target<profile.Level then return false,"Команда повышает уровень. Для сброса перезапустите Play." end
  local xp=-profile.CurrentXP
  for level=profile.Level,target-1 do xp+=Rules.required(level) end
  local gained=Rules.addXP(profile,math.max(0,xp))
  local match=require(script.Parent.TeamService).GetState()
  Progression.Publish(player);Progression.Changed:Fire(player,"XP",gained,if match then match.roundId else nil)
  return true,"Уровень: "..profile.Level..". Очки навыков: "..profile.SkillPoints.."."
 elseif command.name=="learnall" then
  for _,id in Learning.Order do while Learning.reason(profile,id)==nil do Learning.learn(profile,id) end end
  Progression.Publish(player)
  return true,"Изучены все навыки, доступные на текущем уровне."
 elseif command.name=="nocd" then
  noCooldown[player]=command.enabled==true;player:SetAttribute("DeveloperNoCooldown",command.enabled)
  if command.enabled then cooldowns(player) end
  return true,if command.enabled then "КД отключены. Подготовка и условия техник сохраняются." else "Обычные КД включены для следующих применений."
 elseif command.name=="refresh" then
  cooldowns(player);s.pool.mana=s.pool.maximum
  local humanoid=if player.Character then player.Character:FindFirstChildOfClass("Humanoid") else nil
  if humanoid and humanoid.Health>0 then humanoid.Health=humanoid.MaxHealth end
  return true,"HP, чакра и перезарядки восстановлены."
 end
 return false,"Неизвестная команда."
end
function Service.Start()
 if started or not RunService:IsStudio() then return end;started=true
 local remote=Instance.new("RemoteEvent");remote.Name="DeveloperCommand";remote.Parent=RS
 remote.OnServerEvent:Connect(function(player,raw,...)
  if not RunService:IsStudio() or select("#",...)~=0 then return end
  local now=os.clock();if now<(requests[player] or 0) then return end;requests[player]=now+.15
  local ok,message=Service.Execute(player,raw);remote:FireClient(player,ok,message)
 end)
 RunService.Heartbeat:Connect(function()
  for player,enabled in noCooldown do if enabled and player.Parent==Players then cooldowns(player) end end
 end)
 Players.PlayerRemoving:Connect(function(player) noCooldown[player]=nil;requests[player]=nil end)
end
return Service
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="90">
          <Properties>
            <string name="Name">EconomyService</string>
            <string name="Source"><![CDATA[--!strict
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config.ProgressionConfig)
local Rules = require(Shared.Game.ProgressionRules).configure(Config, require(Shared.Config.ItemConfig).Items)
local Teams = require(script.Parent.TeamService)
local Economy = { GoldChanged = Instance.new("BindableEvent"), GoldSpent = Instance.new("BindableEvent") }
local balances: { [Player]: number } = {}
local function roundId(): number? local state = Teams.GetState(); return if state then state.roundId else nil end
function Economy.IsEligible(player: Player): boolean
 local state = Teams.GetState()
 local id = player:GetAttribute("TeamId")
 return player.Parent == game:GetService("Players") and state ~= nil and state.phase == "InProgress"
  and Teams.IsParticipant(player) and typeof(id) == "string" and Teams.IsActive(id) and player:GetAttribute("Eliminated") ~= true
end
function Economy.GetGold(player: Player): number return balances[player] or 0 end
function Economy.ResetPlayerEconomy(player: Player)
 balances[player] = Config.StartingGold; Economy.GoldChanged:Fire(player, Config.StartingGold, 0, "Reset", roundId())
end
function Economy.CanAfford(player: Player, amount: number): boolean
 return balances[player] ~= nil and Rules.validAmount(amount) and Economy.GetGold(player) >= amount
end
function Economy.AddGold(player: Player, amount: number, reason: string): number
 if not Economy.IsEligible(player) or balances[player] == nil then return 0 end
 local before = balances[player]
 local after = Rules.balanceAfter(before, amount, false); if not after then return 0 end
 balances[player] = after
 if after ~= before then Economy.GoldChanged:Fire(player, after, after - before, reason, roundId()) end
 return after - before
end
function Economy.SpendGold(player: Player, amount: number, reason: string): boolean
 if not Economy.IsEligible(player) or balances[player] == nil then return false end
 local before = balances[player]
 local after = Rules.balanceAfter(before, amount, true); if not after then return false end
 -- No yield between balance validation and commit.
 balances[player] = after; Economy.GoldChanged:Fire(player, after, after - before, reason, roundId())
 Economy.GoldSpent:Fire(player, amount, reason); return true
end
function Economy.Remove(player: Player) balances[player] = nil end
return Economy
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="91">
          <Properties>
            <string name="Name">FighterStateService</string>
            <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config.CombatConfig)
local State = require(Shared.Combat.CombatState)
local Life = require(script.Parent.CombatLifeService)
local Heroes = require(Shared.Config.HeroConfig)
local Structures = require(Shared.Game.StructureRules)
local Sleep = require(Shared.Abilities.SleepState)

type Movement = {
	walkSpeed: number, jumpPower: number, jumpHeight: number, autoRotate: boolean,
	ownershipAuto: boolean, owner: Player?, ownershipChanged: boolean,
}
type NetworkLease = { automatic: boolean, owner: Player?, untilAt: number }
export type Fighter = {
	character: Model, humanoid: Humanoid, root: BasePart, player: Player?,
	sleep: Sleep.Status?, logic: State.Fighter, profile: Config.AttackProfile, profileId: string,
	attackLifeId: any?, attackRoundId: any?, revision: number, connections: { RBXScriptConnection }, movement: Movement?, networkLease: NetworkLease?,
	wakeOnlyAttackId: number?,
}

local FighterStateService = { Changed = Instance.new("BindableEvent") }
local fighters: { [Model]: Fighter } = {}
local playerConnections: { [Player]: { RBXScriptConnection } } = {}
local started = false
local walkSpeeds: {[Model]: number}=setmetatable({}, {__mode="k"})
local function effectiveSpeed(model: Model,speed: number): number
 if model:GetAttribute("CombatDisabled")==true then return 0 end
 local ends=model:GetAttribute("OilUntil"); local multiplier=model:GetAttribute("OilMoveMultiplier")
 return if typeof(ends)=="number" and ends>Workspace:GetServerTimeNow() and typeof(multiplier)=="number" then speed*math.clamp(multiplier,0,1) else speed
end

local function restoreMovement(fighter: Fighter)
	if fighter.sleep and fighter.sleep.active then return end
	local saved = fighter.movement
	if not saved then return end
	fighter.movement = nil
	local humanoid, root = fighter.humanoid, fighter.root
	if humanoid.Parent then
		humanoid.WalkSpeed = effectiveSpeed(fighter.character,walkSpeeds[fighter.character] or saved.walkSpeed)
		humanoid.JumpPower = saved.jumpPower
		humanoid.JumpHeight = saved.jumpHeight
		humanoid.AutoRotate = saved.autoRotate
	end
	if saved.ownershipChanged and not fighter.networkLease and root.Parent and root:CanSetNetworkOwnership() then
		if saved.ownershipAuto then
			root:SetNetworkOwnershipAuto()
		else
			root:SetNetworkOwner(if saved.owner and saved.owner.Parent == Players then saved.owner else nil)
		end
	end
end

-- Stun/Sleep and ranged displacement share one original ownership baseline.
function FighterStateService.LeaseNetworkOwnership(fighter: Fighter, untilAt: number)
 local root=fighter.root
 if untilAt~=untilAt or math.abs(untilAt)==math.huge or not root.Parent or not root:CanSetNetworkOwnership() then return end
 local lease=fighter.networkLease
 if not lease then
  local control=fighter.movement
  lease={automatic=if control then control.ownershipAuto else root:GetNetworkOwnershipAuto(),
   owner=if control then control.owner else root:GetNetworkOwner(),untilAt=untilAt}
  fighter.networkLease=lease
 else lease.untilAt=math.max(lease.untilAt,untilAt) end
 root:SetNetworkOwner(nil)
end
local function releaseNetworkLease(fighter: Fighter, now: number, force: boolean?)
 local lease=fighter.networkLease
 if not lease or (not force and now<lease.untilAt) then return end
 fighter.networkLease=nil
 local control=fighter.movement
 if control then
  control.ownershipAuto=lease.automatic; control.owner=lease.owner; control.ownershipChanged=true
 else
  local root=fighter.root
  if root.Parent and root:CanSetNetworkOwnership() then
   if lease.automatic then root:SetNetworkOwnershipAuto()
   else root:SetNetworkOwner(if lease.owner and lease.owner.Parent==Players then lease.owner else nil) end
  end
 end
end
function FighterStateService.ReleaseNetworkOwnership(fighter: Fighter)
 releaseNetworkLease(fighter,Workspace:GetServerTimeNow(),true)
end

function FighterStateService.Snapshot(fighter: Fighter)
	local logic = fighter.logic
	return {
		character = fighter.character, profileId = fighter.profileId, revision = fighter.revision,
		roundId = fighter.character:GetAttribute("RoundId"),
		mode = logic.mode, lastAttackAt = logic.lastAttackAt,
		nextAttackAt = logic.nextAttackAt, stunUntil = logic.stunUntil, attackSerial = logic.attackSerial,
	}
end

function FighterStateService.Publish(fighter: Fighter)
	fighter.revision += 1
	fighter.character:SetAttribute("CombatState", fighter.logic.mode)
	fighter.character:SetAttribute("ComboStep", nil) -- Retire the legacy replicated combo counter.
	fighter.character:SetAttribute("CombatNextAttackAt", fighter.logic.nextAttackAt)
	fighter.character:SetAttribute("CombatStunUntil", fighter.logic.stunUntil)
	fighter.character:SetAttribute("CombatProfileId", fighter.profileId)
	fighter.character:SetAttribute("CombatLastAttackAt", fighter.logic.lastAttackAt)
	fighter.character:SetAttribute("CombatAttackEndsAt", if fighter.logic.active then fighter.logic.active.endsAt else 0)
	fighter.character:SetAttribute("CombatAttackSerial", fighter.logic.attackSerial)
	FighterStateService.Changed:Fire(fighter)
end

function FighterStateService.Remove(character: Model)
	local fighter = fighters[character]
	if not fighter then return end
	fighters[character] = nil
 releaseNetworkLease(fighter,Workspace:GetServerTimeNow(),true)
 fighter.sleep=nil; character:SetAttribute("SleepUntil",nil)
	State.Kill(fighter.logic)
	for _, connection in fighter.connections do connection:Disconnect() end
	restoreMovement(fighter)
end

function FighterStateService.GetWalkSpeed(character: Model): number
 local fighter=fighters[character]; local hp=character:FindFirstChildOfClass("Humanoid")
 return walkSpeeds[character] or (if fighter and fighter.movement then fighter.movement.walkSpeed elseif hp then hp.WalkSpeed else 0)
end
function FighterStateService.Get(character: Model): Fighter?
	return fighters[character]
end
function FighterStateService.Reset()
	for character in fighters do FighterStateService.Remove(character) end
end

function FighterStateService.SetWalkSpeed(character: Model, speed: number)
 walkSpeeds[character]=speed
	local fighter = fighters[character]
	if fighter and fighter.movement then
		fighter.movement.walkSpeed = speed
	else
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if humanoid then humanoid.WalkSpeed = effectiveSpeed(character,speed) end
	end
end

function FighterStateService.GetOrCreate(character: Model): Fighter?
	if Structures.isStructure(character:GetAttribute("EntityKind")) then return nil end
	if fighters[character] then return fighters[character] end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart")
	if not character:IsDescendantOf(Workspace) or not humanoid or not root or not root:IsA("BasePart") then return nil end
	if not humanoid:FindFirstChildOfClass("Animator") then
		Instance.new("Animator").Parent = humanoid
	end
	local fighter: Fighter = {
		character = character, humanoid = humanoid, root = root, player = Players:GetPlayerFromCharacter(character),
		sleep = nil, logic = State.new(), profileId = Config.DefaultProfile, profile = Config.Profiles[Config.DefaultProfile],
		revision = 0, connections = {}, movement = nil, networkLease = nil,
	}
	local heroId = character:GetAttribute("HeroId")
	local hero = if typeof(heroId) == "string" then Heroes.Heroes[heroId] else nil
	if fighter.player and hero then
		fighter.profileId = hero.Profile
		fighter.profile = Config.Profiles[hero.Profile] or Config.Profiles[Config.DefaultProfile]
	end
	fighters[character] = fighter
	Life.Register(character)
	table.insert(fighter.connections, humanoid.Died:Connect(function()
		State.Kill(fighter.logic)
		restoreMovement(fighter)
		FighterStateService.Publish(fighter)
	end))
	table.insert(fighter.connections, character.AncestryChanged:Connect(function()
		if not character:IsDescendantOf(Workspace) then FighterStateService.Remove(character) end
	end))
	if humanoid.Health <= 0 then State.Kill(fighter.logic) end
	FighterStateService.Publish(fighter)
	return fighter
end

local function lockMovement(fighter: Fighter)
	local humanoid, root = fighter.humanoid, fighter.root
	if not fighter.movement then
		local canOwn = root:CanSetNetworkOwnership()
		fighter.movement = {
			walkSpeed = humanoid.WalkSpeed, jumpPower = humanoid.JumpPower,
			jumpHeight = humanoid.JumpHeight, autoRotate = humanoid.AutoRotate,
			ownershipAuto = if fighter.networkLease then fighter.networkLease.automatic elseif canOwn then root:GetNetworkOwnershipAuto() else true,
			owner = if fighter.networkLease then fighter.networkLease.owner elseif canOwn then root:GetNetworkOwner() else nil, ownershipChanged = canOwn,
		}
		if canOwn then root:SetNetworkOwner(nil) end
	end
	humanoid.WalkSpeed = 0
	humanoid.JumpPower = 0
	humanoid.JumpHeight = 0
	humanoid.Jump = false
	humanoid.AutoRotate = false
	if not root.Anchored then
		local vertical = root.AssemblyLinearVelocity.Y
		if vertical ~= vertical or math.abs(vertical) == math.huge then vertical = 0 end
		root.AssemblyLinearVelocity = Vector3.new(0, math.clamp(vertical, -fighter.profile.MaxKnockbackSpeed, fighter.profile.MaxKnockbackSpeed), 0)
	end
end
function FighterStateService.Sleep(fighter: Fighter, now: number)
 if fighter.humanoid.Health<=0 then return end
 fighter.sleep=Sleep.new(now)
 fighter.logic.active=nil; fighter.logic.buffered=nil
 if fighter.logic.mode=="Attacking" then fighter.logic.mode="Idle" end
 fighter.character:SetAttribute("SleepUntil",now+3)
 lockMovement(fighter); FighterStateService.Publish(fighter)
end
function FighterStateService.WakeSleep(fighter: Fighter)
 local status=fighter.sleep; if not status then return end
 Sleep.wake(status,true,0); fighter.sleep=nil
 fighter.character:SetAttribute("SleepUntil",nil)
 if fighter.logic.mode~="Stunned" then restoreMovement(fighter) end
 FighterStateService.Publish(fighter)
end
local function applyStun(fighter: Fighter, duration: number, interrupt: boolean)
	if fighter.humanoid.Health <= 0 or fighter.logic.mode == "Dead" then return end
	local now = Workspace:GetServerTimeNow()
	State.Stun(fighter.logic, now, duration, interrupt)
	lockMovement(fighter)
	FighterStateService.Publish(fighter)
end

function FighterStateService.Stun(fighter: Fighter, duration: number, interrupt: boolean)
	applyStun(fighter, math.clamp(duration, 0, fighter.profile.MaxStunDuration), interrupt)
end
function FighterStateService.StunSpell(fighter: Fighter, duration: number)
	if duration ~= duration or duration <= 0 or duration == math.huge then return end
	applyStun(fighter, duration, false)
end

function FighterStateService.Update(fighter: Fighter, now: number)
 releaseNetworkLease(fighter,now)
 if fighter.sleep and (fighter.humanoid.Health<=0 or Sleep.update(fighter.sleep,now)) then FighterStateService.WakeSleep(fighter) end
	if fighter.humanoid.Health <= 0 then
		if fighter.logic.mode ~= "Dead" then
			State.Kill(fighter.logic)
			restoreMovement(fighter)
			FighterStateService.Publish(fighter)
		end
		return
	end
	if fighter.sleep and fighter.sleep.active then lockMovement(fighter) end
	if State.Update(fighter.logic, now) then
		if fighter.logic.mode ~= "Stunned" then restoreMovement(fighter) end
		FighterStateService.Publish(fighter)
	end
end

function FighterStateService.GetAll(): { [Model]: Fighter }
	return fighters
end

local function bindPlayer(player: Player)
	if playerConnections[player] then return end
	local function bindCharacter(character: Model)
		task.spawn(function()
			local humanoid = character:WaitForChild("Humanoid", Config.CharacterReadyTimeout)
			local root = character:WaitForChild("HumanoidRootPart", Config.CharacterReadyTimeout)
			local deadline = os.clock() + Config.CharacterReadyTimeout
			while player.Character == character and player.Parent == Players and not character:IsDescendantOf(Workspace) and os.clock() < deadline do
				game:GetService("RunService").Heartbeat:Wait()
			end
			if humanoid and root and player.Parent == Players and player.Character == character then
				FighterStateService.GetOrCreate(character)
			end
		end)
	end
	playerConnections[player] = {
		player.CharacterAdded:Connect(bindCharacter),
		player.CharacterRemoving:Connect(FighterStateService.Remove),
	}
	if player.Character then bindCharacter(player.Character) end
end

function FighterStateService.Start()
	if started then return end
	started = true
	Players.PlayerAdded:Connect(bindPlayer)
	Players.PlayerRemoving:Connect(function(player: Player)
		if player.Character then FighterStateService.Remove(player.Character) end
		for character, fighter in fighters do
			if fighter.player == player then FighterStateService.Remove(character) end
		end
		local connections = playerConnections[player]
		if connections then
			for _, connection in connections do connection:Disconnect() end
		end
		playerConnections[player] = nil
	end)
	for _, player in Players:GetPlayers() do bindPlayer(player) end
end

return FighterStateService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="92">
          <Properties>
            <string name="Name">GamakichiService</string>
            <string name="Source"><![CDATA[--!strict
-- Roblox entity/geometry adapter. Follow/assist + shared F command is our PC control policy.
local Players=game:GetService("Players")
local Shared=game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Domain=require(Shared.Abilities.GamakichiState)
local Commands=require(Shared.Abilities.CloneCommands)
local Units=require(Shared.Abilities.WorldUnits)
local Fighters=require(script.Parent.FighterStateService)
local Damage=require(script.Parent.DamageService)
local Targets=require(script.Parent.AbilityTargetService)
local Spells=require(Shared.Abilities.GamakichiSpells)
local Oil=require(script.Parent.OilStatusService)
local Hitboxes=require(script.Parent.HitboxService)
local Navigation=require(script.Parent.CloneNavigation)
local Collision=require(script.Parent.SummonCollision)
type Record={owner: Player, character: Model, model: Model, root: BasePart, humanoid: Humanoid,
 state: Domain.State, cast: Domain.Cast, commands: Commands.State, commandRequest: number, nextHit: number, hitAt: number?, target: Model?, spells: Spells.State, oilTarget: Model?, oilLife: any, center: Vector3?}
local records: {[Player]: Record}={}
local Service={Visual=Instance.new("BindableEvent")}
function Service.Get(player: Player): Record? return records[player] end
function Service.Remove(player: Player)
 local r=records[player]; if not r then return end
 records[player]=nil
 Oil.ClearSource(tostring(player.UserId)..":"..tostring(r.cast.id)); Spells.cancel(r.spells)
 if r.state.active==r.cast then Domain.cancel(r.state) end
 Navigation.Remove(r.model); Fighters.Remove(r.model); r.model:Destroy()
 if r.character.Parent then r.character:SetAttribute("GamakichiCount",0); r.character:SetAttribute("GamakichiAdult",false) end
end
function Service.Reset() for player in records do Service.Remove(player) end; Oil.Reset() end
function Service.Spawn(player: Player, character: Model, state: Domain.State, cast: Domain.Cast, commands: Commands.State)
 Service.Remove(player)
 local source=character:FindFirstChild("HumanoidRootPart") :: BasePart
 local folder=workspace:FindFirstChild("HeroSummons")
 if not folder then folder=Instance.new("Folder"); folder.Name="HeroSummons"; folder.Parent=workspace end
 local model=Instance.new("Model"); model.Name="Gamakichi"
 local function part(name: string,size: Vector3,offset: Vector3,color: Color3): Part
  local p=Instance.new("Part"); p.Name=name; p.Size=size; p.Color=color; p.Anchored=true; p.CanCollide=false; p.CanTouch=false
  p.Position=offset; p.Parent=model; if name~="HumanoidRootPart" then p.CanQuery=false; p:SetAttribute("HeroCosmetic",true) end; return p
 end
 local size=if cast.profile.adult then 1.4 else 1
 local root=part("HumanoidRootPart",Vector3.new(5,3,5)*size,Vector3.zero,Color3.fromRGB(176,78,40))
 local head=part("Head",Vector3.new(4,2,3)*size,Vector3.new(0,1.5,-1)*size,Color3.fromRGB(200,109,57))
 part("LeftEye",Vector3.new(.7,.7,.7)*size,Vector3.new(-1.3,2.4,-2.2)*size,Color3.fromRGB(234,211,90))
 part("RightEye",Vector3.new(.7,.7,.7)*size,Vector3.new(1.3,2.4,-2.2)*size,Color3.fromRGB(234,211,90))
 head.CanQuery=false
 local hp=Instance.new("Humanoid"); hp.RequiresNeck=false; hp.BreakJointsOnDeath=false
 hp.EvaluateStateMachine=false -- Navigation owns movement; no automatic collision changes.
 hp.MaxHealth=cast.profile.health; hp.Health=cast.profile.health; hp.DisplayName=if cast.profile.adult then "Гамакичи · взрослый" else "Гамакичи"
 hp.Parent=model; model.PrimaryPart=root
 model:SetAttribute("EntityKind","Summon"); model:SetAttribute("NativeGamakichi",true); model:SetAttribute("SummonOwner",player.UserId)
 model:SetAttribute("TeamId",character:GetAttribute("TeamId")); model:SetAttribute("RoundId",character:GetAttribute("RoundId"))
 model:SetAttribute("SummonArmor",cast.profile.armor); model:SetAttribute("SummonRank",cast.rank)
 model:SetAttribute("Mana",cast.profile.mana); model:SetAttribute("MaxMana",cast.profile.mana)
 model:SetAttribute("OilImplemented",true); model:SetAttribute("ChoppingImplemented",cast.profile.adult)
 local offset=source.CFrame.RightVector*Domain.Policy.SpawnOffset
 local ray=RaycastParams.new(); ray.FilterType=Enum.RaycastFilterType.Exclude; ray.FilterDescendantsInstances={character}; ray.RespectCanCollide=true
 local wall=workspace:Blockcast(source.CFrame,root.Size,offset,ray)
 if wall then offset=offset.Unit*math.max(0,wall.Distance-.05) end
 model:PivotTo(source.CFrame+offset)
 -- Start on the same clearance plane used by Navigation. A small toad starts
 -- lower than its owner's root; otherwise the first step is rejected as a drop.
 local floor=workspace:Raycast(root.Position+Vector3.new(0,2,0),Vector3.new(0,-12,0),ray)
 if floor and floor.Normal.Y>=.7 then
  local height=math.max(hp.HipHeight+root.Size.Y/2,math.max(4,root.Size.Y)/2+.05)
  model:PivotTo(model:GetPivot()+Vector3.new(0,floor.Position.Y+height-root.Position.Y,0))
 end
 Collision.Apply(model); model.Parent=folder
 records[player]={owner=player,character=character,model=model,root=root,humanoid=hp,state=state,cast=cast,commands=commands,commandRequest=commands.lastRequest,nextHit=0,hitAt=nil,target=nil,spells=Spells.new(),oilTarget=nil,oilLife=nil,center=nil}
 Navigation.Register(model,root,hp)
 Fighters.GetOrCreate(model); character:SetAttribute("GamakichiCount",1); character:SetAttribute("GamakichiAdult",cast.profile.adult); character:SetAttribute("Ready_GamakichiOil",0); character:SetAttribute("Ready_GamakichiChop",0)
end
local function publish(r: Record)
 r.character:SetAttribute("Ready_GamakichiOil",r.spells.oilReady)
 r.character:SetAttribute("Ready_GamakichiChop",r.spells.chopReady)
 r.character:SetAttribute("GamakichiAdult",r.cast.profile.adult)
 r.model:SetAttribute("Channeling",r.spells.channel~=nil)
end
local function affected(r: Record,center: Vector3,radius: number): {Model}
 local result={}
 for model,fighter in Fighters.GetAll() do
  local kind=model:GetAttribute("EntityKind")
  if (kind=="Hero" or kind=="Minion" or kind=="Summon") and Damage.CanDamage(r.model,model)
   and not model:FindFirstChildOfClass("ForceField") and (fighter.root.Position-center).Magnitude<=Units.toStuds(radius)
   and Targets.Visible(r.model,model,center+Vector3.new(0,.1,0),fighter.root.Position) then table.insert(result,model) end
 end
 return result
end
function Service.TrySpell(player: Player,id: string,request: number,now: number,target: any): (boolean,string)
 local r=records[player]
 if not r or r.character~=player.Character or not Domain.live(r.state,r.cast,now) or not Damage.CanAct(r.character) or not Damage.CanAct(r.model) then return false,"Unavailable" end
 local fighter=Fighters.Get(r.model); if not fighter or (fighter.logic.mode=="Stunned" or (fighter.sleep and fighter.sleep.active)) then return false,"Busy" end
 if not Hitboxes.IsFiniteCFrame(r.root.CFrame) then return false,"Unavailable" end
 local point: Vector3
 local selected: Model?=nil
 if id=="GamakichiOil" then
  if typeof(target)~="Instance" then return false,"Target" end
  local instance=target :: Instance
  if not instance:IsA("Model") or not Damage.CanDamage(r.model,instance) then return false,"Target" end
  selected=instance
  local root=instance:FindFirstChild("HumanoidRootPart"); local kind=instance:GetAttribute("EntityKind")
  if not root or not root:IsA("BasePart") or (kind~="Hero" and kind~="Minion" and kind~="Summon") or instance:FindFirstChildOfClass("ForceField") then return false,"Target" end
  point=root.Position
 elseif id=="GamakichiChop" and typeof(target)=="Vector3" then point=target
 else return false,"Malformed" end
 if not Hitboxes.IsFiniteCFrame(CFrame.new(point)) then return false,"Target" end
 local distance=(point-r.root.Position).Magnitude
 local range=if id=="GamakichiOil" then Spells.Oil.Range else Spells.Chopping.Range
 if distance>Units.toStuds(range) or not Targets.Visible(r.model,r.model,r.root.Position,point+Vector3.new(0,.1,0)) then return false,"Target" end
 local accepted,reason=Spells.request(r.spells,id,now,request,r.cast.profile.adult,distance/Units.toStuds(Spells.Oil.ProjectileSpeed))
 if not accepted then return false,reason end
 r.hitAt=nil; r.target=nil
 if selected then
  r.oilTarget=selected; r.oilLife=selected:GetAttribute("LifeId")
  Service.Visual:Fire({source=r.model,kind="GamakichiOil",position=r.root.Position,destination=point,duration=distance/Units.toStuds(Spells.Oil.ProjectileSpeed)})
 else r.center=point; r.model:SetAttribute("ChannelWave",0); Service.Visual:Fire({source=r.model,kind="GamakichiChannel",position=point,radius=Units.toStuds(Spells.Chopping.Radius)}) end
 publish(r); return true,"Accepted"
end
function Service.Update(now: number,delta: number)
 Oil.Update(now)
 for player,r in records do
  if player.Parent~=Players or player.Character~=r.character or not Damage.CanAct(r.character)
   or not r.model.Parent or r.humanoid.Health<=0 or not Domain.live(r.state,r.cast,now) then Service.Remove(player); continue end
  local fighter=Fighters.Get(r.model)
  if fighter and (fighter.logic.mode=="Stunned" or (fighter.sleep and fighter.sleep.active)) then Navigation.Stop(r.model); r.hitAt=nil; r.target=nil; Spells.cancel(r.spells); r.oilTarget=nil; r.center=nil; publish(r); continue end
  r.humanoid.Health=math.min(r.humanoid.MaxHealth,r.humanoid.Health+r.cast.profile.regen*delta)
  if Spells.claimOil(r.spells,now) then
   local target=r.oilTarget; r.oilTarget=nil
   if target and target:GetAttribute("LifeId")==r.oilLife and Damage.CanDamage(r.model,target) then
    local root=target:FindFirstChild("HumanoidRootPart")
    if root and root:IsA("BasePart") and Targets.Visible(r.model,target,r.root.Position,root.Position) then
     for _,victim in affected(r,root.Position,Spells.Oil.Radius) do Oil.Apply(victim,tostring(player.UserId)..":"..tostring(r.cast.id),now) end
     Service.Visual:Fire({source=r.model,kind="GamakichiOilImpact",position=root.Position,radius=Units.toStuds(Spells.Oil.Radius)})
    end
   end
  end
  local wave=Spells.claimWave(r.spells,now)
  if wave and r.center then
   local victims=affected(r,r.center,Spells.Chopping.Radius)
   local raw=Spells.waveDamage(#victims)
   for _,victim in victims do local hp=victim:FindFirstChildOfClass("Humanoid"); if hp then Damage.Apply(r.model,hp,raw) end end
   r.model:SetAttribute("ChannelWave",wave)
   Service.Visual:Fire({source=r.model,kind="GamakichiChopImpact",position=r.center,radius=Units.toStuds(Spells.Chopping.Radius),wave=wave})
  end
  publish(r)
  if r.spells.channel or r.spells.flight then Navigation.Stop(r.model); continue end
  local intent=Commands.resolve(r.commands)
  if r.commandRequest~=r.commands.lastRequest then r.commandRequest=r.commands.lastRequest; r.hitAt=nil; r.target=nil end
  if intent.mode=="Idle" or intent.mode=="Hold" then r.hitAt=nil; r.target=nil; Navigation.Stop(r.model); continue end
  local target: Model?=nil
  if intent.targetId then
   for candidate in Fighters.GetAll() do if candidate:GetAttribute("AbilityEntityId")==intent.targetId then target=candidate; break end end
   if not target or not Damage.CanDamage(r.model,target) then Commands.invalidateTarget(r.commands,intent.targetId); target=nil end
  end
  if r.hitAt and now>=r.hitAt then
   local victim=r.target; r.hitAt=nil; r.target=nil
   local root=if victim then victim:FindFirstChild("HumanoidRootPart") else nil
   if victim and root and root:IsA("BasePart") and Damage.CanDamage(r.model,victim)
    and (root.Position-r.root.Position).Magnitude<=Units.toStuds(100)+(root.Size.X+r.root.Size.X)/2
    and Targets.Visible(r.model,victim,r.root.Position,root.Position) then
    local hp=victim:FindFirstChildOfClass("Humanoid"); if hp then Damage.ApplyAttack(r.model,hp,r.cast.profile.rawDamage) end
   end
  end
  local destination=if target then target:FindFirstChild("HumanoidRootPart") else r.character:FindFirstChild("HumanoidRootPart")
  if not destination or not destination:IsA("BasePart") then Navigation.Stop(r.model); continue end
  local distance=destination.Position-r.root.Position
  local flat=distance*Vector3.new(1,0,1)
  if flat.Magnitude>.001 then r.model:PivotTo(CFrame.lookAt(r.root.Position,r.root.Position+flat)) end
  local stop=if target then Units.toStuds(100)+(r.root.Size.X+destination.Size.X)/2 else Domain.Policy.FollowDistance
  if target and distance.Magnitude<=stop and now>=r.nextHit and not r.hitAt and Targets.Visible(r.model,target,r.root.Position,destination.Position) then
   r.nextHit=now+Domain.Policy.AttackInterval; r.hitAt=now+Domain.Policy.DamagePoint; r.target=target; r.model:SetAttribute("SummonSwingAt",now)
  end
  if r.hitAt then Navigation.Stop(r.model)
  else
   local moving=Navigation.Step(r.model,r.character,target or r.character,destination,stop,now,delta,Units.toStuds(r.cast.profile.speed)*Oil.Movement(r.model,now))
   r.model:SetAttribute("SummonMoving",moving)
  end
 end
end
return Service
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="93">
          <Properties>
            <string name="Name">GameModeService</string>
            <string name="Source"><![CDATA[--!strict
local Config = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared").Config.GameModeConfig)
local GameModeService = {}
function GameModeService.MinimumPerTeam(): number
	if game:GetService("RunService"):IsStudio() then
		return math.clamp(Config.StudioMinimumPerTeam, 1, Config.TeamCapacity)
	end
	return Config.TeamCapacity
end
function GameModeService.MinimumPlayers(): number
	if GameModeService.IsSoloTest() then return 1 end
	return #Config.Teams * GameModeService.MinimumPerTeam()
end
function GameModeService.IsSoloTest(): boolean
	return game:GetService("RunService"):IsStudio() and (Config.DebugSoloMode or workspace:GetAttribute("DeveloperSoloMode")==true)
end
function GameModeService.TeamIds(): { string }
	local ids = {}; for _, team in Config.Teams do table.insert(ids, team.Id) end; return ids
end
return GameModeService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="94">
          <Properties>
            <string name="Name">HeroAppearanceService</string>
            <string name="Source"><![CDATA[--!strict
local Shared=game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Data=require(Shared.Config.CreatorVisualData)
local Forms=require(Shared.Config.NarutoFormVisualData)
local Factory=require(Shared.CreatorVisualFactory)
local Appearance={}
local bound: {[Model]: {RBXScriptConnection}}=setmetatable({}, {__mode="k"})
local function dress(model: Model)
 local head=model:FindFirstChild("Head")
 if not head or not head:IsA("BasePart") or not model:FindFirstChild("UpperTorso") then return end
 local form=if model:GetAttribute("KuramaActive")==true then "Kurama" elseif model:GetAttribute("KcmActive")==true then "KCM" elseif model:GetAttribute("SagePhase")=="Active" then "Sage" else "Normal"
 if form=="KCM" and model:GetAttribute("KcmRank")==3 then form="Rikudo" end
 local version="CreatorStore-v4:"..form
 if model:GetAttribute("HeroAppearanceVersion")==version and model:FindFirstChild("HeroAppearance") then return end
 local sage=form=="Sage"
 local kcm=form=="KCM" or form=="Rikudo"
 -- Keep the physical head and its rig joints; the imported face supplies the visible head.
 head.Transparency=1
 local previous=model:FindFirstChild("HeroAppearance")
 for _,item in model:GetChildren() do
  if item:IsA("Accessory") or item:IsA("Shirt") or item:IsA("Pants") or item:IsA("ShirtGraphic") then item:Destroy() end
 end
 for _,item in head:GetChildren() do if item:IsA("Decal") then item:Destroy() end end
 for _,item in model:GetChildren() do if item:IsA("BasePart") and item.Name~="HumanoidRootPart" then
  item.Transparency=if item.Name=="Head" or form=="Kurama" then 1 else 0
  item.Color=if kcm then Color3.fromRGB(255,184,31) else Color3.fromRGB(255,204,153);item.Material=Enum.Material.SmoothPlastic
 end end
 local shirt=Instance.new("Shirt");shirt.ShirtTemplate=if form=="Rikudo" then "rbxassetid://6510073285" elseif kcm then "rbxassetid://7923921567" elseif sage then "rbxassetid://7472900840" else "rbxassetid://6764794671";shirt.Parent=model
 local pants=Instance.new("Pants");pants.PantsTemplate=if form=="Rikudo" then "rbxassetid://6510069460" elseif kcm then "rbxassetid://7923927930" elseif sage then "rbxassetid://7472928447" else "rbxassetid://3237352364";pants.Parent=model
 -- Build off-tree so clients never observe a deliberately empty costume.
 local folder=Instance.new("Folder");folder.Name="HeroAppearance"
 if sage or kcm then
  -- A classic head supports this store face decal. The avatar's dynamic head does not.
  local faceHead=Instance.new("Part");faceHead.Name=form.."FaceHead";faceHead.Size=Vector3.new(2,1,1)
  faceHead.Color=if kcm then Color3.fromRGB(255,202,71) else Color3.fromRGB(255,204,153);faceHead.Material=Enum.Material.SmoothPlastic
  faceHead.CanCollide=false;faceHead.CanTouch=false;faceHead.CanQuery=false;faceHead.Massless=true
  faceHead:SetAttribute("HeroCosmetic",true);faceHead:SetAttribute("CosmeticBody","Head");faceHead:SetAttribute("CosmeticOffset",CFrame.identity)
  faceHead.CFrame=head.CFrame;faceHead.Parent=folder
  local mesh=Instance.new("SpecialMesh");mesh.MeshType=Enum.MeshType.Head;mesh.Scale=Vector3.one*1.25;mesh.Parent=faceHead
  local face=Instance.new("Decal");face.Name=form.."Face";face.Texture=if kcm then "rbxassetid://9477576334" else "rbxassetid://9449064416";face.Face=Enum.NormalId.Front;face.Parent=faceHead
  local weld=Instance.new("WeldConstraint");weld.Part0=head;weld.Part1=faceHead;weld.Parent=faceHead
 end
 for _,spec in Forms[form] or Data.appearance do
  if spec.form~="All" and spec.form~=form then continue end
  local body=model:FindFirstChild(spec.body)
  if not body or not body:IsA("BasePart") then continue end
  local part=Factory.Part(spec);part:SetAttribute("HeroCosmetic",true)
  part:SetAttribute("CosmeticBody",spec.body);part:SetAttribute("CosmeticOffset",Factory.Frame(spec.cf))
  part.CFrame=body.CFrame*Factory.Frame(spec.cf);part.Parent=folder
  local weld=Instance.new("Weld");weld.Name="FormVisualWeld";weld.Part0=body;weld.Part1=part;weld.C0=Factory.Frame(spec.cf);weld.Parent=part
 end
 if form=="Rikudo" then
  local torso=model:FindFirstChild("UpperTorso") :: BasePart
  for i=1,9 do
   local angle=(i-1)*math.pi*2/9
   local offset=CFrame.new(math.cos(angle)*1.9,.2+math.sin(angle)*1.9,1.25)
   local orb=Instance.new("Part");orb.Name="TruthSeekingOrb"..i;orb.Shape=Enum.PartType.Ball;orb.Size=Vector3.one*.42
   orb.Color=Color3.fromRGB(12,10,17);orb.Material=Enum.Material.SmoothPlastic;orb.Massless=true
   orb.CanCollide=false;orb.CanTouch=false;orb.CanQuery=false;orb:SetAttribute("HeroCosmetic",true)
   orb:SetAttribute("CosmeticBody","UpperTorso");orb:SetAttribute("CosmeticOffset",offset);orb.CFrame=torso.CFrame*offset;orb.Parent=folder
   local weld=Instance.new("Weld");weld.Name="FormVisualWeld";weld.Part0=torso;weld.Part1=orb;weld.C0=offset;weld.Parent=orb
  end
 end
 for _,part in folder:GetChildren() do
  if part:IsA("BasePart") then part:SetAttribute("AppearanceTransparency",part.Transparency) end
 end
 folder:SetAttribute("AppearanceVersion",version)
 folder:SetAttribute("AppearanceForm",form)
 folder:SetAttribute("AppearanceParts",#folder:GetChildren())
 folder:SetAttribute("AppearanceDescendants",#folder:GetDescendants())
 if previous then previous.Name="PreviousHeroAppearance" end
 folder.Parent=model
 model:SetAttribute("HeroVisualForm",form)
 model:SetAttribute("HeroAppearanceVersion",version)
 -- Each client retains its own loaded visual until the next one is ready.
 -- This grace window also covers replication of the new folder and its children.
 if previous then game:GetService("Debris"):AddItem(previous,3) end
end
function Appearance.Apply(model: Model)
 dress(model)
 if bound[model] then return end
 local connections={};bound[model]=connections
 for _,attribute in {"SagePhase","KcmActive","KcmRank","KuramaActive"} do
  table.insert(connections,model:GetAttributeChangedSignal(attribute):Connect(function() dress(model) end))
 end
 model.Destroying:Once(function() for _,connection in connections do connection:Disconnect() end;bound[model]=nil end)
end
return Appearance
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="95">
          <Properties>
            <string name="Name">HeroProgressionService</string>
            <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config.ProgressionConfig)
local Items = require(Shared.Config.ItemConfig)
local Logic = require(Shared.Game.ProgressionRules)
local Rules = Logic.configure(Config, Items.Items)
local Economy = require(script.Parent.EconomyService)
local Teams = require(script.Parent.TeamService)
local Learning = require(Shared.Abilities.SkillLearning)
local Progression = { Changed = Instance.new("BindableEvent") }
local records: { [Player]: Logic.Profile } = {}
local folders: { [Player]: Folder } = {}
local notice: RemoteEvent? = nil
local started = false
function Progression.Get(player: Player): Logic.Profile? return records[player] end
function Progression.GetFolder(player: Player): Folder? return folders[player] end
function Progression.Notify(player: Player, xp: number, gold: number, levels: number)
 local match = Teams.GetState()
 if notice and player.Parent == Players and match then notice:FireClient(player, xp, gold, levels, match.roundId) end
end
function Progression.Publish(player: Player)
 local data, folder = records[player], folders[player]; if not data or not folder then return end
 for _, key in { "Level", "CurrentXP", "TotalKills", "TotalDeaths", "TotalMinionKills", "Assists" } do
  folder:SetAttribute(key, (data :: any)[key])
 end
 folder:SetAttribute("SkillPoints", data.SkillPoints)
 for _, id in Learning.Order do
  folder:SetAttribute("Rank_"..id, data.Learned[id] or 0)
  folder:SetAttribute("LearnReason_"..id, Learning.reason(data,id) or "Ready")
 end
 folder:SetAttribute("XPToNextLevel", Rules.required(data.Level)); folder:SetAttribute("Gold", Economy.GetGold(player))
 for id in Items.Items do folder:SetAttribute("Own_" .. id, data.Owned[id] == true) end
 folder:SetAttribute("Revision", ((folder:GetAttribute("Revision") or 0) :: number) + 1)
end
function Progression.ResetPlayer(player: Player)
 records[player] = Rules.new(); Economy.ResetPlayerEconomy(player)
 local match = Teams.GetState()
 Progression.Publish(player); Progression.Changed:Fire(player, "Reset", 0, if match then match.roundId else nil)
end
function Progression.ResetMatch()
 for _, player in Players:GetPlayers() do Progression.ResetPlayer(player) end
end
function Progression.AddXP(player: Player, amount: number): number
 local data = records[player]; if not data or not Economy.IsEligible(player) then return 0 end
 local levels, accepted = Rules.addXP(data, amount)
 if accepted > 0 then
  local match = Teams.GetState()
  Progression.Publish(player); Progression.Changed:Fire(player, "XP", levels, if match then match.roundId else nil)
  Progression.Notify(player, accepted, 0, levels)
 end
 return levels
end
function Progression.Increment(player: Player, key: string)
 local data = records[player]; if not data or not Economy.IsEligible(player) then return end
 if key == "TotalKills" then data.TotalKills += 1
 elseif key == "TotalDeaths" then data.TotalDeaths += 1
 elseif key == "TotalMinionKills" then data.TotalMinionKills += 1
 elseif key == "Assists" then data.Assists += 1 else return end
 Progression.Publish(player)
end
function Progression.Equip(player: Player, id: string): boolean
 local data, item = records[player], Items.Items[id]
 if not data or not item or not item.Permanent or data.Owned[id] or not Economy.IsEligible(player) then return false end
 data.Owned[id] = true
 local match = Teams.GetState()
 Progression.Publish(player); Progression.Changed:Fire(player, "Equipment", 0, if match then match.roundId else nil); return true
end
function Progression.Start()
 if started then return end; started = true
 notice = Instance.new("RemoteEvent"); notice.Name = "HeroNotice"; notice.Parent = game:GetService("ReplicatedStorage")
 Economy.GoldChanged.Event:Connect(function(player: Player, _balance: number, delta: number, reason: string, roundId: number?)
  local match = Teams.GetState(); if match and roundId ~= match.roundId then return end
  Progression.Publish(player)
  if delta > 0 and reason ~= "Reset" then Progression.Notify(player, 0, delta, 0) end
 end)
 local function add(player: Player)
  local folder = Instance.new("Folder"); folder.Name = "HeroState"; folder.Parent = player; folders[player] = folder
  Progression.ResetPlayer(player)
 end
 Players.PlayerAdded:Connect(add)
 Players.PlayerRemoving:Connect(function(player)
  records[player] = nil; Economy.Remove(player)
  if folders[player] then folders[player]:Destroy(); folders[player] = nil end
 end)
 for _, player in Players:GetPlayers() do add(player) end
end
return Progression
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="96">
          <Properties>
            <string name="Name">HeroService</string>
            <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ContentProvider = game:GetService("ContentProvider")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config.HeroConfig)
local Combat = require(Shared.Config.CombatConfig)
local Ids = require(Shared.Config.AnimationIds)
local Appearance = require(script.Parent.HeroAppearanceService)
local HeroService = {}
local connections: { [Player]: { RBXScriptConnection } } = {}
local prepared: { [Model]: boolean } = setmetatable({}, { __mode = "k" })
local started = false
function HeroService.Assign(player: Player, model: Model)
	local id = player:GetAttribute("HeroId")
	if typeof(id) ~= "string" or not Config.Heroes[id] then id = Config.DefaultHero end
	local hero = Config.Heroes[id :: string]
	player:SetAttribute("HeroId", id); model:SetAttribute("HeroId", id)
	model:SetAttribute("CombatProfileId", hero.Profile)
end
local function prepare(player: Player, model: Model)
	HeroService.Assign(player, model)
	task.spawn(function()
		local humanoid = model:WaitForChild("Humanoid", Combat.CharacterReadyTimeout)
		local head = model:WaitForChild("Head", Combat.CharacterReadyTimeout)
		if player.Character ~= model or not head or not humanoid or not humanoid:IsA("Humanoid") then return end
		if humanoid.RigType ~= Enum.HumanoidRigType.R15 then warn("[Heroes] OrangeNinja needs R15; synchronize default.project.json"); return end
		Appearance.Apply(model)
		if prepared[model] then return end; prepared[model] = true
		local animator = humanoid:FindFirstChildOfClass("Animator") or Instance.new("Animator")
		animator.Parent = humanoid
		local profile = Combat.Profiles[tostring(model:GetAttribute("CombatProfileId"))]
		local set = if profile then Ids[profile.AnimationSet] else nil
		-- Only explicitly configured, accessible tracks suppress the procedural fallback.
		for key, asset in set or {} do
			if not string.match(asset, "^rbxassetid://[1-9]%d*$") then continue end
			task.spawn(function()
				local animation = Instance.new("Animation"); animation.AnimationId = asset
				local loaded = false
				local ok = pcall(function()
					ContentProvider:PreloadAsync({ animation }, function(_, status) loaded = status == Enum.AssetFetchStatus.Success end)
				end)
				animation:Destroy()
				if model.Parent and player.Character == model then model:SetAttribute("TrackReady_" .. key, ok and loaded) end
			end)
		end
	end)
end
local function bind(player: Player)
	if connections[player] then return end
	player:SetAttribute("HeroId", Config.DefaultHero)
	connections[player] = {
		player.CharacterAdded:Connect(function(model) prepare(player, model) end),
		player.CharacterAppearanceLoaded:Connect(function(model) prepare(player, model) end),
	}
	if player.Character then prepare(player, player.Character) end
end
function HeroService.Start()
	if started then return end; started = true
	game:GetService("StarterPlayer").LoadCharacterAppearance = false
	Players.PlayerAdded:Connect(bind)
	Players.PlayerRemoving:Connect(function(player)
		for _, connection in connections[player] or {} do connection:Disconnect() end
		connections[player] = nil
	end)
	for _, player in Players:GetPlayers() do bind(player) end
end
return HeroService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="97">
          <Properties>
            <string name="Name">HitboxService</string>
            <string name="Source"><![CDATA[--!strict

local Workspace = game:GetService("Workspace")
local Config = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared").Config.CombatConfig)

local Damage = require(script.Parent.DamageService)
local HitboxService = {}

function HitboxService.IsFiniteCFrame(frame: CFrame): boolean
	for _, value in { frame:GetComponents() } do
		if value ~= value or math.abs(value) == math.huge then
			return false
		end
	end
	return true
end

local function findHumanoid(part: BasePart): Humanoid?
	if part:GetAttribute("HeroCosmetic") == true or part:GetAttribute("StructureCosmetic") == true then return nil end
	-- Accessories and held weapons must not extend the victim's hurtbox.
	if part:FindFirstAncestorWhichIsA("Accessory") or part:FindFirstAncestorWhichIsA("Tool") then
		return nil
	end
	local ancestor: Instance? = part.Parent
	while ancestor and ancestor ~= Workspace do
		if ancestor:IsA("Model") then
			local humanoid = ancestor:FindFirstChildOfClass("Humanoid")
			if humanoid then
				return humanoid
			end
		end
		ancestor = ancestor.Parent
	end
	return nil
end

function HitboxService.GetTargets(attacker: Model, root: BasePart, profile: Config.AttackProfile, admitWake: ((Model)->boolean)?): ({ Humanoid }, CFrame, Vector3)
	local origin = root.CFrame
	local dimensions, offset = profile.HitboxSize, profile.HitboxOffset
	local size = Vector3.new(dimensions.X, dimensions.Y, dimensions.Z)
	local box = origin * CFrame.new(offset.X, offset.Y, offset.Z)
	if not HitboxService.IsFiniteCFrame(origin) then
		return {}, box, size
	end
	local overlap = OverlapParams.new()
	overlap.FilterType = Enum.RaycastFilterType.Exclude
	overlap.FilterDescendantsInstances = { attacker }
	overlap.MaxParts = 0

	-- Orientation and position are sampled at the authoritative impact time.
	local parts = Workspace:GetPartBoundsInBox(box, size, overlap)
	local targets: { Humanoid } = {}
	local seen: { [Humanoid]: boolean } = {}

	local rayParams = RaycastParams.new()
	rayParams.FilterType = Enum.RaycastFilterType.Exclude
	-- Other fighters in the same swing must not occlude a multi-target hit.
	local occlusionFilter: { Instance } = { attacker }
	local filtered: { [Instance]: boolean } = { [attacker] = true }
	for _, part in parts do
		local humanoid = findHumanoid(part)
		local model = if humanoid then humanoid.Parent else nil
		if model and not filtered[model] then
			filtered[model] = true
			table.insert(occlusionFilter, model)
		end
	end
	rayParams.FilterDescendantsInstances = occlusionFilter
	rayParams.RespectCanCollide = true

	for _, part in parts do
		local humanoid = findHumanoid(part)
		if not humanoid or seen[humanoid] then
			continue
		end
		seen[humanoid] = true
		local character = humanoid.Parent
		if not character or not character:IsA("Model") or character == attacker or humanoid.Health <= 0 then
			continue
		end
		if (not Damage.CanDamage(attacker, character) and (not admitWake or not admitWake(character)))
			or character:FindFirstChildOfClass("ForceField") then continue end
		local targetRoot = character:FindFirstChild("HumanoidRootPart")
		if not targetRoot or not targetRoot:IsA("BasePart") or not HitboxService.IsFiniteCFrame(targetRoot.CFrame) then
			continue
		end
		local delta = targetRoot.Position - origin.Position
		if delta.Magnitude > profile.MaxTargetDistance then continue end
		if delta.Magnitude > Config.PositionEpsilon and origin.LookVector:Dot(delta.Unit) < profile.MinimumForwardDot then continue end
		-- A nearby limb alone must not let an attack pass through a solid wall.
		local obstruction = Workspace:Raycast(origin.Position, targetRoot.Position - origin.Position, rayParams)
		if not obstruction or obstruction.Instance:IsDescendantOf(character) then
			table.insert(targets, humanoid)
		end
	end
 -- A player can explicitly wake one sleeping ally. Default callers remain enemy-only.
 -- Choose the closest admitted interaction; overlap iteration order is unspecified.
 table.sort(targets, function(a: Humanoid, b: Humanoid): boolean
  local first = (a.Parent :: Model):FindFirstChild("HumanoidRootPart") :: BasePart
  local second = (b.Parent :: Model):FindFirstChild("HumanoidRootPart") :: BasePart
  return (first.Position - origin.Position).Magnitude < (second.Position - origin.Position).Magnitude
 end)
 while #targets > profile.MaxTargets do table.remove(targets) end
 return targets, box, size
end

return HitboxService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="98">
          <Properties>
            <string name="Name">ItemShopService</string>
            <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config.ProgressionConfig)
local Items = require(Shared.Config.ItemConfig)
local Rules = require(Shared.Game.ProgressionRules).configure(Config, Items.Items)
local Progression = require(script.Parent.HeroProgressionService)
local Economy = require(script.Parent.EconomyService)
local Stats = require(script.Parent.CharacterStatsService)
local Limiter = require(script.Parent.RequestLimiter)
local Teams = require(script.Parent.TeamService)
local RoundProtocol = require(Shared.Game.RoundProtocol)
type Session = { bucket: Limiter.Bucket, lastId: number, busy: boolean }
local Shop = {}
local shops: { [string]: BasePart } = {}
local sessions: { [Player]: Session } = {}
local remote: RemoteEvent? = nil
local started = false
function Shop.GetLocation(teamId: string): BasePart? return shops[teamId] end
function Shop.Availability(player: Player): (Humanoid?, string?)
 if not Economy.IsEligible(player) then return nil, "Unavailable" end
 local model = player.Character
 local match = Teams.GetState()
 if not model or not match or model:GetAttribute("RoundId") ~= match.roundId or model:GetAttribute("CombatDisabled") == true then return nil, "Unavailable" end
 local humanoid = if model then model:FindFirstChildOfClass("Humanoid") else nil
 local root = if model then model:FindFirstChild("HumanoidRootPart") else nil
 if not humanoid or humanoid.Health <= 0 or not root or not root:IsA("BasePart") then return nil, "Dead" end
 local id = player:GetAttribute("TeamId")
 local shop = if typeof(id) == "string" then shops[id] else nil
 if not shop or not shop:IsDescendantOf(workspace) then return nil, "Unavailable" end
 local distance = (root.Position - shop.Position).Magnitude
 if distance ~= distance or distance > Config.ShopDistance then return nil, "TooFar" end
 return humanoid, nil
end
function Shop.TryPurchase(player: Player, ...: any): (boolean, string)
 if player.Parent ~= Players then return false, "Unavailable" end
 local now = workspace:GetServerTimeNow()
 local session = sessions[player]
 if not session then session = { bucket = Limiter.new(Config.ShopBurst, Config.ShopRequestsPerSecond, now), lastId = 0, busy = false }; sessions[player] = session end
 if not Limiter.Consume(session.bucket, now) then return false, "RateLimited" end
 local requestId, itemId = ...
 if select("#", ...) ~= 2 or typeof(requestId) ~= "number" or requestId ~= requestId or requestId < 1
  or requestId > Config.MaxRequestId or requestId % 1 ~= 0 or typeof(itemId) ~= "string" or #itemId > 48 then return false, "Malformed" end
 if requestId <= session.lastId then return false, "Replay" end
 session.lastId = requestId
 if not Items.Items[itemId] then return false, "UnknownItem" end
 if session.busy then return false, "Busy" end
 session.busy = true
 -- Entire transaction is non-yielding, including all server validation and mutations.
 local function transaction(): (boolean, string)
  local humanoid, reason = Shop.Availability(player)
  if not humanoid then return false, reason or "Unavailable" end
  local profile = Progression.Get(player); if not profile then return false, "Unavailable" end
  reason = Rules.purchaseReason(profile, Economy.GetGold(player), itemId, humanoid.Health, humanoid.MaxHealth)
  if reason then return false, reason end
  local item = Items.Items[itemId]
  if not Economy.SpendGold(player, item.Cost, "Purchase:" .. itemId) then return false, "NotEnoughGold" end
  if item.Permanent then
   assert(Progression.Equip(player, itemId), "Validated equipment transaction failed")
   Stats.RecalculateStats(player)
  elseif item.Heal then
   humanoid.Health = math.min(humanoid.MaxHealth, humanoid.Health + item.Heal)
  end
  return true, "Purchased"
 end
 local ok, success, reason = pcall(transaction)
 session.busy = false
 if not ok then warn("[Shop] " .. tostring(success)); return false, "Unavailable" end
 return success, reason
end
function Shop.ResetSessions() table.clear(sessions) end
function Shop.HandleRequest(player: Player, ...: any): (boolean, string)
 local args = table.pack(...)
 local match = Teams.GetState()
 if not match or not RoundProtocol.accepts(match.roundId, args[args.n]) then return false, "StaleRound" end
 return Shop.TryPurchase(player, table.unpack(args, 1, args.n - 1))
end
function Shop.Start(arena: Folder)
 if started then return end; started = true
 remote = Instance.new("RemoteEvent"); remote.Name = "ItemShop"; remote.Parent = ReplicatedStorage
 local locations = arena:FindFirstChild("Shops"); assert(locations, "Map.Shops missing")
 for _, part in locations:GetChildren() do
  if not part:IsA("BasePart") then continue end
  local id = part:GetAttribute("TeamId"); assert(typeof(id) == "string", "Shop needs TeamId")
  shops[id] = part
  local prompt = part:FindFirstChildOfClass("ProximityPrompt"); assert(prompt, "Shop needs ProximityPrompt")
  prompt.Triggered:Connect(function(player)
   local humanoid = Shop.Availability(player)
   local match = Teams.GetState()
   if humanoid and player:GetAttribute("TeamId") == id and remote and match then remote:FireClient(player, "Open", nil, nil, nil, match.roundId) end
  end)
 end
 ;(remote :: RemoteEvent).OnServerEvent:Connect(function(player: Player, ...: any)
  local requestId = ...
  local success, reason = Shop.HandleRequest(player, ...)
  -- Invalid floods receive no amplification; well-formed requests get a bounded response.
  if typeof(requestId) == "number" and requestId == requestId and requestId >= 1 and requestId <= Config.MaxRequestId
   and reason ~= "RateLimited" and reason ~= "StaleRound" and remote then
   local match = Teams.GetState()
   remote:FireClient(player, "Result", requestId, success, reason, if match then match.roundId else nil)
  end
 end)
 Players.PlayerRemoving:Connect(function(player) sessions[player] = nil end)
end
return Shop
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="99">
          <Properties>
            <string name="Name">JungleService</string>
            <string name="Source"><![CDATA[--!strict
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config.JungleConfig)
local MapConfig = require(Shared.Config.MapConfig)
local Rules = require(Shared.Game.JungleRules)
local Factory = require(script.Parent.MinionFactory)
local Fighters = require(script.Parent.FighterStateService)
local Damage = require(script.Parent.DamageService)
local Teams = require(script.Parent.TeamService)
local Life = require(script.Parent.CombatLifeService)
type Camp = { id: string, home: Vector3, logic: Rules.Camp, model: Model?, target: Model?, nextAttack: number, returnAt: number, deadAt: number }
local Jungle = {}
local camps: { Camp } = {}
local container: Folder? = nil
function Jungle.GetAll(): { Camp } return camps end
local function remove(camp: Camp)
	local model = camp.model; if not model then return end
	Teams.RemoveNeutral(model); Fighters.Remove(model); Life.Remove(model); model:Destroy(); camp.model = nil
end
local function spawn(camp: Camp, now: number)
	local state = Teams.GetState(); if not state or state.phase ~= "InProgress" then return end
	remove(camp)
	local model = Factory.Create("Jungle", Config.TeamId, Color3.fromRGB(156, 121, 75), camp.home, Config.Stats)
	model.Name = "ForestGuardian_" .. camp.id; model:SetAttribute("NeutralCampId", camp.id)
	model:SetAttribute("RoundId", state.roundId)
	local humanoid = model:FindFirstChildOfClass("Humanoid") :: Humanoid
	humanoid.DisplayName = "Лесной страж"
	model.Parent = container; camp.model = model; camp.logic = Rules.new(); camp.target = nil; camp.nextAttack = now + 0.5; camp.returnAt = 0
	Teams.RegisterNeutral(model); Fighters.GetOrCreate(model); Life.Register(model)
	local root = model.PrimaryPart :: BasePart
	if root:CanSetNetworkOwnership() then root:SetNetworkOwner(nil) end
end
function Jungle.Stop()
	for _, camp in camps do
		camp.target = nil
		if camp.model then
			camp.model:SetAttribute("CombatDisabled", true)
			local humanoid = camp.model:FindFirstChildOfClass("Humanoid")
			if humanoid then humanoid:Move(Vector3.zero); humanoid.WalkSpeed = 0 end
		end
	end
end
function Jungle.Start(arena: Folder)
	if container then return end
	local folder = Instance.new("Folder"); folder.Name = "JungleCamps"; folder.Parent = workspace; container = folder
	local markers = Instance.new("Folder"); markers.Name = "Jungle"; markers.Parent = arena
	for _, definition in Config.Camps do
		local home = MapConfig.Origin + definition.Offset
		local marker = Instance.new("Part"); marker.Name = definition.Id; marker.Anchored = true
		marker.CanCollide = false; marker.CanQuery = false; marker.CanTouch = false
		marker.Size = Vector3.new(15, 0.15, 15); marker.Position = home - Vector3.new(0, 2.9, 0)
		marker.Color = Color3.fromRGB(93, 79, 54); marker.Material = Enum.Material.Ground; marker.Parent = markers
		table.insert(camps, { id = definition.Id, home = home, logic = {mode="Dead",respawnAt=0}, model=nil, target=nil, nextAttack=0, returnAt=0, deadAt=0 })
	end
	Damage.Applied.Event:Connect(function(attacker: Model, target: Model)
		for _, camp in camps do
			if camp.model ~= target or camp.logic.mode == "Returning" or camp.logic.mode == "Dead" then continue end
			local root = attacker:FindFirstChild("HumanoidRootPart")
			if root and root:IsA("BasePart") and (root.Position-camp.home).Magnitude <= Config.Leash then camp.target = attacker end
		end
	end)
end
function Jungle.Update(now: number)
	local state = Teams.GetState(); if not state or state.phase ~= "InProgress" then return end
	for _, camp in camps do
		local model = camp.model
		if model and not model.Parent then remove(camp); Rules.die(camp.logic, now, Config.RespawnDelay); model = nil end
		if model and model.Parent then
			local humanoid = model:FindFirstChildOfClass("Humanoid") :: Humanoid
			if humanoid.Health <= 0 and camp.logic.mode ~= "Dead" then Rules.die(camp.logic, now, Config.RespawnDelay); camp.deadAt = now; camp.target = nil end
			if camp.logic.mode == "Dead" and now - camp.deadAt >= Config.CorpseLifetime then remove(camp); model = nil end
		end
		if camp.logic.mode == "Dead" then
			if Rules.step(camp.logic, now, true, 0, false, 0, Config.Leash) == "Spawn" then spawn(camp, now) end
			continue
		end
		if not model or not model.Parent then remove(camp); Rules.die(camp.logic, now, Config.RespawnDelay); continue end
		local humanoid = model:FindFirstChildOfClass("Humanoid") :: Humanoid
		local root = model.PrimaryPart :: BasePart
		local fighter = Fighters.Get(model)
		if fighter and fighter.logic.mode ~= "Stunned" then Fighters.SetWalkSpeed(model,Config.Stats.WalkSpeed) end
		local target = camp.target
		if target and not Damage.CanDamage(model, target) then target = nil end
		if not target and camp.logic.mode ~= "Returning" then
			local nearest = Config.DetectionRange
			for candidate, candidateFighter in Fighters.GetAll() do
				if not Damage.CanDamage(model, candidate) then continue end
				local distance = (candidateFighter.root.Position - root.Position).Magnitude
				if distance < nearest then nearest = distance; target = candidate end
			end
		end
		local targetRoot = if target then target:FindFirstChild("HumanoidRootPart") else nil
		local valid = targetRoot ~= nil and targetRoot:IsA("BasePart")
		local targetPosition = if valid then (targetRoot :: BasePart).Position else camp.home
		local mode = Rules.step(camp.logic, now, true, (root.Position-camp.home).Magnitude, valid, (targetPosition-camp.home).Magnitude, Config.Leash)
		model:SetAttribute("AIState", mode); model:SetAttribute("CombatDisabled", mode == "Returning")
		if mode == "Returning" then
			camp.target = nil
			if camp.returnAt == 0 then camp.returnAt = now end
			-- Bounded recovery when terrain/physics prevents reaching the camp.
			if now - camp.returnAt > 6 then model:PivotTo(CFrame.new(camp.home)) end
			humanoid:MoveTo(camp.home)
		else
			camp.returnAt = 0; camp.target = target
			if mode == "Idle" then humanoid.Health = humanoid.MaxHealth; humanoid:MoveTo(camp.home) end
			if mode == "Chasing" and target and fighter and fighter.logic.mode ~= "Stunned" then
				if (targetPosition-root.Position).Magnitude > Config.AttackRange then humanoid:MoveTo(targetPosition)
				else
					humanoid:MoveTo(root.Position)
					if now >= camp.nextAttack then
						camp.nextAttack = now + Config.Stats.AttackCooldown
						local victim = target:FindFirstChildOfClass("Humanoid")
						if victim then Damage.ApplyAttack(model, victim, Config.Stats.Damage) end
					end
				end
			end
		end
	end
end
return Jungle
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="100">
          <Properties>
            <string name="Name">KnockbackService</string>
            <string name="Source"><![CDATA[--!strict

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config.CombatConfig)
local Structures = require(Shared.Game.StructureRules)
local Workspace = game:GetService("Workspace")
local KnockbackService = {}

-- Stun acquires temporary server ownership before this impulse is applied.
function KnockbackService.Apply(attacker: BasePart, target: BasePart, profile: Config.AttackProfile, speedOverride: number?, upOverride: number?)
	if target.Anchored or not target.Parent then return end
	if Structures.isStructure(target.Parent:GetAttribute("EntityKind")) then return end
	local delta = target.Position - attacker.Position
	local horizontal = Vector3.new(delta.X, 0, delta.Z)
	if horizontal.Magnitude < Config.PositionEpsilon then
		local look = attacker.CFrame.LookVector
		horizontal = Vector3.new(look.X, 0, look.Z)
	end
	if horizontal.Magnitude < Config.PositionEpsilon then return end
	local direction = horizontal.Unit
	local speed = speedOverride or profile.KnockbackVelocity
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { attacker.Parent :: Instance, target.Parent :: Instance }
	params.RespectCanCollide = true
	local size = profile.KnockbackProbeSize
	local wall = Workspace:Blockcast(target.CFrame, Vector3.new(size.X, size.Y, size.Z), direction * speed * profile.KnockbackWallProbeTime, params)
	if wall then
		speed = math.min(speed, math.max(0, wall.Distance - profile.KnockbackWallPadding) / profile.KnockbackWallProbeTime)
	end
	local desired = direction * speed + Vector3.new(0, upOverride or profile.KnockbackUpVelocity, 0)
	if desired.Magnitude > profile.MaxKnockbackSpeed then desired = desired.Unit * profile.MaxKnockbackSpeed end
	local mass = target.AssemblyMass
	if mass <= 0 or mass == math.huge or mass ~= mass then return end
	local current = target.AssemblyLinearVelocity
	if current.Magnitude ~= current.Magnitude or current.Magnitude == math.huge then
		target.AssemblyLinearVelocity = Vector3.zero
		current = Vector3.zero
	end
	-- Set a bounded initial velocity via a mass-scaled delta impulse, never stack it.
	target:ApplyImpulse((desired - current) * mass)
end

return KnockbackService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="101">
          <Properties>
            <string name="Name">MapBuilder</string>
            <string name="Source"><![CDATA[--!strict
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config.MapConfig)
local Mode = require(Shared.Config.GameModeConfig)
local Progression = require(Shared.Config.ProgressionConfig)
local TowerFactory = require(script.Parent.TowerFactory)
local MapScenery = require(script.Parent.MapScenery)
local MapBuilder = {}
function MapBuilder.EnsureShops(map: Folder)
	local existing = map:FindFirstChild("Shops")
	assert(not existing or existing:IsA("Folder"), "Map.Shops must be a Folder")
	local shops = existing or Instance.new("Folder"); shops.Name = "Shops"; shops.Parent = map
	local spawns = map:FindFirstChild("SpawnPoints"); assert(spawns)
	for _, team in Mode.Teams do
		if shops:FindFirstChild(team.Id) then continue end
		local points = spawns:FindFirstChild(team.Id); assert(points)
		local hero = points:FindFirstChild("Hero"); assert(hero and hero:IsA("BasePart"))
		local offset = Progression.ShopOffset
		local shop = Instance.new("Part"); shop.Name = team.Id; shop.Size = Vector3.new(5, 3, 5); shop.Anchored = true
		shop.Position = hero.Position + Vector3.new(offset.X, offset.Y, offset.Z)
		shop.Color = Color3.fromRGB(226, 181, 68); shop.Material = Enum.Material.Metal
		shop:SetAttribute("TeamId", team.Id); shop.Parent = shops
		local prompt = Instance.new("ProximityPrompt"); prompt.Name = "ShopPrompt"; prompt.ActionText = "Магазин"
		prompt.ObjectText = team.Id .. " • предметы за Gold"; prompt.MaxActivationDistance = Progression.ShopPromptDistance
		prompt.HoldDuration = 0; prompt.RequiresLineOfSight = false; prompt.Parent = shop
	end
end
local function folder(parent: Instance, name: string): Folder
	local item = Instance.new("Folder"); item.Name = name; item.Parent = parent; return item
end
local function part(parent: Instance, name: string, size: Vector3, position: Vector3, color: Color3): Part
	local item = Instance.new("Part")
	item.Name = name; item.Anchored = true; item.Size = size; item.Position = Config.Origin + position
	item.Color = color; item.Material = Enum.Material.SmoothPlastic; item.TopSurface = Enum.SurfaceType.Smooth
	item.BottomSurface = Enum.SurfaceType.Smooth; item.Parent = parent; return item
end
function MapBuilder.Build(): Folder
	local existing = workspace:FindFirstChild("Map")
	if existing then
		assert(existing:IsA("Folder") and (existing:GetAttribute("SurvivalMapVersion") == Config.Version or existing:GetAttribute("AuthoredSurvivalMap") == true),
			"Workspace.Map is not a supported survival map; rename your existing container or supply an authored map")
		MapBuilder.EnsureShops(existing)
		TowerFactory.Build(existing)
		MapScenery.Ensure(existing)
		return existing
	end
	assert(Config.Generated, "Generated map disabled: provide Workspace.Map with AuthoredSurvivalMap=true")
	local map = Instance.new("Folder"); map.Name = "Map"; map:SetAttribute("SurvivalMapVersion", Config.Version)
	local ground = folder(map, "Ground"); local lanes = folder(map, "Lanes")
	local bases = folder(map, "Bases"); local spawns = folder(map, "SpawnPoints")
	local waypoints = folder(map, "Waypoints"); local decorations = folder(map, "Decorations")
	part(ground, "Arena", Config.GroundSize, Vector3.zero, Color3.fromRGB(48, 70, 61)).Material = Enum.Material.Grass
	local routes = Config.Routes :: { [string]: { Vector3 } }
	for _, name in Config.LaneOrder do
		local lane = folder(lanes, name); local points = folder(waypoints, name)
		local route = routes[name]
		for index, position in route do
			local marker = part(points, tostring(index), Vector3.one, position, Color3.new(1, 1, 1))
			marker.Transparency = 1; marker.CanCollide = false; marker.CanQuery = false; marker.CanTouch = false
			if index < #route then
				local nextPosition = route[index + 1]
				local delta = nextPosition - position
				local road = part(lane, "Road" .. index, Vector3.new(Config.LaneWidth, 0.2, delta.Magnitude + Config.LaneWidth),
					(position + nextPosition) / 2 - Vector3.new(0, 2.85, 0), Color3.fromRGB(139, 124, 94))
				road.CFrame = CFrame.lookAt(road.Position, road.Position + delta)
				road.Material = Enum.Material.Ground
			end
		end
	end
	local settings = Config.Teams :: { [string]: { Base: Vector3, Hero: Vector3, Reverse: boolean } }
	for _, team in Mode.Teams do
		local layout = settings[team.Id]; assert(layout, "Map layout missing for " .. team.Id)
		local model = Instance.new("Model"); model.Name = team.Id .. "Base"; model:SetAttribute("TeamId", team.Id)
		model:SetAttribute("EntityKind", "Base"); model.Parent = bases
		local root = part(model, "HumanoidRootPart", Vector3.new(6, 6, 6), layout.Base, team.Color)
		root.Material = Enum.Material.Neon; model.PrimaryPart = root
		local humanoid = Instance.new("Humanoid"); humanoid.RequiresNeck = false; humanoid.BreakJointsOnDeath = false
		humanoid.MaxHealth = Mode.BaseHealth; humanoid.Health = Mode.BaseHealth; humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		humanoid.Parent = model
		part(decorations, team.Id .. "Foundation", Vector3.new(23, 0.3, 23), layout.Base - Vector3.new(0, 2.85, 0), team.Color)
		local teamSpawns = folder(spawns, team.Id)
		local spawn = Instance.new("SpawnLocation"); spawn.Name = "Hero"; spawn.Anchored = true
		spawn.Size = Vector3.new(8, 1, 8); spawn.Position = Config.Origin + layout.Hero
		local facing = Config.Origin + layout.Base
		spawn.CFrame = CFrame.lookAt(spawn.Position, Vector3.new(facing.X, spawn.Position.Y, facing.Z))
		spawn.Color = team.Color; spawn.TeamColor = BrickColor.new(team.Color); spawn.Neutral = false
		spawn.AllowTeamChangeOnTouch = false; spawn.Duration = 0; spawn.Parent = teamSpawns
		for _, lane in Config.LaneOrder do
			local route = routes[lane]; local location = route[if layout.Reverse then #route else 1]
			local marker = part(teamSpawns, lane, Vector3.one, location, team.Color)
			marker.Transparency = 1; marker.CanCollide = false; marker.CanQuery = false; marker.CanTouch = false
		end
	end
	for index, position in Config.Obstacles do
		part(decorations, "Rock" .. index, Vector3.new(15, 8, 12), position, Color3.fromRGB(65, 72, 77)).Material = Enum.Material.Rock
	end
	map.Parent = workspace
	MapBuilder.EnsureShops(map)
	TowerFactory.Build(map)
	MapScenery.Ensure(map)
	return map
end
function MapBuilder.Route(map: Folder, lane: string, reverse: boolean): { Vector3 }
	local waypoints = map:FindFirstChild("Waypoints"); assert(waypoints, "Waypoints missing")
	local container = waypoints:FindFirstChild(lane); assert(container, "Route missing")
	local ordered = container:GetChildren()
	table.sort(ordered, function(a, b) return (tonumber(a.Name) or 0) < (tonumber(b.Name) or 0) end)
	local route = {}
	for _, item in ordered do if item:IsA("BasePart") then table.insert(route, item.Position) end end
	assert(#route >= 2, "Route requires at least two points")
	if reverse then
		local reversed = {}; for index = #route, 1, -1 do table.insert(reversed, route[index]) end
		return reversed
	end
	return route
end
return MapBuilder
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="102">
          <Properties>
            <string name="Name">MapScenery</string>
            <string name="Source"><![CDATA[--!strict
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config.MapConfig)
local Plan = require(Shared.Game.MapSceneryPlan)
local MapScenery = {}
local palette = {
	Bark = Color3.fromRGB(103, 72, 48), Leaf = Color3.fromRGB(52, 98, 65), LightLeaf = Color3.fromRGB(77, 120, 68),
	DarkLeaf = Color3.fromRGB(44, 66, 66), Ash = Color3.fromRGB(84, 81, 82), Rock = Color3.fromRGB(111, 115, 107),
	DarkRock = Color3.fromRGB(64, 65, 73), Moss = Color3.fromRGB(78, 104, 66), Plaster = Color3.fromRGB(211, 190, 146),
	Roof = Color3.fromRGB(68, 108, 91), Paper = Color3.fromRGB(226, 219, 185), Alliance = Color3.fromRGB(61, 94, 146),
	Enemy = Color3.fromRGB(148, 43, 52), Bone = Color3.fromRGB(163, 167, 144), Water = Color3.fromRGB(64, 131, 143),
}
function MapScenery.Ensure(map: Folder)
	-- Authored maps own their appearance. Only decorate this generator's layout.
	if map:GetAttribute("AuthoredSurvivalMap") == true then return end
	local old = map:FindFirstChild("ShinobiScenery")
	if old and old:GetAttribute("SceneryVersion") == Plan.Version then return end
	assert(not old or old:GetAttribute("GeneratedScenery") == true, "ShinobiScenery is reserved for generated decor")
	local root = Instance.new("Folder")
	root.Name = "ShinobiScenery"
	root:SetAttribute("GeneratedScenery", true)
	root:SetAttribute("SceneryVersion", Plan.Version)
	local ok, failure = pcall(function()
		for _, piece in Plan.Build() do
			local item = Instance.new("Part")
			item.Name = piece.name
			item.Anchored = true
			item.CanCollide = false
			item.CanTouch = false
			item.CanQuery = false
			item.CastShadow = false -- Canopies cannot darken combat or hide targeting telegraphs.
			item.Size = Vector3.new(piece.sx, piece.sy, piece.sz)
			item.CFrame = CFrame.new(Config.Origin + Vector3.new(piece.x, piece.y, piece.z)) * CFrame.Angles(0, math.rad(piece.yaw), 0)
			item.Color = (palette :: { [string]: Color3 })[piece.palette]
			item.Material = (Enum.Material :: any)[piece.material]
			item.Shape = if piece.shape == "Ball" then Enum.PartType.Ball else Enum.PartType.Block
			item.TopSurface = Enum.SurfaceType.Smooth
			item.BottomSurface = Enum.SurfaceType.Smooth
			item.Parent = root
		end
	end)
	if not ok then root:Destroy(); error(failure) end
	root:SetAttribute("PartCount", #root:GetChildren())
	if old then old:Destroy() end
	root.Parent = map
end
return MapScenery
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="103">
          <Properties>
            <string name="Name">MatchService</string>
            <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config.GameModeConfig)
local MinionConfig = require(Shared.Config.MinionConfig)
local Rules = require(Shared.Game.MatchState)
local Mode = require(script.Parent.GameModeService)
local Builder = require(script.Parent.MapBuilder)
local Teams = require(script.Parent.TeamService)
local Bases = require(script.Parent.BaseService)
local Damage = require(script.Parent.DamageService)
local AI = require(script.Parent.MinionAIService)
local Spawner = require(script.Parent.MinionSpawnerService)
local Progression = require(script.Parent.HeroProgressionService)
local Stats = require(script.Parent.CharacterStatsService)
local Rewards = require(script.Parent.RewardService)
local Shop = require(script.Parent.ItemShopService)
local Towers = require(script.Parent.TowerService)
local Structures = require(script.Parent.StructureService)
local TowerConfig = require(Shared.Config.TowerConfig)
local MapConfig = require(Shared.Config.MapConfig)
local Ability = require(script.Parent.AbilityService)
local Fighters = require(script.Parent.FighterStateService)
local Life = require(script.Parent.CombatLifeService)
local Jungle = require(script.Parent.JungleService)
local MatchService = {}
local state: Rules.State? = nil
local folder: Folder? = nil
local nextAI, nextSnapshot, nextDiagnostics = 0, 0, 0
local nextTower = 0
function MatchService.GetState(): Rules.State? return state end
function MatchService.ResetProgression()
	assert(not state or state.phase ~= "InProgress", "Reset progression only between matches")
	Progression.ResetMatch(); Rewards.Reset(); Shop.ResetSessions()
	require(script.Parent.AbilityService).Reset()
end
function MatchService.Publish()
	local current, replicated = state, folder
	if not current or not replicated then return end
	replicated:SetAttribute("Phase", current.phase); replicated:SetAttribute("StartedAt", current.startedAt)
	replicated:SetAttribute("RoundId", current.roundId)
	replicated:SetAttribute("FinishedAt", current.finishedAt); replicated:SetAttribute("Winner", current.winner or "")
	replicated:SetAttribute("Wave", current.wave); replicated:SetAttribute("ActiveNPCs", AI.GetCount())
	replicated:SetAttribute("PreparationEnds", current.preparationEnds); replicated:SetAttribute("MinimumPlayers", Mode.MinimumPlayers())
	for id, team in current.teams do
		local item = replicated:FindFirstChild(id)
		local base = Bases.Get(id)
		if item and base then
			item:SetAttribute("Kills", Rewards.GetTeamKills(id))
			item:SetAttribute("PlayerCount", team.count); item:SetAttribute("Capacity", Config.TeamCapacity)
			item:SetAttribute("Active", team.active); item:SetAttribute("Health", base.humanoid.Health)
			item:SetAttribute("MaxHealth", base.humanoid.MaxHealth)
			local remaining = Structures.Remaining(id)
			item:SetAttribute("TowersRemaining", remaining); item:SetAttribute("TowersTotal", #MapConfig.LaneOrder)
			item:SetAttribute("BaseProtected", remaining > 0); base.model:SetAttribute("ProtectedByTowers", remaining > 0)
		end
	end
end
local function eliminate(id: string, roundId: number)
	local current = state; if not current then return end
	if roundId ~= current.roundId then return end
	if not Rules.eliminate(current, id, workspace:GetServerTimeNow()) then return end
	Teams.Eliminate(id); AI.RemoveTeam(id)
	if current.phase == "Finished" then
		Damage.SetEnabled(false); Jungle.Stop(); AI.SetRunning(false); Towers.CancelAll(); Ability.Reset(); Fighters.Reset(); Teams.Finish()
		print("[Match] Winner: " .. (current.winner or "Draw"))
	end
	MatchService.Publish()
end
function MatchService.Start()
	if state then return end
	Damage.SetEnabled(false)
	local arena = Builder.Build()
	local effects = workspace:FindFirstChild("Effects")
	assert(not effects or effects:IsA("Folder"), "Workspace.Effects must be a Folder")
	if not effects then local created = Instance.new("Folder"); created.Name = "Effects"; created.Parent = workspace end
	local initial = Rules.new(Mode.TeamIds()); state = initial
	Progression.Start(); Stats.Start(); Rewards.Start()
	Teams.Start(initial, arena); Bases.Start(arena); Spawner.Start(arena)
	Towers.Start(arena); Jungle.Start(arena)
	Shop.Start(arena); require(script.Parent.AbilityLearningService).Start()
	local replicated = Instance.new("Folder"); replicated.Name = "SurvivalState"
	for _, definition in Config.Teams do
		local item = Instance.new("Folder"); item.Name = definition.Id
		item:SetAttribute("DisplayName", definition.DisplayName)
		item:SetAttribute("Color", definition.Color); item.Parent = replicated
	end
	local shots = Instance.new("RemoteEvent"); shots.Name = "MinionShot"; shots.Parent = replicated
	local towerEvents = Instance.new("RemoteEvent"); towerEvents.Name = "TowerEvent"; towerEvents.Parent = replicated
	Towers.Event.Event:Connect(function(kind: string, model: Model, origin: Vector3, destination: Vector3, teamId: string, lane: string, roundId: number)
		if roundId ~= initial.roundId then return end
		towerEvents:FireAllClients(kind, model, origin, destination, teamId, lane, roundId)
		if kind == "Destroyed" then MatchService.Publish() end
	end)
	AI.Shot.Event:Connect(function(origin: Vector3, target: Vector3, kind: string, id: string, model: Model, roundId: number)
		if roundId ~= initial.roundId then return end
		shots:FireAllClients(origin, target, kind, id, model, roundId)
	end)
	replicated.Parent = ReplicatedStorage; folder = replicated
	Bases.Destroyed.Event:Connect(eliminate)
	MatchService.Publish()
	RunService.Heartbeat:Connect(function()
		local current = state; if not current then return end
		local now = workspace:GetServerTimeNow()
		Teams.Update(now)
		local ready = if Mode.IsSoloTest() then Teams.Count() >= 1 else Teams.Ready(Mode.MinimumPerTeam())
		local eligible = if ready then Teams.Count() else 0
		if Rules.advance(current, now, eligible, Mode.MinimumPlayers(), Config.PreparationTime, MinionConfig.FirstWaveDelay) then
			if current.phase == "InProgress" then Teams.LockRoster(); Damage.SetEnabled(true); AI.SetRunning(true) end
			MatchService.Publish()
		end
		if Rules.waveDue(current, now, MinionConfig.WaveInterval) then Spawner.Wave(current.wave); MatchService.Publish() end
		if now >= nextAI then
			nextAI = now + MinionConfig.UpdateInterval
			local before = os.clock(); AI.Update(now); Jungle.Update(now)
			workspace:SetAttribute("SurvivalAIUpdateMs", (os.clock() - before) * 1000)
		end
		if now >= nextSnapshot then nextSnapshot = now + Config.SnapshotInterval; MatchService.Publish() end
		Rewards.Update(now)
		if now >= nextTower then nextTower = now + TowerConfig.UpdateInterval; Towers.Update(now) end
		if MinionConfig.DebugPerformance and now >= nextDiagnostics then
			nextDiagnostics = now + MinionConfig.DiagnosticInterval
			print(string.format("[Minions] active=%d cap=%d updateMs=%.2f", AI.GetCount(), MinionConfig.MaxActiveNPCs, workspace:GetAttribute("SurvivalAIUpdateMs") :: number))
		end
	end)
end
return MatchService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="104">
          <Properties>
            <string name="Name">MeditationCloneService</string>
            <string name="Source"><![CDATA[--!strict
-- Entity adapter. Owner validation and mana credit are injected by NarutoAbilityService.
local Shared=game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Domain=require(Shared.Abilities.MeditationState)
local Units=require(Shared.Abilities.WorldUnits)
local Fighters=require(script.Parent.FighterStateService)
local Collision=require(script.Parent.SummonCollision)
type Record={model: Model, humanoid: Humanoid, owner: Player, character: Model, state: Domain.State, clone: Domain.Clone, valid: ()->boolean, credit: (number)->(), connection: RBXScriptConnection?}
local records: {[Model]: Record}={}
local Service={}
function Service.GetAll(): {[Model]: Record} return records end
-- Kurama pulses credit the owned domain pool, never just its replicated display.
function Service.RestoreMana(model: Model, amount: number): boolean
 local record=records[model]
 if not record or not model:IsDescendantOf(workspace) or record.humanoid.Health<=0 or not record.valid() then return false end
 if not Domain.restore(record.state,record.clone,workspace:GetServerTimeNow(),amount) then return false end
 model:SetAttribute("Mana",record.clone.mana)
 return true
end
local function remove(record: Record, now: number, transfer: boolean)
 if records[record.model]~=record then return end
 records[record.model]=nil
 if record.connection then record.connection:Disconnect() end
 local amount=Domain.settle(record.state,record.clone,now,transfer and record.valid())
 if amount>0 then record.credit(amount) end
 Fighters.Remove(record.model); record.model:Destroy()
end
function Service.ClearOwner(owner: Player)
 for _,record in records do if record.owner==owner then remove(record,workspace:GetServerTimeNow(),false) end end
end
function Service.Reset()
 for _,record in records do remove(record,workspace:GetServerTimeNow(),false) end
end
function Service.Recall(owner: Player, now: number)
 for _,record in records do if record.owner==owner then remove(record,now,true) end end
end
function Service.Spawn(owner: Player, character: Model, state: Domain.State, clones: {Domain.Clone}, valid: ()->boolean, credit: (number)->())
 local sourceRoot=character:FindFirstChild("HumanoidRootPart")
 if not sourceRoot or not sourceRoot:IsA("BasePart") then
  for _,clone in clones do Domain.settle(state,clone,workspace:GetServerTimeNow(),false) end
  return
 end
 for index,clone in clones do
  local archivable=character.Archivable; character.Archivable=true
  local model=character:Clone(); character.Archivable=archivable
  -- Remove inherited combat/VFX tags and state, keep only identity/team/round.
  for _,tag in game:GetService("CollectionService"):GetTags(model) do game:GetService("CollectionService"):RemoveTag(model,tag) end
  for key in model:GetAttributes() do
   if key~="TeamId" and key~="RoundId" and key~="HeroId" then model:SetAttribute(key,nil) end
  end
  for _,item in model:GetDescendants() do
   if item:IsA("LuaSourceContainer") or item:IsA("Tool") or item:IsA("ForceField") then item:Destroy()
   elseif item:IsA("BasePart") then item.CanCollide=false; item.CanTouch=false; item.Massless=true end
  end
  local root=model:FindFirstChild("HumanoidRootPart")
  local humanoid=model:FindFirstChildOfClass("Humanoid")
  if not root or not root:IsA("BasePart") or not humanoid then
   Domain.settle(state,clone,workspace:GetServerTimeNow(),false); model:Destroy(); continue
  end
  model.Name="MeditationClone"
  model:SetAttribute("EntityKind","Summon"); model:SetAttribute("NativeMeditationClone",true)
  model:SetAttribute("SummonOwner",owner.UserId); model:SetAttribute("CombatDisabled",false)
  model:SetAttribute("MeditationExpiresAt",clone.expiresAt); model:SetAttribute("Mana",clone.mana); model:SetAttribute("MaxMana",clone.maximum)
  humanoid.MaxHealth=1; humanoid.Health=1; humanoid.WalkSpeed=0; humanoid.AutoRotate=false
  humanoid.BreakJointsOnDeath=false; humanoid.DisplayDistanceType=Enum.HumanoidDisplayDistanceType.None
  root.Anchored=true; model.PrimaryPart=root
  -- Side placement in studs; clamp against walls. Kurama retains larger offset policy.
  local distance=Units.toStuds(if clone.maximum==2000 then 300 else 100)
  local offset=sourceRoot.CFrame.RightVector*(if index==1 then -distance else distance)
  local params=RaycastParams.new(); params.FilterType=Enum.RaycastFilterType.Exclude; params.FilterDescendantsInstances={character}; params.RespectCanCollide=true
  local wall=workspace:Blockcast(sourceRoot.CFrame,sourceRoot.Size,offset,params)
  if wall then offset=offset.Unit*math.max(0,wall.Distance-.1) end
  local folder=workspace:FindFirstChild("HeroSummons")
  if not folder then folder=Instance.new("Folder"); folder.Name="HeroSummons"; folder.Parent=workspace end
  Collision.Apply(model)
  model:PivotTo(character:GetPivot()+offset); model.Parent=folder
  -- A built-in seated meditation pose; no external animation/asset dependency.
  humanoid.Sit=true
  local record: Record={model=model,humanoid=humanoid,owner=owner,character=character,state=state,clone=clone,valid=valid,credit=credit,connection=nil}
  records[model]=record
  record.connection=humanoid.Died:Connect(function() remove(record,workspace:GetServerTimeNow(),true) end)
  Fighters.GetOrCreate(model)
 end
end
function Service.Update(now: number)
 for _,record in records do
  if not record.valid() or not Domain.live(record.state,record.clone) or not record.model.Parent then remove(record,now,false)
  elseif record.humanoid.Health<=0 or now>=record.clone.expiresAt then remove(record,now,true)
  else Domain.update(record.state,record.clone,now); record.model:SetAttribute("Mana",record.clone.mana) end
 end
end
return Service
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="105">
          <Properties>
            <string name="Name">MinionAIService</string>
            <string name="Source"><![CDATA[--!strict
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Players = game:GetService("Players")
local Config = require(Shared.Config.MinionConfig)
local MapConfig = require(Shared.Config.MapConfig)
local Fighters = require(script.Parent.FighterStateService)
local Damage = require(script.Parent.DamageService)
local Teams = require(script.Parent.TeamService)
local Bases = require(script.Parent.BaseService)
local Structures = require(script.Parent.StructureService)
export type Minion = {
	model: Model, humanoid: Humanoid, root: BasePart, teamId: string, kind: string, lane: string,
	stats: Config.Stats, route: { Vector3 }, waypoint: number, target: Model?, mode: string,
	nextAttack: number, spawnedAt: number, deadAt: number?, lastPosition: Vector3,
	progressAt: number, recoveries: number, recoveryUntil: number, recoveryGoal: Vector3?,
	connections: { RBXScriptConnection },
}
local AI = { Shot = Instance.new("BindableEvent") }
local records: { [Model]: Minion } = {}
local grid: { [string]: { Model } } = {}
local active = 0
local running = false
local function setMode(npc: Minion, mode: string)
	if npc.mode ~= mode then npc.mode = mode; npc.model:SetAttribute("AIState", mode) end
end
local function dead(npc: Minion)
	if npc.deadAt then return end
	active -= 1; npc.deadAt = workspace:GetServerTimeNow(); npc.target = nil
	npc.model:SetAttribute("MinionDiedAt", npc.deadAt)
	setMode(npc, "Dead"); npc.model:SetAttribute("CombatDisabled", true)
	npc.model:SetAttribute("TargetName", "")
	npc.humanoid:Move(Vector3.zero)
end
function AI.Remove(model: Model)
	local npc = records[model]; if not npc then return end
	if not npc.deadAt then active -= 1 end
	records[model] = nil
	for _, connection in npc.connections do connection:Disconnect() end
	Fighters.Remove(model); model:Destroy()
end
function AI.Register(model: Model, teamId: string, kind: string, lane: string, route: { Vector3 }, stats: Config.Stats)
	if records[model] then return end
	local match = Teams.GetState(); if match then model:SetAttribute("RoundId", match.roundId) end
	local root = model:FindFirstChild("HumanoidRootPart") :: BasePart
	local humanoid = model:FindFirstChildOfClass("Humanoid") :: Humanoid
	local now = workspace:GetServerTimeNow()
	local npc: Minion = { model = model, humanoid = humanoid, root = root, teamId = teamId, kind = kind, lane = lane,
		stats = stats, route = route, waypoint = 1, target = nil, mode = "Spawning",
		nextAttack = now + Config.SpawnGrace, spawnedAt = now, deadAt = nil,
		lastPosition = root.Position, progressAt = now, recoveries = 0, recoveryUntil = 0, recoveryGoal = nil, connections = {} }
	records[model] = npc; active += 1
	model:SetAttribute("Lane", lane); model:SetAttribute("AIState", "Spawning"); model:SetAttribute("Waypoint", 1)
	if root:CanSetNetworkOwnership() then root:SetNetworkOwner(nil) end
	Fighters.GetOrCreate(model)
	table.insert(npc.connections, humanoid.Died:Connect(function() dead(npc) end))
	table.insert(npc.connections, model.AncestryChanged:Connect(function()
		if not model:IsDescendantOf(workspace) then AI.Remove(model) end
	end))
end
function AI.GetCount(): number return active end
function AI.Reset()
	running = false
	for model in records do AI.Remove(model) end
	table.clear(grid); active = 0
end
function AI.GetAll(): { [Model]: Minion } return records end
function AI.SetRunning(value: boolean)
	running = value
	if not value then
		for _, npc in records do
			npc.target = nil; npc.humanoid:MoveTo(npc.root.Position); npc.humanoid.WalkSpeed = 0
			npc.model:SetAttribute("CombatDisabled", true)
		end
	end
end
function AI.RemoveTeam(id: string)
	local remove = {}; for model, npc in records do if npc.teamId == id then table.insert(remove, model) end end
	for _, model in remove do AI.Remove(model) end
end
local function cell(position: Vector3): string
	return math.floor(position.X / Config.SpatialCellSize) .. ":" .. math.floor(position.Z / Config.SpatialCellSize)
end
local function rebuildGrid()
	table.clear(grid)
	for model, fighter in Fighters.GetAll() do
		if fighter.humanoid.Health > 0 and model.Parent then
			local key = cell(fighter.root.Position)
			local bucket = grid[key]
			if not bucket then bucket = {}; grid[key] = bucket end
			table.insert(bucket, model)
		end
	end
end
local function selectTarget(npc: Minion): Model?
	local nearestNPC, nearestHero: Model? = nil, nil
	local npcDistance, heroDistance = math.huge, math.huge
	local radius = npc.stats.DetectionRange
	local origin = npc.root.Position
	local minX, maxX = math.floor((origin.X - radius) / Config.SpatialCellSize), math.floor((origin.X + radius) / Config.SpatialCellSize)
	local minZ, maxZ = math.floor((origin.Z - radius) / Config.SpatialCellSize), math.floor((origin.Z + radius) / Config.SpatialCellSize)
	for x = minX, maxX do for z = minZ, maxZ do
		for _, model in grid[x .. ":" .. z] or {} do
			if not Damage.CanDamage(npc.model, model) then continue end
			local root = model:FindFirstChild("HumanoidRootPart")
			if not root or not root:IsA("BasePart") then continue end
			local distance = (root.Position - origin).Magnitude
			if distance > radius then continue end
			if model:GetAttribute("EntityKind") == "Minion" then
				if distance < npcDistance then nearestNPC = model; npcDistance = distance end
			elseif distance < heroDistance then nearestHero = model; heroDistance = distance end
		end
	end end
	if nearestNPC then return nearestNPC end
	if nearestHero then return nearestHero end
	local selected: Model? = nil; local distance = math.huge
	for model, tower in Structures.GetAll() do
		if tower.kind ~= "Tower" or not Structures.Alive(tower) then continue end
		local separation = (tower.root.Position - origin).Magnitude
		local sameLane = tower.lane == npc.lane
		if separation <= (if sameLane then npc.stats.DetectionRange else npc.stats.AttackRange)
			and (separation < distance or (separation == distance and selected ~= nil and model.Name < selected.Name))
			and Damage.CanDamage(npc.model, model) then selected = model; distance = separation end
	end
	if selected then return selected end
	for _, base in Bases.GetAll() do
		local separation = (base.root.Position - origin).Magnitude
		if separation <= npc.stats.AttackRange and separation < distance and Damage.CanDamage(npc.model, base.model) then
			selected = base.model; distance = separation
		end
	end
	return selected
end
local function baseGoal(npc: Minion): Vector3?
	local selected: Vector3? = nil; local nearest = math.huge
	-- Once the lane route is complete, help another lane if its towers still shield the core.
	-- Own-lane towers always take precedence; the outer route keeps cross-lane travel away from rocks.
	local ownLane = false
	for model, tower in Structures.GetAll() do
		if tower.kind ~= "Tower" or not Structures.Alive(tower) or not Damage.CanDamage(npc.model, model) then continue end
		local sameLane = tower.lane == npc.lane
		local distance = (tower.root.Position - npc.root.Position).Magnitude
		if (sameLane and not ownLane) or (sameLane == ownLane and distance < nearest) then
			selected = tower.root.Position; nearest = distance; ownLane = sameLane
		end
	end
	if selected then return selected end
	for _, base in Bases.GetAll() do
		if Teams.IsActive(base.teamId) and base.teamId ~= npc.teamId and Structures.CanReceive(base.model) then
			local distance = (base.root.Position - npc.root.Position).Magnitude
			if distance < nearest then selected = base.root.Position; nearest = distance end
		end
	end
	return selected
end
local function visible(npc: Minion, target: Model, position: Vector3): boolean
	local params = RaycastParams.new(); params.FilterType = Enum.RaycastFilterType.Exclude
	local excluded: { Instance } = { npc.model, target, npc.model.Parent :: Instance }
	-- Actors do not obstruct a confirmed shot; solid map geometry still does.
	for _, player in Players:GetPlayers() do
		if player.Character then table.insert(excluded, player.Character) end
	end
	params.FilterDescendantsInstances = excluded
	params.RespectCanCollide = true
	return workspace:Raycast(npc.root.Position, position - npc.root.Position, params) == nil
end
local function move(npc: Minion, goal: Vector3, now: number)
	setMode(npc, "Moving")
	local displacement = (npc.root.Position - npc.lastPosition) * Vector3.new(1, 0, 1)
	if displacement.Magnitude >= Config.ProgressDistance then
		npc.lastPosition = npc.root.Position; npc.progressAt = now
	end
	if now - npc.progressAt >= Config.StuckTime then
		npc.recoveries += 1; npc.progressAt = now
		if npc.recoveries > Config.MaxRecoveryAttempts then
			warn(string.format("[Minions] Despawn stuck %s lane=%s waypoint=%d", npc.model.Name, npc.lane, npc.waypoint))
			AI.Remove(npc.model); return
		end
		npc.humanoid.Jump = true
		local delta = goal - npc.root.Position
		local side = Vector3.new(-delta.Z, 0, delta.X)
		if side.Magnitude > 0.01 then side = side.Unit else side = Vector3.zAxis end
		npc.recoveryGoal = npc.root.Position + side * Config.RecoveryOffset * (if npc.recoveries % 2 == 1 then 1 else -1)
		npc.recoveryUntil = now + 1
		warn(string.format("[Minions] Recovery %d/%d: %s %s", npc.recoveries, Config.MaxRecoveryAttempts, npc.model.Name, npc.lane))
	end
	npc.humanoid:MoveTo(if now < npc.recoveryUntil and npc.recoveryGoal then npc.recoveryGoal else goal)
end
function AI.Update(now: number)
	-- Corpse cleanup also runs after the match has stopped.
	local remove = {}
	for model, npc in records do
		if npc.deadAt and now - npc.deadAt >= Config.CorpseLifetime then table.insert(remove, model) end
	end
	for _, model in remove do AI.Remove(model) end
	if not running then return end
	rebuildGrid()
	for model, npc in records do
		if npc.deadAt or now - npc.spawnedAt < Config.SpawnGrace then continue end
		if npc.humanoid.Health <= 0 then dead(npc); continue end
		if npc.root.Position.Y < MapConfig.Origin.Y - 15 then AI.Remove(model); continue end
		local fighter = Fighters.Get(model)
		if not fighter or fighter.logic.mode == "Stunned" or (fighter.sleep and fighter.sleep.active) then
			npc.progressAt = now; npc.lastPosition = npc.root.Position; continue
		end
		if not Damage.CanAct(model) then continue end
		local target = selectTarget(npc)
		npc.target = target; model:SetAttribute("TargetName", if target then target.Name else "")
		local goal: Vector3? = nil
		if target then
			local targetRoot = target:FindFirstChild("HumanoidRootPart") :: BasePart
			goal = targetRoot.Position
			if (goal - npc.root.Position).Magnitude <= npc.stats.AttackRange and visible(npc, target, goal) then
				setMode(npc, "Attacking"); npc.humanoid:MoveTo(npc.root.Position); npc.progressAt = now
				if now >= npc.nextAttack then
					npc.nextAttack = now + npc.stats.AttackCooldown
					-- Presentation timestamp only; the existing server damage/cooldown stays authoritative.
					model:SetAttribute("MinionAttackAt", now)
					local humanoid = target:FindFirstChildOfClass("Humanoid")
					if humanoid and Damage.ApplyAttack(model, humanoid, npc.stats.Damage) > 0 then
						AI.Shot:Fire(npc.root.Position, goal, npc.kind, npc.teamId, target, model:GetAttribute("RoundId"))
					end
				end
				continue
			end
		else
			local waypoint = npc.route[npc.waypoint]
			if waypoint and ((waypoint - npc.root.Position) * Vector3.new(1, 0, 1)).Magnitude <= Config.WaypointRadius then
				npc.waypoint += 1; npc.recoveries = 0; model:SetAttribute("Waypoint", npc.waypoint)
				waypoint = npc.route[npc.waypoint]
			end
			goal = waypoint or baseGoal(npc)
		end
		if goal then move(npc, goal, now) end
	end
end
return AI
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="106">
          <Properties>
            <string name="Name">MinionAppearance</string>
            <string name="Source"><![CDATA[--!strict
-- Original primitive silhouettes; cosmetic parts never participate in combat queries/physics.
local Appearance = {}
function Appearance.Apply(model: Model, kind: string, teamId: string)
	local zetsu = teamId == "Red"
	model:SetAttribute("MinionVisual", if zetsu then "WhiteZetsu" else "Alliance")
	local torso = model:FindFirstChild("Torso") :: BasePart
	local head = model:FindFirstChild("Head") :: BasePart
	local leftArm = model:FindFirstChild("Left Arm") :: BasePart
	local rightArm = model:FindFirstChild("Right Arm") :: BasePart
	local pale = Color3.fromRGB(224, 233, 208)
	local cloth = Color3.fromRGB(39, 49, 65)
	local green = Color3.fromRGB(88, 111, 77)
	local dark = Color3.fromRGB(39, 65, 48)
	local steel = Color3.fromRGB(152, 165, 174)
	local folder = Instance.new("Folder"); folder.Name = "MinionCosmetics"; folder.Parent = model
	local function detail(name: string, parent: BasePart, size: Vector3, offset: CFrame, color: Color3, shape: Enum.PartType?): Part
		local part = Instance.new("Part"); part.Name = name; part.Size = size; part.Color = color
		part.Material = Enum.Material.SmoothPlastic; part.Shape = shape or Enum.PartType.Block
		part.TopSurface = Enum.SurfaceType.Smooth; part.BottomSurface = Enum.SurfaceType.Smooth
		part.CanCollide = false; part.CanTouch = false; part.CanQuery = false; part.Massless = true
		part.CastShadow = false; part.CFrame = parent.CFrame * offset; part.Parent = folder
		local weld = Instance.new("WeldConstraint"); weld.Part0 = parent; weld.Part1 = part; weld.Parent = part
		return part
	end
	for _, item in model:GetChildren() do
		if item:IsA("BasePart") and item.Name ~= "HumanoidRootPart" then item.Color = if zetsu then pale else cloth end
	end
	head.Color = if zetsu then pale else Color3.fromRGB(218, 177, 141)
	if zetsu then
		-- Split organic face, leaf collar and a spine distinguish these from uniformed shinobi.
		detail("FaceGrowth", head, Vector3.new(.55, .95, .14), CFrame.new(-.5, 0, -.52), Color3.fromRGB(163, 187, 139))
		for _, side in { -1, 1 } do
			detail("LeafCollar", torso, Vector3.new(.55, 1.8, 1.4), CFrame.new(side * 1.05, .75, .25) * CFrame.Angles(0, 0, -side * .4), dark, Enum.PartType.Ball)
			detail("RootVein", torso, Vector3.new(.12, 1.6, .12), CFrame.new(side * .5, -.05, -.55) * CFrame.Angles(0, 0, side * .25), green)
			detail("Eye", head, Vector3.new(.19, .12, .09), CFrame.new(side * .37, .12, -.56), Color3.fromRGB(78, 93, 42))
		end
		detail("Spine", torso, Vector3.new(.35, 1.85, .35), CFrame.new(0, 0, .63), green)
		if kind == "Ranged" then
			detail("SeedPod", torso, Vector3.new(1.3, 1.3, .8), CFrame.new(0, .2, .95), dark, Enum.PartType.Ball)
			detail("SeedArm", rightArm, Vector3.new(1.14, 1.25, 1.14), CFrame.new(0, -.3, 0), green, Enum.PartType.Ball)
		else
			for _, arm in { leftArm, rightArm } do
				detail("RootBlade", arm, Vector3.new(.2, 1.5, .35), CFrame.new(0, -.65, -.65) * CFrame.Angles(-.3, 0, 0), dark)
			end
		end
	else
		detail("FlakVest", torso, Vector3.new(2.12, 1.65, 1.15), CFrame.new(0, .12, 0), green)
		detail("VestSeam", torso, Vector3.new(.1, 1.5, .09), CFrame.new(0, .1, -.62), dark)
		for _, side in { -1, 1 } do
			detail("VestPouch", torso, Vector3.new(.65, .55, .22), CFrame.new(side * .53, -.22, -.66), Color3.fromRGB(116, 133, 92))
			detail("Eye", head, Vector3.new(.17, .09, .08), CFrame.new(side * .36, .03, -.54), cloth)
			local leg = model:FindFirstChild((if side == -1 then "Left" else "Right") .. " Leg") :: BasePart
			detail("ShinWrap", leg, Vector3.new(1.04, .6, 1.04), CFrame.new(0, -.35, 0), Color3.fromRGB(179, 184, 165))
		end
		detail("ForeheadCloth", head, Vector3.new(2.03, .32, 1.03), CFrame.new(0, .27, 0), cloth)
		detail("AlliancePlate", head, Vector3.new(1.05, .27, .1), CFrame.new(0, .27, -.57), steel)
		-- A simple original linked-bars insignia, rather than an external decal asset.
		detail("AllianceMark", head, Vector3.new(.38, .07, .03), CFrame.new(0, .27, -.635) * CFrame.Angles(0, 0, .35), dark)
		detail("Belt", torso, Vector3.new(2.08, .23, 1.1), CFrame.new(0, -.82, 0), dark)
		if kind == "Ranged" then
			detail("Scroll", torso, Vector3.new(.65, 1.8, .65), CFrame.new(0, 0, .95) * CFrame.Angles(0, 0, .5), Color3.fromRGB(200, 183, 136), Enum.PartType.Cylinder)
			detail("SealCuff", rightArm, Vector3.new(1.08, .55, 1.08), CFrame.new(0, -.5, 0), steel)
		else
			detail("KunaiHandle", rightArm, Vector3.new(.16, .6, .16), CFrame.new(0, -1.1, -.4), dark)
			detail("KunaiBlade", rightArm, Vector3.new(.24, .65, .1), CFrame.new(0, -1.7, -.4), steel)
		end
	end
end
return Appearance
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="107">
          <Properties>
            <string name="Name">MinionFactory</string>
            <string name="Source"><![CDATA[--!strict
local Physics = game:GetService("PhysicsService")
local Config = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared").Config.MinionConfig)
local Appearance = require(script.Parent.MinionAppearance)
local Factory = {}
local registered = false
function Factory.Create(kind: string, teamId: string, color: Color3, position: Vector3, stats: Config.Stats): Model
	if not registered then
		if not Physics:IsCollisionGroupRegistered("SurvivalMinions") then Physics:RegisterCollisionGroup("SurvivalMinions") end
		Physics:CollisionGroupSetCollidable("SurvivalMinions", "SurvivalMinions", false)
		registered = true
	end
	local model = Instance.new("Model"); model.Name = teamId .. kind
	model:SetAttribute("TeamId", teamId); model:SetAttribute("EntityKind", "Minion"); model:SetAttribute("MinionType", kind)
	local function part(name: string, size: Vector3, offset: Vector3, visible: boolean): Part
		local item = Instance.new("Part"); item.Name = name; item.Size = size; item.Position = position + offset
		item.Color = color; item.Material = Enum.Material.SmoothPlastic
		item.TopSurface = Enum.SurfaceType.Smooth; item.BottomSurface = Enum.SurfaceType.Smooth
		item.CollisionGroup = "SurvivalMinions"; item.CanCollide = name == "Torso"; item.CanTouch = false
		item.Transparency = if visible then 0 else 1; item.Parent = model
		return item
	end
	local root = part("HumanoidRootPart", Vector3.new(2, 2, 1), Vector3.zero, false)
	local torso = part("Torso", Vector3.new(2, 2, 1), Vector3.zero, true)
	local head = part("Head", Vector3.new(2, 1, 1), Vector3.new(0, 1.5, 0), true)
	head.Color = if kind == "Ranged" then Color3.fromRGB(255, 217, 105) else color:Lerp(Color3.new(1, 1, 1), 0.3)
	local function joint(name: string, parent: BasePart, child: BasePart, offset: Vector3): Motor6D
		local motor = Instance.new("Motor6D"); motor.Name = name; motor.Part0 = parent; motor.Part1 = child
		motor.C0 = CFrame.new(offset); motor.Parent = parent
		return motor
	end
	joint("RootJoint", root, torso, Vector3.zero); joint("Neck", torso, head, Vector3.new(0, 1.5, 0))
	for _, side in { -1, 1 } do
		local label = if side == -1 then "Left" else "Right"
		local arm = part(label .. " Arm", Vector3.new(1, 2, 1), Vector3.new(side * 1.5, 0, 0), true)
		local leg = part(label .. " Leg", Vector3.new(1, 2, 1), Vector3.new(side * 0.5, -2, 0), true)
		-- Rotate around shoulders/hips while preserving all original part positions and sizes.
		local shoulder = joint(label .. " Shoulder", torso, arm, Vector3.new(side * 1.5, .75, 0))
		shoulder.C1 = CFrame.new(0, .75, 0)
		local hip = joint(label .. " Hip", torso, leg, Vector3.new(side * 0.5, -1, 0))
		hip.C1 = CFrame.new(0, 1, 0)
	end
	local humanoid = Instance.new("Humanoid"); humanoid.MaxHealth = stats.MaxHealth; humanoid.Health = stats.MaxHealth
	humanoid.WalkSpeed = stats.WalkSpeed; humanoid.BreakJointsOnDeath = false; humanoid.DisplayName = teamId .. " " .. kind
	humanoid.HealthDisplayDistance = 45; humanoid.NameDisplayDistance = 30; humanoid.Parent = model
	model.PrimaryPart = root
	Appearance.Apply(model, kind, teamId)
	return model
end
return Factory
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="108">
          <Properties>
            <string name="Name">MinionSpawnerService</string>
            <string name="Source"><![CDATA[--!strict
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config.MinionConfig)
local MapConfig = require(Shared.Config.MapConfig)
local Mode = require(Shared.Config.GameModeConfig)
local AI = require(script.Parent.MinionAIService)
local Factory = require(script.Parent.MinionFactory)
local Teams = require(script.Parent.TeamService)
local Builder = require(script.Parent.MapBuilder)
local Spawner = {}
local map: Folder? = nil
local container: Folder? = nil
function Spawner.Start(arena: Folder)
	if container then return end
	map = arena
	local existing = workspace:FindFirstChild("NPCs")
	assert(not existing or existing:IsA("Folder"), "Workspace.NPCs must be a Folder")
	local root = (existing or Instance.new("Folder")) :: Folder; root.Name = "NPCs"; root.Parent = workspace
	local owned = root:FindFirstChild("SurvivalMinions")
	assert(not owned, "SurvivalMinions container already exists")
	local created = Instance.new("Folder"); created.Name = "SurvivalMinions"; created.Parent = root; container = created
end
function Spawner.Spawn(teamId: string, lane: string, kind: string, slot: number): Model?
	local arena, parent = map, container
	if not arena or not parent or not Teams.IsActive(teamId) or AI.GetCount() >= Config.MaxActiveNPCs then return nil end
	local state = Teams.GetState(); if not state or state.phase ~= "InProgress" then return nil end
	local types: { [string]: Config.Stats } = Config.Types
	local stats = types[kind]; assert(stats, "Unknown minion type")
	local settings = MapConfig.Teams :: { [string]: { Base: Vector3, Hero: Vector3, Reverse: boolean } }
	local layout = settings[teamId]; assert(layout, "Missing route direction")
	local route = Builder.Route(arena, lane, layout.Reverse)
	local points = arena:FindFirstChild("SpawnPoints"); assert(points)
	local teamPoints = points:FindFirstChild(teamId); assert(teamPoints)
	local marker = teamPoints:FindFirstChild(lane)
	assert(marker and marker:IsA("BasePart"), "Minion spawn missing")
	local color = Color3.new(1, 1, 1)
	for _, definition in Mode.Teams do if definition.Id == teamId then color = definition.Color end end
	local position = marker.Position + Vector3.new(0, 0, (slot - 2) * Config.SpawnSpacing)
	local model = Factory.Create(kind, teamId, color, position, stats); model.Parent = parent
	AI.Register(model, teamId, kind, lane, route, stats)
	return model
end
function Spawner.Wave(number: number)
	local ids = Teams.GetActiveTeams()
	-- Rotate team ordering when the shared cap leaves only a partial wave.
	for slot, kind in Config.WaveComposition do
		for _, lane in MapConfig.LaneOrder do
			for offset = 1, #ids do
				local index = ((offset + number - 2) % #ids) + 1
				Spawner.Spawn(ids[index], lane, kind, slot)
			end
		end
	end
end
return Spawner
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="109">
          <Properties>
            <string name="Name">NarutoAbilityService</string>
            <string name="Source"><![CDATA[--!strict
-- Application layer for source-derived base melee variants. Domain modules own timers/rules;
-- Roblox services own entities, input admission, resource transactions and world effects.
local Players = game:GetService("Players")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Definitions = require(Shared.Abilities.NarutoDefinitions)
local Units = require(Shared.Abilities.WorldUnits)
local Rasengan = require(Shared.Abilities.RasenganState)
local Q = Rasengan.configure(Definitions.Rasengan)
local Variants=require(Shared.Abilities.RasenganVariants)
local Sleep=require(script.Parent.NarutoSleepService)
local Shuriken=require(script.Parent.RasenshurikenMeleeService)
local Thrown=require(script.Parent.RasenshurikenThrowService)
local ThrowRules=require(Shared.Abilities.RasenshurikenThrowRules)
local CloneState = require(Shared.Abilities.CloneState)
local W = CloneState.configure(Definitions.Clones)
local Commands = require(Shared.Abilities.CloneCommands)
local Resource = require(Shared.Abilities.NarutoResources)
local ResourceRules = Resource.configure(Definitions.Hero, Definitions.NativeInference)

local Fighters = require(script.Parent.FighterStateService)
local Combat = require(script.Parent.CombatService)
local Hitboxes = require(script.Parent.HitboxService)
local Damage = require(script.Parent.DamageService)
local Stats = require(script.Parent.CharacterStatsService)
local Progression = require(script.Parent.HeroProgressionService)
local Teams = require(script.Parent.TeamService)
local Summons = require(script.Parent.NarutoSummonService)
local Displacement = require(script.Parent.AbilityDisplacementService)
local RankPolicy=require(Shared.Abilities.NarutoRankPolicy)
local ClonePlan=require(Shared.Abilities.CloneCastPlan)
local Sage=require(Shared.Abilities.SageState)
local Meditation=require(Shared.Abilities.MeditationState)
local MeditationClones=require(script.Parent.MeditationCloneService)
local GamaDomain=require(Shared.Abilities.GamakichiState)
local Gama=require(script.Parent.GamakichiService)
local Kcm=require(script.Parent.NarutoKcmService)
local Kurama=require(script.Parent.NarutoKuramaService)
local Ranged=require(script.Parent.NarutoRangedService)
type Session = { variants: Variants.State, shurikenSnapshot: number, meditation: Meditation.State, meditationMode: boolean, meditationRecallAt: number, sage: Sage.State, gama: GamaDomain.State, q: Rasengan.State, clones: CloneState.State, commands: Commands.State, pool: Resource.Pool,
	character: Model?, target: Model?, life: number, selfStun: boolean, selfControlUntil: number,
	preparationStunned: boolean, nextPublish: number, connections: { RBXScriptConnection } }
local Service = { Visual = Instance.new("BindableEvent") }
local sessions: { [Player]: Session } = {}
local started = false
-- KCM worker injects its authoritative current form, without dependency cycles.
-- Called at clone creation; existing clones retain their original profile on morph.
local meditationForm: (Player)->Meditation.Form = function(_player) return "Ordinary" end
function Service.ConfigureMeditationForms(provider: (Player)->Meditation.Form) meditationForm=provider end
local function roundId(): number local match = Teams.GetState(); return if match then match.roundId else 0 end
local function values(player: Player): Resource.Values
	local character = player.Character
	local bonus = if character then character:GetAttribute("StrengthBonus") else nil
	return ResourceRules.values(Stats.Get(player).Level, if typeof(bonus) == "number" and bonus == bonus and math.abs(bonus) < math.huge then bonus else 0)
end
function Service.GetStats(player: Player): (number, number) return Stats.Get(player).Level, values(player).strength end
function Service.Get(player: Player): Session? return sessions[player] end
function Service.IsAbility(id: string): boolean return id=="RasenshurikenThrow" or Ranged.IsAbility(id) or Kcm.IsAbility(id) or id == "MeditationToggle" or id == "MeditationRecall" or id == "ShadowSleep" or id == "Odama" or id == "Rasenshuriken" or id == "SageMode" or id == "GamakichiOil" or id == "GamakichiChop" or id == "Gamakichi" or id == "Rasengan" or id == "ShadowClones" or id == "CloneCommand" end
function Service.Ready(player: Player): { [string]: number }
	local session = sessions[player]; local toad=Gama.Get(player); local ranged=Ranged.Ready(player)
	return if session then { RikudoHY=ranged.RikudoHY or 0, RikudoHZ=ranged.RikudoHZ or 0, KuramaForm=if player.Character then (player.Character:GetAttribute("Ready_KuramaForm") or 0) :: number else 0, KCM=if player.Character then (player.Character:GetAttribute("Ready_KCM") or 0) :: number else 0, KcmDash=if player.Character then (player.Character:GetAttribute("Ready_KcmDash") or 0) :: number else 0, MeditationRecall=session.meditationRecallAt, Odama=session.variants.cooldowns.Odama or 0, Rasenshuriken=session.variants.cooldowns.Rasenshuriken or 0, SageMode=session.sage.cooldownAt, Rasengan = session.q.cooldownAt, ShadowClones = session.clones.cooldownAt, Gamakichi=session.gama.cooldownAt, GamakichiOil=if toad then toad.spells.oilReady else 0, GamakichiChop=if toad then toad.spells.chopReady else 0 } else {}
end
local function publish(player: Player, session: Session, now: number)
	local model = session.character; if not model or model ~= player.Character then return end
	local cast = session.q.active
	model:SetAttribute("SummonOrder", Commands.resolve(session.commands).mode)
	local sage=session.sage.active
 model:SetAttribute("MeditationMode",session.meditationMode)
 model:SetAttribute("Ready_MeditationRecall",session.meditationRecallAt)
 local meditationCount=0; for _ in session.meditation.clones do meditationCount+=1 end
 model:SetAttribute("MeditationCloneCount",meditationCount)
 model:SetAttribute("SageHealthProvisional",sage~=nil and sage.rank==3)
 model:SetAttribute("RasenganVariant",if cast then cast.variant else "")
 model:SetAttribute("RasenganVariantUntil",if cast and cast.variant=="Rasengan" then cast.expiresAt elseif cast and cast.variant=="Odama" then cast.startedAt+1 else 0)
 model:SetAttribute("Ready_Odama",session.variants.cooldowns.Odama or 0)
 model:SetAttribute("Ready_Rasenshuriken",session.variants.cooldowns.Rasenshuriken or 0)
 model:SetAttribute("Ready_SageMode",session.sage.cooldownAt)
 model:SetAttribute("SagePhase",if sage then sage.phase else "")
 model:SetAttribute("SageRank",if sage then sage.rank else 0)
 model:SetAttribute("SageReadyAt",if sage then sage.readyAt else 0)
 model:SetAttribute("SageExpiresAt",if sage then sage.expiresAt else 0)
 model:SetAttribute("SageAuraUntil",if sage then sage.auraUntil else 0)
 if sage then game:GetService("CollectionService"):AddTag(model,"NarutoSage") else game:GetService("CollectionService"):RemoveTag(model,"NarutoSage") end
 model:SetAttribute("Ready_Gamakichi",session.gama.cooldownAt)
	model:SetAttribute("GamakichiCount",if Gama.Get(player) then 1 else 0)
	model:SetAttribute("Mana", session.pool.mana); model:SetAttribute("MaxMana", session.pool.maximum)
	model:SetAttribute("Strength", values(player).strength); model:SetAttribute("NativeStatsProvisional", true)
	model:SetAttribute("Ready_Rasengan", session.q.cooldownAt); model:SetAttribute("Ready_ShadowClones", session.clones.cooldownAt)
	model:SetAttribute("RasenganPhase", if cast then cast.phase else "")
	model:SetAttribute("RasenganHeld", Q.hasMarker(session.q, now))
	model:SetAttribute("RasenganVisible", Q.hasMarker(session.q, now) and cast ~= nil and now >= cast.startedAt + Definitions.Rasengan.HandEffectDelay)
	model:SetAttribute("RasenganStartedAt", if cast then cast.startedAt else 0)
	model:SetAttribute("RasenganReadyAt", if cast then cast.readyAt else 0)
	model:SetAttribute("RasenganImpactAt", if cast then cast.impactAt or 0 else 0)
	model:SetAttribute("RasenganSelfPauseUntil", session.selfControlUntil)
	model:SetAttribute("RasenganExpiresAt", if cast then cast.expiresAt else 0)
	model:SetAttribute("NarutoCastId", session.q.serial)
	local cloneCount = 0; for _ in session.clones.clones do cloneCount += 1 end
	model:SetAttribute("NativeCloneCount", cloneCount)
	model:SetAttribute("NarutoPausedUntil", session.selfControlUntil)
	if model:GetAttribute("NativePose") == true then
		local ends = model:GetAttribute("AbilityEndsAt")
		if not cast or typeof(ends) ~= "number" or now >= ends then
			model:SetAttribute("NativePose", nil); model:SetAttribute("AbilityId", "")
		end
	end
	session.nextPublish = now + 0.1
end
local function cancelQ(player: Player, session: Session, now: number)
	Variants.cancel(session.variants); Rasengan.cancel(session.q); session.target = nil; session.selfControlUntil = 0; publish(player, session, now)
end
local function selfStun(session: Session, fighter: Fighters.Fighter, now: number, duration: number)
	session.selfControlUntil = now + duration; session.selfStun = true
	Fighters.StunSpell(fighter, duration)
	session.selfStun = false
end
local function clearSage(session: Session)
 Sage.cancel(session.sage)
 local model=session.character
 if model then
  Stats.SetLayer(model,"NarutoSage",nil)
  game:GetService("CollectionService"):RemoveTag(model,"NarutoSage")
  for _,key in {"SagePhase","SageRank","SageReadyAt","SageExpiresAt","SageAuraUntil"} do model:SetAttribute(key,nil) end
 end
end
local function invalidate(player: Player, session: Session)
 Ranged.Invalidate(player)
 MeditationClones.ClearOwner(player)
 Meditation.invalidate(session.meditation,roundId(),session.life+1)
 Variants.cancel(session.variants)
 clearSage(session)
	Gama.Remove(player); GamaDomain.cancel(session.gama)
	session.life += 1; Sage.newLife(session.sage,roundId(),session.life); Rasengan.newLife(session.q, session.life); CloneState.newLife(session.clones, session.life)
	Commands.suspend(session.commands); session.target = nil; session.selfControlUntil = 0
	publish(player, session, workspace:GetServerTimeNow())
end
local function bind(player: Player): Session
	local existing = sessions[player]; if existing then return existing end
	local now, owner = workspace:GetServerTimeNow(), tostring(player.UserId)
	local session: Session = { variants=Variants.new(), shurikenSnapshot=0, meditation=Meditation.new(owner,roundId(),0), meditationMode=false, meditationRecallAt=0, sage=Sage.new(owner,roundId(),0), gama=GamaDomain.new(), q = Rasengan.new(owner, roundId(), 0), clones = CloneState.new(owner, roundId(), 0),
		commands = Commands.new(owner, roundId(), 0), pool = Resource.new(values(player), now), character = nil, target = nil,
		life = 0, selfStun = false, selfControlUntil = 0, preparationStunned = false, nextPublish = 0, connections = {} }
	sessions[player] = session
	local function added(model: Model)
		invalidate(player, session); session.character = model; session.preparationStunned = false
		session.pool = Resource.new(values(player), workspace:GetServerTimeNow())
		Commands.newLife(session.commands, roundId(), session.life)
		publish(player, session, workspace:GetServerTimeNow())
	end
	session.connections = {
		player.CharacterAdded:Connect(added),
		player.CharacterRemoving:Connect(function(model)
			if session.character == model then invalidate(player, session); session.character = nil end
		end),
	}
	if player.Character then added(player.Character) end
	return session
end
function Service.TryCast(player: Player, id: string, requestId: number, now: number, targetValue: any): (boolean, string)
	if id=="ShadowSleep" then if typeof(targetValue)~="Instance" then return false,"Target" end; id="ShadowClones" end
	local session = bind(player); local model = player.Character
	local fighter = if model then Fighters.GetOrCreate(model) else nil
	if not model or not fighter then return false, "Unavailable" end
	if fighter.sleep and fighter.sleep.active then return false, "Busy" end
	Resource.recalculate(session.pool, values(player), now)
	if Ranged.IsAbility(id) then return Ranged.TryCast(player,id,requestId,now,targetValue) end
	if Kcm.IsAbility(id) then return Kcm.TryCast(player,id,requestId,now,targetValue) end
	if Kcm.Blocked(model,id) then return false,"Form" end
 if id=="MeditationToggle" or id=="MeditationRecall" then
  if targetValue~=nil then return false,"Malformed" end
  if fighter.logic.mode~="Idle" or session.selfControlUntil>now then return false,"Busy" end
  if id=="MeditationToggle" then
   session.meditationMode=not session.meditationMode
  else
   if now<session.meditationRecallAt then return false,"Cooldown" end
   if next(session.meditation.clones)==nil then return false,"Unavailable" end
   session.meditationRecallAt=now+Meditation.Policy.RecallCooldown
   MeditationClones.Recall(player,now)
  end
  publish(player,session,now); return true,"Accepted"
 end
	if id=="GamakichiOil" or id=="GamakichiChop" then return Gama.TrySpell(player,id,requestId,now,targetValue) end
	if id == "CloneCommand" then
		if typeof(targetValue) == "string" then
			local accepted, reason = Commands.order(session.commands, tostring(player.UserId), roundId(), session.life, requestId, targetValue)
			if accepted then publish(player, session, now) end
			return accepted, reason
		end
		if typeof(targetValue) ~= "Instance" then return false, "Target" end
		local instance = targetValue :: Instance
		if not instance:IsA("Model") then return false, "Target" end
		local target = instance :: Model; local root = target:FindFirstChild("HumanoidRootPart")
		local valid = root ~= nil and root:IsA("BasePart") and Damage.CanDamage(model, target)
			and (root.Position - fighter.root.Position).Magnitude <= Units.toStuds(Definitions.Clones.RangeWarcraft)
		if not valid or not Fighters.Get(target) then return false, "Target" end
		local accepted, reason = Commands.command(session.commands, tostring(player.UserId), roundId(), session.life, requestId, Summons.EntityId(target), true)
		if accepted then publish(player, session, now) end
		return accepted, reason
	end
	if (fighter.sleep and fighter.sleep.active) or fighter.logic.mode ~= "Idle" or fighter.logic.nextAttackAt > now or session.selfControlUntil > now
		or (model:GetAttribute("AbilityId") ~= nil and model:GetAttribute("AbilityId") ~= "") then return false, "Busy" end
	if id=="RasenshurikenThrow" then
        local cast=session.q.active;local sage=session.sage.active;local profile=Progression.Get(player)
        if typeof(targetValue)~="Vector3" then return false,"Malformed" end
        if not cast or not ThrowRules.allowed(if profile then profile.Learned.Rasengan or 0 else 0,sage~=nil and sage.phase=="Active" and now<sage.expiresAt,cast.variant,cast.phase,now,cast.readyAt,cast.expiresAt) then return false,"Unavailable" end
        local life,epoch=session.life,roundId()
        local ok=Thrown.Begin(model,targetValue,now,function() return values(player).strength end,function()
            return player.Character==model and session.life==life and roundId()==epoch and Damage.CanAct(model)
        end)
        if not ok then return false,"Target" end
        model:SetAttribute("RasenshurikenThrowAt",now)
        cancelQ(player,session,now)
        return true,"Accepted"
    elseif id=="Odama" or id=="Rasenshuriken" then
        if targetValue~=nil then return false,"Malformed" end
        local sage=session.sage.active
        local sageThrow=id=="Rasenshuriken" and sage~=nil and sage.phase=="Active" and now<sage.expiresAt
        if not sageThrow and (sage~=nil or meditationForm(player)~="Ordinary") then return false,"FormAdapterUnverified" end
        local cast=session.q.active; if not cast or cast.phase=="Consumed" then return false,"Window" end
        local profile=Progression.Get(player)
        local rank=if profile then profile.Learned.Rasengan or 0 else 0
        local choice,reason,debit=Variants.select(session.variants,id,rank,cast.startedAt,now,session.pool.mana,cast.variant=="Rasengan")
        if not choice then return false,reason end
        assert(Resource.spend(session.pool,debit))
        cast.variant=id; cast.phase="Preparing"; cast.startedAt=now; cast.readyAt=choice.readyAt; cast.expiresAt=choice.expiresAt
        cast.stun=Variants.stun(id); cast.impactDelay=if id=="Rasenshuriken" then .5 else 1
        session.preparationStunned=false
        if id=="Rasenshuriken" then session.shurikenSnapshot=values(player).strength; selfStun(session,fighter,now,1.5) end
        publish(player,session,now); return true,"Accepted"
    elseif id=="SageMode" then
        if targetValue~=nil then return false,"Malformed" end
        if session.q.active then return false,"Busy" end
        local profile=Progression.Get(player)
        local sage,reason,debit=Sage.request(session.sage,now,requestId,if profile then profile.Learned.SageMode or 0 else 0,Stats.Get(player).Level,session.pool.mana,session.meditationMode)
        if not sage then return false,reason end
        assert(Resource.spend(session.pool,debit))
        selfStun(session,fighter,now,sage.readyAt-now)
        publish(player,session,now); return true,"Accepted"
    elseif id == "Gamakichi" then
        if targetValue~=nil then return false,"Malformed" end
        local profile=Progression.Get(player)
        local cast,reason,debit=GamaDomain.request(session.gama,now,requestId,if profile then profile.Learned.Gamakichi or 0 else 0,session.pool.mana)
        if not cast then return false,reason end
        assert(Resource.spend(session.pool,debit))
        Gama.Spawn(player,model,session.gama,cast,session.commands)
        publish(player,session,now); return true,"Accepted"
    elseif id == "Rasengan" then
        if Stats.Get(player).Level < Definitions.Rasengan.RequiredLevel then return false, "Level" end
		if targetValue ~= nil then return false, "Malformed" end
		local cast, reason, debit = Q.request(session.q, now, requestId, session.pool.mana, true)
		if not cast then return false, reason end
		Variants.cancel(session.variants)
		assert(Resource.spend(session.pool, debit), "Q debit must commit without yielding")
		session.preparationStunned = false
		publish(player, session, now); return true, "Accepted"
	elseif id == "ShadowClones" then
        local profile=Progression.Get(player)
        local rank=if profile then profile.Learned.ShadowClones or 0 else 0
        if session.pool.mana<200 then return false,"Mana" end
        local variant="OrdinarySelf"
        if typeof(targetValue)=="Instance" then
            if not (targetValue :: Instance):IsA("Model") then return false,"Target" end
            local target=targetValue :: Model
            if rank<2 or not Damage.CanDamage(model,target) or target:FindFirstChildOfClass("ForceField") then return false,"Target" end
            local root=target:FindFirstChild("HumanoidRootPart")
            if not root or not root:IsA("BasePart") or (root.Position-fighter.root.Position).Magnitude>Units.toStuds(2000) then return false,"Target" end
            if now<session.clones.cooldownAt or session.clones.burst then return false,"Cooldown" end
            if not Sleep.Apply(model,target,now) then return false,"Target" end
            assert(Resource.spend(session.pool,200)); session.clones.cooldownAt=now+Definitions.Clones.Cooldowns[rank]
            publish(player,session,now); return true,"Accepted"
        elseif targetValue~=nil then
            if typeof(targetValue)~="Vector3" or not Hitboxes.IsFiniteCFrame(CFrame.new(targetValue)) then return false,"Target" end
            if (targetValue-fighter.root.Position).Magnitude>Units.toStuds(2000) then return false,"Target" end
            variant="OrdinaryPoint"
        end
        local plan,planReason=RankPolicy.ordinaryClonePlan(rank,variant)
        if not plan then return false,planReason end
        local resourcePlan=ClonePlan.create(rank,if variant=="OrdinarySelf" then "Self" else "Point",session.pool.mana,session.pool.maximum)
        if not resourcePlan then return false,"Mana" end
        plan.count=resourcePlan.count
        local extra=resourcePlan.extraManaDrain
        if session.pool.mana<plan.manaCost then return false,"Mana" end
		local burst, reason = W.begin(session.clones, now, requestId, plan.count, plan.cooldown)
		if not burst then return false, reason end
		assert(Resource.spend(session.pool, plan.manaCost+extra), "W debit must commit without yielding")
		model:SetAttribute("NativePose", true); model:SetAttribute("AbilityId", "ShadowClones")
		model:SetAttribute("AbilityStartedAt", now); model:SetAttribute("AbilityEndsAt", now + 0.25)
		publish(player, session, now); return true, "Accepted"
	end
	return false, "Unsupported"
end
function Service.Reset()
	Ranged.Reset(); Kcm.Reset()
	Sleep.Reset(); Shuriken.Reset(); Thrown.Reset(); Summons.Reset(); Gama.Reset(); Displacement.Reset(); MeditationClones.Reset()
	for player, session in sessions do
		Meditation.invalidate(session.meditation,roundId(),session.life+1); session.meditationMode=false; session.meditationRecallAt=0
		session.variants=Variants.new(); clearSage(session); Sage.reset(session.sage,roundId(),session.life+1); session.gama=GamaDomain.new()
		session.life += 1; Rasengan.reset(session.q, roundId(), session.life); CloneState.reset(session.clones, roundId(), session.life)
		Commands.newLife(session.commands, roundId(), session.life); session.target = nil; session.selfControlUntil = 0
		session.pool = Resource.new(values(player), workspace:GetServerTimeNow()); publish(player, session, workspace:GetServerTimeNow())
	end
end
function Service.Update(now: number)
	Kcm.Update()
	for player, session in sessions do
		Resource.recalculate(session.pool, values(player), now)
		local model = session.character; local fighter = if model then Fighters.Get(model) else nil
		if model and fighter then
			if not Damage.CanAct(model) or fighter.logic.mode == "Dead" then
				if session.sage.active or next(session.meditation.clones) or session.q.active or session.clones.burst or session.commands.active then invalidate(player, session) end
			else
                local preparing=session.sage.active
                if preparing and preparing.meditation and not preparing.clonesSpawned and now>=preparing.cloneSpawnAt and now<preparing.readyAt then
                    preparing.clonesSpawned=true
                    local ownerCharacter=model; local life=session.life; local epoch=roundId()
                    local clones=Meditation.spawn(session.meditation,now,preparing.rank,Stats.Get(player).Level,meditationForm(player))
                    MeditationClones.Spawn(player,model,session.meditation,clones,function()
                        local humanoid=ownerCharacter:FindFirstChildOfClass("Humanoid")
                        return sessions[player]==session and player.Parent==Players and player.Character==ownerCharacter and session.life==life and roundId()==epoch and humanoid~=nil and humanoid.Health>0 and Damage.CanAct(ownerCharacter)
                    end,function(amount: number)
                        Resource.recalculate(session.pool,values(player),workspace:GetServerTimeNow())
                        session.pool.mana=math.min(session.pool.maximum,session.pool.mana+amount)
                    end)
                end
				if Sage.expire(session.sage,now) then
                    Stats.SetLayer(model,"NarutoSage",nil)
                    game:GetService("CollectionService"):RemoveTag(model,"NarutoSage")
                end
                local activated=Sage.activate(session.sage,now)
                if activated then
                    Kcm.SageActivated(player)
                    local modifier=Sage.modifier(activated.rank); assert(modifier)
                    Stats.SetLayer(model,"NarutoSage",{health=modifier.health,armor=modifier.armor,attack=modifier.attack,speed=Units.toStuds(modifier.speedWarcraft)})
                    if not activated.meditation then session.pool.mana=math.min(session.pool.maximum,session.pool.mana+Sage.Source.ManaRestore[activated.rank]) end
                    publish(player,session,now)
                end
                -- A lobby/temporary combat lock may have suspended intents before the
				-- round became playable. Resume only the current live owner's clean group.
				if not session.commands.active then Commands.newLife(session.commands, roundId(), session.life) end
				local cast = session.q.active
				if cast and not session.preparationStunned and now >= cast.startedAt + 1 and now < cast.readyAt then
					session.preparationStunned = true; selfStun(session, fighter, now, math.max(0, cast.readyAt - now))
				end
				Q.update(session.q, now); cast = session.q.active
				if cast then
					local targetId = Q.claimControl(session.q, cast, now)
					local target = session.target
					if targetId and target and Damage.CanDamage(model, target) then
						local targetRoot = target:FindFirstChild("HumanoidRootPart")
						if targetRoot and targetRoot:IsA("BasePart") then
							local facing = (targetRoot.Position - fighter.root.Position) * Vector3.new(1,0,1)
							if facing.Magnitude > .001 then fighter.root.CFrame = CFrame.lookAt(fighter.root.Position, fighter.root.Position + facing) end
						end
						local victim = Fighters.GetOrCreate(target)
						if victim then Fighters.StunSpell(victim, cast.stun) end
						selfStun(session, fighter, now, if cast.variant=="Rasenshuriken" then 1.5 else cast.impactDelay)
						local round, life = session.q.round, session.q.life
						local consumedCast: Rasengan.Cast = cast
						if cast.variant~="Rasenshuriken" then Displacement.Begin(model, target, now, 2, 1, 1, 18, 0.03, function()
							return session.q.round == round and session.q.life == life and (session.q.active == consumedCast or consumedCast.impacted) and Damage.CanDamage(model, target)
						end, function() Service.Visual:Fire({kind="RasenganFinish",source=model,variant=consumedCast.variant,castId=consumedCast.id,position=target:GetPivot().Position}) end,
						function() Service.Visual:Fire({kind="RasenganTrail",source=model,variant=consumedCast.variant,castId=consumedCast.id,position=target:GetPivot().Position}) end) end
					end
					local impacted = Q.claimImpact(session.q, cast, now)
					if impacted and target then
						local humanoid = target:FindFirstChildOfClass("Humanoid")
						local level, strength = Service.GetStats(player); local raw = Variants.damage(cast.variant,level,strength)
						if humanoid and raw then
							if cast.variant=="Rasenshuriken" then
                                local round,life=session.q.round,session.q.life
                                Shuriken.Begin(model,target,now,function() return session.q.round==round and session.q.life==life and Damage.CanAct(model) end,function() return values(player).strength end,session.shurikenSnapshot)
                            else
                                local dealt=Damage.Apply(model, humanoid, raw)
                                if dealt>0 then Service.Visual:Fire({kind="RasenganImpact",source=model,variant=cast.variant,castId=cast.id,position=target:GetPivot().Position}) end
                            end
						end
						session.target = nil
					end
				end
				local burst = session.clones.burst
				if burst then
					local clone = W.spawnOne(session.clones, burst, now, true, Q.hasMarker(session.q, now) and (session.q.active :: Rasengan.Cast).variant~="Rasenshuriken")
					if clone then Summons.Spawn(player, model, session.clones, clone, session.commands) end
				end
			end
		end
		CloneState.expire(session.clones, now)
		if now >= session.nextPublish then publish(player, session, now) end
	end
	Ranged.Update(now); Sleep.Update(now); Shuriken.Update(now); Thrown.Update(now); Displacement.Update(now)
end
function Service.Start()
	if started then return end; started = true
	Kcm.Start({
		mana=function(player) local s=sessions[player]; return if s then s.pool.mana else 0 end,
		restoreMana=function(player,amount) local s=sessions[player]; if s then s.pool.mana=math.min(s.pool.maximum,s.pool.mana+amount) end end,
		spendMana=function(player,amount) local s=sessions[player]; return s~=nil and Resource.spend(s.pool,amount) end,
		busy=function(player)
			local s=sessions[player]; if not s then return true end
			local sage=s.sage.active
			return Ranged.Busy(player) or s.q.active~=nil or s.clones.burst~=nil or s.selfControlUntil>workspace:GetServerTimeNow() or (sage~=nil and sage.phase=="Preparing")
		end,
		sage=function(player)
			local s=sessions[player]; local cast=if s then s.sage.active else nil; local now=workspace:GetServerTimeNow()
			return if cast and cast.phase=="Active" then math.max(0,cast.expiresAt-now) else 0, cast~=nil and cast.phase=="Active" and cast.auraUntil>now
		end,
	})
 Ranged.Start({mana=function(p) return bind(p).pool.mana end,spend=function(p,n) return Resource.spend(bind(p).pool,n) end,
  strength=function(p) return values(p).strength end,
  busy=function(p) local s=bind(p);return s.q.active~=nil or s.clones.burst~=nil or s.selfControlUntil>workspace:GetServerTimeNow() or (s.sage.active~=nil and s.sage.active.phase=="Preparing") end,
  pause=function(p,d) local s=bind(p);local f=if p.Character then Fighters.Get(p.Character) else nil;if f then selfStun(s,f,workspace:GetServerTimeNow(),d) end end})
 Ranged.Visual.Event:Connect(function(message) Service.Visual:Fire(message) end)
 Thrown.Visual.Event:Connect(function(message) Service.Visual:Fire(message) end)
 Service.ConfigureMeditationForms(Kcm.MeditationForm)
 Kurama.ConfigureSummonManaReceiver(MeditationClones.RestoreMana)
 Shuriken.Visual.Event:Connect(function(message) Service.Visual:Fire(message) end)
 Gama.Visual.Event:Connect(function(message) Service.Visual:Fire(message) end)
	Players.PlayerAdded:Connect(function(player) bind(player) end)
	Players.PlayerRemoving:Connect(function(player)
		Ranged.Remove(player); Kcm.Remove(player)
		local session = sessions[player]; if not session then return end
		MeditationClones.ClearOwner(player); Meditation.invalidate(session.meditation,roundId(),session.life+1)
		Gama.Remove(player)
		invalidate(player, session); Summons.ClearOwner(player)
		for _, connection in session.connections do connection:Disconnect() end
		sessions[player] = nil
	end)
	Progression.Changed.Event:Connect(function(player: Player, reason: string)
		local session = sessions[player]; if not session then return end
		if reason == "Reset" then session.pool = Resource.new(values(player), workspace:GetServerTimeNow()) end
	end)
	Fighters.Changed.Event:Connect(function(fighter: Fighters.Fighter)
		local player = fighter.player; local session = if player then sessions[player] else nil
		if player and session and session.character == fighter.character and not session.selfStun then
			if fighter.logic.mode == "Dead" then invalidate(player, session)
			elseif fighter.logic.mode == "Stunned" or (fighter.sleep and fighter.sleep.active) then cancelQ(player, session, workspace:GetServerTimeNow()) end
		end
	end)
	Combat.AttackStarted.Event:Connect(function(fighter: Fighters.Fighter)
		local player = fighter.player; local session = if player then sessions[player] else nil
		if not player or not session then return end
		local candidates = Hitboxes.GetTargets(fighter.character, fighter.root, fighter.profile)
		local chosen: Model? = nil; local nearest = math.huge
		for _, humanoid in candidates do
			local target = humanoid.Parent
			if target and target:IsA("Model") and not target:FindFirstChildOfClass("ForceField") and Damage.CanDamage(fighter.character, target) then
				local root = target:FindFirstChild("HumanoidRootPart")
				if root and root:IsA("BasePart") then
					local distance = (root.Position - fighter.root.Position).Magnitude
					if distance < nearest then nearest = distance; chosen = target end
				end
			end
		end
		Kcm.OnAttackStarted(player,chosen~=nil)
	end)
	Combat.SetContactHandler(function(fighter: Fighters.Fighter, chosen: Model): boolean
		local player = fighter.player; local session = if player then sessions[player] else nil
		if not player or not session then return false end
		Commands.assist(session.commands, Summons.EntityId(chosen), true)
		local cast = session.q.active
		local targetRoot = chosen:FindFirstChild("HumanoidRootPart")
		if cast and targetRoot and targetRoot:IsA("BasePart")
			and (targetRoot.Position - fighter.root.Position).Magnitude <= Units.toStuds(50) + (fighter.root.Size.X + targetRoot.Size.X) / 2 then
			local kind = chosen:GetAttribute("EntityKind")
			if Q.attack(session.q, cast, workspace:GetServerTimeNow(), Summons.EntityId(chosen), true, kind ~= "Hero" and kind ~= "Minion" and kind ~= "Summon") then
				session.target = chosen; session.selfControlUntil = workspace:GetServerTimeNow() + 0.01 + cast.impactDelay
				publish(player, session, workspace:GetServerTimeNow())
				Service.Visual:Fire({kind="RasenganContact",source=fighter.character,target=chosen,variant=cast.variant,castId=cast.id,position=targetRoot.Position})
				return true -- One prepared spell replaces this strike, retaining its original damage.
			end
		end
		return false
	end)
	local last = workspace:GetServerTimeNow()
	game:GetService("RunService").Heartbeat:Connect(function()
		local now = workspace:GetServerTimeNow(); local delta = math.max(0, now - last); last = now
		Summons.Update(now, delta, Service.GetStats)
		Gama.Update(now,delta)
        MeditationClones.Update(now)
	end)
	for _, player in Players:GetPlayers() do bind(player) end
end
return Service
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="110">
          <Properties>
            <string name="Name">NarutoKcmService</string>
            <string name="Source"><![CDATA[--!strict
-- Concrete server ports for KCM. NarutoAbilityService provides only mana/busy/Sage seams.
local Players=game:GetService("Players")
local Shared=game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config=require(Shared.Abilities.NarutoKcmConfig)
local Domain=require(Shared.Abilities.NarutoKcmState).configure(Config)
local Adapter=require(Shared.Abilities.NarutoKcmAdapter)
local RangedDomain=require(Shared.Abilities.NarutoRangedState)
local Gameplay=require(Shared.Abilities.NarutoKcmGameplay)
local Kurama=require(script.Parent.NarutoKuramaService)
local Units=require(Shared.Abilities.WorldUnits)
local Stats=require(script.Parent.CharacterStatsService)
local Progression=require(script.Parent.HeroProgressionService)
local Fighters=require(script.Parent.FighterStateService)
local Damage=require(script.Parent.DamageService)
local Targets=require(script.Parent.AbilityTargetService)
local Hitboxes=require(script.Parent.HitboxService)
local Teams=require(script.Parent.TeamService)
export type Hooks={mana: (Player)->number,restoreMana: (Player,number)->(),spendMana: (Player,number)->boolean,
 busy: (Player)->boolean,sage: (Player)->(number,boolean)}
type Record={player: Player,token: Adapter.Token?,model: Model?,dash: Gameplay.DashState,hagoromo: Gameplay.Hagoromo,
 epoch: number,lastRequest: number,sageEntryBlocked: boolean}
local records: {[string]: Record}={}
local visuals: {[Adapter.Token]: Highlight}={}
local models: {[Adapter.Token]: Model}={}
local hooks: Hooks?=nil
type Runtime=typeof(Adapter.configure(Domain,{} :: Adapter.Ports,{} :: Adapter.MorphPolicy))
local runtime: Runtime?=nil
local S={}
local function round(): number local match=Teams.GetState(); return if match then match.roundId else 0 end
local function snapshot(owner: string): Adapter.Snapshot?
 local r=records[owner]; local h=hooks; if not r or not h then return nil end
 local p=r.player; local model=p.Character; local profile=Progression.Get(p)
 local fighter=if model then Fighters.Get(model) else nil
 if not model or not profile or not fighter then return nil end
 local match=Teams.GetState(); local left,aura=h.sage(p)
 if left<=0 then r.sageEntryBlocked=false end
 local live=Damage.CanAct(model)
 return {life=(model:GetAttribute("LifeId") or 0) :: number,epoch=round(),eligible=p.Parent==Players and p:GetAttribute("HeroId")=="OrangeNinja"
  and match~=nil and match.phase=="InProgress" and Teams.IsParticipant(p),
  canCast=live and not (fighter.sleep and fighter.sleep.active) and fighter.logic.mode=="Idle" and fighter.logic.nextAttackAt<=workspace:GetServerTimeNow()
   and not fighter.root.Anchored and not h.busy(p),
  context={level=profile.Level,rank=profile.Learned.KCM or 0,hagoromo=r.hagoromo.granted,alive=live,
   fullKurama=Kurama.IsActive(p),kuramaCooldown=Kurama.IsLocked(p),sageRemaining=left,sageAuraPresent=aura},
  allowed={kcm=(profile.Learned.KCM or 0)>0 and not r.sageEntryBlocked,gamakichi=(profile.Learned.Gamakichi or 0)>0,
   sage=(profile.Learned.SageMode or 0)>0,dash=true,sharing=false,fullKurama=profile.Level>=21}}
end
local function owned(token: Adapter.Token): Model?
 local model=models[token]; local p=Players:GetPlayerByUserId(tonumber(token.owner) or 0)
 if model and p and p.Character==model and model:GetAttribute("LifeId")==token.life
  and model:GetAttribute("RoundId")==token.epoch then return model end
 return nil
end
function S.Start(h: Hooks)
 if runtime then return end; hooks=h
 local ports: Adapter.Ports={now=function() return workspace:GetServerTimeNow() end,read=snapshot,
  kuramaPulse=function(token) local r=records[token.owner]; if r then Kurama.Pulse(r.player) end end,
  publish=function(token,chakra,mask,cooldownAt)
   local model=owned(token); if not model then return end
   model:SetAttribute("KuramaChakra",chakra); model:SetAttribute("KuramaChakraThreshold",900+100*Stats.Get(records[token.owner].player).Level)
   model:SetAttribute("Ready_KCM",cooldownAt)
   model:SetAttribute("KuramaFormAllowed",mask.fullKurama)
   model:SetAttribute("KcmAllowed",mask.kcm); model:SetAttribute("KcmDashReady",mask.dash)
   model:SetAttribute("KcmGamakichiAllowed",mask.gamakichi); model:SetAttribute("KcmSageAllowed",mask.sage)
  end,
  effect=function(token,kind,id)
   local model=owned(token); if not model then return end
   if kind=="Entered" then
    model:SetAttribute("KcmActive",true); model:SetAttribute("KcmCastId",id)
    local highlight=Instance.new("Highlight"); highlight.Archivable=false; highlight.Name="NarutoKcmAura"; highlight.Adornee=model
    highlight.FillColor=Color3.fromRGB(255,179,30); highlight.OutlineColor=Color3.fromRGB(255,230,110)
    highlight.FillTransparency=.8; highlight.DepthMode=Enum.HighlightDepthMode.Occluded; highlight.Parent=model; visuals[token]=highlight
   elseif kind=="Exited" then
    model:SetAttribute("KcmActive",false); model:SetAttribute("KcmCastId",nil)
    local r=records[token.owner]; if r then r.sageEntryBlocked=false end
   end
  end,
  reapplySage=function(_token) end, -- Additive owned layers remain composed; never snapshot/restart Sage.
  restoreMana=function(token,amount) local model=owned(token); if model then h.restoreMana(records[token.owner].player,amount) end end,
  revokeSharing=function(_token) end, -- Sharing branch is deliberately unavailable in snapshot.allowed.
  fault=function(token,reason) warn("KCM "..token.owner..": "..reason) end,
 }
 local policy: Adapter.MorphPolicy={enabled=true,
  apply=function(token,rank)
   local r=records[token.owner]; local model=if r then r.player.Character else nil; local m=Gameplay.modifier(rank)
   if not model or not m or model:GetAttribute("LifeId")~=token.life or round()~=token.epoch then return false end
   models[token]=model
   Stats.SetLayer(model,"NarutoKcm",{health=m.health,armor=m.armor,attack=m.attack,speed=Units.toStuds(m.speedWarcraft)})
   model:SetAttribute("RikudoActive",rank==3)
   model:SetAttribute("KcmRank",rank); model:SetAttribute("KcmPolicy",Gameplay.Policy.Id)
   return true
  end,
  remove=function(token,_rank)
   local model=models[token]
   if model then
    Stats.SetLayer(model,"NarutoKcm",nil)
    model:SetAttribute("RikudoActive",false)
    model:SetAttribute("KcmActive",false); model:SetAttribute("KcmDashReady",false); model:SetAttribute("KcmRank",0)
   end
   local visual=visuals[token]; if visual then visual:Destroy(); visuals[token]=nil end
  end,
 }
 runtime=Adapter.configure(Domain,ports,policy)
 Kurama.Start({
  chakra=function(p) local r=records[tostring(p.UserId)]; return if runtime and r and r.token then runtime.Chakra(r.token) else nil end,
  spend=function(p,amount) local r=records[tostring(p.UserId)]; return runtime~=nil and r~=nil and r.token~=nil and runtime.SpendChakra(r.token,amount) end,
  kcm=function(p) local r=records[tostring(p.UserId)]; return runtime~=nil and r~=nil and r.token~=nil and runtime.IsActive(r.token) end,
  busy=h.busy,restoreMana=h.restoreMana,
 })
end
local function record(p: Player): Record
 assert(runtime)
 local key=tostring(p.UserId); local r=records[key]
 if not r then
  local created: Record={player=p,token=nil,model=nil,dash=Gameplay.newDash(),hagoromo=Gameplay.newHagoromo(),epoch=round(),lastRequest=0,sageEntryBlocked=false}
  records[key]=created; r=created
 end
 if r.epoch~=round() then
  if r.token then runtime.Remove(r.token); models[r.token]=nil end
  r.token=nil; r.dash=Gameplay.newDash(); r.hagoromo=Gameplay.newHagoromo(); r.epoch=round(); r.lastRequest=0; r.sageEntryBlocked=false
 end
 return r
end
local function refresh(p: Player): Record?
 if not runtime then return nil end
 local r=record(p); local profile=Progression.Get(p); local model=p.Character
 local alive=model~=nil and Damage.CanAct(model)
 if profile then
  local event=Gameplay.updateHagoromo(r.hagoromo,workspace:GetServerTimeNow(),profile.Level,alive)
  if event=="Cutscene" and model then local fighter=Fighters.Get(model); if fighter then Fighters.StunSpell(fighter,1) end end
  local folder=Progression.GetFolder(p)
  if folder then folder:SetAttribute("HagoromoUnlocked",r.hagoromo.granted); folder:SetAttribute("HagoromoReadyAt",r.hagoromo.deadline or 0) end
 end
 if r.token then
  local ok=runtime.Update(r.token)
  if not ok then models[r.token]=nil; r.token=nil end
 end
 if not r.token and alive then
  local token=runtime.Bind(tostring(p.UserId))
  if token then r.token=token; r.model=model; if model then models[token]=model end; runtime.Update(token) end
 end
 if model then
  model:SetAttribute("Ready_KcmDash",r.dash.cooldownAt); model:SetAttribute("HagoromoUnlocked",r.hagoromo.granted)
 end
 return r
end
function S.RikudoGrant(p: Player,now: number): (RangedDomain.Grant?,number?)
 if Kurama.IsActive(p) or Kurama.IsLocked(p) then return nil,nil end
 local r=refresh(p);local rt=runtime
 if not rt or not r or not r.token then return nil,nil end
 local rank,castId=rt.ActiveCast(r.token);local model=owned(r.token);local profile=Progression.Get(p)
 if rank~=3 or not castId or not model or not profile or not r.hagoromo.granted
  or (profile.Learned.KCM or 0)~=3 or profile.Level<27 then return nil,nil end
 return {abilityId="",ownerId=tostring(p.UserId),round=r.token.epoch,life=r.token.life,form="Ewrd",
  kcmRank=3,heroLevel=profile.Level,hagoromo=true,expiresAt=now+.1},castId
end
function S.IsAbility(id: string): boolean return id=="KuramaForm" or id=="KCM" or id=="KcmCancel" or id=="KcmDash" or id=="KuramaConvert" end
-- A09J activation disables A017; the source KCM exit action can restore it.
-- Keep this admission action separate from independently composed stat layers.
function S.SageActivated(p: Player)
 local r=records[tostring(p.UserId)]; if r then r.sageEntryBlocked=true end
end
function S.MeditationForm(p: Player): "Ordinary" | "KCM" | "Kurama"
 if Kurama.IsActive(p) then return "Kurama" end
 local r=records[tostring(p.UserId)]
 return if runtime and r and r.token and runtime.IsActive(r.token) then "KCM" else "Ordinary"
end
function S.IsRikudo(p: Player): boolean
 local r=records[tostring(p.UserId)]
 return runtime~=nil and r~=nil and r.token~=nil and runtime.ActiveRank(r.token)==3
end
function S.OnAttackStarted(p: Player,hasTarget: boolean) Kurama.AttackStarted(p,hasTarget) end
function S.Blocked(model: Model,id: string): boolean
 local player=Players:GetPlayerFromCharacter(model)
 return player~=nil and S.MeditationForm(player)=="KCM" and id=="Gamakichi"
end
function S.TryCast(p: Player,id: string,request: number,now: number,target: any): (boolean,string)
 local r=refresh(p); local h=hooks; if not runtime or not r or not r.token or not h then return false,"Unavailable" end
 if request<=r.lastRequest then return false,"Replay" end; r.lastRequest=request
 local token=r.token; local model=p.Character; if not model then return false,"Unavailable" end
 if id=="KuramaForm" then return Kurama.TryCast(p,request,now,target)
 elseif id=="KCM" then
  if target~=nil then return false,"Malformed" end
  local ok,reason=runtime.Enter(token)
  return ok,reason
 elseif id=="KcmCancel" then
  if target~=nil then return false,"Malformed" end
  return runtime.Cancel(token,(model:GetAttribute("KcmCastId") or 0) :: number)
 elseif id=="KuramaConvert" then
  if target~=nil then return false,"Malformed" end
  return runtime.Convert(token)
 elseif id~="KcmDash" then return false,"Unsupported" end
 local snap=snapshot(tostring(p.UserId)); if not snap or not snap.canCast then return false,"Busy" end
 local fighter=Fighters.Get(model); if not fighter then return false,"Unavailable" end
 local destination: Vector3; local victim: Model?=nil
 if typeof(target)=="Vector3" then destination=target
 elseif typeof(target)=="Instance" then
  local selected=target :: Instance; if not selected:IsA("Model") then return false,"Target" end
  victim=selected; local root=selected:FindFirstChild("HumanoidRootPart")
  local kind=selected:GetAttribute("EntityKind")
  if not root or not root:IsA("BasePart") or (kind~="Hero" and kind~="Minion" and kind~="Summon")
   or not Damage.CanDamage(model,selected) or selected:FindFirstChildOfClass("ForceField") then return false,"Target" end
  destination=root.Position
 else return false,"Target" end
 if not Hitboxes.IsFiniteCFrame(CFrame.new(destination)) then return false,"Target" end
 local start=fighter.root.Position; local distance=(destination-start).Magnitude
 if distance>Units.toStuds(Gameplay.Dash.RangeWarcraft) or math.abs(destination.Y-start.Y)>12 then return false,"Range" end
 if not Targets.Visible(model,victim or model,start,destination) then return false,"Blocked" end
 if victim then
  local delta=(start-destination)*Vector3.new(1,0,1)
  if delta.Magnitude>.01 then destination+=delta.Unit*3 end
 end
 local ray=RaycastParams.new(); ray.FilterType=Enum.RaycastFilterType.Exclude; ray.FilterDescendantsInstances={model}
 if victim then ray.FilterDescendantsInstances={model,victim} end
 ray.RespectCanCollide=true
 local ground=workspace:Raycast(destination+Vector3.new(0,6,0),Vector3.new(0,-18,0),ray)
 if not ground or ground.Normal.Y<.5 then return false,"Ground" end
 destination=Vector3.new(destination.X,ground.Position.Y+fighter.humanoid.HipHeight+fighter.root.Size.Y/2,destination.Z)
 local movement=destination-start
 if movement.Magnitude>.01 and workspace:Blockcast(fighter.root.CFrame,fighter.root.Size*.8,movement,ray) then return false,"Blocked" end
 local strength=(model:GetAttribute("Strength") or Stats.Get(p).Strength) :: number
 local ok,reason,cost,damage=Gameplay.dash(r.dash,now,request,runtime.IsActive(token),
  runtime.IsDashReady(token),h.mana(p),distance/Units.StudsPerWarcraftUnit,if victim then "Unit" else "Point",strength)
 if not ok then return false,reason end
 assert(h.spendMana(p,cost)); fighter.root.CFrame=CFrame.new(destination)*fighter.root.CFrame.Rotation
 fighter.root.AssemblyLinearVelocity=Vector3.zero
 if victim and damage then local hp=victim:FindFirstChildOfClass("Humanoid"); if hp then Damage.Apply(model,hp,damage) end end
 model:SetAttribute("Ready_KcmDash",r.dash.cooldownAt)
 return true,"Accepted"
end
function S.StudioResetCooldowns(p: Player)
 if not game:GetService("RunService"):IsStudio() then return end
 local r=records[tostring(p.UserId)]
 if r then r.dash.cooldownAt=0;if runtime and r.token then runtime.ResetCooldown(r.token) end end
end
function S.StudioEnableRikudo(p: Player): (boolean,string)
 if not game:GetService("RunService"):IsStudio() or p.Parent~=Players then return false,"StudioOnly" end
 local rt=runtime;local r=refresh(p);local snap=snapshot(tostring(p.UserId))
 if not rt or not r or not r.token or not snap or not snap.eligible or not snap.canCast then return false,"Busy" end
 if snap.context.level<27 or snap.context.rank~=3 then return false,"Rank" end
 -- Real owner-scoped progression and domain state; never fake replicated form flags.
 r.hagoromo.granted=true;r.hagoromo.deadline=nil;r.hagoromo.cutsceneAt=nil;r.sageEntryBlocked=false
 if rt.ActiveRank(r.token)==3 then
  rt.CreditChakra(r.token,math.max(0,900+100*snap.context.level-(rt.Chakra(r.token) or 0)))
  refresh(p);return true,"AlreadyActive"
 end
 Kurama.Remove(p)
 -- Close a lower KCM rank through normal cleanup before binding a fresh cast token.
 if rt.IsActive(r.token) then
  local old=r.token;rt.Remove(old);models[old]=nil;r.token=nil
 end
 r=refresh(p);if not r or not r.token then return false,"Unavailable" end
 local token=r.token
 rt.ResetCooldown(token)
 rt.CreditChakra(token,math.max(0,900+100*snap.context.level-(rt.Chakra(token) or 0)))
 return rt.Enter(token)
end
function S.Update()
 if runtime then for _,p in Players:GetPlayers() do refresh(p) end; Kurama.Update(workspace:GetServerTimeNow()) end
end
function S.Remove(p: Player)
 assert(runtime)
 local key=tostring(p.UserId); local r=records[key]
 if r and r.token then runtime.Remove(r.token); models[r.token]=nil end
 Kurama.Remove(p); records[key]=nil
end
function S.Reset()
 Kurama.Reset()
 if runtime then runtime.Reset() end
 for _,r in records do r.token=nil; r.dash=Gameplay.newDash(); r.hagoromo=Gameplay.newHagoromo(); r.epoch=round(); r.lastRequest=0; r.sageEntryBlocked=false end
 table.clear(models); table.clear(visuals)
end
return S
]]></string>
          </Properties>
