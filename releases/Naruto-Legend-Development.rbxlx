          <Item class="ModuleScript" referent="283">
            <Properties>
              <string name="Name">GamakichiVisualController</string>
              <string name="Source"><![CDATA[--!strict
local Run=game:GetService("RunService")
local Shared=game.ReplicatedStorage.Shared
local Clips:{[string]:{duration:number,frames:{{[string]:CFrame}}}}=require(Shared.GamakichiClips) :: any
local Reaction=require(Shared.Combat.HitReaction)
local M={};local started=false
local cached: {[Model]:{skin:MeshPart,bones:{Bone}}}=setmetatable({},{__mode="k"}) :: any
function M.Start()
 if started then return end;started=true
 Run.RenderStepped:Connect(function(dt)
  local folder=workspace:FindFirstChild("HeroSummons");if not folder then return end
  local now=workspace:GetServerTimeNow()
  for _,model in folder:GetChildren() do
   if not model:IsA("Model") or model:GetAttribute("NativeGamakichi")~=true then continue end
   local root=model:FindFirstChild("HumanoidRootPart")
   if not root or not root:IsA("BasePart") then continue end
   local rec=cached[model]
   if not rec then
    local skin=model:FindFirstChild("GamakichiSkin")
    if not skin or not skin:IsA("MeshPart") then continue end
    local bones:{Bone}={}
    for _,b in skin:GetDescendants() do if b:IsA("Bone") then table.insert(bones,b) end end
    rec={skin=skin,bones=bones};cached[model]=rec
   end
   local swing=now-((model:GetAttribute("SummonSwingAt") or -100) :: number)
   local cast=now-((model:GetAttribute("SummonSpellAt") or -100) :: number)
   local channel=model:GetAttribute("Channeling")==true
   local moving=model:GetAttribute("SummonMoving")==true
   local clip=if moving then Clips.Walk else Clips.Idle
   local age=now%clip.duration
   if model:GetAttribute("SummonSpell")=="GamakichiOil" and cast>=0 and cast<Clips.Oil.duration then clip=Clips.Oil;age=cast
   elseif channel then clip=Clips.Attack;age=cast%clip.duration
   elseif swing>=0 and swing<Clips.Attack.duration then clip=Clips.Attack;age=swing end
   local frame=math.clamp(age/clip.duration*(#clip.frames-1),0,#clip.frames-1)
   local a=math.floor(frame)+1;local b=math.min(a+1,#clip.frames)
   local scale=(model:GetAttribute("ToadScale") or 1) :: number
   for _,bone in rec.bones do
    local one=clip.frames[a][bone.Name];local two=clip.frames[b][bone.Name]
    if one and two then
     local goal=one:Lerp(two,frame%1)
     goal=CFrame.new(goal.Position*scale)*goal.Rotation
     bone.Transform=bone.Transform:Lerp(goal,1-math.exp(-35*dt))
    end
   end
   rec.skin.CFrame=root.CFrame*Reaction.Offset(model,"Root",now)*(rec.skin:GetAttribute("ToadOffset") :: CFrame)
  end
 end)
end
return M
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="284">
            <Properties>
              <string name="Name">HUDIcons</string>
              <string name="Source"><![CDATA[--!strict
-- Original code-drawn Naruto symbols. No uploaded images or Valve assets.
local Icons = {}
local palettes: {[string]: Color3} = {
	Rasengan=Color3.fromRGB(32,133,190), Odama=Color3.fromRGB(23,92,178), Rasenshuriken=Color3.fromRGB(36,115,126), ShadowClones=Color3.fromRGB(183,104,39),
	Gamakichi=Color3.fromRGB(148,66,50), SageMode=Color3.fromRGB(186,96,42),
	KCM=Color3.fromRGB(198,151,34), CloneCommand=Color3.fromRGB(86,129,148),
	GamakichiOil=Color3.fromRGB(87,127,52), GamakichiChop=Color3.fromRGB(126,83,62),
	IronBlade=Color3.fromRGB(82,119,137), GuardianArmor=Color3.fromRGB(107,101,137),
	SwiftBoots=Color3.fromRGB(117,85,51), HealingPotion=Color3.fromRGB(91,144,82),
}
function Icons.draw(parent: GuiObject, id: string): Frame
	local canvas=Instance.new("Frame"); canvas.Name="Icon"; canvas.Size=UDim2.fromScale(1,1)
	canvas.BackgroundColor3=palettes[id] or Color3.fromRGB(65,87,105); canvas.BorderSizePixel=0; canvas.Parent=parent
	local gradient=Instance.new("UIGradient"); gradient.Rotation=65
	gradient.Color=ColorSequence.new(Color3.new(1,1,1),Color3.fromRGB(55,60,78)); gradient.Parent=canvas
	local function shape(name: string,x: number,y: number,w: number,h: number,round: boolean,rotation: number?): Frame
		local f=Instance.new("Frame"); f.Name=name; f.AnchorPoint=Vector2.new(.5,.5); f.Position=UDim2.fromScale(x,y); f.Size=UDim2.fromScale(w,h)
		f.BackgroundColor3=Color3.fromRGB(224,237,226); f.BorderSizePixel=0; f.Rotation=rotation or 0; f.Parent=canvas
		if round then local c=Instance.new("UICorner"); c.CornerRadius=UDim.new(1,0); c.Parent=f end
		return f
	end
	local sasuke=require(game.ReplicatedStorage.Shared.Abilities.SasukeDefinitions).Spells[id]
 if sasuke then
  canvas.BackgroundColor3=if sasuke.line=="SasukeFire" then Color3.fromRGB(177,66,31) elseif sasuke.line=="SasukeLightning" then Color3.fromRGB(51,105,169) else Color3.fromRGB(105,46,148)
  if sasuke.line=="SasukeLightning" then
   shape("Bolt",.48,.35,.16,.5,false,32);shape("Bolt",.58,.65,.14,.43,false,32);shape("Cross",.5,.5,.45,.13,false)
  elseif sasuke.line=="SasukeFire" then
   shape("Flame",.5,.55,.48,.62,true,-15);shape("Tongue",.5,.25,.22,.4,false,28);shape("Core",.5,.65,.22,.3,true).BackgroundColor3=Color3.fromRGB(255,190,45)
  elseif sasuke.line=="SasukeSummon" then
   for i=1,6 do shape("Snake",.5+math.sin(i)*.18,.18+i*.1,.23,.22,true) end
  else
   shape("Eye",.5,.5,.8,.42,true);shape("Iris",.5,.5,.38,.38,true).BackgroundColor3=Color3.fromRGB(173,35,79);shape("Pupil",.5,.5,.13,.13,true).BackgroundColor3=Color3.fromRGB(15,10,24)
   for i=1,3 do local a=i*math.pi*2/3;shape("Tomoe",.5+math.cos(a)*.13,.5+math.sin(a)*.13,.07,.07,true).BackgroundColor3=Color3.fromRGB(15,10,24) end
  end
 elseif id=="Rasengan" then
		for i=1,4 do
			local r=shape("ChakraRing",.5,.5,.18+i*.14,.18+i*.14,true); r.BackgroundTransparency=1
			local stroke=Instance.new("UIStroke"); stroke.Color=Color3.fromRGB(159,232,255); stroke.Thickness=2; stroke.Parent=r
		end
		shape("Core",.5,.5,.22,.22,true); shape("Flow",.5,.5,.78,.045,false,-35)
	elseif id=="Odama" then
        local outer=shape("LargeAura",.5,.5,.91,.91,true); outer.BackgroundColor3=Color3.fromRGB(83,198,255); outer.BackgroundTransparency=.35
        shape("LargeCore",.5,.5,.72,.72,true).BackgroundColor3=Color3.fromRGB(224,252,255)
        for i=1,3 do
            local r=shape("CompressedFlow",.5,.5,.25+i*.16,.25+i*.16,true);r.BackgroundTransparency=1
            local stroke=Instance.new("UIStroke");stroke.Color=Color3.fromRGB(79,166,237);stroke.Thickness=2;stroke.Parent=r
        end
    elseif id=="Rasenshuriken" or id=="RasenshurikenThrow" or id=="RikudoHY" or id=="RikudoHZ" then
        for i=0,3 do
            local a=math.pi*i/2
            local blade=shape("WindBlade",.5+math.cos(a)*.24,.5+math.sin(a)*.24,.15,.48,false,45+i*90)
            blade.BackgroundColor3=Color3.fromRGB(210,255,255)
        end
        shape("WindCore",.5,.5,.45,.45,true).BackgroundColor3=Color3.fromRGB(115,228,255)
        local core=shape("Core",.5,.5,.29,.29,true);core.BackgroundColor3=Color3.fromRGB(245,255,255)
    elseif id=="KcmDash" then
        canvas.BackgroundColor3=Color3.fromRGB(173,122,31)
        shape("Dash",.55,.45,.16,.65,false,30);shape("DashTip",.55,.68,.20,.37,false,-34)
        for i=1,3 do shape("Speed",.22,.22+i*.18,.32,.04,false,-12) end
    elseif id=="ShadowSleep" then
        canvas.BackgroundColor3=Color3.fromRGB(105,72,145)
        for _,x in {.28,.72} do shape("ClosedEye",x,.58,.29,.06,false) end
        shape("Sleep",.55,.22,.28,.05,false);shape("Sleep",.55,.31,.28,.05,false,-38);shape("Sleep",.55,.40,.28,.05,false)
    elseif id=="MeditationToggle" or id=="MeditationRecall" then
        canvas.BackgroundColor3=Color3.fromRGB(65,132,117)
        shape("Head",.5,.25,.22,.25,true);shape("Body",.5,.55,.28,.36,true)
        shape("Leg",.32,.79,.48,.13,true,-18);shape("Leg",.68,.79,.48,.13,true,18)
        if id=="MeditationRecall" then shape("Return",.82,.30,.09,.35,false,35) end
    elseif id=="ShadowClones" or id=="CloneCommand" then
		for i=1,3 do local x=.19+(i-1)*.30; shape("Head",x,.37,.18,.22,true); shape("Body",x,.66,.23,.30,true) end
		if id=="CloneCommand" then shape("Command",.5,.20,.74,.035,false) end
	elseif id=="Gamakichi" or id=="GamakichiOil" then
		shape("Frog",.5,.57,.74,.49,true); shape("Eye",.27,.31,.22,.25,true); shape("Eye",.73,.31,.22,.25,true)
		shape("Mouth",.5,.63,.44,.045,false).BackgroundColor3=palettes[id]
		if id=="GamakichiOil" then shape("Oil",.5,.81,.17,.24,true) end
	elseif id=="SageMode" then
		for _,x in {.28,.72} do
			shape("EyeMark",x,.49,.32,.28,true).BackgroundColor3=Color3.fromRGB(78,36,28)
			shape("Eye",x,.49,.24,.12,true); shape("Pupil",x,.49,.15,.035,false).BackgroundColor3=Color3.fromRGB(33,30,25)
		end
	elseif id=="KuramaForm" then
        canvas.BackgroundColor3=Color3.fromRGB(210,145,34)
        for i=1,9 do local a=(i-5)*.26;shape("Tail",.5+math.sin(a)*.32,.37+math.abs(a)*.08,.065,.50,true,(i-5)*17) end
        shape("Fox",.5,.68,.42,.34,true).BackgroundColor3=Color3.fromRGB(255,220,102)
        shape("Ear",.33,.5,.13,.28,false,-22);shape("Ear",.67,.5,.13,.28,false,22)
        for _,x in {.4,.6} do shape("Eye",x,.65,.10,.04,false).BackgroundColor3=Color3.fromRGB(75,33,18) end
	elseif id=="KCM" or id=="KcmCancel" or id=="KuramaConvert" then
		for i=1,5 do shape("Flame",.18+(i-1)*.16,.43,.13,.52,true,(i-3)*18) end
		shape("Seal",.5,.73,.40,.27,true).BackgroundColor3=Color3.fromRGB(77,49,22)
	elseif id=="GuardianArmor" then
		shape("Plate",.5,.46,.54,.58,true); shape("Shoulder",.20,.29,.25,.22,true); shape("Shoulder",.80,.29,.25,.22,true)
	elseif id=="SwiftBoots" then
		shape("Boot",.45,.37,.29,.50,false,-12); shape("Sole",.57,.65,.56,.22,true)
	elseif id=="HealingPotion" then
		shape("Bottle",.5,.50,.46,.57,true); shape("Cork",.5,.18,.26,.15,false)
	else
		shape("Blade",.54,.44,.14,.76,false,38); shape("Guard",.36,.67,.44,.09,false,38); shape("Grip",.24,.83,.10,.27,false,38)
	end
	return canvas
end
return Icons
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="285">
            <Properties>
              <string name="Name">HUDLayout</string>
              <string name="Source"><![CDATA[--!strict
-- Reference space: 1920x1080. Scale with height; never stretch on ultrawide.
local Layout = { ConsoleWidth = 900, ConsoleHeight = 164, TopWidth = 920, TopHeight = 48, DeckHeight=126 }
function Layout.skill(index: number): (number, number, number)
	if index<=6 then return 240+(index-1)*66,38,60 end
	return 638+(index-7)*30,54,26
end
function Layout.item(index: number): (number,number)
	return 704+((index-1)%3)*62,24+math.floor((index-1)/3)*52
end
function Layout.scale(width: number, height: number): number
	return math.min(height / 1080, (width - 32) / Layout.ConsoleWidth, (width - 240) / Layout.TopWidth)
end
return table.freeze(Layout)
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="286">
            <Properties>
              <string name="Name">HeroAppearanceTransition</string>
              <string name="Source"><![CDATA[--!strict
-- Presentation only: keep a loaded costume while its successor is replicated/preloaded.
local Content=game:GetService("ContentProvider")
local Run=game:GetService("RunService")
local Shared=game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Controller={}
type State={model:Model,source:Folder?,shown:Folder?,generation:number,connection:RBXScriptConnection?}
local states:{[Model]:State}={}
local started=false
local function hide(folder:Instance)
 for _,part in folder:GetDescendants() do if part:IsA("BasePart") then part.Transparency=1 end end
end
local function alpha(folder:Folder,value:number)
 for _,part in folder:GetChildren() do
  if part:IsA("BasePart") then
   local original=part:GetAttribute("TransitionTransparency")
   part.Transparency=(if typeof(original)=="number" then original else 0)+(1-(if typeof(original)=="number" then original else 0))*value
  end
 end
end
local function visualCopy(source:Folder,model:Model):Folder
 local copy=Instance.new("Folder");copy.Name="DisplayedHeroAppearance"
 copy:SetAttribute("AppearanceVersion",source:GetAttribute("AppearanceVersion"))
 copy:SetAttribute("AppearanceForm",source:GetAttribute("AppearanceForm"))
 for _,original in source:GetChildren() do
  if not original:IsA("BasePart") then continue end
  local bodyName=original:GetAttribute("CosmeticBody");local offset=original:GetAttribute("CosmeticOffset")
  local body=if typeof(bodyName)=="string" then model:FindFirstChild(bodyName) else nil
  if not body or not body:IsA("BasePart") or typeof(offset)~="CFrame" then continue end
  local part=original:Clone()
  for _,child in part:GetDescendants() do
   if not child:IsA("DataModelMesh") and not child:IsA("Decal") and not child:IsA("SurfaceAppearance") then child:Destroy() end
  end
  local target=original:GetAttribute("AppearanceTransparency")
  part.Transparency=if typeof(target)=="number" then target else 0
  part:SetAttribute("TransitionTransparency",part.Transparency)
  part.CanCollide=false;part.CanTouch=false;part.CanQuery=false;part.Massless=true;part.Anchored=false
  part.LocalTransparencyModifier=0;part.CFrame=body.CFrame*offset;part.Parent=copy
  local weld=Instance.new("Weld");weld.Name="FormVisualWeld";weld.Part0=body;weld.Part1=part;weld.C0=offset;weld.Parent=part
 end
 return copy
end
local function stage(state:State,folder:Folder)
 if state.source==folder then return end
 state.source=folder;state.generation+=1
 local generation=state.generation
 hide(folder)
 task.spawn(function()
  local function current():boolean return state.model.Parent~=nil and state.generation==generation and folder.Parent==state.model end
  -- Attribute/descendant replication is not atomic, even when the server builds off-tree.
  while current() do
   local expected=folder:GetAttribute("AppearanceParts")
   local descendants=folder:GetAttribute("AppearanceDescendants")
   if typeof(expected)=="number" and #folder:GetChildren()>=expected and typeof(descendants)=="number" and #folder:GetDescendants()>=descendants then break end
   Run.Heartbeat:Wait()
  end
  if not current() then return end
  local copy=visualCopy(folder,state.model)
  if not state.shown then
   -- First spawn has no previous costume; show it while warming its textures.
   copy.Parent=state.model;state.shown=copy
   pcall(function() Content:PreloadAsync({copy}) end)
   return
  end
  local fetched=true
  local ready=true
  if folder:GetAttribute("AppearanceForm")=="Sasuke" then
   -- Sasuke has a procedural face. A slow optional mesh must not hold an entire
   -- mode transition (or mode exit) behind an obsolete costume for many seconds.
   task.spawn(function() pcall(function() Content:PreloadAsync({copy}) end) end)
  else
   ready=pcall(function() Content:PreloadAsync({copy},function(_id,status)
    if status~=Enum.AssetFetchStatus.Success then fetched=false end
   end) end)
  end
  if not current() or not ready or not fetched then copy:Destroy();return end
  local previous=state.shown
  alpha(copy,1);copy.Parent=state.model
  local at=os.clock()
  while current() do
   local t=math.clamp((os.clock()-at)/.55,0,1)
   -- Keep the old face fully opaque until the new face is opaque.
   local incoming=math.clamp(t/.6,0,1);incoming=incoming*incoming*(3-2*incoming)
   local outgoing=math.clamp((t-.6)/.4,0,1);outgoing=outgoing*outgoing*(3-2*outgoing)
   alpha(copy,1-incoming);if previous then alpha(previous,outgoing) end
   if t>=1 then break end
   Run.RenderStepped:Wait()
  end
  if not current() then copy:Destroy();if previous and previous.Parent then alpha(previous,0) end;return end
  if previous then previous:Destroy() end
  state.shown=copy;alpha(copy,0)
 end)
end
local function bind(model:Model)
 if states[model] then return end
 local state:State={model=model,source=nil,shown=nil,generation=0,connection=nil};states[model]=state
 state.connection=model.DescendantAdded:Connect(function(item)
  local parent=item.Parent
  if parent and (parent.Name=="HeroAppearance" or parent.Name=="PreviousHeroAppearance") and item:IsA("BasePart") then item.Transparency=1 end
  if item:IsA("Folder") and item.Parent==model and item.Name=="HeroAppearance" then stage(state,item) end
 end)
 for _,child in model:GetChildren() do
  if child.Name=="PreviousHeroAppearance" then hide(child) end
  if child:IsA("Folder") and child.Name=="HeroAppearance" then stage(state,child) end
 end
 model.Destroying:Once(function()
  state.generation+=1;if state.connection then state.connection:Disconnect() end
  if state.shown then state.shown:Destroy() end;states[model]=nil
 end)
end
function Controller.Start()
 if started then return end;started=true
 task.spawn(function()
  local cache=Instance.new("Folder");local factory=require(Shared.CreatorVisualFactory)
  local data=require(Shared.Config.SasukeVisualData)
  for _,specs in {data.appearance,data.susanoo,data.garuda} do for _,spec in specs do factory.Part(spec :: any).Parent=cache end end
  pcall(function() Content:PreloadAsync({cache}) end);cache:Destroy()
 end)
 -- Warm every form's mesh/face IDs before the first transformation when possible.
 task.spawn(function()
  local cache=Instance.new("Folder")
  local factory=require(Shared.CreatorVisualFactory)
  local data=require(Shared.Config.CreatorVisualData)
  local forms=require(Shared.Config.NarutoFormVisualData)
  -- Typed Instances ensure mesh IDs are fetched as meshes, not as generic images.
  local function add(specs:any) for _,s in specs do factory.Part(s).Parent=cache end end
  add(data.appearance);for _,specs in forms do add(specs) end
  for _,id in {"rbxassetid://9477576334","rbxassetid://9449064416"} do
   local part=Instance.new("Part");part.Parent=cache;local decal=Instance.new("Decal");decal.Texture=id;decal.Parent=part
  end
  pcall(function() Content:PreloadAsync({cache}) end);cache:Destroy()
 end)
 workspace.DescendantAdded:Connect(function(item)
  if item:IsA("Folder") and item.Name=="HeroAppearance" and item.Parent and item.Parent:IsA("Model") then bind(item.Parent) end
 end)
 for _,item in workspace:GetDescendants() do
  if item:IsA("Folder") and item.Name=="HeroAppearance" and item.Parent and item.Parent:IsA("Model") then bind(item.Parent) end
 end
end
return Controller
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="287">
            <Properties>
              <string name="Name">HeroHUDController</string>
              <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInput = game:GetService("UserInputService")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Items = require(Shared.Config.ItemConfig)
local Rounds = require(script.Parent.RoundController)
local HUD = {}
local started = false
local colors = { Background = Color3.fromRGB(17, 24, 35), Card = Color3.fromRGB(29, 40, 55),
 Text = Color3.fromRGB(235, 242, 255), Muted = Color3.fromRGB(164, 182, 202), Gold = Color3.fromRGB(255, 207, 94),
 Green = Color3.fromRGB(83, 211, 151), Blue = Color3.fromRGB(90, 160, 255) }
local messages: { [string]: string } = {
 Purchased = "Предмет куплен", NotEnoughGold = "Недостаточно золота", FullHealth = "Здоровье уже полное",
 TooFar = "Вернитесь к магазину своей базы", Dead = "Магазин доступен живому герою",
 Unavailable = "Магазин сейчас недоступен", RateLimited = "Слишком много запросов. Попробуйте ещё раз",
 Replay = "Запрос уже обработан", Busy = "Покупка уже выполняется", UnknownItem = "Неизвестный предмет", Malformed = "Некорректный запрос",
}
function HUD.Start()
 if started then return end; started = true
 task.spawn(function()
  local player = Players.LocalPlayer
  local state = player:WaitForChild("HeroState", 30)
  local match = ReplicatedStorage:WaitForChild("SurvivalState", 30)
  local remote = ReplicatedStorage:WaitForChild("ItemShop", 30)
  local notice = ReplicatedStorage:WaitForChild("HeroNotice", 30)
  if not state or not match or not remote or not remote:IsA("RemoteEvent") or not notice or not notice:IsA("RemoteEvent") then return end
  local gui = Instance.new("ScreenGui"); gui.Name = "HeroHUD"; gui.ResetOnSpawn = false; gui.DisplayOrder = 10
  gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling; gui.Parent = player:WaitForChild("PlayerGui")
  local function round(parent: GuiObject, radius: number)
   local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, radius); c.Parent = parent
  end
  local function frame(parent: Instance, name: string, size: UDim2, position: UDim2): Frame
   local f = Instance.new("Frame"); f.Name = name; f.Size = size; f.Position = position; f.BorderSizePixel = 0
   f.BackgroundColor3 = colors.Background; f.Parent = parent; return f
  end
  local function label(parent: Instance, name: string, text: string, size: UDim2, position: UDim2, fontSize: number): TextLabel
   local l = Instance.new("TextLabel"); l.Name = name; l.Text = text; l.Size = size; l.Position = position
   l.BackgroundTransparency = 1; l.TextColor3 = colors.Text; l.Font = Enum.Font.GothamMedium; l.TextSize = fontSize
   l.TextXAlignment = Enum.TextXAlignment.Left; l.Parent = parent; return l
  end
  local function button(parent: Instance, name: string, text: string, size: UDim2, position: UDim2): TextButton
   local b = Instance.new("TextButton"); b.Name = name; b.Text = text; b.Size = size; b.Position = position
   b.BackgroundColor3 = colors.Gold; b.TextColor3 = colors.Background; b.TextSize = 14; b.Font = Enum.Font.GothamBold
   b.BorderSizePixel = 0; b.Parent = parent; round(b, 6); return b
  end
  local toast = label(gui, "RewardNotice", "", UDim2.fromOffset(360, 50), UDim2.new(0.5, 0, 1, -235), 18)
  toast.AnchorPoint = Vector2.new(0.5, 1); toast.TextXAlignment = Enum.TextXAlignment.Center
  toast.TextColor3 = colors.Gold; toast.TextStrokeTransparency = 0.4; toast.TextWrapped = true
  local shade = frame(gui, "Shop", UDim2.fromScale(1, 1), UDim2.new()); shade.Visible = false
  shade.BackgroundColor3 = Color3.new(); shade.BackgroundTransparency = 0.4; shade.Active = true
  local panel = frame(shade, "Window", UDim2.fromScale(0.92, 0.88), UDim2.fromScale(0.5, 0.5))
  panel.AnchorPoint = Vector2.new(0.5, 0.5); round(panel, 12)
  local constraint = Instance.new("UISizeConstraint"); constraint.MaxSize = Vector2.new(580, 450); constraint.MinSize = Vector2.new(270, 180); constraint.Parent = panel
  label(panel, "Title", "МАГАЗИН БАЗЫ", UDim2.new(1, -75, 0, 30), UDim2.fromOffset(16, 8), 20)
  local shopGold = label(panel, "Balance", "", UDim2.new(1, -32, 0, 22), UDim2.fromOffset(16, 38), 14); shopGold.TextColor3 = colors.Gold
  local close = button(panel, "Close", "×", UDim2.fromOffset(40, 40), UDim2.new(1, -50, 0, 10))
  local list = Instance.new("ScrollingFrame"); list.Name = "Items"; list.Position = UDim2.fromOffset(12, 68)
  list.Size = UDim2.new(1, -24, 1, -110); list.BackgroundTransparency = 1; list.BorderSizePixel = 0
  list.CanvasSize = UDim2.new(); list.AutomaticCanvasSize = Enum.AutomaticSize.Y; list.ScrollBarThickness = 4; list.Parent = panel
  local layout = Instance.new("UIListLayout"); layout.Padding = UDim.new(0, 8); layout.SortOrder = Enum.SortOrder.LayoutOrder; layout.Parent = list
  local status = label(panel, "Status", "Подойдите к магазину своей команды", UDim2.new(1, -32, 0, 34), UDim2.new(0, 16, 1, -38), 12)
  status.TextWrapped = true
  local buys: { [string]: TextButton } = {}
  local pending: number? = nil
  local serial = 0
  local function setOpen(open: boolean)
   shade.Visible = open; player:SetAttribute("ShopOpen", open)
  end
  close.Activated:Connect(function() setOpen(false) end)
  UserInput.InputBegan:Connect(function(input, processed)
   if not processed and input.KeyCode == Enum.KeyCode.Escape then setOpen(false) end
  end)
  local function number(name: string): number return (state:GetAttribute(name) or 0) :: number end
  local function refresh()
   local maximum = math.max(1, number("MaxHealth")); local health = number("CurrentHealth")
   local balance = number("Gold")
   shopGold.Text = math.floor(balance) .. " GOLD  •  экипировка сохраняется после смерти"
   for id, buy in buys do
    local item = Items.Items[id]; local owned = state:GetAttribute("Own_" .. id) == true
    local insufficient = balance < item.Cost; local full = item.Heal ~= nil and health >= maximum
    buy.Text = if owned then "Куплено" elseif pending then "…" elseif insufficient then "Нет Gold" elseif full then "HP полное" else "Купить"
    buy.Active = not owned and not insufficient and not full and pending == nil
    buy.AutoButtonColor = buy.Active; buy.BackgroundColor3 = if buy.Active then colors.Gold else colors.Card
    buy.TextColor3 = if buy.Active then colors.Background else colors.Muted
   end
   if health <= 0 or match:GetAttribute("Phase") ~= "InProgress" or player:GetAttribute("Eliminated") == true then setOpen(false) end
  end
  for index, id in Items.Order do
   local item = Items.Items[id]
   local card = frame(list, id, UDim2.new(1, -8, 0, 76), UDim2.new()); card.LayoutOrder = index; card.BackgroundColor3 = colors.Card; round(card, 8)
   local name = label(card, "Name", item.Name, UDim2.new(1, -105, 0, 22), UDim2.fromOffset(12, 6), 15); name.TextTruncate = Enum.TextTruncate.AtEnd
   local desc = label(card, "Description", item.Description, UDim2.new(1, -110, 0, 39), UDim2.fromOffset(12, 28), 12); desc.TextWrapped = true; desc.TextColor3 = colors.Muted
   local cost = label(card, "Cost", item.Cost .. " GOLD", UDim2.fromOffset(82, 20), UDim2.new(1, -94, 0, 4), 13); cost.TextColor3 = colors.Gold; cost.TextXAlignment = Enum.TextXAlignment.Center
   local buy = button(card, "Buy", "Купить", UDim2.fromOffset(82, 40), UDim2.new(1, -94, 0, 27)); buys[id] = buy
   buy.Activated:Connect(function()
    if pending or not buy.Active then return end
    serial += 1; local request = serial; pending = request; status.Text = "Покупка…"; refresh()
    remote:FireServer(request, id, Rounds.Current())
    task.delay(4, function()
     if pending == request then pending = nil; status.Text = "Ответ не получен. Проверьте баланс и попробуйте ещё раз"; refresh() end
    end)
   end)
  end
  remote.OnClientEvent:Connect(function(kind: string, request: number?, success: boolean?, reason: string?, roundId: number?)
   if not Rounds.Accepts(roundId) then return end
   if kind == "Open" then refresh(); setOpen(true); status.Text = "Предметы приобретаются за золото матча"
   elseif kind == "Result" and request == pending then
    pending = nil; refresh()
    status.Text = messages[reason or "Unavailable"] or "Покупка недоступна"
    status.TextColor3 = if success then colors.Green else colors.Gold
   end
  end)
  local xpGain, goldGain, levelGain, noticeVersion = 0, 0, 0, 0
  Rounds.Watch(function()
   pending = nil; setOpen(false); status.Text = "Матч"; toast.Text = ""
   xpGain = 0; goldGain = 0; levelGain = 0; noticeVersion += 1; refresh()
  end)
  notice.OnClientEvent:Connect(function(xpAmount: number, goldAmount: number, levels: number, roundId: number?)
   if not Rounds.Accepts(roundId) then return end
   xpGain += xpAmount; goldGain += goldAmount; levelGain += levels; noticeVersion += 1
   local version = noticeVersion
   toast.Text = (if levelGain > 0 then "LEVEL UP!  +" .. levelGain .. "\n" else "")
    .. (if xpGain > 0 then "+" .. xpGain .. " XP  " else "") .. (if goldGain > 0 then "+" .. goldGain .. " GOLD" else "")
   task.delay(3, function()
    if version == noticeVersion then toast.Text = ""; xpGain = 0; goldGain = 0; levelGain = 0 end
   end)
  end)
  state.AttributeChanged:Connect(refresh); match:GetAttributeChangedSignal("Phase"):Connect(refresh)
  player:GetAttributeChangedSignal("Eliminated"):Connect(refresh)
  local cameraConnection: RBXScriptConnection? = nil
  local function resize()
   local camera = workspace.CurrentCamera; if not camera then return end
   local viewport = camera.ViewportSize
   toast.Size = UDim2.fromOffset(math.min(360, viewport.X - 24), 50)
   toast.TextSize = if viewport.Y < 500 then 14 else 18
   toast.Position = if viewport.Y > viewport.X then UDim2.new(0.5, 0, 0, 325)
    elseif viewport.Y < 500 then UDim2.new(0.5, 0, 0, if viewport.Y < 350 then 120 else 145)
    else UDim2.new(0.5, 0, 1, -235)
  end
  local function cameraChanged()
   if cameraConnection then cameraConnection:Disconnect() end
   local camera = workspace.CurrentCamera
   if camera then cameraConnection = camera:GetPropertyChangedSignal("ViewportSize"):Connect(resize) end
   resize()
  end
  workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(cameraChanged)
  cameraChanged(); refresh()
 end)
end
return HUD
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="288">
            <Properties>
              <string name="Name">HeroMotionController</string>
              <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Poses = require(Shared.Combat.HeroPoses)
local Config = require(Shared.Config.AbilityConfig)
local Combat = require(Shared.Config.CombatConfig)
local Ids = require(Shared.Config.AnimationIds)
local RigJoints = require(Shared.Combat.RigJoints)
local Reaction = require(Shared.Combat.HitReaction)
type Prediction = { id: number, key: string, at: number, duration: number }
type Rig = { model: Model, humanoid: Humanoid, root: BasePart, joints: { RigJoints.Entry }, poses: { [Instance]: CFrame },
	tracks: { [string]: AnimationTrack }, animations: { Animation }, animate: LocalScript?, animateEnabled: boolean,
	key: string, track: AnimationTrack?, owned: boolean }
local Motion = {}
local rigs: { [Model]: Rig } = {}
local prediction: Prediction? = nil
local started = false
local nextScan = 0
function Motion.Predict(id: number, key: string, at: number, duration: number)
	prediction = { id = id, key = key, at = at, duration = duration }
end
function Motion.StopPrediction(id: number?) if not id or (prediction and prediction.id == id) then prediction = nil end end
local function remove(model: Model)
	local rig = rigs[model]; if not rig then return end
	for _, entry in rig.joints do if entry.joint.Parent then entry.joint.Transform = CFrame.identity end end
	for _, track in rig.tracks do track:Stop(0); track:Destroy() end
	for _, animation in rig.animations do animation:Destroy() end
	if rig.animate and rig.animate.Parent then rig.animate.Enabled = rig.animateEnabled end
	rigs[model] = nil
end
local function bind(model: Model)
	if rigs[model] then rigs[model].joints = RigJoints.Collect(model); return end
	local humanoid = model:FindFirstChildOfClass("Humanoid"); local root = model:FindFirstChild("HumanoidRootPart")
	if not humanoid or humanoid.Health <= 0 or humanoid.RigType ~= Enum.HumanoidRigType.R15 or not root or not root:IsA("BasePart") then return end
	local joints = RigJoints.Collect(model)
	if #joints == 0 then return end -- Refresh as streamed limbs arrive; do not require 15 legacy motors.
	local localOwner = model == Players.LocalPlayer.Character
	local animate = model:FindFirstChild("Animate")
	local scriptAnimate = if localOwner and animate and animate:IsA("LocalScript") then animate else nil
	local rig: Rig = { model = model, humanoid = humanoid, root = root, joints = joints, poses = {}, tracks = {}, animations = {},
		animate = scriptAnimate, animateEnabled = if scriptAnimate then scriptAnimate.Enabled else false,
		key = "", track = nil, owned = localOwner }
	if scriptAnimate and model:GetAttribute("HeroId") then
		scriptAnimate.Enabled = false
		local animator = humanoid:FindFirstChildOfClass("Animator")
		if animator then for _, track in animator:GetPlayingAnimationTracks() do if track.Priority == Enum.AnimationPriority.Core then track:Stop(0.1) end end end
	end
	rigs[model] = rig
end
local function active(rig: Rig, now: number): (string, number, number)
	local model = rig.model
	local throwAt=model:GetAttribute("RasenshurikenThrowAt")
 if typeof(throwAt)=="number" and now>=throwAt and now<throwAt+.8 then return "RasenshurikenThrow",throwAt,.8 end
	local variant = model:GetAttribute("RasenganVariant")
	local technique = if variant == "Odama" or variant == "Rasenshuriken" then variant else "Rasengan"
	local function attackKey(key: string): string
		return if model:GetAttribute("RasenganHeld") == true and (string.match(key,"^Punch%d$") or key == "HeavyPunch") then technique.."Strike" else key
	end
	if model:GetAttribute("NativeMeditationClone")==true then return "Meditation",now,1 end
	local sageReady=model:GetAttribute("SageReadyAt")
 if model:GetAttribute("SagePhase")=="Preparing" and typeof(sageReady)=="number" and now<sageReady then return "SagePrepare",now,1 end
 local rangedUntil=model:GetAttribute("RangedPreparingUntil");local rangedAt=model:GetAttribute("RangedCastStartedAt")
 if typeof(rangedUntil)=="number" and typeof(rangedAt)=="number" and now<rangedUntil then
  if now<rangedAt+1.3 then return "RasenganPrepare",rangedAt,1.3 else return "RasenganStrike",rangedAt+1.3,.2 end
 end
 local selfPause = model:GetAttribute("RasenganSelfPauseUntil")
	local ownPause = typeof(selfPause)=="number" and now<selfPause
	local phase = model:GetAttribute("RasenganPhase")
	local impact = model:GetAttribute("RasenganImpactAt")
	if phase=="Consumed" and ownPause and typeof(impact)=="number" and impact>now then
		local impactDelay = if technique == "Rasenshuriken" then .5 else 1
		return technique.."Strike",impact-impactDelay,impactDelay
	end
	local rasenganAt = model:GetAttribute("RasenganStartedAt"); local ready = model:GetAttribute("RasenganReadyAt")
	-- Begin gathering immediately, including the one-second selection window.
	-- Presentation alone never introduces a new movement or input lock.
	if phase=="Preparing" and typeof(rasenganAt)=="number" and typeof(ready)=="number" and now>=rasenganAt and now<ready then return technique.."Prepare",rasenganAt,ready-rasenganAt end
	if model:GetAttribute("RasenganHelper")==true then return "RasenganHelper",0,1 end
	if model:GetAttribute("CombatState") == "Stunned" then return "Stun", now, 1 end
 local chidoriAt=model:GetAttribute("ChidoriImpactAt")
 if typeof(chidoriAt)=="number" and now>=chidoriAt and now<chidoriAt+.52 then return "ChidoriImpact",chidoriAt,.52 end
	local ability = model:GetAttribute("AbilityId")
	if typeof(ability) == "string" and ability ~= "" then
		local at = model:GetAttribute("AbilityStartedAt"); local ends = model:GetAttribute("AbilityEndsAt")
		if typeof(at) == "number" and typeof(ends) == "number" and now < ends then return ability, at, ends - at end
	end
	local intent = if rig.owned then prediction else nil
	if intent and now < intent.at + intent.duration then return attackKey(intent.key), intent.at, intent.duration end
	local swingAt = model:GetAttribute("SummonSwingAt")
	if typeof(swingAt) == "number" and now < swingAt + 0.28 then return "Punch" .. tostring(model:GetAttribute("SummonSwingStep") or 1), swingAt, 0.28 end
	local ends, at = model:GetAttribute("CombatAttackEndsAt"), model:GetAttribute("CombatLastAttackAt")
	if typeof(ends) == "number" and typeof(at) == "number" and now < ends then
		return attackKey("Punch1"), at, ends - at
	end
	local velocity = rig.root.AssemblyLinearVelocity * Vector3.new(1, 0, 1)
 local castAt=model:GetAttribute("SasukeCastPoseAt");local castUntil=model:GetAttribute("SasukeCastPoseUntil")
 if typeof(castAt)=="number" and typeof(castUntil)=="number" and now<castUntil then return "SasukeCast:"..tostring(model:GetAttribute("SasukeCastPose")),castAt,castUntil-castAt end
	return if velocity.Magnitude > 1.5 or model:GetAttribute("SummonMoving") == true then "Run" else "Idle", 0, 1
end
local function hasPublished(rig: Rig, key: string, at: number, duration: number): boolean
	local animator = rig.humanoid:FindFirstChildOfClass("Animator"); if not animator then return false end
	local profile = Combat.Profiles[tostring(rig.model:GetAttribute("CombatProfileId"))] or Combat.Profiles.Default
	local set = Ids[profile.AnimationSet]; local id = if set then set[key] else nil
	if not id or id == "" or rig.model:GetAttribute("EntityKind") == "Summon" then return false end
	local m1 = key == "HeavyPunch" or string.match(key, "^Punch%d$") ~= nil
	-- M1 tracks belong to AnimationController, including local prediction. Observers only inspect replication.
	if rig.owned and not m1 and rig.model:GetAttribute("TrackReady_" .. key) == true then
		local track = rig.tracks[key]
		if not track then
			local animation = Instance.new("Animation"); animation.AnimationId = id; table.insert(rig.animations, animation)
			local ok, loaded = pcall(function() return animator:LoadAnimation(animation) end)
			if ok then track = loaded; rig.tracks[key] = loaded end
		end
		if track and track.Length > 0 then
			if rig.track ~= track or rig.key ~= key then
				if rig.track then rig.track:Stop(Combat.AnimationFadeTime) end
				track.Looped = key == "Idle" or key == "Run" or key == "Stun"
				track.Priority = if key == "Idle" then Enum.AnimationPriority.Idle elseif key == "Run" then Enum.AnimationPriority.Movement else Enum.AnimationPriority.Action
				track:Play(Combat.AnimationFadeTime)
				if not track.Looped then track.TimePosition = math.min(math.max(0, workspace:GetServerTimeNow() - at), duration) end
				rig.track = track
			end
		end
	end
	for _, track in animator:GetPlayingAnimationTracks() do
		if track.Animation and track.Animation.AnimationId == id and track.Length > 0 and track.IsPlaying then return true end
	end
	return false
end
function Motion.GetDiagnostics(model: Model): (string?, number)
	local rig = rigs[model]; if not rig then return nil, 0 end
	local moved = 0
	for _, entry in rig.joints do local x, y, z = entry.joint.Transform:ToOrientation(); if math.abs(x) + math.abs(y) + math.abs(z) > 0.05 then moved += 1 end end
	return rig.key, moved
end
function Motion.Start()
	if started then return end; started = true
	Players.LocalPlayer.CharacterRemoving:Connect(function(model) prediction = nil; remove(model) end)
	-- Animator evaluates after PreAnimation. Apply fallback joint transforms in PreSimulation.
	RunService.PreSimulation:Connect(function(dt)
		local now = workspace:GetServerTimeNow()
		if now >= nextScan then
			nextScan = now + 0.25
			for _, player in Players:GetPlayers() do if player.Character then bind(player.Character) end end
			local summons = workspace:FindFirstChild("HeroSummons")
			if summons then for _, model in summons:GetChildren() do if model:IsA("Model") then bind(model) end end end
			local visuals = workspace:FindFirstChild("LocalHeroVFX")
			if visuals then for _, model in visuals:GetChildren() do if model:IsA("Model") and model:GetAttribute("RasenganHelper")==true then bind(model) end end end
		end
		for model, rig in rigs do
			if not model:IsDescendantOf(workspace) or rig.humanoid.Health <= 0 then remove(model); continue end
			if rig.owned and model:GetAttribute("HeroId") then
				local animate = model:FindFirstChild("Animate")
				if animate and animate:IsA("LocalScript") then
					if not rig.animate then rig.animate = animate; rig.animateEnabled = animate.Enabled end
					animate.Enabled = false
				end
			end
			local camera = workspace.CurrentCamera
			if camera and (camera.CFrame.Position - rig.root.Position).Magnitude > Config.Visual.ViewDistance and not rig.owned then continue end
			local key, at, duration = active(rig, now)
			if rig.track and rig.key ~= key then rig.track:Stop(Combat.AnimationFadeTime); rig.track = nil end
			local holding = model:GetAttribute("RasenganVisible")==true and (key=="Idle" or key=="Run")
			local published = not holding and hasPublished(rig, key, at, duration)
			rig.key = key
			if published then
				for _,entry in rig.joints do entry.joint.Transform*=Reaction.Offset(model,entry.key,now) end
				table.clear(rig.poses); continue
			end
			if not model:GetAttribute("HeroId") and (key == "Idle" or key == "Run") then
				for _, entry in rig.joints do if entry.joint.Parent then entry.joint.Transform = Reaction.Offset(model,entry.key,now) end end
				table.clear(rig.poses); continue
			end
			local pose = Poses.sample(key, now, math.clamp((now - at) / math.max(0.001, duration), 0, 1))
			if model:GetAttribute("HeroId")=="Sasuke" then pose=require(Shared.Combat.SasukePoses).sample(model,key,now,math.clamp((now-at)/math.max(.001,duration),0,1),pose) end
			if holding then pose = Poses.holdRasengan(pose,now,tostring(model:GetAttribute("RasenganVariant"))) end
			if (key == "RasenganPrepare" or key == "OdamaPrepare" or key == "RasenshurikenPrepare")
				and rig.humanoid.WalkSpeed > 0 and (rig.root.AssemblyLinearVelocity*Vector3.new(1,0,1)).Magnitude > 1.5 then
				local run = Poses.sample("Run",now,0)
				for _, joint in {"LeftHip","RightHip","LeftKnee","RightKnee"} do pose[joint] = run[joint] end
			end
			local alpha = 1 - math.exp(-Config.Visual.BlendSpeed * dt)
			for _, entry in rig.joints do
				local motor = entry.joint
				if not motor.Parent then continue end
				local angle = pose[entry.key]
				local target = if angle then CFrame.Angles(angle[1], angle[2], angle[3]) else CFrame.identity
				local current = (rig.poses[motor] or CFrame.identity):Lerp(target, alpha)
				motor.Transform = current*Reaction.Offset(model,entry.key,now); rig.poses[motor] = current
			end
		end
	end)
end
return Motion
]]></string>
