            <string name="Name">AbilityInputRules</string>
            <string name="Source"><![CDATA[--!strict
-- One key resolves to one request. KCM cancel takes X only while that form is active.
local Rules = {}
function Rules.ownsArrow(key: string, textFocused: boolean, menuOpen: boolean, guiSelected: boolean, shopOpen: boolean): boolean
	return (key == "Right" or key == "Left") and not (textFocused or menuOpen or guiSelected or shopOpen)
end
function Rules.resolve(aliases: { read [string]: string }, key: string, kcmActive: boolean): string?
	if key == "X" and kcmActive then return "KcmCancel" end
	return aliases[key]
end
return Rules
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="4">
          <Properties>
            <string name="Name">ChakraKnifeInstancePolicy</string>
            <string name="Source"><![CDATA[--!strict
-- Roblox adaptation of the paired-region predicate. No WC3 coordinates or teleport.
export type Identity={id: string,eligible: boolean}
export type Attempt={caster: Identity?,readyAt: number,resolved: boolean}
local P={}
local function finite(n: number): boolean return n==n and math.abs(n)<math.huge end
local function snapshot(value: Identity?): Identity?
 if not value or value.id=="" or not value.eligible then return nil end
 return {id=value.id,eligible=true}
end
function P.begin(now: number,caster: Identity?): Attempt?
 if not finite(now) then return nil end
 return {caster=snapshot(caster),readyAt=now+.01,resolved=false}
end
function P.resolve(attempt: Attempt,now: number,targetAfterDelay: Identity?): (boolean,string)
 if not finite(now) then return false,"Clock" end
 if attempt.resolved then return false,"Replay" end
 if now<attempt.readyAt then return false,"Early" end
 attempt.resolved=true
 local caster=attempt.caster;local target=snapshot(targetAfterDelay)
 if not caster or not target then return false,"OutsideInstance" end
 return caster.id==target.id,if caster.id==target.id then "Accepted" else "CrossInstance"
end
return table.freeze(P)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="5">
          <Properties>
            <string name="Name">CloneCastPlan</string>
            <string name="Source"><![CDATA[--!strict
-- Explicit Roblox policy: mass eligibility reads mana AFTER base 200 debit.
local Domain=require("./NarutoRules")
local Rules=Domain.configure(require("./NarutoDefinitions"))
local Plan={}
function Plan.create(rank: number,target: string,mana: number,maximum: number): (Domain.ClonePlan?, string)
 if mana~=mana or mana<200 or mana==math.huge then return nil,"Mana" end
 return Rules.clonePlan(rank,target,mana-200,maximum)
end
return table.freeze(Plan)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="6">
          <Properties>
            <string name="Name">CloneCommands</string>
            <string name="Source"><![CDATA[--!strict
-- Agreed third-person control adaptation: owner follow/assist and explicit group target.
-- Target validity is supplied by the authoritative world adapter; no distances/AI invented.
export type State = {
	ownerId: string, round: number, life: number, active: boolean,
	lastRequest: number, assistTarget: string?, commandedTarget: string?, holding: boolean,
}
export type Intent = { mode: string, ownerId: string, targetId: string? }
local Commands = {}
function Commands.new(ownerId: string, round: number, life: number): State
	return { ownerId = ownerId, round = round, life = life, active = true, lastRequest = 0,
		assistTarget = nil, commandedTarget = nil, holding = false }
end
function Commands.suspend(state: State)
	state.active = false; state.assistTarget = nil; state.commandedTarget = nil; state.holding = false
end
function Commands.newLife(state: State, round: number, life: number)
	Commands.suspend(state); state.round = round; state.life = life; state.active = true
end
function Commands.assist(state: State, targetId: string?, validEnemy: boolean)
	state.assistTarget = if state.active and not state.holding and validEnemy and targetId ~= "" then targetId else nil
end
function Commands.invalidateTarget(state: State, targetId: string)
	if state.assistTarget == targetId then state.assistTarget = nil end
	if state.commandedTarget == targetId then state.commandedTarget = nil end
end
local function admit(state: State, actorId: string, round: number, life: number, requestId: number): (boolean, string)
	if actorId ~= state.ownerId then return false, "Owner" end
	if round ~= state.round or life ~= state.life then return false, "StaleLife" end
	if requestId ~= requestId or requestId == math.huge or requestId < 1 or requestId % 1 ~= 0 then return false, "Malformed" end
	if requestId <= state.lastRequest then return false, "Replay" end
	state.lastRequest = requestId
	if not state.active then return false, "Unavailable" end
	return true, "Accepted"
end
function Commands.order(state: State, actorId: string, round: number, life: number, requestId: number, order: string): (boolean, string)
	local accepted, reason = admit(state, actorId, round, life, requestId)
	if not accepted then return false, reason end
	if order ~= "Follow" and order ~= "Hold" then return false, "Malformed" end
	state.holding = order == "Hold"; state.commandedTarget = nil; state.assistTarget = nil
	return true, "Accepted"
end
function Commands.command(state: State, actorId: string, round: number, life: number,
	requestId: number, targetId: string, validEnemy: boolean): (boolean, string)
	local accepted, reason = admit(state, actorId, round, life, requestId)
	if not accepted then return false, reason end
	if targetId == "" or not validEnemy then return false, "Target" end
	state.commandedTarget = targetId; state.holding = false; return true, "Accepted"
end
function Commands.resolve(state: State): Intent
	if not state.active then return { mode = "Idle", ownerId = state.ownerId, targetId = nil } end
	if state.holding then return { mode = "Hold", ownerId = state.ownerId, targetId = nil } end
	if state.commandedTarget then return { mode = "Command", ownerId = state.ownerId, targetId = state.commandedTarget } end
	if state.assistTarget then return { mode = "Assist", ownerId = state.ownerId, targetId = state.assistTarget } end
	return { mode = "Follow", ownerId = state.ownerId, targetId = nil }
end
return Commands
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="7">
          <Properties>
            <string name="Name">CloneNavigationPolicy</string>
            <string name="Source"><![CDATA[--!strict
-- Engine-free policy; coordinates are horizontal studs. World queries stay server-side.
local Policy = {}
Policy.RepathInterval = 0.8
Policy.FailureDelay = 2
Policy.GoalDrift = 2
Policy.StuckTime = 1.2
Policy.RequestInterval = 0.25
Policy.MaxConcurrent = 2
Policy.SlotInterval = 0.5
export type Clock = { generation: number, key: string, nextPath: number, pending: boolean, alive: boolean }
function Policy.new(): Clock
	return { generation = 0, key = "", nextPath = 0, pending = false, alive = true }
end
function Policy.change(state: Clock, key: string): boolean
	if state.key == key then return false end
	state.key = key; state.generation += 1
	return true
end
function Policy.cancel(state: Clock)
	state.generation += 1; state.alive = false
end
function Policy.canRequest(state: Clock, now: number): boolean
	return state.alive and not state.pending and now >= state.nextPath
end
function Policy.begin(state: Clock, now: number): number
	state.pending = true; state.nextPath = now + Policy.RepathInterval
	return state.generation
end
function Policy.finish(state: Clock, generation: number, now: number, success: boolean): boolean
	state.pending = false
	if not state.alive or generation ~= state.generation then return false end
	if not success then state.nextPath = now + Policy.FailureDelay end
	return true
end
function Policy.slot(index: number, radius: number, spacing: number): (number, number)
	-- Fixed eight-angle inner ring; overflow waits outside melee range.
	local ring = math.floor((index - 1) / 8)
	-- Stagger waiting rings so settled overflow does not seal the radial lanes.
	local angle = ((index - 1) % 8) * math.pi / 4 + ring * math.pi / 8
	local distance = radius + ring * spacing
	return math.cos(angle) * distance, math.sin(angle) * distance
end
function Policy.segmentDistance(ax: number, az: number, bx: number, bz: number, px: number, pz: number): number
	local dx, dz = bx - ax, bz - az
	local length = dx * dx + dz * dz
	local t = if length > 0 then math.clamp(((px - ax) * dx + (pz - az) * dz) / length, 0, 1) else 0
	return math.sqrt((ax + t * dx - px)^2 + (az + t * dz - pz)^2)
end
function Policy.clearPeer(ax: number, az: number, bx: number, bz: number, px: number, pz: number, spacing: number): boolean
	local before = math.sqrt((ax-px)^2 + (az-pz)^2)
	local after = math.sqrt((bx-px)^2 + (bz-pz)^2)
	-- Spawn overlap can escape, but cannot deepen or pass through another unit.
	if before < spacing then return after > before + 0.001 end
	return Policy.segmentDistance(ax, az, bx, bz, px, pz) >= spacing
end
return table.freeze(Policy)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="8">
          <Properties>
            <string name="Name">CloneState</string>
            <string name="Source"><![CDATA[--!strict
-- Ordinary A04N burst/illusion lifetime. Roblox units, orders and Sleep are adapters.
export type Configuration = {
	read Lifetime: number, read SpawnInterval: number, read OutgoingMultiplier: number,
	read IncomingMultiplier: number, read MassCount: number,
}
export type Burst = { id: number, round: number, life: number, remaining: number, nextAt: number }
export type Clone = {
	id: number, ownerId: string, round: number, life: number, expiresAt: number,
	outgoingMultiplier: number, incomingMultiplier: number, hasPayload: boolean,
}
export type Payload = { cloneId: number, ownerId: string, round: number, life: number, targetId: string, claimed: boolean }
export type State = {
	ownerId: string, round: number, life: number, serial: number, burstSerial: number,
	lastRequest: number, cooldownAt: number, burst: Burst?, clones: { [number]: Clone }, pending: { [Payload]: boolean },
}
local Module = {}
local function finite(value: number): boolean return value == value and math.abs(value) < math.huge end
function Module.new(ownerId: string, round: number, life: number): State
	return { ownerId = ownerId, round = round, life = life, serial = 0, burstSerial = 0,
		lastRequest = 0, cooldownAt = 0, burst = nil, clones = {}, pending = {} }
end
function Module.newLife(state: State, life: number)
	state.life = life; state.burst = nil; table.clear(state.pending)
	-- Source does not prove a death purge of completed illusions. Invalidate empowered payloads
	-- as an intentional safety fix, but keep already-created clones until expiry/removal.
	for _, clone in state.clones do clone.hasPayload = false end
end
function Module.reset(state: State, round: number, life: number)
	Module.newLife(state, life); state.round = round; state.cooldownAt = 0; table.clear(state.clones)
end
function Module.remove(state: State, clone: Clone): boolean
	if state.clones[clone.id] ~= clone then return false end
	state.clones[clone.id] = nil; return true
end
function Module.expire(state: State, now: number): { Clone }
	local removed: { Clone } = {}
	if not finite(now) then return removed end
	for _, clone in state.clones do
		if now >= clone.expiresAt then Module.remove(state, clone); table.insert(removed, clone) end
	end
	return removed
end
function Module.takePayload(state: State, clone: Clone, now: number, targetId: string, hostile: boolean, structure: boolean): Payload?
	if not finite(now) or state.clones[clone.id] ~= clone or clone.ownerId ~= state.ownerId
		or clone.round ~= state.round or clone.life ~= state.life or now >= clone.expiresAt
		or not clone.hasPayload or not hostile or structure or targetId == "" then return nil end
	clone.hasPayload = false -- Atomic admission closes the same-frame double-attack race.
	local payload: Payload = { cloneId = clone.id, ownerId = state.ownerId, round = state.round, life = state.life,
		targetId = targetId, claimed = false }
	state.pending[payload] = true
	return payload
end
function Module.claimPayload(state: State, payload: Payload): string?
	if not state.pending[payload] or payload.claimed or payload.ownerId ~= state.ownerId or payload.round ~= state.round
		or payload.life ~= state.life then return nil end
	state.pending[payload] = nil; payload.claimed = true; return payload.targetId
end
function Module.configure(config: Configuration)
	local Rules = {}
	-- Count/cooldown come from the server's validated clone plan, never a client packet.
	function Rules.begin(state: State, now: number, requestId: number, count: number, cooldown: number): (Burst?, string)
		if not finite(now) or not finite(requestId) or requestId < 1 or requestId % 1 ~= 0
			or not finite(count) or count < 1 or count > config.MassCount or count % 1 ~= 0
			or not finite(cooldown) or cooldown < 0 then return nil, "Malformed" end
		if requestId <= state.lastRequest then return nil, "Replay" end
		state.lastRequest = requestId
		if state.burst then return nil, "Busy" end
		if now < state.cooldownAt then return nil, "Cooldown" end
		state.burstSerial += 1
		local burst: Burst = { id = state.burstSerial, round = state.round, life = state.life,
			remaining = count, nextAt = now + config.SpawnInterval }
		state.burst = burst; state.cooldownAt = now + cooldown
		return burst, "Accepted"
	end
	function Rules.spawnOne(state: State, burst: Burst, now: number, alive: boolean, heldRasengan: boolean): Clone?
		if not finite(now) or state.burst ~= burst or burst.round ~= state.round or burst.life ~= state.life then return nil end
		if not alive then state.burst = nil; return nil end
		if now < burst.nextAt then return nil end
		state.serial += 1
		local clone: Clone = { id = state.serial, ownerId = state.ownerId, round = state.round, life = state.life,
			expiresAt = now + config.Lifetime, outgoingMultiplier = config.OutgoingMultiplier,
			incomingMultiplier = config.IncomingMultiplier, hasPayload = heldRasengan }
		state.clones[clone.id] = clone
		burst.remaining -= 1; burst.nextAt = now + config.SpawnInterval
		if burst.remaining == 0 then state.burst = nil end
		return clone
	end
	return Rules
end
return Module
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="9">
          <Properties>
            <string name="Name">GamakichiSpells</string>
            <string name="Source"><![CDATA[--!strict
-- Explicit object overrides + separately named Roblox native-policy adaptations.
local S={}
S.Oil=table.freeze({Range=750,Radius=150,Duration=6,Cooldown=25,Mana=0,ProjectileSpeed=900,Arc=.05,MissChance=.3,MoveReduction=.4})
S.Chopping=table.freeze({Range=250,Radius=400,Waves=4,Damage=120,WaveCap=750,CastTime=.5,Cooldown=30,Mana=0})
S.NativePolicy=table.freeze({WaveInterval=1,FirstWaveAfterPreparation=true,RefreshNonStacking=true,
 AttackSpeedReductionImplemented=false,UnverifiedNsi4=.4,ClearOnSourceRemoval=true})
export type Flight={id: number,at: number}
export type Channel={id: number,nextAt: number,wave: number}
export type State={serial: number,lastRequest: number,oilReady: number,chopReady: number,flight: Flight?,channel: Channel?}
function S.new(): State return {serial=0,lastRequest=0,oilReady=0,chopReady=0,flight=nil,channel=nil} end
function S.request(state: State,id: string,now: number,request: number,adult: boolean,travel: number): (boolean,string)
 if request~=request or request%1~=0 or request<1 or request==math.huge then return false,"Malformed" end
 if request<=state.lastRequest then return false,"Replay" end
 state.lastRequest=request
 if id~="GamakichiOil" and id~="GamakichiChop" then return false,"Unsupported" end
 if id=="GamakichiChop" and not adult then return false,"Rank" end
 if state.flight or state.channel then return false,"Busy" end
 if now<(if id=="GamakichiOil" then state.oilReady else state.chopReady) then return false,"Cooldown" end
 if travel~=travel or travel<0 or travel==math.huge then return false,"Malformed" end
 state.serial+=1
 if id=="GamakichiOil" then
  state.oilReady=now+S.Oil.Cooldown; state.flight={id=state.serial,at=now+travel}
 else
  state.chopReady=now+S.Chopping.Cooldown; state.channel={id=state.serial,nextAt=now+S.Chopping.CastTime,wave=0}
 end
 return true,"Accepted"
end
function S.claimOil(state: State,now: number): boolean
 if not state.flight or now<state.flight.at then return false end
 state.flight=nil; return true
end
function S.claimWave(state: State,now: number): number?
 local c=state.channel; if not c or now<c.nextAt then return nil end
 c.wave+=1; local wave=c.wave
 c.nextAt+=S.NativePolicy.WaveInterval
 if wave>=S.Chopping.Waves then state.channel=nil end
 return wave
end
function S.cancel(state: State) state.flight=nil; state.channel=nil end
-- Grant IDs preserve independent casters; refresh, never multiply slow/miss chance.
export type Debuff={grants: {[string]: number}}
function S.debuff(): Debuff return {grants={}} end
function S.apply(d: Debuff,key: string,now: number) d.grants[key]=now+S.Oil.Duration end
function S.clear(d: Debuff,key: string) d.grants[key]=nil end
function S.untilAt(d: Debuff,now: number): number
 local ends=0
 for key,t in d.grants do if t<=now then d.grants[key]=nil else ends=math.max(ends,t) end end
 return ends
end
function S.movement(d: Debuff,now: number): number return if S.untilAt(d,now)>now then 1-S.Oil.MoveReduction else 1 end
function S.misses(d: Debuff,now: number,roll: number): boolean
 return roll==roll and roll>=0 and roll<1 and S.untilAt(d,now)>now and roll<S.Oil.MissChance
end
-- Deterministic equal split is the selected cap policy; not a certified Blizzard allocation order.
function S.waveDamage(targetCount: number): number
 return if targetCount>0 then math.min(S.Chopping.Damage,S.Chopping.WaveCap/targetCount) else 0
end
return S
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="10">
          <Properties>
            <string name="Name">GamakichiState</string>
            <string name="Source"><![CDATA[--!strict
-- A005 object facts. Policy below is a bounded Roblox adaptation, not native parity.
export type Profile = { read health: number, read regen: number, read armor: number, read speed: number, read mana: number, read rawDamage: number, read adult: boolean }
export type Cast = { id: number, rank: number, expiresAt: number, profile: Profile }
export type State = { serial: number, lastRequest: number, cooldownAt: number, active: Cast? }
local G = {}
G.Policy = table.freeze({ FirstLevel=1, LevelSkip=2, AttackInterval=2, DamagePoint=.5,
 FollowDistance=10, SpawnOffset=8, CancelOnOwnerDeath=true })
local early: Profile = table.freeze({health=500,regen=2,armor=7,speed=350,mana=500,rawDamage=41,adult=false})
local adult: Profile = table.freeze({health=1500,regen=5,armor=15,speed=400,mana=1000,rawDamage=101,adult=true})
function G.rank(rank: number): (number?, number?, number?, Profile?)
 if rank~=rank or rank%1~=0 or rank<1 or rank>10 then return nil,nil,nil,nil end
 return if rank<=4 then 50 elseif rank<=8 then 150 else 300, if rank<=5 then 60 else 150, 5+5*rank, if rank<=5 then early else adult
end
function G.new(): State return {serial=0,lastRequest=0,cooldownAt=0,active=nil} end
function G.request(state: State, now: number, request: number, rank: number, mana: number): (Cast?, string, number)
 if request~=request or request<1 or request%1~=0 or request==math.huge then return nil,"Malformed",0 end
 if request<=state.lastRequest then return nil,"Replay",0 end
 state.lastRequest=request
 local cost,cd,duration,profile=G.rank(rank)
 if not cost or not cd or not duration or not profile then return nil,"Unlearned",0 end
 if now<state.cooldownAt then return nil,"Cooldown",0 end
 if mana<cost then return nil,"Mana",0 end
 state.serial+=1
 local cast: Cast={id=state.serial,rank=rank,expiresAt=now+duration,profile=profile}
 state.active=cast; state.cooldownAt=now+cd
 return cast,"Accepted",cost
end
function G.live(state: State, cast: Cast, now: number): boolean return state.active==cast and now<cast.expiresAt end
function G.cancel(state: State) state.active=nil end
function G.expire(state: State, now: number): boolean
 local cast=state.active
 if cast and now>=cast.expiresAt then G.cancel(state); return true end
 return false
end
return G
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">MeditationState</string>
            <string name="Source"><![CDATA[--!strict
-- forms contract JASS 44774-44826, 44227-44296. No Roblox dependencies.
local M = {}
export type Form = "Ordinary" | "KCM" | "Kurama"
export type Clone = {id: number, owner: string, round: number, life: number, mana: number, maximum: number, regen: number, updatedAt: number, expiresAt: number, settled: boolean}
export type State = {owner: string, round: number, life: number, serial: number, clones: {[number]: Clone}}
-- Native initial mana for nmdr/nmcf is omitted; zero is explicit safe policy.
M.Policy = table.freeze({OrdinaryInitialMana=0, InitialManaProvisional=true, Lifetime=35, OwnerInvalidationTransfers=false, RecallCost=0, RecallCostProvisional=true, RecallCooldown=5})
local function finite(n: number): boolean return n==n and math.abs(n)<math.huge end
function M.new(owner: string, round: number, life: number): State
 return {owner=owner,round=round,life=life,serial=0,clones={}}
end
function M.plan(rank: number, level: number, form: Form): (number,number,number)
 if not finite(rank) or rank%1~=0 or rank<1 or rank>3 or not finite(level) or level%1~=0 or level<1 or level>30 then return 0,0,0 end
 if form=="Kurama" then return 2,2000,100 end
 if form~="Ordinary" and form~="KCM" then return 0,0,0 end
 local two = rank==3 and (if form=="KCM" then level>18 else level>=18)
 return if two then 2 else 1,500,20
end
function M.spawn(state: State, now: number, rank: number, level: number, form: Form): {Clone}
 if not finite(now) then return {} end
 local count,maximum,regen=M.plan(rank,level,form)
 local result: {Clone}={}
 for _=1,count do
  state.serial+=1
  local clone: Clone={id=state.serial,owner=state.owner,round=state.round,life=state.life,mana=M.Policy.OrdinaryInitialMana,maximum=maximum,regen=regen,updatedAt=now,expiresAt=now+M.Policy.Lifetime,settled=false}
  state.clones[clone.id]=clone; table.insert(result,clone)
 end
 return result
end
function M.live(state: State, clone: Clone): boolean
 return state.clones[clone.id]==clone and not clone.settled and state.owner==clone.owner and state.round==clone.round and state.life==clone.life
end
function M.update(state: State, clone: Clone, now: number)
 if not M.live(state,clone) or not finite(now) then return end
 local at=math.max(clone.updatedAt,math.min(now,clone.expiresAt))
 clone.mana=math.min(clone.maximum,clone.mana+(at-clone.updatedAt)*clone.regen); clone.updatedAt=at
end
-- Claim before calling adapters: concurrent Died/expiration/recall can pay only once.
function M.restore(state: State, clone: Clone, now: number, amount: number): boolean
 if not M.live(state,clone) or not finite(now) or now<clone.updatedAt or now>=clone.expiresAt
  or not finite(amount) or amount<=0 then return false end
 M.update(state,clone,now)
 clone.mana=math.min(clone.maximum,clone.mana+amount)
 return true
end
function M.settle(state: State, clone: Clone, now: number, ownerValid: boolean): number
 if not M.live(state,clone) or not finite(now) then return 0 end
 M.update(state,clone,now); clone.settled=true; state.clones[clone.id]=nil
 return if ownerValid then clone.mana else 0
end
function M.invalidate(state: State, round: number, life: number)
 for _,clone in state.clones do clone.settled=true end
 state.clones={}; state.round=round; state.life=life
end
return M
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="12">
          <Properties>
            <string name="Name">NarutoAdvancedCatalog</string>
            <string name="Source"><![CDATA[--!strict
-- Eligibility is not implementation readiness. Missing native costs stay absent.
export type Context = { sageReady: boolean, level: number, kcmRank: number, hagoromo: boolean, held: string }
local Catalog = {}
function Catalog.reason(id: string, c: Context): string?
 if id=="ChoOdama" then
  if c.held~="Odama" or not c.sageReady or c.level<16 then return "Eligibility" end
  return "NativeCostUnknown"
 elseif id=="Wakusei" then
  if c.kcmRank<1 or c.kcmRank>2 or (c.held~="Rasengan" and c.held~="Odama") then return "Eligibility" end
  return "NativeCostUnknown"
 elseif id=="RasenRenShuriken" or id=="MagmaRasenshuriken" then
  if c.held~="Rasenshuriken" or (id=="MagmaRasenshuriken" and not c.hagoromo) then return "Eligibility" end
  return "RangedAndMeleeGraphUnverified"
 elseif id=="BijudamaRasenshuriken" or id=="ChoBijudamaRasenshuriken" or id=="ChoBijuuRasenshuriken" or id=="ChakraKnife" then
  if c.kcmRank~=3 or not c.hagoromo then return "Eligibility" end
  return if id=="ChakraKnife" then "RegionPolicyUnknown" else "DownstreamGraphUnverified"
 end
 return "Unsupported"
end
return table.freeze(Catalog)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">NarutoDefinitions</string>
            <string name="Source"><![CDATA[--!strict
-- Source: Naruto Legend 1.7A FIX20.3; contract libfile_de3939fe995081919fd57704506aa2b1.
-- Source verification is not Roblox runtime readiness. No distances below are studs.
local lines = {
	table.freeze({ Id = "Rasengan", Rawcode = "A014", Name = "Расенган", SourceStatus = "BaseVerified", RuntimeReady = false }),
	table.freeze({ Id = "ShadowClones", Rawcode = "A04N", Name = "Теневые клоны", SourceStatus = "BaseVerified", RuntimeReady = false }),
	table.freeze({ Id = "Gamakichi", Rawcode = "A005", Name = "Гамакичи", SourceStatus = "Planned", RuntimeReady = false }),
	table.freeze({ Id = "SageMode", Rawcode = "A09J", Name = "Режим мудреца", SourceStatus = "Planned", RuntimeReady = false }),
	table.freeze({ Id = "KCM", Rawcode = "A017", Name = "KCM", SourceStatus = "Planned", RuntimeReady = false }),
}
return table.freeze({
	SourceVersion = "1.7A FIX20.3",
	SourceSHA256 = "8c5750f178a7f1d66a4f04e8d0c585168e51f93c924149858fbb8d731193a5c8",
	Lines = table.freeze(lines),
	Hero = table.freeze({
		UnitRawcode = "Hpal", Strength = 16, StrengthGrowth = 1.4, Agility = 15, AgilityGrowth = 1.1,
		Intelligence = 14, IntelligenceGrowth = 1, BaseMana = 1300, InitialManaField = 9999,
		BaseHealth = 300, HealthPerStrength = 20, MapLevelCap = 30,
	}),
	NativeInference = table.freeze({
		RuntimeCertified = false, ManaPerIntelligence = 15, RegenPerIntelligence = 0.05,
		BaseManaRegen = 0.01, BaseSpeedWarcraft = 270,
	}),
	Rasengan = table.freeze({
		Ranks = 3, RequiredLevel = 4, RankSkip = 7, ManaCost = 100, Cooldown = 60,
		Preparation = 2, HoldDuration = 15, AttackControlDelay = 0.01, ImpactDelay = 1, Stun = 3.5,
		VariantWindow = 1, HandEffectDelay = 1.5, HelperOffsetWarcraft = 120,
		BaseDamage = 120, StrengthFactor = 1, LevelFactor = 10,
	}),
	Clones = table.freeze({
		Counts = table.freeze({ 3, 4, 5, 7 }), Cooldowns = table.freeze({ 50, 46, 42, 38 }),
		ManaCost = 200, RangeWarcraft = 2000, Lifetime = 20, SpawnInterval = 0.01,
		OutgoingMultiplier = 0.30, IncomingMultiplier = 20,
		MassCount = 30, MassManaFraction = 0.30,
		SleepDuration = 3, SleepCosmetics = 5, SleepRadiusWarcraft = 120,
		PayloadLevelFactor = 4, PayloadStrengthFactor = 0.30,
		PayloadDisplacementWarcraft = 600, PayloadDisplacementDuration = 0.5,
	}),
	-- Deliberately absent: inherited rank-1 buff speed, clone unlock levels,
	-- generic skill-point cost and native resource ordering.
	Unsupported = table.freeze({
		"OdamaAdapter", "Rasenshuriken", "SageMode", "KCM", "Gamakichi",
		"ClonePointAdvanced", "AlternateClonePayload", "NativeSleepWakePolicy",
	}),
})
]]></string>
