        <Item class="ModuleScript" referent="111">
          <Properties>
            <string name="Name">NarutoKuramaService</string>
            <string name="Source"><![CDATA[--!strict
local Players=game:GetService("Players")
local Shared=game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Form=require(Shared.Abilities.NarutoKuramaState)
local Units=require(Shared.Abilities.WorldUnits)
local Structures=require(Shared.Game.StructureRules)
local Stats=require(script.Parent.CharacterStatsService)
local Fighters=require(script.Parent.FighterStateService)
local Teams=require(script.Parent.TeamService)
local Damage=require(script.Parent.DamageService)
local Hitboxes=require(script.Parent.HitboxService)
export type Hooks={chakra: (Player)->number?,spend: (Player,number)->boolean,kcm: (Player)->boolean,
 busy: (Player)->boolean,restoreMana: (Player,number)->()}
type Record={state: Form.State,model: Model?,visual: Highlight?,lastRequest: number,applied: boolean}
local records: {[Player]: Record}={}
local retained: {[string]: {epoch: number,balance: Form.Balance}}={}
local hooks: Hooks?=nil
local rng=Random.new()
local summonMana: ((Model,number)->boolean)?=nil
local S={}
local function epoch(): number local m=Teams.GetState(); return if m then m.roundId else 0 end
local function valid(p: Player,r: Record): boolean
 local model=r.model
 return p.Parent==Players and model~=nil and p.Character==model and model:GetAttribute("LifeId")==r.state.life
  and epoch()==r.state.epoch and Damage.CanAct(model)
end
local function teardown(r: Record)
 if not r.applied and not r.visual then return end; r.applied=false
 local model=r.model
 if model then
  Stats.SetLayer(model,"NarutoKurama",nil); Stats.SetLayer(model,"NarutoKuramaThreeHead",nil)
  model:SetAttribute("KuramaActive",false); model:SetAttribute("KuramaProcPending",false)
 end
 if r.visual then r.visual:Destroy(); r.visual=nil end
end
local function events(r: Record,list: {Form.Event})
 for _,e in list do if e.kind=="Exited" then teardown(r) end end
 local model=r.model; if model then model:SetAttribute("KuramaLocked",Form.isLocked(r.state)) end
end
local function record(p: Player,now: number): Record
 local r=records[p]; local model=p.Character; local life=if model then (model:GetAttribute("LifeId") or 0) :: number else 0
 if not r then
  local owner=tostring(p.UserId); local saved=retained[owner]
  local created: Record={state=Form.new(owner,epoch(),life,now,if saved and saved.epoch==epoch() then saved.balance else nil),model=model,visual=nil,lastRequest=0,applied=false}
  retained[owner]=nil
  r=created; records[p]=created
 elseif r.state.epoch~=epoch() or r.state.life~=life or r.model~=model then
  events(r,Form.newLife(r.state,epoch(),life,now))
  r.model=model; r.lastRequest=0
 end
 return r
end
function S.Start(h: Hooks) hooks=h end
function S.ConfigureSummonManaReceiver(receiver: (Model,number)->boolean) summonMana=receiver end
function S.IsActive(p: Player): boolean
 local r=records[p]; local c=if r then r.state.active else nil
 return r~=nil and r.applied and c~=nil and c.buff and (c.externalBuff or workspace:GetServerTimeNow()<c.expiresAt) and valid(p,r)
end
function S.IsLocked(p: Player): boolean
 local r=records[p]; local model=if r then r.model else nil
 return r~=nil and model~=nil and r.state.epoch==epoch() and model==p.Character and model:GetAttribute("LifeId")==r.state.life and Form.isLocked(r.state)
end
function S.TryCast(p: Player,request: number,now: number,target: any): (boolean,string)
 local h=hooks; if not h then return false,"Unavailable" end
 if target~=nil then return false,"Malformed" end
 local r=record(p,now); local model=p.Character; local fighter=if model then Fighters.Get(model) else nil
 if not model or not fighter or not valid(p,r) or p:GetAttribute("HeroId")~="OrangeNinja" then return false,"Unavailable" end
 if request~=request or request%1~=0 or request<1 or request==math.huge then return false,"Malformed" end
 if request<=r.lastRequest then return false,"Replay" end; r.lastRequest=request
 events(r,Form.update(r.state,now,true))
 local before=table.clone(r.state)
 local accepted,reason,cost=Form.request(r.state,now,{level=Stats.Get(p).Level,alive=true,
  canCast=fighter.logic.mode=="Idle" and fighter.logic.nextAttackAt<=now and not fighter.root.Anchored and not h.busy(p),
  kcm=h.kcm(p),chakra=h.chakra(p) or 0})
 if not accepted then return false,reason end
 -- Resource owner and policy application are synchronous; no client debit/attributes are accepted.
 if not h.spend(p,cost) then r.state=before; return false,"Chakra" end
 r.applied=true
 local m=Form.modifier()
 Stats.SetLayer(model,"NarutoKurama",{health=m.health,armor=m.armor,attack=m.attack,speed=Units.toStuds(m.speedWarcraft)})
 model:SetAttribute("KuramaActive",true); model:SetAttribute("KuramaLocked",true)
 model:SetAttribute("KuramaCastId",r.state.serial); model:SetAttribute("KuramaExpiresAt",now+Form.Duration)
 model:SetAttribute("Ready_KuramaForm",r.state.cooldownAt); model:SetAttribute("KuramaPolicy",Form.Policy.Retention)
 local v=Instance.new("Highlight"); v.Name="NarutoKuramaAura"; v.Archivable=false; v.Adornee=model
 v.FillColor=Color3.fromRGB(255,90,10); v.OutlineColor=Color3.fromRGB(255,220,40); v.FillTransparency=.55
 v.DepthMode=Enum.HighlightDepthMode.Occluded; v.Parent=model; r.visual=v
 return true,"Accepted"
end
-- Attack intent with an admitted target, before landed M1 damage. Structures may be initial targets.
function S.AttackStarted(p: Player,hasTarget: boolean)
 local r=records[p]; if not r or not S.IsActive(p) then return end
 local model=r.model; if not model then return end
 local root=model:FindFirstChild("HumanoidRootPart"); if not root or not root:IsA("BasePart") or not Hitboxes.IsFiniteCFrame(root.CFrame) then return end
 local at=root.Position
 if Form.attackStart(r.state,workspace:GetServerTimeNow(),rng:NextNumber(1,100),model:GetAttribute("NativeNarutoClone")==true,hasTarget,at.X,at.Y,at.Z) then
  model:SetAttribute("KuramaProcPending",true)
 end
end
-- Called on the EXISTING separate-chakra resource1s phase, after its strict threshold admission.
function S.Pulse(p: Player)
 local r=records[p]; local h=hooks; if not r or not h or not S.IsActive(p) then return end
 local model=r.model; if not model then return end
 local root=model:FindFirstChild("HumanoidRootPart"); if not root or not root:IsA("BasePart") then return end
 local receiver=summonMana
 for target,fighter in Fighters.GetAll() do
  local kind=target:GetAttribute("EntityKind")
  if not Structures.isStructure(kind) and not Teams.IsEnemy(model,target)
   and Teams.GetId(model)==Teams.GetId(target) and (fighter.root.Position-root.Position).Magnitude<=Units.toStuds(400) then
   -- Source predicate has no alive test. Roblox safety: never resurrect dead Humanoids.
   if fighter.humanoid.Health>0 then fighter.humanoid.Health=math.min(fighter.humanoid.MaxHealth,fighter.humanoid.Health+20) end
   local player=Players:GetPlayerFromCharacter(target)
   if player then h.restoreMana(player,20)
   elseif target:GetAttribute("NativeGamakichi")==true then
    local mana,maxMana=target:GetAttribute("Mana"),target:GetAttribute("MaxMana")
    if typeof(mana)=="number" and typeof(maxMana)=="number" then target:SetAttribute("Mana",math.min(maxMana,mana+20)) end
   elseif receiver then receiver(target,20) end -- Optional authoritative meditation/other-mana-owner seam, never edit presentation mana.
  end
 end
end
function S.ObserveBuff(p: Player,life: number,round: number,cast: number,present: boolean): boolean
 local r=records[p]
 if not r or r.state.life~=life or r.state.epoch~=round or not valid(p,r) then return false end
 return Form.observeBuff(r.state,cast,present)
end
function S.ObserveBuffRemoved(p: Player,life: number,round: number,cast: number): boolean
 local r=records[p]
 if not r or r.state.life~=life or r.state.epoch~=round or not valid(p,r) then return false end
 return Form.buffRemoved(r.state,cast)
end
function S.Update(now: number)
 for p in records do
  local r=record(p,now)
  local alive=valid(p,r)
  events(r,Form.update(r.state,now,alive))
  local model=r.model
  if model then model:SetAttribute("Ready_KuramaForm",r.state.cooldownAt) end
  if alive and model then
   local hp=model:FindFirstChildOfClass("Humanoid")
   local proc,amount=Form.claimProc(r.state,now,if hp then hp.MaxHealth else 0)
   if proc and amount then
    model:SetAttribute("KuramaProcPending",false)
    local center=Vector3.new(proc.x,proc.y,proc.z)
    for target,fighter in Fighters.GetAll() do
     local kind=target:GetAttribute("EntityKind")
     if not Structures.isStructure(kind) and Damage.CanDamage(model,target)
      and (fighter.root.Position-center).Magnitude<=Units.toStuds(Form.ProcRadius) then Damage.Apply(model,fighter.humanoid,amount) end
    end
   end
   model:SetAttribute("Ready_KuramaForm",r.state.cooldownAt)
  end
 end
end
function S.Remove(p: Player)
 local r=records[p]; if r then
  events(r,Form.update(r.state,workspace:GetServerTimeNow(),false)); teardown(r)
  retained[tostring(p.UserId)]={epoch=r.state.epoch,balance=Form.balance(r.state)}
  records[p]=nil
 end
end
function S.StudioResetCooldowns(p: Player)
 if not game:GetService("RunService"):IsStudio() then return end
 local r=records[p];if not r then return end
 r.state.cooldownAt=0;r.state.threeHeadAt=0
 if r.state.active and not r.state.active.buff then r.state.active=nil end
 if r.model then r.model:SetAttribute("Ready_KuramaForm",0);r.model:SetAttribute("KuramaLocked",Form.isLocked(r.state)) end
end
function S.Reset()
 for p,r in records do
  local model=r.model; S.Remove(p)
  if model then model:SetAttribute("Ready_KuramaForm",0); model:SetAttribute("KuramaExpiresAt",0); model:SetAttribute("KuramaCastId",nil) end
 end
 table.clear(retained)
end
return S
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="112">
          <Properties>
            <string name="Name">NarutoRangedService</string>
            <string name="Source"><![CDATA[--!strict
-- Server-owned HY/HZ transaction/world adapter. Source policies: docs/NARUTO-RANGED-RUNTIME.md.
local Players=game:GetService("Players")
local Shared=game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Domain=require(Shared.Abilities.NarutoRangedState)
local Units=require(Shared.Abilities.WorldUnits)
local Kcm=require(script.Parent.NarutoKcmService)
local Fighters=require(script.Parent.FighterStateService)
local Damage=require(script.Parent.DamageService)
local Teams=require(script.Parent.TeamService)
local Hitboxes=require(script.Parent.HitboxService)
local Structures=require(Shared.Game.StructureRules)
export type Hooks={mana:(Player)->number,spend:(Player,number)->boolean,strength:(Player)->number,
 busy:(Player)->boolean,pause:(Player,number)->()}
type Presentation={key:string,origin:Vector3,target:Vector3}
type Record={state:Domain.State,model:Model,kcmCast:number?,presentations:{[number]:Presentation}}
type Ownership={model:Model,untilAt:number}
local records:{[Player]:Record}={}
local retained:{[string]:{round:number,balance:Domain.Balance}}={}
local ownership:{[BasePart]:Ownership}={}
local hooks:Hooks?=nil
local S={Visual=Instance.new("BindableEvent"),Event=Instance.new("BindableEvent")}
local function epoch():number local match=Teams.GetState();return if match then match.roundId else 0 end
local function raw(point:Vector3):Domain.Point return {x=point.X/Units.StudsPerWarcraftUnit,z=point.Z/Units.StudsPerWarcraftUnit} end
local function finish(r:Record,id:number)
 local p=r.presentations[id];if not p then return end
 r.presentations[id]=nil;S.Visual:Fire({kind="RikudoEnd",key=p.key})
end
local function cancel(r:Record)
 for _,cast in r.state.casts do Domain.cancel(r.state,cast) end
 for id in r.presentations do finish(r,id) end
 r.model:SetAttribute("RangedPreparingUntil",nil);r.model:SetAttribute("RangedCastStartedAt",nil)
end
local function bind(p:Player,now:number):Record?
 local model=p.Character;local life=if model then model:GetAttribute("LifeId") else nil
 if not model or typeof(life)~="number" then return nil end
 local r=records[p]
 if not r then
  local owner=tostring(p.UserId);local saved=retained[owner]
  local created:Record={state=Domain.new(owner,epoch(),life,now,if saved and saved.round==epoch() then saved.balance else nil),model=model,kcmCast=nil,presentations={}};records[p]=created;r=created
  retained[owner]=nil
 elseif r.model~=model or r.state.life~=life or r.state.round~=epoch() then
  cancel(r)
  if r.state.round~=epoch() then Domain.reset(r.state,epoch(),life) else Domain.newLife(r.state,epoch(),life) end
  r.model=model;r.kcmCast=nil
 end
 return r
end
function S.IsAbility(id:string):boolean return id=="RikudoHY" or id=="RikudoHZ" end
function S.Ready(p:Player):{[string]:number}
 local r=records[p];return if r then {RikudoHY=r.state.cooldowns.A0HY or 0,RikudoHZ=r.state.cooldowns.A0HZ or 0} else {}
end
function S.Busy(p:Player):boolean
 local r=records[p];if not r then return false end
 local now=workspace:GetServerTimeNow()
 for _,c in r.state.casts do if now<c.unpauseAt then return true end end
 return false
end
function S.Invalidate(p:Player) local r=records[p];if r then cancel(r) end end
function S.Remove(p:Player)
 local r=records[p];if r then
  cancel(r);retained[tostring(p.UserId)]={round=r.state.round,balance=Domain.balance(r.state)}
  Domain.close(r.state);records[p]=nil
 end
end
function S.Inspect(p:Player):Domain.State? local r=records[p];return if r then r.state else nil end
local function publish(r:Record,grant:Domain.Grant?)
 local model=r.model
 model:SetAttribute("RikudoRangedGranted",grant~=nil)
 model:SetAttribute("Ready_RikudoHY",r.state.cooldowns.A0HY or 0)
 model:SetAttribute("Ready_RikudoHZ",r.state.cooldowns.A0HZ or 0)
end
function S.TryCast(p:Player,id:string,requestId:number,now:number,target:any):(boolean,string)
 local h=hooks;local r=bind(p,now)
 if not h or not r or not S.IsAbility(id) then return false,"Unavailable" end
 local grant,kcmCast=Kcm.RikudoGrant(p,now)
 if not grant or not kcmCast then publish(r,nil);return false,"Rikudo" end
 if r.kcmCast and r.kcmCast~=kcmCast then cancel(r) end;r.kcmCast=kcmCast
 local fighter=Fighters.Get(r.model)
 if not fighter or not Damage.CanAct(r.model) or fighter.logic.mode~="Idle" or fighter.logic.nextAttackAt>now
  or (fighter.sleep and fighter.sleep.active) or fighter.root.Anchored or h.busy(p) or S.Busy(p) then return false,"Busy" end
 if typeof(target)~="Vector3" or not Hitboxes.IsFiniteCFrame(CFrame.new(target)) then return false,"Target" end
 local point=target :: Vector3;local origin=fighter.root.Position
 if (point-origin).Magnitude>Units.toStuds(Domain.RangeWarcraft) then return false,"Range" end
 local ray=RaycastParams.new();ray.FilterType=Enum.RaycastFilterType.Exclude
 local ignored:{Instance}={};for model in Fighters.GetAll() do table.insert(ignored,model) end
 ray.FilterDescendantsInstances=ignored;ray.RespectCanCollide=true
 local ground=workspace:Raycast(point+Vector3.new(0,12,0),Vector3.new(0,-36,0),ray)
 if not ground then return false,"Ground" end
 point=Vector3.new(point.X,ground.Position.Y,point.Z)
 if (point-origin).Magnitude>Units.toStuds(Domain.RangeWarcraft) then return false,"Range" end
 local code=if id=="RikudoHY" then "A0HY" else "A0HZ"
 grant.abilityId=code
 local cast,reason,debit=Domain.request(r.state,now,requestId,code,h.mana(p),raw(origin),raw(point),grant,true)
 if not cast then publish(r,grant);return false,reason end
 assert(h.spend(p,debit),"Ranged state/debit must commit without yielding")
 local key=string.format("%s:%d:%d:%d:%d",r.state.ownerId,r.state.round,r.state.life,kcmCast,cast.id)
 local visualOrigin=origin+Vector3.new(0,1,0)
 r.presentations[cast.id]={key=key,origin=visualOrigin,target=point+Vector3.new(0,1,0)}
 r.model:SetAttribute("RangedPreparingUntil",now+1.5);r.model:SetAttribute("RangedCastStartedAt",now)
 h.pause(p,1.5);publish(r,grant)
 S.Visual:Fire({kind="RikudoStart",key=key,caster=r.model,abilityId=code,origin=visualOrigin,
  target=point+Vector3.new(0,1,0),startedAt=now,releaseAt=cast.releaseAt,life=r.state.life})
 return true,"Accepted"
end
local function allied(a:Model,b:Model):boolean
 if a==b then return true end
 local first,second=Teams.GetId(a),Teams.GetId(b)
 return first~=nil and first==second
end
local function move(model:Model,root:BasePart,center:Vector3,amount:number,now:number)
 if root.Anchored then return end
 local flat=(center-root.Position)*Vector3.new(1,0,1);if flat.Magnitude<.001 then return end
 local step=flat.Unit*(if amount>0 then math.min(amount,flat.Magnitude) else amount)
 local ray=RaycastParams.new();ray.FilterType=Enum.RaycastFilterType.Exclude;ray.FilterDescendantsInstances={model};ray.RespectCanCollide=true
 local hit=workspace:Blockcast(root.CFrame,root.Size*.8,step,ray)
 if hit then step=step.Unit*math.max(0,math.min(step.Magnitude,hit.Distance-.03)) end
 if root:CanSetNetworkOwnership() then
  local saved=ownership[root]
  if not saved then
   saved={model=model,untilAt=now+.4};ownership[root]=saved
  end
  saved.untilAt=now+.4
  local fighter=Fighters.Get(model); if fighter then Fighters.LeaseNetworkOwnership(fighter,saved.untilAt) end
 end
 root.CFrame+=step
end
local function restore(now:number,force:boolean?)
 for root,saved in ownership do
  if force or now>=saved.untilAt or not root.Parent then
   ownership[root]=nil
   local fighter=Fighters.Get(saved.model)
   if fighter then Fighters.ReleaseNetworkOwnership(fighter) end
  end
 end
end
local function apply(p:Player,r:Record,e:Domain.Event,now:number)
 local view=r.presentations[e.id];if not view then return end
 if p.Character~=r.model or e.life~=r.state.life or e.round~=epoch() or not Damage.CanAct(r.model) then cancel(r);return end
 local center=Vector3.new(Units.toStuds(e.center.x),view.target.Y,Units.toStuds(e.center.z))
 if e.kind=="Arrived" then
  S.Visual:Fire({kind="RikudoArrived",key=view.key,position=center,at=e.at})
 elseif e.kind=="DamagePulse" or e.kind=="Motion" then
  local radius=Units.toStuds(e.radius)
  local affected=0
  for model,victim in Fighters.GetAll() do
   local flat=(victim.root.Position-center)*Vector3.new(1,0,1)
   -- Safe adaptation: absent source null groups introduce no live exclusion groups.
   if flat:Dot(flat)<=radius*radius and Damage.CanAct(model) and Domain.eligible(e.filter or "",allied(r.model,model),
    Teams.IsEnemy(r.model,model),Structures.isStructure(model:GetAttribute("EntityKind")),false) then
    if e.damage then Damage.Apply(r.model,victim.humanoid,e.damage) end
    if e.displacement and victim.humanoid.Health>0 then move(model,victim.root,center,Units.toStuds(e.displacement),now) end
    affected+=1
   end
  end
  S.Event:Fire(p,e,affected)
  if e.kind=="DamagePulse" and (e.abilityId=="A0HZ" or e.pulse%4==1 or e.pulse==58) then
   S.Visual:Fire({kind="RikudoPulse",key=view.key,radius=radius,at=e.at})
  end
 elseif e.kind=="Completed" or e.kind=="Cancelled" then finish(r,e.id);S.Event:Fire(p,e,0) end
end
function S.Update(now:number)
 local h=hooks;if not h then return end
 for _,p in Players:GetPlayers() do
  local r=bind(p,now);if not r then continue end
  local grant,castId=Kcm.RikudoGrant(p,now)
  if not grant or (r.kcmCast and r.kcmCast~=castId) or not Damage.CanAct(r.model) then cancel(r) end
  r.kcmCast=castId;publish(r,grant)
  if grant then
   local events=Domain.update(r.state,now,function():number return h.strength(p) end)
   for _,e in events do apply(p,r,e,now) end
  end
 end
 restore(now)
end
function S.Reset()
 for _,r in records do cancel(r);Domain.reset(r.state,epoch(),r.state.life);publish(r,nil);r.kcmCast=nil end
 restore(workspace:GetServerTimeNow(),true)
 table.clear(retained)
end
function S.Start(h:Hooks) assert(not hooks,"Ranged hooks already configured");hooks=h end
return S
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="113">
          <Properties>
            <string name="Name">NarutoSleepService</string>
            <string name="Source"><![CDATA[--!strict
local Fighters=require(script.Parent.FighterStateService)
local Damage=require(script.Parent.DamageService)
local Teams=require(script.Parent.TeamService)
local Sleep=require(game.ReplicatedStorage.Shared.Abilities.SleepState)
local Service={}
local cosmetics: {[Model]: number}={}
function Service.CanWakeAlly(attacker: Model,target: Model): boolean
 if attacker==target or not Damage.CanAct(attacker) or not Damage.CanAct(target)
  or Teams.IsNeutral(attacker) or Teams.IsNeutral(target) or target:FindFirstChildOfClass("ForceField") then return false end
 local team=Teams.GetId(attacker)
 if not team or team~=Teams.GetId(target) or not Teams.IsActive(team) then return false end
 local kind=target:GetAttribute("EntityKind")
 if kind~="Hero" and kind~="Minion" and kind~="Summon" then return false end
 local fighter=Fighters.Get(target)
 return fighter~=nil and Sleep.isActive(fighter.sleep,workspace:GetServerTimeNow())
end
function Service.TryWakeAlly(attacker: Model,target: Model): boolean
 if not Service.CanWakeAlly(attacker,target) then return false end
 local fighter=Fighters.Get(target); assert(fighter)
 -- Wake is not damage: no rewards, offensive procs, or friendly-fire exception.
 Fighters.WakeSleep(fighter); return true
end
function Service.Apply(caster: Model,target: Model,now: number): boolean
 if not Damage.CanDamage(caster,target) or target:FindFirstChildOfClass("ForceField") then return false end
 local kind=target:GetAttribute("EntityKind")
 if kind~="Hero" and kind~="Minion" and kind~="Summon" then return false end
 local fighter=Fighters.GetOrCreate(target); if not fighter then return false end
 Fighters.Sleep(fighter,now)
 -- Five noncombat silhouettes: no humanoids, scripts, tags, collision or targeting.
 local folder=Instance.new("Model"); folder.Name="SleepCosmetics"
 local previous=caster.Archivable; caster.Archivable=true
 for i=1,5 do
  local copy=caster:Clone()
  for _,tag in game:GetService("CollectionService"):GetTags(copy) do game:GetService("CollectionService"):RemoveTag(copy,tag) end
  for name in copy:GetAttributes() do copy:SetAttribute(name,nil) end
  for _,item in copy:GetDescendants() do
   if item:IsA("LuaSourceContainer") or item:IsA("Humanoid") or item:IsA("Tool") then item:Destroy()
   elseif item:IsA("BasePart") then item.Anchored=true; item.CanCollide=false; item.CanTouch=false; item.CanQuery=false; item.Transparency=math.max(.5,item.Transparency) end
  end
  local angle=2*math.pi*i/5
  local point=fighter.root.Position+Vector3.new(math.cos(angle),0,math.sin(angle))*7.5
  copy:PivotTo(CFrame.lookAt(point,fighter.root.Position)); copy.Parent=folder
 end
 caster.Archivable=previous; folder.Parent=workspace; cosmetics[folder]=now+3
 return true
end
function Service.Update(now: number)
 for model,deadline in cosmetics do if now>=deadline then cosmetics[model]=nil; model:Destroy() end end
end
function Service.Reset()
 for model in cosmetics do model:Destroy() end; table.clear(cosmetics)
 for _,fighter in Fighters.GetAll() do Fighters.WakeSleep(fighter) end
end
Damage.Applied.Event:Connect(function(_attacker: Model,target: Model)
 local fighter=Fighters.Get(target); if fighter then Fighters.WakeSleep(fighter) end
end)
Damage.AttackAttempt.Event:Connect(function(_attacker: Model,target: Model)
 local fighter=Fighters.Get(target); if fighter then Fighters.WakeSleep(fighter) end
end)
return Service
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="114">
          <Properties>
            <string name="Name">NarutoSummonService</string>
            <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Definitions = require(Shared.Abilities.NarutoDefinitions)
local Units = require(Shared.Abilities.WorldUnits)
local Domain = require(Shared.Abilities.CloneState)
local Commands = require(Shared.Abilities.CloneCommands)
local Formulas = require(Shared.Abilities.NarutoRules).configure(Definitions)
local Combat = require(Shared.Config.CombatConfig)
local Fighters = require(script.Parent.FighterStateService)
local Damage = require(script.Parent.DamageService)
local Stats = require(script.Parent.CharacterStatsService)
local Targets = require(script.Parent.AbilityTargetService)
local Push = require(script.Parent.AbilityDisplacementService)
local Oil=require(script.Parent.OilStatusService)
local Navigation = require(script.Parent.CloneNavigation)
local Collision = require(script.Parent.SummonCollision)
export type Record = { model: Model, root: BasePart, humanoid: Humanoid, owner: Player, state: Domain.State,
	clone: Domain.Clone, commands: Commands.State, nextHit: number, attackDamage: number }
local Service = { Spawned = Instance.new("BindableEvent") }
local records: { [Model]: Record } = {}
local targetSerial = 0
local function targetId(model: Model): string
	local id = model:GetAttribute("AbilityEntityId")
	if typeof(id) == "string" then return id end
	targetSerial += 1; id = "entity-" .. tostring(targetSerial); model:SetAttribute("AbilityEntityId", id); return id :: string
end
function Service.EntityId(model: Model): string return targetId(model) end
function Service.GetAll(): { [Model]: Record } return records end
function Service.GetCount(): number local count = 0; for _ in records do count += 1 end; return count end
function Service.Remove(model: Model)
	local record = records[model]; if not record then return end
	Navigation.Remove(model); records[model] = nil; Domain.remove(record.state, record.clone); Fighters.Remove(model); model:Destroy()
end
function Service.ClearOwner(player: Player)
	for model, record in records do if record.owner == player then Service.Remove(model) end end
end
function Service.Reset() for model in records do Service.Remove(model) end end
function Service.Spawn(player: Player, character: Model, state: Domain.State, clone: Domain.Clone, commands: Commands.State): Model?
	local sourceRoot = character:FindFirstChild("HumanoidRootPart"); local sourceHumanoid = character:FindFirstChildOfClass("Humanoid")
	if not sourceRoot or not sourceRoot:IsA("BasePart") or not sourceHumanoid or sourceHumanoid.Health <= 0 then Domain.remove(state, clone); return nil end
	local previous = character.Archivable; character.Archivable = true
	local model = character:Clone(); character.Archivable = previous
	local humanoid = model:FindFirstChildOfClass("Humanoid") :: Humanoid
	humanoid.EvaluateStateMachine = false
	for _, item in model:GetDescendants() do
		if item:IsA("LuaSourceContainer") or item:IsA("Tool") or item:IsA("ForceField") then item:Destroy()
		elseif item:IsA("BasePart") then item.CanCollide = false; item.CanTouch = false; item.Massless = true end
	end
	model:SetAttribute("OilUntil",nil); model:SetAttribute("OilMoveMultiplier",nil); model:SetAttribute("OilMissAt",nil); game:GetService("CollectionService"):RemoveTag(model,"GamakichiOilStatus")
	for _,key in {"SagePhase","SageRank","SageReadyAt","SageExpiresAt","SageAuraUntil"} do model:SetAttribute(key,nil) end
 game:GetService("CollectionService"):RemoveTag(model,"NarutoSage")
 model:SetAttribute("SleepUntil",nil); model:SetAttribute("RasenganVariant",nil); model:SetAttribute("RasenganVariantUntil",nil)
 require(script.Parent.HeroAppearanceService).Apply(model)
 model.Name = "ShadowClone"; model:SetAttribute("EntityKind", "Summon"); model:SetAttribute("NativeNarutoClone", true)
	model:SetAttribute("SummonOwner", player.UserId); model:SetAttribute("CombatDisabled", false)
	model:SetAttribute("AbilityId", ""); model:SetAttribute("AbilityEntityId", nil); model:SetAttribute("LifeId", nil)
	model:SetAttribute("RasenganPhase", ""); model:SetAttribute("RasenganSelfPauseUntil", 0)
	model:SetAttribute("CombatState", "Idle"); model:SetAttribute("RasenganHeld", clone.hasPayload); model:SetAttribute("RasenganVisible", clone.hasPayload)
	model:SetAttribute("RasenganExpiresAt", clone.expiresAt)
	model:SetAttribute("OutgoingDamageMultiplier", clone.outgoingMultiplier); model:SetAttribute("IncomingDamageMultiplier", clone.incomingMultiplier)
	local root = model:FindFirstChild("HumanoidRootPart") :: BasePart
	-- Navigation owns movement. Collision groups also protect against copied-rig
	-- initialization restoring CanCollide after these explicit flags are set.
	-- Explicit prototype inheritance policy: copy current/max HP once, without .05 scaling.
	humanoid.WalkSpeed=Stats.Get(player).WalkSpeed; humanoid.MaxHealth = sourceHumanoid.MaxHealth; humanoid.Health = sourceHumanoid.Health
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None; humanoid.BreakJointsOnDeath = false
	root.Anchored = true; model.PrimaryPart = root
	local spacing = sourceRoot.Size.X * 2
	local offset = sourceRoot.CFrame.RightVector * ((clone.id % 3) - 1) * spacing + sourceRoot.CFrame.LookVector * -spacing
	local ray = RaycastParams.new(); ray.FilterType = Enum.RaycastFilterType.Exclude; ray.FilterDescendantsInstances = { character }; ray.RespectCanCollide = true
	local wall = workspace:Blockcast(sourceRoot.CFrame, sourceRoot.Size, offset, ray)
	if wall and offset.Magnitude > 0 then offset = offset.Unit * math.max(0, wall.Distance - 0.01) end
	local folder = workspace:FindFirstChild("HeroSummons")
	if not folder then folder = Instance.new("Folder"); folder.Name = "HeroSummons"; folder.Parent = workspace end
	Collision.Apply(model)
	model:PivotTo(character:GetPivot() + offset); model.Parent = folder
	local stats = Stats.Get(player)
	records[model] = { model = model, root = root, humanoid = humanoid, owner = player, state = state, clone = clone,
		commands = commands, nextHit = 0, attackDamage = Combat.Profiles.OrangeNinja.CloneDamage * stats.AttackDamageMultiplier + stats.AttackDamageBonus }
	Navigation.Register(model, root, humanoid)
	Fighters.GetOrCreate(model); Service.Spawned:Fire(model)
	return model
end
function Service.Update(now: number, delta: number, sourceStats: (Player) -> (number, number))
	for model, record in records do
		local clone, owner = record.clone, record.owner
		if not model.Parent or record.humanoid.Health <= 0 or owner.Parent ~= Players or now >= clone.expiresAt
			or record.state.clones[clone.id] ~= clone then Service.Remove(model); continue end
		model:SetAttribute("RasenganHeld", clone.hasPayload); model:SetAttribute("RasenganVisible", clone.hasPayload)
		local fighter = Fighters.Get(model)
		if fighter and (fighter.logic.mode == "Stunned" or (fighter.sleep and fighter.sleep.active)) then Navigation.Stop(model); continue end
		local intent = Commands.resolve(record.commands)
		local character = owner.Character
		if not character or not Damage.CanAct(character) or intent.mode == "Idle" or intent.mode == "Hold" then Navigation.Stop(model); continue end
		local target: Model? = nil
		if intent.targetId then
			for candidate in Fighters.GetAll() do
				if candidate:GetAttribute("AbilityEntityId") == intent.targetId then target = candidate; break end
			end
			if not target or not Damage.CanDamage(model, target) then Commands.invalidateTarget(record.commands, intent.targetId); target = nil end
		end
		local destination = if target then target:FindFirstChild("HumanoidRootPart") else character:FindFirstChild("HumanoidRootPart")
		if not destination or not destination:IsA("BasePart") then Navigation.Stop(model); continue end
		local distance = destination.Position - record.root.Position
		local flat = distance * Vector3.new(1, 0, 1)
		local stop = if target then Units.toStuds(50) + (record.root.Size.X + destination.Size.X) / 2 else record.root.Size.X * 3
		if flat.Magnitude > 0.001 then record.root.CFrame = CFrame.lookAt(record.root.Position, record.root.Position + flat) end
		if target and Damage.CanDamage(model, target) and distance.Magnitude <= stop + 0.01 and now >= record.nextHit and Targets.Visible(model, target, record.root.Position, destination.Position) then
			record.nextHit = now + 2 -- Hpal ua1c; M1 damage itself retains current prototype combat balance.
			model:SetAttribute("SummonSwingAt", now); model:SetAttribute("SummonSwingStep", 1)
			local humanoid = target:FindFirstChildOfClass("Humanoid")
			if humanoid then
				local payload = Domain.takePayload(record.state, clone, now, targetId(target), true, target:GetAttribute("EntityKind") ~= "Hero" and target:GetAttribute("EntityKind") ~= "Minion" and target:GetAttribute("EntityKind") ~= "Summon")
				if payload and Domain.claimPayload(record.state, payload) then
					local level, strength = sourceStats(owner)
					local raw = Formulas.clonePayloadDamage(level, strength)
					if raw then Damage.Apply(character, humanoid, raw) end
					local round, life = record.state.round, record.state.life
					Push.Begin(character, target, now, 0.5, 0.5, 12, 12, 0.01, function()
						return record.state.round == round and record.state.life == life and Damage.CanDamage(character, target :: Model)
					end)
				end
				Damage.ApplyAttack(model, humanoid, record.attackDamage)
			end
		end
		local moving = Navigation.Step(model, character, target or character, destination, stop, now, delta,
			Units.toStuds(Definitions.NativeInference.BaseSpeedWarcraft) * Oil.Movement(model, now))
		model:SetAttribute("SummonMoving", moving)
	end
end
return Service
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="115">
          <Properties>
            <string name="Name">OilStatusService</string>
            <string name="Source"><![CDATA[--!strict
local Shared=game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Rules=require(Shared.Abilities.GamakichiSpells)
local Fighters=require(script.Parent.FighterStateService)
local Teams=require(script.Parent.TeamService)
type Record={state: Rules.Debuff,round: number}
local records: {[Model]: Record}={}
local random=Random.new()
local Service={}
local function publish(model: Model,r: Record,now: number)
 local ends=Rules.untilAt(r.state,now)
 local tags=game:GetService("CollectionService")
 if ends>now then tags:AddTag(model,"GamakichiOilStatus") else tags:RemoveTag(model,"GamakichiOilStatus") end
 model:SetAttribute("OilUntil",if ends>now then ends else nil)
 model:SetAttribute("OilMoveMultiplier",if ends>now then 1-Rules.Oil.MoveReduction else nil)
 Fighters.SetWalkSpeed(model,Fighters.GetWalkSpeed(model))
end
function Service.Apply(model: Model,key: string,now: number)
 local match=Teams.GetState(); local round=if match then match.roundId else 0
 local r=records[model]
 if not r or r.round~=round then r={state=Rules.debuff(),round=round}; records[model]=r end
 Rules.apply(r.state,key,now); publish(model,r,now)
end
function Service.ClearSource(key: string)
 local now=workspace:GetServerTimeNow()
 for model,r in records do Rules.clear(r.state,key); publish(model,r,now) end
end
function Service.Movement(model: Model,now: number): number
 local r=records[model]; return if r then Rules.movement(r.state,now) else 1
end
function Service.MissesAttack(model: Model): boolean
 local r=records[model]; local now=workspace:GetServerTimeNow()
 local missed=r~=nil and Rules.misses(r.state,now,random:NextNumber())
 if missed then model:SetAttribute("OilMissAt",now) end
 return missed
end
function Service.Update(now: number)
 local match=Teams.GetState()
 for model,r in records do
  local hp=model:FindFirstChildOfClass("Humanoid")
  if not model.Parent or not hp or hp.Health<=0 or (match and (match.roundId~=r.round or match.phase~="InProgress")) then table.clear(r.state.grants) end
  if Rules.untilAt(r.state,now)==0 then publish(model,r,now); records[model]=nil end
 end
end
function Service.Reset()
 local now=workspace:GetServerTimeNow()
 for model,r in records do table.clear(r.state.grants); publish(model,r,now) end
 table.clear(records)
end
return Service
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="116">
          <Properties>
            <string name="Name">RasenshurikenMeleeService</string>
            <string name="Source"><![CDATA[--!strict
-- Bounded melee-only adapter. 0.04 cadence over 3.5s is an explicit scheduling policy.
local Shared=game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local V=require(Shared.Abilities.RasenganVariants)
local AreaRules=require(Shared.Abilities.RasenshurikenThrowRules)
local Structures=require(Shared.Game.StructureRules)
local Units=require(Shared.Abilities.WorldUnits)
local Fighters=require(script.Parent.FighterStateService)
local Damage=require(script.Parent.DamageService)
type Area={id:number,at:number,caster: Model,target: Model,nextAt: number,untilAt: number,tick: number,valid: ()->boolean,strength: ()->number}
local areas: {Area}={}
local serial=0
local Service={Visual=Instance.new("BindableEvent")}
function Service.Begin(caster: Model,target: Model,now: number,valid: ()->boolean,strength: ()->number,snapshot: number)
 if not valid() then return end
 local hp=caster:FindFirstChildOfClass("Humanoid")
 if hp then hp:TakeDamage(V.selfDamage(snapshot)) end
 if not valid() then return end
 serial-=1
 Service.Visual:Fire({kind="RasenshurikenArea",id=serial,startAt=now,source=target,position=target:GetPivot().Position,radius=Units.toStuds(300)})
 table.insert(areas,{id=serial,at=now,caster=caster,target=target,nextAt=now,untilAt=now+3.5,tick=0,valid=valid,strength=strength})
end
function Service.Update(now: number)
 for i=#areas,1,-1 do
  local area=areas[i]
  if not area.valid() or not area.target.Parent then Service.Visual:Fire({kind="RasenshurikenAreaEnd",id=area.id,position=Vector3.zero});table.remove(areas,i); continue end
  while area.nextAt<=now and area.nextAt<area.untilAt do
   local root=area.target:FindFirstChild("HumanoidRootPart"); if not root or not root:IsA("BasePart") then break end
   local center=root.Position
   local radius=Units.toStuds(AreaRules.radiusForTick(area.tick+1))
   for model,victim in Fighters.GetAll() do
    local offset=center-victim.root.Position
    if offset.Magnitude<=radius and not Structures.isStructure(model:GetAttribute("EntityKind")) and Damage.CanDamage(area.caster,model) then
     Damage.Apply(area.caster,victim.humanoid,AreaRules.pulse(area.strength()))
     local flat=offset*Vector3.new(1,0,1)
     if flat.Magnitude>.001 and not victim.root.Anchored then
      local step=flat.Unit*math.min(Units.toStuds(4),flat.Magnitude)
      local ray=RaycastParams.new(); ray.FilterType=Enum.RaycastFilterType.Exclude; ray.FilterDescendantsInstances={model,area.caster}; ray.RespectCanCollide=true
      if not workspace:Blockcast(victim.root.CFrame,victim.root.Size,step,ray) then victim.root.CFrame+=step end
     end
    end
   end
   area.tick+=1; area.nextAt=area.at+area.tick*AreaRules.Interval
  end
  if now>=area.untilAt then table.remove(areas,i) end
 end
end
function Service.Reset() table.clear(areas) end
return Service
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="117">
          <Properties>
            <string name="Name">RasenshurikenThrowService</string>
            <string name="Source"><![CDATA[--!strict
local Shared=game.ReplicatedStorage.Shared
local Rules=require(Shared.Abilities.RasenshurikenThrowRules)
local Units=require(Shared.Abilities.WorldUnits)
local Structures=require(Shared.Game.StructureRules)
local Damage=require(script.Parent.DamageService)
local Fighters=require(script.Parent.FighterStateService)
type Flight={id:number,source:Model,origin:Vector3,direction:Vector3,at:number,distance:number,strength:()->number,valid:()->boolean}
type Area={id:number,tick:number,source:Model,position:Vector3,at:number,nextAt:number,strength:()->number,valid:()->boolean}
local flights:{Flight}={};local areas:{Area}={};local serial=0
local S={Visual=Instance.new("BindableEvent")}
local function params(source:Model):RaycastParams
 local p=RaycastParams.new();p.FilterType=Enum.RaycastFilterType.Exclude;p.RespectCanCollide=true
 local excluded:{Instance}={source}
 for model in Fighters.GetAll() do table.insert(excluded,model) end
 p.FilterDescendantsInstances=excluded;return p
end
function S.Begin(source:Model,aim:Vector3,now:number,strength:()->number,valid:()->boolean):boolean
 local root=source:FindFirstChild("HumanoidRootPart")
 if not root or not root:IsA("BasePart") or not Rules.finite(aim.X) or not Rules.finite(aim.Y) or not Rules.finite(aim.Z) then return false end
 local origin=root.Position+Vector3.new(0,2,0);local delta=aim-origin
 if delta.Magnitude<.1 or #flights>=32 then return false end
 serial+=1
 local flight:Flight={id=serial,source=source,origin=origin,direction=delta.Unit,at=now+Rules.Windup,distance=0,strength=strength,valid=valid}
 table.insert(flights,flight)
 S.Visual:Fire({kind="RasenshurikenFlight",id=serial,source=source,position=origin,direction=flight.direction,releaseAt=flight.at,speed=Rules.Speed,range=Rules.Range})
 return true
end
function S.Update(now:number)
 for i=#flights,1,-1 do
  local f=flights[i]
  if not f.valid() then S.Visual:Fire({kind="RasenshurikenFlightEnd",id=f.id,position=f.origin});table.remove(flights,i);continue end
  if now<f.at then continue end
  local distance=math.min(Rules.Range,(now-f.at)*Rules.Speed)
  local from=f.origin+f.direction*f.distance;local travel=distance-f.distance
  if travel<=0 then continue end
  local ray=workspace:Spherecast(from,.8,f.direction*travel,params(f.source))
  local nearest=if ray then ray.Distance else travel+1
  local hit:Model?=nil
  for model,fighter in Fighters.GetAll() do
   if not Damage.CanDamage(f.source,model) then continue end
   local offset=fighter.root.Position-from;local along=math.clamp(offset:Dot(f.direction),0,travel)
   local radius=math.min(4,math.max(fighter.root.Size.X,fighter.root.Size.Y,fighter.root.Size.Z)*.5)+.8
   if (offset-f.direction*along).Magnitude<=radius and along<nearest then nearest=along;hit=model end
  end
  f.distance=distance
  if hit or ray or distance>=Rules.Range then
   local position=from+f.direction*math.min(travel,nearest)
   if hit then local fighter=Fighters.Get(hit);if fighter then Fighters.StunSpell(fighter,4.5) end end
   table.insert(areas,{id=f.id,tick=0,source=f.source,position=position,at=now+Rules.ImpactDelay,nextAt=now+Rules.ImpactDelay,strength=f.strength,valid=f.valid})
   S.Visual:Fire({kind="RasenshurikenDetonate",id=f.id,position=position,radius=Units.toStuds(Rules.Radius),startAt=now+Rules.ImpactDelay,duration=Rules.Duration})
   table.remove(flights,i)
  end
 end
 for i=#areas,1,-1 do
  local a=areas[i]
  if not a.valid() or now>=a.at+Rules.Duration then S.Visual:Fire({kind="RasenshurikenAreaEnd",id=a.id,position=a.position});table.remove(areas,i);continue end
  while a.nextAt<=now and a.nextAt<a.at+Rules.Duration do
   local radius=Units.toStuds(Rules.radiusForTick(a.tick+1))
   local rayParams=params(a.source)
   for model,fighter in Fighters.GetAll() do
    local delta=fighter.root.Position-a.position
    if delta.Magnitude<=radius and not Structures.isStructure(model:GetAttribute("EntityKind")) and Damage.CanDamage(a.source,model) and (delta.Magnitude<.01 or not workspace:Raycast(a.position,delta,rayParams)) then
     Damage.Apply(a.source,fighter.humanoid,Rules.pulse(a.strength()))
     local pull=-delta*Vector3.new(1,0,1)
     if pull.Magnitude>.001 and not fighter.root.Anchored then
      local step=pull.Unit*math.min(Units.toStuds(4),pull.Magnitude)
      if not workspace:Blockcast(fighter.root.CFrame,fighter.root.Size,step,rayParams) then fighter.root.CFrame+=step end
     end
    end
   end
   a.tick+=1;a.nextAt=a.at+a.tick*Rules.Interval
  end
 end
end
function S.Reset() table.clear(flights);table.clear(areas) end
return S
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="118">
          <Properties>
            <string name="Name">RequestLimiter</string>
            <string name="Source"><![CDATA[--!strict

-- Pure token bucket. Its instances live only on the server, one per player.
export type Bucket = {
	tokens: number,
	updatedAt: number,
	capacity: number,
	refillRate: number,
}

local RequestLimiter = {}

function RequestLimiter.new(capacity: number, refillRate: number, now: number): Bucket
	assert(capacity > 0 and refillRate > 0, "Rate limit must be positive")
	return { tokens = capacity, updatedAt = now, capacity = capacity, refillRate = refillRate }
end

function RequestLimiter.Consume(bucket: Bucket, now: number): boolean
	local elapsed = math.max(0, now - bucket.updatedAt)
	bucket.tokens = math.min(bucket.capacity, bucket.tokens + elapsed * bucket.refillRate)
	bucket.updatedAt = math.max(bucket.updatedAt, now)
	if bucket.tokens < 1 then
		return false
	end
	bucket.tokens -= 1
	return true
end

return RequestLimiter
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="119">
          <Properties>
            <string name="Name">RewardService</string>
            <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config.ProgressionConfig)
local Rules = require(Shared.Game.RewardRules)
local Life = require(script.Parent.CombatLifeService)
local Teams = require(script.Parent.TeamService)
local Progression = require(script.Parent.HeroProgressionService)
local Economy = require(script.Parent.EconomyService)
local Reward = {}
local started = false
local nextPassive = 0
-- Match scoreboard projection survives individual profile removal/reconnect.
local teamKills: { [string]: number } = {}
function Reward.GetTeamKills(id: string): number return teamKills[id] or 0 end
local awarded: { [Model]: number } = setmetatable({}, { __mode = "k" })
local function death(event: Life.Death)
 if awarded[event.model] == event.lifeId then return end
 awarded[event.model] = event.lifeId
 local state = Teams.GetState()
 if not state or event.roundId ~= state.roundId or state.phase ~= "InProgress" or not (Teams.IsActive(event.teamId) or Teams.IsNeutral(event.model)) then return end
 -- Elimination and match shutdown never turn into bounty events.
 if event.killer and not Teams.IsActive(event.killer.teamId) then event.killer = nil end
 local samples: { Rules.PlayerSample } = {}
 local recipients: { [number]: Player } = {}
 for _, player in Players:GetPlayers() do
  recipients[player.UserId] = player
  local model = player.Character
  local humanoid = if model then model:FindFirstChildOfClass("Humanoid") else nil
  local root = if model then model:FindFirstChild("HumanoidRootPart") else nil
  table.insert(samples, { userId = player.UserId, teamId = tostring(player:GetAttribute("TeamId") or ""),
   active = Economy.IsEligible(player), alive = humanoid ~= nil and humanoid.Health > 0,
   inRange = root ~= nil and root:IsA("BasePart") and (root.Position - event.position).Magnitude <= Config.XPRange })
 end
 local minion = (Config.MinionRewards :: { [string]: Rules.Reward })[event.minionType]
 local plan = Rules.plan(event, samples, minion, Config.HeroReward, Config.AssistReward, true)
 for id, grant in plan do
  local player = recipients[id]
  if grant.XP > 0 then Progression.AddXP(player, grant.XP) end
  if grant.Gold > 0 then Economy.AddGold(player, grant.Gold, if grant.Assists > 0 then "Assist" else "Kill") end
  if grant.Kills > 0 then
   Progression.Increment(player, "TotalKills")
   local teamId = tostring(player:GetAttribute("TeamId") or "")
   teamKills[teamId] = (teamKills[teamId] or 0) + grant.Kills
  end
  if grant.Deaths > 0 then Progression.Increment(player, "TotalDeaths") end
  if grant.MinionKills > 0 then Progression.Increment(player, "TotalMinionKills") end
  if grant.Assists > 0 then Progression.Increment(player, "Assists") end
 end
end
function Reward.Update(now: number)
 local state = Teams.GetState()
 if not state or state.phase ~= "InProgress" then nextPassive = 0; return end
 if nextPassive == 0 then nextPassive = state.startedAt + Config.PassiveInterval end
 if now < nextPassive then return end
 nextPassive = now + Config.PassiveInterval
 for _, player in Players:GetPlayers() do Economy.AddGold(player, Config.PassiveGold, "Passive") end
end
function Reward.Reset() nextPassive = 0; table.clear(awarded); table.clear(teamKills); Life.ResetHistory() end
function Reward.Start()
 if started then return end; started = true
 Life.Died.Event:Connect(death)
end
return Reward
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="120">
          <Properties>
            <string name="Name">StructureReset</string>
            <string name="Source"><![CDATA[--!strict
-- Capture only existing managed visuals. Unknown children are never deleted.
export type Snapshot = { restore: () -> () }
local Reset = {}
function Reset.capture(model: Model): Snapshot
	local actions: { () -> () } = {}
	for _, item in model:GetDescendants() do
		if model:GetAttribute("EntityKind") == "Tower" and item:GetAttribute("StructureCosmetic") == nil
			and (not item:IsA("PointLight") or not item.Parent or item.Parent:GetAttribute("StructureCosmetic") == nil) then continue end
		if item:IsA("BasePart") then
			local color, material, transparency = item.Color, item.Material, item.Transparency
			local collide, query, touch = item.CanCollide, item.CanQuery, item.CanTouch
			local frame, size = item.CFrame, item.Size
			table.insert(actions, function()
				if not item:IsDescendantOf(model) then return end
				item.Color = color; item.Material = material; item.Transparency = transparency
				item.CanCollide = collide; item.CanQuery = query; item.CanTouch = touch
				item.CFrame = frame; item.Size = size
			end)
		elseif item:IsA("PointLight") then
			local enabled, brightness = item.Enabled, item.Brightness
			table.insert(actions, function() if item:IsDescendantOf(model) then item.Enabled = enabled; item.Brightness = brightness end end)
		end
	end
	return { restore = function() for _, action in actions do action() end end }
end
function Reset.humanoid(model: Model, health: number): Humanoid
	local old = model:FindFirstChildOfClass("Humanoid")
	if old then old:Destroy() end
	local humanoid = Instance.new("Humanoid")
	-- Dead humanoids cannot be revived by assigning Health. Use a fresh one.
	humanoid.BreakJointsOnDeath = false; humanoid.RequiresNeck = false
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	humanoid.MaxHealth = health; humanoid.Health = health; humanoid.Parent = model
	return humanoid
end
return Reset
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="121">
          <Properties>
            <string name="Name">StructureService</string>
            <string name="Source"><![CDATA[--!strict
-- Registry and protection only: no dependencies on damage, combat, or tower scheduling.
local Rules = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared").Game.StructureRules)
export type Structure = { model: Model, humanoid: Humanoid, root: BasePart, teamId: string, lane: string, kind: string }
local Service = {}
local records: { [Model]: Structure } = {}
function Service.Register(model: Model): Structure
	if records[model] then return records[model] end
	local humanoid = model:FindFirstChildOfClass("Humanoid"); local root = model:FindFirstChild("HumanoidRootPart")
	assert(humanoid and root and root:IsA("BasePart") and Rules.isStructure(model:GetAttribute("EntityKind")), "Invalid structure")
	local record: Structure = { model = model, humanoid = humanoid, root = root, teamId = tostring(model:GetAttribute("TeamId")),
		lane = tostring(model:GetAttribute("Lane") or ""), kind = tostring(model:GetAttribute("EntityKind")) }
	records[model] = record; return record
end
function Service.GetAll(): { [Model]: Structure } return records end
function Service.Alive(record: Structure): boolean
	return record.model:IsDescendantOf(workspace) and record.root:IsDescendantOf(record.model)
		and record.humanoid.Parent == record.model and record.humanoid.Health > 0 and record.model:GetAttribute("IsDestroyed") ~= true
end
function Service.Remaining(teamId: string): number
	local count = 0
	for _, record in records do if record.kind == "Tower" and record.teamId == teamId and Service.Alive(record) then count += 1 end end
	return count
end
function Service.CanReceive(model: Model): boolean
	if model:GetAttribute("EntityKind") ~= "Base" then return true end
	return Rules.canReceive(model:GetAttribute("EntityKind"), Service.Remaining(tostring(model:GetAttribute("TeamId"))))
end
function Service.Remove(model: Model) records[model] = nil end
return Service
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="122">
          <Properties>
            <string name="Name">SummonCollision</string>
            <string name="Source"><![CDATA[--!strict
-- Humanoid initialization may restore CanCollide on copied rig parts. Collision
-- groups are the authoritative nonblocking guarantee, independent of that flag.
local Physics = game:GetService("PhysicsService")
local Collision = {}
local ready = false
function Collision.Apply(model: Model)
	if not ready then
		for _, name in { "SurvivalHeroes", "SurvivalMinions", "SurvivalSummons" } do
			if not Physics:IsCollisionGroupRegistered(name) then Physics:RegisterCollisionGroup(name) end
		end
		for _, name in { "SurvivalHeroes", "SurvivalMinions", "SurvivalSummons" } do
			Physics:CollisionGroupSetCollidable("SurvivalSummons", name, false)
		end
		-- Keep Default collidable: navigation's world raycasts still see terrain.
		ready = true
	end
	for _, item in model:GetDescendants() do
		if item:IsA("BasePart") then
			item.CollisionGroup = "SurvivalSummons"
			item.CanCollide = false; item.CanTouch = false
		end
	end
end
return Collision
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="123">
          <Properties>
            <string name="Name">TeamService</string>
            <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local Teams = game:GetService("Teams")
local Physics = game:GetService("PhysicsService")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config.GameModeConfig)
local Rules = require(Shared.Game.MatchState)
local Roster = require(Shared.Game.MatchRoster)
local TeamService = {}
local neutral: { [Model]: boolean } = setmetatable({}, { __mode = "k" })
function TeamService.RegisterNeutral(model: Model) neutral[model] = true end
function TeamService.RemoveNeutral(model: Model) neutral[model] = nil end
function TeamService.IsNeutral(model: Model): boolean return neutral[model] == true end
local JungleRules = require(Shared.Game.JungleRules)
local state: Rules.State? = nil
local map: Folder? = nil
local teams: { [string]: Team } = {}
local roster: Roster.State? = nil
local connections: { [Player]: { RBXScriptConnection } } = {}
local deaths: { [Player]: RBXScriptConnection } = {}
local descendants: { [Player]: RBXScriptConnection } = {}
local pending: { [Player]: number } = {}
local loading: { [Player]: number } = {}
local resetRound = 1
function TeamService.GetId(model: Model): string?
	local player = Players:GetPlayerFromCharacter(model)
	local id = if player then player:GetAttribute("TeamId") else model:GetAttribute("TeamId")
	return if typeof(id) == "string" then id else nil
end
function TeamService.IsActive(id: string?): boolean
	local current = state
	return current ~= nil and id ~= nil and current.teams[id] ~= nil and current.teams[id].active
end
function TeamService.IsEnemy(first: Model, second: Model): boolean
	local current = state
	if not current then return first ~= second end -- Isolated M1 regression scene.
	if neutral[first] or neutral[second] then
		return JungleRules.hostile(neutral[first] == true, neutral[second] == true, TeamService.IsActive(TeamService.GetId(first)), TeamService.IsActive(TeamService.GetId(second)))
	end
	return Rules.enemy(current, TeamService.GetId(first), TeamService.GetId(second))
end
function TeamService.GetActiveTeams(): { string }
	return if state then Rules.active(state) else {}
end
function TeamService.GetState(): Rules.State? return state end
function TeamService.IsParticipant(player: Player): boolean
	local current, members = state, roster
	return current ~= nil and members ~= nil and Roster.teamOf(members, player.UserId) ~= nil
		and player.Parent == Players and player:GetAttribute("Spectating") ~= true
end
function TeamService.Count(): number
	return if roster then Roster.connectedCount(roster) else 0
end
function TeamService.Ready(minimumPerTeam: number): boolean
	return roster ~= nil and Roster.ready(roster, minimumPerTeam)
end
function TeamService.LockRoster()
	if roster then Roster.lock(roster) end
end
local function syncCounts()
	local current, members = state, roster
	if not current or not members then return end
	local counts = Roster.counts(members)
	for id, team in current.teams do team.count = counts[id] or 0 end
end
local function invalidateCharacter(player: Player)
	pending[player] = nil
	local character = player.Character
	if character then
		character:SetAttribute("CombatDisabled", true)
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if humanoid then humanoid.Health = 0 end
	end
end
local function canSpawn(player: Player): boolean
	local current = state
	local id = player:GetAttribute("TeamId")
	return player.Parent == Players and current ~= nil and current.phase ~= "Finished"
		and TeamService.IsParticipant(player) and typeof(id) == "string" and TeamService.IsActive(id)
end
local function characterAdded(player: Player, character: Model)
	local current = state; if not current then return end
	local epoch = loading[player] or current.roundId
	character:SetAttribute("RoundId", epoch)
	if deaths[player] then deaths[player]:Disconnect(); deaths[player] = nil end
	if descendants[player] then descendants[player]:Disconnect() end
	local function collision(item: Instance)
		if item:IsA("BasePart") and item.CollisionGroup == "Default" then item.CollisionGroup = "SurvivalHeroes" end
	end
	for _, item in character:GetDescendants() do collision(item) end
	descendants[player] = character.DescendantAdded:Connect(collision)
	local id = player:GetAttribute("TeamId")
	character:SetAttribute("TeamId", id); character:SetAttribute("EntityKind", "Hero")
	task.spawn(function()
		local humanoid = character:WaitForChild("Humanoid", 10)
		local root = character:WaitForChild("HumanoidRootPart", 10)
		if player.Character ~= character or player.Parent ~= Players then return end
		if not humanoid or not humanoid:IsA("Humanoid") or not root or not root:IsA("BasePart") then return end
		if epoch ~= current.roundId or not canSpawn(player) then invalidateCharacter(player); return end
		local respawn = player.RespawnLocation
		if respawn then character:PivotTo(respawn.CFrame + Vector3.new(0, 4, 0)) end
		character:SetAttribute("CombatDisabled", false)
		deaths[player] = humanoid.Died:Connect(function()
			if epoch == current.roundId and player.Character == character and canSpawn(player) then pending[player] = workspace:GetServerTimeNow() + Config.RespawnTime end
		end)
	end)
end
local function add(player: Player)
	local current, arena = state, map
	assert(current and arena)
	player:SetAttribute("RoundId", current.roundId)
	local members = roster; assert(members)
	local id: string? = if current.phase ~= "Finished" then Roster.join(members, player.UserId) else nil
	local eliminated = id ~= nil and not TeamService.IsActive(id)
	if eliminated then id = nil end
	syncCounts()
	player.Neutral = true
	if id then
		player:SetAttribute("Spectating", false)
		player.Team = teams[id]; player.Neutral = false
		player:SetAttribute("TeamId", id); player:SetAttribute("Eliminated", false)
		local points = arena:FindFirstChild("SpawnPoints"); assert(points)
		local teamPoints = points:FindFirstChild(id); assert(teamPoints)
		local spawn = teamPoints:FindFirstChild("Hero")
		assert(spawn and spawn:IsA("SpawnLocation"), "Hero spawn missing for " .. id)
		player.RespawnLocation = spawn
		pending[player] = workspace:GetServerTimeNow()
	else
		-- Roblox permits clearing these object references; the API definitions omit nil.
		player.Team = nil :: any; player.RespawnLocation = nil :: any
		player:SetAttribute("TeamId", nil)
		player:SetAttribute("Spectating", true)
		player:SetAttribute("Eliminated", eliminated)
		invalidateCharacter(player)
	end
	if not connections[player] then connections[player] = {
		player.CharacterAdded:Connect(function(character) characterAdded(player, character) end),
		player.CharacterRemoving:Connect(function()
			if deaths[player] then deaths[player]:Disconnect(); deaths[player] = nil end
			if descendants[player] then descendants[player]:Disconnect(); descendants[player] = nil end
		end),
	} end
	if player.Character then characterAdded(player, player.Character) end
end
function TeamService.Eliminate(id: string)
	for _, player in Players:GetPlayers() do
		if player:GetAttribute("TeamId") == id then
			player:SetAttribute("Eliminated", true); invalidateCharacter(player)
		end
	end
end
function TeamService.Finish()
	table.clear(pending)
	for _, player in Players:GetPlayers() do
		local character = player.Character
		if character then
			character:SetAttribute("CombatDisabled", true)
			local humanoid = character:FindFirstChildOfClass("Humanoid")
			if humanoid then humanoid:Move(Vector3.zero); humanoid.WalkSpeed = 0; humanoid.JumpPower = 0; humanoid.JumpHeight = 0 end
		end
	end
end
function TeamService.Update(now: number)
	local current = state; if not current then return end
	-- Fill vacated lobby slots deterministically. A locked round accepts only its
	-- original members on reconnect; new arrivals spectate for the remainder of this match.
	if current.phase == "WaitingForPlayers" or current.phase == "Preparing" then
		local waiting = Players:GetPlayers()
		table.sort(waiting, function(a: Player, b: Player) return a.UserId < b.UserId end)
		for _, player in waiting do
			if TeamService.Count() >= #current.order * Config.TeamCapacity then break end
			if player:GetAttribute("Spectating") == true then add(player) end
		end
	end
	for player, due in pending do
		if now >= due and not loading[player] then
			pending[player] = nil
			if not canSpawn(player) then continue end
			local epoch = current.roundId
			loading[player] = epoch
			task.spawn(function()
				local ok, message = pcall(function() player:LoadCharacterAsync() end)
				loading[player] = nil
				if not ok then warn("[Teams] Character load failed: " .. tostring(message)) end
				if epoch ~= current.roundId then
					local model = player.Character
					if model and model:GetAttribute("RoundId") == epoch then model:Destroy(); player.Character = nil end
					if canSpawn(player) then pending[player] = workspace:GetServerTimeNow() end
				elseif not canSpawn(player) then invalidateCharacter(player)
				elseif not ok then pending[player] = workspace:GetServerTimeNow() + 2 end
			end)
		end
	end
end
function TeamService.Start(match: Rules.State, arena: Folder)
	if state then return end; state = match; map = arena; resetRound = match.roundId
	roster = Roster.new(match.order, Config.TeamCapacity)
	Players.CharacterAutoLoads = false
	for _, name in { "SurvivalHeroes", "SurvivalMinions" } do
		if not Physics:IsCollisionGroupRegistered(name) then Physics:RegisterCollisionGroup(name) end
	end
	-- Lane units body-block heroes; summons keep their separate nonblocking group.
	Physics:CollisionGroupSetCollidable("SurvivalHeroes", "SurvivalMinions", true)
	for _, definition in Config.Teams do
		local existing = Teams:FindFirstChild(definition.Id)
		assert(not existing or existing:IsA("Team"), "Team name occupied")
		local team = (existing or Instance.new("Team")) :: Team
		team.Name = definition.Id; team.TeamColor = BrickColor.new(definition.Color); team.AutoAssignable = false
		team.Parent = Teams; teams[definition.Id] = team
	end
	Players.PlayerAdded:Connect(add)
	Players.PlayerRemoving:Connect(function(player)
		local wasAssigned = roster ~= nil and Roster.teamOf(roster, player.UserId) ~= nil
		if roster then Roster.leave(roster, player.UserId) end
		if wasAssigned and match.phase == "Preparing" then
			match.phase = "WaitingForPlayers"; match.preparationEnds = 0
		end
		syncCounts()
		pending[player] = nil
		if deaths[player] then deaths[player]:Disconnect(); deaths[player] = nil end
		if descendants[player] then descendants[player]:Disconnect(); descendants[player] = nil end
		for _, connection in connections[player] or {} do connection:Disconnect() end
		connections[player] = nil
	end)
	for _, player in Players:GetPlayers() do add(player) end
end
function TeamService.Reset(roundId: number)
	local current = state; assert(current and current.roundId == roundId)
	if roundId <= resetRound then return end; resetRound = roundId
	table.clear(pending); roster = Roster.new(current.order, Config.TeamCapacity)
	for _, team in current.teams do team.count = 0 end
	local players = Players:GetPlayers()
	table.sort(players, function(a: Player, b: Player) return a.UserId < b.UserId end)
	for _, player in players do
		if deaths[player] then deaths[player]:Disconnect(); deaths[player] = nil end
		if descendants[player] then descendants[player]:Disconnect(); descendants[player] = nil end
		local character = player.Character
		if character then character:SetAttribute("CombatDisabled", true); character:Destroy(); player.Character = nil end
		player:SetAttribute("RoundId", roundId)
		add(player)
	end
end
return TeamService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="124">
          <Properties>
            <string name="Name">TowerFactory</string>
            <string name="Source"><![CDATA[--!strict
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config.TowerConfig)
local Map = require(Shared.Config.MapConfig)
local Mode = require(Shared.Config.GameModeConfig)
local Factory = {}
function Factory.Build(map: Folder): Folder
	local existing = map:FindFirstChild("Towers")
	assert(not existing or existing:IsA("Folder"), "Map.Towers must be a Folder")
	local container = existing or Instance.new("Folder"); container.Name = "Towers"; container.Parent = map
	local layouts = Config.Positions :: { [string]: { [string]: { number } } }
	for _, team in Mode.Teams do for _, lane in Map.LaneOrder do
		local name = team.Id .. "_" .. lane
		local previous = container:FindFirstChild(name)
		if previous then
			assert(previous:IsA("Model") and previous:GetAttribute("ManagedTower") == true, "Unknown object occupies tower slot " .. name)
			continue
		end
		local coordinates = layouts[team.Id] and layouts[team.Id][lane]; assert(coordinates, "Tower layout missing: " .. name)
		local origin = Map.Origin + Vector3.new(coordinates[1], coordinates[2], coordinates[3])
		local model = Instance.new("Model"); model.Name = name
		model:SetAttribute("ManagedTower", true); model:SetAttribute("EntityKind", "Tower"); model:SetAttribute("TeamId", team.Id)
		model:SetAttribute("Lane", lane); model:SetAttribute("IsDestroyed", false); model:SetAttribute("TowerState", "Idle")
		local function part(partName: string, size: Vector3, offset: Vector3, color: Color3, hurtbox: boolean): Part
			local item = Instance.new("Part"); item.Name = partName; item.Size = size; item.Position = origin + offset
			item.Anchored = true; item.CanCollide = hurtbox; item.CanQuery = hurtbox; item.CanTouch = false
			item:SetAttribute("StructureCosmetic", not hurtbox); item.Color = color; item.Material = Enum.Material.Metal
			item.TopSurface = Enum.SurfaceType.Smooth; item.BottomSurface = Enum.SurfaceType.Smooth; item.Parent = model; return item
		end
		local root = part("HumanoidRootPart", Vector3.new(5, 6, 5), Vector3.zero, Color3.fromRGB(55, 64, 78), true)
		model.PrimaryPart = root
		part("Plinth", Vector3.new(8, 1, 8), Vector3.new(0, -2.5, 0), Color3.fromRGB(36, 43, 54), false)
		part("Capital", Vector3.new(7, 1, 7), Vector3.new(0, 3.5, 0), team.Color, false)
		for _, side in { -1, 1 } do
			part("TeamStripe", Vector3.new(0.22, 4, 2), Vector3.new(side * 2.6, 0, 0), team.Color, false).Material = Enum.Material.Neon
			part("Fin", Vector3.new(0.6, 4, 0.6), Vector3.new(side * 2.5, 5, 0), team.Color, false)
		end
		local crystal = part("Crystal", Vector3.new(2.6, 2.6, 2.6), Vector3.new(0, 6.3, 0), team.Color, false)
		crystal.Material = Enum.Material.Neon; crystal.CFrame *= CFrame.Angles(0, math.pi / 4, math.pi / 4)
		local light = Instance.new("PointLight"); light.Color = team.Color; light.Brightness = 0.8; light.Range = 12; light.Parent = crystal
		local humanoid = Instance.new("Humanoid"); humanoid.RequiresNeck = false; humanoid.BreakJointsOnDeath = false
		humanoid.MaxHealth = Config.Health; humanoid.Health = Config.Health; humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		humanoid.Parent = model; model.Parent = container
	end end
	return container :: Folder
end
return Factory
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="125">
          <Properties>
            <string name="Name">TowerRewardService</string>
            <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Rules = require(Shared.Game.TowerRules)
local Config = require(Shared.Config.TowerConfig)
local Economy = require(script.Parent.EconomyService)
local Teams = require(script.Parent.TeamService)
local Structures = require(script.Parent.StructureService)
local Reward = {}
local ledger: { [Model]: Rules.State } = setmetatable({}, { __mode = "k" })
local ledgerRound = 0
-- Called synchronously after confirmed damage, before a same-frame core kill can finish the match.
function Reward.Confirmed(attacker: Model, target: Model)
	local record = Structures.GetAll()[target]
	if not record or record.kind ~= "Tower" or record.humanoid.Health > 0 then return end
	local attackingTeam = tostring(attacker:GetAttribute("TeamId"))
	local match = Teams.GetState()
	if not match or match.phase ~= "InProgress" or attacker:GetAttribute("RoundId") ~= match.roundId
		or target:GetAttribute("RoundId") ~= match.roundId or not Teams.IsActive(attackingTeam) then return end
	if ledgerRound ~= match.roundId then table.clear(ledger); ledgerRound = match.roundId end
	local state = ledger[target]
	if not state then state = Rules.new(); Rules.destroy(state); ledger[target] = state end
	if not Rules.claimReward(state, attackingTeam ~= record.teamId) then return end
	for _, player in Players:GetPlayers() do
		if Rules.recipient(attackingTeam, tostring(player:GetAttribute("TeamId")), player.Parent == Players,
			Economy.IsEligible(player), player:GetAttribute("Eliminated") == true) then
			Economy.AddGold(player, Config.TeamGold, "TowerDestroyed")
		end
	end
end
return Reward
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="126">
          <Properties>
            <string name="Name">TowerService</string>
            <string name="Source"><![CDATA[--!strict
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Players = game:GetService("Players")
local Config = require(Shared.Config.TowerConfig)
local Rules = require(Shared.Game.TowerRules)
local Structures = require(script.Parent.StructureService)
local Fighters = require(script.Parent.FighterStateService)
local Damage = require(script.Parent.DamageService)
local Teams = require(script.Parent.TeamService)
local Factory = require(script.Parent.TowerFactory)
local Hitboxes = require(script.Parent.HitboxService)
local Reset = require(script.Parent.StructureReset)
export type Tower = { structure: Structures.Structure, logic: Rules.State, crystal: BasePart,
	label: TextLabel, fill: Frame, connections: { RBXScriptConnection } }
local Service = { Event = Instance.new("BindableEvent") }
local records: { [Model]: Tower } = {}
local ids: { [Model]: number } = setmetatable({}, { __mode = "k" })
local models: { [number]: Model } = setmetatable({}, { __mode = "v" })
local serial = 0
local started = false
local currentRound = 0
local arena: Folder? = nil
local visuals: { [Model]: Reset.Snapshot } = {}
local function idFor(model: Model): number
	if ids[model] then return ids[model] end
	serial += 1; ids[model] = serial; models[serial] = model; return serial
end
function Service.GetAll(): { [Model]: Tower } return records end
local function mode(tower: Tower, value: string)
	tower.structure.model:SetAttribute("TowerState", value)
	tower.structure.model:SetAttribute("ChargeEndsAt", if tower.logic.shot then tower.logic.contactAt else 0)
end
local function health(tower: Tower)
	local record = tower.structure
	record.model:SetAttribute("CurrentHealth", record.humanoid.Health)
	record.model:SetAttribute("MaxHealth", record.humanoid.MaxHealth)
	tower.label.Text = string.format("%s • %s\n%d / %d", record.teamId, record.lane, math.ceil(record.humanoid.Health), record.humanoid.MaxHealth)
	tower.fill.Size = UDim2.fromScale(math.clamp(record.humanoid.Health / record.humanoid.MaxHealth, 0, 1), 1)
end
local function destroy(tower: Tower)
	if not Rules.destroy(tower.logic) then return end
	local record = tower.structure
	record.model:SetAttribute("IsDestroyed", true); mode(tower, "Destroyed")
	for _, item in record.model:GetDescendants() do
		if item:IsA("BasePart") and item:GetAttribute("StructureCosmetic") ~= nil then
			item.CanCollide = false; item.CanQuery = false; item.CanTouch = false
			item.Transparency = if item.Name == "Plinth" then 0 else 1
			item.Material = Enum.Material.Slate; item.Color = Color3.fromRGB(47, 50, 58)
		elseif item:IsA("PointLight") and item.Parent and item.Parent:GetAttribute("StructureCosmetic") ~= nil then item.Enabled = false end
	end
	tower.label.Text = record.teamId .. " • " .. record.lane .. "\nБАШНЯ РАЗРУШЕНА"; tower.fill.Size = UDim2.fromScale(0, 1)
	Service.Event:Fire("Destroyed", record.model, tower.crystal.Position, tower.crystal.Position, record.teamId, record.lane, currentRound)
end
local function valid(tower: Tower, model: Model): boolean
	local kind = tostring(model:GetAttribute("EntityKind"))
	if not (Config.TargetPriority :: { [string]: number })[kind] or (kind == "Summon" and not Config.AllowSummons) then return false end
	if kind == "Hero" then
		local player = Players:GetPlayerFromCharacter(model)
		if not player or player.Parent ~= Players or player:GetAttribute("Eliminated") == true then return false end
	end
	local root = model:FindFirstChild("HumanoidRootPart")
	if not root or not root:IsA("BasePart") or not Damage.CanDamage(tower.structure.model, model) then return false end
	if not Hitboxes.IsFiniteCFrame(root.CFrame) or not Hitboxes.IsFiniteCFrame(tower.structure.root.CFrame) then return false end
	if (root.Position - tower.structure.root.Position).Magnitude > Config.Range then return false end
	local excluded: { Instance } = { tower.structure.model, model }
	for actor in Fighters.GetAll() do table.insert(excluded, actor) end
	local summons = workspace:FindFirstChild("HeroSummons"); if summons then table.insert(excluded, summons) end
	local ray = RaycastParams.new(); ray.FilterType = Enum.RaycastFilterType.Exclude; ray.FilterDescendantsInstances = excluded; ray.RespectCanCollide = true
	-- Use the combat center for LOS so a short solid wall cannot be bypassed by the decorative crystal's height.
	return workspace:Raycast(tower.structure.root.Position, root.Position - tower.structure.root.Position, ray) == nil
end
function Service.CancelAll()
	for _, tower in records do
		Rules.cancel(tower.logic)
		if not tower.logic.destroyed then mode(tower, "Idle") end
	end
end
function Service.Update(now: number)
	local match = Teams.GetState()
	if not match or match.phase ~= "InProgress" then Service.CancelAll(); return end
	for model, tower in records do
		if not model:IsDescendantOf(workspace) or tower.structure.humanoid.Parent ~= model or not tower.structure.root:IsDescendantOf(model) then
			Rules.destroy(tower.logic); Structures.Remove(model)
			for _, connection in tower.connections do connection:Disconnect() end
			records[model] = nil; visuals[model] = nil; continue
		end
		if tower.structure.humanoid.Health <= 0 then destroy(tower) end
		if tower.logic.destroyed then continue end
		if not Damage.CanAct(model) then Rules.cancel(tower.logic); mode(tower, "Idle"); continue end
		local pending = tower.logic.shot
		if pending then
			local target = models[pending]
			local confirmed = Rules.contact(tower.logic, now, target ~= nil and valid(tower, target), true)
			if confirmed and target then
				local humanoid = target:FindFirstChildOfClass("Humanoid")
				local root = target:FindFirstChild("HumanoidRootPart")
				mode(tower, "Attacking"); model:SetAttribute("LastShotAt", now)
				if humanoid and root and root:IsA("BasePart") then
					local position = root.Position
					Damage.Apply(model, humanoid, Config.Damage)
					Service.Event:Fire("Shot", model, tower.crystal.Position, position, tower.structure.teamId, tower.structure.lane, currentRound)
				end
			elseif not tower.logic.shot then mode(tower, "Idle") end
			continue
		end
		local samples: { Rules.Candidate } = {}
		for actor, fighter in Fighters.GetAll() do
			table.insert(samples, { id = idFor(actor), kind = tostring(actor:GetAttribute("EntityKind")),
				distance = (fighter.root.Position - tower.structure.root.Position).Magnitude, valid = valid(tower, actor) })
		end
		local target = Rules.choose(tower.logic, samples, now, Config.TargetPriority, Config.AllowSummons)
		tower.logic.target = target
		if target and Rules.begin(tower.logic, target, now, Config.Windup, Config.AttackInterval) then mode(tower, "Charging")
		elseif now >= ((model:GetAttribute("LastShotAt") or 0) :: number) + Config.Visual.ProjectileDuration then mode(tower, "Idle") end
	end
end
local function bindHealth(tower: Tower)
	local record, epoch = tower.structure, currentRound
	table.insert(tower.connections, record.humanoid.HealthChanged:Connect(function()
		if currentRound ~= epoch or tower.structure ~= record then return end
		health(tower); if record.humanoid.Health <= 0 then destroy(tower) end
	end))
end
local function register(model: Model)
	visuals[model] = Reset.capture(model); model:SetAttribute("RoundId", currentRound)
	local record = Structures.Register(model)
	local crystal = model:FindFirstChild("Crystal"); assert(crystal and crystal:IsA("BasePart"))
	local board = Instance.new("BillboardGui"); board.Name = "TowerHealth"; board.Size = UDim2.fromOffset(170, 54)
	board.StudsOffset = Vector3.new(0, 10, 0); board.MaxDistance = 170; board.AlwaysOnTop = true; board.Parent = record.root
	local label = Instance.new("TextLabel"); label.Size = UDim2.new(1, 0, 1, -8); label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBold; label.TextSize = 14; label.TextColor3 = Color3.new(1, 1, 1); label.TextStrokeTransparency = 0.25; label.Parent = board
	local track = Instance.new("Frame"); track.Size = UDim2.new(1, 0, 0, 5); track.Position = UDim2.new(0, 0, 1, -5)
	track.BackgroundColor3 = Color3.fromRGB(25, 28, 35); track.BorderSizePixel = 0; track.Parent = board
	local fill = Instance.new("Frame"); fill.BackgroundColor3 = crystal.Color; fill.BorderSizePixel = 0; fill.Parent = track
	local tower: Tower = { structure = record, logic = Rules.new(), crystal = crystal, label = label, fill = fill, connections = {} }
	records[model] = tower; health(tower)
	bindHealth(tower)
end
function Service.Reset(roundId: number)
	if roundId <= currentRound then return end
	Service.CancelAll(); currentRound = roundId
	table.clear(ids); table.clear(models); serial = 0
	for model, tower in records do
		for _, connection in tower.connections do connection:Disconnect() end; table.clear(tower.connections)
		visuals[model].restore(); Structures.Remove(model)
		Reset.humanoid(model, Config.Health)
		model:SetAttribute("RoundId", roundId); model:SetAttribute("IsDestroyed", false)
		model:SetAttribute("LastShotAt", 0); model:SetAttribute("CombatDisabled", false)
		tower.structure = Structures.Register(model); tower.logic = Rules.new()
		mode(tower, "Idle"); health(tower); bindHealth(tower)
	end
	local map = arena; assert(map)
	for _, model in Factory.Build(map):GetChildren() do
		if model:IsA("Model") and model:GetAttribute("ManagedTower") == true and not records[model] then register(model) end
	end
end
function Service.Start(map: Folder)
	if started then return end; started = true
	arena = map
	local match = Teams.GetState(); currentRound = if match then match.roundId else 1
	local container = Factory.Build(map)
	for _, model in container:GetChildren() do
		if not model:IsA("Model") or model:GetAttribute("ManagedTower") ~= true then continue end
		register(model)
	end
	Damage.Applied.Event:Connect(function(attacker: Model, victim: Model, amount: number, roundId: number?)
		if amount <= 0 or roundId ~= currentRound then return end
		local killed = records[victim]
		if killed and killed.structure.humanoid.Health <= 0 then
			destroy(killed)
		end
		if attacker:GetAttribute("EntityKind") ~= "Hero" or victim:GetAttribute("EntityKind") ~= "Hero" then return end
		local victimRoot = victim:FindFirstChild("HumanoidRootPart"); if not victimRoot or not victimRoot:IsA("BasePart") then return end
		local now = workspace:GetServerTimeNow()
		for _, tower in records do
			if victim:GetAttribute("TeamId") == tower.structure.teamId and (victimRoot.Position - tower.structure.root.Position).Magnitude <= Config.Range
				and valid(tower, attacker) then Rules.aggress(tower.logic, idFor(attacker), now, Config.AggroDuration, true) end
		end
	end)
end
return Service
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="127">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <token name="GameSettingsAvatar">1</token>
      <bool name="LoadCharacterAppearance">false</bool>
    </Properties>
    <Item class="StarterPlayerScripts" referent="128">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="129">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="Folder" referent="130">
          <Properties>
            <string name="Name">Controllers</string>
          </Properties>
          <Item class="ModuleScript" referent="131">
            <Properties>
              <string name="Name">AbilityController</string>
              <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Input = game:GetService("UserInputService")
local Actions = game:GetService("ContextActionService")
local Gui = game:GetService("GuiService")
local RunService = game:GetService("RunService")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config.AbilityConfig)
local VFX = require(script.Parent.AbilityVFXController)
local Rounds = require(script.Parent.RoundController)
local Learning = require(script.Parent.LearningController)
local InputRules = require(Shared.Abilities.AbilityInputRules)
local Gama=require(Shared.Abilities.GamakichiState)
local Targeting=require(script.Parent.AbilityTargeting)
local Feedback=require(script.Parent.VFXController)
local quickKey: Enum.KeyCode? = nil
local UpgradeQueue=require(Shared.Abilities.RasenganUpgradeQueue)
local upgrades: UpgradeQueue.State? = nil
local upgradeCharacter: Model? = nil
local pendingAbility: string? = nil
local function clearUpgrades()
 if upgrades then UpgradeQueue.clear(upgrades) end
 upgrades=nil; upgradeCharacter=nil
end
local Controller = { Changed = Instance.new("BindableEvent") }
local remote: RemoteEvent? = nil
local serial, pendingId, pendingAt = 0, 0, 0
local corrections: { [string]: number } = {}
local correctionModel: Model? = nil
-- Corrections bridge replication latency; replicated deadlines remain authoritative after that window.
local correctionUntil = 0
local lastReason = ""
local selectingCommand: string? = nil
local needsTarget = Targeting.IsTargeted
function Controller.CancelCloneCommand()
	selectingCommand = nil; quickKey = nil; Targeting.Clear(); Players.LocalPlayer:SetAttribute("SelectingCloneTarget", nil); lastReason = ""
end
function Controller.SelectedAbility(): string? return selectingCommand end
function Controller.GetUpgradeQueue(): {string} return if upgrades then table.clone(upgrades.items) else {} end
function Controller.GetQueuedUpgrade(id: string): boolean
 local queue=upgrades
 return queue~=nil and not queue.closed and (queue.awaiting==id or table.find(queue.items,id)~=nil)
end
function Controller.IsSelectingCloneTarget(): boolean return selectingCommand~=nil end
function Controller.ClearCooldownCorrections()
 if not RunService:IsStudio() then return end
 corrections={};correctionUntil=0;Controller.Changed:Fire()
end
function Controller.Remaining(id: string): number
 if id=="ShadowSleep" then id="ShadowClones" end
	if RunService:IsStudio() and Players.LocalPlayer:GetAttribute("DeveloperNoCooldown")==true then return 0 end
	local model = Players.LocalPlayer.Character; if not model then return 0 end
	local deadline = model:GetAttribute("Ready_" .. id)
	return math.max(0, math.max(if typeof(deadline) == "number" then deadline else 0,
		if correctionModel == model and workspace:GetServerTimeNow() < correctionUntil then corrections[id] or 0 else 0) - workspace:GetServerTimeNow())
end
function Controller.Unavailable(summonOrder: boolean?): string?
	local player = Players.LocalPlayer; local model = player.Character
	local humanoid = if model then model:FindFirstChildOfClass("Humanoid") else nil
	if not model or not humanoid or humanoid.Health <= 0 or model:GetAttribute("CombatDisabled") == true or player:GetAttribute("Eliminated") == true then return "Недоступно" end
	if player:GetAttribute("ShopOpen") == true then return "Закройте магазин" end
	if Input:GetFocusedTextBox() then return "Ввод текста" end
	-- Alt only exposes the cursor for HUD buttons and mouse targeting.
	if Gui.MenuIsOpen or player:GetAttribute("StatsOpen")==true or player:GetAttribute("DeveloperConsoleOpen")==true then return "Закройте меню" end
	local match = ReplicatedStorage:FindFirstChild("SurvivalState")
	if not match or match:GetAttribute("Phase") ~= "InProgress" then return "Ожидание матча" end
	if ((model:GetAttribute("SleepUntil") or 0) :: number)>workspace:GetServerTimeNow() then return "Sleep" end
	if not summonOrder and model:GetAttribute("CombatState") == "Stunned" then return "Контроль" end
	if not summonOrder and model:GetAttribute("AbilityId") ~= "" and model:GetAttribute("AbilityId") ~= nil then return "Подготовка" end
	local nextM1 = model:GetAttribute("CombatNextAttackAt")
	if not summonOrder and typeof(nextM1) == "number" and nextM1 > workspace:GetServerTimeNow() then return "Восстановление" end
	if pendingId > 0 and workspace:GetServerTimeNow() - pendingAt < 1.5 then return "Ожидание ответа" end
	return nil
end
function Controller.Cost(id: string): number
 local state=Players.LocalPlayer:FindFirstChild("HeroState")
 return if id=="RikudoHY" or id=="RikudoHZ" then 1800 elseif id=="KcmDash" then 100 elseif id=="Odama" or id=="Rasenshuriken" or id=="ShadowSleep" then 200 elseif id=="SageMode" then 25 elseif id == "Rasengan" then 100 elseif id == "ShadowClones" then 200 elseif id=="Gamakichi" then Gama.rank(if state then (state:GetAttribute("Rank_Gamakichi") or 0) :: number else 0) or 0 else 0
end
function Controller.AbilityUnavailable(id: string): string?
	if not (Config.PrototypeEnabled :: { [string]: boolean })[id] then return "В разработке" end
	local unavailable = Controller.Unavailable(id=="CloneCommand" or id=="KcmCancel" or id=="GamakichiOil" or id=="GamakichiChop"); if unavailable then return unavailable end
	local player = Players.LocalPlayer; local model = player.Character; if not model then return "Недоступно" end
	if (id=="RikudoHY" or id=="RikudoHZ") and model:GetAttribute("RikudoRangedGranted")~=true then return "Requires active Rikudo" end
 local state = player:FindFirstChild("HeroState"); local level = if state then state:GetAttribute("Level") else nil
 local line=if id=="KcmDash" or id=="KcmCancel" then "KCM" elseif id=="MeditationToggle" or id=="MeditationRecall" then "SageMode" elseif id=="CloneCommand" then "ShadowClones" elseif id=="GamakichiOil" or id=="GamakichiChop" then "Gamakichi" else id
 if (id=="KCM" or id=="KcmDash" or id=="KcmCancel" or id=="GamakichiOil" or id=="GamakichiChop" or id=="Rasengan" or id=="ShadowClones" or id=="Gamakichi" or id=="SageMode" or id=="MeditationToggle" or id=="MeditationRecall" or id=="CloneCommand") and (not state or (if id=="CloneCommand" then math.max((state:GetAttribute("Rank_ShadowClones") or 0) :: number,(state:GetAttribute("Rank_Gamakichi") or 0) :: number) else ((state:GetAttribute("Rank_"..line) or 0) :: number))<1) then return "Не изучено" end
	if id == "Rasengan" and (typeof(level) ~= "number" or level < 4) then return "С уровня 4" end
	if id=="MeditationRecall" and (model:GetAttribute("MeditationCloneCount") or 0)==0 then return "Нет медитирующих клонов" end
	if id=="Odama" or id=="Rasenshuriken" then
  if model:GetAttribute("KcmActive")==true or model:GetAttribute("KuramaActive")==true or (model:GetAttribute("SagePhase")~=nil and model:GetAttribute("SagePhase")~="" and not (id=="Rasenshuriken" and model:GetAttribute("SagePhase")=="Active")) then return "Нужна обычная форма или режим мудреца для Расенсюрикена" end
  local rank=if state then (state:GetAttribute("Rank_Rasengan") or 0) :: number else 0
  local untilAt=(model:GetAttribute("RasenganVariantUntil") or 0) :: number
  local wanted=if id=="Odama" or model:GetAttribute("RasenganVariant")=="Rasengan" then "Rasengan" else "Odama"
  if rank<(if id=="Odama" then 2 else 3) then return if id=="Odama" then "Нужен II ранг Расенгана" else "Нужен III ранг Расенгана" end
  if model:GetAttribute("RasenganVariant")~=wanted then return if id=="Odama" then "Сначала 1 — Расенган" else "Сначала Q — Расенган" end
  if untilAt<=workspace:GetServerTimeNow() then return "Окно усиления закрыто" end
 end
 if id=="ShadowSleep" and (not state or ((state:GetAttribute("Rank_ShadowClones") or 0) :: number)<2) then return "Requires clones II" end
	if id=="KuramaForm" then
  if typeof(level)~="number" or level<21 then return "Курама с уровня 21" end
  if model:GetAttribute("KcmActive")==true or model:GetAttribute("KuramaLocked")==true then return "Форма уже действует" end
  if ((model:GetAttribute("KuramaChakra") or 0) :: number)<2500 then return "Нужно 2500 чакры Курамы" end
 end
 local kcm=model:GetAttribute("KcmActive")==true
 if id=="KCM" and model:GetAttribute("KcmAllowed")~=true then return "KCM недоступен" end
 if id=="KCM" and ((model:GetAttribute("KuramaChakra") or 0) :: number)<200 then return "Нужно 200 чакры Курамы" end
 if id=="KcmCancel" and not kcm then return "KCM не активен" end
 if id=="KcmDash" and model:GetAttribute("KcmDashReady")~=true then return "Рывок доступен в KCM" end
 if id=="Gamakichi" and kcm then return "Недоступно в KCM" end
 if id=="KuramaConvert" and (typeof(level)~="number" or level<16 or ((model:GetAttribute("KuramaChakra") or 0) :: number)<200) then return "Уровень 16 и 200 чакры Курамы" end

 local mana = model:GetAttribute("Mana")
 if id=="SageMode" and model:GetAttribute("SagePhase")~="" and model:GetAttribute("SagePhase")~=nil then return "Режим уже действует" end
 local cost = Controller.Cost(id)
	if cost > 0 and (typeof(mana) ~= "number" or mana < cost) then return "Недостаточно маны" end
	if id == "CloneCommand" and (model:GetAttribute("NativeCloneCount") or 0) == 0 and (model:GetAttribute("GamakichiCount") or 0)==0 then return "Нет клонов" end
 if (id=="GamakichiOil" or id=="GamakichiChop") and (model:GetAttribute("GamakichiCount") or 0)==0 then return "Нет Гамакичи" end
 if id=="GamakichiChop" and model:GetAttribute("GamakichiAdult")~=true then return "Только взрослый Гамакичи" end
 return nil
end
local function reject(reason: string): boolean
 lastReason=reason; Controller.Changed:Fire(); return false
end
function Controller.BeginTarget(id: string): boolean
 if not needsTarget(id) then return false end
 local reason=Controller.AbilityUnavailable(id)
 if reason then return reject(reason) end
 if Controller.Remaining(id)>0 then return reject("Способность восстанавливается") end
 quickKey=nil; selectingCommand=id; Players.LocalPlayer:SetAttribute("SelectingCloneTarget",true)
 lastReason="ЛКМ — применить · ПКМ / Esc — отмена"; Controller.Changed:Fire(); return true
end
function Controller.BeginCloneCommand(): boolean return Controller.BeginTarget("CloneCommand") end
function Controller.PickCloneTarget(point: Vector2?): Model? return Targeting.PickModel(point) end
function Controller.ConfirmTarget(): boolean
 if not selectingCommand then return false end
 local target,reason=Targeting.Evaluate(selectingCommand)
 if reason then return reject(reason) end
 return Controller.TryCast(selectingCommand,target)
end
function Controller.Command(mode: string): boolean
 if mode=="Follow" or mode=="Hold" then return Controller.TryCast("CloneCommand",mode) end
 if not Controller.BeginCloneCommand() then return false end
 return Controller.ConfirmTarget()
end
local function dispatch(id: string, selectedTarget: any): boolean
	if not remote or not Config.Abilities[id] then return false end
	local reason=Controller.AbilityUnavailable(id); if reason then return reject(reason) end
	if Controller.Remaining(id)>0 then return reject("Способность восстанавливается") end
	local model = Players.LocalPlayer.Character; if not model then return false end
	local target = if needsTarget(id) or id=="RasenshurikenThrow" then selectedTarget else nil
	if needsTarget(id) and not target then return Controller.BeginTarget(id) end
	serial += 1; if serial > Config.MaxRequestId then return false end
	pendingId = serial; pendingAt = workspace:GetServerTimeNow(); pendingAbility=id; lastReason = ""
	if selectingCommand then
		selectingCommand = nil; quickKey=nil; Targeting.Clear()
		-- Consume the target-selection click for every InputBegan listener this frame.
		RunService.PreRender:Once(function()
			if not selectingCommand then Players.LocalPlayer:SetAttribute("SelectingCloneTarget", nil) end
		end)
	end
	if target then remote:FireServer(serial, model, id, target, Rounds.Current())
	else remote:FireServer(serial, model, id, Rounds.Current()) end
	Controller.Changed:Fire(); return true
end
local function queueUpgrade(id: string): boolean
 local player=Players.LocalPlayer; local model=player.Character
 if not model then return reject("Недоступно") end
 local now=workspace:GetServerTimeNow()
 local unavailable=Controller.Unavailable()
 if unavailable and unavailable~="Ожидание ответа" then clearUpgrades(); return reject(unavailable) end
 if unavailable=="Ожидание ответа" and pendingAbility~="Rasengan" and pendingAbility~="Odama" and pendingAbility~="Rasenshuriken" then
  return reject(unavailable)
 end
 if model:GetAttribute("KcmActive")==true or model:GetAttribute("KuramaActive")==true
  or (model:GetAttribute("SagePhase")~=nil and model:GetAttribute("SagePhase")~="" and not (id=="Rasenshuriken" and model:GetAttribute("SagePhase")=="Active")) then
  clearUpgrades(); return reject("Усиления доступны в обычной форме")
 end
 local hero=player:FindFirstChild("HeroState")
 local rank=if hero then (hero:GetAttribute("Rank_Rasengan") or 0) :: number else 0
 if rank<(if id=="Odama" then 2 else 3) then return reject(if id=="Odama" then "Нужен II ранг Расенгана" else "Нужен III ранг Расенгана") end
 local queue=upgrades
 -- Repeated presses on a submitted/queued step never send a second request.
 if queue and not queue.closed and (queue.awaiting==id or queue.stage==id or table.find(queue.items,id)) then return true end
 if Controller.Remaining(id)>0 then return reject("Способность восстанавливается") end
 if ((model:GetAttribute("Mana") or 0) :: number)<200 then return reject("Для усиления нужно ещё 200 чакры") end
 if not queue or queue.closed or upgradeCharacter~=model then
  local variant=model:GetAttribute("RasenganVariant")
  if variant~="Rasengan" and variant~="Odama" then return reject(if id=="Odama" then "Сначала 1 — Расенган" else "Сначала Q — Расенган") end
  queue=UpgradeQueue.new((model:GetAttribute("NarutoCastId") or 0) :: number,variant,
   (model:GetAttribute("RasenganVariantUntil") or 0) :: number,nil)
  upgrades=queue; upgradeCharacter=model
 end
 assert(queue)
 local ok,reason=UpgradeQueue.enqueue(queue,id,now)
 if not ok then return reject(if reason=="Window" then "Окно усиления закрыто" else "Сначала Q — Расенган") end
 lastReason=""; Controller.Changed:Fire(); return true
end
function Controller.TryCast(id: string, selectedTarget: any): boolean
 if id=="Odama" or id=="Rasenshuriken" then return queueUpgrade(id) end
 local ok=dispatch(id,selectedTarget)
 if ok then
  clearUpgrades()
  if id=="Rasengan" then
   local model=Players.LocalPlayer.Character
   if model then
    upgradeCharacter=model
    upgrades=UpgradeQueue.new(((model:GetAttribute("NarutoCastId") or 0) :: number)+1,"Rasengan",workspace:GetServerTimeNow()+1.25,"Rasengan")
   end
  end
 end
 return ok
end
function Controller.TryThrowRasenshuriken(): boolean
 local model=Players.LocalPlayer.Character
 if not model or model:GetAttribute("SagePhase")~="Active" or model:GetAttribute("RasenganVariant")~="Rasenshuriken" then return false end
 if model:GetAttribute("RasenganPhase")~="Holding" or ((model:GetAttribute("RasenganReadyAt") or 0) :: number)>workspace:GetServerTimeNow() then return true end
 local camera=require(script.Parent.CameraController);local ray=camera.GetAimRay()
 if not ray then return true end
 local params=RaycastParams.new();params.FilterType=Enum.RaycastFilterType.Exclude;params.FilterDescendantsInstances={model}
 local hit=workspace:Raycast(ray.Origin,ray.Direction*120,params)
 dispatch("RasenshurikenThrow",if hit then hit.Position else ray.Origin+ray.Direction*120)
 return true
end
local function flushUpgrades()
 local queue=upgrades; if not queue then return end
 local player=Players.LocalPlayer; local model=player.Character; local now=workspace:GetServerTimeNow()
 local hp=if model then model:FindFirstChildOfClass("Humanoid") else nil
 if model~=upgradeCharacter or not model or not hp or hp.Health<=0 or model:GetAttribute("CombatDisabled")==true
  or Gui.MenuIsOpen or Input:GetFocusedTextBox() or player:GetAttribute("ShopOpen")==true or player:GetAttribute("StatsOpen")==true
  or model:GetAttribute("KcmActive")==true or model:GetAttribute("KuramaActive")==true
  or (model:GetAttribute("SagePhase")~=nil and model:GetAttribute("SagePhase")~="" and model:GetAttribute("SagePhase")~="Active") or UpgradeQueue.expired(queue,now) then
  clearUpgrades(); return
 end
 local cast=(model:GetAttribute("NarutoCastId") or 0) :: number
 -- A base request creates the next cast; replication can precede or trail Result.
 if queue.awaiting=="Rasengan" and cast==queue.castId-1 then return end
 if not UpgradeQueue.observe(queue,cast,tostring(model:GetAttribute("RasenganVariant")),
  (model:GetAttribute("RasenganVariantUntil") or 0) :: number,now) then clearUpgrades(); return end
 if pendingId>0 then return end
 local nextId=UpgradeQueue.next(queue,now); if not nextId then return end
 local reason=Controller.AbilityUnavailable(nextId)
 if reason or Controller.Remaining(nextId)>0 then clearUpgrades(); reject(reason or "Способность восстанавливается"); return end
 if dispatch(nextId,nil) then UpgradeQueue.sent(queue,nextId,now) else clearUpgrades() end
end
function Controller.GetMessage(): string
 local model=Players.LocalPlayer.Character
 if lastReason~="" then return lastReason end
 if model and model:GetAttribute("RasenganHeld")==true then
  local variant=tostring(model:GetAttribute("RasenganVariant"))
  if variant=="Rasenshuriken" and model:GetAttribute("SagePhase")=="Active" then return "Расенсюрикен · ЛКМ — бросить по прицелу" end
  local name=if variant=="Odama" then "Одама Расенган" elseif variant=="Rasenshuriken" then "Расенсюрикен" else "Расенган"
  if variant=="Rasengan" and model:GetAttribute("SagePhase")=="Active" and not Controller.AbilityUnavailable("Rasenshuriken") then return "X — Расенсюрикен · затем ЛКМ — бросок" end
  local nextId=if variant=="Rasengan" then "Odama" elseif variant=="Odama" then "Rasenshuriken" else nil
  if nextId and not Controller.AbilityUnavailable(nextId) and Controller.Remaining(nextId)<=0 then
   local hero=Players.LocalPlayer:FindFirstChild("HeroState")
   local third=hero~=nil and ((hero:GetAttribute("Rank_Rasengan") or 0) :: number)>=3
   return if nextId=="Odama" then (if third then "Z — Одама / X — Расенсюрикен · +200 чакры" else "Z — Одама · +200 чакры") else "X — усилить до Расенсюрикена · +200 чакры"
  end
  local phase=model:GetAttribute("RasenganPhase")
  return if phase=="Consumed" then name..": попадание" elseif phase=="Preparing" then name..": формирование в руке…" else name.." готов · подойдите к врагу и нажмите ЛКМ"
 end
 return if model and model:GetAttribute("MeditationMode")==true then "Meditation: 4 / J recall / Right direct" else ""
end
function Controller.GetFormStatus(): string
 local model=Players.LocalPlayer.Character; if not model then return "" end
 local chakra=model:GetAttribute("KuramaChakra"); if typeof(chakra)~="number" then return "" end
 if model:GetAttribute("KuramaActive")==true then
  local ends=model:GetAttribute("KuramaExpiresAt"); return string.format("Курама %d | Форма %.0fс",math.floor(chakra),math.max(0,(if typeof(ends)=="number" then ends else 0)-workspace:GetServerTimeNow()))
 end
 return string.format("Курама %d | %s",math.floor(chakra),if model:GetAttribute("KcmActive")==true then "KCM: E рывок / X выход / ← мана" else "5 KCM / 6 Курама (ур.21) / ← мана")
end
function Controller.Start()
	if remote then return end
	Rounds.Watch(function() pendingId = 0; pendingAbility=nil; clearUpgrades(); corrections = {}; correctionModel = nil; Controller.CancelCloneCommand(); Controller.Changed:Fire() end)
	local event = ReplicatedStorage:WaitForChild("HeroAbility", 15); assert(event and event:IsA("RemoteEvent"), "HeroAbility missing")
	remote = event; VFX.Start()
	-- Roblox camera controls consume arrows before InputBegan. Own only the two
	-- gameplay arrows, while leaving text and menu/navigation input to the UI.
	Actions:BindActionAtPriority("NarutoArrowTechniques", function(_, state, input)
		if not InputRules.ownsArrow(input.KeyCode.Name, Input:GetFocusedTextBox() ~= nil, Gui.MenuIsOpen,
			Gui.SelectedObject ~= nil, Players.LocalPlayer:GetAttribute("ShopOpen") == true) then
			return Enum.ContextActionResult.Pass
		end
		if state == Enum.UserInputState.Begin then
			local id = (Config.InputAliases :: { read [string]: string })[input.KeyCode.Name]
			if id then Controller.TryCast(id) end
		end
		return Enum.ContextActionResult.Sink
	end, false, Enum.ContextActionPriority.High.Value, Enum.KeyCode.Right, Enum.KeyCode.Left)
	RunService.Heartbeat:Connect(function()
  flushUpgrades()
		if selectingCommand then
   if Controller.AbilityUnavailable(selectingCommand) then Controller.CancelCloneCommand(); Controller.Changed:Fire()
   else
    local reason=Targeting.Preview(selectingCommand)
    lastReason=(reason or "Цель доступна")..(if quickKey then " · отпустите E — рывок · ПКМ — отмена" else " · ЛКМ — применить · ПКМ / Esc — отмена")
   end
  end
	end)
	event.OnClientEvent:Connect(function(message: any)
		if not Rounds.Accepts(message.roundId) then return end
		if message.kind == "DamageFeedback" then Feedback.DamageFeedback(message); return end
		if message.kind ~= "Result" then VFX.Event(message); return end
		if message.character ~= Players.LocalPlayer.Character or message.requestId ~= pendingId then return end
		pendingId = 0; pendingAbility=nil; if not message.accepted then clearUpgrades() end; correctionModel = message.character; corrections = message.ready; correctionUntil = workspace:GetServerTimeNow() + 1.5
		local reasons: { [string]: string } = { Window="Окно усиления закрыто", Rank="Нужен следующий ранг Расенгана", FormAdapterUnverified="Усиления доступны в обычной форме", Unlearned="Способность не изучена", Rikudo="Нужен активный Рикудо", Hagoromo="Требуется дар Хагоромо", Chakra="Недостаточно чакры Курамы", Form="Недоступно в текущей форме", Range="Слишком далеко", Blocked="Путь перекрыт", Ground="Выберите устойчивую поверхность", Busy = "Дождитесь завершения действия", Cooldown = "Способность восстанавливается",
			Unavailable = "Сейчас недоступно", RateLimited = "Слишком часто", Replay = "Запрос уже обработан", Mana = "Недостаточно маны",
			Level = "Требуется уровень 4", Target = "Выберите доступного врага", Unsupported = "Ещё не доступно", UnsupportedTarget = "Эта ветка ещё не доступна" }
		lastReason = if message.accepted then "" else reasons[message.reason] or "Запрос отклонён"
		Controller.Changed:Fire()
	end)
	Players.LocalPlayer.CharacterAdded:Connect(function() pendingId = 0; pendingAbility=nil; clearUpgrades(); corrections = {}; correctionModel = nil; Controller.CancelCloneCommand() end)
	Input.InputBegan:Connect(function(input, processed)
		if input.KeyCode == Enum.KeyCode.Right or input.KeyCode == Enum.KeyCode.Left then return end
		if selectingCommand and input.KeyCode == Enum.KeyCode.Escape then Controller.CancelCloneCommand(); Controller.Changed:Fire(); return end
		if processed or Input:GetFocusedTextBox() or Gui.MenuIsOpen then return end
  if input.KeyCode==Enum.KeyCode.R then Controller.Command("Follow"); return end
  if input.KeyCode==Enum.KeyCode.Y then Controller.Command("Hold"); return end
		if selectingCommand then
			if input.KeyCode == Enum.KeyCode.Escape or input.UserInputType == Enum.UserInputType.MouseButton2 then
				Controller.CancelCloneCommand(); Controller.Changed:Fire(); return
			elseif input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				local gui = Players.LocalPlayer:FindFirstChildOfClass("PlayerGui")
				local abilityGui = if gui then gui:FindFirstChild("AbilityHUD") else nil
				if gui and abilityGui then
					for _, object in gui:GetGuiObjectsAtPosition(input.Position.X, input.Position.Y) do
						if object:IsDescendantOf(abilityGui) then return end
					end
				end
				Controller.ConfirmTarget()
				return
			end
		end
		local model = Players.LocalPlayer.Character
		local alias = InputRules.resolve(Config.InputAliases :: { read [string]: string }, input.KeyCode.Name, model ~= nil and model:GetAttribute("KcmActive") == true)
		if alias then
   if not needsTarget(alias) and (Input:IsKeyDown(Enum.KeyCode.LeftControl) or Input:IsKeyDown(Enum.KeyCode.RightControl)) then Learning.TryLearn(alias); return end
			if alias=="KcmDash" then
    if Controller.BeginTarget(alias) then quickKey=input.KeyCode end
   elseif alias == "CloneCommand" then Controller.Command("Attack") else Controller.TryCast(alias) end
			return
		end
		for _, id in Config.Order do
			if input.KeyCode.Name == Config.Abilities[id].Key then
    if not needsTarget(id) and (Input:IsKeyDown(Enum.KeyCode.LeftControl) or Input:IsKeyDown(Enum.KeyCode.RightControl)) then Learning.TryLearn(id) elseif id=="CloneCommand" then Controller.Command("Attack") else Controller.TryCast(id) end
    break
   end
		end
	end)
 Input.InputEnded:Connect(function(input)
  if quickKey and input.KeyCode==quickKey then quickKey=nil; Controller.ConfirmTarget() end
 end)
 Input.WindowFocusReleased:Connect(function() clearUpgrades(); Controller.CancelCloneCommand() end)
 Players.LocalPlayer.CharacterRemoving:Connect(function() clearUpgrades(); Controller.CancelCloneCommand() end)
end
return Controller
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="132">
            <Properties>
              <string name="Name">AbilityDescriptions</string>
              <string name="Source"><![CDATA[--!strict
-- Player-facing descriptions shared by main and temporary ability slots.
return {
 Rasengan="Собирает вращающуюся чакру в ладони. После формирования подойдите к врагу и ударьте ЛКМ. Промах сохраняет заряд.\nПосле Q выберите Z — Одама или X — Расенсюрикен напрямую. Доступные варианты заменяют значок Q до выбора или окончания заряда. Без выбора остаётся обычный Расенган.",
 Odama="Увеличивает обычный Расенган до огромной сферы. Наруто поддерживает её второй рукой и наносит мощный удар вблизи.\nТребуется II ранг Расенгана. Q → Z. Доплата 200 чакры; всего 300. Урон: 250 + 3 × сила. ЛКМ по врагу — применить.",
 Rasenshuriken="Добавляет стихию ветра: над ладонью вращаются четыре острые лопасти. Попадание создаёт расширяющуюся сферу режущих потоков вокруг врага.\nТребуется III ранг. Q → X, Одама не требуется. Доплата 200 чакры; всего 300. В обычной форме — удар ЛКМ вблизи с уроном владельцу. В режиме мудреца — ЛКМ бросает по прицелу на расстояние до 110 studs. При попадании раскрывается синий купол; бросок не ранит владельца.",
 ShadowClones="Создаёт теневых клонов, которые следуют за Наруто и помогают атаковать. Количество, длительность и восстановление зависят от ранга.\nF — атаковать цель под прицелом; R — следовать; Y — удерживать позицию. Со II ранга T открывает технику сна против врага.",
 Gamakichi="Призывает Гамакичи. Ранг определяет силу и возраст жабы. Она помогает в бою и выполняет общие команды F / R / Y.\nG — выбрать точку для масла. Взрослая жаба получает H — серию ударов мечом по области. ЛКМ подтверждает цель, ПКМ отменяет.",
 SageMode="Наруто неподвижно собирает природную энергию, затем входит в режим мудреца. Оранжевая аура отмечает действующий режим.\nПодготовка требует времени: учитывайте опасность рядом. Стрелка вправо — медитация; J — вернуть чакру из медитирующих клонов. Параметры зависят от изученного ранга.",
 KCM="Использует отдельный запас чакры Курамы и окружает Наруто золотой энергией. Доступность формы зависит от ранга и условий прогрессии.\nE — удерживать для прицеливания рывка, отпустить для применения. X — выйти из формы. Стрелка влево — преобразование чакры.",
 CloneCommand="Направляет клонов и Гамакичи на вражескую цель под прицелом. Если цели нет, выберите её и подтвердите ЛКМ.\nR возвращает призывов к владельцу; Y оставляет их на месте. Союзников атаковать нельзя.",
 GamakichiOil="Гамакичи выпускает масло в выбранную точку. Замедление начинается после прилёта, а не при нажатии.\nНаведите прицел, нажмите G и подтвердите ЛКМ. ПКМ / Esc — отмена.",
 GamakichiChop="Взрослый Гамакичи проводит четыре последовательных удара мечом по выбранной области. Урон проходит волнами.\nH — выбрать область, ЛКМ — подтвердить. Требуется взрослый призыв. ПКМ / Esc — отмена.",
 RikudoHY="Временная техника Рикудо: мощная атака по выбранной точке. Требуется активная форма и 1800 чакры. V → прицел → ЛКМ. ПКМ / Esc — отмена.",
 RikudoHZ="Временная техника Рикудо с областью поражения. Требуется активная форма и 1800 чакры. B → прицел → ЛКМ. ПКМ / Esc — отмена.",
}
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="133">
            <Properties>
              <string name="Name">AbilityHUDController</string>
              <string name="Source"><![CDATA[--!strict
local Players=game:GetService("Players")
local RunService=game:GetService("RunService")
local UserInput=game:GetService("UserInputService")
local Shared=game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config=require(Shared.Config.AbilityConfig)
local Items=require(Shared.Config.ItemConfig)
local Combat=require(Shared.Config.CombatConfig)
local BasicRules=require(Shared.Combat.BasicAttackRules)
local CloneRanks=require(Shared.Abilities.NarutoRankPolicy)
local Gamakichi=require(Shared.Abilities.GamakichiState)
local Controller=require(script.Parent.AbilityController)
local Learning=require(script.Parent.LearningController)
local View=require(script.Parent.MobaHUDView)
local Layout=require(script.Parent.HUDLayout)
local Icons=require(script.Parent.HUDIcons)
local Descriptions=require(script.Parent.AbilityDescriptions)
local HUD={}
local started=false
function HUD.Start()
 if started then return end; started=true; Controller.Start(); Learning.Start()
 local player=Players.LocalPlayer
 local starter=game:GetService("StarterGui")
 starter:SetCoreGuiEnabled(Enum.CoreGuiType.Health,false); starter:SetCoreGuiEnabled(Enum.CoreGuiType.PlayerList,false)
 local gui=Instance.new("ScreenGui"); gui.Name="AbilityHUD"; gui.ResetOnSpawn=false; gui.DisplayOrder=8
 gui.ScreenInsets=Enum.ScreenInsets.None; gui.ZIndexBehavior=Enum.ZIndexBehavior.Sibling; gui.Parent=player:WaitForChild("PlayerGui")
 local panel=View.frame(gui,"Abilities",UDim2.fromOffset(Layout.ConsoleWidth,Layout.ConsoleHeight),UDim2.fromScale(.5,1)); panel.AnchorPoint=Vector2.new(.5,1)
 View.border(panel,View.Gold); local scale=Instance.new("UIScale"); scale.Parent=panel
 local portrait=View.portrait(panel,UDim2.fromOffset(108,132),UDim2.fromOffset(4,25))
 local hero=View.label(panel,"HeroName",UDim2.fromOffset(108,22),UDim2.fromOffset(4,2),13); hero.Text="NARUTO"
 local level=View.label(panel,"Level",UDim2.fromOffset(30,26),UDim2.fromOffset(82,130),17); level.BackgroundTransparency=0; level.BackgroundColor3=View.Background; level.TextColor3=View.Gold
 local xpTrack=View.frame(panel,"XP",UDim2.fromOffset(108,4),UDim2.fromOffset(4,159)); xpTrack.BackgroundColor3=View.Card
 local xpFill=View.frame(xpTrack,"Fill",UDim2.fromScale(0,1),UDim2.new()); xpFill.BackgroundColor3=View.Gold
 local stats=View.label(panel,"CombatStats",UDim2.fromOffset(116,124),UDim2.fromOffset(119,29),13); stats.TextXAlignment=Enum.TextXAlignment.Left; stats.TextYAlignment=Enum.TextYAlignment.Top
 local kda=View.label(panel,"KDA",UDim2.fromOffset(116,22),UDim2.fromOffset(119,2),12)
 local points=View.label(panel,"SkillPoints",UDim2.fromOffset(336,16),UDim2.fromOffset(240,0),12); points.TextColor3=View.Gold
 local gold=View.label(panel,"Gold",UDim2.fromOffset(186,27),UDim2.fromOffset(704,128),17); gold.TextColor3=View.Gold
 local statsToggle=Instance.new("TextButton"); statsToggle.Name="StatsToggle"; statsToggle.Text="C  Характеристики"; statsToggle.Size=UDim2.fromOffset(116,23); statsToggle.Position=UDim2.fromOffset(119,137); statsToggle.TextSize=10; statsToggle.BackgroundColor3=View.Card; statsToggle.TextColor3=View.Gold; statsToggle.Parent=panel
 local statsPanel=View.frame(panel,"CharacterStats",UDim2.fromOffset(300,300),UDim2.fromOffset(0,-310)); statsPanel.Visible=false; View.border(statsPanel,View.Gold)
 local statsText=View.label(statsPanel,"Values",UDim2.new(1,-24,1,-24),UDim2.fromOffset(12,12),14); statsText.TextXAlignment=Enum.TextXAlignment.Left; statsText.TextYAlignment=Enum.TextYAlignment.Top
 local function toggle() statsPanel.Visible=not statsPanel.Visible; player:SetAttribute("StatsOpen",statsPanel.Visible) end
 statsToggle.Activated:Connect(toggle)
 UserInput.InputBegan:Connect(function(input,processed) if not processed and not UserInput:GetFocusedTextBox() and input.KeyCode==Enum.KeyCode.C then toggle() end end)
 local tooltip=View.frame(panel,"Tooltip",UDim2.fromOffset(410,300),UDim2.fromOffset(240,-310)); tooltip.Visible=false; tooltip.ZIndex=8; View.border(tooltip,View.Gold)
 local tooltipText=View.label(tooltip,"Text",UDim2.new(1,-20,1,-16),UDim2.fromOffset(10,8),14); tooltipText.TextSize=16; tooltipText.TextWrapped=true; tooltipText.TextXAlignment=Enum.TextXAlignment.Left; tooltipText.TextYAlignment=Enum.TextYAlignment.Top
 local hovered: string?=nil
 local buttons: {[string]: TextButton}={}
 local learnButtons: {[string]: TextButton}={}
 for index,id in Config.Order do
  local main=index<=5; local x,y,size=Layout.skill(index)
  local button=Instance.new("TextButton"); button.Name=id; button.Size=UDim2.fromOffset(size,size)
  button.Position=UDim2.fromOffset(x,y)
  button.BackgroundColor3=View.Card; button.BorderSizePixel=0; button.Text=""; button.Parent=panel; View.border(button,View.Gold)
  Icons.draw(button,id)
  local shade=View.frame(button,"Cooldown",UDim2.fromScale(1,1),UDim2.new()); shade.BackgroundColor3=Color3.new(); shade.BackgroundTransparency=.35; shade.ZIndex=2
  local key=View.label(button,"Key",UDim2.fromOffset(if main then 45 else 30,16),UDim2.fromOffset(0,-16),if main then 12 else 11); key.Text=Config.Abilities[id].KeyLabel; key.TextXAlignment=Enum.TextXAlignment.Left; key.TextColor3=View.Gold
  local status=View.label(button,"Status",UDim2.fromScale(1,1),UDim2.new(),if main then 17 else 12); status.ZIndex=3; status.TextStrokeTransparency=.2
  local cost=View.label(button,"Chakra",UDim2.new(1,-4,0,12),UDim2.new(0,2,1,-13),10); cost.TextXAlignment=Enum.TextXAlignment.Right; cost.TextColor3=Color3.fromRGB(128,203,255); cost.ZIndex=3
  local rank=View.label(button,"Rank",UDim2.fromOffset(size,14),UDim2.fromOffset(0,size+2),11); rank.TextColor3=View.Gold; rank.Visible=main
  button.MouseEnter:Connect(function() hovered=id; tooltip.Visible=true end)
  button.MouseLeave:Connect(function() if hovered==id then hovered=nil; tooltip.Visible=false end end)
  button.Activated:Connect(function() if id=="CloneCommand" then Controller.BeginCloneCommand() else Controller.TryCast(id) end end)
  buttons[id]=button
  if main then
   local plus=Instance.new("TextButton"); plus.Name="Learn"; plus.Text="+"; plus.Size=UDim2.fromOffset(22,20); plus.Position=UDim2.new(1,-22,0,-21); plus.ZIndex=4; plus.TextSize=20
   plus.BackgroundColor3=Color3.fromRGB(152,112,33); plus.TextColor3=Color3.new(1,1,1); plus.Parent=button
   plus.Activated:Connect(function() Learning.TryLearn(id) end); learnButtons[id]=plus
  end
 end
 local rikudoPanel=View.frame(panel,"RikudoTechniques",UDim2.fromOffset(370,45),UDim2.fromOffset(520,Layout.RikudoPanelY));rikudoPanel.Visible=false
 local rikudoTitle=View.label(rikudoPanel,"Title",UDim2.fromOffset(370,17),UDim2.fromOffset(0,-18),12);rikudoTitle.Text="РИКУДО • временные техники";rikudoTitle.TextColor3=View.Gold
 local rangedButtons:{[string]:TextButton}={}
 for i,id in {"RikudoHY","RikudoHZ"} do
  local b=Instance.new("TextButton");b.Name=id;b.Size=UDim2.fromOffset(180,45);b.Position=UDim2.fromOffset((i-1)*190,0);b.BackgroundColor3=View.Card;b.TextColor3=View.Text;b.TextSize=12;b.Parent=rikudoPanel;View.border(b,View.Gold)
  b.Activated:Connect(function() Controller.BeginTarget(id) end);rangedButtons[id]=b
  b.MouseEnter:Connect(function() hovered=id;tooltip.Position=UDim2.fromOffset(520,Layout.RikudoTooltipY);tooltip.Visible=true;tooltipText.Text=Config.Abilities[id].Name.." ["..Config.Abilities[id].KeyLabel.."]\n1800 маны • 60 с\nВыбери точку. Клавиша или кнопка → клик.\nEsc / ПКМ — отмена." end)
  b.MouseLeave:Connect(function() if hovered==id then hovered=nil;tooltip.Visible=false;tooltip.Position=UDim2.fromOffset(240,-310) end end)
 end
 local function bar(name: string,y: number,color: Color3): (Frame,TextLabel)
  local track=View.frame(panel,name,UDim2.fromOffset(450,17),UDim2.fromOffset(240,y)); track.BackgroundColor3=View.Card
  local fill=View.frame(track,"Fill",UDim2.fromScale(1,1),UDim2.new()); fill.BackgroundColor3=color
  local text=View.label(track,"Value",UDim2.fromScale(1,1),UDim2.new(),12); text.TextStrokeTransparency=.35; return fill,text
 end
 local hpFill,hpText=bar("Health",124,Color3.fromRGB(74,144,57))
 local mpFill,mpText=bar("Mana",143,Color3.fromRGB(42,105,171))
 local inventory: {{frame: Frame, name: TextLabel, id: string?}}={}
 for index=1,6 do
  local x,y=Layout.item(index)
  local slot=View.frame(panel,"Item"..index,UDim2.fromOffset(58,48),UDim2.fromOffset(x,y)); slot.BackgroundColor3=View.Card
  local name=View.label(slot,"Name",UDim2.new(1,0,0,20),UDim2.new(0,0,1,-20),9); name.ZIndex=2; name.TextWrapped=true; name.TextTruncate=Enum.TextTruncate.None; name.TextStrokeTransparency=.15
  View.border(slot,Color3.fromRGB(91,97,103)); table.insert(inventory,{frame=slot,name=name,id=nil})
 end
 local itemTitle=View.label(panel,"Inventory",UDim2.fromOffset(186,22),UDim2.fromOffset(704,0),11); itemTitle.Text="ПРЕДМЕТЫ"
 local message=View.label(gui,"AbilityMessage",UDim2.fromOffset(620,28),UDim2.new(.5,0,1,-180),14); message.AnchorPoint=Vector2.new(.5,1); message.TextColor3=View.Gold; message.TextStrokeTransparency=.3
 local commands=View.label(gui,"SummonCommands",UDim2.fromOffset(620,24),UDim2.new(.5,0,1,-220),13); commands.AnchorPoint=Vector2.new(.5,1); commands.TextColor3=View.Gold; commands.TextStrokeTransparency=.3
 local choices: {[string]: TextButton}={}
 for _,id in {"Odama","Rasenshuriken"} do
  local b=Instance.new("TextButton");b.Name="Choose"..id;b.Text="";b.BackgroundColor3=View.Card;b.BorderSizePixel=0;b.Parent=panel;b.Visible=false;View.border(b,View.Gold)
  local symbol=View.frame(b,"Symbol",UDim2.new(1,0,0,30),UDim2.new());Icons.draw(symbol,id)
  local key=View.label(b,"ChoiceKey",UDim2.new(1,0,0,16),UDim2.fromOffset(0,31),13);key.Text=Config.Abilities[id].KeyLabel;key.TextColor3=View.Gold
  local cost=View.label(b,"Cost",UDim2.new(1,0,0,12),UDim2.fromOffset(0,47),9);cost.Text="200";cost.TextColor3=Color3.fromRGB(128,203,255)
  b.Activated:Connect(function() Controller.TryCast(id) end)
  b.MouseEnter:Connect(function() hovered=id;tooltip.Visible=true end)
  b.MouseLeave:Connect(function() if hovered==id then hovered=nil;tooltip.Visible=false end end)
  choices[id]=b
 end
 local nextUpdate=0
 RunService.Heartbeat:Connect(function()
  local now=workspace:GetServerTimeNow(); if now<nextUpdate then return end; nextUpdate=now+.1
  local camera=workspace.CurrentCamera
  if camera then
   scale.Scale=Layout.scale(camera.ViewportSize.X,camera.ViewportSize.Y)
   message.Position=UDim2.new(.5,0,1,-(Layout.ConsoleHeight*scale.Scale+12)); message.Size=UDim2.fromOffset(math.min(900,camera.ViewportSize.X-24),40)
  end
  local model=player.Character; View.updatePortrait(portrait,model)
  commands.Visible=model~=nil and (((model:GetAttribute("NativeCloneCount") or 0) :: number)>0 or ((model:GetAttribute("GamakichiCount") or 0) :: number)>0)
  commands.Position=message.Position-UDim2.fromOffset(0,40)
  local order=tostring(if model then model:GetAttribute("SummonOrder") or "Follow" else "Follow")
  commands.Text="F — атаковать · R — за мной · Y — стоять  ["..(if order=="Hold" then "Стоять" elseif order=="Command" then "Атака" else "Следование").."]"
  rikudoPanel.Visible=model~=nil and model:GetAttribute("RikudoRangedGranted")==true
  for id,b in rangedButtons do
   local left=Controller.Remaining(id);local reason=Controller.AbilityUnavailable(id)
   b.Active=left<=0 and reason==nil;b.AutoButtonColor=b.Active;b.BackgroundColor3=if b.Active then View.Card else Color3.fromRGB(31,29,35)
   b.Text=Config.Abilities[id].KeyLabel.."  "..Config.Abilities[id].Name.."\n"..(if left>0 then string.format("%.1f с",left) elseif reason then "1800 маны • недоступно" else "1800 маны • выбрать точку")
  end
  local state=player:FindFirstChild("HeroState")
  local function number(name: string): number local value=if state then state:GetAttribute(name) else nil; return if typeof(value)=="number" then value else 0 end
  local function shown(name: string,format: string): string local value=if state then state:GetAttribute(name) else nil; return if typeof(value)=="number" then string.format(format,value) else "—" end
  local humanoid=if model then model:FindFirstChildOfClass("Humanoid") else nil
  local hp=if humanoid then humanoid.Health else 0; local maximum=if humanoid then humanoid.MaxHealth else 1
  local mana=if model then model:GetAttribute("Mana") else nil; local maxMana=if model then model:GetAttribute("MaxMana") else nil
  local mp=if typeof(mana)=="number" then mana else 0; local maxMP=if typeof(maxMana)=="number" then maxMana else 1
  hpFill.Size=UDim2.fromScale(math.clamp(hp/math.max(1,maximum),0,1),1); hpText.Text=string.format("%d / %d",math.ceil(hp),maximum)
  mpFill.Size=UDim2.fromScale(math.clamp(mp/math.max(1,maxMP),0,1),1); mpText.Text=string.format("%d / %d",math.floor(mp),maxMP)
  level.Text=shown("Level","%d"); gold.Text=shown("Gold","%d GOLD")
  kda.Text=string.format("K/D/A  %d / %d / %d",number("TotalKills"),number("TotalDeaths"),number("Assists"))
  xpFill.Size=UDim2.fromScale(if number("XPToNextLevel")==0 then 1 else math.clamp(number("CurrentXP")/number("XPToNextLevel"),0,1),1)
  local profile=Combat.Profiles.OrangeNinja
  local rawAttack=profile.Damage*number("AttackDamageMultiplier")+number("AttackDamageBonus")
  local attacksPerSecond=BasicRules.speed(profile,number("Agility"))/profile.AttackCooldown
  stats.Text="STR  "..shown("Strength","%.1f").."\nAGI  "..shown("Agility","%.1f").."\nINT   "..shown("Intelligence","%.1f")..string.format("\nАтака %.1f · %.2f/с",rawAttack,attacksPerSecond).."\nБроня  "..shown("Defense","%.1f").."\nСкор.  "..shown("WalkSpeed","%.1f")
  statsText.Text="NARUTO  •  Уровень "..shown("Level","%d").."\nXP "..shown("CurrentXP","%d").." / "..shown("XPToNextLevel","%d").."\nОчки навыков: "..shown("SkillPoints","%d").."\n\n"..stats.Text.."\n\nМножитель M1  "..shown("AttackDamageMultiplier","x%.2f").."\nБонус M1  "..shown("AttackDamageBonus","+%.0f").."\nРеген. маны  "..shown("ManaRegen","%.2f/с")
  local owned={}; for _,id in Items.Order do if state and state:GetAttribute("Own_"..id)==true then table.insert(owned,id) end end
  for index,slot in inventory do
   local id=owned[index]
   if slot.id~=id then
    local old=slot.frame:FindFirstChild("Icon"); if old then old:Destroy() end
    if id then Icons.draw(slot.frame,id) end
    slot.id=id
   end
   slot.name.Text=if id then Items.Items[id].Name else "—"
  end
  local notice=if Learning.GetMessage()~="" then Learning.GetMessage() else Controller.GetMessage()
  local formStatus=Controller.GetFormStatus()
  message.Visible=hovered==nil
  message.Text=if notice~="" and formStatus~="" then notice.."\n"..formStatus else notice..formStatus
  points.Text=if number("SkillPoints")>0 then string.format("+ %d  •  Ctrl+1–5 / + для обучения",number("SkillPoints")) else "НАВЫКИ"
  local choosing=model~=nil and model:GetAttribute("RasenganVariant")=="Rasengan" and model:GetAttribute("RasenganPhase")~="Consumed"
   and ((model:GetAttribute("RasenganVariantUntil") or 0) :: number)>now and number("Rank_Rasengan")>=2 and (model:GetAttribute("SagePhase")~="Active" or number("Rank_Rasengan")>=3)
   and model:GetAttribute("KcmActive")~=true and model:GetAttribute("KuramaActive")~=true and (model:GetAttribute("SagePhase")==nil or model:GetAttribute("SagePhase")=="" or model:GetAttribute("SagePhase")=="Active")
  buttons.Rasengan.Visible=not choosing
  local sx,sy,ss=Layout.skill(1)
  for i,id in {"Odama","Rasenshuriken"} do
   local b=choices[id];b.Visible=choosing and number("Rank_Rasengan")>=i+1 and (id=="Rasenshuriken" or not model or model:GetAttribute("SagePhase")~="Active")
   local sage=model~=nil and model:GetAttribute("SagePhase")=="Active"
   local width=if number("Rank_Rasengan")>=3 and not sage then (ss-3)/2 else ss
   b.Position=UDim2.fromOffset(sx+(if sage then 0 else (i-1)*(width+3)),sy);b.Size=UDim2.fromOffset(width,ss)
   local reason=Controller.AbilityUnavailable(id);b.BackgroundColor3=if reason or Controller.Remaining(id)>0 then View.Card else Color3.fromRGB(24,88,113)
  end
  for id,plus in learnButtons do plus.Visible=state~=nil and state:GetAttribute("LearnReason_"..id)=="Ready" end
  for id,button in buttons do
   local shownId=id
   if id=="Rasengan" and model then
    local variant=model:GetAttribute("RasenganVariant")
    if variant=="Odama" or variant=="Rasenshuriken" then shownId=variant end
   end
   if button:GetAttribute("ShownTechnique")~=shownId then
    local old=button:FindFirstChild("Icon");if old then old:Destroy() end
    local icon=Icons.draw(button,shownId);icon.ZIndex=1
    button:SetAttribute("ShownTechnique",shownId)
   end
   local costLabel=button:FindFirstChild("Chakra") :: TextLabel; local cost=Controller.Cost(id); costLabel.Text=if cost>0 then tostring(cost) else ""
   local remaining=Controller.Remaining(id); local reason=Controller.AbilityUnavailable(id); local rank=number("Rank_"..id)
   local enabled=(Config.PrototypeEnabled :: {[string]: boolean})[id]==true
   button.Active=true; button.AutoButtonColor=reason==nil and remaining<=0
   button.BackgroundColor3=if Controller.SelectedAbility()==id then Color3.fromRGB(33,107,108) elseif reason=="Недостаточно маны" then Color3.fromRGB(30,48,88) else View.Card
   local shade=button:FindFirstChild("Cooldown") :: Frame
   shade.Visible=remaining>0 or reason~=nil or not enabled
   local cooldown=Config.Abilities[id].Cooldown
   if id=="ShadowClones" then local plan=CloneRanks.cloneRank(rank);if plan then cooldown=plan.cooldown end
   elseif id=="Gamakichi" then local _,cd=Gamakichi.rank(rank);if cd then cooldown=cd end end
   shade.Size=UDim2.fromScale(1,if remaining>0 then math.clamp(remaining/math.max(1,cooldown),0,1) else 1)
   local status=button:FindFirstChild("Status") :: TextLabel
   status.Text=if not enabled then "LOCK" elseif remaining>0 then tostring(math.ceil(remaining)) elseif reason then (if reason=="Недостаточно маны" then "ЧАКРА" elseif rank==0 and learnButtons[id] then "0" else "×") else ""
   local rankLabel=button:FindFirstChild("Rank") :: TextLabel; rankLabel.Text=if rank>0 then string.rep("●",math.min(rank,5)) else "○"
   if id=="Rasengan" and model and model:GetAttribute("RasenganHeld")==true then
    shade.Visible=false;status.Text="";button.BackgroundColor3=Color3.fromRGB(24,90,120)
   end
   if id=="SageMode" and model then
    local phase=model:GetAttribute("SagePhase"); local deadline=model:GetAttribute(if phase=="Preparing" then "SageReadyAt" else "SageExpiresAt")
    if (phase=="Preparing" or phase=="Active") and typeof(deadline)=="number" then
     status.Text=(if phase=="Preparing" then "P " else "S ")..tostring(math.max(0,math.ceil(deadline-now))); shade.Visible=true; shade.Size=UDim2.fromScale(1,1); shade.BackgroundColor3=Color3.fromRGB(89,51,19)
    else shade.BackgroundColor3=Color3.new() end
   end

  end
  if hovered then
   local id=if hovered=="Rasengan" then tostring(buttons.Rasengan:GetAttribute("ShownTechnique") or hovered) else hovered;local definition=Config.Abilities[id]
   if definition then
    local rank=number("Rank_"..(if id=="Odama" or id=="Rasenshuriken" then "Rasengan" else id))
    local cd=definition.Cooldown
    if id=="ShadowClones" then local plan=CloneRanks.cloneRank(rank);if plan then cd=plan.cooldown end end
    if id=="Gamakichi" then local _,value=Gamakichi.rank(rank);if value then cd=value end end
    tooltipText.Text=(if id=="ShadowClones" then "Теневые клоны" elseif id=="Rasengan" then "Расенган" else definition.Name)..(if rank>0 then " • ранг "..rank else "").."  ["..definition.KeyLabel.."]\n"..tostring(Controller.Cost(id)).." чакры  •  восстановление "..tostring(cd).." с\n\n"..((Descriptions :: {[string]:string})[id] or "").."\n\n"..(Controller.AbilityUnavailable(id) or (if Controller.Remaining(id)>0 then string.format("Перезарядка: %.1f с",Controller.Remaining(id)) else "Готово")).."\nAlt — свободный курсор • Ctrl + 1–5 — изучение"
   end
  end
 end)
end
return HUD
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="134">
            <Properties>
              <string name="Name">AbilityTargeting</string>
              <string name="Source"><![CDATA[--!strict
-- Preview only: server services still decide legality, resources and hits.
local Players = game:GetService("Players")
local Input = game:GetService("UserInputService")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Units = require(Shared.Abilities.WorldUnits)
local Definitions = require(Shared.Abilities.NarutoDefinitions)
local Spells = require(Shared.Abilities.GamakichiSpells)
local Kcm = require(Shared.Abilities.NarutoKcmGameplay)
local Ranged = require(Shared.Abilities.NarutoRangedState)
local Targeting = {}
local folder: Folder? = nil
local ring: {Part} = {}
local line: Part? = nil
local marker: Part? = nil
local growthRing: {Part} = {}
local highlight: Highlight? = nil
local validColor, invalidColor = Color3.fromRGB(94,225,205), Color3.fromRGB(255,104,98)
-- NarutoRangedState starts both explosions at 636 WC; HY expands by 4 for 58 pulses.
local rangedRadius, hyMaximumRadius = 636, 636 + 4*58
local actors: {[Model]: boolean} = {}
local function actorAdded(item: Instance)
	if item:IsA("Humanoid") and item.Parent and item.Parent:IsA("Model") then actors[item.Parent] = true end
end
for _, item in workspace:GetDescendants() do actorAdded(item) end
workspace.DescendantAdded:Connect(actorAdded)
workspace.DescendantRemoving:Connect(function(item)
	if item:IsA("Humanoid") and item.Parent and item.Parent:IsA("Model") then actors[item.Parent] = nil end
end)

function Targeting.IsTargeted(id: string): boolean
	return id == "CloneCommand" or id == "ShadowSleep" or id == "GamakichiOil" or id == "GamakichiChop" or id == "KcmDash" or id == "RikudoHY" or id == "RikudoHZ"
end
local function exclusions(): {Instance}
	local player = Players.LocalPlayer
	local excluded: {Instance} = {}
	if player.Character then table.insert(excluded, player.Character) end
	if folder then table.insert(excluded, folder) end
	local summons = workspace:FindFirstChild("HeroSummons")
	if summons then for _, model in summons:GetChildren() do
		if model:GetAttribute("TeamId") == player:GetAttribute("TeamId") then table.insert(excluded, model) end
	end end
	return excluded
end
function Targeting.Pick(point: Vector2?): RaycastResult?
	local camera = workspace.CurrentCamera; if not camera then return nil end
	local mouse = point or Input:GetMouseLocation()
	local ray = if Input.MouseBehavior == Enum.MouseBehavior.LockCenter
		then camera:ViewportPointToRay(camera.ViewportSize.X/2, camera.ViewportSize.Y/2)
		else camera:ScreenPointToRay(mouse.X, mouse.Y)
	local params = RaycastParams.new(); params.FilterDescendantsInstances = exclusions()
	return workspace:Raycast(ray.Origin, ray.Direction*500, params)
end
local function modelAt(hit: RaycastResult?): Model?
	local item = if hit then hit.Instance :: Instance else nil
	while item and item ~= workspace do
		if item:IsA("Model") and item:FindFirstChildOfClass("Humanoid") then return item end
		item = item.Parent
	end
	return nil
end
function Targeting.PickModel(point: Vector2?): Model? return modelAt(Targeting.Pick(point)) end
local function terrainParams(): RaycastParams
	local ignored = exclusions()
	for actor in actors do table.insert(ignored, actor) end
	local params = RaycastParams.new(); params.FilterDescendantsInstances = ignored; params.RespectCanCollide = true
	return params
end
function Targeting.Geometry(id: string): (BasePart?, number, number)
	local player = Players.LocalPlayer
	local model = player.Character
	if id == "GamakichiOil" or id == "GamakichiChop" then
		model = nil
		local summons = workspace:FindFirstChild("HeroSummons")
		if summons then for _, child in summons:GetChildren() do
			if child:IsA("Model") and child:GetAttribute("NativeGamakichi") == true and child:GetAttribute("SummonOwner") == player.UserId then model = child; break end
		end end
	end
	local root = if model then model:FindFirstChild("HumanoidRootPart") else nil
	local range = if id == "GamakichiOil" then Spells.Oil.Range elseif id == "GamakichiChop" then Spells.Chopping.Range
		elseif id == "KcmDash" then Kcm.Dash.RangeWarcraft elseif id == "RikudoHY" or id == "RikudoHZ" then Ranged.RangeWarcraft else Definitions.Clones.RangeWarcraft
	local radius = if id == "GamakichiChop" then Spells.Chopping.Radius elseif id == "GamakichiOil" then Spells.Oil.Radius
		elseif id == "RikudoHY" or id == "RikudoHZ" then rangedRadius else 0
	return if root and root:IsA("BasePart") then root else nil, Units.toStuds(range), Units.toStuds(radius)
end
function Targeting.Evaluate(id: string, point: Vector2?): (any, string?, Vector3?)
	local hit = Targeting.Pick(point); if not hit then return nil, "Наведите прицел на цель или землю", nil end
	local model = modelAt(hit)
	local area = id == "GamakichiChop" or id == "RikudoHY" or id == "RikudoHZ"
	local target: any = if area then hit.Position elseif id == "KcmDash" then model or hit.Position else model
	if not target then return nil, "Наведите прицел на врага", hit.Position end
	local origin, range = Targeting.Geometry(id); if not origin then return nil, "Источник способности недоступен", hit.Position end
	local position = hit.Position
	if area then
		-- Aiming at a torso anchors the area to the floor under it, not to its side normal.
		local ground = workspace:Raycast(position+Vector3.new(0,12,0),Vector3.new(0,-36,0),terrainParams())
		if not ground then return nil, "Наведите прицел на землю", position end
		position = ground.Position; target = position
	end
	if typeof(target) == "Instance" then
		local targetModel = target :: Model
		local hp = targetModel:FindFirstChildOfClass("Humanoid")
		local root = targetModel:FindFirstChild("HumanoidRootPart")
		local ownTeam = Players.LocalPlayer:GetAttribute("TeamId")
		if not hp or hp.Health <= 0 or not root or not root:IsA("BasePart") or targetModel:FindFirstChildOfClass("ForceField")
			or targetModel:GetAttribute("CombatDisabled") == true or targetModel:GetAttribute("IsDestroyed") == true
			or (ownTeam ~= nil and targetModel:GetAttribute("TeamId") == ownTeam) then return nil, "Недоступная цель", hit.Position end
		local kind = targetModel:GetAttribute("EntityKind")
		if id ~= "CloneCommand" and kind ~= "Hero" and kind ~= "Minion" and kind ~= "Summon" then return nil, "Выберите бойца", hit.Position end
		position = root.Position
	end
	if (position-origin.Position).Magnitude > range then return nil, "Слишком далеко", position end
	-- Only these techniques use server terrain visibility checks. Clone orders,
	-- Sleep and ranged ultimates must not acquire a new client-only LOS restriction.
	if id == "KcmDash" or id == "GamakichiOil" or id == "GamakichiChop" then
		local destination = if id == "KcmDash" then position else position+Vector3.new(0,.1,0)
		if workspace:Raycast(origin.Position, destination-origin.Position, terrainParams()) then return nil, "Путь перекрыт", position end
	end
	if id == "KcmDash" then
		if math.abs(position.Y-origin.Position.Y)>12 then return nil, "Слишком большой перепад высоты", position end
		local destination = position
		if typeof(target) == "Instance" then
			local flat = (origin.Position-destination)*Vector3.new(1,0,1)
			if flat.Magnitude>.01 then destination += flat.Unit*3 end
		end
		local params = RaycastParams.new(); params.RespectCanCollide = true
		local ignored: {Instance} = {}; if Players.LocalPlayer.Character then table.insert(ignored,Players.LocalPlayer.Character :: Model) end
		if typeof(target) == "Instance" then table.insert(ignored,target) end
		params.FilterDescendantsInstances = ignored
		local ground = workspace:Raycast(destination+Vector3.new(0,6,0),Vector3.new(0,-18,0),params)
		if not ground or ground.Normal.Y<.5 then return nil, "Выберите устойчивую поверхность", position end
		local humanoid = if origin.Parent then origin.Parent:FindFirstChildOfClass("Humanoid") else nil
		destination = Vector3.new(destination.X,ground.Position.Y+(if humanoid then humanoid.HipHeight else 2)+origin.Size.Y/2,destination.Z)
		local movement = destination-origin.Position
		if movement.Magnitude>.01 and workspace:Blockcast(origin.CFrame,origin.Size*.8,movement,params) then return nil, "Путь перекрыт", destination end
		position = destination
	end
	return target, nil, position
end
function Targeting.Clear()
	if folder then folder:Destroy(); folder = nil end
	table.clear(ring); table.clear(growthRing); line = nil; marker = nil; highlight = nil
	Players.LocalPlayer:SetAttribute("AimTargetValid", nil)
end
local function part(name: string): Part
	local p = Instance.new("Part"); p.Name = name; p.Anchored = true; p.CanCollide = false; p.CanQuery = false; p.CanTouch = false
	p.Material = Enum.Material.Neon; p.CastShadow = false; p.Transparency = .35; p.Parent = folder; return p
end
function Targeting.Preview(id: string): string?
	if not folder then
		local created = Instance.new("Folder"); created.Name = "LocalAbilityAim"; created.Parent = workspace; folder = created
		for _ = 1,32 do table.insert(ring, part("Range")) end
		for _ = 1,32 do table.insert(growthRing, part("ExpansionLimit")) end
		line = part("Direction"); marker = part("Area"); marker.Shape = Enum.PartType.Cylinder
		highlight = Instance.new("Highlight"); highlight.DepthMode = Enum.HighlightDepthMode.Occluded; highlight.FillTransparency = .85; highlight.Parent = folder
	end
	local target, reason, position = Targeting.Evaluate(id)
	local root, range, radius = Targeting.Geometry(id)
	local color = if reason then invalidColor else validColor
	Players.LocalPlayer:SetAttribute("AimTargetValid", reason == nil)
	if root then
		local floor = workspace:Raycast(root.Position,Vector3.new(0,-20,0),terrainParams())
		local center = if floor then floor.Position+Vector3.new(0,.08,0) else root.Position-Vector3.new(0,2.6,0)
		for i,p in ring do
			local a,b = (i-1)*math.pi/16, i*math.pi/16
			local first = center+Vector3.new(math.cos(a),0,math.sin(a))*range
			local last = center+Vector3.new(math.cos(b),0,math.sin(b))*range
			p.Size = Vector3.new(.08,.08,(last-first).Magnitude); p.CFrame = CFrame.lookAt((first+last)/2,last); p.Color = color
		end
		if line then
			line.Transparency = if position then .4 else 1
			if position and (position-root.Position).Magnitude > .01 then
				line.Size = Vector3.new(.08,.08,(position-root.Position).Magnitude); line.CFrame = CFrame.lookAt((root.Position+position)/2, position); line.Color = color
			end
		end
	end
	if marker then
		marker.Transparency = if position then .8 else 1
		if position then marker.Size = Vector3.new(.06,math.max(1,radius*2),math.max(1,radius*2)); marker.CFrame = CFrame.new(position+Vector3.new(0,.08,0))*CFrame.Angles(0,0,math.pi/2); marker.Color = color end
	end
	for i,p in growthRing do
		p.Transparency = if id == "RikudoHY" and position then .6 else 1
		if id == "RikudoHY" and position then
			local a,b = (i-1)*math.pi/16, i*math.pi/16
			local first = position+Vector3.new(math.cos(a),0,math.sin(a))*Units.toStuds(hyMaximumRadius)
			local last = position+Vector3.new(math.cos(b),0,math.sin(b))*Units.toStuds(hyMaximumRadius)
			p.Size=Vector3.new(.1,.1,(last-first).Magnitude); p.CFrame=CFrame.lookAt((first+last)/2,last); p.Color=color
		end
	end
	if highlight then highlight.Adornee = if typeof(target) == "Instance" then target else nil; highlight.FillColor = color; highlight.OutlineColor = color end
	return reason
end
return Targeting
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="135">
            <Properties>
              <string name="Name">AbilityVFXController</string>
              <string name="Source"><![CDATA[--!strict
-- Original Roblox presentation following the map's timing/attachment sequence.
local Players=game:GetService("Players")
local RunService=game:GetService("RunService")
local Shared=game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config=require(Shared.Config.AbilityConfig)
local Definition=require(Shared.Abilities.NarutoDefinitions).Rasengan
local Rounds=require(script.Parent.RoundController)
local Ranged=require(script.Parent.NarutoRangedVFXController)
local RasenganArt=require(script.Parent.RasenganVisual)
local ChakraAura=require(script.Parent.ChakraAuraVisual)
local FlightArt=require(script.Parent.RasenshurikenFlightVisual)
local AreaRules=require(Shared.Abilities.RasenshurikenThrowRules)
local Units=require(Shared.Abilities.WorldUnits)
type Effect={areaId:number?,parts:{BasePart},at:number,untilAt:number,origin:Vector3,model:Model?,kind:string,destination:Vector3?,radius:number?,caster:Model?,orb:RasenganArt.Orb?,burst:RasenganArt.Burst?}
type Helper={model:Model,cast:number}
local effects:{Effect}={}
local orbs:{[Model]:Effect}={}
local helpers:{[Model]:Helper}={}
local oilHighlights:{[Model]:Highlight}={}
local sageHighlights:{[Model]:Highlight}={}
local folder:Folder?=nil
local VFX={}
local started=false
local function part(name:string,color:Color3,size:Vector3): Part
	local p=Instance.new("Part"); p.Name=name; p.Anchored=true; p.CanCollide=false; p.CanTouch=false; p.CanQuery=false
	p.Color=color; p.Size=size; p.Material=Enum.Material.Neon; p.CastShadow=false; p.Parent=folder; return p
end
local function remove(index:number)
	local effect=effects[index]; if effect.model then orbs[effect.model]=nil end
	if effect.orb then RasenganArt.Destroy(effect.orb) end
	if effect.burst then effect.burst.group:Destroy() end
	for _,p in effect.parts do p:Destroy() end; table.remove(effects,index)
end
local function create(position:Vector3,kind:string,model:Model?,variant:string?): Effect?
	local camera=workspace.CurrentCamera
	if #effects>=Config.Visual.MaxEffects or (camera and (camera.CFrame.Position-position).Magnitude>Config.Visual.ViewDistance) then return nil end
	local now=workspace:GetServerTimeNow()
	local effect:Effect={parts={},at=now,untilAt=now+(if kind=="Area" then 3.5 elseif kind=="Orb" then 20 elseif kind=="Finish" then .7 else .5),origin=position,model=model,kind=kind}
	if kind=="Orb" and model and folder then
  local detailed=model:GetAttribute("NativeNarutoClone")~=true and (not camera or (camera.CFrame.Position-position).Magnitude<90)
  effect.orb=RasenganArt.Create(folder,model,detailed); table.insert(effects,effect); return effect
 end
 if (kind=="Contact" or kind=="Impact" or kind=="Finish") and folder then
  local burst=RasenganArt.Burst(folder,position,variant or "Rasengan",kind,now); effect.burst=burst
  effect.untilAt=now+burst.duration; table.insert(effects,effect); return effect
 end
 local count=if kind=="Oil" then 1 elseif kind=="Area" then 97 elseif kind=="Chop" then 24 elseif kind=="Smoke" then 14 elseif kind=="Channel" or kind=="OilImpact" then 4 else 8
	for i=1,count do
		local p=part(if kind=="Orb" then "RasenganSpiral" else "Rasengan"..kind,Color3.fromRGB(110,211,255),Vector3.one*.2)
		if kind=="Oil" or kind=="OilImpact" then p.Shape=Enum.PartType.Ball; p.Color=Color3.fromRGB(82,49,24); p.Material=Enum.Material.SmoothPlastic; p.Size=Vector3.one*.8
		elseif kind=="Area" then p.Color=Color3.fromRGB(205,248,255); if i==1 then p.Shape=Enum.PartType.Ball;p.Material=Enum.Material.ForceField;p.Color=Color3.fromRGB(30,125,255) end
		elseif kind=="Channel" or kind=="Chop" then if kind=="Channel" then p.Shape=Enum.PartType.Cylinder end; p.Color=Color3.fromRGB(218,241,255)
		elseif kind=="Smoke" then p.Shape=Enum.PartType.Ball; p.Material=Enum.Material.SmoothPlastic; p.Color=Color3.fromRGB(193,207,214)
		elseif kind=="Finish" and i==1 then p.Shape=Enum.PartType.Cylinder
		else p.Shape=Enum.PartType.Ball end
		table.insert(effect.parts,p)
	end
	table.insert(effects,effect); return effect
end
local function removeHelper(source:Model,poof:boolean)
	local helper=helpers[source]; if not helper then return end
	if poof and helper.model.Parent then create(helper.model:GetPivot().Position,"Smoke",nil) end
	helper.model:Destroy(); helpers[source]=nil
end
local function helper(source:Model,cast:number)
	if helpers[source] then return end
	local root=source:FindFirstChild("HumanoidRootPart"); if not root or not root:IsA("BasePart") then return end
	local old=source.Archivable; source.Archivable=true; local copy=source:Clone(); source.Archivable=old
 local copiedHumanoid=copy:FindFirstChildOfClass("Humanoid"); if copiedHumanoid then copiedHumanoid.EvaluateStateMachine=false end
	for _,item in copy:GetDescendants() do
		if item:IsA("LuaSourceContainer") or item:IsA("Tool") or item:IsA("ForceField") then item:Destroy()
		elseif item:IsA("BasePart") then item.CanCollide=false; item.CanTouch=false; item.CanQuery=false; item.Massless=true end
	end
	copy.Name="RasenganPreparationHelper"; copy:SetAttribute("RasenganHelper",true); copy:SetAttribute("RasenganPhase","")
	copy:SetAttribute("RasenganVisible",false); copy:SetAttribute("RasenganHeld",false); copy:SetAttribute("EntityKind","Cosmetic")
	local copyRoot=copy:FindFirstChild("HumanoidRootPart") :: BasePart; copyRoot.Anchored=true
	local humanoid=copy:FindFirstChildOfClass("Humanoid"); if humanoid then humanoid.DisplayDistanceType=Enum.HumanoidDisplayDistanceType.None end
	-- Cosmetic choreography: the helper works beside the palm, not seven studs away.
	local position=root.Position+root.CFrame.RightVector*2.3+root.CFrame.LookVector*.6
	copy:PivotTo(CFrame.lookAt(position,root.Position)); copy.Parent=folder
	helpers[source]={model=copy,cast=cast}; create(position,"Smoke",nil)
end
local function visible(model:Model,now:number): boolean
	if model:GetAttribute("NativeNarutoClone")==true then return model:GetAttribute("RasenganVisible")==true end
	local at=model:GetAttribute("RasenganStartedAt")
	return model:GetAttribute("RasenganHeld")==true and typeof(at)=="number" and now>=at+.08
end
function VFX.Event(message:any)
 if folder then FlightArt.Event(message,folder) end
 if message.kind=="RasenshurikenAreaEnd" then
  for i=#effects,1,-1 do if effects[i].areaId==message.id then remove(i) end end;return
 end
 if message.kind=="RasenshurikenDetonate" then
  local e=create(message.position,"Area",nil);if e then e.radius=message.radius;e.areaId=message.id;e.at=message.startAt;e.untilAt=e.at+AreaRules.Duration end;return
 end
 local variant=if typeof(message.variant)=="string" then message.variant else "Rasengan"
 if variant~="Odama" and variant~="Rasenshuriken" then variant="Rasengan" end
 if typeof(message.kind)=="string" and string.sub(message.kind,1,6)=="Rikudo" then Ranged.Event(message);return end
	if typeof(message.position)~="Vector3" then return end
	if message.kind=="GamakichiOil" or message.kind=="GamakichiOilImpact" or message.kind=="GamakichiChannel" or message.kind=="GamakichiChopImpact" then
		local kind=if message.kind=="GamakichiOil" then "Oil" elseif message.kind=="GamakichiOilImpact" then "OilImpact" elseif message.kind=="GamakichiChannel" then "Channel" else "Chop"
		local effect=create(message.position,kind,nil)
		if effect then
			effect.destination=if typeof(message.destination)=="Vector3" then message.destination else nil
			effect.radius=if typeof(message.radius)=="number" then message.radius else 1
			local source=message.source
			if typeof(source)=="Instance" then local instance=source :: Instance; if instance:IsA("Model") then effect.caster=instance end end
			if kind=="Oil" and typeof(message.duration)=="number" then effect.untilAt=effect.at+math.max(.03,message.duration) end
		end
	elseif message.kind=="Smoke" then create(message.position,"Smoke",nil)
	elseif message.kind=="RasenshurikenArea" then
  local e=create(message.position,"Area",nil);if e then e.radius=message.radius;e.caster=message.source;e.areaId=message.id;e.at=message.startAt or e.at;e.untilAt=e.at+AreaRules.Duration end
 elseif message.kind=="RasenganContact" then create(message.position,"Contact",nil,variant)
	elseif message.kind=="RasenganImpact" then create(message.position,"Impact",nil,variant)
	elseif message.kind=="RasenganFinish" then create(message.position,"Finish",nil,variant)
	elseif message.kind=="RasenganTrail" then create(message.position,"Trail",nil) end
end
function VFX.GetDiagnostics(model:Model): (boolean,boolean)
	return helpers[model]~=nil,orbs[model]~=nil
end
function VFX.Start()
 Ranged.Start()
	if started then return end; started=true
	local created=Instance.new("Folder"); created.Name="LocalHeroVFX"; created.Parent=workspace; folder=created
	Rounds.Watch(function()
        FlightArt.Clear()
		for i=#effects,1,-1 do remove(i) end
		for model in helpers do removeHelper(model,false) end
	end)
	RunService.PreRender:Connect(function(dt)
		local now=workspace:GetServerTimeNow(); local match=game:GetService("ReplicatedStorage"):FindFirstChild("SurvivalState")
		local active=match~=nil and match:GetAttribute("Phase")=="InProgress"
        ChakraAura.Update(created,now)
        FlightArt.Update(now,dt)
		local sageTagged:{[Model]:boolean}={}
        if active then for _,model in game:GetService("CollectionService"):GetTagged("NarutoSage") do
            if model:IsA("Model") and model.Parent then
                local hp=model:FindFirstChildOfClass("Humanoid")
                local untilAt=model:GetAttribute("SageAuraUntil")
                if hp and hp.Health>0 and typeof(untilAt)=="number" and now<untilAt then
                    sageTagged[model]=true
                    if not sageHighlights[model] then
                        local h=Instance.new("Highlight"); h.Name="SageAura"; h.Adornee=model; h.DepthMode=Enum.HighlightDepthMode.Occluded
                        h.FillColor=Color3.fromRGB(231,140,42); h.OutlineColor=Color3.fromRGB(250,195,75); h.FillTransparency=.88; h.OutlineTransparency=.45; h.Parent=folder; sageHighlights[model]=h
                    end
                end
            end
        end end
        for model,h in sageHighlights do if not sageTagged[model] then h:Destroy(); sageHighlights[model]=nil end end
        local tagged:{[Model]:boolean}={}
		if active then for _,model in game:GetService("CollectionService"):GetTagged("GamakichiOilStatus") do
			if model:IsA("Model") and model.Parent and ((model:GetAttribute("OilUntil") or 0) :: number)>now then
				tagged[model]=true
				if not oilHighlights[model] then
					local h=Instance.new("Highlight"); h.Name="OilStatus"; h.FillColor=Color3.fromRGB(92,55,21); h.FillTransparency=.45; h.OutlineTransparency=.6; h.DepthMode=Enum.HighlightDepthMode.Occluded; h.Adornee=model; h.Parent=folder; oilHighlights[model]=h
				end
			end
		end end
		for model,h in oilHighlights do if not tagged[model] then h:Destroy(); oilHighlights[model]=nil end end
		local function source(model:Model)
			local humanoid=model:FindFirstChildOfClass("Humanoid"); if not active or not humanoid or humanoid.Health<=0 then removeHelper(model,false); return end
			local at=model:GetAttribute("RasenganStartedAt"); local ready=model:GetAttribute("RasenganReadyAt"); local cast=model:GetAttribute("NarutoCastId")
			if model:GetAttribute("NativeNarutoClone")~=true and typeof(at)=="number" and typeof(ready)=="number" and typeof(cast)=="number" and model:GetAttribute("RasenganPhase")=="Preparing"
				and now>=at+Definition.VariantWindow and now<ready then
				local old=helpers[model]; if old and old.cast~=cast then removeHelper(model,false) end
				helper(model,cast)
			else removeHelper(model,true) end
			if visible(model,now) and not orbs[model] then
				local effect=create(model:GetPivot().Position,"Orb",model); if effect then orbs[model]=effect end
			end
		end
		for _,player in Players:GetPlayers() do if player.Character then source(player.Character) end end
		local summons=workspace:FindFirstChild("HeroSummons")
		if summons then for _,model in summons:GetChildren() do if model:IsA("Model") then source(model) end end end
		for model in helpers do if not model:IsDescendantOf(workspace) then removeHelper(model,false) end end
		for index=#effects,1,-1 do
			local effect=effects[index]; local model=effect.model
			local humanoid=if model then model:FindFirstChildOfClass("Humanoid") else nil
			if not active or now>=effect.untilAt or (effect.caster and not effect.caster.Parent) or (model and (not model.Parent or not humanoid or humanoid.Health<=0 or not visible(model,now))) then remove(index); continue end
			local elapsed=now-effect.at
			if model then
				local hand=model:FindFirstChild("RightHand"); if not hand or not hand:IsA("BasePart") then remove(index); continue end
                if effect.orb then RasenganArt.Update(effect.orb,model,hand,now,dt) end
            elseif effect.burst then
                RasenganArt.UpdateBurst(effect.burst,effect.origin,now)
			else
				local progress=math.clamp(elapsed/(effect.untilAt-effect.at),0,1)
				for i,p in effect.parts do
					local angle=i*math.pi/4; local finish=effect.kind=="Finish"
					if effect.kind=="Oil" and effect.destination then
						p.Position=effect.origin:Lerp(effect.destination,progress)+Vector3.new(0,(effect.destination-effect.origin).Magnitude*.05*4*progress*(1-progress),0)
					elseif effect.kind=="Area" then
                        local radius=Units.toStuds(AreaRules.radius(elapsed))
                        if radius<=0 then p.Transparency=1;continue end
                        if effect.caster then effect.origin=effect.caster:GetPivot().Position end
                        local envelope=math.min(1,(1-progress)*5)
                        if i==1 then
                            p.Size=Vector3.one*radius*2; p.Position=effect.origin; p.Transparency=1-envelope*.72
                        elseif i<=73 then
                            local band=math.floor((i-2)/24);local segment=(i-2)%24
                            local rotation=CFrame.new(effect.origin)*CFrame.Angles(band*1.05,elapsed*.7,band*.85)
                            local spin=segment*math.pi/12+elapsed*(if band%2==0 then 11 else -9)
                            local bandRadius=math.max(0,radius-.15)
                            local a=rotation:PointToWorldSpace(Vector3.new(math.cos(spin)*bandRadius,math.sin(spin)*bandRadius,0))
                            local b=rotation:PointToWorldSpace(Vector3.new(math.cos(spin+.28)*bandRadius,math.sin(spin+.28)*bandRadius,0))
                            p.Size=Vector3.new(.06,.12,(b-a).Magnitude);p.CFrame=CFrame.lookAt((a+b)/2,b);p.Transparency=1-envelope*(.55+.3*math.sin(segment*.4)^2)
                        else
                            local spin=i*2.399+elapsed*17;local r=radius*(.2+((i*17)%19)/25)
                            local a=effect.origin+Vector3.new(math.cos(spin)*r,math.sin(i+elapsed*9)*radius*.7,math.sin(spin)*r)
                            local b=a+Vector3.new(math.cos(spin+1)*radius*.35,.35,math.sin(spin+1)*radius*.35)
                            local limit=math.max(.01,radius-.15)
                            local da,db=a-effect.origin,b-effect.origin
                            if da.Magnitude>limit then a=effect.origin+da.Unit*limit end
                            if db.Magnitude>limit then b=effect.origin+db.Unit*limit end
                            p.Size=Vector3.new(.025,.04,(b-a).Magnitude);p.CFrame=CFrame.lookAt((a+b)/2,b);p.Transparency=1-envelope*.8
                        end
                    elseif effect.kind=="Chop" then
                        local radius=(effect.radius or 4)*(.45+progress*.55)
                        local rotation=CFrame.new(effect.origin)*CFrame.Angles(.25,elapsed*2,math.rad(55))
                        local angle=(i-1)/23*math.pi*1.4
                        local a=rotation:PointToWorldSpace(Vector3.new(math.cos(angle)*radius,math.sin(angle)*radius,0))
                        local b=rotation:PointToWorldSpace(Vector3.new(math.cos(angle+.2)*radius,math.sin(angle+.2)*radius,0))
                        p.Size=Vector3.new(.07,.25,(b-a).Magnitude);p.CFrame=CFrame.lookAt((a+b)/2,b);p.Transparency=progress
                    elseif effect.kind=="Smoke" then
                        local spread=progress*3.3;local angle=i*2.399
                        p.Position=effect.origin+Vector3.new(math.cos(angle)*spread,math.sin(i)*.7+progress*2,math.sin(angle)*spread)
                        p.Size=Vector3.one*(.7+math.sin(i)^2+progress*1.7);p.Transparency=.15+progress*.85
                    elseif effect.kind=="Channel" or effect.kind=="OilImpact" then
						local radius=(effect.radius or 1)*(if effect.kind=="Area" then 1+math.min(elapsed/1.6,1)*2/3 elseif effect.kind=="Channel" then 1 else progress)
                        if effect.kind=="Area" and effect.caster then effect.origin=effect.caster:GetPivot().Position end
						if effect.kind=="OilImpact" then p.Position=effect.origin+Vector3.new(math.cos(angle)*radius,0,math.sin(angle)*radius); p.Transparency=progress
						else p.Size=Vector3.new(.1,radius*2,radius*2); p.CFrame=CFrame.new(effect.origin+Vector3.new(0,.12+i*.02,0))*CFrame.Angles(0,0,math.pi/2); p.Transparency=.7+progress*.3 end
					elseif finish and i==1 then
						p.Size=Vector3.new(.12,2+progress*8,2+progress*8); p.CFrame=CFrame.new(effect.origin-Vector3.new(0,2.8,0))*CFrame.Angles(0,0,math.pi/2); p.Transparency=.35+progress*.65
					else
						p.Position=effect.origin+Vector3.new(math.cos(angle)*progress*(if finish then 4 else 2),progress*(if finish then -2 else 1.5),math.sin(angle)*progress*(if finish then 4 else 2))
						p.Size=Vector3.one*(.3+progress*(if finish then 1.4 else 1)); p.Transparency=.2+progress*.8
					end
				end
			end
		end
	end)
end
return VFX
]]></string>
