          <Item class="ModuleScript" referent="157">
            <Properties>
              <string name="Name">TowerVFXController</string>
              <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Config = require(ReplicatedStorage:WaitForChild("Shared").Config.TowerConfig)
local Rounds = require(script.Parent.RoundController)
type Effect = { object: BasePart, tween: Tween, endsAt: number }
local Controller = {}
local started = false
local effects: { Effect } = {}
local function remove(index: number)
	local effect = effects[index]; effect.tween:Cancel(); effect.object:Destroy(); table.remove(effects, index)
end
function Controller.GetActiveCount(): number return #effects end
function Controller.Start()
	if started then return end; started = true
	Rounds.Watch(function() for i = #effects, 1, -1 do remove(i) end end)
	task.spawn(function()
		local state = ReplicatedStorage:WaitForChild("SurvivalState", 30); if not state then return end
		local event = state:WaitForChild("TowerEvent") :: RemoteEvent
		local folder = Instance.new("Folder"); folder.Name = "LocalTowerVFX"; folder.Parent = workspace
		event.OnClientEvent:Connect(function(kind: string, _model: Model, origin: Vector3, destination: Vector3, teamId: string, _lane: string, roundId: number)
			if not Rounds.Accepts(roundId) then return end
			local camera = workspace.CurrentCamera
			if camera and (origin - camera.CFrame.Position).Magnitude > Config.Visual.ViewDistance then return end
			while #effects >= Config.Visual.MaxEffects do remove(1) end
			local team = state:FindFirstChild(teamId)
			local color = if team then team:GetAttribute("Color") else Color3.new(1, 1, 1)
			local object = Instance.new("Part"); object.Name = "Tower" .. kind; object.Shape = Enum.PartType.Ball
			object.Anchored = true; object.CanCollide = false; object.CanQuery = false; object.CanTouch = false; object.CastShadow = false
			object.Material = Enum.Material.Neon; object.Color = color :: Color3; object.Position = origin
			object.Size = Vector3.one * (if kind == "Destroyed" then 3 else 0.85); object.Parent = folder
			local duration = if kind == "Destroyed" then Config.Visual.RuinFlashLifetime else Config.Visual.ProjectileDuration
			local tween = TweenService:Create(object, TweenInfo.new(duration, Enum.EasingStyle.Quad), {
				Position = destination, Size = Vector3.one * (if kind == "Destroyed" then 12 else 0.25), Transparency = 1,
			})
			table.insert(effects, { object = object, tween = tween, endsAt = os.clock() + duration }); tween:Play()
		end)
		RunService.PreRender:Connect(function()
			for index = #effects, 1, -1 do if os.clock() >= effects[index].endsAt then remove(index) end end
			local map = workspace:FindFirstChild("Map"); local towers = if map then map:FindFirstChild("Towers") else nil
			if not towers then return end
			local now = workspace:GetServerTimeNow()
			for _, model in towers:GetChildren() do
				if model:GetAttribute("ManagedTower") ~= true then continue end
				local crystal = model:FindFirstChild("Crystal")
				if not crystal or not crystal:IsA("BasePart") then continue end
				local light = crystal:FindFirstChildOfClass("PointLight")
				local charging = model:GetAttribute("TowerState") == "Charging"
				local chargeEnd = (model:GetAttribute("ChargeEndsAt") or 0) :: number
				local progress = if charging then math.clamp(1 - (chargeEnd - now) / Config.Windup, 0, 1) else 0
				crystal.Size = Vector3.one * (2.6 + progress * 1.5)
				if light then light.Brightness = 0.8 + progress * 5 end
			end
		end)
	end)
end
return Controller
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="158">
            <Properties>
              <string name="Name">VFXController</string>
              <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config.VFXConfig)
local Debug = require(Shared.Config.DebugConfig)
local Rounds = require(script.Parent.RoundController)

type Effect = { object: Instance, expiresAt: number, tweens: { Tween } }
local VFXController = {}
local effects: { Effect } = {}
local debugEffects: { Effect } = {}
local folder: Folder? = nil
local started = false
local shakeEnabled = Config.CameraShakeEnabled
local shakeUntil = 0
local shakeDuration = 0
local shakeAmplitude = 0
local shakeHumanoid: Humanoid? = nil
local cameraOffset = Vector3.zero
local lastHitSound = 0

local function dispose(effect: Effect)
	for _, tween in effect.tweens do tween:Cancel() end
	effect.object:Destroy()
end
function VFXController.Clear()
	for _, effect in effects do dispose(effect) end; table.clear(effects)
	for _, effect in debugEffects do dispose(effect) end; table.clear(debugEffects)
	shakeUntil = 0; shakeAmplitude = 0
	if shakeHumanoid and shakeHumanoid.Parent then shakeHumanoid.CameraOffset = Vector3.zero end
	shakeHumanoid = nil; cameraOffset = Vector3.zero
end
Rounds.Watch(VFXController.Clear)

local function remember(object: Instance, lifetime: number, tweens: { Tween }, debugEffect: boolean?)
	local list = if debugEffect then debugEffects else effects
	local limit = if debugEffect then Debug.MaxDebugHitboxes else Config.MaxEffects
	while #list >= limit do
		local oldest = table.remove(list, 1)
		if oldest then dispose(oldest) end
	end
	table.insert(list, { object = object, expiresAt = os.clock() + lifetime, tweens = tweens })
end

local function part(name: string, position: Vector3, size: Vector3, color: Color3): Part
	local object = Instance.new("Part")
	object.Name = name
	object.Anchored = true
	object.CanCollide = false
	object.CanQuery = false
	object.CanTouch = false
	object.CastShadow = false
	object.Material = Enum.Material.Neon
	object.Color = color
	object.Size = size
	object.Position = position
	return object
end

function VFXController.Swing(character: Model, step: number)
	local handName = if step % 2 == 0 then "LeftHand" else "RightHand"
	local hand = character:FindFirstChild(handName) or character:FindFirstChild("Right Arm")
	if not hand then return end
	local glow = Instance.new("Highlight")
	glow.Name = "PredictedSwingCue"
	glow.Adornee = hand
	glow.DepthMode = Enum.HighlightDepthMode.Occluded
	glow.FillColor = Config.NormalColor
	glow.FillTransparency = 0.45
	glow.OutlineTransparency = 1
	glow.Parent = folder
	remember(glow, Config.SwingLifetime, {})
end

function VFXController.Projectile(origin: Vector3, destination: Vector3, color: Color3, duration: number)
	local shot = part("MinionProjectile", origin, Vector3.one * 0.45, color)
	shot.Shape = Enum.PartType.Ball; shot.Parent = folder
	local tween = TweenService:Create(shot, TweenInfo.new(duration, Enum.EasingStyle.Linear), { Position = destination })
	tween:Play(); remember(shot, duration, { tween })
end

function VFXController.Hit(character: Model, position: Vector3, heavy: boolean)
	local lifetime = if heavy then Config.HeavyLifetime else Config.HitLifetime
	local color = if heavy then Config.HeavyColor else Config.NormalColor
	local group = Instance.new("Folder")
	group.Name = "ConfirmedHit"
	group.Parent = folder
	local tweens: { Tween } = {}
	local sphere = part("Flash", position, Vector3.one * Config.HitSize, color)
	sphere.Shape = Enum.PartType.Ball
	sphere.Parent = group
	local flashTween = TweenService:Create(sphere, TweenInfo.new(lifetime), {
		Size = Vector3.one * (if heavy then Config.HeavyExpansion else Config.HitExpansion), Transparency = 1,
	})
	table.insert(tweens, flashTween)
	flashTween:Play()
	local reaction = Instance.new("Highlight")
	reaction.Adornee = character
	reaction.DepthMode = Enum.HighlightDepthMode.Occluded
	reaction.FillColor = Config.ReactionColor
	reaction.FillTransparency = 0.65
	reaction.OutlineTransparency = 1
	reaction.Parent = group
	for index = 1, Config.SparkCount do
		local angle = (index / Config.SparkCount) * math.pi * 2
		local direction = Vector3.new(math.cos(angle), math.sin(angle), 0)
		local spark = part("Spark", position, Vector3.new(0.06, 0.06, Config.SparkLength), color)
		spark.CFrame = CFrame.lookAt(position, position + direction)
		spark.Parent = group
		local tween = TweenService:Create(spark, TweenInfo.new(lifetime), {
			Position = position + direction * Config.SparkTravel, Transparency = 1,
		})
		table.insert(tweens, tween)
		tween:Play()
	end
	remember(group, lifetime, tweens)
end

-- Only the server's Damage.Applied path sends these messages. Predicted swings
-- never create numbers, hit markers, impact sound or camera feedback.
function VFXController.DamageFeedback(message: any)
	if typeof(message.amount) ~= "number" or message.amount <= 0 or typeof(message.position) ~= "Vector3" then return end
	local target = message.target
	if typeof(target) ~= "Instance" or not target:IsA("Model") then return end
	local camera = workspace.CurrentCamera
	if camera and (camera.CFrame.Position-message.position).Magnitude > 240 then return end
	local anchor = part("ConfirmedDamage", message.position+Vector3.new(0,2,0), Vector3.one*.1, Config.NormalColor)
	anchor.Transparency = 1; anchor.Parent = folder
	local gui = Instance.new("BillboardGui"); gui.Size = UDim2.fromOffset(100,40); gui.AlwaysOnTop = false; gui.Adornee = anchor; gui.Parent = anchor
	local label = Instance.new("TextLabel"); label.Size = UDim2.fromScale(1,1); label.BackgroundTransparency = 1
	label.Text = tostring(math.floor(message.amount+.5)); label.TextColor3 = Config.NormalColor; label.TextSize = 22; label.Font = Enum.Font.GothamBold; label.TextStrokeTransparency = .35; label.Parent = gui
	local rise = TweenService:Create(anchor,TweenInfo.new(.65),{Position=anchor.Position+Vector3.new(0,2.5,0)})
	local fade = TweenService:Create(label,TweenInfo.new(.65),{TextTransparency=1,TextStrokeTransparency=1})
	rise:Play(); fade:Play(); remember(anchor,.7,{rise,fade})
	VFXController.Hit(target,message.position,false)
	-- Rate-limit presentation, not damage: every target still gets its own number.
	if os.clock()-lastHitSound >= .09 then
		lastHitSound=os.clock(); VFXController.Shake(false)
		Players.LocalPlayer:SetAttribute("CombatHitUntil",workspace:GetServerTimeNow()+.13)
		local sound=Instance.new("Sound"); sound.SoundId="rbxasset://sounds/impact_water.mp3"; sound.Volume=.22; sound.PlaybackSpeed=1.8; sound.Parent=anchor; sound:Play()
	end
end

local function stopShake()
	if shakeHumanoid and shakeHumanoid.Parent then shakeHumanoid.CameraOffset = cameraOffset end
	shakeHumanoid = nil
	shakeUntil = 0
	shakeAmplitude = 0
end

function VFXController.Shake(heavy: boolean)
	if not shakeEnabled then return end
	local character = Players.LocalPlayer.Character
	local humanoid = if character then character:FindFirstChildOfClass("Humanoid") else nil
	if not humanoid or humanoid.Health <= 0 then return end
	if shakeHumanoid ~= humanoid then
		stopShake()
		shakeHumanoid = humanoid
		cameraOffset = humanoid.CameraOffset
	end
	shakeDuration = if heavy then Config.HeavyShakeDuration else Config.ShakeDuration
	shakeUntil = os.clock() + shakeDuration
	shakeAmplitude = math.max(shakeAmplitude, if heavy then Config.HeavyShakeAmplitude else Config.ShakeAmplitude)
end

function VFXController.SetCameraShakeEnabled(enabled: boolean)
	shakeEnabled = enabled
	if not enabled then stopShake() end
end

function VFXController.DebugBox(frame: CFrame, size: Vector3)
	if not Debug.DebugHitboxes then return end
	local box = part("DebugHitbox", frame.Position, size, Color3.fromRGB(85, 215, 255))
	box.CFrame = frame
	box.Transparency = 0.8
	box.Parent = folder
	remember(box, Debug.HitboxLifetime, {}, true)
end

function VFXController.GetActiveCount(): number
	return #effects
end

function VFXController.Start()
	if started then return end
	started = true
	local container = Instance.new("Folder")
	container.Name = "LocalCombatVFX"
	local existing = workspace:FindFirstChild("Effects")
	local effectsRoot = if existing and existing:IsA("Folder") then existing else Instance.new("Folder")
	effectsRoot.Name = "Effects"; effectsRoot.Parent = workspace
	container.Parent = effectsRoot
	folder = container
	Players.LocalPlayer.CharacterRemoving:Connect(function()
		stopShake()
		for _, list in { effects, debugEffects } do
			for _, effect in list do dispose(effect) end
			table.clear(list)
		end
	end)
	RunService:BindToRenderStep("CombatCameraFeedback", Enum.RenderPriority.Camera.Value - 1, function()
		local humanoid = shakeHumanoid
		if not humanoid then return end
		local now = os.clock()
		if now >= shakeUntil or not humanoid.Parent or humanoid.Health <= 0 then stopShake(); return end
		local amplitude = shakeAmplitude * math.clamp((shakeUntil - now) / shakeDuration, 0, 1)
		humanoid.CameraOffset = cameraOffset + Vector3.new(math.sin(now * Config.ShakeFrequency), math.cos(now * Config.ShakeFrequency * 1.3), 0) * amplitude
	end)
	RunService.Heartbeat:Connect(function()
		local now = os.clock()
		for _, list in { effects, debugEffects } do
			for index = #list, 1, -1 do
				if now >= list[index].expiresAt then
					local expired = table.remove(list, index)
					if expired then dispose(expired) end
				end
			end
		end
	end)
end

return VFXController
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="LocalScript" referent="159">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[--!strict

local CombatController = require(script.Parent.Controllers.CombatController)
local InputController = require(script.Parent.Controllers.InputController)

require(script.Parent.Controllers.CameraController).Start()
CombatController.Start()
InputController.Start()
if not (game:GetService("RunService"):IsStudio() and workspace:GetAttribute("CombatOnlyTest") == true) then
	require(script.Parent.Controllers.HeroAppearanceTransition).Start()
	task.spawn(function() require(script.Parent.Controllers.DeveloperConsoleController).Start() end)
	require(script.Parent.Controllers.SurvivalHUDController).Start()
	require(script.Parent.Controllers.HeroHUDController).Start()
	require(script.Parent.Controllers.AbilityHUDController).Start()
	require(script.Parent.Controllers.TowerVFXController).Start()
	require(script.Parent.Controllers.MinionMotionController).Start()
end
print("[Anime Battlegrounds] Client ready; left mouse button attacks")
]]></string>
