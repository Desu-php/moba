            <string name="Name">CloneAutonomyPolicy</string>
            <string name="Source"><![CDATA[--!strict
-- Roblox companion behavior; damage, counts and lifetime remain in NarutoDefinitions.
return table.freeze({
	AcquireRadius = 28,
	PursueRadius = 40,
	OwnerLeash = 48,
	ReturnRadius = 10,
	ScanInterval = .4,
	RecallGrace = 2,
	CrowdCost = 8,
