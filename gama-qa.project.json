{
  "name": "Naruto-Legend-Development",
  "serveAddress": "127.0.0.1",
  "servePort": 34872,
  "tree": {
    "$className": "DataModel",
    "$ignoreUnknownInstances": true,
    "ReplicatedStorage": {
      "$ignoreUnknownInstances": true,
      "Shared": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "$ignoreUnknownInstances": true,
      "Server": {
        "$path": "src/server"
      },
      "GamaAutonomyQA": {
        "$path": "tests/summon-ai/Autonomous.server.luau"
      },
      "LaneCrossingQA": {
        "$path": "tests/summon-ai/LaneCrossing.server.luau"
      },
      "ObstacleAvoidanceQA": {
        "$path": "tests/summon-ai/ObstacleAvoidance.server.luau"
      }
    },
    "StarterPlayer": {
      "$properties": {
        "GameSettingsAvatar": "R15",
        "LoadCharacterAppearance": false
      },
      "$ignoreUnknownInstances": true,
      "StarterPlayerScripts": {
        "$ignoreUnknownInstances": true,
        "Client": {
          "$path": "src/client"
        }
      }
    },
    "Workspace": {
      "$ignoreUnknownInstances": true,
      "$attributes": {
        "DeveloperSoloMode": true
      }
    }
  }
}
